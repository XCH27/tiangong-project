{
  "name": "omniverse-v2-tui-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "OmniVerse Vision V2 terminal (Ink) prototype — four-state main line (输入/计划/运行), mock data, REST/SSE-ready. Visual-language validation before pi-tui.",
  "bin": {
    "oe-v2": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.tsx",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
