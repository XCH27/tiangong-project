.DS_Store
.fleet/
.claude/
node_modules/
**/node_modules/
__pycache__/
*.pyc

# Local source-reference checkouts live here; only the index/docs around them
# should be tracked by the Fleet repo.
/源码参考/software/*/
/源码参考/plugins/*/

# Optional local visual-reference library. Product docs may point to it as
# auxiliary material, but it is not a Fleet build input or tracked source.
/UI参考/

.cursor/
.evolver/
.opencode/

# Local agent-tooling state; never part of the product tree.
.agents/

# Local disposal directory; never commit it.
/_trash/

# Local agent-tool state (never product tree)
/.workbuddy/
/assets/
