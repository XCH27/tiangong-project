+import type { ModelConfigObject } from "./config/model-config.js";
+import { MODEL_KNOWLEDGE, MODEL_KNOWLEDGE_HOSTS } from "./model-knowledge.generated.js";
+
+/**
+ * Model facts from the shipped catalog, for models that no provider response, curated rule or user
+ * correction describes. It replaces the catch-all placeholder (200K, text-only) and is itself
+ * overridden by every one of those layers.
+ *
+ * Design (compared with OpenCode's models.dev catalog and Cherry Studio's provider registry): one
+ * entry per model per host, because hosts legitimately differ (OpenAI 272K vs a gateway's 1.05M).
+ * Lookup prefers the host actually serving the request, then the model's own vendor, and only then
+ * a consensus across hosts, where capabilities are unioned (any credible host reporting image input
+ * means the model takes images) and limits use the most common value.
+ */
+export interface ModelKnowledgeInput {
+  readonly providerId?: string;
+  readonly templateId?: string;
+  readonly modelId: string;
+  readonly baseUrl?: string | null;
+}
+export interface ModelKnowledge {
+  readonly host: string;
+  /** Which evidence chose the entry: the serving host, the model's vendor or cross-host consensus. */
+  readonly basis: "host" | "vendor" | "consensus";
+  readonly contextWindow?: number;
+  readonly maxOutputTokens?: number;
+  readonly imageInput: boolean;
+  readonly reasoning: boolean;
+  readonly imageOutput: boolean;
+  readonly textOutput: boolean;
+  readonly reasoningLevels: readonly string[];
+}
+type Entry = readonly [string, number, number, number, string];
+
+const normalise = (id: string) => id.trim().toLowerCase().replace(/\./g, "-");
+const lastSegment = (id: string) => id.slice(id.lastIndexOf("/") + 1);
+
+/** Variant spellings that name the same underlying model; tried only after the exact id. */
+const VARIANT_SUFFIXES = [/-thinking$/u, /-latest$/u, /:(?:free|beta|thinking|latest)$/u, /-\d{8}$/u, /-\d{4}-\d{2}-\d{2}$/u];
+
+function keys(modelId: string): string[] {
+  const base = normalise(lastSegment(modelId));
+  const out = [base];
+  for (const suffix of VARIANT_SUFFIXES) {
+    const stripped = base.replace(suffix, "");
+    if (stripped !== base && !out.includes(stripped)) out.push(stripped);
+  }
+  return out;
+}
+
+/** Connections whose host is fixed by their template (official clients and subscriptions). */
+const TEMPLATE_HOSTS: Readonly<Record<string, readonly string[]>> = {
+  "fleet-claude-native": ["anthropic"],
+  "fleet-chatgpt-native": ["openai-codex", "openai"],
+  "fleet-openai-codex": ["openai-codex", "openai"],
+  "fleet-kimi-cli-native": ["kimi-coding", "moonshotai"],
+  "fleet-xai": ["xai"],
+  "fleet-github-copilot": ["github-copilot"],
+};
+/** Routing prefixes inside model ids (OpenCode `opencode-go/…`, Kimi CLI `kimi-code/…`). */
+const PREFIX_HOSTS: Readonly<Record<string, string>> = {
+  "opencode-go": "opencode-go",
+  opencode: "opencode",
+  "kimi-code": "kimi-coding",
+  deepseek: "deepseek",
+  openai: "openai",
+  anthropic: "anthropic",
+  google: "google",
+  "x-ai": "xai",
+  xai: "xai",
+  moonshotai: "moonshotai",
+  zai: "zai",
+  "z-ai": "zai",
+  minimax: "minimax",
+  xiaomi: "xiaomi",
+  mistralai: "mistral",
+  mistral: "mistral",
+};
+/** The vendor that publishes each family; its own API states the model's native limits. */
+const VENDOR_HOSTS: readonly (readonly [RegExp, string])[] = [
+  [/^claude/u, "anthropic"],
+  [/^(?:gpt|o\d|chatgpt|codex)/u, "openai"],
+  [/^(?:gemini|gemma)/u, "google"],
+  [/^grok/u, "xai"],
+  [/^deepseek/u, "deepseek"],
+  [/^glm/u, "zai"],
+  [/^(?:kimi|k\d|moonshot)/u, "moonshotai"],
+  [/^mimo/u, "xiaomi"],
+  [/^minimax/u, "minimax"],
+  [/^(?:qwen|qwq)/u, "qwen-token-plan"],
+  [/^(?:mistral|codestral|devstral|magistral|ministral)/u, "mistral"],
+];
+
+function baseUrlHost(baseUrl: string | null | undefined): string | undefined {
+  if (!baseUrl) return undefined;
+  const wanted = baseUrl.trim().replace(/\/+$/u, "").toLowerCase();
+  let best: { host: string; length: number } | undefined;
+  for (const [host, urls] of Object.entries(MODEL_KNOWLEDGE_HOSTS))
+    for (const url of urls) {
+      const known = url.toLowerCase();
+      // Longest matching prefix wins: opencode.ai/zen/go is OpenCode Go, not OpenCode Zen.
+      if ((wanted === known || wanted.startsWith(`${known}/`)) && known.length > (best?.length ?? 0))
+        best = { host, length: known.length };
+    }
+  return best?.host;
+}
+
+function mode(values: number[]): number | undefined {
+  const counts = new Map<number, number>();
+  for (const value of values) if (value > 0) counts.set(value, (counts.get(value) ?? 0) + 1);
+  let chosen: number | undefined;
+  for (const [value, count] of counts)
+    if (chosen === undefined || count > counts.get(chosen)! || (count === counts.get(chosen) && value < chosen))
+      chosen = value;
+  return chosen;
+}
+
+function toKnowledge(entry: Entry, basis: ModelKnowledge["basis"]): ModelKnowledge {
+  const [host, context, output, flags, levels] = entry;
+  return {
+    host,
+    basis,
+    ...(context > 0 ? { contextWindow: context } : {}),
+    ...(output > 0 ? { maxOutputTokens: output } : {}),
+    imageInput: (flags & 1) !== 0,
+    reasoning: (flags & 2) !== 0,
+    imageOutput: (flags & 4) !== 0,
+    textOutput: (flags & 8) !== 0,
+    reasoningLevels: levels ? levels.split(",") : [],
+  };
+}
+
+export function lookupModelKnowledge(input: ModelKnowledgeInput): ModelKnowledge | undefined {
+  let entries: readonly Entry[] | undefined;
+  let matchedKey = "";
+  for (const key of keys(input.modelId)) {
+    entries = MODEL_KNOWLEDGE[key];
+    if (entries?.length) {
+      matchedKey = key;
+      break;
+    }
+  }
+  if (!entries?.length) return undefined;
+  const prefixes = input.modelId.toLowerCase().split("/").slice(0, -1);
+  const hosted = [
+    ...prefixes.map((prefix) => PREFIX_HOSTS[prefix]).filter((host): host is string => !!host),
+    ...(input.templateId ? (TEMPLATE_HOSTS[input.templateId] ?? []) : []),
+    ...(baseUrlHost(input.baseUrl) ? [baseUrlHost(input.baseUrl)!] : []),
+  ];
+  for (const host of hosted) {
+    const entry = entries.find((candidate) => candidate[0] === host);
+    if (entry) return toKnowledge(entry, "host");
+  }
+  const vendor = VENDOR_HOSTS.find(([pattern]) => pattern.test(matchedKey))?.[1];
+  const own = vendor ? entries.find((candidate) => candidate[0] === vendor) : undefined;
+  if (own) return toKnowledge(own, "vendor");
+  const flags = entries.reduce((all, entry) => all | entry[3], 0);
+  const levelCounts = new Map<string, number>();
+  for (const entry of entries) if (entry[4]) levelCounts.set(entry[4], (levelCounts.get(entry[4]) ?? 0) + 1);
+  const levels = [...levelCounts].sort((a, b) => b[1] - a[1])[0]?.[0] ?? "";
+  return toKnowledge(
+    [
+      "consensus",
+      mode(entries.map((entry) => entry[1])) ?? 0,
+      mode(entries.map((entry) => entry[2])) ?? 0,
+      flags,
+      levels,
+    ],
+    "consensus",
+  );
+}
+
+/**
+ * The catalog's facts as a model-config layer. Only facts the catalog states are set; reasoning
+ * levels stay with curated/request-mapped rules because their values must map to request fields.
+ */
+export function modelKnowledgeConfig(input: ModelKnowledgeInput): ModelConfigObject | undefined {
+  const knowledge = lookupModelKnowledge(input);
+  if (!knowledge) return undefined;
+  return {
+    properties: {
+      ...(knowledge.contextWindow ? { contextWindow: knowledge.contextWindow } : {}),
+      inputFormat: { supportsText: true, supportsImage: knowledge.imageInput },
+      ...(knowledge.imageOutput
+        ? { outputFormat: { supportsText: knowledge.textOutput, supportsImage: true } }
+        : {}),
+    },
+    ...(knowledge.maxOutputTokens
+      ? { optionSpecs: { maxOutputTokens: { max: knowledge.maxOutputTokens } } }
+      : {}),
+  };
+}
