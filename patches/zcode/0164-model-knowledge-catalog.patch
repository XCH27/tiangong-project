diff --git a/scripts/generate-model-knowledge.mjs b/scripts/generate-model-knowledge.mjs
new file mode 100644
index 0000000..c2aa829
--- /dev/null
+++ b/scripts/generate-model-knowledge.mjs
@@ -0,0 +1,61 @@
+#!/usr/bin/env node
+// Regenerates packages/provider/src/model-knowledge.generated.ts from the model catalog that the
+// installed @earendil-works/pi-ai already ships (MIT; derived from models.dev and OpenRouter).
+// Run after upgrading pi-ai: `node scripts/generate-model-knowledge.mjs`.
+import { readFile, realpath, writeFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const root = resolve(import.meta.dirname, "..");
+// pi-ai is ESM-only and hides package.json from its exports map; read the copy services installs.
+const piRoot = await realpath(join(root, "packages/services/node_modules/@earendil-works/pi-ai")).catch(
+  () => realpath(join(root, "node_modules/@earendil-works/pi-ai")),
+);
+const { version } = JSON.parse(await readFile(join(piRoot, "package.json"), "utf8"));
+const { MODELS, IMAGE_MODELS } = await import(
+  pathToFileURL(join(piRoot, "dist/models.generated.js")).href
+);
+
+// Same normalisation as runtime lookup (model-knowledge.ts): vendor path dropped, case and
+// dot/hyphen version spelling unified ("claude-sonnet-4.6" ≡ "claude-sonnet-4-6").
+const key = (id) => id.slice(id.lastIndexOf("/") + 1).trim().toLowerCase().replace(/\./g, "-");
+const LEVELS = ["minimal", "low", "medium", "high", "xhigh", "max"];
+
+const hosts = {};
+const models = {};
+function add(model, kind) {
+  const host = model.provider;
+  if (model.baseUrl) (hosts[host] ??= new Set()).add(model.baseUrl.replace(/\/+$/, ""));
+  const input = model.input ?? ["text"];
+  const output = model.output ?? (kind === "image" ? ["image"] : ["text"]);
+  // Bits: 1 image input · 2 reasoning · 4 image output · 8 text output.
+  const flags =
+    (input.includes("image") ? 1 : 0) |
+    (model.reasoning ? 2 : 0) |
+    (output.includes("image") ? 4 : 0) |
+    (output.includes("text") ? 8 : 0);
+  const levels = model.thinkingLevelMap
+    ? LEVELS.filter((level) => model.thinkingLevelMap[level] != null).join(",")
+    : "";
+  const entry = [host, model.contextWindow ?? 0, model.maxTokens ?? 0, flags, levels];
+  const list = (models[key(model.id)] ??= []);
+  if (!list.some((existing) => existing[0] === host)) list.push(entry);
+}
+for (const provider of Object.values(MODELS)) for (const model of Object.values(provider)) add(model, "chat");
+for (const provider of Object.values(IMAGE_MODELS)) for (const model of Object.values(provider)) add(model, "image");
+
+const sortedHosts = Object.fromEntries(
+  Object.entries(hosts)
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([host, urls]) => [host, [...urls].filter((url) => !url.includes("{")).sort()]),
+);
+const sortedModels = Object.fromEntries(Object.entries(models).sort(([a], [b]) => a.localeCompare(b)));
+const output = `// Generated by scripts/generate-model-knowledge.mjs from @earendil-works/pi-ai ${version}; do not edit.
+// Entry: [host, contextWindow, maxOutputTokens, flags, reasoningLevels]; flags 1 image-in · 2 reasoning ·
+// 4 image-out · 8 text-out. Zero means the source did not state the value.
+export const MODEL_KNOWLEDGE_SOURCE = "@earendil-works/pi-ai ${version}";
+export const MODEL_KNOWLEDGE_HOSTS: Readonly<Record<string, readonly string[]>> = JSON.parse(${JSON.stringify(JSON.stringify(sortedHosts))});
+export const MODEL_KNOWLEDGE: Readonly<Record<string, readonly (readonly [string, number, number, number, string])[]>> = JSON.parse(${JSON.stringify(JSON.stringify(sortedModels))});
+`;
+await writeFile(join(root, "packages/provider/src/model-knowledge.generated.ts"), output);
+console.log(`model knowledge: ${Object.keys(sortedModels).length} models, ${Object.keys(sortedHosts).length} hosts (pi-ai ${version})`);
