diff --git a/packages/services/test/model-knowledge.test.ts b/packages/services/test/model-knowledge.test.ts
new file mode 100644
index 0000000..58259fb
--- /dev/null
+++ b/packages/services/test/model-knowledge.test.ts
@@ -0,0 +1,96 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import { lookupModelKnowledge } from "../../provider/src/model-knowledge.js";
+import { parseZCodeBuiltinModelConfigRules } from "../../provider/src/config/schema.js";
+
+const builtin = async () =>
+  parseZCodeBuiltinModelConfigRules(
+    JSON.parse(
+      await readFile(
+        fileURLToPath(new URL("../../../config/provider/zcode-builtin.json", import.meta.url)),
+        "utf8",
+      ),
+    ).config.modelConfigRules,
+  );
+
+test("catalog prefers the serving host, then the vendor, then cross-host consensus", () => {
+  // OpenCode Go routes by id prefix; its own entry wins over other hosts of the same model.
+  assert.equal(lookupModelKnowledge({ modelId: "opencode-go/gpt-6-luna" })?.host, "opencode-go");
+  assert.equal(lookupModelKnowledge({ modelId: "opencode-go/gpt-6-luna" })?.contextWindow, 1050000);
+  // The ChatGPT subscription host states its own (smaller) limit for the same model.
+  const codex = lookupModelKnowledge({ modelId: "gpt-6-luna", templateId: "fleet-chatgpt-native" });
+  assert.equal(codex?.host, "openai-codex");
+  assert.equal(codex?.contextWindow, 272000);
+  // A custom API connection is matched by its base URL; the longest known prefix wins.
+  assert.equal(
+    lookupModelKnowledge({ modelId: "glm-5.3", baseUrl: "https://opencode.ai/zen/go/v1/" })?.host,
+    "opencode-go",
+  );
+  // Without a host, the vendor's own API states the model.
+  const gemini = lookupModelKnowledge({ modelId: "gemini-3.8-flash", templateId: "fleet-antigravity-native" });
+  assert.equal(gemini?.basis, "vendor");
+  assert.equal(gemini?.host, "google");
+  assert.equal(gemini?.imageInput, true);
+});
+
+test("catalog matches spelling variants of the same model", () => {
+  // Copilot spells versions with dots, Anthropic with hyphens.
+  assert.equal(lookupModelKnowledge({ modelId: "claude-sonnet-4.6" })?.contextWindow, 1000000);
+  assert.equal(lookupModelKnowledge({ modelId: "Anthropic/Claude-Sonnet-4-6" })?.host, "anthropic");
+  // A -thinking variant names the same model.
+  assert.equal(lookupModelKnowledge({ modelId: "claude-opus-4-6-thinking" })?.contextWindow, 1000000);
+  assert.equal(lookupModelKnowledge({ modelId: "definitely-not-a-model-xyz" }), undefined);
+});
+
+test("catalog facts replace the placeholder but never curated rules, provider facts or corrections", async () => {
+  const rules = await builtin();
+  const unknownHost = { providerId: "p", modelId: "opencode-go/hy3", templateId: "fleet-opencode-native" };
+  assert.equal(rules.resolve(unknownHost).properties?.contextWindow, 256000);
+  assert.equal(rules.resolveEvidence(unknownHost).properties?.contextWindow, 256000);
+  assert.equal(rules.resolveCuratedEvidence(unknownHost).properties?.contextWindow, undefined);
+  // A model nobody knows keeps the explicit placeholder and no evidence.
+  const nobody = { providerId: "p", modelId: "definitely-not-a-model-xyz" };
+  assert.equal(rules.resolve(nobody).properties?.contextWindow, 200000);
+  assert.equal(rules.resolveEvidence(nobody).properties?.contextWindow, undefined);
+  // The catalog layer is never written back into the builtin file shape.
+  assert.ok(!JSON.stringify(rules.toZCodeBuiltinJSON()).includes("knowledge"));
+});
+
+test("generation, speech, transcription and embedding models are recognised and kept out of chat", async () => {
+  const rules = await builtin();
+  const output = (modelId: string) =>
+    rules.resolve({ providerId: "p", modelId }).properties?.outputFormat;
+  for (const id of ["veo-3.1-generate-preview", "kling-v2.6-pro", "doubao-seedance-1-0-pro", "MiniMax-Hailuo-02", "wan2.6-t2v", "sora-2"])
+    assert.deepEqual([id, output(id)?.supportsVideo, output(id)?.supportsText], [id, true, false]);
+  for (const id of ["gpt-image-2", "doubao-seedream-4-0", "black-forest-labs/flux.2-pro", "qwen-image-plus", "imagen-4.0-generate-001", "cogview-4"])
+    assert.deepEqual([id, output(id)?.supportsImage, output(id)?.supportsText], [id, true, false]);
+  // Chat models that can also draw stay chat models.
+  assert.deepEqual(
+    [output("gemini-3-pro-image-preview")?.supportsImage, output("gemini-3-pro-image-preview")?.supportsText],
+    [true, true],
+  );
+  assert.equal(output("gpt-4o-mini-tts")?.supportsSpeech, true);
+  assert.equal(output("whisper-1")?.supportsTranscription, true);
+  assert.equal(output("text-embedding-3-large")?.supportsText, false);
+  assert.equal(output("BAAI/bge-reranker-v2-m3")?.supportsText, false);
+  // Ordinary chat models are untouched by these patterns.
+  for (const id of ["gpt-6-luna", "kimi-k3", "deepseek-v4-pro", "grok-4.7", "glm-5.3"])
+    assert.equal(output(id)?.supportsText, true, id);
+});
+
+test("the shipped catalog snapshot matches the installed pi-ai release", async () => {
+  const { MODEL_KNOWLEDGE_SOURCE } = await import("../../provider/src/model-knowledge.generated.js");
+  const installed = JSON.parse(
+    await readFile(
+      fileURLToPath(new URL("../../../node_modules/@earendil-works/pi-ai/package.json", import.meta.url)),
+      "utf8",
+    ),
+  ).version;
+  assert.equal(
+    MODEL_KNOWLEDGE_SOURCE,
+    `@earendil-works/pi-ai ${installed}`,
+    "Run node scripts/generate-model-knowledge.mjs after upgrading pi-ai",
+  );
+});
