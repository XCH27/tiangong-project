diff --git a/packages/services/test/subscription-bundle.test.ts b/packages/services/test/subscription-bundle.test.ts
new file mode 100644
index 0000000..ea64b21
--- /dev/null
+++ b/packages/services/test/subscription-bundle.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { promisify } from "node:util";
+import test from "node:test";
+import { build } from "esbuild";
+
+const run = promisify(execFile);
+const fixture = `
+import assert from "node:assert/strict";
+import { createSubscriptionConnections } from "./packages/services/src/model-provider/subscriptionConnections.ts";
+const requests = [];
+const jwt = "test." + Buffer.from(JSON.stringify({
+  "https://api.openai.com/auth": { chatgpt_account_id: "fixture-account" }
+})).toString("base64url") + ".signature";
+globalThis.fetch = async (input, init) => {
+  const url = String(input);
+  requests.push(url);
+  init?.signal?.throwIfAborted();
+  if (url === "https://auth.openai.com/api/accounts/deviceauth/usercode")
+    return Response.json({ device_auth_id: "fixture-device", user_code: "CODEX", interval: 60 });
+  if (url === "https://github.com/login/device/code")
+    return Response.json({ device_code: "fixture-device", user_code: "COPILOT", verification_uri: "https://github.com/login/device", interval: 60, expires_in: 900 });
+  if (url === "https://auth.openai.com/api/accounts/deviceauth/token")
+    return new Response(null, { status: 403 });
+  if (url === "https://auth.openai.com/oauth/token") {
+    assert.equal(new URLSearchParams(init.body).get("grant_type"), "refresh_token");
+    return Response.json({ access_token: jwt, refresh_token: "refreshed", expires_in: 3600 });
+  }
+  if (url === "https://api.github.com/copilot_internal/v2/token")
+    return Response.json({ token: "fixture;proxy-ep=proxy.individual.githubcopilot.com", expires_at: Math.floor(Date.now()/1000) + 3600 });
+  if (url === "https://api.individual.githubcopilot.com/models")
+    return Response.json({ data: [{ id: "gpt-4.1", model_picker_enabled: true, policy: { state: "enabled" } }] });
+  throw new Error("Unexpected network request: " + url);
+};
+const records = new Map();
+const owner = createSubscriptionConnections({
+  credentials: {
+    load: async id => records.get(id) ?? null,
+    save: async (id, data) => { records.set(id, data); },
+    delete: async id => { records.delete(id); },
+  },
+  getView: async () => ({ providers: ["openai-codex", "github-copilot"].map(providerId => ({
+    providerId, effectiveConfig: { access: { type: "subscription", provider: providerId } }
+  })) }),
+  setConnected: async () => {},
+  withConnectionLock: async (_id, operation) => operation(),
+});
+for (const kind of ["openai-codex", "github-copilot"]) {
+  const flow = await owner.begin(kind);
+  assert.equal(flow.userCode, kind === "openai-codex" ? "CODEX" : "COPILOT");
+  const finished = assert.rejects(owner.finish(kind, flow.flowId), /cancel|abort/i);
+  await owner.cancel(kind, flow.flowId);
+  await finished;
+  assert.equal(JSON.parse(records.get("model-subscription:" + kind)).pendingFlowId, undefined);
+  records.set("model-subscription:" + kind, JSON.stringify({
+    kind, credential: { type: "oauth", access: "expired", refresh: "fixture-refresh", expires: 1, accountId: "fixture-account" }
+  }));
+  const auth = await owner.resolve(kind);
+  assert.notEqual(auth.apiKey, "expired");
+  if (kind === "openai-codex") assert.equal(auth.headers["chatgpt-account-id"], "fixture-account");
+  else assert.equal(auth.baseUrl, "https://api.individual.githubcopilot.com");
+}
+assert.equal(requests.length, 6);
+console.log("Bundled Codex and Copilot device flow, cancellation, refresh and request auth passed");
+`;
+
+for (const minify of [false, true]) {
+  test(`isolated ${minify ? "production" : "development"} bundle loads real OAuth drivers`, async () => {
+    const directory = await mkdtemp(join(tmpdir(), "fleet-subscription-bundle-"));
+    try {
+      const entry = join(directory, "index.mjs");
+      await build({
+        stdin: {
+          contents: fixture,
+          loader: "ts",
+          resolveDir: resolve(import.meta.dirname, "../../.."),
+        },
+        bundle: true,
+        platform: "node",
+        format: "esm",
+        target: "node22",
+        minify,
+        outfile: entry,
+        logLevel: "silent",
+      });
+      // 在仓库外启动真实产物：不能意外从源码树/node_modules 补回漏打包的 OAuth 文件。
+      const result = await run(process.execPath, [entry], {
+        cwd: directory,
+        env: { PATH: process.env.PATH },
+        timeout: 20_000,
+      });
+      assert.match(result.stdout, /Bundled Codex and Copilot/);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+}
