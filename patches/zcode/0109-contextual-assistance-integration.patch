+++ b/packages/services/test/page-assistant.test.ts
@@ -0,0 +1,379 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import {
+  PAGE_ASSISTANT_PAGE_IDS,
+  pageAssistantTargetSchema,
+  pageAssistantTools,
+  PageAssistantOperationError,
+} from "@zcode/shared";
+import { assertPageAssistantSessionScope } from "../src/page-assistant/pageAssistantScope.js";
+import { createPageAssistantService } from "../src/page-assistant/pageAssistantService.js";
+import { createSettingService } from "../src/setting/settingService.js";
+import { createObservableSettingService } from "../src/setting/observableSettingService.js";
+import type {
+  IModelSelectionService,
+  ModelPreferences,
+  ModelPreferencesPatch,
+} from "../src/model-provider/modelSelectionService.js";
+
+const general = { feature: "app-page" as const, pageId: "general" as const };
+async function fixture() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-page-preferences-"));
+  const originalProfile = process.env.ZCODE_DESKTOP_HOME_DIR;
+  process.env.ZCODE_DESKTOP_HOME_DIR = dir;
+  const setting = createObservableSettingService(createSettingService());
+  await setting.update({
+    httpProxy: "private-proxy",
+    terminalFontFamily: "private-font",
+    modelIoFullRetentionEnabled: true,
+  });
+  let preferences: ModelPreferences = { revision: "one", favoriteModelSelections: [] };
+  const saves: ModelPreferencesPatch[] = [];
+  const selection = {
+    async getPreferences() {
+      return structuredClone(preferences);
+    },
+    async savePreferences(patch: ModelPreferencesPatch) {
+      if (patch.expectedRevision !== preferences.revision)
+        throw Object.assign(new Error("changed"), { code: "model_preference_conflict" });
+      saves.push(structuredClone(patch));
+      preferences = {
+        ...preferences,
+        revision: String(saves.length + 1),
+        ...(patch.defaultModelSelection === undefined
+          ? {}
+          : { defaultModelSelection: patch.defaultModelSelection ?? undefined }),
+        ...(patch.pageAssistantDefaultModelSelection === undefined
+          ? {}
+          : {
+              pageAssistantDefaultModelSelection:
+                patch.pageAssistantDefaultModelSelection ?? undefined,
+            }),
+      };
+      return structuredClone(preferences);
+    },
+    async getView() {
+      return {
+        revision: 1,
+        providers: [
+          {
+            providerId: "fixture",
+            providerName: "Fixture",
+            config: { apiKey: "PRIVATE-CATALOG-KEY" },
+            models: Array.from({ length: 40 }, (_, index) => ({
+              modelId: `model-${index}`,
+              config: {},
+              evidenceConfig: {
+                optionSpecs: { reasoningLevel: { values: ["low", "high"], map: "PRIVATE-MAP" } },
+              },
+            })),
+          },
+        ],
+      };
+    },
+  } as unknown as IModelSelectionService;
+  const service = createPageAssistantService({
+    settingService: setting,
+    modelSelectionService: selection,
+    providerSettingsService: {
+      async modelSettingsAssistantContext(providerId: string, modelId?: string) {
+        return {
+          workspacePath: dir,
+          view: { target: { feature: "model-settings", providerId, modelId, openingRevision: 9 } },
+        };
+      },
+    } as never,
+    workspacePath: () => dir,
+  });
+  return {
+    dir,
+    setting,
+    service,
+    selection,
+    saves,
+    disk: () => readFile(join(dir, ".zcode/v2/setting.json"), "utf8"),
+    async close() {
+      if (originalProfile === undefined) delete process.env.ZCODE_DESKTOP_HOME_DIR;
+      else process.env.ZCODE_DESKTOP_HOME_DIR = originalProfile;
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test("every declared page has a bounded context and only General/Usage publish their real scoped operations", async () => {
+  const f = await fixture();
+  try {
+    for (const pageId of PAGE_ASSISTANT_PAGE_IDS) {
+      const target = { feature: "app-page" as const, pageId };
+      const value = await f.service.perform(target, { operation: "read" });
+      assert.equal(value.target.pageId, pageId);
+      assert.ok(value.description.length < 1500);
+      assert.equal(JSON.stringify(value).includes("private-proxy"), false);
+      assert.equal(JSON.stringify(value).includes("private-font"), false);
+      assert.equal(JSON.stringify(value).includes("modelIoFullRetention"), false);
+      assert.equal(pageAssistantTools(target).includes("Bash"), false);
+      assert.equal(pageAssistantTools(target).includes("SetPagePreference"), pageId === "general");
+      assert.equal(pageAssistantTools(target).includes("ReadUsageStats"), pageId === "usage");
+      if (pageId !== "general") assert.deepEqual(value.preferences, []);
+    }
+    assert.equal(
+      pageAssistantTargetSchema.safeParse({ feature: "app-page", pageId: "imaginary" }).success,
+      false,
+    );
+    const context = await f.service.getContext({ feature: "app-page", pageId: "plugins" } as never);
+    assert.equal(context.target.feature === "app-page" && context.target.pageId, "plugin-store");
+  } finally {
+    await f.close();
+  }
+});
+
+test("preference writes share the real Setting queue, preserve unrelated values and emit only after commit", async () => {
+  const f = await fixture();
+  try {
+    const before = await f.setting.get();
+    const changes: unknown[] = [];
+    const subscription = f.service.onDidChange((event) => changes.push(event));
+    const result = await f.service.perform(general, {
+      operation: "set-preference",
+      key: "keepAwakeWhileRunning",
+      value: true,
+      expectedValue: false,
+    });
+    assert.equal(
+      result.preferences.find((row) => row.key === "keepAwakeWhileRunning")!.value,
+      true,
+    );
+    const saved = await f.setting.get();
+    assert.deepEqual(saved, { ...before, keepAwakeWhileRunning: true });
+    assert.deepEqual(changes, [{ kind: "preferences", keys: ["keepAwakeWhileRunning"] }]);
+    const disk = await f.disk();
+    await assert.rejects(
+      f.service.perform(general, {
+        operation: "set-preference",
+        key: "keepAwakeWhileRunning",
+        value: false,
+        expectedValue: false,
+      }),
+      /conflict/,
+    );
+    assert.equal(await f.disk(), disk);
+    assert.equal(changes.length, 1);
+    subscription.dispose();
+  } finally {
+    await f.close();
+  }
+});
+
+test("human and Agent writes from the same observed preference do not overwrite one another", async () => {
+  const f = await fixture();
+  try {
+    const results = await Promise.allSettled([
+      f.setting.update({ keepAwakeWhileRunning: true }),
+      f.service.perform(general, {
+        operation: "set-preference",
+        key: "keepAwakeWhileRunning",
+        value: false,
+        expectedValue: false,
+      }),
+    ]);
+    assert.equal(results[0]!.status, "fulfilled");
+    assert.equal(results[1]!.status, "rejected");
+    assert.equal((await f.setting.get()).keepAwakeWhileRunning, true);
+    const reopened = createSettingService();
+    assert.equal((await reopened.get()).keepAwakeWhileRunning, true);
+  } finally {
+    await f.close();
+  }
+});
+
+test("language changes atomically update preference and effective locale; unsupported system does not write", async () => {
+  const f = await fixture();
+  try {
+    const value = await f.service.perform(general, {
+      operation: "set-preference",
+      key: "localePreference",
+      value: "en-US",
+      expectedValue: "system",
+    });
+    assert.equal(value.effectiveLocale, "en-US");
+    assert.equal((await f.setting.get()).localePreference, "en-US");
+    const disk = await f.disk();
+    await assert.rejects(
+      f.service.perform(general, {
+        operation: "set-preference",
+        key: "localePreference",
+        value: "system",
+        expectedValue: "en-US",
+      }),
+      (error) =>
+        error instanceof PageAssistantOperationError &&
+        error.reasonCode === "preference_unsupported",
+    );
+    assert.equal(await f.disk(), disk);
+  } finally {
+    await f.close();
+  }
+});
+
+test("foreign-page, sensitive, malformed and unavailable-host preference calls have no effects", async () => {
+  const f = await fixture();
+  try {
+    const disk = await f.disk();
+    await assert.rejects(
+      f.service.perform(
+        { feature: "app-page", pageId: "appearance" },
+        {
+          operation: "set-preference",
+          key: "messageStreamShowReasoning",
+          value: false,
+          expectedValue: true,
+        },
+      ),
+      /outside_target/,
+    );
+    for (const command of [
+      { operation: "set-preference", key: "httpProxy", value: "changed", expectedValue: null },
+      { operation: "set-preference", key: "memoryEnabled", value: true, expectedValue: false },
+      {
+        operation: "set-preference",
+        key: "keepAwakeWhileRunning",
+        value: "yes",
+        expectedValue: false,
+      },
+      {
+        operation: "set-preference",
+        key: "keepAwakeWhileRunning",
+        value: true,
+        expectedValue: false,
+        extra: "ignored",
+      },
+    ])
+      await assert.rejects(f.service.perform(general, command as never));
+    await assert.rejects(
+      f.service.perform(
+        { feature: "app-page", pageId: "browser-view" },
+        { operation: "read", modelQuery: "model" },
+      ),
+      /outside_target/,
+    );
+    const unavailable = createPageAssistantService({
+      available: false,
+      settingService: f.setting,
+      modelSelectionService: f.selection,
+      providerSettingsService: {} as never,
+      workspacePath: () => f.dir,
+    });
+    await assert.rejects(unavailable.getContext(general), /unavailable/);
+    assert.equal(await f.disk(), disk);
+  } finally {
+    await f.close();
+  }
+});
+
+test("model defaults use the versioned preference owner and discovery returns only a filtered maximum of 32 safe models", async () => {
+  const f = await fixture();
+  try {
+    const initial = await f.service.perform(general, { operation: "read", modelQuery: "" });
+    assert.equal(initial.models?.length, 32);
+    assert.equal(initial.modelDirectoryTruncated, true);
+    assert.equal(JSON.stringify(initial).includes("PRIVATE-CATALOG-KEY"), false);
+    assert.equal(JSON.stringify(initial).includes("PRIVATE-MAP"), false);
+    const filtered = await f.service.perform(general, {
+      operation: "read",
+      modelQuery: "model-39",
+    });
+    assert.deepEqual(
+      filtered.models?.map((model) => model.modelId),
+      ["model-39"],
+    );
+    const selection = {
+      providerId: "fixture",
+      modelId: "model-39",
+      options: { reasoningLevel: "high" },
+    };
+    await f.service.perform(general, {
+      operation: "set-model-default",
+      purpose: "page-assistant",
+      selection,
+      expectedRevision: "one",
+    });
+    assert.deepEqual(f.saves, [
+      { expectedRevision: "one", pageAssistantDefaultModelSelection: selection },
+    ]);
+    assert.deepEqual((await f.service.getContext(general)).defaultModelSelection, selection);
+    const settings = await f.disk();
+    await assert.rejects(
+      f.service.perform(general, {
+        operation: "set-model-default",
+        purpose: "conversation",
+        selection,
+        expectedRevision: "one",
+      }),
+      /changed/,
+    );
+    await assert.rejects(
+      f.service.perform(
+        { feature: "app-page", pageId: "usage" },
+        {
+          operation: "set-model-default",
+          purpose: "conversation",
+          selection,
+          expectedRevision: "2",
+        },
+      ),
+      /outside_target/,
+    );
+    assert.equal(await f.disk(), settings);
+    assert.equal(f.saves.length, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("the reverse-operation scope uses original transport and exact persisted Session target before a writer", async () => {
+  const workspace = { workspacePath: "/fixture/conversations" };
+  const reads: string[] = [];
+  const input = {
+    workspace,
+    expectedWorkspacePath: workspace.workspacePath,
+    sessionId: "session-a",
+    requestedTarget: general,
+    async readTarget(id: string) {
+      reads.push(id);
+      return general;
+    },
+  };
+  await assertPageAssistantSessionScope(input);
+  assert.deepEqual(reads, ["session-a"]);
+  await assert.rejects(
+    assertPageAssistantSessionScope({
+      ...input,
+      workspace: { ...workspace, workspaceIdentity: "remote:actor" },
+    }),
+    /unavailable/,
+  );
+  await assert.rejects(
+    assertPageAssistantSessionScope({
+      ...input,
+      workspace: { ...workspace, remoteSessionId: "foreign" },
+    }),
+    /unavailable/,
+  );
+  await assert.rejects(
+    assertPageAssistantSessionScope({ ...input, workspace: { workspacePath: "/foreign" } }),
+    /unavailable/,
+  );
+  assert.deepEqual(reads, ["session-a"]);
+  for (const value of [
+    undefined,
+    { feature: "app-page", pageId: "appearance" },
+    { feature: "app-page", pageId: "unknown" },
+  ])
+    await assert.rejects(
+      assertPageAssistantSessionScope({ ...input, readTarget: async () => value }),
+      /target_mismatch/,
+    );
+});
