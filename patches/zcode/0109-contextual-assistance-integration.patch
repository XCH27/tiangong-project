+  await act(async () => {
+    button.dispatchEvent(new MouseEvent("mousedown", { bubbles: true, button: 0 }));
+    button.click();
+  });
+}
+const visibleIds = (container: HTMLElement) =>
+  [...container.querySelectorAll<HTMLElement>("[data-model-provider-model-id]")].map(
+    (element) => element.dataset.modelProviderModelId,
+  );
+const options = (container: HTMLElement) =>
+  [...container.querySelectorAll<HTMLElement>("[data-provider-catalog-filter]")].map(
+    (element) => element.dataset.providerCatalogFilter,
+  );
+function selected(container: HTMLElement) {
+  return container.querySelector<HTMLElement>(
+    '[data-provider-catalog-filter][aria-selected="true"]',
+  )?.dataset.providerCatalogFilter;
+}
+
+async function run() {
+  const results: { name: string; error?: string }[] = [];
+  for (const locale of ["zh-CN", "en-US"] as const) {
+    for (const dark of [false, true]) {
+      document.documentElement.classList.toggle("dark", dark);
+      const f = await fixture(locale);
+      f.container.style.width = "320px";
+      try {
+        const ten = catalog("A", 10);
+        await f.render(ten, 1);
+        check(options(f.container).length === 0, "Ten models showed a filter toolbar");
+        const eleven = catalog("A");
+        await f.render(eleven, 2);
+        check(
+          options(f.container).join() === "all,text,image,video",
+          "Empty or missing capability tabs",
+        );
+        check(visibleIds(f.container).length === 11, "All omitted unknown rows");
+        await select(f.container, "image");
+        check(
+          visibleIds(f.container).join() === "image-only,mixed-image-video",
+          "Image input/name became generation evidence",
+        );
+        check(
+          !f.container.querySelector('[data-model-provider-model-id][role="button"]'),
+          "Type filtering retained partial-catalog drag controls",
+        );
+        const search = f.input('[role="search"] input');
+        await f.type(search, " MIXED ");
+        check(
+          visibleIds(f.container).join() === "mixed-image-video",
+          "Search did not compose with type",
+        );
+        check(
+          options(f.container).join() === "all,text,image,video",
+          "Search changed catalog options",
+        );
+        await f.type(search, "vision");
+        check(visibleIds(f.container).length === 0, "No-match filter fell back to every row");
+        check(
+          f.container.textContent?.includes(locale === "zh-CN" ? "没有匹配" : "No matching"),
+          "Filtered empty state did not explain no matches",
+        );
+        await f.type(search, "");
+
+        // Losing the selected category retires that choice; its later return must not reselect it.
+        const withdrawn = structuredClone(eleven);
+        for (const model of withdrawn.models)
+          model.evidenceConfig = { properties: { outputFormat: { supportsText: true } } };
+        await f.render(withdrawn, 3);
+        check(
+          selected(f.container) === "all" && visibleIds(f.container).length === 11,
+          "Withdrawn type left a hidden filter active",
+        );
+        await f.render(eleven, 4);
+        check(selected(f.container) === "all", "Returning capability revived an obsolete choice");
+        await select(f.container, "video");
+        await f.render(ten, 5);
+        check(
+          options(f.container).length === 0 && visibleIds(f.container).length === 10,
+          "Directory shrink retained an invisible type filter",
+        );
+        await f.render(eleven, 6);
+        check(selected(f.container) === "all", "Directory expansion revived a hidden choice");
+        await select(f.container, "image");
+        await f.render(catalog("B"), 7);
+        check(
+          selected(f.container) === "all" && visibleIds(f.container).length === 11,
+          "Provider switch inherited another provider's filter",
+        );
+        check(
+          f.writes.length + f.modelWrites.length + f.modelActions.length === 0,
+          "Read-only filtering wrote provider data",
+        );
+
+        const list = f.container.querySelector<HTMLElement>(
+          '[data-testid="provider-catalog-filters"] [role="tablist"]',
+        );
+        check(list, "Filter tablist is unavailable");
+        await act(async () => {
+          const all = f.container.querySelector<HTMLButtonElement>(
+            '[data-provider-catalog-filter="all"]',
+          )!;
+          all.focus();
+          all.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowRight", bubbles: true }));
+          // Radix posts roving focus with setTimeout; a RAF alone can finish before that job.
+          await new Promise<void>((resolve) => setTimeout(resolve, 0));
+          await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+        });
+        check(
+          (document.activeElement as HTMLElement | null)?.dataset.providerCatalogFilter === "text",
+          "Keyboard navigation did not focus the next type",
+        );
+        check(
+          selected(f.container) === "text",
+          "Keyboard navigation did not activate the next type",
+        );
+        check(
+          list.scrollWidth <= list.clientWidth + 1,
+          "Narrow filter tabs overflowed their existing settings layout",
+        );
+        const add = f.container.querySelector<HTMLButtonElement>(
+          `[data-testid="${TID_MODEL_PROVIDER_ADD_MODEL_BUTTON}"]`,
+        );
+        check(add, "Existing manual model entry disappeared");
+        await act(async () => add.click());
+        check(
+          selected(f.container) === "all",
+          "Manual addition left an unknown new model behind a type filter",
+        );
+        check(
+          visibleIds(f.container).length === 11,
+          "Manual addition no longer shows the complete saved catalog",
+        );
+        results.push({
+          name: `${locale} ${dark ? "dark" : "light"}: large catalog filters, recovery, keyboard and narrow layout`,
+        });
+      } catch (error) {
+        results.push({
+          name: `${locale} ${dark ? "dark" : "light"}: large catalog filters`,
+          error: error instanceof Error ? error.stack : String(error),
+        });
+      } finally {
+        await f.close();
+      }
+    }
+  }
+  document.documentElement.classList.remove("dark");
+  return results;
+}
+(
+  window as unknown as { __providerCatalogFilterTests: ReturnType<typeof run> }
+).__providerCatalogFilterTests = run();
diff --git a/packages/ui/test/providerCatalogFilters.test.ts b/packages/ui/test/providerCatalogFilters.test.ts
new file mode 100644
index 0000000..78fb7dc
--- /dev/null
+++ b/packages/ui/test/providerCatalogFilters.test.ts
@@ -0,0 +1,77 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  filterProviderCatalogModels,
+  providerCatalogFilterOptions,
+} from "../src/settings/model-provider-section/providerCatalogFilters.js";
+
+function model(modelId: string, output?: object, input?: object) {
+  return {
+    modelId,
+    evidenceConfig: {
+      properties: {
+        ...(output ? { outputFormat: output } : {}),
+        ...(input ? { inputFormat: input } : {}),
+      },
+    },
+    // Runtime completion defaults must not turn an unknown directory row into text evidence.
+    config: { properties: { outputFormat: { supportsText: true } } },
+  };
+}
+
+test("filters appear after ten unfiltered models and contain only evidenced output types", () => {
+  const catalog = Array.from({ length: 10 }, (_, index) =>
+    model(`text-${index}`, { supportsText: true }),
+  );
+  assert.deepEqual(providerCatalogFilterOptions(catalog), []);
+  catalog.push(model("image", { supportsText: false, supportsImage: true }));
+  assert.deepEqual(providerCatalogFilterOptions(catalog), ["all", "text", "image"]);
+  assert.deepEqual(
+    providerCatalogFilterOptions(
+      Array.from({ length: 11 }, (_, index) => model(`unknown-${index}`)),
+    ),
+    ["all"],
+  );
+  assert.deepEqual(
+    providerCatalogFilterOptions(
+      Array.from({ length: 11 }, (_, index) => model(`text-${index}`, { supportsText: true })),
+    ),
+    ["all", "text"],
+  );
+});
+
+test("mixed outputs belong to each evidenced type while image input and names cannot imply generation", () => {
+  const catalog = [
+    model("mixed", { supportsText: true, supportsImage: true, supportsVideo: true }),
+    model("vision", { supportsText: true }, { supportsImage: true }),
+    model("video-image-speech-transcription"),
+    model("image-off", { supportsText: true, supportsImage: false }),
+  ];
+  assert.deepEqual(
+    filterProviderCatalogModels(catalog, "", "image").map((item) => item.modelId),
+    ["mixed"],
+  );
+  assert.deepEqual(
+    filterProviderCatalogModels(catalog, "", "video").map((item) => item.modelId),
+    ["mixed"],
+  );
+  assert.deepEqual(
+    filterProviderCatalogModels(catalog, "", "text").map((item) => item.modelId),
+    ["mixed", "vision", "image-off"],
+  );
+  assert.deepEqual(filterProviderCatalogModels(catalog, "", "all"), catalog);
+});
+
+test("search composes with type filtering without mutating the catalog or changing options", () => {
+  const catalog = Array.from({ length: 11 }, (_, index) =>
+    model(`row-${index}`, { supportsText: true, supportsImage: index === 4 }),
+  );
+  const before = structuredClone(catalog);
+  assert.deepEqual(
+    filterProviderCatalogModels(catalog, " ROW-4 ", "image").map((item) => item.modelId),
+    ["row-4"],
+  );
+  assert.deepEqual(filterProviderCatalogModels(catalog, "ROW-0", "image"), []);
+  assert.deepEqual(providerCatalogFilterOptions(catalog), ["all", "text", "image"]);
+  assert.deepEqual(catalog, before);
+});
