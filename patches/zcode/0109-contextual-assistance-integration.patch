@@ -0,0 +1,25 @@
+import {
+  pageAssistantTargetSchema,
+  PageAssistantOperationError,
+  type PageAssistantTarget,
+} from "@zcode/shared";
+
+/** Caller scope comes from the original transport, and the target comes from its Session owner. */
+export async function assertPageAssistantSessionScope(input: {
+  workspace: { workspacePath: string; workspaceIdentity?: string; remoteSessionId?: string };
+  expectedWorkspacePath?: string;
+  sessionId: string;
+  requestedTarget: PageAssistantTarget;
+  readTarget(sessionId: string): Promise<unknown>;
+}): Promise<void> {
+  if (
+    input.workspace.workspaceIdentity ||
+    input.workspace.remoteSessionId ||
+    (input.expectedWorkspacePath && input.workspace.workspacePath !== input.expectedWorkspacePath)
+  )
+    throw new PageAssistantOperationError("unavailable");
+  const actual = pageAssistantTargetSchema.safeParse(await input.readTarget(input.sessionId));
+  const requested = pageAssistantTargetSchema.parse(input.requestedTarget);
+  if (!actual.success || JSON.stringify(actual.data) !== JSON.stringify(requested))
+    throw new PageAssistantOperationError("target_mismatch");
+}
diff --git a/packages/services/src/page-assistant/pageAssistantService.ts b/packages/services/src/page-assistant/pageAssistantService.ts
