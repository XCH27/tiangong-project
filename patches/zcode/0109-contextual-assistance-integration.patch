diff --git a/packages/ui/src/ToolCallBlocks/renderers/page-assistant.tsx b/packages/ui/src/ToolCallBlocks/renderers/page-assistant.tsx
new file mode 100644
index 0000000..269058f
--- /dev/null
+++ b/packages/ui/src/ToolCallBlocks/renderers/page-assistant.tsx
@@ -0,0 +1,98 @@
+import { Settings2 } from "lucide-react";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { ToolLayout } from "../ToolLayout.js";
+import { readRawToolCallInput } from "../fileSummaryTypes.js";
+import type { ToolCallBlockRenderContext } from "../shared.js";
+
+export function isPageAssistantToolCall(
+  tool: ToolCallBlockRenderContext["toolCallNode"]["toolCall"],
+) {
+  return [tool.toolName, tool.kind, tool.title].some((name) =>
+    ["ReadPageContext", "SetPagePreference", "SetPageModelDefault"].includes(name ?? ""),
+  );
+}
+const PREFERENCE_LABELS: Record<string, string> = {
+  localePreference: "settings.locale",
+  keepAwakeWhileRunning: "settings.keepAwakeWhileRunning",
+  closeToTrayOnWindows: "settings.closeToTrayOnWindows",
+  proactiveSuggestionsEnabled: "chat.officeSuggestions.setting",
+  messageStreamShowReasoning: "settings.messageStreamShowReasoning",
+  messageStreamShowTodos: "settings.messageStreamShowTodos",
+  toolGroupingExploreEnabled: "settings.toolGroupingExplore",
+  toolGroupingTerminalEnabled: "settings.toolGroupingTerminal",
+  toolGroupingChangesEnabled: "settings.toolGroupingChanges",
+  zcodeInteractionBehavior: "pageAssistant.interactionBehavior",
+};
+export function PageAssistantToolCallBlock(context: ToolCallBlockRenderContext) {
+  const { intl } = useZCodeIntl();
+  const tool = context.toolCallNode.toolCall;
+  const raw = readRawToolCallInput(tool.raw) ?? tool.input;
+  const input = raw && typeof raw === "object" ? (raw as Record<string, unknown>) : {};
+  const defaults = [tool.toolName, tool.kind, tool.title].includes("SetPageModelDefault");
+  const preference = [tool.toolName, tool.kind, tool.title].includes("SetPagePreference");
+  const title = intl.formatMessage({
+    id: defaults
+      ? "pageAssistant.setModelDefault"
+      : preference
+        ? "pageAssistant.setPreference"
+        : "pageAssistant.readContext",
+  });
+  const formatValue = (value: unknown) =>
+    typeof value === "boolean"
+      ? intl.formatMessage({ id: value ? "pageAssistant.enabled" : "pageAssistant.disabled" })
+      : value === "zh-CN"
+        ? "中文简体"
+        : value === "en-US"
+          ? "English"
+          : value === "queue"
+            ? intl.formatMessage({ id: "pageAssistant.queue" })
+            : value === "guide"
+              ? intl.formatMessage({ id: "pageAssistant.guide" })
+              : value == null
+                ? intl.formatMessage({ id: "pageAssistant.unknown" })
+                : String(value);
+  const selected =
+    input.selection && typeof input.selection === "object"
+      ? (input.selection as Record<string, unknown>)
+      : null;
+  const primary = defaults
+    ? `${intl.formatMessage({ id: input.purpose === "page-assistant" ? "settings.modelDefaults.page-assistant" : "settings.modelDefaults.conversation" })} · ${typeof selected?.modelId === "string" ? selected.modelId : intl.formatMessage({ id: input.purpose === "page-assistant" ? "settings.modelDefaults.followConversation" : "settings.modelDefaults.automatic" })}`
+    : preference
+      ? intl.formatMessage({
+          id: PREFERENCE_LABELS[String(input.key)] ?? "pageAssistant.preference",
+        })
+      : null;
+  const reason = context.errorText?.match(/\bpage_assistant\.([a-z_]+)\b/)?.[1];
+  const error = context.errorText
+    ? intl.formatMessage({
+        id: reason ? `pageAssistant.error.${reason}` : "pageAssistant.error.operation_failed",
+      })
+    : undefined;
+  return (
+    <ToolLayout
+      toolId={tool.toolId}
+      icon={<Settings2 className="size-4 text-foreground-subtle" />}
+      showIcon={context.showIcon}
+      kindLabel={context.kindLabelOverride ?? title}
+      primaryText={primary}
+      canToggle={false}
+      forceOpen={preference}
+      secondaryText={
+        context.statusLabel ? (
+          <span className="whitespace-nowrap">{context.statusLabel}</span>
+        ) : undefined
+      }
+      showFailureStatus={tool.status === "failed"}
+      statusLabel={tool.status === "failed" ? context.statusLabel : undefined}
+      statusTooltip={error}
+      title={primary ?? title}
+      content={
+        preference ? (
+          <p className="text-ui-sm text-foreground-subtle">
+            {formatValue(input.expectedValue)} → {formatValue(input.value)}
+          </p>
+        ) : undefined
+      }
+    />
+  );
+}
