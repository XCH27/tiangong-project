+      const triggers = [
+        ...node.querySelectorAll<HTMLButtonElement>("button[data-model-current-value]"),
+      ];
+      check(triggers.length === 2, "The two purpose controls are missing");
+      return triggers;
+    },
+    async close() {
+      await act(async () => root.unmount());
