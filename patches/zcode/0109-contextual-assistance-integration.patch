@@ -0,0 +1,38 @@
+import type { PageAssistantSelection } from "@zcode/shared";
+import type { IntlInstance } from "@/i18n/IntlProvider.js";
+
+const PAGE_LABEL_KEYS: Record<string, string> = {
+  general: "settings.systemTitle",
+  appearance: "settings.appearanceTitle",
+  migration: "settings.migration.title",
+  browser: "settings.browser.title",
+  modelProvider: "settings.modelProviderTitle",
+  memory: "settings.memory",
+  plugin: "settings.plugins.title",
+  mcp: "settings.mcpTitle",
+  skill: "settings.skills.title",
+  usage: "settings.usageTitle",
+  subagents: "settings.subagents.title",
+  commands: "settings.commands.title",
+  hooks: "settings.hooks.title",
+  shortcuts: "settings.shortcuts.title",
+  computerUse: "settings.computerUse.title",
+  workspaceFileSearch: "settings.workspaceFileSearch.title",
+  automations: "pageAssistant.page.automations",
+  "plugin-store": "pageAssistant.page.plugins",
+  workspace: "pageAssistant.page.workspace",
+  conversation: "pageAssistant.page.conversation",
+  project: "pageAssistant.page.project",
+  "browser-view": "pageAssistant.page.browser",
+  "document-preview": "pageAssistant.page.document",
+  search: "pageAssistant.page.search",
+  onboarding: "pageAssistant.page.onboarding",
+};
+export function pageAssistantLabel(intl: IntlInstance, selection: PageAssistantSelection) {
+  if (selection.feature === "model-settings")
+    return selection.modelId ?? intl.formatMessage({ id: "settings.modelProviderTitle" });
+  return (
+    selection.resource?.label ??
+    intl.formatMessage({ id: PAGE_LABEL_KEYS[selection.pageId] ?? "pageAssistant.page.workspace" })
+  );
+}
