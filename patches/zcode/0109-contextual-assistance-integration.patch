--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/page-assistant-lifecycle.test.ts
@@ -0,0 +1,305 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createInMemorySessionEventStore } from "@zcode/contracts";
+import { pageAssistantTargetSchema } from "@zcode/shared";
+import { createSessionRecordForV4, listSessions } from "../src/zcode-protocol/server-operations.js";
+import { sessionMgmtHandlers } from "../src/zcode-protocol-v4/commands/handlers/session-mgmt.js";
+import { CommandInbox } from "../src/zcode-protocol-v4/command-inbox.js";
+import type { ZCodeProtocolAgentServerContext } from "../src/zcode-protocol/server-types.js";
+
+const workspace = {
+  workspaceKey: "/fixture/conversations",
+  workspacePath: "/fixture/conversations",
+};
+const target = { feature: "app-page" as const, pageId: "general" as const };
+function contextFixture() {
+  const options: unknown[] = [];
+  const closed: string[] = [];
+  const context = {
+    deps: {
+      cwd: workspace.workspacePath,
+      createSessionEventStore: () => createInMemorySessionEventStore(),
+      createZCodeApp: async (input: any) => {
+        options.push(input);
+        let selection = {
+          providerId: "fixture",
+          modelId: "original",
+          options: { reasoningLevel: "low" },
+        };
+        return {
+          sessionId: input.sessionId,
+          runtime: {
+            getSessionModelSelection: () => selection,
+            subscribeEvents: () => () => {},
+            emitModelSelected: async () => {},
+          },
+          getMode: () => "build",
+          getModel: () => "fixture/original",
+          getThoughtLevel: () => selection.options.reasoningLevel,
+          listThoughtLevels: () => ["low", "high"],
+          listModels: () => [],
+          setModel: async (value: any) => {
+            if (value.modelId === "missing") throw new Error("requested model unavailable");
+            selection = structuredClone(value);
+            return {};
+          },
+          close: async () => {
+            closed.push(input.sessionId);
+          },
+        };
+      },
+    },
+    appRuntimePreferences: {
+      askUserQuestionAutoResolutionEnabled: true,
+      modelIoFullRetentionEnabled: false,
+      offPeakToolEnabled: false,
+      dynamicWorkflowEnabled: false,
+    },
+    sessions: new Map(),
+    notify() {},
+    assertServing() {},
+    v4Interactions: { async initializeAskUserQuestionAutoResolutionEnabled() {} },
+    requestClient: async () => ({
+      memoryEnabled: false,
+      nativeSearchEnhancementsEnabled: true,
+      askUserQuestionAutoResolutionEnabled: true,
+      modelIoFullRetentionEnabled: false,
+    }),
+  } as unknown as ZCodeProtocolAgentServerContext;
+  return { context, options, closed };
+}
+
+test("each page invocation creates a fresh deferred Session, retaining the exact scoped profile", async () => {
+  const f = contextFixture();
+  const first = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    pageAssistantTarget: target,
+  });
+  const second = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    pageAssistantTarget: target,
+  });
+  assert.notEqual(first.sessionId, second.sessionId);
+  assert.equal(f.context.sessions.size, 2);
+  assert.deepEqual(first.pageAssistantTarget, target);
+  for (const value of f.options as any[]) {
+    assert.deepEqual(value.runtimeConfig.pageAssistantTarget, target);
+    assert.deepEqual(value.runtimeConfig.toolAllowlist, [
+      "ReadPageContext",
+      "AskUserQuestion",
+      "SetPagePreference",
+      "SetPageModelDefault",
+    ]);
+    assert.equal(value.runtimeConfig.taskType, "page_assistant");
+    assert.equal(value.runtimeConfig.modelSettingsAssistant, undefined);
+  }
+  assert.equal(f.context.sessions.get(first.sessionId)!.persistence, "deferred");
+});
+
+test("fresh model-setting invocations retain the legacy runtime target without writing a generic target", async () => {
+  const f = contextFixture();
+  const modelTarget = {
+    feature: "model-settings" as const,
+    providerId: "fixture",
+    modelId: "model",
+    openingRevision: 1,
+  };
+  const first = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    pageAssistantTarget: modelTarget,
+  });
+  const second = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    modelSettingsAssistant: modelTarget,
+  });
+  assert.notEqual(first.sessionId, second.sessionId);
+  assert.deepEqual(first.pageAssistantTarget, modelTarget);
+  for (const value of f.options as any[]) {
+    assert.deepEqual(value.runtimeConfig.modelSettingsAssistant, modelTarget);
+    assert.equal(value.runtimeConfig.pageAssistantTarget, undefined);
+  }
+});
+
+test("unknown, conflicting and remote page targets fail before any runtime is created", async () => {
+  const f = contextFixture();
+  await assert.rejects(
+    createSessionRecordForV4(f.context, {
+      workspace,
+      pageAssistantTarget: { feature: "app-page", pageId: "imaginary" },
+    }),
+  );
+  await assert.rejects(
+    createSessionRecordForV4(f.context, {
+      workspace,
+      pageAssistantTarget: target,
+      modelSettingsAssistant: {
+        feature: "model-settings",
+        providerId: "fixture",
+        openingRevision: 1,
+      },
+    }),
+    /Conflicting/,
+  );
+  await assert.rejects(
+    createSessionRecordForV4(f.context, {
+      workspace: { ...workspace, workspaceIdentity: "remote:fixture" },
+      pageAssistantTarget: target,
+    }),
+    /local/,
+  );
+  assert.equal(f.options.length, 0);
+});
+
+test("requested full model defaults retain effort/Fast/context and failed configuration closes only its unadmitted draft", async () => {
+  const f = contextFixture();
+  const host = {
+    createSessionRecord: ({ pageAssistantTarget }: any) =>
+      createSessionRecordForV4(f.context, {
+        workspace,
+        persistence: "deferred",
+        pageAssistantTarget,
+      }),
+    getRecord: (id: string) => f.context.sessions.get(id),
+    closeSession: async (id: string) => {
+      await f.context.sessions.get(id)!.app.close?.();
+      f.context.sessions.delete(id);
+    },
+  };
+  const modelSelection = {
+    providerId: "fixture",
+    modelId: "selected",
+    options: { reasoningLevel: "high", speedMode: "fast", contextWindow: 65_536 },
+  };
+  const result = await sessionMgmtHandlers.createSession(
+    host as never,
+    {
+      type: "createSession",
+      payload: {
+        workspaceId: workspace.workspacePath,
+        pageAssistantTarget: target,
+        config: { modelSelection },
+      },
+    } as never,
+  );
+  assert.ok(result && "sessionId" in result);
+  assert.deepEqual(
+    f.context.sessions.get(result.sessionId)!.app.runtime.getSessionModelSelection(),
+    modelSelection,
+  );
+  const existing = result.sessionId;
+  await assert.rejects(
+    sessionMgmtHandlers.createSession(
+      host as never,
+      {
+        type: "createSession",
+        payload: {
+          workspaceId: workspace.workspacePath,
+          pageAssistantTarget: target,
+          config: { modelSelection: { providerId: "fixture", modelId: "missing" } },
+          firstInput: { text: "must not execute" },
+        },
+      } as never,
+    ),
+    /unavailable/,
+  );
+  assert.equal(f.closed.length, 1);
+  assert.notEqual(f.closed[0], existing);
+  assert.equal(f.context.sessions.size, 1);
+  assert.ok(f.context.sessions.has(existing));
+});
+
+test("explicit assistant history reads saved typed targets and leaves ordinary lists unchanged", async () => {
+  const f = contextFixture();
+  const make = (id: string, taskType: string) => ({
+    id,
+    projectID: "project",
+    directory: workspace.workspacePath,
+    path: workspace.workspacePath,
+    slug: id,
+    title: id,
+    version: "fixture",
+    taskType,
+    time: { created: 1, updated: 1 },
+  });
+  const rows = [
+    make("ordinary", "interactive"),
+    make("page", "page_assistant"),
+    make("broken", "page_assistant"),
+  ];
+  const calls: unknown[] = [];
+  f.context.deps.sessionStore = {
+    async listSessions(input: any) {
+      calls.push(input);
+      return rows.filter((row) => input.taskTypes.includes(row.taskType));
+    },
+    async getSession(id: string) {
+      return rows.find((row) => row.id === id);
+    },
+    async sessionEntries({ sessionID, type }: any) {
+      return sessionID === "page" && type === "runtime/page_assistant" ? [{ data: target }] : [];
+    },
+  } as never;
+  const ordinary = await listSessions(f.context, { workspace });
+  assert.deepEqual(
+    ordinary.sessions.map((row) => row.sessionId),
+    ["ordinary"],
+  );
+  const history = await listSessions(f.context, { workspace, onlyPageAssistants: true });
+  assert.deepEqual(
+    history.sessions.map((row) => row.sessionId),
+    ["page"],
+  );
+  assert.deepEqual(history.sessions[0]!.pageAssistantTarget, target);
+  assert.equal(history.sessions[0]!.taskType, "page_assistant");
+  assert.ok(pageAssistantTargetSchema.safeParse(history.sessions[0]!.pageAssistantTarget).success);
+});
+
+test("a retry of one invocation keeps its create receipt while a new command creates a new assistant", async () => {
+  const f = contextFixture();
+  const inbox = new CommandInbox({ getRevision: () => 0, getLogEpoch: () => "epoch" });
+  const envelope = {
+    commandId: "invocation-one",
+    clientId: "caller",
+    sessionId: null,
+    type: "createSession",
+    issuedAt: 1,
+    payload: { workspaceId: workspace.workspacePath, pageAssistantTarget: target },
+  };
+  const first = await inbox.handle(envelope);
+  assert.equal(first.kind, "execute");
+  if (first.kind !== "execute") throw new Error("Expected create admission");
+  const created = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    pageAssistantTarget: target,
+  });
+  first.settle({
+    status: "accepted",
+    result: { type: "createSession", sessionId: created.sessionId, pageAssistantTarget: target },
+  });
+  const retry = await inbox.handle(envelope);
+  assert.equal(retry.kind, "ack");
+  assert.equal(
+    retry.ack.result?.type === "createSession" && retry.ack.result.sessionId,
+    created.sessionId,
+  );
+  assert.equal(f.context.sessions.size, 1);
+  const next = await inbox.handle({ ...envelope, commandId: "invocation-two" });
+  assert.equal(next.kind, "execute");
+  if (next.kind !== "execute") throw new Error("Expected a fresh invocation");
+  const second = await createSessionRecordForV4(f.context, {
+    workspace,
+    persistence: "deferred",
+    pageAssistantTarget: target,
+  });
+  next.settle({
+    status: "accepted",
+    result: { type: "createSession", sessionId: second.sessionId, pageAssistantTarget: target },
+  });
+  assert.notEqual(second.sessionId, created.sessionId);
+  assert.equal(f.context.sessions.size, 2);
+});
