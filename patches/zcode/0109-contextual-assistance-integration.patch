+import { MessageCircle } from "lucide-react";
+import type { PageAssistantSelection } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { usePageAssistant } from "./PageAssistantContext.js";
+
+/** The direct keyboard/touch path invokes the same owner as the context menu. */
+export function PageAssistantAction({
+  selection,
+  label,
+}: {
+  selection: PageAssistantSelection;
+  label?: string;
+}) {
+  const controller = usePageAssistant();
+  const { intl } = useZCodeIntl();
+  return (
+    <Button
+      variant="outline"
+      disabled={!controller}
+      onClick={(event) => {
+        const bounds = event.currentTarget.getBoundingClientRect();
+        controller?.open(selection, { x: bounds.right, y: bounds.bottom }, label);
+      }}
+    >
+      <MessageCircle className="size-4" />
+      {intl.formatMessage({ id: "pageAssistant.open" })}
+    </Button>
+  );
+}
diff --git a/packages/ui/src/page-assistant/PageAssistantContext.tsx b/packages/ui/src/page-assistant/PageAssistantContext.tsx
new file mode 100644
index 0000000..bfdf8f5
--- /dev/null
+++ b/packages/ui/src/page-assistant/PageAssistantContext.tsx
@@ -0,0 +1,54 @@
+import { createContext, useContext, type ReactNode } from "react";
+import { pageAssistantSelectionSchema, type PageAssistantSelection } from "@zcode/shared";
+
+export interface PageAssistantAnchor {
+  x: number;
+  y: number;
+}
+export interface PageAssistantController {
+  open(selection: PageAssistantSelection, anchor?: PageAssistantAnchor, label?: string): void;
+  openCaptured(): void;
+}
+export const PageAssistantContext = createContext<PageAssistantController | null>(null);
+export const usePageAssistant = () => useContext(PageAssistantContext);
+
+/** Only typed surface metadata is read; form values and rendered page text never enter context. */
+export function pageAssistantScope(selection: PageAssistantSelection, label?: string) {
+  return {
+    "data-page-assistant-selection": JSON.stringify(selection),
+    ...(label ? { "data-page-assistant-label": label } : {}),
+  };
+}
+export function readPageAssistantSelection(element: Element): PageAssistantSelection | null {
+  if (element.closest("[inert]")) return null;
+  const scope = element.closest<HTMLElement>("[data-page-assistant-selection]");
+  if (!scope?.dataset.pageAssistantSelection) return { feature: "app-page", pageId: "workspace" };
+  try {
+    const parsed = pageAssistantSelectionSchema.safeParse(
+      JSON.parse(scope.dataset.pageAssistantSelection),
+    );
+    if (!parsed.success) return null;
+    const selection = parsed.data;
+    if (selection.feature === "model-settings") {
+      const modelId = element.closest<HTMLElement>("[data-model-provider-model-id]")?.dataset
+        .modelProviderModelId;
+      return modelId ? { ...selection, modelId } : selection;
+    }
+    return selection;
+  } catch {
+    return null;
+  }
+}
+export function PageAssistantScope({
+  selection,
+  children,
+}: {
+  selection: PageAssistantSelection;
+  children: ReactNode;
+}) {
+  return (
+    <div className="contents" {...pageAssistantScope(selection)}>
+      {children}
+    </div>
+  );
+}
diff --git a/packages/ui/src/page-assistant/PageAssistantConversation.tsx b/packages/ui/src/page-assistant/PageAssistantConversation.tsx
new file mode 100644
index 0000000..769f0e0
--- /dev/null
+++ b/packages/ui/src/page-assistant/PageAssistantConversation.tsx
@@ -0,0 +1,84 @@
+import { useEffect, useRef, useState } from "react";
+import type { ModelSelection, PageAssistantTarget } from "@zcode/shared";
+import { SessionPane } from "@/v4/SessionPane.js";
+import { createCommandEnvelope } from "@/v4/commandFactory.js";
+import { useV4Conversation } from "@/v4/V4ConversationContext.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+export function PageAssistantConversation({
+  workspacePath,
+  target,
+  defaultModelSelection,
+  resumeSessionId,
+}: {
+  workspacePath: string;
+  target: PageAssistantTarget;
+  defaultModelSelection?: ModelSelection;
+  resumeSessionId?: string;
+}) {
+  const { sendCommand } = useV4Conversation();
+  const { intl } = useZCodeIntl();
+  const [sessionId, setSessionId] = useState(resumeSessionId);
+  const [failed, setFailed] = useState(false);
+  // 每次用户唤起换 mount key；React 重放/传输重试保留同一命令，不能多建会话。
+  const envelope = useRef(
+    createCommandEnvelope({
+      type: "createSession",
+      sessionId: null,
+      payload: {
+        workspaceId: workspacePath,
+        pageAssistantTarget: target,
+        config: {
+          mode: "build",
+          ...(defaultModelSelection ? { modelSelection: defaultModelSelection } : {}),
+        },
+      },
+    }),
+  );
+  const pending = useRef<ReturnType<typeof sendCommand> | undefined>(undefined);
+  useEffect(() => {
+    if (resumeSessionId) return;
+    let mounted = true;
+    pending.current ??= sendCommand(envelope.current);
+    void pending.current
+      .then((ack) => {
+        if (!mounted) return;
+        if (
+          (ack.status !== "accepted" && ack.status !== "duplicate") ||
+          ack.result?.type !== "createSession" ||
+          JSON.stringify(ack.result.pageAssistantTarget) !== JSON.stringify(target)
+        )
+          throw new Error("Scoped page assistant creation was not accepted");
+        setSessionId(ack.result.sessionId);
+      })
+      .catch(() => {
+        if (mounted) setFailed(true);
+      });
+    return () => {
+      mounted = false;
+    };
+  }, [sendCommand, target, resumeSessionId]);
+  if (failed)
+    return (
+      <p role="alert" className="p-4 text-ui-base text-destructive">
+        {intl.formatMessage({ id: "pageAssistant.failed" })}
+      </p>
+    );
+  if (!sessionId)
+    return (
+      <p className="p-4 text-ui-base text-foreground-subtle">
+        {intl.formatMessage({ id: "common.loading" })}
+      </p>
+    );
+  return (
+    <SessionPane
+      paneId={`page-assistant:${sessionId}`}
+      sessionId={sessionId}
+      workspacePath={workspacePath}
+      compactAssistant
+      isDesktop
+      focused
+      telemetryVisible
+    />
+  );
+}
diff --git a/packages/ui/src/page-assistant/PageAssistantHistory.tsx b/packages/ui/src/page-assistant/PageAssistantHistory.tsx
new file mode 100644
index 0000000..1494951
--- /dev/null
+++ b/packages/ui/src/page-assistant/PageAssistantHistory.tsx
@@ -0,0 +1,112 @@
+import { useRef, useState } from "react";
+import { History } from "lucide-react";
+import type { PageAssistantTarget } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { pageAssistantLabel } from "./pageAssistantLabels.js";
+
+export interface SavedPageAssistant {
+  sessionId: string;
+  target: PageAssistantTarget;
+  workspacePath: string;
+  updatedAt: number;
+}
+export function PageAssistantHistory({ onResume }: { onResume(saved: SavedPageAssistant): void }) {
+  const { pageAssistantService, zcodeAgentService } = useServices();
+  const { intl, locale } = useZCodeIntl();
+  const [open, setOpen] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [failed, setFailed] = useState(false);
+  const [items, setItems] = useState<SavedPageAssistant[]>([]);
+  const generation = useRef(0);
+  const onOpenChange = (next: boolean) => {
+    setOpen(next);
+    const readGeneration = ++generation.current;
+    if (!next) return;
+    setLoading(true);
+    setFailed(false);
+    setItems([]);
+    if (!pageAssistantService) {
+      setFailed(true);
+      setLoading(false);
+      return;
+    }
+    // 原 Session 列表是唯一历史来源；不另存一份助手目录或借当前页面重新解释旧目标。
+    void pageAssistantService
+      .getContext({ feature: "app-page", pageId: "workspace" })
+      .then(async ({ workspacePath }) => {
+        const sessions = await zcodeAgentService.listSessions({
+          workspacePath,
+          onlyPageAssistants: true,
+          limit: 20,
+        });
+        if (generation.current !== readGeneration) return;
+        setItems(
+          sessions.flatMap((item) =>
+            item.pageAssistantTarget
+              ? [
+                  {
+                    sessionId: item.sessionId,
+                    target: item.pageAssistantTarget,
+                    workspacePath,
+                    updatedAt: item.updatedAt,
+                  },
+                ]
+              : [],
+          ),
+        );
+      })
+      .catch(() => {
+        if (generation.current === readGeneration) setFailed(true);
+      })
+      .finally(() => {
+        if (generation.current === readGeneration) setLoading(false);
+      });
+  };
+  return (
+    <DropdownMenu open={open} onOpenChange={onOpenChange}>
+      <DropdownMenuTrigger asChild>
+        <Button
+          variant="ghost"
+          size="icon-sm"
+          aria-label={intl.formatMessage({ id: "pageAssistant.history" })}
+        >
+          <History className="size-4" />
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="end" className="max-h-72 max-w-80 overflow-y-auto">
+        {loading || failed || items.length === 0 ? (
+          <p className="p-2 text-ui-base text-foreground-subtle">
+            {intl.formatMessage({
+              id: loading
+                ? "common.loading"
+                : failed
+                  ? "pageAssistant.historyFailed"
+                  : "pageAssistant.historyEmpty",
+            })}
+          </p>
+        ) : null}
+        {items.map((item) => (
+          <DropdownMenuItem key={item.sessionId} onSelect={() => onResume(item)}>
+            <span className="min-w-0 truncate">{pageAssistantLabel(intl, item.target)}</span>
+            <span className="ml-auto shrink-0 text-ui-sm text-foreground-subtlest">
+              {new Intl.DateTimeFormat(locale, {
+                month: "numeric",
+                day: "numeric",
+                hour: "2-digit",
+                minute: "2-digit",
+              }).format(item.updatedAt)}
+            </span>
+          </DropdownMenuItem>
+        ))}
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
