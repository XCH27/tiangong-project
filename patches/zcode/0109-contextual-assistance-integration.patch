diff --git a/apps/zcode-cli/packages/core/test/page-assistant.test.ts b/apps/zcode-cli/packages/core/test/page-assistant.test.ts
new file mode 100644
index 0000000..8a00278
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/page-assistant.test.ts
@@ -0,0 +1,244 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  pageAssistantTools,
+  pageAssistantInstructions,
+  PAGE_ASSISTANT_ENTRY,
+  PageAssistantOperationError,
+} from "@zcode/shared";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import { createSettingService } from "../../../../../packages/services/src/setting/settingService.js";
+import { createPageAssistantService } from "../../../../../packages/services/src/page-assistant/pageAssistantService.js";
+import { readStoredPageAssistantTarget } from "../../bootstrap/src/zcode-protocol/page-assistant.js";
+
+const target = { feature: "app-page" as const, pageId: "general" as const };
+const tool = (name: string, input: unknown, id = name) => ({ id, name, input });
+async function pageFixture(pageId: typeof target.pageId | "appearance" | "usage" = "general") {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-page-pi-owner-"));
+  const beforeHome = process.env.ZCODE_DESKTOP_HOME_DIR;
+  process.env.ZCODE_DESKTOP_HOME_DIR = dir;
+  const setting = createSettingService();
+  await setting.update({ keepAwakeWhileRunning: false });
+  const page = { ...target, pageId };
+  const service = createPageAssistantService({
+    settingService: setting,
+    providerSettingsService: {} as never,
+    modelSelectionService: {
+      async getPreferences() {
+        return { revision: "one", favoriteModelSelections: [] };
+      },
+    } as never,
+    workspacePath: () => dir,
+  });
+  const calls: string[] = [];
+  const f = await fixture("pi", true, {
+    config: {
+      taskType: "page_assistant",
+      pageAssistantTarget: page,
+      systemPrompt: pageAssistantInstructions(page),
+      toolAllowlist: [...pageAssistantTools(page)],
+    },
+    deps: {
+      pageAssistantPort: {
+        async perform(command) {
+          calls.push(command.operation);
+          return service.perform(page, command);
+        },
+      },
+    },
+  });
+  return {
+    f,
+    page,
+    calls,
+    setting,
+    service,
+    async close() {
+      await f.close();
+      if (beforeHome === undefined) delete process.env.ZCODE_DESKTOP_HOME_DIR;
+      else process.env.ZCODE_DESKTOP_HOME_DIR = beforeHome;
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test("actual Host/Pi/SQLite page assistant exposes only its operations, writes through Setting and retains target/receipts cold", async () => {
+  const p = await pageFixture();
+  try {
+    p.f.steps.push(
+      () => reply("", [tool("ReadPageContext", {})]),
+      () =>
+        reply("", [
+          tool("SetPagePreference", {
+            key: "keepAwakeWhileRunning",
+            value: true,
+            expectedValue: false,
+          }),
+        ]),
+      () => reply("The preference was saved."),
+    );
+    await p.f.runtime.executeTurn("Keep awake while work runs");
+    assert.equal((await p.setting.get()).keepAwakeWhileRunning, true);
+    assert.equal(p.f.permissionCalls, 1);
+    for (const request of p.f.requests)
+      assert.deepEqual(new Set(request.tools), new Set(pageAssistantTools(p.page)));
+    const entries = await p.f.store.sessionEntries({
+      sessionID: "session" as never,
+      type: PAGE_ASSISTANT_ENTRY,
+    });
+    assert.deepEqual(entries[0]!.data, p.page);
+    const facts = p.f.toolFacts();
+    assert.equal(facts.length, 2);
+    await p.f.reopen();
+    assert.deepEqual(await readStoredPageAssistantTarget(p.f.store, "session"), p.page);
+    assert.deepEqual(p.f.toolFacts(), facts);
+    p.f.steps.push(() => reply("The earlier page operation is retained."));
+    await p.f.runtime.executeTurn("Explain the saved change");
+    assert.deepEqual(p.calls, ["read", "set-preference"]);
+  } finally {
+    await p.close();
+  }
+});
+
+test("denial, invalid preference values and invented tools never reach the page owner", async () => {
+  const p = await pageFixture();
+  try {
+    p.f.deny();
+    p.f.steps.push(
+      () =>
+        reply("", [
+          tool("SetPagePreference", {
+            key: "keepAwakeWhileRunning",
+            value: true,
+            expectedValue: false,
+          }),
+        ]),
+      () =>
+        reply("", [
+          tool(
+            "SetPagePreference",
+            { key: "keepAwakeWhileRunning", value: "yes", expectedValue: false },
+            "invalid",
+          ),
+        ]),
+      () => reply("", [tool("Bash", { command: "echo forbidden" })]),
+      () => reply("No changes were made."),
+    );
+    await p.f.runtime.executeTurn("Change this page");
+    assert.deepEqual(p.calls, []);
+    assert.equal(p.f.permissionCalls, 1);
+    assert.equal((await p.setting.get()).keepAwakeWhileRunning, false);
+  } finally {
+    await p.close();
+  }
+});
+
+test("read-only Appearance cannot borrow General's mutation, even though the tool is registered", async () => {
+  const p = await pageFixture("appearance");
+  try {
+    p.f.steps.push(
+      () =>
+        reply("", [
+          tool("SetPagePreference", {
+            key: "keepAwakeWhileRunning",
+            value: true,
+            expectedValue: false,
+          }),
+        ]),
+      () => reply("This assistant explains Appearance but cannot change it."),
+    );
+    await p.f.runtime.executeTurn("Change appearance");
+    assert.deepEqual(p.calls, []);
+    assert.equal(p.f.permissionCalls, 0);
+    assert.equal((await p.setting.get()).keepAwakeWhileRunning, false);
+    assert.deepEqual(
+      new Set(p.f.requests[0]!.tools),
+      new Set(["ReadPageContext", "AskUserQuestion"]),
+    );
+  } finally {
+    await p.close();
+  }
+});
+
+test("Stop during approval rejects a late allow and cannot replay a preference change on reopen", async () => {
+  const p = await pageFixture();
+  try {
+    const asked = Promise.withResolvers<void>();
+    const answer = Promise.withResolvers<{ decision: string }>();
+    p.f.permissionWith(async () => {
+      asked.resolve();
+      return answer.promise;
+    });
+    p.f.steps.push(() =>
+      reply("", [
+        tool("SetPagePreference", {
+          key: "keepAwakeWhileRunning",
+          value: true,
+          expectedValue: false,
+        }),
+      ]),
+    );
+    const pending = p.f.runtime.executeTurn("Change preference").then(
+      () => undefined,
+      () => undefined,
+    );
+    await asked.promise;
+    p.f.runtime.stopActiveForegroundExecution();
+    answer.resolve({ decision: "allow" });
+    await pending;
+    assert.deepEqual(p.calls, []);
+    assert.equal((await p.setting.get()).keepAwakeWhileRunning, false);
+    await p.f.reopen();
+    p.f.steps.push(() => reply("The cancelled change was not applied."));
+    await p.f.runtime.executeTurn("What happened?");
+    assert.deepEqual(p.calls, []);
+  } finally {
+    await p.close();
+  }
+});
+
+test("missing or unknown stored page targets refuse unrestricted cold activation; legacy model target remains readable", async () => {
+  const p = await pageFixture();
+  try {
+    p.f.steps.push(() => reply("No changes requested."));
+    await p.f.runtime.executeTurn("Explain this page");
+    await p.f.store.saveSessionEntry({
+      id: `session:${PAGE_ASSISTANT_ENTRY}`,
+      sessionID: "session" as never,
+      type: PAGE_ASSISTANT_ENTRY,
+      data: { feature: "app-page", pageId: "unknown" },
+      time: { created: 1, updated: 1 },
+    });
+    await assert.rejects(readStoredPageAssistantTarget(p.f.store, "session"));
+    await assert.rejects(readStoredPageAssistantTarget(p.f.store, "missing"));
+    const legacy = {
+      feature: "model-settings",
+      providerId: "original",
+      modelId: "model",
+      openingRevision: 8,
+    };
+    await p.f.store.saveSessionEntry({
+      id: "session:legacy-other",
+      sessionID: "session" as never,
+      type: "runtime/model_settings_assistant",
+      data: legacy,
+      time: { created: 1, updated: 1 },
+    });
+    // A corrupted new target cannot borrow an unrelated legacy target.
+    await assert.rejects(readStoredPageAssistantTarget(p.f.store, "session"));
+    const store = {
+      sessionEntries: async ({ type }: { type: string }) =>
+        type === "runtime/model_settings_assistant" ? [{ data: legacy }] : [],
+    } as never;
+    assert.deepEqual(await readStoredPageAssistantTarget(store, "old-session"), legacy);
+    assert.equal(
+      new PageAssistantOperationError("target_mismatch").message,
+      "page_assistant.target_mismatch",
+    );
+  } finally {
+    await p.close();
+  }
+});
