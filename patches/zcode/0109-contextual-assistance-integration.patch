diff --git a/packages/ui/src/settings/model-provider-section/providerCatalogFilters.ts b/packages/ui/src/settings/model-provider-section/providerCatalogFilters.ts
new file mode 100644
index 0000000..622adf0
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/providerCatalogFilters.ts
@@ -0,0 +1,42 @@
+import type { ProviderSettingsFormModel } from "@/lib/providerSettingsFormTypes.js";
+
+export type ProviderCatalogFilter = "all" | "text" | "image" | "video";
+type CatalogModel = Pick<ProviderSettingsFormModel, "modelId" | "evidenceConfig">;
+const outputTypes = ["text", "image", "video"] as const;
+const outputFields = {
+  text: "supportsText",
+  image: "supportsImage",
+  video: "supportsVideo",
+} as const;
+
+function matchesOutput(
+  model: CatalogModel,
+  filter: Exclude<ProviderCatalogFilter, "all">,
+): boolean {
+  // 通用运行补全会补出文本输出；分类只读已有目录/手动修正证据，未知不借用补全值。
+  return model.evidenceConfig?.properties?.outputFormat?.[outputFields[filter]] === true;
+}
+
+/** Options depend on the complete connection catalog, never the current search result. */
+export function providerCatalogFilterOptions(
+  models: readonly CatalogModel[],
+): readonly ProviderCatalogFilter[] {
+  if (models.length <= 10) return [];
+  return [
+    "all",
+    ...outputTypes.filter((type) => models.some((model) => matchesOutput(model, type))),
+  ];
+}
+
+export function filterProviderCatalogModels<T extends CatalogModel>(
+  models: readonly T[],
+  query: string,
+  filter: ProviderCatalogFilter,
+): T[] {
+  const search = query.trim().toLocaleLowerCase();
+  return models.filter(
+    (model) =>
+      model.modelId.toLocaleLowerCase().includes(search) &&
+      (filter === "all" || matchesOutput(model, filter)),
+  );
+}
