+import { check, fixture, providerWithModel } from "./helpers/providerDraftFixture.js";
+
+type Provider = ReturnType<typeof providerWithModel>;
+function catalog(providerId = "catalog", count = 11): Provider {
+  const value = providerWithModel();
+  value.providerId = providerId;
+  value.providerName = providerId;
+  const base = value.models[0]!;
+  value.models = Array.from({ length: count }, (_, index) => {
+    const model = structuredClone(base);
+    model.modelId = `text-${index}`;
+    model.evidenceConfig = { properties: { outputFormat: { supportsText: true } } };
+    if (index === 1) {
+      model.modelId = "image-only";
+      model.evidenceConfig.properties!.outputFormat = { supportsText: false, supportsImage: true };
+    }
+    if (index === 2) {
+      model.modelId = "mixed-image-video";
+      model.evidenceConfig.properties!.outputFormat = {
+        supportsText: true,
+        supportsImage: true,
+        supportsVideo: true,
+      };
+    }
+    if (index === 3) {
+      model.modelId = "unknown-image-video";
+      model.evidenceConfig = {};
+    }
+    if (index === 4) {
+      model.modelId = "vision-input";
+      model.evidenceConfig.properties!.inputFormat = { supportsImage: true };
+    }
+    return model;
+  });
+  return value;
+}
+
+async function select(container: HTMLElement, filter: string) {
