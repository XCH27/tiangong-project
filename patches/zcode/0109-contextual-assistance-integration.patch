diff --git a/packages/ui/src/settings/ModelPurposeDefaults.tsx b/packages/ui/src/settings/ModelPurposeDefaults.tsx
new file mode 100644
index 0000000..52f0187
--- /dev/null
+++ b/packages/ui/src/settings/ModelPurposeDefaults.tsx
@@ -0,0 +1,192 @@
+import { useRef, useState } from "react";
+import { ZCODE_AGENT_PROVIDER, type ModelSelection } from "@zcode/shared";
+import { completeNewModelSelection } from "@zcode/provider";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { Card, CardContent } from "@/components/ui/card.js";
+import { Button } from "@/components/ui/button.js";
+import { SettingsRow } from "@/settings/SettingsPageParts.js";
+import { useBaseWorkspaceServices } from "@/hooks/useWorkspaceServices.js";
+import { useModelSelectionServiceView } from "@/hooks/useModelSelectionView.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { buildRegistryModelSelectGroups } from "@/lib/modelSelectionGroups.js";
+import { encodeCustomModelValue } from "@/lib/zcodeCustomModelValue.js";
+import { parseModelPickerValue } from "@/lib/zcodeSessionProjection.js";
+
+const PURPOSES = ["conversation", "page-assistant"] as const;
+/** Two purpose choices, one existing Personal preference writer; Project recent choices stay separate. */
+export function ModelPurposeDefaults() {
+  const { modelSelectionService } = useBaseWorkspaceServices();
+  const read = useModelSelectionServiceView(modelSelectionService);
+  const { intl } = useZCodeIntl();
+  const owner = useRef({ service: modelSelectionService, generation: 0 });
+  if (owner.current.service !== modelSelectionService)
+    owner.current = { service: modelSelectionService, generation: owner.current.generation + 1 };
+  const [saveState, setSaveState] = useState<{
+    generation: number;
+    pending: boolean;
+    errorKey?: string;
+  }>({ generation: 0, pending: false });
+  const pending = saveState.generation === owner.current.generation && saveState.pending;
+  const error = saveState.generation === owner.current.generation ? saveState.errorKey : undefined;
+  const view = read.state.status === "ready" ? read.state.view : null;
+  const readFailed = read.state.status === "error" || read.state.status === "unavailable";
+  const groups = view
+    ? buildRegistryModelSelectGroups(ZCODE_AGENT_PROVIDER, view).map((group) => ({
+        ...group,
+        directItems: true,
+      }))
+    : [];
+  const change = async (purpose: (typeof PURPOSES)[number], selection: ModelSelection | null) => {
+    if (!view?.preferencesRevision || pending) return;
+    const generation = owner.current.generation;
+    setSaveState({ generation, pending: true });
+    try {
+      await modelSelectionService.savePreferences({
+        expectedRevision: view.preferencesRevision,
+        ...(purpose === "conversation"
+          ? { defaultModelSelection: selection }
+          : { pageAssistantDefaultModelSelection: selection }),
+      });
+    } catch (cause) {
+      const code = cause && typeof cause === "object" && "code" in cause ? cause.code : undefined;
+      if (owner.current.generation !== generation) return;
+      setSaveState({
+        generation,
+        pending: true,
+        errorKey:
+          code === "model_preference_conflict"
+            ? "settings.modelDefaults.conflict"
+            : code === "model_preference_unavailable"
+              ? "settings.modelDefaults.unavailable"
+              : code === "model_preference_unsupported"
+                ? "settings.modelDefaults.unsupported"
+                : "settings.modelDefaults.failed",
+      });
+    } finally {
+      if (owner.current.generation === generation) {
+        setSaveState((current) => ({ ...current, pending: false }));
+        read.reload();
+      }
+    }
+  };
+  return (
+    <section className="space-y-3" data-model-purpose-defaults>
+      <div>
+        <h3 className="text-ui-lg font-semibold text-foreground">
+          {intl.formatMessage({ id: "settings.modelDefaults.title" })}
+        </h3>
+        <p className="mt-1 text-ui-base text-foreground-subtle">
+          {intl.formatMessage({ id: "settings.modelDefaults.description" })}
+        </p>
+      </div>
+      <Card>
+        <CardContent className="p-0">
+          {PURPOSES.map((purpose) => {
+            const selection =
+              purpose === "conversation"
+                ? view?.configuredDefaultSelection
+                : view?.pageAssistantDefaultSelection;
+            const available =
+              !selection ||
+              groups.some((group) =>
+                group.items.some(
+                  (item) =>
+                    item.value === encodeCustomModelValue(selection.providerId, selection.modelId),
+                ),
+              );
+            const automatic = intl.formatMessage({
+              id:
+                purpose === "conversation"
+                  ? "settings.modelDefaults.automatic"
+                  : "settings.modelDefaults.followConversation",
+            });
+            return (
+              <SettingsRow
+                key={purpose}
+                label={intl.formatMessage({ id: `settings.modelDefaults.${purpose}` })}
+                description={intl.formatMessage({
+                  id: `settings.modelDefaults.${purpose}.description`,
+                })}
+                control={
+                  <ModelConfigSelect
+                    modelGroups={groups}
+                    normalizedValue={
+                      selection
+                        ? encodeCustomModelValue(selection.providerId, selection.modelId)
+                        : "inherit"
+                    }
+                    triggerLabel={
+                      !view
+                        ? intl.formatMessage({
+                            id: readFailed ? "settings.modelDefaults.notLoaded" : "common.loading",
+                          })
+                        : (selection?.modelId ?? automatic)
+                    }
+                    tooltipTitle={
+                      selection ? `${selection.providerId}/${selection.modelId}` : automatic
+                    }
+                    leadingItems={[{ key: "inherit", value: "inherit", name: automatic }]}
+                    showManageModelsAction={false}
+                    footerActions={[]}
+                    labelVisibilityClassName="inline-flex"
+                    disabled={pending || !view?.preferencesRevision}
+                    lockReasonMessage=""
+                    isItemLocked={() => false}
+                    triggerClassName="min-w-0 max-w-64"
+                    triggerBadge={
+                      !available ? (
+                        <span className="text-ui-sm text-warning">
+                          {intl.formatMessage({ id: "settings.modelDefaults.unavailableBadge" })}
+                        </span>
+                      ) : undefined
+                    }
+                    onValueChange={(value) => {
+                      if (!view) return;
+                      const selected =
+                        value === "inherit"
+                          ? null
+                          : completeNewModelSelection(view, parseModelPickerValue(value));
+                      if (value !== "inherit" && !selected) {
+                        setSaveState({
+                          generation: owner.current.generation,
+                          pending: false,
+                          errorKey: "settings.modelDefaults.unavailable",
+                        });
+                        return;
+                      }
+                      void change(purpose, selected ?? null);
+                    }}
+                  />
+                }
+              />
+            );
+          })}
+        </CardContent>
+      </Card>
+      {read.state.status === "loading" ? (
+        <p className="text-ui-sm text-foreground-subtle">
+          {intl.formatMessage({ id: "common.loading" })}
+        </p>
+      ) : null}
+      {error ? (
+        <p role="alert" className="text-ui-base text-destructive">
+          {intl.formatMessage({ id: error })}
+        </p>
+      ) : null}
+      {readFailed || (view && !view.preferencesRevision) ? (
+        <div className="flex items-center justify-between gap-2 text-ui-base">
+          <p role="alert" className="text-foreground-subtle">
+            {intl.formatMessage({
+              id: readFailed
+                ? "settings.modelDefaults.readFailed"
+                : "settings.modelDefaults.unsupported",
+            })}
+          </p>
+          <Button variant="ghost" size="sm" onClick={read.reload}>
+            {intl.formatMessage({ id: "common.retry" })}
+          </Button>
+        </div>
+      ) : null}
+    </section>
+  );
+}
