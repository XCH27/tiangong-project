@@ -0,0 +1,419 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  MutableAccountProviderConfigSource,
+  parseModelConfig,
+  parseProviderConfig,
+} from "@zcode/provider";
+import {
+  NodeModelSelectionConfigRepository,
+  NodeProviderRegistryRuntime,
+  createNodeModelSelectionFacade,
+} from "@zcode/provider-node";
+import { providerProvisioningPersonalConfigSchema } from "@zcode/shared";
+import {
+  createModelSelectionService,
+  type ModelSelectionConfiguredDefaultSource,
+} from "../src/model-provider/modelSelectionService.js";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-purpose-defaults-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let account = new MutableAccountProviderConfigSource();
+  let runtime = new NodeProviderRegistryRuntime({ ...options, accountSource: account });
+  await runtime.start();
+  const { providerId } = await runtime.configService.createPersonalProvider({
+    providerName: "Purpose fixture",
+    initialConfig: parseProviderConfig({
+      api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+      access: { type: "api-key", apiKey: "synthetic-purpose-fixture" },
+    }),
+  });
+  for (const modelId of ["primary", "helper"]) {
+    await runtime.configService.addPersonalModel(
+      providerId,
+      modelId,
+      parseModelConfig({
+        properties: { contextWindow: 65_536, contextWindows: [65_536, 131_072] },
+        optionSpecs: {
+          reasoningLevel: { values: ["low", "high"], map: "{}" },
+          maxOutputTokens: { max: 4_096 },
+          speedMode: null,
+        },
+      }),
+      undefined,
+      true,
+    );
+  }
+  await runtime.registryService.refresh("purpose-fixture");
+  let source = new NodeModelSelectionConfigRepository({
+    personalRepository: runtime.personalRepository,
+  });
+  let service = createModelSelectionService(
+    createNodeModelSelectionFacade(runtime.registryService),
+    async () => {},
+    source,
+    async () => {
+      await runtime.registryService.refresh("purpose-preferences");
+    },
+  );
+  return {
+    providerId,
+    selection: (modelId: string) => ({ providerId, modelId, options: { reasoningLevel: "auto" } }),
+    get runtime() {
+      return runtime;
+    },
+    get account() {
+      return account;
+    },
+    get source() {
+      return source;
+    },
+    get service() {
+      return service;
+    },
+    read: () => readFile(options.personalFilePath, "utf8"),
+    async independentWriter() {
+      const writer = new NodeProviderRegistryRuntime(options);
+      await writer.start();
+      const repository = new NodeModelSelectionConfigRepository({
+        personalRepository: writer.personalRepository,
+      });
+      const api = createModelSelectionService(
+        createNodeModelSelectionFacade(writer.registryService),
+        async () => {},
+        repository,
+        async () => {
+          await writer.registryService.refresh("independent-preference");
+        },
+      );
+      return {
+        runtime: writer,
+        service: api,
+        close() {
+          api.dispose();
+          repository.dispose();
+          writer.dispose();
+        },
+      };
+    },
+    async reopen() {
+      service.dispose();
+      source.dispose();
+      runtime.dispose();
+      account = new MutableAccountProviderConfigSource();
+      runtime = new NodeProviderRegistryRuntime({ ...options, accountSource: account });
+      await runtime.start();
+      source = new NodeModelSelectionConfigRepository({
+        personalRepository: runtime.personalRepository,
+      });
+      service = createModelSelectionService(
+        createNodeModelSelectionFacade(runtime.registryService),
+        async () => {},
+        source,
+        async () => {
+          await runtime.registryService.refresh("purpose-reopen");
+        },
+      );
+    },
+    async close() {
+      service.dispose();
+      source.dispose();
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+test("purpose defaults share one versioned writer, survive other Provider writes and cold reopen, and clear independently", async () => {
+  const f = await fixture();
+  try {
+    const initial = await f.service.getPreferences();
+    assert.match(initial.revision, /^[a-f0-9]{64}$/);
+    assert.equal(initial.pageAssistantDefaultModelSelection, undefined);
+    const ordinary = {
+      ...f.selection("primary"),
+      options: { reasoningLevel: "low", speedMode: "standard" as const, contextWindow: 65_536 },
+    };
+    const page = {
+      ...f.selection("helper"),
+      options: { reasoningLevel: "high", contextWindow: 131_072 },
+    };
+    const saved = await f.service.savePreferences({
+      defaultModelSelection: ordinary,
+      pageAssistantDefaultModelSelection: page,
+      expectedRevision: initial.revision,
+    });
+    assert.notEqual(saved.revision, initial.revision);
+    assert.deepEqual(saved.defaultModelSelection, ordinary);
+    assert.deepEqual(saved.pageAssistantDefaultModelSelection, page);
+    const view = await f.service.getView();
+    assert.deepEqual(view.configuredDefaultSelection, ordinary);
+    assert.deepEqual(view.pageAssistantDefaultSelection, page);
+    assert.equal(view.preferencesRevision, saved.revision);
+    const encoded = JSON.parse(await f.read());
+    assert.deepEqual(
+      providerProvisioningPersonalConfigSchema.parse(encoded.config)
+        .pageAssistantDefaultModelSelection,
+      page,
+    );
+    assert.equal(
+      providerProvisioningPersonalConfigSchema.safeParse({
+        ...encoded.config,
+        pageAssistantDefaultModelSelection: { providerId: f.providerId },
+      }).success,
+      false,
+    );
+    assert.equal("expectedRevision" in encoded.config, false);
+    await f.runtime.configService.setPersonalModelEnabled(f.providerId, "helper", false);
+    await f.runtime.registryService.refresh("ordinary-model-write");
+    await f.reopen();
+    const reopened = await f.service.getPreferences();
+    assert.deepEqual(reopened.defaultModelSelection, ordinary);
+    assert.deepEqual(reopened.pageAssistantDefaultModelSelection, page);
+    assert.deepEqual(
+      (await f.service.getView()).pageAssistantDefaultSelection,
+      page,
+      "Reading an unavailable preference must not replace it with a fallback",
+    );
+    const cleared = await f.service.savePreferences({
+      pageAssistantDefaultModelSelection: null,
+      expectedRevision: reopened.revision,
+    });
+    assert.deepEqual(cleared.defaultModelSelection, ordinary);
+    assert.equal(cleared.pageAssistantDefaultModelSelection, undefined);
+    await f.reopen();
+    assert.equal((await f.service.getPreferences()).pageAssistantDefaultModelSelection, undefined);
+    await f.service.savePreferences({
+      defaultModelSelection: null,
+      expectedRevision: (await f.service.getPreferences()).revision,
+    });
+    assert.equal((await f.service.getPreferences()).defaultModelSelection, undefined);
+  } finally {
+    await f.close();
+  }
+});
+
+test("two real writers with one preference revision commit once and never overwrite a newer default", async () => {
+  const f = await fixture();
+  const other = await f.independentWriter();
+  try {
+    const expectedRevision = (await f.service.getPreferences()).revision;
+    const results = await Promise.allSettled([
+      f.service.savePreferences({
+        defaultModelSelection: f.selection("primary"),
+        expectedRevision,
+      }),
+      other.service.savePreferences({
+        defaultModelSelection: f.selection("helper"),
+        expectedRevision,
+      }),
+    ]);
+    assert.equal(results.filter((result) => result.status === "fulfilled").length, 1);
+    const rejected = results.find(
+      (result) => result.status === "rejected",
+    ) as PromiseRejectedResult;
+    assert.match(rejected.reason.message, /revision conflict/);
+    assert.equal(rejected.reason.code, "model_preference_conflict");
+    const current = await f.service.getPreferences();
+    const before = await f.read();
+    await assert.rejects(
+      f.service.savePreferences({
+        pageAssistantDefaultModelSelection: f.selection("helper"),
+        expectedRevision,
+      }),
+      /revision conflict/,
+    );
+    assert.equal(await f.read(), before);
+    await f.reopen();
+    assert.deepEqual(
+      (await f.service.getPreferences()).defaultModelSelection,
+      current.defaultModelSelection,
+    );
+  } finally {
+    other.close();
+    await f.close();
+  }
+});
+
+test("invalid model and explicit unsupported options reject the whole purpose patch before disk changes", async () => {
+  const f = await fixture();
+  try {
+    const expectedRevision = (await f.service.getPreferences()).revision;
+    const before = await f.read();
+    for (const invalid of [
+      f.selection("missing"),
+      { ...f.selection("helper"), options: { reasoningLevel: "unsupported" } },
+      { ...f.selection("helper"), options: { reasoningLevel: "auto", speedMode: "fast" as const } },
+      { ...f.selection("helper"), options: { reasoningLevel: "auto", contextWindow: 32_768 } },
+    ]) {
+      await assert.rejects(
+        f.service.savePreferences({
+          defaultModelSelection: f.selection("primary"),
+          pageAssistantDefaultModelSelection: invalid,
+          expectedRevision,
+        }),
+        { code: "model_preference_unavailable" },
+      );
+      assert.equal(await f.read(), before);
+    }
+  } finally {
+    await f.close();
+  }
+});
+
+test("live Registry withdrawal is rechecked inside the existing Personal writer even when its file revision did not change", async () => {
+  const f = await fixture();
+  const facade = createNodeModelSelectionFacade(f.runtime.registryService);
+  const guardedSource: ModelSelectionConfiguredDefaultSource = {
+    read: () => f.source.read(),
+    readPreferences: () => f.source.readPreferences(),
+    savePreferences: async (patch, assertCurrent) => {
+      const snapshot = await f.account.read();
+      f.account.replace({
+        ...snapshot,
+        revision: "withdrawn-fixture-catalog",
+        states: {
+          [f.providerId]: { availability: "unavailable", entitled: false, current: false },
+        },
+      });
+      await f.runtime.registryService.refresh("withdraw-during-preference");
+      return f.source.savePreferences(patch, assertCurrent);
+    },
+  };
+  const service = createModelSelectionService(facade, async () => {}, guardedSource);
+  try {
+    const expectedRevision = (await service.getPreferences()).revision;
+    const before = await f.read();
+    await assert.rejects(
+      service.savePreferences({
+        pageAssistantDefaultModelSelection: f.selection("helper"),
+        expectedRevision,
+      }),
+      /Registry revision conflict/,
+    );
+    assert.equal(await f.read(), before);
+  } finally {
+    service.dispose();
+    await f.close();
+  }
+});
+
+test("a fresh preference revision cannot validate a model against an older unpublished Registry snapshot", async () => {
+  const f = await fixture();
+  const writer = await f.independentWriter();
+  try {
+    await writer.runtime.configService.setPersonalModelEnabled(f.providerId, "helper", false);
+    const stale = await f.service.getView();
+    assert.ok(
+      stale.providers
+        .find((provider) => provider.providerId === f.providerId)
+        ?.models.some((model) => model.modelId === "helper"),
+      "The original runtime must retain its stale catalog",
+    );
+    const expectedRevision = (await f.service.getPreferences()).revision;
+    const before = await f.read();
+    await assert.rejects(
+      f.service.savePreferences({
+        pageAssistantDefaultModelSelection: f.selection("helper"),
+        expectedRevision,
+      }),
+      /Registry revision conflict/,
+    );
+    assert.equal(await f.read(), before);
+    await f.runtime.registryService.refresh("catch-up-after-independent-write");
+    await assert.rejects(
+      f.service.savePreferences({
+        pageAssistantDefaultModelSelection: f.selection("helper"),
+        expectedRevision,
+      }),
+      /no longer available/,
+    );
+    assert.equal(await f.read(), before);
+  } finally {
+    writer.close();
+    await f.close();
+  }
+});
+
+test("purpose values are snapshotted before readiness and old unversioned sources reject conditional writes explicitly", async () => {
+  const f = await fixture();
+  let release!: () => void;
+  const ready = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  const waiting = createModelSelectionService(
+    createNodeModelSelectionFacade(f.runtime.registryService),
+    () => ready,
+    f.source,
+    async () => {
+      await f.runtime.registryService.refresh("snapshot-ready");
+    },
+  );
+  try {
+    const input = {
+      defaultModelSelection: f.selection("primary"),
+      pageAssistantDefaultModelSelection: f.selection("helper"),
+      expectedRevision: (await f.service.getPreferences()).revision,
+    };
+    const pending = waiting.savePreferences(input);
+    input.defaultModelSelection.modelId = "missing";
+    input.pageAssistantDefaultModelSelection.options.reasoningLevel = "unsupported";
+    release();
+    const saved = await pending;
+    assert.equal(saved.defaultModelSelection?.modelId, "primary");
+    assert.equal(saved.pageAssistantDefaultModelSelection?.options?.reasoningLevel, "auto");
+    let writes = 0;
+    let oldDefault = f.selection("primary");
+    const legacy = createModelSelectionService(
+      createNodeModelSelectionFacade(f.runtime.registryService),
+      async () => {},
+      {
+        read: async () => oldDefault,
+        readPreferences: async () => ({
+          defaultModelSelection: oldDefault,
+          favoriteModelSelections: [],
+        }),
+        savePreferences: async (patch) => {
+          writes++;
+          if (patch.defaultModelSelection)
+            oldDefault = patch.defaultModelSelection as typeof oldDefault;
+        },
+      },
+    );
+    try {
+      assert.equal((await legacy.getPreferences()).revision, "");
+      assert.equal((await legacy.getView()).preferencesRevision, undefined);
+      await assert.rejects(
+        legacy.savePreferences({
+          defaultModelSelection: f.selection("helper"),
+          expectedRevision: "unavailable-version",
+        }),
+        { code: "model_preference_unsupported" },
+      );
+      assert.equal(writes, 0);
+      const compatible = await legacy.savePreferences({
+        defaultModelSelection: f.selection("helper"),
+      });
+      assert.equal(compatible.defaultModelSelection?.modelId, "helper");
+      assert.equal(compatible.revision, "");
+      assert.equal(writes, 1);
+    } finally {
+      legacy.dispose();
+    }
+  } finally {
+    waiting.dispose();
+    await f.close();
+  }
+});
diff --git a/packages/services/test/page-assistant-rpc.test.ts b/packages/services/test/page-assistant-rpc.test.ts
