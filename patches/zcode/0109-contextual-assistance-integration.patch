+  ContextMenuTrigger,
+} from "@/components/ui/context-menu.js";
+import { Popover, PopoverAnchor, PopoverContent } from "@/components/ui/popover.js";
+import { useServices } from "@/hooks/useServices.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { V4ConversationProvider } from "@/v4/V4ConversationContext.js";
+import {
+  PageAssistantContext,
+  pageAssistantScope,
+  readPageAssistantSelection,
+  type PageAssistantAnchor,
+} from "./PageAssistantContext.js";
+import { PageAssistantConversation } from "./PageAssistantConversation.js";
+import { PageAssistantHistory, type SavedPageAssistant } from "./PageAssistantHistory.js";
+import { pageAssistantLabel } from "./pageAssistantLabels.js";
+import { useSettings, refreshSettingsAfterExternalCommit } from "@/hooks/useSettingService.js";
+import { logger } from "@/logger.js";
+
+interface Invocation {
+  id: string;
+  selection: PageAssistantSelection;
+  anchor: PageAssistantAnchor;
+  label?: string;
+  saved?: SavedPageAssistant;
+}
+const FALLBACK_PAGE: PageAssistantSelection = { feature: "app-page", pageId: "workspace" };
+function centerAnchor(): PageAssistantAnchor {
+  return { x: window.innerWidth / 2, y: 80 };
+}
+
+function AssistantBody({ invocation }: { invocation: Invocation }) {
+  const { pageAssistantService } = useServices();
+  const { intl } = useZCodeIntl();
+  const [context, setContext] =
+    useState<Awaited<ReturnType<NonNullable<typeof pageAssistantService>["getContext"]>>>();
+  const [failed, setFailed] = useState(false);
+  useEffect(() => {
+    if (invocation.saved) return;
+    if (!pageAssistantService) {
+      setFailed(true);
+      return;
+    }
+    let mounted = true;
+    void pageAssistantService
+      .getContext(invocation.selection)
+      .then((value) => {
+        if (mounted) setContext(value);
+      })
+      .catch(() => {
+        if (mounted) setFailed(true);
+      });
+    return () => {
+      mounted = false;
+    };
+  }, [invocation, pageAssistantService]);
+  const target = invocation.saved?.target ?? context?.target;
+  const workspacePath = invocation.saved?.workspacePath ?? context?.workspacePath;
+  if (failed)
+    return (
+      <p role="alert" className="p-4 text-ui-base text-destructive">
+        {intl.formatMessage({ id: "pageAssistant.failed" })}
+      </p>
+    );
+  if (!target || !workspacePath)
+    return (
+      <p className="p-4 text-ui-base text-foreground-subtle">
+        {intl.formatMessage({ id: "common.loading" })}
+      </p>
+    );
+  return (
+    <V4ConversationProvider workspacePath={workspacePath}>
+      <PageAssistantConversation
+        workspacePath={workspacePath}
+        target={target}
+        defaultModelSelection={invocation.saved ? undefined : context?.defaultModelSelection}
+        resumeSessionId={invocation.saved?.sessionId}
+      />
+    </V4ConversationProvider>
+  );
+}
+
+/** One presentation owner; accepted work and saved history remain with the existing Host. */
+export function PageAssistantHost({ children }: { children: ReactNode }) {
+  const platform = usePlatform();
+  const { pageAssistantService, settingService, broadcastService } = useServices();
+  const { intl } = useZCodeIntl();
+  const [invocation, setInvocation] = useState<Invocation | null>(null);
+  useSettings();
+  useEffect(() => {
+    const subscription = pageAssistantService?.onDidChange((event) => {
+      // 接受结果后重读原设置 owner；不重写值，也不让已关闭小窗漏掉后台提交。
+      void refreshSettingsAfterExternalCommit(settingService)
+        .then(async (settings) => {
+          const patch = Object.fromEntries(event.keys.map((key) => [key, settings[key]]));
+          if (event.keys.includes("localePreference")) {
+            Object.assign(patch, { locale: settings.locale });
+            await broadcastService.send({
+              channel: "state:locale",
+              payload: {
+                preference: settings.localePreference ?? settings.locale,
+                resolvedLocale: settings.locale,
+              },
+            });
+          }
+          platform.syncAppSettings?.(patch);
+        })
+        .catch((error) =>
+          logger.warn(`[page-assistant] committed preference refresh failed: ${String(error)}`),
+        );
+    });
+    return () => subscription?.dispose();
+  }, [pageAssistantService, settingService, broadcastService, platform]);
+  const captured = useRef<{
+    selection: PageAssistantSelection;
+    anchor: PageAssistantAnchor;
+    label?: string;
+  }>({ selection: FALLBACK_PAGE, anchor: centerAnchor() });
+  const focusReturn = useRef<HTMLElement | null>(null);
+  const capturedFocus = useRef<HTMLElement | null>(null);
+  const open = useCallback(
+    (
+      selection: PageAssistantSelection,
+      anchor = centerAnchor(),
+      label?: string,
+      saved?: SavedPageAssistant,
+    ) => {
+      const parsed = pageAssistantSelectionSchema.safeParse(selection);
+      if (!parsed.success) return;
+      focusReturn.current =
+        document.activeElement instanceof HTMLElement ? document.activeElement : null;
+      // 新唤起始终换 generation；只有明确历史选择才带已有 Session ID。
+      setInvocation({
+        id: crypto.randomUUID(),
+        selection: structuredClone(parsed.data),
+        anchor,
+        label,
+        saved,
+      });
+    },
+    [],
+  );
+  const controller = useMemo(
+    () => ({
+      open,
+      openCaptured: () => {
+        open(captured.current.selection, captured.current.anchor, captured.current.label);
+        focusReturn.current = capturedFocus.current;
+      },
+    }),
+    [open],
+  );
+  useEffect(
+    () =>
+      platform.onPageAssistantRequest?.((request) => {
+        const selection = request.selection ?? captured.current.selection;
+        open(
+          selection,
+          request.anchor ?? captured.current.anchor,
+          request.selection ? undefined : captured.current.label,
+        );
+      }),
+    [platform, open],
+  );
+  const resume = (saved: SavedPageAssistant) => {
+    const selection: PageAssistantSelection =
+      saved.target.feature === "model-settings"
+        ? {
+            feature: "model-settings",
+            providerId: saved.target.providerId,
+            ...(saved.target.modelId ? { modelId: saved.target.modelId } : {}),
+          }
+        : saved.target;
+    open(selection, invocation?.anchor, undefined, saved);
+  };
+  return (
+    <PageAssistantContext.Provider value={controller}>
+      <ContextMenu>
+        <ContextMenuTrigger asChild>
+          <div
+            className="h-full"
+            onKeyDownCapture={(event) => {
+              if (!(event.shiftKey && event.key === "F10") && event.key !== "ContextMenu") return;
+              if (
+                !(event.target instanceof HTMLElement) ||
+                event.target.closest('input,textarea,[contenteditable="true"]')
+              )
+                return;
+              const trigger = event.target.closest('[data-slot="context-menu-trigger"]');
+              if (trigger && trigger !== event.currentTarget) return;
+              const selection = readPageAssistantSelection(event.target);
+              if (!selection) return;
+              capturedFocus.current =
+                document.activeElement instanceof HTMLElement ? document.activeElement : null;
+              const bounds = event.target.getBoundingClientRect();
+              event.preventDefault();
+              event.stopPropagation();
+              open(
+                selection,
+                { x: bounds.right, y: bounds.bottom },
+                event.target.closest<HTMLElement>("[data-page-assistant-label]")?.dataset
+                  .pageAssistantLabel,
+              );
+            }}
+            onContextMenuCapture={(event) => {
+              if (!(event.target instanceof Element)) return;
+              const selection = readPageAssistantSelection(event.target);
+              if (!selection) return;
+              capturedFocus.current =
+                document.activeElement instanceof HTMLElement ? document.activeElement : null;
+              captured.current = {
+                selection,
+                anchor: { x: event.clientX, y: event.clientY },
+                label: event.target.closest<HTMLElement>("[data-page-assistant-label]")?.dataset
+                  .pageAssistantLabel,
+              };
+              // 文本字段继续走原生复制/粘贴；已有独立 DOM 菜单仍由自己的 trigger 处理。
+              const trigger = event.target.closest('[data-slot="context-menu-trigger"]');
+              if (
+                event.target.closest('input,textarea,[contenteditable="true"]') &&
+                (!trigger || trigger === event.currentTarget)
+              )
+                event.stopPropagation();
+              else if (
+                (!trigger || trigger === event.currentTarget) &&
+                !window.getSelection()?.toString() &&
+                !event.target.closest(
+                  '[data-slot="dropdown-menu-content"], [data-slot="select-content"], [data-slot="context-menu-content"], [role="menu"], [role="listbox"]',
+                )
+              ) {
+                // 普通页面右键直接打开对话小窗，不再增加一个只含“让 Agent 帮忙”的中间菜单。
+                event.preventDefault();
+                event.stopPropagation();
+                open(captured.current.selection, captured.current.anchor, captured.current.label);
+              }
+            }}
+          >
+            {children}
+          </div>
+        </ContextMenuTrigger>
+        <ContextMenuContent omitPageAssistant>
+          <ContextMenuItem onSelect={controller.openCaptured}>
+            {intl.formatMessage({ id: "pageAssistant.open" })}
+          </ContextMenuItem>
+        </ContextMenuContent>
+      </ContextMenu>
+      <Popover
+        open={Boolean(invocation)}
+        onOpenChange={(next) => {
+          if (!next) setInvocation(null);
+        }}
+      >
+        <PopoverAnchor asChild>
+          <div
+            className="pointer-events-none fixed h-0 w-0"
+            style={{ left: invocation?.anchor.x ?? 0, top: invocation?.anchor.y ?? 0 }}
+          />
+        </PopoverAnchor>
+        <PopoverContent
+          side="bottom"
+          align="end"
+          className="flex h-[min(32rem,calc(100dvh-2rem))] w-[min(28rem,calc(100vw-2rem))] flex-col overflow-hidden p-0"
+          {...(invocation ? pageAssistantScope(invocation.selection) : {})}
+          onInteractOutside={(event) => {
+            if (
+              (event.target as Element)?.closest(
+                '[data-slot="context-menu-content"], [data-slot="dialog-content"], [data-slot="select-content"]',
+              )
+            )
+              event.preventDefault();
+          }}
+          onCloseAutoFocus={(event) => {
+            event.preventDefault();
+            if (focusReturn.current?.isConnected) focusReturn.current.focus();
+          }}
+        >
+          <div className="flex min-w-0 items-center justify-between gap-2 border-b border-border p-3">
+            <span className="min-w-0 truncate text-ui-base font-semibold">
+              {invocation?.label ??
+                (invocation ? pageAssistantLabel(intl, invocation.selection) : "")}
+            </span>
+            <div className="flex items-center gap-1">
+              <PageAssistantHistory onResume={resume} />
+              <Button
+                variant="ghost"
+                size="icon-sm"
+                onClick={() => setInvocation(null)}
+                aria-label={intl.formatMessage({ id: "common.close" })}
+              >
+                <X className="size-4" />
+              </Button>
+            </div>
+          </div>
+          <div className="min-h-0 flex-1">
+            {invocation ? <AssistantBody key={invocation.id} invocation={invocation} /> : null}
+          </div>
+        </PopoverContent>
+      </Popover>
+    </PageAssistantContext.Provider>
+  );
+}
