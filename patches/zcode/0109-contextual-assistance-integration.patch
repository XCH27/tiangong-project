+/** 外部提交不能借用提交前启动的旧读取；仍更新同一 service-scoped 原快照。 */
+export async function refreshSettingsAfterExternalCommit(settingService: ISettingService): Promise<AppSettings> {
+  const store = getSettingsStore(settingService);
+  await store.inflightRefresh;
+  await refreshSettingsStore(settingService);
+  if (store.snapshot.error) throw store.snapshot.error;
+  if (!store.snapshot.settings) throw new Error("Settings snapshot is unavailable after commit");
+  return store.snapshot.settings;
+}
 
