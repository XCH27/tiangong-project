+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import type { IModelSelectionService, ModelSelectionView } from "@zcode/services";
+import { TID_CHAT_MODEL_SELECT_ITEM, testId, type ModelSelection } from "@zcode/shared";
+import { ModelPurposeDefaults } from "../src/settings/ModelPurposeDefaults.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { encodeCustomModelValue } from "../src/lib/zcodeCustomModelValue.js";
+import { useRemoteWorkspaceSessionStore } from "../src/store/remoteWorkspaceSessionStore.js";
+
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT =
+  true;
+type Locale = "zh-CN" | "en-US";
+type Patch = Parameters<IModelSelectionService["savePreferences"]>[0];
+type Preferences = Awaited<ReturnType<IModelSelectionService["getPreferences"]>>;
+const results: { name: string; error?: string }[] = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const equal = (actual: unknown, expected: unknown, message: string) =>
+  check(JSON.stringify(actual) === JSON.stringify(expected), message);
+const selection = (modelId: string, providerId = "connected"): ModelSelection => ({
+  providerId,
+  modelId,
+  options: { reasoningLevel: "high" },
+});
+
+function catalog(): ModelSelectionView {
+  const model = (modelId: string) => ({
+    modelId,
+    config: {
+      enabled: true,
+      properties: {
+        contextWindow: 128000,
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: true,
+        requiresMfjsToolSchema: false,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: false,
+          supportsVideo: false,
+          supportsAudio: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+      },
+      optionSpecs: {
+        reasoningLevel: { values: ["auto", "low", "high"], defaultValue: "high", map: "{}" },
+        maxOutputTokens: { max: 8192, map: "{}" },
+      },
+    },
+  });
+  return {
+    revision: 1,
+    preferencesRevision: "personal-7",
+    configuredDefaultSelection: selection("alpha"),
+    pageAssistantDefaultSelection: selection("beta"),
+    providers: [
+      {
+        providerId: "connected",
+        providerName: "First connection",
+        config: { api: { type: "openai-responses", baseUrl: "https://fixture.invalid/v1" } },
+        models: [model("alpha"), model("beta")],
+      },
+      {
+        providerId: "second",
+        providerName: "Second connection",
+        config: { api: { type: "openai-responses", baseUrl: "https://second.invalid/v1" } },
+        models: [model("gamma")],
+      },
+    ],
+  };
+}
+
+function host(initial = catalog()) {
+  let view = initial;
+  let readError: Error | undefined;
+  let reads = 0;
+  const listeners = new Set<(view: ModelSelectionView) => void>();
+  const writes: { patch: Patch; result: ReturnType<typeof Promise.withResolvers<Preferences>> }[] =
+    [];
+  const preferences = (): Preferences => ({
+    revision: view.preferencesRevision ?? "",
+    defaultModelSelection: view.configuredDefaultSelection,
+    pageAssistantDefaultModelSelection: view.pageAssistantDefaultSelection,
+    favoriteModelSelections: [],
+  });
+  const service: IModelSelectionService = {
+    onDidChange(listener) {
+      listeners.add(listener);
+      return {
+        dispose: () => {
+          listeners.delete(listener);
+        },
+      };
+    },
+    async getView() {
+      reads += 1;
+      if (readError) throw readError;
+      return view;
+    },
+    async getPreferences() {
+      return preferences();
+    },
+    savePreferences(patch) {
+      const result = Promise.withResolvers<Preferences>();
+      writes.push({ patch: structuredClone(patch), result });
+      return result.promise;
+    },
+  };
+  return {
+    service,
+    writes,
+    get view() {
+      return view;
+    },
+    get reads() {
+      return reads;
+    },
+    get listenerCount() {
+      return listeners.size;
+    },
+    failRead(error?: Error) {
+      readError = error;
+    },
+    async commit(index: number) {
+      const write = writes[index]!;
+      view = {
