index 0000000..56d66c8
--- /dev/null
+++ b/packages/services/test/page-assistant-rpc.test.ts
@@ -0,0 +1,172 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { ChannelClient, ChannelServer, ProxyChannel, createQueuePair } from "@zcode/rpc";
+import { IPageAssistantService } from "@zcode/services";
+import type { ModelSelection, PageAssistantSelection } from "@zcode/shared";
+import type { ModelPreferences } from "../src/model-provider/modelSelectionService.js";
+import { RemoteServiceAccess } from "../../client/src/remoteServiceAccess.js";
+import { createPageAssistantService } from "../src/page-assistant/pageAssistantService.js";
+import { createSettingService } from "../src/setting/settingService.js";
+
+const pageDefault: ModelSelection = {
+  providerId: "page-provider",
+  modelId: "page-model",
+  options: { reasoningLevel: "high", speedMode: "fast", contextWindow: 65_536 },
+};
+const globalDefault: ModelSelection = {
+  providerId: "conversation-provider",
+  modelId: "conversation-model",
+  options: { reasoningLevel: "medium", speedMode: "standard", contextWindow: 131_072 },
+};
+const general: PageAssistantSelection = { feature: "app-page", pageId: "general" };
+
+async function fixture() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-page-rpc-"));
+  const previousProfile = process.env.ZCODE_DESKTOP_HOME_DIR;
+  process.env.ZCODE_DESKTOP_HOME_DIR = dir;
+  const setting = createSettingService();
+  await setting.update({ keepAwakeWhileRunning: false });
+  let preferences: ModelPreferences = {
+    revision: "fixture-revision",
+    favoriteModelSelections: [],
+    defaultModelSelection: globalDefault,
+    pageAssistantDefaultModelSelection: pageDefault,
+  };
+  const service = createPageAssistantService({
+    settingService: setting,
+    modelSelectionService: {
+      async getPreferences() {
+        return structuredClone(preferences);
+      },
+    } as never,
+    providerSettingsService: {
+      async modelSettingsAssistantContext(providerId: string, modelId?: string) {
+        return {
+          workspacePath: dir,
+          view: { target: { feature: "model-settings", providerId, modelId, openingRevision: 9 } },
+        };
+      },
+    } as never,
+    workspacePath: () => dir,
+  });
+  // These are the real serialized Channel and service-proxy layers used by RemoteServiceAccess.
+  const [rendererProtocol, hostProtocol] = createQueuePair();
+  const server = new ChannelServer(hostProtocol, "test-host");
+  server.registerChannel(IPageAssistantService.channelName, ProxyChannel.fromService(service));
+  const client = new ChannelClient(rendererProtocol);
+  const access = new RemoteServiceAccess(client);
+  return {
+    dir,
+    setting,
+    service,
+    access,
+    setPreferences(value: ModelPreferences) {
+      preferences = structuredClone(value);
+    },
+    async close() {
+      client.dispose();
+      server.dispose();
+      if (previousProfile === undefined) delete process.env.ZCODE_DESKTOP_HOME_DIR;
+      else process.env.ZCODE_DESKTOP_HOME_DIR = previousProfile;
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test("RemoteServiceAccess routes page getContext and committed preference events across the public RPC channel", async () => {
+  const f = await fixture();
+  try {
+    assert.ok(
+      f.access.pageAssistantService,
+      "The renderer accessor must publish the PageAssistant proxy",
+    );
+    const result = await f.access.pageAssistantService.getContext(general);
+    assert.equal(result.workspacePath, f.dir);
+    assert.deepEqual(result.target, general);
+    assert.deepEqual(result.defaultModelSelection, pageDefault);
+    const changes: unknown[] = [];
+    const subscription = f.access.pageAssistantService.onDidChange((event) => changes.push(event));
+    // A round trip also places the event-listen request before the subsequent write.
+    await f.access.pageAssistantService.getContext(general);
+    await f.access.pageAssistantService.perform(general, {
+      operation: "set-preference",
+      key: "keepAwakeWhileRunning",
+      value: true,
+      expectedValue: false,
+    });
+    assert.equal((await f.setting.get()).keepAwakeWhileRunning, true);
+    assert.deepEqual(changes, [{ kind: "preferences", keys: ["keepAwakeWhileRunning"] }]);
+    await assert.rejects(
+      f.access.pageAssistantService.perform(general, {
+        operation: "set-preference",
+        key: "keepAwakeWhileRunning",
+        value: false,
+        expectedValue: false,
+      }),
+      /conflict/,
+    );
+    assert.equal((await f.setting.get()).keepAwakeWhileRunning, true);
+    assert.equal(
+      changes.length,
+      1,
+      "A rejected RPC mutation must not emit a committed-state event",
+    );
+    subscription.dispose();
+    await f.access.pageAssistantService.perform(general, {
+      operation: "set-preference",
+      key: "keepAwakeWhileRunning",
+      value: false,
+      expectedValue: true,
+    });
+    assert.equal(changes.length, 1, "Disposed renderer listeners must not retain the old window");
+  } finally {
+    await f.close();
+  }
+});
+
+test("model-setting getContext survives the same accessor/channel without changing its typed target or full default options", async () => {
+  const f = await fixture();
+  try {
+    const result = await f.access.pageAssistantService.getContext({
+      feature: "model-settings",
+      providerId: "selected-provider",
+      modelId: "selected-model",
+    });
+    assert.deepEqual(result.target, {
+      feature: "model-settings",
+      providerId: "selected-provider",
+      modelId: "selected-model",
+      openingRevision: 9,
+    });
+    assert.deepEqual(result.defaultModelSelection, pageDefault);
+  } finally {
+    await f.close();
+  }
+});
+
+test("an unset page default falls back to the exact configured conversation default across RPC; no default stays absent", async () => {
+  const f = await fixture();
+  try {
+    f.setPreferences({
+      revision: "global-only",
+      favoriteModelSelections: [],
+      defaultModelSelection: globalDefault,
+    });
+    const result = await f.access.pageAssistantService.getContext(general);
+    assert.deepEqual(
+      result.defaultModelSelection,
+      globalDefault,
+      "Fallback must preserve provider/model and all effort/Fast/context options",
+    );
+    f.setPreferences({ revision: "none", favoriteModelSelections: [] });
+    assert.equal(
+      (await f.access.pageAssistantService.getContext(general)).defaultModelSelection,
+      undefined,
+    );
+  } finally {
+    await f.close();
+  }
+});
diff --git a/packages/services/test/page-assistant.test.ts b/packages/services/test/page-assistant.test.ts
