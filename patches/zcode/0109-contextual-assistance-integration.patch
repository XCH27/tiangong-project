--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/page-assistant.ts
@@ -0,0 +1,78 @@
+import type { PageAssistantPort, SessionStorePort, SessionId } from "@zcode/contracts";
+import {
+  PAGE_ASSISTANT_ENTRY,
+  MODEL_SETTINGS_ASSISTANT_ENTRY,
+  appPageAssistantTargetSchema,
+  modelSettingsAssistantTargetSchema,
+  pageAssistantContextSchema,
+  pageAssistantTools,
+  pageAssistantInstructions,
+  zcodeProtocolMethods,
+  pageAssistantFailureReasonSchema,
+  PageAssistantOperationError,
+  type AppPageAssistantTarget,
+  type PageAssistantTarget,
+} from "@zcode/shared";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function pageAssistantConfig(input: AppPageAssistantTarget) {
+  const target = appPageAssistantTargetSchema.parse(input);
+  return {
+    pageAssistantTarget: target,
+    taskType: "page_assistant" as const,
+    systemPrompt: pageAssistantInstructions(target),
+    toolAllowlist: [...pageAssistantTools(target)],
+    mode: "build" as const,
+    planEnabled: false,
+    dynamicWorkflowEnabled: false,
+    titleGeneration: { enabled: false },
+    hooks: { enabled: false, events: {}, timeoutMs: 60000, maxOutputBytes: 32768 },
+    mcp: { enabled: false, servers: {} },
+    memory: { enabled: false },
+    subagents: { enabled: false },
+  };
+}
+export function createPageAssistantPort(
+  context: ZCodeProtocolAgentServerContext,
+  sessionId: string,
+  input: AppPageAssistantTarget,
+): PageAssistantPort {
+  const target = appPageAssistantTargetSchema.parse(input);
+  return {
+    async perform(command, signal) {
+      signal?.throwIfAborted();
+      try {
+        return await context.requestClient(
+          zcodeProtocolMethods.interactionPageAssistant,
+          { sessionId, target, command },
+          pageAssistantContextSchema,
+          { signal, timeoutMs: 15000 },
+        );
+      } catch (error) {
+        const data = error && typeof error === "object" && "data" in error ? error.data : undefined;
+        const reason = pageAssistantFailureReasonSchema.safeParse(
+          data && typeof data === "object" && "reasonCode" in data ? data.reasonCode : undefined,
+        );
+        throw new PageAssistantOperationError(reason.success ? reason.data : "operation_failed");
+      }
+    },
+  };
+}
+/** An explicit old-session resume reads its original target, never a new page or current defaults. */
+export async function readStoredPageAssistantTarget(
+  store: SessionStorePort | undefined,
+  sessionId: string,
+): Promise<PageAssistantTarget> {
+  const generic = await store?.sessionEntries?.({
+    sessionID: sessionId as SessionId,
+    type: PAGE_ASSISTANT_ENTRY,
+  });
+  if (generic?.length) return appPageAssistantTargetSchema.parse(generic[0]!.data);
+  const legacy = await store?.sessionEntries?.({
+    sessionID: sessionId as SessionId,
+    type: MODEL_SETTINGS_ASSISTANT_ENTRY,
+  });
+  if (!legacy?.length)
+    throw new Error("Page assistant target is missing; unrestricted resume is forbidden");
+  return modelSettingsAssistantTargetSchema.parse(legacy[0]!.data);
+}
