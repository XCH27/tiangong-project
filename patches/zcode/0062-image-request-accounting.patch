+test("repeated upstream image call IDs retain every charged request and artifact after restart", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-image-accounting-"));
+  const dbPath = join(root, "sessions.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  const artifacts = new NodeToolArtifactStore({
+    rootDir: join(root, "artifacts"),
+    imageCacheRootDir: join(root, "images"),
+    videoCacheRootDir: join(root, "videos"),
+  });
+  const uris: string[] = [];
+  try {
+    await store.createSession({
+      id: "session" as never,
+      projectID: "project" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const [, generate] = createMediaGenerationToolEntries({
+      listModels: () => [],
+      prepareImage: async () => "fixture-binding",
+      async generateImage() {
+        return {
+          bytes: Buffer.from([0xff, 0xd8, 0xff]),
+          mimeType: "image/jpeg",
+          reportedModelId: "grok-image",
+          reportedCostUsd: 0.04,
+        };
+      },
+    });
+    for (const [turnId, assistantMessageId] of [
+      ["turn-a", "request-1"],
+      ["turn-a", "request-2"],
+      ["turn-b", "request-3"],
+    ]) {
+      const result = (await generate.handler(
+        {
+          providerId: "xai",
+          modelId: "grok-image",
+          prompt: "A square",
+          binding: "fixture-binding",
+        },
+        {
+          abortSignal: new AbortController().signal,
+          sessionId: "session",
+          toolCallId: "reused-image-call",
+          turnId,
+          traceContext: { traceId: "trace", turnId, attributes: { assistantMessageId } },
+          workspaceRoot: root,
+          artifactStore: artifacts,
+          sessionStore: store,
+        } as unknown as ToolExecutionContext,
+      )) as { artifactUri: string };
+      uris.push(result.artifactUri);
+    }
+    const checkLedger = async () => {
+      const result = await store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(result.accounting?.[0]?.requestCount, 3);
+      assert.ok(Math.abs((result.accounting?.[0]?.estimatedUsd ?? 0) - 0.12) < 1e-10);
+    };
+    await checkLedger();
+    store.close();
+    store = new SqliteSessionStore({ dbPath });
+    await checkLedger();
+    assert.equal(new Set(uris).size, 3);
+    for (const uri of uris)
+      assert.match(
+        (await artifacts.readToolResultArtifact({ uri })).content,
+        /^data:image\/jpeg;base64,/,
+      );
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
