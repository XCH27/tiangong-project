+test("a known local refusal is diagnosed as not submitted and survives replay", async () => {
+  const { MediaSubmissionNotStartedError } = await import("@zcode/contracts");
+  const f = await setup(); let calls = 0;
+  const port: MediaGenerationPort = { listModels: () => [], prepareImage: async () => "unused", generateImage: async () => { throw new Error("unused"); },
+    submitVideo: async () => { calls++; throw new MediaSubmissionNotStartedError("The original credential was removed; no request was submitted"); } };
+  const generate = createMediaGenerationToolEntries(port).find((tool) => tool.metadata.name === "GenerateVideo")!;
+  try {
+    const result = await generate.handler(request, f.context()) as any;
+    assert.equal(result.status, "failed"); assert.match(result.message, /no request was submitted/);
+    await f.reopen(); const repeated = await generate.handler(request, f.context()) as any;
+    assert.equal(repeated.message, result.message); assert.equal(calls, 1);
+  } finally { await f.close(); }
+});
