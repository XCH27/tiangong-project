+test("daily model, turn and tool buckets retain local dates across DST and zone changes", async () => {
+  const f = await fixture();
+  const sessionID = "session" as SessionId;
+  const dates = [
+    ["spring-before", "2026-03-08T07:30:00Z", "2026-03-07"],
+    ["spring-after", "2026-03-09T07:30:00Z", "2026-03-09"],
+    ["fall-before", "2026-11-01T07:30:00Z", "2026-11-01"],
+    ["fall-after", "2026-11-02T07:30:00Z", "2026-11-01"],
+  ];
+  try {
+    for (const [id, timestamp] of dates) {
+      const startedAt = Date.parse(timestamp!);
+      await f.record(id!, "a", "standard", { startedAt, inputTokens: 10, outputTokens: 1 });
+      await f.store.upsertTurnUsage({
+        sessionID,
+        turnID: id as TurnId,
+        status: "completed",
+        startedAt,
+      });
+      await f.store.upsertToolUsage({
+        id: id!,
+        sessionID,
+        toolCallID: id!,
+        toolName: "Read",
+        status: "completed",
+        startedAt,
+      });
+    }
+    const input = { since: 0, until: Date.parse("2026-12-01T00:00:00Z"), tzOffsetMs: -8 * 3600000 };
+    const read = (timeZone?: string) => f.store.queryAppUsage({ ...input, timeZone });
+    const local = await read("America/Los_Angeles");
+    const dayIndex = (date: string) => Date.parse(date) / 86400000;
+    const bucket = (date: string) => local.days.find((row) => row.dayIndex === dayIndex(date));
+    assert.deepEqual(bucket("2026-03-07"), {
+      dayIndex: dayIndex("2026-03-07"),
+      totalTokens: 11,
+      turnCount: 1,
+      toolCallCount: 1,
+    });
+    assert.equal(bucket("2026-03-09")?.totalTokens, 11);
+    assert.equal(bucket("2026-11-01")?.totalTokens, 22);
+    assert.equal(bucket("2026-11-01")?.turnCount, 2);
+    assert.equal(bucket("2026-11-01")?.toolCallCount, 2);
+    assert.equal(
+      local.dayModels.find((row) => row.dayIndex === dayIndex("2026-11-01"))?.totalTokens,
+      22,
+    );
+    const utc = await read("UTC");
+    assert.equal(utc.days.length, 4);
+    assert.equal(utc.days.find((row) => row.dayIndex === dayIndex("2026-11-02"))?.totalTokens, 11);
+    assert.deepEqual((await read("America/Los_Angeles")).days, local.days);
+    assert.equal(
+      (await read()).days.find((row) => row.dayIndex === dayIndex("2026-03-08"))?.totalTokens,
+      11,
+    );
+    f.reopen();
+    assert.deepEqual((await read("America/Los_Angeles")).days, local.days);
+    await assert.rejects(read("invalid/timezone"), RangeError);
+    assert.deepEqual((await read("UTC")).days, utc.days);
+  } finally {
+    await f.close();
+  }
 });
