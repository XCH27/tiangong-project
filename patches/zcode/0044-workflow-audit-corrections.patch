diff --git a/apps/zcode-cli/packages/bootstrap/test/usage-calendar.test.ts b/apps/zcode-cli/packages/bootstrap/test/usage-calendar.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..158477b1a843f64c2fb029ec937c4ad2d3a95eef
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/usage-calendar.test.ts
@@ -0,0 +1,75 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { AppUsageQueryResult } from "@zcode/contracts";
+import {
+  buildAppUsageSnapshot,
+  resolveTzOffsetMs,
+} from "../src/zcode-protocol/usage-stats-builder.js";
+import { getUsageStats } from "../src/zcode-protocol/server-operations.js";
+
+const empty: AppUsageQueryResult = {
+  totals: {
+    totalTokens: 0,
+    inputTokens: 0,
+    outputTokens: 0,
+    reasoningTokens: 0,
+    cacheCreationTokens: 0,
+    cacheReadTokens: 0,
+    modelRequestCount: 0,
+    modelErrorCount: 0,
+    avgTimeToFirstTokenMs: null,
+  },
+  turnTotals: { totalSessions: 0, totalTurns: 0, avgTurnDurationMs: null, longestSessionMs: 0 },
+  toolTotals: { toolCallCount: 0, toolErrorCount: 0 },
+  models: [],
+  tools: [],
+  days: [],
+  dayModels: [],
+};
+
+test("historical chart bounds use each boundary's own timezone offset", () => {
+  const timeZone = "America/Los_Angeles";
+  const since = Date.parse("2026-03-08T07:30:00Z");
+  const until = Date.parse("2026-03-10T07:30:00Z");
+  assert.equal(resolveTzOffsetMs(timeZone, since), -8 * 3600000);
+  assert.equal(resolveTzOffsetMs(timeZone, until), -7 * 3600000);
+  const snapshot = buildAppUsageSnapshot(empty, {
+    range: "7d",
+    timeZone,
+    tzOffsetMs: resolveTzOffsetMs(timeZone, until),
+    since,
+    until,
+    generatedAt: until,
+  });
+  assert.equal(snapshot.heatmap.startDate, "2026-03-07");
+  assert.equal(snapshot.heatmap.endDate, "2026-03-10");
+  assert.deepEqual(
+    snapshot.dailyModelUsage.map((day) => day.date),
+    ["2026-03-07", "2026-03-08", "2026-03-09", "2026-03-10"],
+  );
+});
+
+test("the existing stats protocol passes timezone through and rejects a missing ledger", async () => {
+  const params = { range: "7d", timeZone: "America/Los_Angeles", since: 100, until: 200 };
+  await assert.rejects(getUsageStats({ deps: {} } as never, params), /usage_stats_unavailable/);
+  const snapshot = await getUsageStats(
+    {
+      deps: {
+        sessionStore: {
+          queryAppUsage: async (input: unknown) => {
+            assert.deepEqual(input, {
+              since: 100,
+              until: 200,
+              tzOffsetMs: -8 * 3600000,
+              timeZone: params.timeZone,
+            });
+            return empty;
+          },
+        },
+      },
+    } as never,
+    params,
+  );
+  assert.equal(snapshot.source, "agent-db");
+  assert.equal(snapshot.summary.totalTokens, 0);
+});
