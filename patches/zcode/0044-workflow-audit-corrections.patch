-  connectionSelections?: ProviderFamilyConnectionSelectionSettings;
-  teamPlanSelections?: Partial<
-    Record<
-      ProviderFamilyDomain,
-      Extract<ProviderFamilyConnectionSelection, { kind: "team-coding-plan" }>
-    >
