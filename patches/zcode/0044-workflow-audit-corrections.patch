index 0000000000000000000000000000000000000000..e6780e33e5e9ccb4845a33ea72ba061d628a6745
--- /dev/null
+++ b/packages/services/test/plugin-storage-scope.test.ts
@@ -0,0 +1,112 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, writeFile, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { createSkillsService } from "../src/skills/skillsService.js";
+import { createCommandsService } from "../src/commands/commandsService.js";
+import { createSubagentsService } from "../src/subagents/subagentsService.js";
+
+test("Settings plugin resources follow the runtime storage override rather than another cached version", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-plugin-scope-"));
+  const previousHome = process.env.ZCODE_DESKTOP_HOME_DIR;
+  const previousStorage = process.env.ZCODE_STORAGE_DIR;
+  const home = join(dir, "home");
+  const configured = join(dir, "configured");
+  const overridden = join(dir, "overridden");
+  const workspacePath = join(dir, "workspace");
+  const id = "storage-fixture@fixture";
+  async function seed(root: string, label: string) {
+    const pluginStorage = join(root, "cli", "plugins");
+    const plugin = join(pluginStorage, "fixture-package");
+    for (const folder of [".zcode-plugin", "skills/fixture", "commands", "agents"]) {
+      await mkdir(join(plugin, folder), { recursive: true });
+    }
+    await writeFile(
+      join(plugin, ".zcode-plugin/plugin.json"),
+      JSON.stringify({
+        name: "storage-fixture",
+        version: "1",
+        skills: "skills",
+        commands: "commands",
+        agents: "agents",
+      }),
+    );
+    await writeFile(
+      join(plugin, "skills/fixture/SKILL.md"),
+      `---\nname: skill-${label}\ndescription: Fixture ${label}\n---\n${label}`,
+    );
+    await writeFile(
+      join(plugin, "commands/fixture.md"),
+      `---\ndescription: Fixture ${label}\n---\n${label}`,
+    );
+    await writeFile(
+      join(plugin, "agents/fixture.md"),
+      `---\nname: agent-${label}\ndescription: Fixture ${label}\ntools: [Read]\n---\n${label}`,
+    );
+    await writeFile(
+      join(pluginStorage, "installed_plugins.json"),
+      JSON.stringify({
+        plugins: [
+          {
+            id,
+            name: "storage-fixture",
+            marketplace: "fixture",
+            installPath: plugin,
+            version: "1",
+            scope: "user",
+            installedAt: "2026-01-01T00:00:00Z",
+          },
+        ],
+      }),
+    );
+  }
+  try {
+    await mkdir(join(home, ".zcode/cli"), { recursive: true });
+    await mkdir(workspacePath);
+    await writeFile(
+      join(home, ".zcode/cli/config.json"),
+      JSON.stringify({
+        storage: { dir: configured },
+        plugins: { enabledPlugins: { [id]: true } },
+      }),
+    );
+    await seed(configured, "old");
+    await seed(overridden, "new");
+    process.env.ZCODE_DESKTOP_HOME_DIR = home;
+    process.env.ZCODE_STORAGE_DIR = overridden;
+    const skills = createSkillsService({ isDesktopRuntime: true });
+    const commands = createCommandsService();
+    const agents = createSubagentsService({ homeDir: home });
+    const read = async () => ({
+      skills: (await skills.list({ workspacePath })).skills.filter((row) => row.pluginId === id),
+      commands: (await commands.list({ workspacePath })).pluginCommands.filter(
+        (row) => row.pluginName === "storage-fixture" && row.pluginMarketplace === "fixture",
+      ),
+      agents: (await agents.list({ workspacePath })).agents.filter((row) => row.pluginId === id),
+    });
+    const current = await read();
+    assert.equal(current.skills.length, 1);
+    assert.match(current.skills[0]!.name, /skill-new/);
+    assert.equal(current.commands.length, 1);
+    assert.match(current.commands[0]!.description!, /Fixture new/);
+    assert.deepEqual(current.agents.map((row) => row.name).sort(), [
+      "agent-new",
+      "storage-fixture:agent-new",
