diff --git a/packages/ui/test/pluginCapabilityProjection.test.ts b/packages/ui/test/pluginCapabilityProjection.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9483e91a376a8fe04942df542c1f7cfc72579d08
--- /dev/null
+++ b/packages/ui/test/pluginCapabilityProjection.test.ts
@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ZCodePluginInfo } from "@zcode/shared";
+import {
+  partitionPluginsForSettings,
+  selectPluginsForScope,
+} from "../src/settings/pluginCapabilityProjection.js";
+
+test("the internal node_repl host remains in runtime inventory but never exposes its own settings switch", () => {
+  const internalId = "node-repl-host@zcode-plugins-official";
+  const browserId = "browser-use@zcode-plugins-official";
+  const inventory = [internalId, browserId].map((id) => ({
+    id,
+    name: id.split("@")[0],
+    source: "official",
+    packageStatus: "available",
+  })) as unknown as ZCodePluginInfo[];
+  const scoped = selectPluginsForScope(inventory, [], "user");
+  assert.equal(scoped.length, 2, "the host remains available to Browser and Computer Use");
+  const settings = partitionPluginsForSettings(scoped, new Set([internalId, browserId]));
+  assert.deepEqual(settings.installed, []);
+  assert.deepEqual(
+    settings.builtIn.map((plugin) => plugin.id),
+    [browserId],
+  );
+});
