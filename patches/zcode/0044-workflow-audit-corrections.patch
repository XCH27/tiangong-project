+const MAX_MODEL_LIST_PAGE_BYTES = 8 * 1024 * 1024;
+const MAX_MODEL_LIST_ENTRIES = 20_000;
+
+/** Bound each untrusted catalog page before JSON parsing, including unknown body lengths. */
+async function readModelListPage(response: Response): Promise<unknown> {
+  if (Number(response.headers.get("content-length")) > MAX_MODEL_LIST_PAGE_BYTES) {
+    await response.body?.cancel();
+    throw new Error("The model list response is too large");
+  }
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("The model list response is empty");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const part = await reader.read();
+      if (part.done) break;
+      size += part.value.byteLength;
+      if (size > MAX_MODEL_LIST_PAGE_BYTES) throw new Error("The model list response is too large");
+      chunks.push(part.value);
+    }
+  } finally {
+    await reader.cancel().catch(() => {});
+    reader.releaseLock();
+  }
+  return JSON.parse(Buffer.concat(chunks, size).toString("utf8"));
+}
