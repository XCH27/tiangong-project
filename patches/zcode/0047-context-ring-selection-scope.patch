new file mode 100644
index 0000000000000000000000000000000000000000..4d897637e82b9f5b362c40546178ccbfbc4d5347
--- /dev/null
+++ b/packages/ui/src/lib/contextUsageModelScope.ts
@@ -0,0 +1,18 @@
+import type { SessionUsageState } from "@zcode/shared/zcode-protocol-v4";
+
+/** 下一次提交改选模型时，Session 的上次用量仍属于原模型；只有身份相同才能显示占用。 */
+export function contextWindowForSelectedModel(
+  contextWindow: SessionUsageState["contextWindow"] | undefined,
+  providerId: string | undefined,
+  modelId: string | undefined,
+  lastRequest?: SessionUsageState["lastRequest"],
+): SessionUsageState["contextWindow"] {
+  if (!providerId || !modelId) return null;
+  const measurement = contextWindow?.measurement;
+  const hasMeasuredIdentity = Boolean(measurement?.providerId || measurement?.modelId);
+  const observedProvider = hasMeasuredIdentity ? measurement?.providerId : lastRequest?.providerId;
+  const observedModel = hasMeasuredIdentity ? measurement?.modelId : lastRequest?.modelId;
+  return observedProvider === providerId && observedModel === modelId
+    ? (contextWindow ?? null)
+    : null;
+}
