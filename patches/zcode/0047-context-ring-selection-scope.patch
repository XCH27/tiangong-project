diff --git a/packages/ui/test/contextUsageModelScope.test.ts b/packages/ui/test/contextUsageModelScope.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3ac052133a3c46ce552a42d48395027ff47bbbb
--- /dev/null
+++ b/packages/ui/test/contextUsageModelScope.test.ts
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { SessionUsageState } from "@zcode/shared/zcode-protocol-v4";
+import { contextWindowForSelectedModel } from "../src/lib/contextUsageModelScope.js";
+
+const sample: NonNullable<SessionUsageState["contextWindow"]> = {
+  usedTokens: 15_629,
+  maxTokens: 272_000,
+  autoCompactThresholdTokens: null,
+  measurement: {
+    source: "provider-usage",
+    state: "current",
+    providerId: "chatgpt",
+    modelId: "gpt-6-sol",
+    observedAt: 1000,
+  },
+};
+
+test("composer context occupancy belongs to the measured provider and model", () => {
+  assert.equal(contextWindowForSelectedModel(sample, "chatgpt", "gpt-6-sol"), sample);
+  assert.equal(contextWindowForSelectedModel(sample, "chatgpt", "gpt-6-luna"), null);
+  assert.equal(contextWindowForSelectedModel(sample, "other-provider", "gpt-6-sol"), null);
+  assert.equal(contextWindowForSelectedModel(sample, undefined, "gpt-6-sol"), null);
+});
+
+test("legacy unowned occupancy cannot be presented as the newly selected model", () => {
+  const legacy = {
+    ...sample,
+    measurement: { source: "unknown" as const, state: "stale" as const },
+  };
+  assert.equal(contextWindowForSelectedModel(legacy, "chatgpt", "gpt-6-sol"), null);
+  const lastRequest = { providerId: "chatgpt", modelId: "gpt-6-sol" };
+  assert.equal(contextWindowForSelectedModel(legacy, "chatgpt", "gpt-6-sol", lastRequest), legacy);
+  assert.equal(contextWindowForSelectedModel(legacy, "chatgpt", "gpt-6-luna", lastRequest), null);
+  const partial = {
+    ...legacy,
+    measurement: { ...legacy.measurement, providerId: "other-provider" },
+  };
+  assert.equal(
+    contextWindowForSelectedModel(partial, "other-provider", "gpt-6-sol", lastRequest),
+    null,
+  );
+  assert.equal(contextWindowForSelectedModel(null, "chatgpt", "gpt-6-sol"), null);
+});
