 }
 
+/** UI receipt only; installed facts remain in the canonical service projection. */
+export interface PluginPackageOperationReceipt {
+  succeeded: boolean;
+  canonicalChanged: boolean;
+  isCurrent(): boolean;
+}
+
+export async function runPluginPackageOperation(
+  set: (partial: Partial<PluginManagementState>) => void,
+  get: () => PluginManagementState,
+  pluginService: IPluginManagementService,
+  operationId: string,
+  operation: (workspace: { workspacePath: string; workspaceIdentity?: string }) => Promise<void>,
+): Promise<PluginPackageOperationReceipt> {
+  const context = capturePluginContext(set, get, pluginService);
+  const version = get().operationVersion + 1;
+  const inventory = () => JSON.stringify([get().plugins, get().installedPlugins]);
+  const before = inventory();
+  const succeeded = await runWorkspaceOperation(set, get, pluginService, operationId, operation, {
+    reconcileFailure: true,
+  });
+  const observed = inventory();
+  const known = get().marketplaceAvailabilityKnown;
+  const generation = context.owner.generation;
+  // A newer readonly observation can retain this receipt when the same facts remain current.
+  const isCurrent = () => isPluginContextCurrent(get, context) && get().operationVersion === version &&
+    (context.owner.generation === generation ||
+      (inventory() === observed && (!known || get().marketplaceAvailabilityKnown)));
+  return {
+    succeeded,
+    canonicalChanged: isCurrent() && known && before !== observed,
+    isCurrent,
+  };
+}
+
 export async function runWorkspaceOperation(
   set: (partial: Partial<PluginManagementState>) => void,
   get: () => PluginManagementState,
