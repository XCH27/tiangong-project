diff --git a/packages/zcode-server-cli/src/runtime/serviceBootstrap.ts b/packages/zcode-server-cli/src/runtime/serviceBootstrap.ts
new file mode 100644
index 00000000..b3b15d36
--- /dev/null
+++ b/packages/zcode-server-cli/src/runtime/serviceBootstrap.ts
@@ -0,0 +1,26 @@
+import { stat } from "node:fs/promises";
+import { createRequire } from "node:module";
+import { basename, dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+// Resolve from this owner, never from the embedding process argv or execArgv.
+export async function resolveServiceBootstrap(moduleUrl: string, command = process.execPath) {
+  const owner = fileURLToPath(moduleUrl);
+  const name = basename(owner);
+  const entry = name === "server-cli.js"
+    ? owner
+    : name === "cli.ts" || name === "cli.js"
+      ? join(dirname(owner), name === "cli.ts" ? "main.ts" : "main.js")
+      : null;
+  if (!entry || !(await stat(entry).catch(() => null))?.isFile()) {
+    throw new Error("Cannot resolve runnable ZCode Server CLI entry");
+  }
+  const args: string[] = [];
+  if (entry.endsWith(".ts")) {
+    // Node cannot resolve main.ts's emitted .js imports without the source loader.
+    const loader = createRequire(pathToFileURL(entry)).resolve("tsx/esm");
+    if (!(await stat(loader)).isFile()) throw new Error("Missing ZCode source CLI loader");
+    args.push("--import", pathToFileURL(loader).href);
+  }
+  return { command, entry, args };
+}
