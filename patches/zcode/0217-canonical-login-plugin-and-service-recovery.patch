@@ -0,0 +1,93 @@
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, writeFile, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { execFileSync } from "node:child_process";
+import { test } from "node:test";
+import { resolveServiceBootstrap } from "../src/runtime/serviceBootstrap.js";
+import { writeStableLauncher } from "../src/runtime/stableLauncher.js";
+import { resolveServerLayout } from "../src/runtime/paths.js";
+
+test("owner entry admission ignores caller argv and rejects missing/non-file entries", async () => {
+  const root = await mkdtemp(join(tmpdir(), "zcode-entry-"));
+  const old = process.argv[1];
+  try {
+    process.argv[1] = "/test/embedding.ts";
+    const owner = pathToFileURL(join(root, "cli.js")).href;
+    await assert.rejects(resolveServiceBootstrap(owner));
+    await mkdir(join(root, "main.js"));
+    await assert.rejects(resolveServiceBootstrap(owner));
+    await rm(join(root, "main.js"), { recursive: true });
+    await writeFile(join(root, "main.js"), "");
+    assert.equal((await resolveServiceBootstrap(owner)).entry, join(root, "main.js"));
+    await writeFile(join(root, "server-cli.js"), "");
+    assert.equal((await resolveServiceBootstrap(pathToFileURL(join(root, "server-cli.js")).href)).entry, join(root, "server-cli.js"));
+    await assert.rejects(resolveServiceBootstrap(pathToFileURL(join(root, "embedding.js")).href));
+  } finally { process.argv[1] = old; await rm(root, { recursive: true, force: true }); }
+});
+
+test("source entry supplies its own tsx loader, never parent test/inspect flags", async () => {
+  const bootstrap = await resolveServiceBootstrap(new URL("../src/cli.ts", import.meta.url).href);
+  assert.ok(bootstrap.entry.endsWith("/main.ts"));
+  assert.equal(bootstrap.args[0], "--import");
+  assert.match(bootstrap.args[1]!, /^file:.*tsx.*esm/);
+  assert.equal(bootstrap.args.length, 2);
+});
+
+test("POSIX bootstrap preserves spaces/quotes and current release keeps precedence", async () => {
+  const root = await mkdtemp(join(tmpdir(), "zcode shell ' -"));
+  try {
+    const layout = resolveServerLayout(root);
+    const capture = join(root, "capture ' file.sh");
+    await writeFile(capture, "#!/bin/sh\nprintf '%s\\n' \"$@\"\n", { mode: 0o755 });
+    const entry = "entry ' with spaces";
+    const launcher = await writeStableLauncher(layout, "darwin", { command: capture, entry, args: ["--import", "loader ' path"] });
+    assert.equal(execFileSync(launcher, ["serve", "argument ' spaced"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }), "--import\nloader ' path\nentry ' with spaces\nserve\nargument ' spaced\n");
+    const releaseDir = join(layout.releasesDir, "release ' one");
+    await mkdir(join(releaseDir, "runtime"), { recursive: true });
+    await writeFile(join(releaseDir, "runtime/node"), "#!/bin/sh\nprintf '%s\\n' \"$@\"\n", { mode: 0o755 });
+    await writeFile(join(root, "current.json"), JSON.stringify({ releaseDir }));
+    assert.equal(execFileSync(launcher, ["status"], { encoding: "utf8" }), `${releaseDir}/runtime/server-cli.js\nstatus\n`);
+    assert.ok((await readFile(launcher, "utf8")).includes("--import"));
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("source bootstrap arguments execute emitted .js imports through the loader", async () => {
+  const root = await mkdtemp(join(tmpdir(), "zcode-source ' -"));
+  try {
+    const bootstrap = await resolveServiceBootstrap(new URL("../src/cli.ts", import.meta.url).href);
+    await writeFile(join(root, "package.json"), '{"type":"module"}');
+    await writeFile(join(root, "sibling.ts"), 'export const result: string = "source-loader-ok";');
+    await writeFile(join(root, "main.ts"), 'import { result } from "./sibling.js"; console.log(result);');
+    assert.equal(execFileSync(bootstrap.command, [...bootstrap.args, join(root, "main.ts")], { encoding: "utf8" }), "source-loader-ok\n");
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("Windows launcher escapes URI percentages, disables delayed expansion and preserves child exit", async () => {
+  const root = await mkdtemp(join(tmpdir(), "zcode-windows-text-"));
+  try {
+    const launcher = await writeStableLauncher(resolveServerLayout(root), "win32", {
+      command: "C:\\Node!\\node.exe",
+      entry: "C:\\source!\\main.ts",
+      args: ["--import", "file:///C:/source%20space%21/loader.mjs"],
+    });
+    const text = await readFile(launcher, "utf8");
+    assert.match(text, /@echo off\r\nsetlocal DisableDelayedExpansion\r\n/);
+    assert.ok(text.includes('"file:///C:/source%%20space%%21/loader.mjs"'));
+    assert.ok(text.includes('"C:\\Node!\\node.exe"'));
+    assert.ok(text.includes('"C:\\source!\\main.ts" %*\r\nexit /b\r\n'));
+    assert.ok(text.includes('"%RELEASE_DIR%\\runtime\\server-cli.js" %*\r\n  exit /b\r\n'));
+    assert.ok(!text.includes("%ERRORLEVEL%"));
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("bootstrap validation follows healthy-service return and precedes destructive service work", async () => {
+  const source = await readFile(new URL("../src/cli.ts", import.meta.url), "utf8");
+  const serve = source.slice(source.indexOf("async function runServe("));
+  const admission = serve.indexOf("await resolveServiceBootstrap(import.meta.url)");
+  assert.ok(serve.indexOf("return 0;") < admission);
+  assert.ok(admission < serve.indexOf('command: "stop"'));
+  assert.ok(admission < serve.indexOf("await writeStableLauncher("));
+  assert.ok(admission < serve.indexOf("await unregisterLegacyServiceForRoot("));
+});
