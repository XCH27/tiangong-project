+    provider?: NativeExecutorKind;
+    executable?: string;
+    configDir?: string;
+    /** ACP sign-in method to run (CLIs that advertise `authenticate` methods). */
+    methodId?: string;
+  }): NativeCliLoginProcess | Promise<NativeCliLoginProcess>;
+}
+export async function inspectNativeCliConnection(
+  access: NonNullable<ProviderConfigObject["access"]>,
+  adapter?: NativeCliConnectionAdapter,
+): Promise<NativeCliConnectionInspection> {
+  if (access.type !== "native-cli") throw new Error("This is not a native CLI connection");
+  if (!adapter) throw new Error("Native CLI connection unavailable on this host");
+  return adapter.inspect(access);
+}
+
+export type NativeCliSavedAccount = NonNullable<NativeCliAccessConfigObject["accounts"]>[number];
+/** CLIs whose official login honours an isolated home, so one connection can hold several sign-ins. */
+// Claude stays single-account: Anthropic's plan limits assume ordinary, individual use, so Fleet
+// neither keeps several Claude sign-ins nor rotates between them.
+export const NATIVE_CLI_MULTI_ACCOUNT = new Set(["codex"]);
+export const nativeCliAccountHome = (dir?: string) => dir || "";
+
+/** Saved sign-ins; records written before multi-account carry only the active identity. */
+export function nativeSavedAccounts(access: NativeCliAccessConfigObject): NativeCliSavedAccount[] {
+  if (access.accounts?.length) return [...access.accounts];
+  return access.connected && access.accountId
+    ? [
+        {
+          id: access.accountId,
+          ...(access.accountName ? { name: access.accountName } : {}),
+          ...(access.configDir ? { configDir: access.configDir } : {}),
+          ...(access.planType ? { planType: access.planType } : {}),
+        },
+      ]
+    : [];
+}
+
+/** The active fields mirror one saved account; "" selects the CLI's own default home. */
+export function nativeAccessForAccount(
+  access: NativeCliAccessConfigObject,
+  account: NativeCliSavedAccount,
+  accounts: NativeCliSavedAccount[],
+): NativeCliAccessConfigObject {
+  return {
+    ...access,
+    connected: true,
+    accountId: account.id,
+    accountName: account.name ?? account.id,
+    ...(account.planType ? { planType: account.planType } : {}),
+    configDir: account.configDir ?? "",
+    accounts,
+  };
+}
+
+/** Data contract only; the original operations owner retains the sole flow Map. */
+export interface NativeCliLoginFlow {
+  id: string;
+  cancel(): void;
+  status: "pending" | "finished" | "failed";
+  failure?: Error;
+  settledAt?: number;
+  committed?: boolean;
+  commitSettled?: boolean;
+  commitFailure?: unknown;
+  intendedAccess?: NativeCliAccessConfigObject;
+  /** The connection's stored config when the login began; fences the post-login write. */
+  expected: ProviderConfigObject;
+  access: NonNullable<ProviderConfigObject["access"]>;
+  commit?: Promise<void>;
+  /** Set once the version-checked write starts; before that a cancel still fences the commit. */
+  writing?: boolean;
+  cancelled?: boolean;
+  /** Fleet-allocated home for an added account; removed unless the account is saved. */
+  allocatedHome?: string;
+}
+
+/** Match an uncertain receipt to the existing canonical connection without writing it. */
+export function nativeCliCommitMatches(
+  current: ProviderConfigObject | undefined,
+  expected: ProviderConfigObject,
+  intended: NativeCliAccessConfigObject | undefined,
+): boolean {
+  const identity = (value: unknown) => JSON.stringify(value, (_key, entry: unknown) =>
+    entry && typeof entry === "object" && !Array.isArray(entry)
+      ? Object.fromEntries(Object.entries(entry).sort(([a], [b]) => a.localeCompare(b))) : entry);
+  return Boolean(current && intended && identity(current.api) === identity(expected.api) &&
+    current.access?.type === "native-cli" && identity(current.access) === identity(intended));
+}
