+        const original = f.agent.installPlugin;
+        f.agent.installPlugin = async (input) => {
+          writes++; await original(input); throw new Error("package acknowledgement lost");
+        };
+      } else {
+        const original = f.agent.updatePlugin;
+        f.agent.updatePlugin = async (input) => {
+          writes++; await original(input); throw new Error("package acknowledgement lost");
+        };
+      }
+      const receipt = mutation === "install"
+        ? await f.store.getState().installPlugin("writer", "audit-market", f.service)
+        : await f.store.getState().updatePlugin("writer@audit-market", f.service);
+      assert.equal(receipt.succeeded, false);
+      assert.equal(receipt.canonicalChanged, true);
+      assert.equal(receipt.isCurrent(), true);
+      assert.equal(writes, 1);
+      assert.equal(f.store.getState().installedPlugins.find((entry) => entry.id === "writer@audit-market")?.version,
+        mutation === "install" ? "1.0.0" : "2.0.0");
+      assert.equal(f.store.getState().error, "package acknowledgement lost");
+      // A normal observer refresh does not withdraw a valid operation receipt.
+      await f.store.getState().refresh(f.service);
+      assert.equal(receipt.isCurrent(), true);
+      f.agent.getPluginsOverview = async () => { throw new Error("new observation is unknown"); };
+      await f.store.getState().refresh(f.service);
+      assert.equal(receipt.isCurrent(), false);
+    } finally { await f.close(); }
+  });
+}
+
+
+test("a rejected install or unknown overview cannot claim a canonical package change", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    f.agent.installPlugin = async () => ({ installedPlugins: [], dependencyClosure: [],
+      diagnostics: [{ severity: "error", code: "rejected", message: "before package write" }] });
+    const rejected = await f.store.getState().installPlugin("writer", "audit-market", f.service);
+    assert.equal(rejected.succeeded, false);
+    assert.equal(rejected.canonicalChanged, false);
+    f.agent.getPluginsOverview = async () => { throw new Error("catalog observation unavailable"); };
+    const unknown = await f.store.getState().installPlugin("writer", "audit-market", f.service);
+    assert.equal(unknown.canonicalChanged, false);
+    assert.equal(f.store.getState().marketplaceAvailabilityKnown, false);
+    assert.equal(f.store.getState().error, "before package write");
+  } finally { await f.close(); }
+});
+
+for (const departure of ["ABA", "service", "operation"] as const) {
+  test(`a late install receipt is withdrawn after ${departure} ownership changes`, async () => {
+    const f = await pluginMarketFixture();
+    const ready = deferred(), release = deferred();
+    try {
+      const original = f.agent.installPlugin;
+      f.agent.installPlugin = async (input) => {
+        await original(input);
+        ready.resolve();
+        await release.promise;
+        throw new Error("old package ACK lost");
+      };
+      const pending = f.store.getState().installPlugin("writer", "audit-market", f.service);
+      await ready.promise;
+      if (departure === "ABA") {
+        await f.store.getState().initialize({ workspacePath: f.workspace, workspaceIdentity: "B", configScope: "user", pluginService: f.service });
+        await f.store.getState().initialize({ workspacePath: f.workspace, configScope: "user", pluginService: f.service });
+      } else if (departure === "service") {
+        await f.store.getState().initialize({ workspacePath: f.workspace, configScope: "user", pluginService: { ...f.service } });
+      } else {
+        await f.store.getState().configurePlugin(f.id, { tone: "new owner" }, f.service);
+      }
+      release.resolve();
+      const receipt = await pending;
+      assert.equal(receipt.isCurrent(), false);
+      assert.equal(receipt.canonicalChanged, false);
+      assert.notEqual(f.store.getState().error, "old package ACK lost");
+    } finally { release.resolve(); await f.close(); }
+  });
+}
