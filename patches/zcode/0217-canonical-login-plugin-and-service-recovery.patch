index 00000000..22408ec2
--- /dev/null
+++ b/packages/zcode-server-cli/test/bundle-banner.test.ts
@@ -0,0 +1,55 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdir, mkdtemp, realpath, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import test from "node:test";
+import { build, type Options } from "tsup";
+import serverConfig from "../tsup.config.js";
+
+const config = serverConfig as Options;
+
+// This compiles a tiny authored CJS dependency, not the product or any plugin contribution.
+// It consumes the actual shared banner: the missing bridge reproduces the production fs failure.
+for (const name of ["server-cli", "server-core"]) {
+  test(`${name} ESM banner admits bundled CJS and resolves staged modules from its own entry`, async () => {
+    assert.equal(config.format?.[0], "esm");
+    assert.equal(config.platform, "node");
+    assert.equal(config.target, "node22");
+    assert.ok(config.entry && !Array.isArray(config.entry) && typeof config.entry === "object");
+    assert.ok(Object.hasOwn(config.entry, name));
+    assert.ok(config.banner && typeof config.banner === "object" && config.banner.js);
+    const root = await realpath(await mkdtemp(join(tmpdir(), "zcode-esm-bridge-")));
+    try {
+      const runtime = join(root, "release with spaces", "runtime");
+      const foreignCwd = join(root, "different-cwd");
+      const dependency = join(runtime, "node_modules", "fixture-dependency");
+      await mkdir(dependency, { recursive: true });
+      await mkdir(foreignCwd);
+      await writeFile(join(runtime, "package.json"), '{"type":"module"}');
+      await writeFile(join(dependency, "package.json"), '{"main":"index.cjs"}');
+      await writeFile(join(dependency, "index.cjs"), 'module.exports = "staged-package";');
+      await writeFile(join(runtime, "probe.txt"), "entry-relative-data");
+      const cjs = join(root, "fixture.cjs");
+      await writeFile(cjs, [
+        'const fs = require("fs");',
+        'const path = require("node:path");',
+        'module.exports = { content: fs.readFileSync(path.join(__dirname, "probe.txt"), "utf8"),',
+        'packageValue: require("fixture-dependency"), resolved: require.resolve("fixture-dependency"),',
+        'filename: __filename, directory: __dirname };',
+      ].join("\n"));
+      const entry = join(root, "entry.mjs");
+      await writeFile(entry, 'import result from "./fixture.cjs"; process.stdout.write(JSON.stringify(result));');
+      const outfile = join(runtime, `${name}.js`);
+      await build({ entry: { [name]: entry }, outDir: runtime, bundle: true, format: ["esm"],
+        platform: config.platform, target: config.target, banner: { js: config.banner.js },
+        external: ["fixture-dependency"], outExtension: () => ({ js: ".js" }),
+        splitting: false, sourcemap: false, dts: false, clean: false, silent: true });
+      const result = JSON.parse(execFileSync(process.execPath, [outfile], {
+        cwd: foreignCwd, encoding: "utf8", timeout: 10_000,
+      }));
+      assert.deepEqual(result, { content: "entry-relative-data", packageValue: "staged-package",
+        resolved: join(dependency, "index.cjs"), filename: outfile, directory: dirname(outfile) });
+    } finally { await rm(root, { recursive: true, force: true }); }
+  });
+}
diff --git a/packages/zcode-server-cli/test/service-bootstrap.test.ts b/packages/zcode-server-cli/test/service-bootstrap.test.ts
