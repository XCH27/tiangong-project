diff --git a/packages/provider-node/test/personal-provider-canonical-noop.test.ts b/packages/provider-node/test/personal-provider-canonical-noop.test.ts
new file mode 100644
index 00000000..d2b299c5
--- /dev/null
+++ b/packages/provider-node/test/personal-provider-canonical-noop.test.ts
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import { mkdtemp, readFile, rm, stat } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { NodePersonalProviderConfigRepository } from "../src/personal-provider-config-repository.js";
+
+test("identical canonical update runs fences but preserves file and emits no updated", async () => {
+  const root = await mkdtemp(join(tmpdir(), "provider-noop-"));
+  const filePath = join(root, "personal.json");
+  const repo = new NodePersonalProviderConfigRepository({ filePath, pollingIntervalMs: false });
+  try {
+    await repo.update(current => ({ ...current, providerOrder: ["a", "b"] }));
+    const bytes = await readFile(filePath);
+    const before = await stat(filePath, { bigint: true });
+    let events = 0;
+    repo.onDidChange(reason => { if (reason === "updated") events++; });
+    let transformed = false;
+    const saved = await repo.update(current => { transformed = true; return { ...current }; });
+    assert.ok(transformed);
+    assert.deepEqual(await readFile(filePath), bytes);
+    const after = await stat(filePath, { bigint: true });
+    assert.equal(after.ino, before.ino);
+    assert.equal(after.mtimeNs, before.mtimeNs);
+    assert.equal(events, 0);
+    await assert.rejects(repo.update(current => { assert.equal(current.revision, saved.revision); throw new Error("expected revision fence"); }), /expected revision fence/);
+    assert.equal(events, 0);
+    await repo.update(current => ({ ...current, providerOrder: ["b", "a"] }));
+    assert.equal(events, 1);
+    assert.notDeepEqual(await readFile(filePath), bytes);
+  } finally { repo.dispose(); await rm(root, { recursive: true, force: true }); }
+});
+
+test("queued no-op observes a separate writer's locked commit and preserves it", async () => {
+  const root = await mkdtemp(join(tmpdir(), "provider-concurrent-"));
+  const filePath = join(root, "personal.json");
+  const first = new NodePersonalProviderConfigRepository({ filePath, pollingIntervalMs: false });
+  const external = new NodePersonalProviderConfigRepository({ filePath, pollingIntervalMs: false });
+  try {
+    await first.update(current => ({ ...current, providerOrder: ["initial"] }));
+    await external.update(current => ({ ...current, providerOrder: ["external", "initial"] }));
+    const bytes = await readFile(filePath);
+    const before = await stat(filePath, { bigint: true });
+    const observed = await first.update(current => { assert.deepEqual(current.providerOrder, ["external", "initial"]); return { ...current }; });
+    assert.deepEqual(observed.providerOrder, ["external", "initial"]);
+    assert.deepEqual(await readFile(filePath), bytes);
+    assert.equal((await stat(filePath, { bigint: true })).ino, before.ino);
+    await Promise.all([
+      external.update(current => ({ ...current, providerOrder: [...current.providerOrder!, "latest"] })),
+      first.update(current => ({ ...current })),
+    ]);
+    assert.deepEqual((await first.read()).providerOrder, ["external", "initial", "latest"]);
+  } finally { first.dispose(); external.dispose(); await rm(root, { recursive: true, force: true }); }
+});
