@@ -0,0 +1,355 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import { reply } from "./helpers/pi-runtime-fixture.js";
+import { lateReceiptFixture as setup } from "./helpers/late-tool-receipt-fixture.js";
+import { recoverLateToolSettlements } from "../src/runtime/methods/late-tool-settlement.js";
+
+for (const streaming of [false, true]) {
+  test(`late known success is durable, idempotent and refreshes future live context (${streaming})`, async () => {
+    const f = await setup(streaming);
+    try {
+      assert.equal(f.requests.length, 1);
+      await f.settled();
+      const part = (await f.parts())[0] as any;
+      assert.equal(part.id, f.initial.id);
+      assert.equal(part.state.status, "completed");
+      assert.match(part.state.output, /late/);
+      assert.equal(f.facts().length, 1);
+      assert.equal(f.facts()[0].status, "completed");
+      assert.equal(f.facts()[0].error_type, null);
+      assert.equal(f.facts()[0].error_message, null);
+      assert.equal(f.facts()[0].cancelled_by_user, 0);
+      const lateEvents = f.events.filter((e) => e.type === SessionEventType.ToolCallResult);
+      assert.equal(lateEvents.length, 1);
+      assert.equal(lateEvents[0].payload.assistantMessageId, part.messageID);
+      await recoverLateToolSettlements(f.runtime as never);
+      assert.equal(f.facts().length, 1);
+      assert.equal(f.events.filter((e) => e.type === SessionEventType.ToolCallResult).length, 1);
+      f.steps.push((request: any) => {
+        const tools = request.messages.filter((m: any) => m.role === "tool");
+        assert.match(JSON.stringify(tools), /saved/);
+        assert.doesNotMatch(JSON.stringify(tools), /may still complete/);
+        return reply("read known receipt");
+      });
+      await f.runtime.executeTurn("inspect saved result");
+      assert.equal(f.requests.length, 2);
+      await f.reopen();
+      assert.equal((await f.parts())[0].state.status, "completed");
+      assert.equal(f.effects, 1, "cold read never dispatches the effect");
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("late rejected and returned failures preserve their actual reason after restart", async () => {
+  for (const outcome of [
+    new Error("late fixture failure"),
+    { result: false, errorCode: 77, message: "late fixture business failure" },
+  ]) {
+    const f = await setup(false, outcome);
+    try {
+      await f.settled();
+      assert.equal((await f.parts())[0].state.status, "error");
+      assert.match(((await f.parts())[0] as any).state.error, /late fixture/);
+      assert.doesNotMatch(((await f.parts())[0] as any).state.error, /may still complete/);
+      assert.equal(f.facts()[0].status, "error");
+      assert.match(f.facts()[0].error_message, /late fixture/);
+      await f.reopen();
+      assert.match(((await f.parts())[0] as any).state.error, /late fixture/);
+      assert.equal(f.requests.length, 1);
+      assert.equal(f.effects, 1);
+    } finally {
+      await f.close();
+    }
+  }
+});
+
+test("late receipt cannot finish a newer turn's tool with the same provider call ID", async () => {
+  const f = await setup();
+  const entered = Promise.withResolvers<void>();
+  const finishNew = Promise.withResolvers<void>();
+  let newTurn: Promise<unknown> | undefined;
+  try {
+    const entry = f.runtime.getToolRegistry().get("Probe")!;
+    f.runtime.getToolRegistry().register({
+      ...entry,
+      async handler() {
+        entered.resolve();
+        await finishNew.promise;
+        return { saved: "new" };
+      },
+    } as never);
+    f.runtime.invalidateToolCache();
+    f.steps.push(
+      () => reply("new", [{ id: "same-id", name: "Probe", input: { value: "new" } }]),
+      () => reply("new done"),
+    );
+    newTurn = f.runtime.executeTurn("new independent work");
+    await entered.promise;
+    f.finish.resolve();
+    for (let i = 0; i < 200 && (await f.parts())[0].state.status !== "completed"; i++)
+      await new Promise((resolve) => setTimeout(resolve, 10));
+    const projection = await f.runtime.getProjection();
+    assert.equal(
+      projection.activeToolCalls.find((call) => call.toolCallId === "same-id")?.status,
+      "running",
+    );
+    assert.equal((await f.parts())[1].state.status, "running");
+    finishNew.resolve();
+    await newTurn;
+    const parts = await f.parts();
+    assert.match((parts[0] as any).state.output, /late/);
+    assert.match((parts[1] as any).state.output, /new/);
+    assert.equal(f.facts().length, 2);
+    assert.equal(f.requests.length, 3);
+    assert.match(
+      JSON.stringify(f.requests[1].messages),
+      /may still complete/,
+      "already sent request retains its snapshot",
+    );
+  } finally {
+    finishNew.resolve();
+    await newTurn?.catch(() => {});
+    await f.close();
+  }
+});
+
+test("part publication or usage failure retains an existing journal receipt for cold reconciliation", async () => {
+  for (const failedOwner of ["part", "usage"] as const) {
+    const f = await setup();
+    const savePart = f.store.savePart.bind(f.store);
+    const usage = f.store.upsertToolUsage.bind(f.store);
+    try {
+      if (failedOwner === "part")
+        f.store.savePart = async (part) => {
+          if (part.type === "tool" && part.state.status === "completed")
+            throw new Error("disposable part disk failure");
+          return savePart(part);
+        };
+      else
+        f.store.upsertToolUsage = async (record) => {
+          if (record.status === "completed") throw new Error("disposable usage disk failure");
+          return usage(record);
+        };
+      await f.settled();
+      assert.equal(f.failures.length, 1);
+      assert.equal(f.events.filter((e) => e.type === SessionEventType.ToolCallResult).length, 0);
+      const receipts = await f.store.sessionEntries!({
+        sessionID: "session" as never,
+        type: "runtime/late_tool_settlement",
+      });
+      assert.equal((receipts[0].data as any).pending, true);
+      f.store.savePart = savePart;
+      f.store.upsertToolUsage = usage;
+      f.steps.push((request: any) => {
+        assert.doesNotMatch(JSON.stringify(request.messages), /may still complete/);
+        return reply("reconciled before next input");
+      });
+      await f.runtime.executeTurn("inspect known saved receipt");
+      assert.equal((await f.parts())[0].state.status, "completed");
+      await f.reopen();
+      assert.equal((await f.parts())[0].state.status, "completed");
+      assert.equal(f.facts().length, 1);
+      assert.equal(f.facts()[0].status, "completed");
+      assert.equal(f.effects, 1);
+      assert.equal(f.requests.length, 2);
+    } finally {
+      f.store.savePart = savePart;
+      f.store.upsertToolUsage = usage;
+      await f.close();
+    }
+  }
+});
+
+test("fully unwritable receipt owners preserve unknown across restart without a false known event", async () => {
+  const f = await setup();
+  const saveEntry = f.store.saveSessionEntry.bind(f.store);
+  try {
+    f.store.saveSessionEntry = async (entry) => {
+      if (entry.type === "runtime/late_tool_settlement")
+        throw new Error("disposable journal disk failure");
+      return saveEntry(entry);
+    };
+    await f.settled();
+    assert.equal(f.failures.length, 1);
+    assert.equal((await f.parts())[0].state.status, "error");
+    assert.match(((await f.parts())[0] as any).state.error, /may still complete/);
+    assert.equal(f.events.filter((e) => e.type === SessionEventType.ToolCallResult).length, 0);
+    await f.reopen();
+    assert.match(((await f.parts())[0] as any).state.error, /may still complete/);
+    assert.equal(f.effects, 1);
+    assert.equal(f.requests.length, 1);
+  } finally {
+    f.store.saveSessionEntry = saveEntry;
+    await f.close();
+  }
+});
+
+test("late large result uses the existing durable artifact path", async () => {
+  const f = await setup(false, { saved: "bounded late output ".repeat(100) });
+  try {
+    await f.settled();
+    const part = (await f.parts())[0] as any;
+    assert.equal(part.state.status, "completed");
+    assert.equal(part.state.metadata.serialization.budgetStrategy, "artifact");
+    assert.ok(part.state.metadata.serialization.artifactPath);
+    await f.reopen();
+    assert.equal((await f.parts())[0].state.status, "completed");
+    assert.equal(f.effects, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("known handler completion retains a durable result-processing failure instead of unknown", async () => {
+  const f = await setup(
+    false,
+    { saved: "late" },
+    {
+      outputSchema: {
+        type: "object",
+        properties: { saved: { type: "number" } },
+        required: ["saved"],
+      },
+    },
+  );
+  try {
+    await f.settled();
