index 0000000..d0f3ae9
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/late-tool-receipt-projection.test.ts
@@ -0,0 +1,190 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+
+function fixture() {
+  const projection = new ProductProjection("late-session", "late-epoch");
+  let sequence = 0;
+  const events: SessionEvent[] = [];
+  const send = (type: SessionEvent["type"], turnId: string, payload: unknown, id?: string) => {
+    const event = {
+      id: id ?? `event-${++sequence}`,
+      sessionId: "late-session",
+      turnId,
+      traceId: "late-trace",
+      sequenceNumber: sequence,
+      timestamp: new Date(1000 + sequence),
+      type,
+      payload,
+    } as SessionEvent;
+    events.push(event);
+    projection.applyEventAtomically(event, () => true);
+    return event;
+  };
+  send(SessionEventType.TurnStarted, "old-turn", { input: "old write" });
+  send(SessionEventType.ToolCallScheduled, "old-turn", {
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    toolName: "Write",
+    input: {},
+  });
+  send(SessionEventType.ToolCallStarted, "old-turn", {
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    startedAt: new Date(),
+  });
+  send(SessionEventType.ToolCallError, "old-turn", {
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    error: { type: "tool_cancelled", message: "operation outcome unknown" },
+  });
+  send(SessionEventType.TurnError, "old-turn", {
+    error: { type: "turn_cancelled", message: "Turn was cancelled." },
+  });
+  const row = (assistant: string) =>
+    projection
+      .getSnapshot()
+      .rows.window.find(
+        (row) => row.kind === "toolCall" && row.assistantResponseId === assistant,
+      ) as any;
+  return { projection, send, row, events };
+}
+const marker = { receiptId: "late-session:late-tool:original-part", partId: "original-part" };
+
+test("a journaled late success corrects only the stopped original row and leaves the Session stopped", () => {
+  const f = fixture();
+  const control = structuredClone(f.projection.getSnapshot().control);
+  f.send(SessionEventType.ToolCallResult, "old-turn", {
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    lateSettlement: marker,
+    duration: 2,
+    result: { success: true, content: "actual saved result" },
+  });
+  assert.equal(f.row("old-assistant").status, "success");
+  assert.equal(f.row("old-assistant").output.text, "actual saved result");
+  assert.deepEqual(f.projection.getSnapshot().control, control);
+});
+
+test("late success/failure is fenced by original turn and assistant while a newer tool reuses its ID", () => {
+  for (const failed of [false, true]) {
+    const f = fixture();
+    f.send(SessionEventType.TurnStarted, "new-turn", { input: "new independent work" });
+    f.send(SessionEventType.ToolCallScheduled, "new-turn", {
+      toolCallId: "shared-call",
+      assistantMessageId: "new-assistant",
+      toolName: "Probe",
+      input: {},
+    });
+    f.send(SessionEventType.ToolCallStarted, "new-turn", {
+      toolCallId: "shared-call",
+      assistantMessageId: "new-assistant",
+      startedAt: new Date(),
+    });
+    const control = structuredClone(f.projection.getSnapshot().control);
+    const before = structuredClone(f.row("new-assistant"));
+    const event = f.send(
+      failed ? SessionEventType.ToolCallError : SessionEventType.ToolCallResult,
+      "old-turn",
+      failed
+        ? {
+            toolCallId: "shared-call",
+            assistantMessageId: "old-assistant",
+            lateSettlement: marker,
+            error: { type: "Error", message: "actual late failure" },
+          }
+        : {
+            toolCallId: "shared-call",
+            assistantMessageId: "old-assistant",
+            lateSettlement: marker,
+            duration: 2,
+            result: { success: true, content: "actual late success" },
+          },
+    );
+    assert.equal(f.row("old-assistant").status, failed ? "error" : "success");
+    assert.deepEqual(f.row("new-assistant"), before);
+    assert.deepEqual(f.projection.getSnapshot().control, control);
+    const rows = structuredClone(f.projection.getSnapshot().rows);
+    f.projection.applyEventAtomically(event, () => true);
+    assert.deepEqual(f.projection.getSnapshot().rows, rows);
+    const cold = new ProductProjection("late-session", "replay-epoch");
+    for (const item of f.events) cold.applyEventAtomically(item, () => true);
+    assert.deepEqual(
+      cold.getSnapshot().rows.window.map((row: any) => [row.rowId, row.status]),
+      f.projection.getSnapshot().rows.window.map((row: any) => [row.rowId, row.status]),
+    );
+  }
+});
+
+test("an unmarked stale result cannot revive a stopped row", () => {
+  const f = fixture();
+  const before = structuredClone(f.row("old-assistant"));
+  f.send(SessionEventType.ToolCallResult, "old-turn", {
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    duration: 2,
+    result: { success: true, content: "unconfirmed stale" },
+  });
+  assert.deepEqual(f.row("old-assistant"), before);
+});
+
+test("real Host late receipt reaches the stopped V4 row after durable publication", async () => {
+  const { lateReceiptFixture } =
+    await import("../../core/test/helpers/late-tool-receipt-fixture.js");
+  const f = await lateReceiptFixture();
+  try {
+    const projection = new ProductProjection("session", "host-receipt-epoch");
+    for (const event of f.events) projection.applyEventAtomically(event, () => true);
+    const before = structuredClone(projection.getSnapshot().control);
+    f.runtime.subscribeEvents({
+      onSessionEvent(event) {
+        projection.applyEventAtomically(event, () => true);
+      },
+    });
+    await f.settled();
+    const rows = projection
+      .getSnapshot()
+      .rows.window.filter((row) => row.kind === "toolCall") as any[];
+    assert.equal(rows.length, 1);
+    assert.equal(rows[0].status, "success");
+    assert.match(rows[0].output.text, /saved/);
+    assert.deepEqual(projection.getSnapshot().control, before);
+    const event = f.events.find((event) => event.type === SessionEventType.ToolCallResult);
+    assert.equal(event.payload.lateSettlement.partId, f.initial.id);
+    const stored = (await f.parts())[0] as any;
+    assert.equal(stored.state.status, "completed");
+    assert.equal(event.payload.assistantMessageId, stored.messageID);
+  } finally {
+    await f.close();
+  }
+});
+
+test("the existing strict transport schema retains the original assistant and optional late receipt", async () => {
+  const { zcodeToolUpdatedEventPayloadSchema } =
+    await import("../../../../../packages/shared/src/zcode-protocol/index.js");
+  const result = {
+    kind: "result",
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    lateSettlement: marker,
+    duration: 2,
+    result: { success: true, content: "saved" },
+  };
+  assert.deepEqual(zcodeToolUpdatedEventPayloadSchema.parse(result), result);
+  const error = {
+    kind: "error",
+    toolCallId: "shared-call",
+    assistantMessageId: "old-assistant",
+    lateSettlement: marker,
+    error: { type: "Error", message: "known failure" },
+  };
+  assert.deepEqual(zcodeToolUpdatedEventPayloadSchema.parse(error), error);
+  assert.equal(
+    zcodeToolUpdatedEventPayloadSchema.safeParse({
+      ...result,
+      lateSettlement: { partId: "original-part" },
+    }).success,
+    false,
+  );
+});
