@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { lateReceiptFixture as setup } from "./helpers/late-tool-receipt-fixture.js";
+
+test("late receipt accounting keeps admitted capability after registration replacement and writes once", async () => {
+  const f = await setup();
+  const upsert = f.store.upsertToolUsage.bind(f.store);
+  const completed: any[] = [];
+  try {
+    f.store.upsertToolUsage = async (record) => {
+      if (record.status === "completed") completed.push(record);
+      return upsert(record);
+    };
+    const entry = f.runtime.getToolRegistry().get("Probe")!;
+    f.runtime.getToolRegistry().register({
+      ...entry,
+      metadata: { ...entry.metadata, readOnly: true, sideEffectScope: "network" },
+      async handler() {
+        throw new Error("replacement must not execute for the admitted call");
+      },
+    } as never);
+    f.runtime.invalidateToolCache();
+    await f.settled();
+    assert.equal(
+      completed.length,
+      1,
+      "the Host receipt owns accounting; its published event must not upsert again",
+    );
+    const { DatabaseSync } = await import("node:sqlite");
+    const { join } = await import("node:path");
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try {
+      const fact = db
+        .prepare("select status, read_only, side_effect_scope from tool_usage")
+        .get() as any;
+      assert.equal(fact.status, "completed");
+      assert.equal(fact.read_only, 0);
+      assert.equal(fact.side_effect_scope, "workspace");
+    } finally {
+      db.close();
+    }
+    await f.reopen();
+    assert.equal(f.facts().length, 1);
+    assert.equal(f.facts()[0].status, "completed");
+    assert.equal(f.effects, 1);
+    assert.equal(f.requests.length, 1);
+  } finally {
+    f.store.upsertToolUsage = upsert;
+    await f.close();
+  }
+});
diff --git a/apps/zcode-cli/packages/core/test/late-tool-receipt.test.ts b/apps/zcode-cli/packages/core/test/late-tool-receipt.test.ts
