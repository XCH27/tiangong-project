@@ -0,0 +1,286 @@
+import {
+  SessionEventType,
+  type SessionEntryInfo,
+  type TraceContext,
+  type ToolExecutionResult,
+} from "../deps.js";
+import { createErrorResult } from "../../tool/executor/errors.js";
+import type { ToolPart } from "@zcode/contracts";
+import { createRuntimeToolResultEntry } from "../../agent/message-history.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { modelContentForToolResult, stringifyToolResultOutput } from "../helpers/tool-result.js";
+import { persistToolResultMediaAttachments } from "../helpers/tool-result-media-persistence.js";
+import { completedToolPartMetadata } from "./tool-part-metadata.js";
+import { recordToolUsageFromResult } from "./turn-tool-usage.js";
+import { createToolCallResultEvent } from "../../tool/executor/events.js";
+
+const LATE_TOOL_RECEIPT = "runtime/late_tool_settlement";
+interface Receipt {
+  part: ToolPart;
+  traceContext: TraceContext;
+  result: Omit<ToolExecutionResult, "startedAt" | "completedAt" | "output"> & {
+    startedAt: number;
+    completedAt: number;
+  };
+}
+const receiptId = (part: ToolPart) => `${part.sessionID}:late-tool:${part.id}`;
+
+/** Initial unknown publication precedes this handoff; late work never owns an active turn. */
+export function trackLateToolSettlement(
+  runtime: AgentRuntimeInternal,
+  initialPart: ToolPart,
+  result: ToolExecutionResult,
+  traceContext: TraceContext,
+): void {
+  if (!result.lateSettlement) return;
+  const work = result.lateSettlement.then(async (late) => {
+    let media: Awaited<ReturnType<typeof persistToolResultMediaAttachments>>;
+    try {
+      media =
+        late.success && traceContext.turnId
+          ? await persistToolResultMediaAttachments({
+              artifactStore: runtime.artifactStore,
+              assistantMessageId: initialPart.messageID,
+              content: modelContentForToolResult(late),
+              sessionId: initialPart.sessionID,
+              sessionStore: runtime.sessionStore,
+              toolCallId: late.toolCallId,
+              toolName: late.toolName,
+              traceContext,
+              turnId: traceContext.turnId,
+            })
+          : undefined;
+    } catch (outputError) {
+      // 媒体保存失败是输出回执失败，已完成的真实效果不能重新记成 unknown 或静默成功。
+      const failure = createErrorResult(
+        { id: late.toolCallId, name: late.toolName, input: initialPart.state.input },
+        new Error(
+          `Tool completed after Stop, but media output persistence failed: ${outputError instanceof Error ? outputError.message : String(outputError)}`,
+        ),
+        late.durationMs,
+      );
+      late = { ...failure, startedAt: late.startedAt, completedAt: late.completedAt };
+    }
+    const content = stringifyToolResultOutput(late);
+    const part: ToolPart = {
+      ...initialPart,
+      state: late.success
+        ? {
+            status: "completed",
+            input: initialPart.state.input,
+            output: content,
+            title: late.toolName,
+            metadata: {
+              ...completedToolPartMetadata(late),
+              lateSettlement: "completed",
+              ...(media ? { modelContentLayout: media.modelContentLayout } : {}),
+            },
+            time: { start: late.startedAt.getTime(), end: late.completedAt.getTime() },
+            ...(media ? { attachments: media.attachments } : {}),
+          }
+        : {
+            status: "error",
+            input: initialPart.state.input,
+            error: late.error?.message ?? content,
+            metadata: { lateSettlement: "failed", modelContent: content },
+            time: { start: late.startedAt.getTime(), end: late.completedAt.getTime() },
+          },
+    };
+    const receipt: Receipt = {
+      part,
+      traceContext,
+      result: {
+        toolCallId: late.toolCallId,
+        toolName: late.toolName,
+        success: late.success,
+        error: late.error,
+        display: late.display,
+        durationMs: late.durationMs,
+        serialization: late.serialization
+          ? { ...late.serialization, modelContent: content }
+          : undefined,
+        modelContent: content,
+        startedAt: late.startedAt.getTime(),
+        completedAt: late.completedAt.getTime(),
+      },
+    };
+    const store = runtime.sessionStore;
+    if (!store?.saveSessionEntry)
+      throw new Error("Cannot retain late tool receipt in this Session");
+    const now = Date.now();
+    const entry: SessionEntryInfo = {
+      id: receiptId(part),
+      sessionID: part.sessionID,
+      type: LATE_TOOL_RECEIPT,
+      touchSession: false,
+      time: { created: now, updated: now },
+      data: { receipt, pending: true },
+    };
+    // 先用已有 Session journal 留下已知结局；part/usage 写失败或 acknowledgement 丢失可冷恢复。
+    await store.saveSessionEntry(entry);
+    await applyReceipt(runtime, entry, receipt);
+    replaceCanonicalToolReceipt(runtime, initialPart.id, late);
+  });
+  void runtime.trackResidencyBlockingWork(work).catch((error) => reportFailure(runtime, error));
+}
+
+/** Read/reconcile only. No tool, model, permission or post-tool hook can run from a receipt. */
+export async function recoverLateToolSettlements(runtime: AgentRuntimeInternal): Promise<void> {
+  const store = runtime.sessionStore;
+  if (!store?.sessionEntries || !store.saveSessionEntry) return;
+  for (const entry of await store.sessionEntries({
+    sessionID: runtime.sessionId,
+    type: LATE_TOOL_RECEIPT,
+  })) {
+    const data = entry.data as { receipt?: Receipt; pending?: boolean };
+    if (!data?.pending || !data.receipt) continue;
+    const receipt = data.receipt;
+    if (
+      receipt.part?.type !== "tool" ||
+      receipt.part.sessionID !== runtime.sessionId ||
+      entry.id !== receiptId(receipt.part) ||
+      receipt.result.toolCallId !== receipt.part.callID ||
+      receipt.traceContext.sessionId !== runtime.sessionId ||
+      !Number.isFinite(receipt.result.startedAt) ||
+      !Number.isFinite(receipt.result.completedAt)
+    )
+      throw new Error("Invalid late tool receipt in this Session");
+    try {
+      await applyReceipt(runtime, entry, receipt);
+      replaceCanonicalToolReceipt(runtime, receipt.part.id, receiptResult(receipt));
+    } catch (error) {
+      reportFailure(runtime, error);
+    }
+  }
+}
+
+const receiptWrites = new WeakMap<AgentRuntimeInternal, Map<string, Promise<void>>>();
+
+function applyReceipt(
+  runtime: AgentRuntimeInternal,
+  entry: SessionEntryInfo,
+  receipt: Receipt,
+): Promise<void> {
+  let writes = receiptWrites.get(runtime);
+  if (!writes) receiptWrites.set(runtime, (writes = new Map()));
+  const pending = writes.get(entry.id);
+  if (pending) return pending;
+  // producer 与下一输入的恢复共享原 receipt 的提交；瞬态 gate 不保存第二份结果状态。
+  const work = applyReceiptOnce(runtime, entry, receipt).finally(() => writes!.delete(entry.id));
+  writes.set(entry.id, work);
+  return work;
+}
+
+async function applyReceiptOnce(
+  runtime: AgentRuntimeInternal,
+  entry: SessionEntryInfo,
+  receipt: Receipt,
+): Promise<void> {
+  const store = runtime.sessionStore!;
+  const messages = await store.messages({ sessionID: runtime.sessionId });
+  const original = messages
+    .find((message) => message.info.id === receipt.part.messageID)
+    ?.parts.find((part) => part.id === receipt.part.id);
+  // 不重建被 rewind/delete 移除的消息；不能把回执写到复用 call ID 的另一消息。
+  if (!original || original.type !== "tool" || original.callID !== receipt.part.callID) return;
+  const result = receiptResult(receipt);
+  await store.savePart(receipt.part);
+  await recordToolUsageFromResult(runtime, result, receipt.traceContext, {
+    propagateFailure: true,
+    preserveAdmittedMetadata: true,
+  });
+  const events = await runtime.eventStore.getEvents(runtime.sessionId);
+  const eventId = `${entry.id}:settled`;
+  if (!events.some((event) => event.id === eventId)) {
+    if (result.success && result.serialization) {
+      const event = createToolCallResultEvent(
+        runtime.sessionId,
+        { id: result.toolCallId, name: result.toolName, input: original.state.input },
+        receipt.traceContext,
+        receipt.traceContext.turnId,
+        result.serialization,
+        result.durationMs,
+        result.display,
+        result.performance,
+        undefined,
+      );
+      event.id = eventId as never;
+      event.payload.lateSettlement = { receiptId: entry.id, partId: receipt.part.id };
+      event.timestamp = result.completedAt;
+      if (receipt.part.state.status === "completed" && receipt.part.state.attachments) {
+        event.payload.result.attachments = receipt.part.state.attachments.map(
+          (part, attachmentIndex) => ({
+            attachmentIndex,
+            ref: part.url,
+            fileName: part.filename ?? "",
+            mime: part.mime,
+          }),
+        );
+      }
+      await runtime.appendEvent(event, receipt.traceContext);
+    } else {
+      const event = runtime.createEvent(
+        SessionEventType.ToolCallError,
+        {
+          toolCallId: result.toolCallId,
+          assistantMessageId: receipt.part.messageID,
+          lateSettlement: { receiptId: entry.id, partId: receipt.part.id },
+          error: result.error,
+        },
+        receipt.traceContext,
+      );
+      event.id = eventId as never;
+      event.timestamp = result.completedAt;
+      await runtime.appendEvent(event, receipt.traceContext);
+    }
+  }
+  await store.saveSessionEntry!({
+    ...entry,
+    touchSession: false,
+    time: { ...entry.time, updated: Date.now() },
+    data: { receipt, pending: false },
+  });
+}
+
+function receiptResult(receipt: Receipt): ToolExecutionResult {
+  return {
+    ...receipt.result,
+    output: receipt.result.modelContent,
+    startedAt: new Date(receipt.result.startedAt),
+    completedAt: new Date(receipt.result.completedAt),
+  };
+}
+
+function replaceCanonicalToolReceipt(
+  runtime: AgentRuntimeInternal,
+  partId: string,
+  result: ToolExecutionResult,
+): void {
+  const entries = runtime.messageHistory.borrowReadOnlyRuntimeEntries();
+  if (!entries.some((entry) => entry.kind !== "attachment" && entry.toolResultPartId === partId))
+    return;
+  runtime.messageHistory.replaceMessages(
+    entries.map((entry) =>
+      entry.kind !== "attachment" && entry.toolResultPartId === partId
+        ? {
+            ...createRuntimeToolResultEntry(
+              result.toolCallId,
+              result.toolName,
+              modelContentForToolResult(result),
+              !result.success,
+            ),
+            toolResultPartId: partId,
+          }
+        : entry,
+    ),
+  );
+}
+
+function reportFailure(runtime: AgentRuntimeInternal, error: unknown): void {
+  runtime.logger?.warn("Late tool receipt persistence failed; check the original operation", {
+    event: "tool.call.late_receipt.persist_failed",
+    module: "core.runtime",
+    status: "failed",
+    errorMessage: error instanceof Error ? error.message : String(error),
+  });
+}
