@@ -0,0 +1,122 @@
+import assert from "node:assert/strict";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import type { AgentRuntimeDeps } from "../../src/runtime/types.js";
+import { fixture, reply } from "./pi-runtime-fixture.js";
+export async function lateReceiptFixture(
+  streaming = false,
+  output: unknown = { saved: "late" },
+  entryOverride: Record<string, unknown> = {},
+  depsOverride: Partial<AgentRuntimeDeps> = {},
+) {
+  const profile = await mkdtemp(join(tmpdir(), "fleet-late-profile-"));
+  const previous = process.env.ZCODE_HOME;
+  process.env.ZCODE_HOME = profile;
+  const failures: string[] = [];
+  const logger = {
+    info() {},
+    debug() {},
+    error() {},
+    warn(_message: string, data: any) {
+      if (data?.event === "tool.call.late_receipt.persist_failed") failures.push(data.errorMessage);
+    },
+    child() {
+      return logger;
+    },
+  };
+  const f = await fixture(undefined, streaming, {
+    deps: { logger: logger as never, ...depsOverride },
+  });
+  const entered = Promise.withResolvers<void>();
+  const finish = Promise.withResolvers<void>();
+  let effects = 0;
+  const registered = f.runtime.getToolRegistry().get("Probe")!;
+  f.runtime.getToolRegistry().register({
+    ...registered,
+    resultBudget: {
+      maxInlineBytes: 64,
+      maxModelBytes: 64,
+      strategy: "artifact",
+      artifact: { enabled: true, retention: "session" },
+    },
+    ...entryOverride,
+    async handler() {
+      effects++;
+      await writeFile(join(f.dir, "late-effect.txt"), "committed exactly once");
+      entered.resolve();
+      await finish.promise;
+      if (output instanceof Error) throw output;
+      return output;
+    },
+  } as never);
+  f.runtime.invalidateToolCache();
+  const events: any[] = [];
+  f.runtime.subscribeEvents({
+    onSessionEvent(event) {
+      events.push(event);
+    },
+  });
+  f.steps.push(() => reply("late", [{ id: "same-id", name: "Probe", input: { value: "late" } }]));
+  const turn = f.runtime
+    .executeTurn("save disposable fixture")
+    .catch((error: Error) => error.message);
+  await entered.promise;
+  f.runtime.stopActiveForegroundExecution();
+  assert.equal(await turn, "Turn was cancelled.");
+  const parts = async () =>
+    (await f.store.messages({ sessionID: "session" as never }))
+      .flatMap((m) => m.parts)
+      .filter((p) => p.type === "tool");
+  const initial = (await parts())[0] as any;
+  assert.equal(initial.state.status, "error");
+  assert.equal(initial.state.metadata.lateSettlement, "pending");
+  assert.match(initial.state.error, /may still complete/);
+  return {
+    ...f,
+    get runtime() {
+      return f.runtime;
+    },
+    get store() {
+      return f.store;
+    },
+    events,
+    failures,
+    initial,
+    parts,
+    finish,
+    get effects() {
+      return effects;
+    },
+    facts() {
+      const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+      try {
+        return db
+          .prepare(
+            "select id, status, error_type, error_message, cancelled_by_user from tool_usage order by started_at",
+          )
+          .all() as any[];
+      } finally {
+        db.close();
+      }
+    },
+    async settled() {
+      finish.resolve();
+      for (let i = 0; i < 200 && f.runtime.hasResidencyBlockingWork(); i++)
+        await new Promise((resolve) => setTimeout(resolve, 10));
+      assert.equal(
+        f.runtime.hasResidencyBlockingWork(),
+        false,
+        "receipt work finishes in bounded test time",
+      );
+    },
+    async close() {
+      finish.resolve();
+      await f.close();
+      if (previous === undefined) delete process.env.ZCODE_HOME;
+      else process.env.ZCODE_HOME = previous;
+      await rm(profile, { recursive: true, force: true });
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/core/test/late-tool-receipt-accounting.test.ts b/apps/zcode-cli/packages/core/test/late-tool-receipt-accounting.test.ts
