+    await f.reopen();
+    assert.equal((await f.parts())[0].state.status, "error");
+    assert.match(((await f.parts())[0] as any).state.error, /result processing failed/);
+    assert.equal(f.effects, 1);
+    assert.equal(f.requests.length, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("artifact and media output failures retain a truthful durable receipt of completed execution", async () => {
+  const brokenArtifact = {
+    async writeToolResultArtifact() {
