diff --git a/apps/zcode-cli/packages/core/src/tool/executor/late-settlement.ts b/apps/zcode-cli/packages/core/src/tool/executor/late-settlement.ts
new file mode 100644
index 0000000..37e35d9
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/executor/late-settlement.ts
@@ -0,0 +1,71 @@
+import type { TraceContext } from "@zcode/contracts";
+import type { ExecutableToolCall, ToolEntry, ToolExecutionResult } from "../types.js";
+import type { ToolExecutorDeps } from "./types.js";
+import type { LateToolSettlement } from "./timeout.js";
+import {
+  createErrorResult,
+  createToolHandlerFailureError,
+  isToolHandlerFailure,
+} from "./errors.js";
+import { serializeOutput } from "./result-serialization.js";
+import { createToolResultDisplay } from "./result-display.js";
+import { validateOutput } from "./validation.js";
+
+/** Stop cannot undo an admitted effect. Normalize its receipt without another lifecycle. */
+export async function createLateToolResult(input: {
+  deps: ToolExecutorDeps;
+  entry: ToolEntry;
+  toolCall: ExecutableToolCall;
+  traceContext: TraceContext;
+  late: LateToolSettlement;
+  startTime: number;
+}): Promise<ToolExecutionResult> {
+  const completedAt = new Date();
+  const durationMs = completedAt.getTime() - input.startTime;
+  let error = input.late.status === "failed" ? input.late.error : undefined;
+  if (input.late.status === "completed") {
+    if (isToolHandlerFailure(input.late.output)) {
+      error = createToolHandlerFailureError(input.toolCall, input.late.output);
+    } else {
+      try {
+        validateOutput(input.late.output, input.entry);
+        // 原 turn 已停止，但保存已发生的结果不是重启效果，不能借用已 abort 的执行 signal。
+        const serialization = await serializeOutput(
+          input.deps,
+          input.late.output,
+          input.entry,
+          input.traceContext,
+          input.toolCall.id,
+          new AbortController().signal,
+          { strictArtifactPersistence: true },
+        );
+        return {
+          toolCallId: input.toolCall.id,
+          toolName: input.toolCall.name,
+          success: true,
+          output: input.late.output,
+          modelContent: serialization.modelContent ?? serialization.content,
+          serialization,
+          display: createToolResultDisplay(input.toolCall.name, input.late.output, {
+            mcp: input.entry.metadata.mcpPresentation,
+          }),
+          durationMs,
+          startedAt: new Date(input.startTime),
+          completedAt,
+        };
+      } catch (processingError) {
+        // 已知 handler 结局不能因结果校验/序列化失败重新变成 unknown；保留完成事实和失败阶段。
+        error = new Error(
+          `Tool completed after Stop, but result processing failed: ${processingError instanceof Error ? processingError.message : String(processingError)}`,
+          { cause: processingError },
+        );
+      }
+    }
+  }
+  const result = createErrorResult(
+    input.toolCall,
+    error instanceof Error ? error : new Error(String(error)),
+    durationMs,
+  );
+  return { ...result, startedAt: new Date(input.startTime), completedAt };
+}
