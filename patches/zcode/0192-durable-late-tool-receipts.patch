+
+test("producer and concurrent live recovery share one receipt commit and one terminal event", async () => {
+  const f = await setup();
+  const savePart = f.store.savePart.bind(f.store);
+  const entered = Promise.withResolvers<void>();
+  const publish = Promise.withResolvers<void>();
+  let publications = 0;
+  try {
+    f.store.savePart = async (part) => {
+      if (part.type === "tool" && part.state.status === "completed") {
+        publications++;
+        entered.resolve();
+        await publish.promise;
+      }
+      return savePart(part);
+    };
+    f.finish.resolve();
+    await entered.promise;
+    const recovery = recoverLateToolSettlements(f.runtime as never);
+    await new Promise((resolve) => setTimeout(resolve, 10));
+    publish.resolve();
+    await recovery;
+    await f.settled();
+    assert.equal(publications, 1);
+    assert.equal(
+      f.events.filter((event) => event.type === SessionEventType.ToolCallResult).length,
+      1,
+    );
+    assert.equal(f.facts().length, 1);
