+import type { SessionEvent, ToolCallErrorPayload, ToolCallResultPayload } from "@zcode/contracts";
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+
+/** Only the Host's saved receipt may correct a stopped row; it cannot change Session control. */
+export function isLateToolReceiptForRow(
+  event: SessionEvent,
+  row: ToolCallRow,
+  productTurnId: string,
+): boolean {
+  const payload = event.payload as ToolCallErrorPayload | ToolCallResultPayload;
+  const receipt = payload.lateSettlement;
+  return Boolean(
+    receipt?.partId &&
+    receipt.receiptId === `${event.sessionId}:late-tool:${receipt.partId}` &&
+    row.status === "cancelled" &&
+    event.turnId &&
+    row.turnId === productTurnId &&
+    payload.assistantMessageId &&
+    row.assistantResponseId === payload.assistantMessageId,
+  );
+}
