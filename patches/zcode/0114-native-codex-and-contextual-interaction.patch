@@ -0,0 +1,57 @@
+import { createHash } from "node:crypto";
+import type { NativeAgentContinuation } from "@zcode/contracts";
+import { CodexClient, type CodexClientOptions } from "./codex-client.js";
+import { readCodexNativeIdentity } from "./codex-inspect.js";
+
+const THREAD_ID = /^[a-z0-9_-]{1,128}$/iu;
+const fingerprint = (thread: unknown) => {
+  const value = thread as Record<string, unknown>;
+  // 加载状态、标题和预览是派生视图；它们不能让未变更的原生历史失去恢复资格。
+  return createHash("sha256")
+    .update(
+      JSON.stringify({ id: value.id, modelProvider: value.modelProvider, turns: value.turns }),
+    )
+    .digest("hex");
+};
+/** Public vendor history controls, used only to bind a continuation; no history is imported. */
+export async function codexContinuation(
+  client: CodexClient,
+  threadId: string,
+  executorVersion: string,
+): Promise<NativeAgentContinuation> {
+  if (!THREAD_ID.test(threadId)) throw new Error("Invalid native Codex thread identity");
+  const response = await client.request<{ thread: unknown }>("thread/read", {
+    threadId,
+    includeTurns: true,
+  });
+  if (!response?.thread) throw new Error("Native Codex did not retain its continuation");
+  return {
+    sessionId: threadId,
+    cachePath: `codex-thread:${threadId}`,
+    cacheFingerprint: fingerprint(response.thread),
+    executorVersion,
+  };
+}
+export async function canResumeCodex(
+  continuation: NativeAgentContinuation,
+  options: CodexClientOptions,
+  accountId?: string,
+) {
+  if (
+    !THREAD_ID.test(continuation.sessionId) ||
+    continuation.cachePath !== `codex-thread:${continuation.sessionId}`
+  )
+    return false;
+  const client = new CodexClient(options);
+  try {
+    const initialized = await client.initialize();
+    if (initialized.userAgent !== continuation.executorVersion) return false;
+    await readCodexNativeIdentity(client, accountId);
+    const current = await codexContinuation(client, continuation.sessionId, initialized.userAgent);
+    return current.cacheFingerprint === continuation.cacheFingerprint;
+  } catch {
+    return false;
+  } finally {
+    await client.close();
+  }
+}
