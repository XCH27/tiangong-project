     : undefined;
 }
 
+/** Native Codex percentages are scoped windows, not summed account capacity or money. */
+export function parseCodexNativeUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const body = object(payload);
+  if (!body) return { status: "unavailable" };
+  const byId = object(body.rateLimitsByLimitId);
+  const entries = byId ? Object.entries(byId) : [["default", body.rateLimits]];
+  const windows: SubscriptionUsageWindow[] = [];
+  let plan: string | undefined;
+  for (const [id, raw] of entries.slice(0, 64)) {
+    const bucket = object(raw);
+    if (!bucket) continue;
+    if (typeof bucket.planType === "string") plan ??= bucket.planType;
+    for (const name of ["primary", "secondary"]) {
+      const window = object(bucket[name]);
+      if (!window) continue;
+      const used = window.usedPercent,
+        minutes = window.windowDurationMins,
+        reset = window.resetsAt;
+      if (typeof used !== "number" || !Number.isFinite(used) || used < 0 || used > 100) continue;
+      windows.push({
+        id: `${id}:${name}`,
+        usedPercent: used,
+        ...(typeof minutes === "number" && Number.isFinite(minutes) && minutes > 0
+          ? { windowMinutes: minutes }
+          : {}),
+        ...(typeof reset === "number" && Number.isFinite(reset) && reset > 0
+          ? { resetAt: reset * 1000 }
+          : {}),
+      });
+    }
+  }
+  return windows.length
+    ? {
+        status: "available",
+        source: "codex-native",
+        observedAt,
+        windows,
+        ...(plan ? { plan } : {}),
+      }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
