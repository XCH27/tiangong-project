index 0000000..0237e2e
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/codex-client.ts
@@ -0,0 +1,208 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { StringDecoder } from "node:string_decoder";
+
+export interface CodexNotification {
+  method: string;
+  params?: unknown;
+}
+export interface CodexServerRequest extends CodexNotification {
+  id: string | number;
+}
+export interface CodexClientOptions {
+  executable?: string;
+  configDir?: string;
+  env?: Record<string, string | undefined>;
+  cwd?: string;
+  /** Isolated protocol fixtures supply a synthetic server, never a production connection field. */
+  args?: string[];
+  /** Private isolated fixture diagnostics; not exposed by Provider configuration or production logging. */
+  onDiagnostic?: (chunk: string) => void;
+}
+export function codexNativeEnvironment(options: CodexClientOptions): NodeJS.ProcessEnv {
+  const env = { ...process.env };
+  for (const key of ["OPENAI_API_KEY", "CODEX_API_KEY", "CODEX_AUTH_TOKEN", "ACCESS_TOKEN"])
+    delete env[key];
+  Object.assign(env, options.env);
+  if (options.configDir) env.CODEX_HOME = options.configDir;
+  return env;
+}
+
+/** Official newline JSON-RPC, not MCP and not another Session or command queue. */
+export class CodexClient {
+  private readonly child: ChildProcessWithoutNullStreams;
+  private readonly exited: Promise<void>;
+  private readonly pending = new Map<
+    number,
+    {
+      resolve(value: unknown): void;
+      reject(error: Error): void;
+      timer: ReturnType<typeof setTimeout>;
+      method: string;
+    }
+  >();
+  private readonly listeners = new Set<(event: CodexNotification) => void>();
+  private nextId = 1;
+  private closed = false;
+  private failure?: Error;
+  private readonly diagnostic?: (chunk: string) => void;
+  onRequest?: (request: CodexServerRequest) => void;
+  onFailure?: (error: Error) => void;
+  constructor(options: CodexClientOptions = {}) {
+    this.diagnostic = options.onDiagnostic;
+    this.child = spawn(
+      options.executable ?? "codex",
+      options.args ?? ["app-server", "--listen", "stdio://"],
+      {
+        cwd: options.cwd,
+        env: codexNativeEnvironment(options),
+        shell: false,
+        windowsHide: true,
+        detached: process.platform !== "win32",
+        stdio: ["pipe", "pipe", "pipe"],
+      },
+    );
+    if (options.onDiagnostic)
+      this.child.stderr.on("data", (chunk: Buffer) => options.onDiagnostic!(chunk.toString()));
+    else this.child.stderr.resume(); // Never forward OAuth codes, native diagnostics or credentials.
+    this.exited = new Promise((resolve) => this.child.once("close", () => resolve()));
+    const decoder = new StringDecoder("utf8");
+    let buffered = "";
+    this.child.stdout.on("data", (bytes: Buffer) => {
+      if (this.closed) return;
+      buffered += decoder.write(bytes);
+      // 原生输出也有边界；不能让坏协议或单行无限输出拖垮整个 Host。
+      if (Buffer.byteLength(buffered) > 8 * 1024 * 1024) {
+        this.fail(new Error("Native Codex protocol output exceeds its limit"));
+        return;
+      }
+      let end: number;
+      while ((end = buffered.indexOf("\n")) !== -1) {
+        const line = buffered.slice(0, end);
+        buffered = buffered.slice(end + 1);
+        if (line.trim()) this.receive(line);
+      }
+    });
+    this.child.once("error", (error) =>
+      this.fail(
+        new Error(
+          (error as NodeJS.ErrnoException).code === "ENOENT"
+            ? "Native Codex executable not found"
+            : "Native Codex process could not start",
+        ),
+      ),
+    );
+    this.child.once("close", () => {
+      if (!this.closed) this.fail(new Error("Native Codex process exited before completion"));
+    });
+  }
+  subscribe(listener: (event: CodexNotification) => void) {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+  private receive(line: string) {
+    try {
+      const item = JSON.parse(line) as Record<string, unknown>;
+      if (!item || typeof item !== "object" || Array.isArray(item)) throw new Error();
+      if (typeof item.method === "string") {
+        this.diagnostic?.(`RPC ${item.method}: ${JSON.stringify(item.params)}\n`);
+        const event = { method: item.method, params: item.params };
+        if (typeof item.id === "string" || typeof item.id === "number") {
+          if (!this.onRequest) throw new Error();
+          this.onRequest({ ...event, id: item.id });
+        } else for (const listener of this.listeners) listener(event);
+        return;
+      }
+      if (typeof item.id !== "number") throw new Error();
+      const pending = this.pending.get(item.id);
+      if (!pending) throw new Error();
+      this.pending.delete(item.id);
+      clearTimeout(pending.timer);
+      // 远端错误文本可能包含令牌/回调地址；只返回受控的失败原因。
+      if (item.error) {
+        this.diagnostic?.(JSON.stringify(item.error));
+        const code =
+          typeof (item.error as any).code === "number" ? ` (${(item.error as any).code})` : "";
+        pending.reject(new Error(`Native Codex ${pending.method} request failed${code}`));
+      } else if ("result" in item) pending.resolve(item.result);
+      else throw new Error();
+    } catch {
+      this.fail(new Error("Native Codex returned an invalid protocol frame"));
+    }
+  }
+  private send(item: unknown) {
+    if (this.closed) throw this.failure ?? new Error("Native Codex connection is closed");
+    this.child.stdin.write(JSON.stringify(item) + "\n", (error) => {
+      if (error) this.fail(new Error("Native Codex protocol write failed"));
+    });
+  }
+  request<T = unknown>(method: string, params: unknown, timeoutMs = 15000): Promise<T> {
+    const id = this.nextId++;
+    const result = Promise.withResolvers<unknown>();
+    const timer = setTimeout(
+      () => this.fail(new Error("Native Codex control timed out")),
+      timeoutMs,
+    );
+    timer.unref();
+    this.pending.set(id, { ...result, timer, method });
+    try {
+      this.send({ id, method, params });
+    } catch (error) {
+      clearTimeout(timer);
+      this.pending.delete(id);
+      result.reject(error);
+    }
+    return result.promise as Promise<T>;
+  }
+  notify(method: string, params: unknown = {}) {
+    this.send({ method, params });
+  }
+  respond(id: string | number, result: unknown) {
+    this.send({ id, result });
+  }
+  async initialize(): Promise<{ userAgent: string }> {
+    const result = await this.request<{ userAgent: string }>("initialize", {
+      clientInfo: { name: "fleet", title: "Fleet", version: "0.1.0" },
+      capabilities: { experimentalApi: true },
+    });
+    if (typeof result?.userAgent !== "string")
+      throw new Error("Unsupported native Codex handshake");
+    this.notify("initialized");
+    return result;
+  }
+  private fail(error: Error) {
+    if (this.closed) return;
+    this.failure = error;
+    this.onFailure?.(error);
+    void this.close().catch(() => {});
+  }
+  async close(mode: "stop" | "settled" = "stop") {
+    if (!this.closed) {
+      this.closed = true;
+      const error = this.failure ?? new Error("Native Codex connection closed");
+      for (const pending of this.pending.values()) {
+        clearTimeout(pending.timer);
+        pending.reject(error);
+      }
+      this.pending.clear();
+      this.listeners.clear();
+      if (mode === "settled" && this.child.pid && this.child.exitCode === null) {
+        this.child.stdin.end();
+        const timer = setTimeout(() => this.child.kill("SIGKILL"), 1500);
+        timer.unref();
+        await this.exited;
+        clearTimeout(timer);
+        return;
+      }
+      // Stop 不把错误工具回执送回仍存活的模型循环，先回收自己创建的进程。
+      if (this.child.pid && this.child.exitCode === null) {
+        try {
+          if (process.platform === "win32") this.child.kill("SIGKILL");
+          else process.kill(-this.child.pid, "SIGKILL");
+        } catch {
+          this.child.kill("SIGKILL");
+        }
+      }
+    }
+    await this.exited;
+  }
+}
