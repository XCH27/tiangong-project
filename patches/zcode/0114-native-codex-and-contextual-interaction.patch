@@ -0,0 +1,63 @@
+import { spawn } from "node:child_process";
+
+/** Native CLI owns authorization; this shared child lifetime never receives or stores a token. */
+export function superviseNativeLogin(
+  executable: string,
+  args: string[],
+  env: NodeJS.ProcessEnv,
+  timeoutMs = 180000,
+) {
+  const child = spawn(executable, args, {
+    env,
+    shell: false,
+    windowsHide: true,
+    stdio: ["pipe", "ignore", "pipe"],
+  });
+  // Classify the failure without returning OAuth URLs, codes or native secret output.
+  let diagnostics = "";
+  child.stderr?.on("data", (chunk: Buffer) => {
+    diagnostics = (diagnostics + chunk.toString()).slice(-8192);
+  });
+  let settled = false;
+  let terminateTimer: ReturnType<typeof setTimeout> | undefined;
+  const completion = Promise.withResolvers<void>();
+  const settle = (error?: Error) => {
+    if (settled) return;
+    settled = true;
+    clearTimeout(timer);
+    if (error) completion.reject(error);
+    else completion.resolve();
+  };
+  const cancel = (message = "Native CLI login cancelled") => {
+    if (settled) return;
+    child.stdin?.end();
+    child.kill("SIGTERM");
+    terminateTimer = setTimeout(() => child.kill("SIGKILL"), 1500);
+    terminateTimer.unref();
+    settle(new Error(message));
+  };
+  const timer = setTimeout(() => cancel("Native CLI login timed out"), timeoutMs);
+  timer.unref();
+  child.once("error", (error) => settle(error));
+  child.once("close", (code) => {
+    clearTimeout(terminateTimer);
+    const reason = /ECONN|ENOTFOUND|EAI_AGAIN|fetch failed|network|certificate|TLS|proxy/i.test(
+      diagnostics,
+    )
+      ? "network"
+      : /timed? ?out|ETIMEDOUT/i.test(diagnostics)
+        ? "timeout"
+        : /invalid_grant|access_denied|unauthorized|authorization failed/i.test(diagnostics)
+          ? "authorization"
+          : "unknown";
+    diagnostics = "";
+    settle(
+      code === 0
+        ? undefined
+        : new Error(`Native CLI login failed: ${reason} (exit ${code ?? "signal"})`),
+    );
+  });
+  // A consumer may cancel before installing its own waiter; never create an unhandled rejection.
+  void completion.promise.catch(() => {});
+  return { completion: completion.promise, cancel };
+}
