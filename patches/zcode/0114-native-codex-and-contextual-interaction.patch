@@ -0,0 +1,21 @@
+import type { ModelEvent } from "@zcode/contracts";
+
+/** Per-input observations only; canonical history and results remain with the Host. */
+export class NativeEvents {
+  private values: Array<ModelEvent | Error> = [];
+  private notify?: () => void;
+  push(value: ModelEvent | Error) {
+    this.values.push(value);
+    this.notify?.();
+    this.notify = undefined;
+  }
+  async next(): Promise<ModelEvent> {
+    while (!this.values.length)
+      await new Promise<void>((resolve) => {
+        this.notify = resolve;
+      });
+    const value = this.values.shift()!;
+    if (value instanceof Error) throw value;
+    return value;
+  }
+}
