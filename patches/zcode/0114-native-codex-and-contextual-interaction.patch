--- /dev/null
+++ b/packages/ui/src/page-assistant/usePageAssistantPlacement.ts
@@ -0,0 +1,171 @@
+import {
+  useEffect,
+  useRef,
+  useState,
+  type PointerEvent,
+  type MouseEvent as ReactMouseEvent,
+  type KeyboardEvent,
+} from "react";
+
+/** Craft EditPopover's bounded drag/resize behavior, on ZCode's existing popover surface. */
+export function usePageAssistantPlacement(invocationId?: string, preservePlacement = false) {
+  const panel = useRef<HTMLDivElement>(null);
+  const offset = useRef({ x: 0, y: 0 });
+  const [position, setPosition] = useState(offset.current);
+  const [size, setSize] = useState({ width: 400, height: 480 });
+  const [active, setActive] = useState(false);
+  const gesture = useRef<
+    | {
+        kind: "move" | "resize";
+        x: number;
+        y: number;
+        width: number;
+        height: number;
+        left: number;
+        top: number;
+      }
+    | undefined
+  >(undefined);
+  const clamp = (value: number, min: number, max: number) =>
+    Math.max(min, Math.min(Math.max(min, max), value));
+  const move = (x: number, y: number) => {
+    const rect = panel.current?.getBoundingClientRect();
+    if (!rect) return;
+    const baseX = rect.left - offset.current.x;
+    const baseY = rect.top - offset.current.y;
+    offset.current = {
+      x: clamp(x, 16, window.innerWidth - 16 - rect.width) - baseX,
+      y: clamp(y, 48, window.innerHeight - 16 - rect.height) - baseY,
+    };
+    setPosition(offset.current);
+  };
+  useEffect(() => {
+    if (preservePlacement) return;
+    gesture.current = undefined;
+    offset.current = { x: 0, y: 0 };
+    setPosition(offset.current);
+    setActive(false);
+    setSize({
+      width: Math.min(400, window.innerWidth - 32),
+      height: Math.min(480, window.innerHeight - 64),
+    });
+  }, [invocationId, preservePlacement]);
+  useEffect(() => {
+    const resize = () => {
+      setSize((current) => ({
+        width: Math.min(current.width, window.innerWidth - 32),
+        height: Math.min(current.height, window.innerHeight - 64),
+      }));
+      requestAnimationFrame(() => {
+        const rect = panel.current?.getBoundingClientRect();
+        if (rect) move(rect.left, rect.top);
+      });
+    };
+    window.addEventListener("resize", resize);
+    return () => window.removeEventListener("resize", resize);
+  }, []);
+  const start = (
+    event: ReactMouseEvent<HTMLElement> | PointerEvent<HTMLElement>,
+    kind: "move" | "resize",
+  ) => {
+    if (event.button !== 0) return;
+    const rect = panel.current?.getBoundingClientRect();
+    if (!rect) return;
+    event.preventDefault();
+    event.currentTarget.focus({ preventScroll: true });
+    gesture.current = {
+      kind,
+      x: event.clientX,
+      y: event.clientY,
+      width: rect.width,
+      height: rect.height,
+      left: rect.left,
+      top: rect.top,
+    };
+    setActive(true);
+  };
+  const update = (event: { clientX: number; clientY: number }) => {
+    const current = gesture.current;
+    if (!current) return;
+    const dx = event.clientX - current.x,
+      dy = event.clientY - current.y;
+    if (current.kind === "move") move(current.left + dx, current.top + dy);
+    else
+      setSize({
+        width: clamp(
+          current.width + dx,
+          Math.min(300, window.innerWidth - 32),
+          window.innerWidth - 32,
+        ),
+        height: clamp(
+          current.height + dy,
+          Math.min(250, window.innerHeight - 64),
+          window.innerHeight - 64,
+        ),
+      });
+  };
+  const finish = () => {
+    gesture.current = undefined;
+    setActive(false);
+  };
+  useEffect(() => {
+    if (!active) return;
+    // Craft listens on the document so dragging keeps working outside the handle.
+    // Retain mouse events for native WebView input; pointer events also cover touch.
+    document.addEventListener("mousemove", update);
+    document.addEventListener("pointermove", update);
+    document.addEventListener("mouseup", finish);
+    document.addEventListener("pointerup", finish);
+    document.addEventListener("pointercancel", finish);
+    window.addEventListener("blur", finish);
+    return () => {
+      document.removeEventListener("mousemove", update);
+      document.removeEventListener("pointermove", update);
+      document.removeEventListener("mouseup", finish);
+      document.removeEventListener("pointerup", finish);
+      document.removeEventListener("pointercancel", finish);
+      window.removeEventListener("blur", finish);
+    };
+  }, [active]);
+  const keyboard = (event: KeyboardEvent<HTMLElement>, kind: "move" | "resize") => {
+    const delta = {
+      ArrowLeft: [-16, 0],
+      ArrowRight: [16, 0],
+      ArrowUp: [0, -16],
+      ArrowDown: [0, 16],
+    }[event.key];
+    const rect = panel.current?.getBoundingClientRect();
+    if (!delta || !rect) return;
+    event.preventDefault();
+    event.stopPropagation();
+    if (kind === "move") move(rect.left + delta[0]!, rect.top + delta[1]!);
+    else
+      setSize({
+        width: clamp(
+          size.width + delta[0]!,
+          Math.min(300, window.innerWidth - 32),
+          window.innerWidth - 32,
+        ),
+        height: clamp(
+          size.height + delta[1]!,
+          Math.min(250, window.innerHeight - 64),
+          window.innerHeight - 64,
+        ),
+      });
+  };
+  const handle = (kind: "move" | "resize") => ({
+    onMouseDown: (event: ReactMouseEvent<HTMLElement>) => start(event, kind),
+    onPointerDown: (event: PointerEvent<HTMLElement>) => {
+      if (event.pointerType !== "mouse") start(event, kind);
+    },
+    onKeyDown: (event: KeyboardEvent<HTMLElement>) => keyboard(event, kind),
+  });
+  return {
+    panel,
+    active,
+    size,
+    style: { transform: `translate(${position.x}px, ${position.y}px)` },
+    moveHandle: handle("move"),
+    resizeHandle: handle("resize"),
+  };
+}
