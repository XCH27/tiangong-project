+import { codexNativeEnvironment, type CodexClientOptions } from "./codex-client.js";
+import { resolveCodexNativeExecutable } from "./codex-executable.js";
+import { superviseNativeLogin } from "./native-login.js";
+
+/** Uses the official Codex login, not Fleet client registration or another app's token file. */
+export function startCodexNativeLogin(options: CodexClientOptions & { timeoutMs?: number } = {}) {
+  return superviseNativeLogin(
+    resolveCodexNativeExecutable(options.executable),
+    ["login"],
+    codexNativeEnvironment(options),
+    options.timeoutMs,
+  );
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/codex-turn.ts b/apps/zcode-cli/packages/adapters/src/native-agent/codex-turn.ts
new file mode 100644
index 0000000..343bffd
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/codex-turn.ts
@@ -0,0 +1,389 @@
+import { codexEventObject as object, codexUsage } from "./codex-event-contract.js";
+import { isDeepStrictEqual } from "node:util";
+import type { Model, ModelResult, NativeAgentPort, NativeAgentToolReceipt } from "@zcode/contracts";
+import { CodexClient, type CodexClientOptions, type CodexServerRequest } from "./codex-client.js";
+import { readCodexNativeIdentity } from "./codex-inspect.js";
+import { codexInput, codexToolContent } from "./codex-content.js";
+import { NativeEvents } from "./native-events.js";
+import { canResumeCodex, codexContinuation } from "./codex-continuation.js";
+
+/** One official native loop; dynamic calls wait for the Host's committed, admitted receipts. */
+export function createCodexNativeAgentPort(options: CodexClientOptions = {}): NativeAgentPort {
+  return {
+    canResume(continuation, request) {
+      return canResumeCodex(
+        continuation,
+        {
+          ...options,
+          executable: request.model.nativeExecutor?.executable ?? options.executable,
+          configDir: request.model.nativeExecutor?.configDir ?? options.configDir,
+        },
+        request.model.nativeExecutor?.accountId,
+      );
+    },
+    createTurn(request) {
+      if (request.model.nativeExecutor?.kind !== "codex")
+        throw new Error("Unsupported native Agent executor");
+      const events = new NativeEvents();
+      const definitions = request.tools.filter((tool) => !tool.providerNative);
+      const names = new Set(definitions.map((tool) => tool.name));
+      const scope = [...names].map((name) => `fleet.${name}`);
+      const bindings = new Map<string, { name: string; input: unknown }>();
+      const callbacks = new Map<string, CodexServerRequest>();
+      const receipts = new Map<string, NativeAgentToolReceipt>();
+      const available = new Map<string, number>();
+      const seenResponses = new Set<string>();
+      let client: CodexClient | undefined;
+      let start: Promise<void> | undefined;
+      let closePromise: Promise<void> | undefined;
+      let closed = false;
+      let admission = 0;
+      let threadId: string | undefined;
+      let turnId: string | undefined;
+      let text = "";
+      let calls: NonNullable<ModelResult["toolCalls"]> = [];
+      let finalResult: ModelResult | undefined;
+      let completed = false;
+      let executorVersion: string | undefined;
+      let checkpoint: Awaited<ReturnType<typeof codexContinuation>> | undefined;
+      const fail = (error: unknown) => {
+        if (closed) return;
+        events.push(error instanceof Error ? error : new Error("Native Codex execution failed"));
+        closed = true;
+        void client?.close().catch(() => {});
+      };
+      const reply = () => {
+        for (const [id, callback] of callbacks) {
+          const receipt = receipts.get(id),
+            binding = bindings.get(id);
+          if (!receipt || !binding || (available.get(id) ?? Infinity) > admission) continue;
+          const input = object(callback.params);
+          if (
+            receipt.toolName !== binding.name ||
+            !isDeepStrictEqual(receipt.input, binding.input) ||
+            !isDeepStrictEqual(receipt.input, input.arguments)
+          )
+            throw new Error("Native Codex callback does not match its committed Host receipt");
+          client!.respond(callback.id, {
+            contentItems: codexToolContent(receipt.content),
+            success: !receipt.isError,
+          });
+          callbacks.delete(id);
+          receipts.delete(id);
+          bindings.delete(id);
+          available.delete(id);
+        }
+      };
+      const onRequest = (callback: CodexServerRequest) => {
+        try {
+          if (callback.method !== "item/tool/call")
+            throw new Error("Unsupported native Codex request");
+          const value = object(callback.params);
+          if (
+            value.threadId !== threadId ||
+            value.turnId !== turnId ||
+            value.namespace !== "fleet" ||
+            typeof value.callId !== "string" ||
+            !names.has(value.tool) ||
+            callbacks.has(value.callId)
+          )
+            throw new Error("Native Codex tool callback has a changed scope");
+          const binding = bindings.get(value.callId);
+          if (
+            binding &&
+            (binding.name !== value.tool || !isDeepStrictEqual(binding.input, value.arguments))
+          )
+            throw new Error("Native Codex tool callback changed its input");
+          callbacks.set(value.callId, callback);
+          // IPC 回调可晚于 Host admission 到达；仍按已捕获的放行轮次，而不是绕开 admission。
+          reply();
+        } catch (error) {
+          fail(error);
+        }
+      };
+      const finish = (result: ModelResult) => {
+        for (const toolCall of result.toolCalls ?? []) events.push({ type: "tool_call", toolCall });
+        events.push({
+          type: "finish",
+          finishReason: result.finishReason,
+          usage: result.usage,
+          providerMetadata: result.providerMetadata,
+        });
+      };
+      const consume = (method: string, params: unknown) => {
+        if (closed) return;
+        try {
+          const value = object(params);
+          if (value.threadId && value.threadId !== threadId) return;
+          if (value.turnId && turnId && value.turnId !== turnId) return;
+          if (method === "turn/started") {
+            turnId ??= value.turn.id;
+            return;
+          }
+          if (method === "item/agentMessage/delta") {
+            if (typeof value.delta !== "string") throw new Error("Invalid native Codex text delta");
+            text += value.delta;
+            events.push({ type: "text_delta", text: value.delta });
+            return;
+          }
+          if (method === "rawResponseItem/completed") {
+            const item = object(value.item);
+            if (item.type !== "function_call") return;
+            if (
+              item.namespace !== "fleet" ||
+              !names.has(item.name) ||
+              typeof item.call_id !== "string"
+            )
+              throw new Error("Native Codex returned an unavailable tool");
+            const input =
+              typeof item.arguments === "string" ? JSON.parse(item.arguments) : item.arguments;
+            if (bindings.has(item.call_id))
+              throw new Error("Native Codex repeated a pending tool identity");
+            bindings.set(item.call_id, { name: item.name, input });
+            calls.push({ id: item.call_id, name: item.name, input });
+            return;
+          }
+          if (method === "rawResponse/completed") {
+            if (typeof value.responseId !== "string" || seenResponses.has(value.responseId))
+              throw new Error("Native Codex repeated a model response identity");
+            seenResponses.add(value.responseId);
+            const result: ModelResult = {
+              text,
+              toolCalls: calls,
+              usage: codexUsage(value.usage),
+              finishReason: calls.length ? "tool-calls" : "stop",
+              providerMetadata: {
+                nativeExecutor: "codex",
+                nativeRequestId: value.responseId,
+                nativeReportedUsage: value.usage,
+                fleetAccounting: {
+                  billingProvider: "openai",
+                  authKind: "subscription",
+                  accountId: request.model.nativeExecutor?.accountId,
+                },
+              },
+            };
+            if (calls.length) finish(result);
+            else finalResult = result;
+            text = "";
+            calls = [];
+            return;
+          }
+          if (method === "turn/completed") {
+            if (value.turn.status !== "completed" || !finalResult || callbacks.size)
+              throw new Error("Native Codex ended without a successful terminal receipt");
+            const terminal = finalResult;
+            finalResult = undefined;
+            // 已完成的模型回执先进入 Host；后续恢复快照失败也不能抹掉真实用量和结果。
+            completed = true;
+            finish({
+              ...terminal,
+              providerMetadata: {
+                ...terminal.providerMetadata,
+                nativeSessionId: threadId,
+                nativeContinuationMode: request.continuation ? "resume" : "fresh",
+              },
+            });
+            return;
+          }
+          if (method === "error" && !value.willRetry) {
+            options.onDiagnostic?.(JSON.stringify(value));
+            throw new Error("Native Codex execution failed");
+          }
+        } catch (error) {
+          fail(error);
+        }
+      };
+      const launch = (messages: Parameters<Model["streamText"]>[0]["messages"]) => {
+        start ??= (async () => {
+          if (closed || request.signal.aborted) throw new Error("Native Codex turn stopped");
+          const access = request.model.nativeExecutor!;
+          client = new CodexClient({
+            ...options,
+            executable: access.executable ?? options.executable,
+            configDir: access.configDir ?? options.configDir,
+            cwd: request.workingDirectory,
+            args: options.args ?? [
+              "app-server",
+              "--listen",
+              "stdio://",
+              "--host-tools-json",
+              JSON.stringify(scope),
+            ],
+          });
+          client.onRequest = onRequest;
+          client.onFailure = fail;
+          client.subscribe(({ method, params }) => consume(method, params));
+          const initialized = (await client.initialize()) as {
+            userAgent: string;
+            fleetHostToolScope?: { version: number; tools: string[] };
+          };
+          executorVersion = initialized.userAgent;
+          if (
+            initialized.fleetHostToolScope?.version !== 1 ||
+            !isDeepStrictEqual([...initialized.fleetHostToolScope.tools].sort(), [...scope].sort())
+          )
+            throw new Error("Native Codex cannot enforce this Host tool scope");
+          await readCodexNativeIdentity(client, access.accountId);
+          if (closed || request.signal.aborted) throw new Error("Native Codex turn stopped");
+          const created = object(
+            await client.request(request.continuation ? "thread/resume" : "thread/start", {
+              ...(request.continuation ? { threadId: request.continuation.sessionId } : {}),
+              model: request.model.modelId,
+              modelProvider: "openai",
+              cwd: request.workingDirectory,
+              ephemeral: request.persistContinuation !== true,
+              environments: [],
+              selectedCapabilityRoots: [],
+              approvalPolicy: "never",
+              sandbox: "read-only",
+              experimentalRawEvents: true,
+              developerInstructions: messages
+                .filter((message) => message.role === "system")
+                .map((message) =>
+                  typeof message.content === "string"
+                    ? message.content
+                    : JSON.stringify(message.content),
+                )
+                .join("\n\n"),
+              ...(!request.continuation
+                ? {
+                    dynamicTools: [
+                      {
+                        type: "namespace",
+                        name: "fleet",
+                        description: "Fleet Host operations",
+                        tools: definitions.map((tool) => ({
+                          type: "function",
+                          name: tool.name,
+                          description: tool.description ?? "",
+                          inputSchema: tool.inputSchema,
+                        })),
+                      },
+                    ],
+                  }
+                : {}),
+              config: {
+                "features.code_mode.enabled": false,
+                "features.code_mode.direct_only_tool_namespaces": ["fleet"],
+                "features.plugins": false,
+                "features.skip_host_skill_discovery": true,
+                "features.apps": false,
+                "features.enable_mcp_apps": false,
+                "orchestrator.mcp.enabled": false,
+                "cloud.mcp.enabled": false,
+                "skills.include_instructions": false,
+                project_doc_max_bytes: 0,
+              },
+            }),
+          );
+          threadId = created.thread?.id;
+          if (
+            typeof threadId !== "string" ||
+            created.model !== request.model.modelId ||
+            created.modelProvider !== "openai"
+          )
+            throw new Error("Native Codex changed its admitted model");
+          const effort = request.model.options.reasoningLevel;
+          const input = request.continuation
+            ? messages
+                .filter((message) => message.role !== "system")
+                .slice(request.continuationMessageOffset ?? 0)
+            : messages;
+          const begun = object(
+            await client.request("turn/start", {
+              threadId,
+              input: codexInput(input),
+              ...(effort && effort !== "auto" ? { effort } : {}),
+              serviceTier: request.model.options.speedMode === "fast" ? "priority" : null,
+            }),
+          );
+          turnId ??= begun.turn?.id;
+          if (typeof turnId !== "string") throw new Error("Native Codex did not identify its turn");
+        })().catch(fail);
+      };
+      const model: Model = {
+        ...request.model,
+        bind() {
+          return model;
+        },
+        async generateText(input) {
+          let body = "";
+          const toolCalls: NonNullable<ModelResult["toolCalls"]> = [];
+          for await (const event of model.streamText(input)) {
+            if (event.type === "text_delta") body += event.text;
+            if (event.type === "tool_call") toolCalls.push(event.toolCall);
+            if (event.type === "finish")
+              return {
+                text: body,
+                toolCalls,
+                finishReason: event.finishReason,
+                usage: event.usage,
+                providerMetadata: event.providerMetadata,
+              };
+          }
+          throw new Error("Native Codex ended without a result");
+        },
+        async *streamText(input) {
+          launch(input.messages);
+          for (;;) {
+            const event = await events.next();
+            yield event;
+            if (event.type === "finish") return;
+          }
+        },
+      };
+      const stop = () => {
+        fail(new Error("Native Codex turn stopped"));
+      };
+      request.signal.addEventListener("abort", stop, { once: true });
+      return {
+        model,
+        checkpoint: async () => (completed ? checkpoint : undefined),
+        async admitNextStep() {
+          if (closed || request.signal.aborted) throw new Error("Native Codex turn stopped");
+          if (client)
+            await readCodexNativeIdentity(client, request.model.nativeExecutor?.accountId);
+          if (closed || request.signal.aborted) throw new Error("Native Codex turn stopped");
+          admission++;
+          reply();
+          events.push({ type: "start" });
+        },
+        retainToolReceipts(values) {
+          for (const value of values) {
+            receipts.set(value.toolCallId, value);
+            available.set(value.toolCallId, admission + 1);
+          }
+        },
+        async close() {
+          closePromise ??= (async () => {
+            closed = true;
+            events.push(new Error("Native Codex connection closed"));
+            request.signal.removeEventListener("abort", stop);
+            await client?.close(completed ? "settled" : "stop");
+            await start;
+            if (completed && request.persistContinuation && threadId && executorVersion) {
+              const reader = new CodexClient({
+                ...options,
+                executable: request.model.nativeExecutor?.executable ?? options.executable,
+                configDir: request.model.nativeExecutor?.configDir ?? options.configDir,
+              });
+              try {
+                await reader.initialize();
+                await readCodexNativeIdentity(reader, request.model.nativeExecutor?.accountId);
+                checkpoint = await codexContinuation(reader, threadId, executorVersion);
+              } finally {
+                await reader.close();
+              }
+            }
+            callbacks.clear();
+            receipts.clear();
+            bindings.clear();
+            available.clear();
+          })();
+          await closePromise;
+        },
+      };
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/index.ts b/apps/zcode-cli/packages/adapters/src/native-agent/index.ts
index 94a7a89..df3af9d 100644
