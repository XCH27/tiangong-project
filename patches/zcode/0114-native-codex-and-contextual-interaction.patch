+import type { NativeAgentPort } from "@zcode/contracts";
+import { createClaudeNativeAgentPort } from "./claude.js";
+import { createCodexNativeAgentPort } from "./codex-turn.js";
+
+/** One executor per admitted model; the Host and its durable writers remain unchanged. */
+export function createNativeAgentPort(): NativeAgentPort {
+  const claude = createClaudeNativeAgentPort(),
+    codex = createCodexNativeAgentPort();
+  const select = (kind?: string) => {
+    if (kind === "claude") return claude;
+    if (kind === "codex") return codex;
+    throw new Error("Unsupported native Agent executor");
+  };
+  return {
+    canResume: async (continuation, request) =>
+      select(request.model.nativeExecutor?.kind).canResume?.(continuation, request) ?? false,
+    createTurn: (request) => select(request.model.nativeExecutor?.kind).createTurn(request),
+  };
+}
