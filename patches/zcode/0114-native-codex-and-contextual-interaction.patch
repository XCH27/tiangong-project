index 0000000..af1e44d
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/codex-executable.ts
@@ -0,0 +1,36 @@
+import { accessSync, constants } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+/** Prefer the reviewed scoped build; never silently use an executor without the Host ceiling. */
+export function resolveCodexNativeExecutable(override?: string): string {
+  if (override) return override;
+  const file = typeof __filename === "string" ? __filename : fileURLToPath(import.meta.url);
+  const name = process.platform === "win32" ? "codex.exe" : "codex";
+  const roots = [dirname(file)];
+  for (let index = 0; index < 8; index++) roots.push(resolve(roots.at(-1)!, ".."));
+  for (const root of roots) {
+    for (const candidate of [
+      join(root, "codex", name),
+      join(
+        root,
+        "packages",
+        "desktop",
+        "bundled-agents",
+        `${process.platform}-${process.arch}`,
+        "codex",
+        name,
+      ),
+    ]) {
+      try {
+        accessSync(candidate, constants.X_OK);
+        return candidate;
+      } catch {
+        /* Try the existing staging layouts. */
+      }
+    }
+  }
+  throw new Error(
+    "The scoped Codex executor is unavailable; build its native SDK before connecting",
+  );
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/codex-inspect.ts b/apps/zcode-cli/packages/adapters/src/native-agent/codex-inspect.ts
new file mode 100644
index 0000000..890fbe8
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/codex-inspect.ts
@@ -0,0 +1,124 @@
+import { createHash } from "node:crypto";
+import { z } from "zod";
+import { CodexClient, type CodexClientOptions } from "./codex-client.js";
+import { resolveCodexNativeExecutable } from "./codex-executable.js";
+
+const accountSchema = z.object({
+  account: z.object({
+    type: z.literal("chatgpt"),
+    email: z.string().trim().min(1),
+    planType: z.string().min(1),
+  }),
+  workspaceRouting: z.object({
+    chatgptAccountId: z.string().trim().min(1),
+    backendOrigin: z.string().url(),
+  }),
+});
+const modelSchema = z.object({
+  id: z.string().min(1),
+  model: z.string().min(1),
+  displayName: z.string(),
+  hidden: z.boolean(),
+  supportedReasoningEfforts: z.array(
+    z.object({ reasoningEffort: z.string(), description: z.string() }),
+  ),
+  defaultReasoningEffort: z.string(),
+  inputModalities: z.array(z.string()),
+  isDefault: z.boolean(),
+  serviceTiers: z.array(z.object({ id: z.string() }).passthrough()).optional(),
+});
+export type CodexNativeModelInfo = z.infer<typeof modelSchema>;
+export interface CodexNativeIdentity {
+  accountId: string;
+  accountName: string;
+  planType: string;
+}
+export function codexNativeIdentity(value: unknown): CodexNativeIdentity {
+  const parsed = accountSchema.safeParse(value);
+  if (!parsed.success)
+    throw new Error(
+      "Sign in to the official Codex CLI with your ChatGPT subscription account first",
+    );
+  const { account, workspaceRouting } = parsed.data;
+  // 团队 workspace ID 可能共享；绑定官方返回的账号标签，不能只用邮箱或 workspace ID。
+  const scope = [
+    workspaceRouting.chatgptAccountId,
+    account.email.trim().toLowerCase(),
+    workspaceRouting.backendOrigin,
+  ];
+  return {
+    accountId: "codex:" + createHash("sha256").update(JSON.stringify(scope)).digest("hex"),
+    accountName: account.email,
+    planType: account.planType,
+  };
+}
+export async function readCodexNativeIdentity(client: CodexClient, expected?: string) {
+  const identity = codexNativeIdentity(
+    await client.request("account/read", { refreshToken: false }),
+  );
+  if (expected && identity.accountId !== expected)
+    throw new Error("Native Codex account changed; reconnect this connection");
+  return identity;
+}
+export async function inspectCodexNativeConnection(options: CodexClientOptions = {}) {
+  const client = new CodexClient({
+    ...options,
+    executable: resolveCodexNativeExecutable(options.executable),
+    args: options.args ?? ["app-server", "--listen", "stdio://", "--host-tools-json", "[]"],
+  });
+  try {
+    const initialized = (await client.initialize()) as {
+      userAgent: string;
+      fleetHostToolScope?: { version: number; tools: string[] };
+    };
+    if (
+      initialized.fleetHostToolScope?.version !== 1 ||
+      initialized.fleetHostToolScope.tools.length
+    )
+      throw new Error("Native Codex cannot enforce the Host connection scope");
+    const { userAgent } = initialized;
+    const identity = await readCodexNativeIdentity(client);
+    const models: CodexNativeModelInfo[] = [];
+    let cursor: string | undefined;
+    const cursors = new Set<string>();
+    do {
+      const page = z
+        .object({ data: z.array(modelSchema), nextCursor: z.string().nullable() })
+        .parse(
+          await client.request("model/list", {
+            includeHidden: false,
+            ...(cursor ? { cursor } : {}),
+          }),
+        );
+      models.push(...page.data.filter((model) => !model.hidden));
+      if (models.length > 2000) throw new Error("Native Codex model catalog exceeds its limit");
+      cursor = page.nextCursor ?? undefined;
+      if (cursor && cursors.has(cursor))
+        throw new Error("Native Codex model catalog repeated its cursor");
+      if (cursor) cursors.add(cursor);
+    } while (cursor);
+    // 检查目录读取期间原生登录是否被切换；失败不能发布别的账号目录。
+    await readCodexNativeIdentity(client, identity.accountId);
+    return { ...identity, userAgent, models };
+  } finally {
+    await client.close();
+  }
+}
+
+/** Prompt-free quota control; the official CLI retains refresh and selected-workspace routing. */
+export async function readCodexNativeUsage(options: CodexClientOptions & { accountId: string }) {
+  const client = new CodexClient({
+    ...options,
+    executable: resolveCodexNativeExecutable(options.executable),
+    args: options.args ?? ["app-server", "--listen", "stdio://", "--host-tools-json", "[]"],
+  });
+  try {
+    await client.initialize();
+    await readCodexNativeIdentity(client, options.accountId);
+    const usage = await client.request("account/rateLimits/read", {});
+    await readCodexNativeIdentity(client, options.accountId);
+    return usage;
+  } finally {
+    await client.close();
+  }
+}
