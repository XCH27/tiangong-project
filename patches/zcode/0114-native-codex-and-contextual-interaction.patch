+
+export const codexEventObject = (value: unknown): Record<string, any> => {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw new Error("Invalid native Codex event");
+  return value as Record<string, any>;
+};
+export function codexUsage(value: unknown): ModelUsage {
+  if (value == null) return {};
+  const raw = codexEventObject(value);
+  const fields = [
+    "inputTokens",
+    "cachedInputTokens",
+    "outputTokens",
+    "reasoningOutputTokens",
+    "totalTokens",
+  ];
+  for (const field of fields)
+    if (!Number.isSafeInteger(raw[field]) || raw[field] < 0)
+      throw new Error("Invalid native Codex usage counters");
+  if (raw.cachedInputTokens > raw.inputTokens || raw.reasoningOutputTokens > raw.outputTokens)
+    throw new Error("Invalid native Codex usage classes");
+  return {
+    inputTokens: raw.inputTokens,
+    outputTokens: raw.outputTokens,
+    totalTokens: raw.totalTokens,
+    cacheReadTokens: raw.cachedInputTokens,
+    reasoningTokens: raw.reasoningOutputTokens,
+    ...(Number.isSafeInteger(raw.cacheWriteInputTokens) && raw.cacheWriteInputTokens >= 0
+      ? { cacheWriteTokens: raw.cacheWriteInputTokens }
+      : {}),
+  };
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/codex-executable.ts b/apps/zcode-cli/packages/adapters/src/native-agent/codex-executable.ts
