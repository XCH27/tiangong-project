+const executable = resolveCodexNativeExecutable(process.env.FLEET_CODEX_TEST_CLI);
+async function nativeFixture() {
+  assert.ok(executable, "Build and select the scoped Codex binary before this test");
+  const profile = await mkdtemp(join(tmpdir(), "fleet-codex-native-"));
+  const payload = Buffer.from(
+    JSON.stringify({
+      email: "fixture@example.invalid",
+      sub: "fixture-user",
+      "https://api.openai.com/auth": {
+        chatgpt_account_id: "fixture-workspace",
+        chatgpt_user_id: "fixture-user",
+        chatgpt_plan_type: "pro",
+      },
+      exp: Math.floor(Date.now() / 1000) + 3600,
+    }),
+  ).toString("base64url");
+  await writeFile(
+    join(profile, "auth.json"),
+    JSON.stringify({
+      auth_mode: "chatgpt",
+      OPENAI_API_KEY: null,
+      tokens: {
+        id_token: `e30.${payload}.fixture`,
+        access_token: "synthetic-native-token",
+        refresh_token: "synthetic-refresh",
+        account_id: "fixture-workspace",
+      },
+      last_refresh: new Date().toISOString(),
+    }),
+    { mode: 0o600 },
+  );
+  const requests: any[] = [];
+  let diagnostics = "";
+  let failure: unknown;
+  let stopFixture: (() => void) | undefined;
+  let retainedTools: any[] = [];
+  const respond = (body: any, send: (type: string, value: object) => void) => {
+    assert.ok(requests.length <= 3, "Unexpected extra native inference");
+    const declared =
+      body.tools ??
+      body.input
+        .filter((item: any) => item.type === "additional_tools")
+        .flatMap((item: any) => item.tools);
+    if (declared.length) retainedTools = declared;
+    const tools = retainedTools;
+    assert.equal(body.reasoning?.effort, "high");
+    assert.deepEqual(
+      tools.map((t: any) =>
+        t.type === "namespace" ? [t.name, t.tools.map((x: any) => x.name)] : t.name,
+      ),
+      [["fleet", ["Probe"]]],
+    );
+    const done =
+      body.input.some((item: any) => item.type === "function_call_output") ||
+      JSON.stringify(body.input).includes("after-restart-input");
+    const id = `response-${requests.length}`;
+    send("response.created", { response: { id, status: "in_progress", output: [] } });
+    const item = done
+      ? {
+          type: "message",
+          id: "message-final",
+          role: "assistant",
+          status: "completed",
+          content: [{ type: "output_text", text: "native-codex-complete", annotations: [] }],
