diff --git a/packages/ui/src/settings/model-provider-section/ProviderTemplateSetup.tsx b/packages/ui/src/settings/model-provider-section/ProviderTemplateSetup.tsx
new file mode 100644
index 0000000..aab85a7
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ProviderTemplateSetup.tsx
@@ -0,0 +1,228 @@
+import { useState } from "react";
+import { ArrowLeftIcon } from "lucide-react";
+import {
+  resolveProviderTemplateName,
+  type ProviderApiType,
+  type ProviderConfigObject,
+} from "@zcode/provider";
+import { Button } from "@/components/ui/button.js";
+import { Input } from "@/components/ui/input.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { ProviderApiKeySection } from "./ProviderCardSections.js";
+import { ProviderLogo } from "./ProviderLogo.js";
+import { ProviderConnectionChoices } from "./ProviderConnectionChoices.js";
+import {
+  newProviderSetupDraft,
+  providerSetupConfig,
+  type ProviderSetupDraft,
+} from "./providerSetupDraft.js";
+import { selectProviderTemplate, type ProviderVendor } from "./providerTemplateCatalog.js";
+
+export function ProviderTemplateSetup({
+  vendor,
+  selectedId,
+  custom,
+  busy,
+  error,
+  onSelect,
+  onBack,
+  onCreate,
+}: {
+  vendor: ProviderVendor;
+  selectedId: string;
+  custom: boolean;
+  busy: boolean;
+  error: boolean;
+  onSelect: (id: string) => void;
+  onBack: () => void;
+  onCreate: (config: ProviderConfigObject, name?: string) => void;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const platform = usePlatform();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.catalog.${key}` });
+  const [drafts, setDrafts] = useState<Record<string, ProviderSetupDraft>>({});
+  const [name, setName] = useState(vendor.label);
+  const [visible, setVisible] = useState(false);
+  const [invalid, setInvalid] = useState(false);
+  const selected = vendor.templates.find((template) => template.templateId === selectedId);
+  if (!selected) return null;
+  const draft = drafts[selectedId] ?? newProviderSetupDraft(selected);
+  const patch = (values: Partial<ProviderSetupDraft>) => {
+    setInvalid(false);
+    setDrafts((previous) => ({ ...previous, [selectedId]: { ...draft, ...values } }));
+  };
+  const serviceId = selected.catalog?.serviceId ?? selected.templateId;
+  const subscription = selected.config.access?.type === "subscription";
+  const services = [
+    ...new Map(
+      vendor.templates.map((template) => [
+        template.catalog?.serviceId ?? template.templateId,
+        resolveProviderTemplateName(
+          template.templateId,
+          { templateNameMap: template.catalog?.serviceNameMap ?? template.templateNameMap },
+          locale,
+        ),
+      ]),
+    ).entries(),
+  ].map(([value, label]) => ({ value, label }));
+  const serviceTemplates = vendor.templates.filter(
+    (template) => (template.catalog?.serviceId ?? template.templateId) === serviceId,
+  );
+  const regions = [...new Set(serviceTemplates.map((template) => template.catalog?.region))].filter(
+    (region): region is "cn" | "global" => region !== undefined,
+  );
+  const protocolRoutes = serviceTemplates.filter(
+    (template) => template.catalog?.region === selected.catalog?.region,
+  );
+  const declaredFormats = [
+    ...new Set(protocolRoutes.map((template) => template.config.api?.type)),
+  ].filter((api): api is ProviderApiType => api != null);
+  const formats: ProviderApiType[] =
+    declaredFormats.length > 1
+      ? declaredFormats
+      : ["anthropic-messages", "openai-chat-completions", "openai-responses"];
+  const choose = (change: Parameters<typeof selectProviderTemplate>[2]) => {
+    if (busy) return;
+    const next = selectProviderTemplate(vendor.templates, selectedId, change);
+    if (!next) return;
+    // 协议变体属于同一服务/地区，沿用本次输入的密钥；跨地区/套餐则恢复各自草稿。
+    if (change.api)
+      setDrafts((previous) => ({
+        ...previous,
+        [next.templateId]: {
+          ...draft,
+          api: next.config.api!.type!,
+          baseUrl: next.config.api!.baseUrl ?? "",
+        },
+      }));
+    setVisible(false);
+    setInvalid(false);
+    onSelect(next.templateId);
+  };
+  const keyUrl =
+    selected.config.access && "apiKeyManagementUrl" in selected.config.access
+      ? selected.config.access.apiKeyManagementUrl
+      : undefined;
+  const submit = () => {
+    if (busy) return;
+    const config = providerSetupConfig(selected, draft);
+    if (!config || (custom && !name.trim())) {
+      setInvalid(true);
+      return;
+    }
+    onCreate(config, custom ? name.trim() : undefined);
+  };
+  return (
+    <section className="space-y-5" data-testid="provider-connection-setup">
+      <div className="flex items-center gap-3">
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon-sm"
+          disabled={busy}
+          onClick={onBack}
+          aria-label={t("back")}
+        >
+          <ArrowLeftIcon className="size-4" />
+        </Button>
+        <ProviderLogo logo={selected.config.logo} className="size-5" />
+        <h2 className="text-ui-lg font-semibold text-foreground">{vendor.label}</h2>
+      </div>
+      <fieldset disabled={busy} className="min-w-0 space-y-4">
+        {custom ? (
+          <div className="space-y-2">
+            <label htmlFor="provider-setup-name" className="text-ui-base text-foreground-subtle">
+              {t("name")}
+            </label>
+            <Input
+              id="provider-setup-name"
+              value={name}
+              onChange={(event) => setName(event.target.value)}
+            />
+          </div>
+        ) : null}
+        <ProviderConnectionChoices
+          label={t("service")}
+          value={serviceId}
+          items={services}
+          disabled={busy}
+          onChange={(value) => choose({ serviceId: value })}
+        />
+        <ProviderConnectionChoices
+          label={t("region")}
+          value={selected.catalog?.region ?? ""}
+          items={regions.map((region) => ({ value: region, label: t(region) }))}
+          disabled={busy}
+          onChange={(region) => choose({ serviceId, region })}
+        />
+        {!subscription ? (
+          <>
+            <div className="space-y-2">
+              <label htmlFor="provider-setup-url" className="text-ui-base text-foreground-subtle">
+                {intl.formatMessage({ id: "settings.modelProvider.baseUrl" })}
+              </label>
+              <Input
+                id="provider-setup-url"
+                size="lg"
+                autoComplete="off"
+                spellCheck={false}
+                value={draft.baseUrl}
+                onChange={(event) => patch({ baseUrl: event.target.value })}
+                placeholder="https://api.example.com/v1"
+              />
+            </div>
+            <ProviderConnectionChoices
+              label={intl.formatMessage({ id: "settings.modelProvider.apiFormat" })}
+              value={draft.api}
+              items={formats.map((format) => ({
+                value: format,
+                label: intl.formatMessage({
+                  id: `settings.modelProvider.apiFormat.title.${format === "anthropic-messages" ? "anthropicMessages" : format === "openai-responses" ? "responses" : "chatCompletions"}`,
+                }),
+              }))}
+              disabled={busy}
+              onChange={(api) => {
+                if (declaredFormats.length > 1)
+                  choose({ serviceId, region: selected.catalog?.region ?? "", api });
+                else patch({ api: api as ProviderApiType });
+              }}
+            />
+            <ProviderApiKeySection
+              apiKeyValue={draft.primary}
+              additionalApiKeys={draft.additional}
+              autoSwitchCredentials={draft.automatic}
+              apiKeyVisible={visible}
+              readOnly={busy}
+              onToggleApiKeyVisibility={() => setVisible(!visible)}
+              onApiKeyChange={(primary) => patch({ primary })}
+              onApiKeyBlur={() => {}}
+              onCredentialsChange={(primary, additional, automatic) =>
+                patch({ primary, additional, automatic })
+              }
+              presetApiKeyUrl={keyUrl ?? undefined}
+              onOpenPresetApiKey={keyUrl ? () => void platform.openExternal(keyUrl) : undefined}
+            />
+          </>
+        ) : (
+          <p className="text-ui-base text-foreground-subtle">{t("subscription")}</p>
+        )}
+      </fieldset>
+      {error || invalid ? (
+        <p role="alert" className="text-ui-base text-destructive">
+          {invalid
+            ? t(custom && !name.trim() ? "invalidName" : "invalid")
+            : intl.formatMessage({ id: "settings.modelProvider.templateCreateFailed" })}
+        </p>
+      ) : null}
+      <div className="flex justify-end gap-2">
+        <Button type="button" variant="secondary" disabled={busy} onClick={onBack}>
+          {intl.formatMessage({ id: "common.cancel" })}
+        </Button>
+        <Button type="button" disabled={busy} onClick={submit}>
+          {t(subscription ? "connect" : "save")}
+        </Button>
+      </div>
+    </section>
+  );
+}
