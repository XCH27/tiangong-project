+import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs.js";
+
+// SettingsSegmentedTabs 的视觉值；连接选项在窄窗口换行，保留原生键盘与选中状态。
+export function ProviderConnectionChoices({
+  label,
+  value,
+  items,
+  disabled,
+  onChange,
+}: {
+  label: string;
+  value: string;
+  items: readonly { value: string; label: string }[];
+  disabled?: boolean;
+  onChange: (value: string) => void;
+}) {
+  if (items.length < 2) return null;
+  return (
+    <div className="space-y-2">
+      <div className="text-ui-base text-foreground-subtle">{label}</div>
+      <Tabs value={value} onValueChange={onChange} className="gap-0">
+        <TabsList
+          aria-label={label}
+          className="flex h-auto max-w-full flex-wrap justify-start rounded-lg bg-surface p-0.5 group-data-horizontal/tabs:h-auto"
+        >
+          {items.map((item) => (
+            <TabsTrigger
+              key={item.value}
+              value={item.value}
+              disabled={disabled}
+              className="h-7 flex-none rounded-md border-transparent bg-transparent px-2.5 text-ui-base font-medium text-foreground-subtle data-active:border-transparent data-active:bg-background data-active:text-foreground data-active:shadow-none dark:data-active:border-transparent dark:data-active:bg-background"
+            >
+              {item.label}
+            </TabsTrigger>
+          ))}
+        </TabsList>
+      </Tabs>
+    </div>
+  );
+}
