@@ -0,0 +1,50 @@
+import {
+  isApiKeyAccess,
+  type ProviderApiType,
+  type ProviderConfigObject,
+  type ProviderSettingsTemplateView,
+} from "@zcode/provider";
+
+export interface ProviderSetupDraft {
+  baseUrl: string;
+  api: ProviderApiType;
+  primary: string;
+  additional: string[];
+  automatic: boolean;
+}
+export function newProviderSetupDraft(template: ProviderSettingsTemplateView): ProviderSetupDraft {
+  return {
+    baseUrl: template.config.api?.baseUrl ?? "",
+    api: template.config.api?.type ?? "openai-chat-completions",
+    primary: "",
+    additional: [],
+    automatic: false,
+  };
+}
+export function providerSetupConfig(
+  template: ProviderSettingsTemplateView,
+  draft: ProviderSetupDraft,
+): ProviderConfigObject | undefined {
+  if (template.config.access?.type === "subscription") return {};
+  if (!isApiKeyAccess(template.config.access)) return undefined;
+  let url: URL;
+  try {
+    url = new URL(draft.baseUrl.trim());
+  } catch {
+    return undefined;
+  }
+  if (!["https:", "http:"].includes(url.protocol) || url.username || url.password) return undefined;
+  const keys = [
+    ...new Set([draft.primary, ...draft.additional].map((key) => key.trim()).filter(Boolean)),
+  ];
+  if (!keys.length || keys.length > 10) return undefined;
+  return {
+    api: { type: draft.api, baseUrl: draft.baseUrl.trim() },
+    access: {
+      type: template.config.access.type,
+      apiKey: keys[0],
+      additionalApiKeys: keys.slice(1),
+      autoSwitchCredentials: draft.automatic && keys.length > 1,
+    },
+  };
+}
diff --git a/packages/ui/src/settings/model-provider-section/providerTemplateCatalog.ts b/packages/ui/src/settings/model-provider-section/providerTemplateCatalog.ts
new file mode 100644
index 0000000..9c96103
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/providerTemplateCatalog.ts
@@ -0,0 +1,78 @@
+import {
+  resolveProviderTemplateName,
+  type ProviderSettingsTemplateView,
+  type ProviderTemplateLocale,
+} from "@zcode/provider";
+
+export interface ProviderVendor {
+  id: string;
+  label: string;
+  templates: ProviderSettingsTemplateView[];
+}
+
+export function groupProviderTemplates(
+  templates: readonly ProviderSettingsTemplateView[],
+  locale: ProviderTemplateLocale,
+  query = "",
+): ProviderVendor[] {
+  const groups = new Map<string, ProviderVendor>();
+  for (const template of templates) {
+    const catalog = template.catalog;
+    // 未声明品牌的旧模板保留独立入口，不按名称、端点或图标碰撞合并。
+    const id = catalog ? `vendor:${catalog.vendorId}` : `template:${template.templateId}`;
+    const label = resolveProviderTemplateName(
+      template.templateId,
+      { templateNameMap: catalog?.vendorNameMap ?? template.templateNameMap },
+      locale,
+    );
+    const group = groups.get(id) ?? { id, label, templates: [] };
+    group.templates.push(template);
+    groups.set(id, group);
+  }
+  const search = query.trim().toLocaleLowerCase();
+  return [...groups.values()].filter(
+    (group) =>
+      !search ||
+      group.templates.some((template) =>
+        [
+          group.label,
+          template.templateId,
+          ...Object.values(template.templateNameMap),
+          ...Object.values(template.catalog?.vendorNameMap ?? {}),
+          ...Object.values(template.catalog?.serviceNameMap ?? {}),
+        ].some((value) => value?.toLocaleLowerCase().includes(search)),
+      ),
+  );
+}
+
+type RouteChoice = { serviceId?: string; region?: string; api?: string };
+export function selectProviderTemplate(
+  templates: readonly ProviderSettingsTemplateView[],
+  currentId: string,
+  change: RouteChoice,
+): ProviderSettingsTemplateView | undefined {
+  const current = templates.find((template) => template.templateId === currentId);
+  if (!current) return undefined;
+  const dimensions = (template: ProviderSettingsTemplateView) => ({
+    serviceId: template.catalog?.serviceId ?? template.templateId,
+    region: template.catalog?.region ?? "",
+    api: template.config.api?.type ?? "",
+  });
+  const previous = dimensions(current);
+  const candidates = templates.filter((template) => {
+    const values = dimensions(template);
+    return Object.entries(change).every(
+      ([key, value]) => values[key as keyof RouteChoice] === value,
+    );
+  });
+  // 只选目录中确实存在的组合；保留兼容地域/协议，不拼接或猜测新的 URL。
+  const score = (template: ProviderSettingsTemplateView) => {
+    const values = dimensions(template);
+    return (
+      (values.serviceId === previous.serviceId ? 4 : 0) +
+      (values.region === previous.region ? 2 : 0) +
+      (values.api === previous.api ? 1 : 0)
+    );
+  };
+  return candidates.sort((a, b) => score(b) - score(a))[0];
+}
