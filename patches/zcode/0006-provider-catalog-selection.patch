diff --git a/packages/services/test/provider-catalog.test.ts b/packages/services/test/provider-catalog.test.ts
new file mode 100644
index 0000000..518ecf9
--- /dev/null
+++ b/packages/services/test/provider-catalog.test.ts
@@ -0,0 +1,227 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import {
+  newProviderSetupDraft,
+  providerSetupConfig,
+} from "../../ui/src/settings/model-provider-section/providerSetupDraft.js";
+import {
+  parseProviderTemplateMap,
+  ProviderSettingsFacade,
+  type ProviderRegistryFacadeSource,
+} from "@zcode/provider";
+import {
+  groupProviderTemplates,
+  selectProviderTemplate,
+} from "../../ui/src/settings/model-provider-section/providerTemplateCatalog.js";
+
+const builtin = JSON.parse(
+  await readFile(new URL("../../../config/provider/zcode-builtin.json", import.meta.url), "utf8"),
+);
+const map = parseProviderTemplateMap(builtin.config.providerConfigRules.templateRules);
+// Exercise the actual settings projection, so catalog metadata cannot disappear in the host RPC view.
+const facade = new ProviderSettingsFacade({
+  getSnapshot: () => ({
+    registry: { revision: 1 },
+    config: { zcodeBuiltinProviderTemplates: parseProviderTemplateMap(map.toJSON()) },
+    resolution: { registryProviders: [], resolvedProviders: [] },
+    account: { states: {} },
+  }),
+} as unknown as ProviderRegistryFacadeSource);
+const templates = facade.getView().providerTemplates;
+const vendors = groupProviderTemplates(templates, "zh-CN");
+const family = (id: string) => vendors.find((vendor) => vendor.id === `vendor:${id}`)!.templates;
+
+test("registry serialization and settings projection retain every route under one vendor", () => {
+  assert.equal(templates.length, 39);
+  assert.equal(vendors.length, 19);
+  assert.equal(
+    new Set(vendors.flatMap((vendor) => vendor.templates.map((template) => template.templateId)))
+      .size,
+    39,
+  );
+  for (const template of templates) {
+    assert.deepEqual(template.catalog, map.get(template.templateId)?.catalog);
+    assert.deepEqual(template.config, map.get(template.templateId)?.config.toJSON());
+    assert.ok(template.catalog, template.templateId);
+  }
+});
+
+test("all OpenCode services and protocols remain reachable, with no duplicate vendor cards", () => {
+  const routes = family("opencode");
+  assert.equal(routes.length, 6);
+  for (const target of routes) {
+    const selected = selectProviderTemplate(routes, routes[0]!.templateId, {
+      serviceId: target.catalog!.serviceId,
+      api: target.config.api!.type!,
+    });
+    assert.equal(selected?.templateId, target.templateId);
+    assert.deepEqual(selected?.config, target.config);
+  }
+  const zen = selectProviderTemplate(routes, "opencode-go-responses", { serviceId: "zen" });
+  assert.equal(zen?.templateId, "opencode-zen-responses");
+});
+
+test("MiniMax service changes preserve region and choose declared plan endpoints", () => {
+  const routes = family("minimax");
+  const cn = selectProviderTemplate(routes, "minimax", { serviceId: "token" });
+  assert.equal(cn?.templateId, "fleet-minimax-token-plan-cn");
+  const global = selectProviderTemplate(routes, cn!.templateId, {
+    serviceId: "token",
+    region: "global",
+  });
+  assert.equal(global?.templateId, "fleet-minimax-token-plan");
+  assert.notEqual(global?.config.api?.baseUrl, cn?.config.api?.baseUrl);
+  assert.equal(
+    selectProviderTemplate(routes, global!.templateId, { serviceId: "api" })?.templateId,
+    "fleet-minimax",
+  );
+});
+
+test("every declared service, region and protocol combination is reachable without synthesis", () => {
+  for (const vendor of vendors)
+    for (const target of vendor.templates) {
+      const selected = selectProviderTemplate(vendor.templates, vendor.templates[0]!.templateId, {
+        serviceId: target.catalog!.serviceId,
+        region: target.catalog!.region ?? "",
+        api: target.config.api?.type ?? "",
+      });
+      assert.equal(selected?.templateId, target.templateId);
+      assert.equal(selected, target);
+    }
+});
+
+test("API and subscription authentication remain different choices for OpenAI", () => {
+  const routes = family("openai");
+  const subscription = selectProviderTemplate(routes, "openai", { serviceId: "chatgpt" });
+  assert.equal(subscription?.config.access?.type, "subscription");
+  const api = selectProviderTemplate(routes, subscription!.templateId, { serviceId: "api" });
+  assert.equal(api?.templateId, "openai");
+  assert.equal(api?.config.access?.type, "api-key");
+});
+
+test("search matches services and both locales without dropping the rest of a vendor's routes", () => {
+  for (const query of ["ChatGPT", "  CHATGPT  "]) {
+    const matches = groupProviderTemplates(templates, "zh-CN", query);
+    assert.equal(matches.length, 1);
+    assert.equal(matches[0]?.id, "vendor:openai");
+    assert.equal(matches[0]?.templates.length, 2);
+  }
+  assert.equal(groupProviderTemplates(templates, "en-US", "阿里云")[0]?.label, "Alibaba Cloud");
+  assert.equal(groupProviderTemplates(templates, "zh-CN", "SiliconFlow")[0]?.label, "硅基流动");
+  assert.equal(groupProviderTemplates(templates, "zh-CN", "not-a-vendor").length, 0);
+});
+
+test("undeclared legacy templates are never merged by matching name, logo or endpoint", () => {
+  const a = { ...templates[0]!, catalog: undefined, templateId: "first" };
+  const b = { ...a, templateId: "second" };
+  const groups = groupProviderTemplates([a, b], "zh-CN");
+  assert.equal(groups.length, 2);
+  assert.notEqual(groups[0]?.id, groups[1]?.id);
+  assert.equal(groups[0]?.label, groups[1]?.label);
+});
+
+test("missing selections and impossible combinations cannot resolve into another route", () => {
+  assert.equal(
+    selectProviderTemplate(family("minimax"), "removed-template", { region: "cn" }),
+    undefined,
+  );
+  assert.equal(
+    selectProviderTemplate(family("kimi"), "fleet-kimi-coding-global", {
+      serviceId: "api",
+      region: "global",
+    }),
+    undefined,
+  );
+  assert.equal(
+    selectProviderTemplate(family("kimi"), "fleet-kimi-coding-global", { serviceId: "api" })
+      ?.templateId,
+    "moonshot-kimi",
+  );
+  const invalid = { ...templates[0], catalog: { ...templates[0]!.catalog, region: "guessed" } };
+  assert.throws(() => parseProviderTemplateMap([invalid]));
+});
+
+test("setup validates the draft before creation and does not silently accept embedded credentials", () => {
+  const template = family("minimax")[0]!;
+  const draft = newProviderSetupDraft(template);
+  assert.equal(providerSetupConfig(template, draft), undefined);
+  for (const baseUrl of [
+    "",
+    "not-a-url",
+    "file:///tmp/server",
+    "https://user:password@example.test",
+  ]) {
+    assert.equal(
+      providerSetupConfig(template, { ...draft, primary: "synthetic", baseUrl }),
+      undefined,
+    );
+  }
+  assert.equal(
+    providerSetupConfig(template, {
+      ...draft,
+      primary: "synthetic",
+      baseUrl: "http://localhost:1234/v1",
+    })?.api?.baseUrl,
+    "http://localhost:1234/v1",
+  );
+});
+
+test("creation sends only a personal overlay, preserving template ownership and model defaults", () => {
+  const template = family("minimax")[0]!;
+  const draft = {
+    ...newProviderSetupDraft(template),
+    primary: " primary ",
+    additional: ["primary", " backup ", ""],
+    automatic: true,
+  };
+  const config = providerSetupConfig(template, draft)!;
+  assert.deepEqual(config.access, {
+    type: "api-key",
+    apiKey: "primary",
+    additionalApiKeys: ["backup"],
+    autoSwitchCredentials: true,
+  });
+  assert.equal(config.group, undefined);
+  assert.equal(config.builtinModelIds, undefined);
+  assert.equal(draft.primary, " primary ");
+  assert.equal(
+    providerSetupConfig(template, { ...draft, additional: ["primary"] })?.access?.type,
+    "api-key",
+  );
+  assert.equal(
+    (
+      providerSetupConfig(template, { ...draft, additional: ["primary"] })?.access as {
+        autoSwitchCredentials: boolean;
+      }
+    ).autoSwitchCredentials,
+    false,
+  );
+});
+
+test("fresh region and service drafts never inherit another connection's secrets", () => {
+  const cn = family("minimax").find((template) => template.templateId === "minimax")!;
+  const global = family("minimax").find((template) => template.templateId === "fleet-minimax")!;
+  const a = newProviderSetupDraft(cn);
+  a.primary = "synthetic-cn";
+  a.additional.push("synthetic-backup");
+  const b = newProviderSetupDraft(global);
+  assert.equal(b.primary, "");
+  assert.deepEqual(b.additional, []);
+  assert.notEqual(a.baseUrl, b.baseUrl);
+  assert.deepEqual(newProviderSetupDraft(cn).additional, []);
+});
+
+test("subscription setup cannot persist an API key or overridden endpoint into its native adapter", () => {
+  const subscription = family("openai").find(
+    (template) => template.templateId === "fleet-openai-codex",
+  )!;
+  assert.deepEqual(
+    providerSetupConfig(subscription, {
+      ...newProviderSetupDraft(subscription),
+      primary: "must-not-leak",
+      baseUrl: "https://another.example",
+    }),
+    {},
+  );
+});
