diff --git a/apps/zcode-cli/packages/adapters/test/decision-chat.test.ts b/apps/zcode-cli/packages/adapters/test/decision-chat.test.ts
new file mode 100644
index 0000000..b18813a
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/decision-chat.test.ts
@@ -0,0 +1,183 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseModelConfig, parseProviderConfig, decisionModelCandidates } from "@zcode/provider";
+import {
+  NodeProviderRegistryRuntime,
+  NodeModelSelectionConfigRepository,
+  createNodeModelSelectionFacade,
+} from "../../../../../packages/provider-node/src/index.js";
+import { createModelSelectionService } from "../../../../../packages/services/src/model-provider/modelSelectionService.js";
+import { createDecisionModelPort } from "../src/model/decision-model.js";
+import { parseChatDecisionAnswers } from "../src/model/decision-chat.js";
+import { NodeHttpClientAdapter } from "../src/http/index.js";
+
+const choice = {
+  state: "Synthetic evidence",
+  questions: {
+    kind: { type: "choice" as const, instructions: "Pick", criteria: { useful: "Useful", other: "Other" } },
+    rank: { type: "score" as const, instructions: "Rate", criteria: ["low", "mid", "high"] },
+    ok: { type: "bool" as const, instructions: "Is it fine?", criteria: { true: "yes", false: "no" } },
+  },
+};
+const valid = {
+  answers: {
+    kind: { type: "choice", choice: "useful", probabilities: { useful: 0.7, other: 0.3 }, confidence: 0.7 },
+    rank: { type: "score", score: 2, confidence: 0.5 },
+    ok: { type: "bool", probability: 0.9 },
+  },
+};
+
+test("chat decision answers pass only the classifier contract", () => {
+  assert.deepEqual(parseChatDecisionAnswers(choice, "```json\n" + JSON.stringify(valid) + "\n```")?.rank, {
+    type: "score",
+    score: 2,
+    confidence: 0.5,
+  });
+  const broken = (patch: (answers: any) => void) => {
+    const copy = structuredClone(valid);
+    patch(copy.answers);
+    return parseChatDecisionAnswers(choice, JSON.stringify(copy));
+  };
+  assert.equal(broken((a) => (a.kind.choice = "unoffered")), undefined, "unoffered label");
+  assert.equal(broken((a) => (a.kind.probabilities = { useful: 0.7, other: 0.7 })), undefined, "mass not 1");
+  assert.equal(broken((a) => (a.kind.choice = "other")), undefined, "choice not the most probable");
+  assert.equal(broken((a) => delete a.kind.probabilities.other), undefined, "missing label");
+  assert.equal(broken((a) => (a.rank.score = 4)), undefined, "score outside rubric");
+  assert.equal(broken((a) => (a.ok.probability = 1.2)), undefined, "probability outside [0,1]");
+  assert.equal(broken((a) => delete a.ok), undefined, "missing question");
+  assert.equal(parseChatDecisionAnswers(choice, "I think it is useful."), undefined, "prose");
+});
+
+async function fixture(replies: string[]) {
+  const root = await mkdtemp(join(tmpdir(), "fleet-decision-chat-"));
+  const runtime = new NodeProviderRegistryRuntime({
+    personalFilePath: join(root, "personal.json"),
+    zcodeBuiltinFilePath: fileURLToPath(new URL("../../../../../config/provider/zcode-builtin.json", import.meta.url)),
+    personalPollingIntervalMs: false,
+    watch: false,
+  });
+  await runtime.start();
+  const { providerId } = await runtime.configService.createPersonalProvider({
+    initialConfig: parseProviderConfig({
+      api: { type: "openai-chat-completions", baseUrl: "https://api.example.invalid/v1" },
+      access: { type: "api-key", apiKey: "synthetic-only" },
+    }),
+    providerName: "Chat fixture",
+  });
+  for (const modelId of ["small-model", "middle-model", "large-model"])
+    await runtime.configService.addPersonalModel(providerId, modelId, parseModelConfig({}), undefined, true);
+  await runtime.registryService.refresh();
+  const prompts: string[] = [];
+  const port = createDecisionModelPort({
+    registry: {
+      getSnapshot: () => runtime.registryService.getSnapshot(),
+      refresh: (reason) => runtime.registryService.refresh(reason),
+    },
+    http: new NodeHttpClientAdapter({ env: {}, noProxy: "*" }),
+    chatModel: () =>
+      ({
+        async generateText(request: { messages: { content: unknown }[] }) {
+          prompts.push(String(request.messages.at(-1)?.content));
+          return { text: replies.shift() ?? "", finishReason: "stop", usage: { inputTokens: 40, outputTokens: 12 } };
+        },
+      }) as never,
+  });
+  const save = async (patch: Record<string, unknown>) => {
+    const service = createModelSelectionService(
+      createNodeModelSelectionFacade(runtime.registryService),
+      async () => {},
+      new NodeModelSelectionConfigRepository({ personalRepository: runtime.personalRepository }),
+      async () => {
+        await runtime.registryService.refresh();
+      },
+    );
+    try {
+      const view = await service.getView();
+      await service.savePreferences({ expectedRevision: view.preferencesRevision, ...patch } as never);
+      return await service.getView();
+    } finally {
+      service.dispose();
+    }
+  };
+  return {
+    providerId,
+    port,
+    prompts,
+    runtime,
+    save,
+    async close() {
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+test("an ordinary chat model can be the decision model and answers through the same contract", async () => {
+  const f = await fixture([JSON.stringify(valid), "not json"]);
+  try {
+    const candidates = decisionModelCandidates(f.runtime.registryService.getSnapshot());
+    assert.ok(candidates.some((m) => m.modelId === "small-model" && m.lane === "chat"));
+    await f.save({ decisionModelSettings: { enabled: true, selection: { providerId: f.providerId, modelId: "small-model" } } });
+    assert.equal(f.port.isAvailable(), true);
+    const first = await f.port.prepare(choice);
+    const ok = await f.port.classify({ ...choice, binding: first.binding, signal: new AbortController().signal });
+    assert.equal(ok.status, "completed");
+    assert.deepEqual((ok.answers.kind as { choice: string }).choice, "useful");
+    assert.deepEqual(ok.usage, { inputTokens: 40, outputTokens: 12 });
+    const second = await f.port.prepare(choice);
+    const invalid = await f.port.classify({ ...choice, binding: second.binding, signal: new AbortController().signal });
+    assert.equal(invalid.status, "error");
+    assert.deepEqual(invalid.answers, {});
+  } finally {
+    await f.close();
+  }
+});
+
+test("automatic choice moves a new conversation off the standard tier only when the decision says so", async () => {
+  const tierReply = (tier: string) =>
+    JSON.stringify({
+      answers: {
+        tier: {
+          type: "choice",
+          choice: tier,
+          probabilities: { fast: tier === "fast" ? 0.8 : 0.1, standard: 0.1, deep: tier === "deep" ? 0.8 : 0.1 },
+          confidence: 0.8,
+        },
+      },
+    });
+  const f = await fixture([tierReply("deep"), tierReply("fast")]);
+  try {
+    const tiers = {
+      fast: { providerId: f.providerId, modelId: "small-model" },
+      standard: { providerId: f.providerId, modelId: "middle-model" },
+      deep: { providerId: f.providerId, modelId: "large-model" },
+    };
+    const standard = { providerId: f.providerId, modelId: "middle-model" };
+    // Without a decision model the conversation simply stays on the standard tier.
+    const view = await f.save({
+      newConversationModelPolicy: "automatic",
+      decisionModelSettings: { enabled: false, automaticTiers: tiers },
+    });
+    assert.equal(view.preferredSelection?.modelId, "middle-model", "new conversations start on the standard tier");
+    assert.deepEqual(await f.port.automaticModel!({ prompt: "Refactor the whole storage layer", current: standard }), {
+      tier: "standard",
+      reason: "decision-unavailable",
+    });
+    await f.save({
+      decisionModelSettings: { enabled: true, selection: { providerId: f.providerId, modelId: "small-model" }, automaticTiers: tiers },
+    });
+    const deep = await f.port.automaticModel!({ prompt: "Refactor the whole storage layer", current: standard });
+    assert.deepEqual(deep.selection, tiers.deep);
+    assert.match(f.prompts.at(-1)!, /Refactor the whole storage layer/);
+    // A model the user picked by hand is never replaced.
+    assert.deepEqual(await f.port.automaticModel!({ prompt: "hi", current: tiers.deep }), {});
+    const fast = await f.port.automaticModel!({ prompt: "What time zone is UTC+8?", current: standard });
+    assert.deepEqual(fast.selection, tiers.fast);
+  } finally {
+    await f.close();
+  }
+});
