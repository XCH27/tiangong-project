 }
+
+/**
+ * Ordinary chat models usable as decision models: they answer the same questions in validated JSON
+ * (what Claude Code and Cursor do with a small model). API and plan routes come first; official CLIs
+ * follow, since each decision starts a CLI session and is slower (callers keep their own deadline).
+ */
+export function chatDecisionModels(
+  snapshot: ProviderRegistryServiceSnapshot | null,
+): DecisionModelCandidate[] {
+  return (
+    snapshot?.resolution.resolvedProviders.flatMap((provider) => {
+      const access = provider.config.access;
+      if (!provider.enabled || provider.providerIssues.length || !access) return [];
+      return provider.models.flatMap((model) => {
+        if (!model.executable || model.config.properties?.outputFormat?.supportsText === false) return [];
+        const contextWindow = model.evidenceConfig?.properties?.contextWindow;
+        return [
+          {
+            providerId: provider.providerId,
+            providerName: provider.providerName?.trim() || provider.providerId,
+            modelId: model.modelId,
+            ...(typeof contextWindow === "number" ? { contextWindow } : {}),
+            lane: "chat" as const,
+          },
+        ];
+      });
+    }) ?? []
+  );
+}
+
+/** Every decision model a user can choose: dedicated classifiers first, then chat models. */
+export function decisionModelCandidates(
+  snapshot: ProviderRegistryServiceSnapshot | null,
+): DecisionModelCandidate[] {
+  const classifiers = classifierModels(snapshot);
+  const taken = new Set(classifiers.map((model) => `${model.providerId}\n${model.modelId}`));
+  const chat = chatDecisionModels(snapshot).filter((model) => !taken.has(`${model.providerId}\n${model.modelId}`));
+  const cli = new Set(
+    snapshot?.resolution.resolvedProviders
+      .filter((provider) => provider.config.access?.type === "native-cli")
+      .map((provider) => provider.providerId),
+  );
+  return [...classifiers, ...chat.filter((model) => !cli.has(model.providerId)), ...chat.filter((model) => cli.has(model.providerId))];
+}
