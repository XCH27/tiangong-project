@@ -0,0 +1,72 @@
+import type { AutomaticModelTiers as Tiers, DecisionModelSettings } from "@zcode/shared";
+import type { ModelSelectionView } from "@zcode/services";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { selectTriggerVariants } from "@/components/ui/select.js";
+import { SettingsRow } from "@/settings/SettingsPageParts.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { encodeCustomModelValue } from "@/lib/zcodeCustomModelValue.js";
+import { parseModelPickerValue } from "@/lib/zcodeSessionProjection.js";
+
+const TIERS = ["fast", "standard", "deep"] as const;
+
+/**
+ * The three models automatic choice picks between. A new conversation starts on the standard tier;
+ * the decision model moves its first turn to fast or deep only when warranted.
+ */
+export function AutomaticModelTiers({
+  view,
+  groups,
+  pending,
+  onChange,
+}: {
+  view: ModelSelectionView | null;
+  groups: Parameters<typeof ModelConfigSelect>[0]["modelGroups"];
+  pending: boolean;
+  onChange(settings: DecisionModelSettings): void | Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const decision = view?.decisionModelSettings ?? { enabled: false };
+  const tiers: Tiers = decision.automaticTiers ?? {};
+  return (
+    <>
+      {TIERS.map((tier) => {
+        const selection = tiers[tier];
+        const label = intl.formatMessage({ id: `settings.modelDefaults.tier.${tier}` });
+        return (
+          <SettingsRow
+            key={tier}
+            label={label}
+            description={tier === "standard" ? intl.formatMessage({ id: "settings.modelDefaults.tier.hint" }) : undefined}
+            control={
+              <ModelConfigSelect
+                modelGroups={groups}
+                triggerTestId={`model-tier-${tier}`}
+                normalizedValue={selection ? encodeCustomModelValue(selection.providerId, selection.modelId) : "none"}
+                triggerLabel={selection?.modelId ?? intl.formatMessage({ id: "settings.modelDefaults.tier.none" })}
+                tooltipTitle={label}
+                accessibleLabel={selection ? `${selection.providerId}/${selection.modelId}` : label}
+                leadingItems={[{ key: "none", value: "none", name: intl.formatMessage({ id: "settings.modelDefaults.tier.none" }) }]}
+                showManageModelsAction={false}
+                focusSelectorOnClose={null}
+                footerActions={[]}
+                labelVisibilityClassName="inline-flex"
+                disabled={pending || !view?.preferencesRevision}
+                lockReasonMessage=""
+                isItemLocked={() => false}
+                triggerIcon={<></>}
+                triggerClassName={selectTriggerVariants({ size: "lg", className: "min-w-0 w-64 max-w-full" })}
+                onValueChange={(value) => {
+                  const picked = value === "none" ? undefined : parseModelPickerValue(value);
+                  const next: Tiers = { ...tiers };
+                  if (picked) next[tier] = { providerId: picked.providerId, modelId: picked.modelId };
+                  else delete next[tier];
+                  void onChange({ ...decision, automaticTiers: next });
+                }}
+              />
+            }
+          />
+        );
+      })}
+    </>
+  );
+}
