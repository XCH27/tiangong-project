@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { routeAutomaticModel } from "../src/runtime/methods/turn-model.js";
+
+function runtime(history: unknown[], decide: () => Promise<unknown>) {
+  return {
+    sessionId: "s",
+    sessionStore: { messages: async () => history },
+    decisionModelPort: { automaticModel: decide },
+    logger: { info() {}, warn() {} },
+  } as never;
+}
+const intent = { modelSelection: { providerId: "p", modelId: "middle-model" } } as never;
+
+test("automatic choice routes only the first turn and keeps the offered model on failure", async () => {
+  const deep = async () => ({ selection: { providerId: "p", modelId: "large-model" }, tier: "deep", reason: "decision" });
+  const first = await routeAutomaticModel(runtime([], deep), intent, "Plan a migration");
+  assert.equal(first.changed, true);
+  assert.equal((first.intent as any).modelSelection.modelId, "large-model");
+  const later = await routeAutomaticModel(runtime([{ role: "user" }], deep), intent, "next");
+  assert.equal(later.changed, false, "later turns never switch automatically");
+  const failing = await routeAutomaticModel(runtime([], async () => { throw new Error("offline"); }), intent, "x");
+  assert.deepEqual(failing, { intent, changed: false });
+  const stay = await routeAutomaticModel(runtime([], async () => ({ tier: "standard" })), intent, "x");
+  assert.equal(stay.changed, false);
+});
