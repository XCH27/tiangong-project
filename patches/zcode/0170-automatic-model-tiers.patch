+      event: "model.automatic_choice",
+      module: "core.runtime",
+      tier: decided.tier,
+      reason: decided.reason,
+      switched: Boolean(decided.selection),
+    });
+    if (!decided.selection) return { intent, changed: false };
+    const next: ModelSelection = { providerId: decided.selection.providerId, modelId: decided.selection.modelId } as ModelSelection;
+    if (sameModelSelection(current, next)) return { intent, changed: false };
+    return { intent: { ...intent, modelSelection: next }, changed: true };
+  } catch (error) {
+    runtime.logger?.warn("Automatic model choice failed; keeping the offered model", {
+      event: "model.automatic_choice_failed",
+      module: "core.runtime",
+      error: error instanceof Error ? error.message : String(error),
+    });
+    return { intent, changed: false };
+  }
