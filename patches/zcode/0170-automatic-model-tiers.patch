+/**
+ * Automatic model choice (decision settings): on a new conversation's first turn the decision model
+ * may move the conversation from the standard tier to the fast or deep tier, once. Later turns never
+ * switch automatically, so prompt caches and native sessions stay intact. Any failure keeps the
+ * offered model.
+ */
+export async function routeAutomaticModel(
+  runtime: AgentRuntimeInternal,
+  intent: TurnInputIntentMetadata | undefined,
+  prompt: string,
+): Promise<{ intent: TurnInputIntentMetadata | undefined; changed: boolean }> {
+  const current = intent?.modelSelection;
+  const port = runtime.decisionModelPort;
+  if (!current || !port?.automaticModel || !prompt.trim()) return { intent, changed: false };
+  try {
+    const history = await runtime.sessionStore?.messages?.({ sessionID: runtime.sessionId });
+    if (history?.length) return { intent, changed: false };
+    const decided = await port.automaticModel(
+      { prompt, current: { providerId: current.providerId, modelId: current.modelId } },
+      AbortSignal.timeout(12000),
+    );
