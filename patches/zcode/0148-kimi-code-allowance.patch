+function kimiCounts(detail: Record<string, unknown> | undefined) {
+  const limit = finite(detail?.limit);
+  if (limit === undefined || limit <= 0) return undefined;
+  const used = finite(detail?.used);
+  if (used !== undefined && used >= 0) return { used, limit };
+  const remaining = finite(detail?.remaining);
+  return remaining !== undefined && remaining >= 0 && remaining <= limit
+    ? { used: limit - remaining, limit }
+    : undefined;
+}
+function kimiReset(value: unknown): number | undefined {
+  const parsed = typeof value === "string" ? Date.parse(value) : NaN;
+  return Number.isFinite(parsed) ? parsed : undefined;
+}
+function kimiWindowMinutes(window: Record<string, unknown> | undefined): number | undefined {
+  const duration = finite(window?.duration);
+  if (duration === undefined || duration <= 0) return undefined;
+  const unit = String(window?.timeUnit ?? "").toUpperCase();
+  return unit.includes("DAY") ? duration * 1440 : unit.includes("HOUR") ? duration * 60 : unit.includes("MINUTE") ? duration : undefined;
+}
+
+/**
+ * Kimi Code `/coding/v1/usages`（官方 kimi-code packages/oauth/src/managed-usage.ts、CodexBar）：
+ * 优先 usages.limit_5h/limit_7d/limit_month_total 的 used_ratio；旧响应的 usage（每周）与
+ * limits[]（短窗口）计数作回退。比例为 0 而计数显示已使用时，按 CodexBar 视为占位值、改用计数。
+ */
+export function parseKimiCodeUsage(payload: unknown, observedAt: number): SubscriptionUsageResult {
+  const body = record(payload);
+  const pools = record(body?.usages);
+  const weeklyDetail = record(body?.usage);
+  const firstLimit = record(Array.isArray(body?.limits) ? body.limits[0] : undefined);
+  const sessionDetail = record(firstLimit?.detail);
+  const counted = (detail: Record<string, unknown> | undefined) => {
+    const counts = kimiCounts(detail);
+    return counts ? clampPercent((counts.used / counts.limit) * 100) : undefined;
+  };
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const [key, name, minutes] of KIMI_POOLS) {
+    const pool = record(pools?.[key]);
+    const ratio = finite(pool?.used_ratio);
+    const detail = name === "weekly" ? weeklyDetail : name === "session" ? sessionDetail : undefined;
+    const fallback = counted(detail);
+    const placeholder = ratio === 0 && !pools?.limit_month_total && (fallback ?? 0) > 0;
+    const fromRatio = ratio !== undefined && ratio >= 0 && !placeholder;
+    const usedPercent = fromRatio ? Math.min(1, ratio) * 100 : fallback;
+    if (usedPercent === undefined) continue;
+    const reset = kimiReset(
+      fromRatio ? pool?.reset_time : (detail?.resetTime ?? detail?.reset_time ?? detail?.resetAt),
+    );
+    // 计数回退时，短窗口的时长以响应里 limits[0].window 为准。
+    const windowMinutes =
+      !fromRatio && name === "session" ? (kimiWindowMinutes(record(firstLimit?.window)) ?? minutes) : minutes;
+    windows.push({ id: `default:${name}`, usedPercent, windowMinutes, ...(reset ? { resetAt: reset } : {}) });
+  }
+  return windows.length
+    ? { status: "available", source: "Kimi Code", observedAt, windows }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+/** CodexBar codeAPIUsageEndpoint：…/coding → …/coding/v1/usages。 */
+function kimiUsageUrl(baseUrl: string): string {
+  const url = new URL(baseUrl);
+  const path = url.pathname.replace(/\/+$/u, "");
+  return `${url.origin}${path.endsWith("/coding/v1") ? path : path.endsWith("/coding") ? `${path}/v1` : "/coding/v1"}/usages`;
+}
