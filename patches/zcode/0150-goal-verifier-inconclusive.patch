diff --git a/apps/zcode-cli/packages/core/test/goal-verification.test.ts b/apps/zcode-cli/packages/core/test/goal-verification.test.ts
new file mode 100644
index 0000000..3a1e299
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/goal-verification.test.ts
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import { verifyActiveTargetCompletionForContinuation } from "../src/runtime/methods/target-completion-verification.js";
+import { shouldAutoDrainV4QueueHead } from "../../bootstrap/src/zcode-protocol-v4/queue-auto-drain.js";
+
+const session = "session" as never;
+
+test("an unreadable verifier result pauses the Goal instead of completing it (K-05)", async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(() => reply("main reply"));
+    await f.runtime.executeTurn("Initialize local goal fixture");
+    const runtime = f.runtime as never as { rootTraceContext: unknown };
+    const target = await f.store.setTarget({ sessionID: session, objective: "Unfinished synthetic deliverable" });
+    f.steps.push(() => reply("malformed verifier output"));
+    const result = await verifyActiveTargetCompletionForContinuation.call(runtime as never, {
+      target,
+      traceContext: runtime.rootTraceContext as never,
+    });
+    assert.equal(result?.verification.passed, false);
+    assert.equal(result?.target.status, "paused");
+    await f.reopen();
+    assert.equal((await f.store.readTarget({ sessionID: session }))?.status, "paused");
+  } finally {
+    await f.close();
+  }
+});
+
+test("a late pass for a replaced Goal does not complete the new Goal", async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(() => reply("main reply"));
+    await f.runtime.executeTurn("Initialize local goal fixture");
+    const runtime = f.runtime as never as { rootTraceContext: unknown };
+    const old = await f.store.setTarget({ sessionID: session, objective: "Old goal", status: "active" });
+    const received = Promise.withResolvers<void>();
+    const answer = Promise.withResolvers<ReturnType<typeof reply>>();
+    f.steps.push(() => {
+      received.resolve();
+      return answer.promise;
+    });
+    const pending = verifyActiveTargetCompletionForContinuation.call(runtime as never, {
+      target: old,
+      traceContext: runtime.rootTraceContext as never,
+    });
+    await received.promise;
+    await f.store.setTarget({ sessionID: session, objective: "A different new goal", status: "active" });
+    answer.resolve(reply('{"passed":true,"reason":"Old goal reviewed"}'));
+    await pending;
+    const now = await f.store.readTarget({ sessionID: session });
+    assert.equal(now?.objective, "A different new goal");
+    assert.equal(now?.status, "active");
+  } finally {
+    await f.close();
+  }
+});
+
+test("a paused Goal no longer holds ordinary queued input; Stop keeps its own hold", () => {
+  const base = { dispatchState: "queued" as const, sessionBusy: false };
+  assert.equal(shouldAutoDrainV4QueueHead({ ...base, autoDrain: true, targetStatus: "active" }), false);
+  assert.equal(shouldAutoDrainV4QueueHead({ ...base, autoDrain: true, targetStatus: "paused" }), true);
+  assert.equal(shouldAutoDrainV4QueueHead({ ...base, autoDrain: false, targetStatus: "paused" }), false);
+});
