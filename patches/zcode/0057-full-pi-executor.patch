diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn-message.ts b/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn-message.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e358f5bcfc286058afcbdca3e1c4cd5affaf4a21
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn-message.ts
@@ -0,0 +1,105 @@
+import type {
+  AssistantMessage,
+  Model as PiModel,
+  Usage,
+  TextContent,
+  ImageContent,
+} from "@earendil-works/pi-ai";
+import type { Model, ModelMessageContent } from "../deps.js";
+import type { RuntimeModelTextResult } from "../types.js";
+
+/** Pi is the loop executor. The Host model port owns route, auth, effort/Fast and actual prices. */
+export function piHostModel(model: Model): PiModel<string> {
+  return {
+    id: String(model.modelId),
+    name: String(model.modelId),
+    provider: String(model.providerId),
+    api: "fleet-host",
+    baseUrl: "https://fleet.invalid/host-managed",
+    reasoning: model.optionSpecs.reasoningLevel.values.some(
+      (level) => level !== "off" && level !== "auto",
+    ),
+    input: ["text"],
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    contextWindow: model.properties.contextWindow,
+    maxTokens: model.optionSpecs.maxOutputTokens.max,
+  };
+}
+
+export function piHostMessage(
+  model: Model,
+  result: RuntimeModelTextResult | undefined,
+  error?: unknown,
+): AssistantMessage {
+  const usage = result?.usage;
+  const cacheRead = usage?.cacheReadTokens ?? 0;
+  const cacheWrite = usage?.cacheWriteTokens ?? 0;
+  const nativeUsage: Usage = {
+    input: Math.max(0, (usage?.inputTokens ?? 0) - cacheRead - cacheWrite),
+    output: usage?.outputTokens ?? 0,
+    cacheRead,
+    cacheWrite,
+    totalTokens: usage?.totalTokens ?? (usage?.inputTokens ?? 0) + (usage?.outputTokens ?? 0),
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+  };
+  const content: AssistantMessage["content"] = [];
+  for (const block of result?.reasoning ?? []) {
+    if (block.text) content.push({ type: "thinking", thinking: block.text });
+  }
+  if (result?.text) content.push({ type: "text", text: result.text });
+  for (const call of result?.toolCalls ?? []) {
+    content.push({
+      type: "toolCall",
+      id: call.id,
+      name: call.name,
+      arguments: (typeof call.input === "object" &&
+      call.input !== null &&
+      !Array.isArray(call.input)
+        ? call.input
+        : { value: call.input }) as Extract<
+        AssistantMessage["content"][number],
+        { type: "toolCall" }
+      >["arguments"],
+    });
+  }
+  return {
+    role: "assistant",
+    content,
+    api: "fleet-host",
+    provider: String(model.providerId),
+    model: String(model.modelId),
+    timestamp: Date.now(),
+    usage: nativeUsage,
+    stopReason:
+      error !== undefined
+        ? "error"
+        : result?.toolCalls?.length
+          ? "toolUse"
+          : result?.finishReason === "length"
+            ? "length"
+            : "stop",
+    ...(error !== undefined
+      ? { errorMessage: error instanceof Error ? error.message : String(error) }
+      : {}),
+  };
+}
+
+/** Private SDK outcome projection; provider-visible media still uses the existing Host codec. */
+export function piToolContent(content: ModelMessageContent): Array<TextContent | ImageContent> {
+  if (typeof content === "string") return [{ type: "text" as const, text: content }];
+  return content.flatMap((block): Array<TextContent | ImageContent> => {
+    if (block.type === "text") return [{ type: "text" as const, text: block.text }];
+    if (block.type === "image") {
+      const data = /^data:([^;,]+);base64,([\s\S]+)$/.exec(block.dataUrl);
+      if (data) return [{ type: "image" as const, mimeType: data[1]!, data: data[2]! }];
+    }
+    return [
+      {
+        type: "text" as const,
+        text:
+          ("source" in block ? block.source?.placeholder : undefined) ??
+          "Media retained by the Fleet artifact owner",
+      },
+    ];
+  });
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn.ts b/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e51f8060b1ce5bf9da1e762b936aa10d6083a75d
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/pi-turn.ts
@@ -0,0 +1,253 @@
+import { createAssistantMessageEventStream } from "@earendil-works/pi-ai";
+import {
+  createAgentSession,
+  DefaultResourceLoader,
+  SessionManager,
+  SettingsManager,
+  type AgentSession,
+  type ExtensionAPI,
+  type ModelRuntime,
+  type ToolDefinition,
+} from "@earendil-works/pi-coding-agent";
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { RegularTurnLoopState } from "./turn-loop-state.js";
+import type { ToolExecutionResult } from "../deps.js";
+import {
+  throwIfTurnAborted,
+  modelContentForToolResult,
+  isErrorForToolResult,
+} from "../helpers/index.js";
+import { prepareRegularModelStep } from "./turn-step-prepare.js";
+import {
+  runModelBackedTurnStep,
+  type ExternalModelTools,
+  type ModelStepResult,
+  type ModelStepRequestOptions,
+} from "./turn-model-step.js";
+import { executeToolCallsForModelStep } from "./turn-tools.js";
+import { piHostMessage, piHostModel, piToolContent } from "./pi-turn-message.js";
+import type { RuntimeModelTextResult } from "../types.js";
+
+/** One full AgentSession owns the model/tool loop for one admitted input in the existing CLI process.
+ * Host preparation, retries, compaction, artifacts and durable events retain their existing owners.
+ * Native SDK state is private/in-memory; restart is hydrated by the existing canonical Session store.
+ */
+export async function runPiTurn(
+  runtime: AgentRuntimeInternal,
+  state: RegularTurnLoopState,
+): Promise<void> {
+  let prepared: ModelStepRequestOptions | undefined = await prepareRegularModelStep(runtime, state);
+  let pending: ExternalModelTools | undefined;
+  let batch: Promise<void> | undefined;
+  let results = new Map<string, ToolExecutionResult>();
+  let outcome: ModelStepResult = "continue";
+  let failure: unknown;
+  let failed = false;
+  let session: AgentSession | undefined;
+  let extension: ExtensionAPI | undefined;
+  const registered = new Set<string>();
+  const pendingStep = (): ExternalModelTools | undefined => pending;
+  const hostOutcome = (): ModelStepResult => outcome;
+
+  const executeBatch = () => {
+    if (!pending) return Promise.reject(new Error("Pi tool call has no admitted Host model step"));
+    if (!batch) {
+      const step = pending;
+      batch = (async () => {
+        outcome = await executeToolCallsForModelStep.call(runtime, state, {
+          ...step,
+          onResults: (values) => {
+            results = new Map(values.map((value) => [value.toolCallId, value]));
+          },
+        });
+        if (
+          session &&
+          (session.model?.id !== String(state.model.modelId) ||
+            session.model?.provider !== String(state.model.providerId))
+        ) {
+          await session.setModel(piHostModel(state.model));
+        }
+        if (outcome === "break") void session?.abort();
+      })().catch((error) => {
+        failed = true;
+        failure = error;
+        throw error;
+      });
+      // A rejected native call reports its error through Pi; keep the Host cause for the terminal result.
+      void batch.catch(() => {});
+    }
+    return batch;
+  };
+  const definition = (name: string): ToolDefinition => ({
+    name,
+    label: name,
+    description:
+      "Execute the admitted Fleet tool through its Host permission and persistence path.",
+    // Provider schemas come from prepared.tools. The Host executor validates the actual captured input.
+    parameters: { type: "object", additionalProperties: true } as ToolDefinition["parameters"],
+    async execute(id) {
+      await executeBatch();
+      const result = results.get(id);
+      if (!result) throw new Error("Pi tool result does not match the admitted Host call");
+      if (isErrorForToolResult(result)) {
+        const content = modelContentForToolResult(result);
+        throw new Error(
+          typeof content === "string" ? content : (result.error?.message ?? "Fleet tool failed"),
+        );
+      }
+      return {
+        content: piToolContent(modelContentForToolResult(result)),
+        details: { hostToolCallId: id },
+      };
+    },
+  });
+  const register = (names: readonly string[]) => {
+    for (const name of names) {
+      if (registered.has(name)) continue;
+      extension?.registerTool(definition(name));
+      registered.add(name);
+    }
+  };
+  const settings = SettingsManager.inMemory({
+    retry: { enabled: false },
+    compaction: { enabled: false },
+    packages: [],
+    extensions: [],
+    skills: [],
+    themes: [],
+  });
+  const loader = new DefaultResourceLoader({
+    cwd: runtime.workingDirectory,
+    agentDir: runtime.modelIoDir ?? runtime.workingDirectory,
+    settingsManager: settings,
+    noExtensions: true,
+    noSkills: true,
+    noPromptTemplates: true,
+    noThemes: true,
+    noContextFiles: true,
+    systemPrompt: "",
+    extensionFactories: [
+      (api) => {
+        extension = api;
+        register(runtime.registry.list());
+        api.on("agent_before_settle", () => {
+          if (failed || state.turnAbortSignal.aborted || outcome === "break") return;
+          return {
+            continue: true,
+            entries: [
+              {
+                type: "custom_message" as const,
+                customType: "fleet.hostContinuation",
+                content: "Continue the admitted operation at its next Host boundary.",
+                display: false,
+              },
+            ],
+          };
+        });
+      },
+    ],
+  });
+  await loader.reload();
+  const streamSimple: ModelRuntime["streamSimple"] = () => {
+    const stream = createAssistantMessageEventStream();
+    void (async () => {
+      try {
+        if (batch) await batch;
+        throwIfTurnAborted(state.turnAbortSignal);
+        if (outcome === "break") throw new Error("Host run already completed");
+        batch = undefined;
+        pending = undefined;
+        results = new Map();
+        prepared ??= await prepareRegularModelStep(runtime, state);
+        register(runtime.registry.list());
+        session?.setActiveToolsByName([...registered]);
+        let result: RuntimeModelTextResult | undefined;
+        const requestModel = state.model;
+        outcome = await runModelBackedTurnStep.call(runtime, state, {
+          ...prepared,
+          onResult: (value) => {
+            result = value;
+          },
+          externalToolExecution: (step) => {
+            pending = step;
+          },
+        });
+        prepared = undefined;
+        if (
+          session &&
+          (session.model?.id !== String(state.model.modelId) ||
+            session.model?.provider !== String(state.model.providerId))
+        ) {
+          await session.setModel(piHostModel(state.model));
+        }
+        // Register unexpected names as routed calls too: the existing executor owns registry-miss errors.
+        register(pendingStep()?.toolCalls.map((call) => call.name) ?? []);
+        session?.setActiveToolsByName([...registered]);
+        const message = piHostMessage(requestModel, result);
+        stream.push({ type: "start", partial: { ...message, content: [], stopReason: "pending" } });
+        stream.push({
+          type: "done",
+          reason: message.stopReason as "stop" | "toolUse" | "length",
+          message,
+        });
+      } catch (error) {
+        if (outcome !== "break") {
+          failed = true;
+          failure = error;
+        }
+        const message = piHostMessage(state.model, undefined, error);
+        stream.push({ type: "error", reason: "error", error: message });
+      }
+    })();
+    return stream;
+  };
+  const modelRuntime = {
+    hasConfiguredAuth: () => true,
+    checkAuth: async () => ({}),
+    getModel: () => piHostModel(state.model),
+    getAvailableSnapshot: () => [piHostModel(state.model)],
+    getModels: () => [piHostModel(state.model)],
+    getError: () => undefined,
+    streamSimple,
+  } as unknown as ModelRuntime;
+  const created = await createAgentSession({
+    cwd: runtime.workingDirectory,
+    model: piHostModel(state.model),
+    modelRuntime,
+    sessionManager: SessionManager.inMemory(runtime.workingDirectory),
+    settingsManager: settings,
+    resourceLoader: loader,
+    noTools: "builtin",
+  });
+  session = created.session;
+  await session.bindExtensions({});
+  const unsubscribe = session.subscribe((event) => {
+    // A newly discovered/invalid name may be rejected by Pi before its handler. The Host still
+    // closes that admitted batch, so canonical tool outcomes and turn phases cannot be left open.
+    if (
+      event.type === "tool_execution_end" &&
+      !batch &&
+      pendingStep()?.toolCalls.some((call) => call.id === event.toolCallId)
+    ) {
+      void executeBatch().catch(() => {});
+    }
+  });
+  const onAbort = () => {
+    void session?.abort();
