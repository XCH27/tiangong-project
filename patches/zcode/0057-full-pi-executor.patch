+    if (failed) throw failure;
+    throwIfTurnAborted(state.turnAbortSignal);
+    if (hostOutcome() !== "break")
+      throw new Error("Pi settled before the admitted Host turn completed");
+  } finally {
+    state.turnAbortSignal.removeEventListener("abort", onAbort);
+    unsubscribe();
+    await session.abort();
+    session.dispose();
+  }
+}
