+});
+
+test(
+  "changing the Session selection cannot change a running Pi input",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    try {
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("step", [call("bound", "yes")]);
+        },
+        () => reply("first done"),
+      );
+      const running = f.runtime.executeTurn("First input");
+      await entered.promise;
+      f.runtime.setSessionModelSelection(selection("model-b"));
+      release.resolve();
+      await running;
+      assert.deepEqual(
+        f.requests.map((request) => request.selection.modelId),
+        ["model-a", "model-a"],
+      );
+      f.steps.push(() => reply("second done"));
+      await f.runtime.executeTurn("Second input");
+      assert.deepEqual(
+        f.requests.map((request) => request.selection.modelId),
+        ["model-a", "model-a", "model-b"],
+      );
+    } finally {
+      release.resolve();
+      await f.close();
+    }
+  },
+);
+
+test(
+  "Pi cancellation is a cancelled Host turn, never successful completion",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    const entered = Promise.withResolvers<void>();
+    const controller = new AbortController();
+    try {
+      f.steps.push(async (request) => {
+        entered.resolve();
+        await new Promise((_, reject) =>
+          request.abortSignal.addEventListener(
+            "abort",
+            () => reject(new Error("cancelled request")),
+            { once: true },
+          ),
+        );
+        return reply("must not complete");
+      });
+      const running = f.runtime.executeTurn("Stop this input", undefined, {
+        abortSignal: controller.signal,
+      });
+      await entered.promise;
+      controller.abort(new Error("user stop"));
+      await assert.rejects(running);
+      assert.equal(f.effects, 0);
+      const messages = await f.store.messages({ sessionID: "session" as never });
+      assert.ok(
+        messages.some((message) => message.info.role === "assistant" && "error" in message.info),
+      );
+    } finally {
+      controller.abort();
+      await f.close();
+    }
+  },
+);
+
+test(
+  "streaming responses and attachments keep the Host media and usage paths",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    try {
+      const image = join(f.dir, "fixture.png");
+      await writeFile(
+        image,
+        Buffer.from(
+          "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aWQAAAABJRU5ErkJggg==",
+          "base64",
+        ),
+      );
+      f.steps.push(
+        (request) => {
+          assert.ok(
+            request.messages.some(
+              (message: any) =>
+                Array.isArray(message.content) &&
+                message.content.some((block: any) => block.type === "image"),
+            ),
+          );
+          return reply("streamed working", [call("streamed", "once")]);
+        },
+        () => reply("streamed complete"),
+      );
+      const result = await f.runtime.executeTurn("Read this image", [
+        {
+          type: "image",
+          content: `data:image/png;base64,${(await readFile(image)).toString("base64")}`,
+          mimeType: "image/png",
+        },
+      ]);
+      assert.equal(result.response, "streamed complete");
+      assert.equal(f.effects, 1);
+      const rows = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(rows.totals.modelRequestCount, 2);
+      assert.equal(rows.toolTotals.toolCallCount, 1);
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "Pi keeps the admitted subscription account across tool rounds and refreshes each attempt",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    try {
+      f.enableSubscription();
+      f.selectAccount("account-b");
+      f.steps.push(
+        () => reply("working", [call("bound-account", "saved")]),
+        () => reply("complete"),
+      );
+      await f.runtime.executeTurn("Use the admitted account", undefined, {
+        intent: {
+          modelSelection: selection(),
+          subscriptionAccountId: "account-a",
+        },
+      } as never);
+      assert.deepEqual(f.accounts, ["account-a", "account-a"]);
+      f.steps.push(() => reply("next account"));
+      await f.runtime.executeTurn("Next input");
+      assert.deepEqual(f.accounts, ["account-a", "account-a", "account-b"]);
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test("Host output-limit continuation survives Pi settlement", { timeout: 10000 }, async () => {
+  const f = await fixture("pi", true);
+  try {
+    f.steps.push(
+      () => ({
+        ...reply("partial reply"),
+        finishReason: "length",
+        usage: { ...usage, outputTokens: 4096, totalTokens: 4196 },
+      }),
+      (request) => {
+        assert.ok(JSON.stringify(request.messages).includes("partial reply"));
+        return reply("continuation complete");
+      },
+    );
+    const result = await f.runtime.executeTurn("Finish the answer");
+    assert.ok(result.response.includes("continuation complete"));
+    assert.equal(f.requests.length, 2);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
