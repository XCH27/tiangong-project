diff --git a/apps/zcode-cli/packages/core/test/pi-turn-integration.test.ts b/apps/zcode-cli/packages/core/test/pi-turn-integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..14df3c54e2438e07a25d029d323fb1f583c93297
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/pi-turn-integration.test.ts
@@ -0,0 +1,575 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { DatabaseSync } from "node:sqlite";
+import {
+  createInMemorySessionEventStore,
+  getCurrentModelInvocationContext,
+} from "@zcode/contracts";
+import { AgentRuntime } from "../src/runtime/agent-runtime.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+
+type Step = (request: any, selection: any) => unknown | Promise<unknown>;
+const usage = {
+  inputTokens: 100,
+  outputTokens: 10,
+  totalTokens: 110,
+  cacheReadTokens: 20,
+  cacheWriteTokens: 0,
+};
+const selection = (id = "model-a") => ({
+  providerId: "fixture",
+  modelId: id,
+  options: { reasoningLevel: "off" },
+});
+const reply = (text: string, toolCalls?: any[]) => ({
+  text,
+  toolCalls,
+  finishReason: toolCalls?.length ? "tool-calls" : "stop",
+  usage,
+});
+const call = (id: string, value: string) => ({ id, name: "Probe", input: { value } });
+
+async function fixture(executor?: "pi" | "zcode", streaming = false) {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-pi-turn-"));
+  const path = join(dir, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath: path });
+  let runtime: AgentRuntime;
+  const steps: Step[] = [];
+  const requests: Array<{ messages: any[]; tools: string[]; selection: any }> = [];
+  let decision = "allow";
+  let effects = 0;
+  let subscription = false;
+  let selectedAccount = "account-a";
+  const accounts: string[] = [];
+  let permissionCalls = 0;
+  const factory = ({ selection: selected }: any): any => {
+    const model = {
+      providerId: selected.providerId,
+      modelId: selected.modelId,
+      options: selected.options,
+      properties: {
+        contextWindow: 1000000,
+        requiresMfjsToolSchema: false,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: true,
+          supportsAudio: false,
+          supportsVideo: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: true,
+      },
+      optionSpecs: {
+        maxOutputTokens: { max: 4096, map: "{}" },
+        reasoningLevel: { values: ["off"], map: "{}" },
+      },
+      bind(options: any) {
+        return factory({
+          selection: { ...selected, options: { ...selected.options, ...options } },
+        });
+      },
+      async generateText(request: any) {
+        if (subscription) {
+          const refresh = getCurrentModelInvocationContext()?.refreshRuntimeHeadersBeforeAttempt;
+          assert.ok(refresh, "Pi must preserve the Host per-attempt credential context");
+          await refresh({
+            subscriptionAccess: { provider: "openai-codex" },
+            attempt: 0,
+            providerId: selected.providerId,
+            modelId: selected.modelId,
+          });
+        }
+        requests.push({
+          messages: structuredClone(request.messages),
+          tools: (request.tools ?? []).map((tool: any) => tool.name),
+          selection: selected,
+        });
+        const next = steps.shift();
+        assert.ok(next, "Unexpected physical model request");
+        return await next(request, selected);
+      },
+      async *streamText(request: any) {
+        const result = (await model.generateText(request)) as any;
+        yield { type: "start" };
+        if (result.text) yield { type: "text_delta", text: result.text };
+        for (const toolCall of result.toolCalls ?? []) yield { type: "tool_call", toolCall };
+        yield { type: "finish", finishReason: result.finishReason, usage: result.usage };
+      },
+    };
+    return model;
+  };
+  const create = () => {
+    runtime = new AgentRuntime(
+      "session" as never,
+      {
+        agentExecutor: executor,
+        workingDirectory: dir,
+        modelSelection: selection(),
+        mode: "build",
+        modelStreaming: streaming ? "on" : "off",
+        titleGeneration: { enabled: false },
+        memory: { use: false },
+        dynamicWorkflowEnabled: false,
+        toolAllowlist: ["Probe"],
+      },
+      {
+        eventStore: createInMemorySessionEventStore(),
+        sessionStore: store,
+        modelFactory: factory,
+        providerRuntimeHeadersPort: {
+          async refreshBeforeModelRequest(input: any) {
+            const accountId = input.subscriptionAccess.accountId ?? selectedAccount;
+            accounts.push(accountId);
+            return {
+              headersApplied: true,
+              requestAuth: {
+                apiKey: "synthetic",
+                credentialSelection: { accountId, revision: "fixture" },
+              },
+            };
+          },
+        },
+        permissionBroker: {
+          async requestPermission() {
+            permissionCalls++;
+            return { decision } as never;
+          },
+        },
+      },
+    );
+    runtime.getToolRegistry().register({
+      metadata: {
+        name: "Probe",
+        description: "write fixture",
+        readOnly: false,
+        destructive: false,
+        concurrentSafe: false,
+        sideEffectScope: "workspace",
+        riskLevel: "high",
+        needsApproval: true,
+      },
+      inputSchema: {
+        type: "object",
+        properties: { value: { type: "string" } },
+        required: ["value"],
+      },
+      async handler(input: any) {
+        effects++;
+        await writeFile(join(dir, "effect.txt"), input.value);
+        return { saved: input.value };
+      },
+    } as never);
+    runtime.invalidateToolCache();
+  };
+  create();
+  return {
+    steps,
+    requests,
+    accounts,
+    enableSubscription() {
+      subscription = true;
+    },
+    selectAccount(id: string) {
+      selectedAccount = id;
+    },
+    get runtime() {
+      return runtime;
+    },
+    get store() {
+      return store;
+    },
+    dir,
+    get effects() {
+      return effects;
+    },
+    get permissionCalls() {
+      return permissionCalls;
+    },
+    deny() {
+      decision = "deny";
+    },
+    terminal() {
+      runtime.getToolRegistry().getMetadata("Probe")!.stopTurnOnSuccess = true;
+    },
+    read: () => readFile(join(dir, "effect.txt"), "utf8"),
+    executorFacts() {
+      const db = new DatabaseSync(path, { readOnly: true });
+      try {
+        return db
+          .prepare("select provider_metadata_json from model_usage")
+          .all()
+          .map((row) => JSON.parse(String(row.provider_metadata_json)).fleetAccounting.executor);
+      } finally {
+        db.close();
+      }
+    },
+    async reopen() {
+      runtime.beginShutdown();
+      store.close();
+      store = new SqliteSessionStore({ dbPath: path });
+      create();
+      await runtime.resumeFromStore();
+    },
+    async close() {
+      runtime.beginShutdown();
+      store.close();
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test(
+  "full Pi executor writes model and tool results through the existing Host, once per call",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.steps.push(
+        () => reply("working", [call("one", "first"), call("two", "second")]),
+        (request) => {
+          assert.equal(
+            request.messages.filter((message: any) => message.role === "tool").length,
+            2,
+          );
+          return reply("finished");
+        },
+      );
+      const result = await f.runtime.executeTurn("Use Probe twice");
+      assert.equal(result.response, "finished");
+      assert.equal(f.effects, 2);
+      assert.equal(await f.read(), "second");
+      assert.equal(f.permissionCalls, 2);
+      assert.equal(f.requests.length, 2);
+      assert.ok(f.requests.every((request) => request.tools.every((name) => name === "Probe")));
+      const rows = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(rows.totals.modelRequestCount, 2);
+      assert.equal(rows.toolTotals.toolCallCount, 2);
+      await f.reopen();
+      f.steps.push((request) => {
+        assert.equal(request.messages.filter((message: any) => message.role === "tool").length, 2);
+        return reply("restored");
+      });
+      assert.equal((await f.runtime.executeTurn("Continue after reopen")).response, "restored");
+      assert.equal(f.effects, 2);
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "the new runtime default executes through Pi while the legacy control remains selectable",
+  { timeout: 10000 },
+  async () => {
+    for (const executor of [undefined, "zcode"] as const) {
+      const f = await fixture(executor);
+      try {
+        f.steps.push(() => reply("complete"));
+        assert.equal((await f.runtime.executeTurn("One request")).response, "complete");
+        const rows = await f.store.queryAppUsage({
+          since: 0,
+          until: Date.now() + 1,
+          tzOffsetMs: 0,
+        });
+        assert.equal(rows.totals.modelRequestCount, 1);
+        assert.deepEqual(f.executorFacts(), [executor ?? "pi"]);
+      } finally {
+        await f.close();
+      }
+    }
+  },
+);
+
+test(
+  "unexpected tool names close through the Host's registry-miss path",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.steps.push(
+        () => reply("invalid tool", [{ id: "unknown", name: "NoSuchTool", input: {} }]),
+        (request) => {
+          assert.ok(
+            request.messages.some((message: any) => message.role === "tool" && message.isError),
+          );
+          return reply("recovered");
+        },
+      );
+      assert.equal((await f.runtime.executeTurn("Try the missing tool")).response, "recovered");
+      assert.equal(f.effects, 0);
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test("terminal Host tools prevent another physical model request", { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    f.terminal();
+    f.steps.push(() => reply("terminal", [call("stop", "saved")]));
+    const result = await f.runtime.executeTurn("Finish through Probe");
+    assert.equal(result.response, "terminal");
+    assert.equal(f.requests.length, 1);
+    assert.equal(f.effects, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test(
+  "a text-only Guide continues through Pi at the committed Host boundary",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    const entered = Promise.withResolvers<void>(),
+      release = Promise.withResolvers<void>();
+    let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+    try {
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("first");
+        },
+        (request) => {
+          assert.ok(
+            request.messages.some(
+              (message: any) =>
+                message.role === "user" &&
+                JSON.stringify(message.content).includes("New instruction"),
+            ),
+          );
+          return reply("guided");
+        },
+      );
+      running = f.runtime.executeTurn("Original input");
+      await entered.promise;
+      const accepted = await f.runtime.steerTurn({ input: "New instruction", delivery: "guide" });
+      assert.equal(accepted.kind, "queued");
+      release.resolve();
+      assert.equal((await running).response, "guided");
+      assert.equal(f.requests.length, 2);
+    } finally {
+      release.resolve();
+      await running?.catch(() => {});
+      await f.close();
+    }
+  },
+);
+
+test("physical model failure remains a failed Host turn", { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(() => {
+      throw new Error("fixture provider refused");
+    });
+    await assert.rejects(
+      f.runtime.executeTurn("Fail the model"),
+      (error: any) => error.cause?.message === "fixture provider refused",
+    );
+    assert.equal(f.requests.length, 1);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("Pi tool calls retain the original Host permission refusal", { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    f.deny();
+    f.steps.push(
+      () => reply("attempt", [call("denied", "no")]),
+      (request) => {
+        assert.ok(
+          request.messages.some((message: any) => message.role === "tool" && message.isError),
+        );
+        return reply("permission denied");
+      },
+    );
+    assert.equal((await f.runtime.executeTurn("Attempt Probe")).response, "permission denied");
+    assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 1);
+  } finally {
+    await f.close();
