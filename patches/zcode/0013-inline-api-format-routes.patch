+test("format selection binds the declared endpoint and survives saving/reopening without losing credentials", async () => {
+  const f = await fixture();
+  try {
+    const service = f.runtime.configService;
+    const templates = (await service.read()).zcodeBuiltinProviderTemplates.toJSON();
+    const routes = resolveTemplateProtocolRoutes("deepseek", templates);
+    assert.deepEqual(routes, [
+      { type: "anthropic-messages", baseUrl: "https://api.deepseek.com/anthropic" },
+      { type: "openai-chat-completions", baseUrl: "https://api.deepseek.com" },
+    ]);
+    const { providerId } = await service.createPersonalProvider({
+      templateId: "deepseek",
+      initialConfig: parseProviderConfig({
+        access: { type: "api-key", apiKey: "fixture-key", additionalApiKeys: ["fixture-backup"] },
+      }),
+    });
+    const config = (await service.read()).personalProviders.get(providerId)!.toJSON();
+    const next = selectProviderProtocolRoute(
+      "openai-chat-completions",
+      routes[0]!.baseUrl + "/",
+      routes,
+    );
+    await service.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig({ ...config, api: next }),
+    );
+    const reopened = createProviderConfigRuntime({
+      personalFilePath: f.personalFilePath,
+      zcodeBuiltinFilePath: fileURLToPath(
+        new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+      ),
+      personalPollingIntervalMs: false,
+      watch: false,
+    });
+    await reopened.start();
+    try {
+      const saved = (await reopened.configService.read()).personalProviders
+        .get(providerId)!
+        .toJSON();
+      assert.deepEqual(saved.api, next);
+      assert.deepEqual(saved.access, config.access);
+      assert.deepEqual(saved.personalModelIds, config.personalModelIds);
+      const template = templates.find((t) => t.templateId === "deepseek")!.config;
+      const policy = resolveProviderProtocolPolicy(
+        template,
+        { ...template, api: next },
+        undefined,
+        routes,
+      );
+      assert.equal(policy.mode, "preset");
+      assert.deepEqual(policy.formats, ["anthropic-messages", "openai-chat-completions"]);
+      const previous = await readFile(f.personalFilePath, "utf8");
+      await assert.rejects(
+        service.savePersonalProviderOverlay(
+          providerId,
+          parseProviderConfig({ ...saved, api: { ...next, type: "anthropic-messages" } }),
+        ),
+        /protocol/i,
+      );
+      assert.equal(await readFile(f.personalFilePath, "utf8"), previous);
+      const back = selectProviderProtocolRoute("anthropic-messages", next.baseUrl, routes);
+      await service.savePersonalProviderOverlay(
+        providerId,
+        parseProviderConfig({ ...saved, api: back }),
+      );
+      assert.deepEqual(
+        (await service.read()).personalProviders.get(providerId)!.api?.toJSON(),
+        back,
+      );
+    } finally {
+      reopened.dispose();
+    }
+  } finally {
+    await f.dispose();
+  }
+});
+
