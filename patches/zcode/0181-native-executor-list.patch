@@ -0,0 +1,27 @@
+/**
+ * The one list of harnesses Fleet runs as whole executors (OV-099). Claude Code and Codex use their
+ * SDK/app-server; Antigravity and the rest speak ACP. Every schema, union and setting derives from
+ * this list instead of repeating it.
+ */
+export const ACP_EXECUTOR_KINDS = [
+  "cursor",
+  "kimi",
+  "opencode",
+  "hermes",
+  "openclaw",
+  "codebuddy",
+  "qwen",
+  "copilot",
+  "grok",
+] as const;
+
+export const NATIVE_EXECUTOR_KINDS = ["claude", "codex", "antigravity", ...ACP_EXECUTOR_KINDS] as const;
+
+export type AcpExecutorKind = (typeof ACP_EXECUTOR_KINDS)[number];
+export type NativeExecutorKind = (typeof NATIVE_EXECUTOR_KINDS)[number];
+
+const ACP_KIND_SET: ReadonlySet<string> = new Set(ACP_EXECUTOR_KINDS);
+
+export function isAcpExecutorKind(value: string): value is AcpExecutorKind {
+  return ACP_KIND_SET.has(value);
+}
