+import type { ProviderSettingsTemplateView } from "./facades.js";
+
+/** Match existing catalogue metadata without inheriting its model membership or changing a route. */
+export function matchEndpointTemplate(
+  baseUrl: string | null | undefined,
+  templates: readonly ProviderSettingsTemplateView[],
+  apiType?: string | null,
+): ProviderSettingsTemplateView | undefined {
+  const route = (value: string | null | undefined) => {
+    try {
+      const url = new URL(value ?? "");
+      return `${url.origin}${url.pathname.replace(/\/+$/, "").replace(/\/v1$/, "")}`;
+    } catch {
+      return undefined;
+    }
+  };
+  const target = route(baseUrl);
+  return target
+    ? templates.find(
+        (template) =>
+          (!apiType || template.config.api?.type === apiType) &&
+          route(template.config.api?.baseUrl) === target,
+      )
+    : undefined;
+}
