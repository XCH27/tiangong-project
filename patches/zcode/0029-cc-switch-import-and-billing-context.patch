+
+function parseObject(value: unknown): RecordValue {
+  if (typeof value !== "string") throw new Error("Invalid JSON");
+  const parsed: unknown = JSON.parse(value);
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
+    throw new Error("Invalid JSON");
+  return parsed as RecordValue;
+}
+
+export function parseCandidate(raw: RecordValue): Candidate {
+  const appType = text(raw.app_type);
+  const id = JSON.stringify([appType, text(raw.id)]);
+  const row = { id, appType, name: text(raw.name), baseUrl: "", modelIds: [] as string[] };
+  try {
+    const settings = parseObject(raw.settings_config);
+    const meta = parseObject(raw.meta ?? "{}");
+    const env = record(settings.env);
+    const claude = appType === "claude" || appType === "claude-desktop";
+    const auth = record(settings.auth);
+    const toml =
+      appType === "codex" && typeof settings.config === "string" ? parseToml(settings.config) : {};
+    const active = record(record(toml.model_providers)[text(toml.model_provider)]);
+    let apiKey = "";
+    let apiType: ApiType;
+    if (claude) {
+      row.baseUrl = first(
+        env.ANTHROPIC_BASE_URL,
+        settings.base_url,
+        settings.baseURL,
+        settings.apiEndpoint,
+      );
+      apiKey = first(
+        env.ANTHROPIC_AUTH_TOKEN,
+        env.ANTHROPIC_API_KEY,
+        env.OPENROUTER_API_KEY,
+        env.GOOGLE_API_KEY,
+        env.OPENAI_API_KEY,
+        env.GEMINI_API_KEY,
+        settings.apiKey,
+        settings.api_key,
+      );
+      apiType = protocol(
+        first(meta.apiFormat, settings.api_format, settings.apiFormat) ||
+          (settings.openrouter_compat_mode ? "openai_chat" : "anthropic"),
+      );
+      row.modelIds = [
+        env.ANTHROPIC_MODEL,
+        env.ANTHROPIC_DEFAULT_HAIKU_MODEL,
+        env.ANTHROPIC_DEFAULT_SONNET_MODEL,
+        env.ANTHROPIC_DEFAULT_OPUS_MODEL,
+        env.ANTHROPIC_DEFAULT_FABLE_MODEL,
+        env.CLAUDE_CODE_SUBAGENT_MODEL,
+      ]
+        .map(text)
+        .filter(Boolean);
+    } else if (appType === "codex") {
+      row.baseUrl = first(active.base_url, toml.base_url, settings.base_url, settings.baseURL);
+      apiKey = first(
+        auth.OPENAI_API_KEY,
+        // CC Switch 不从 Codex 保留 Provider 的 table 读取 bearer，只接受顶层兼容字段。
+        ["amazon-bedrock", "amazon-bedrock-runtime", "openai", "ollama", "lmstudio"].includes(
+          text(toml.model_provider),
+        )
+          ? undefined
+          : active.experimental_bearer_token,
+        toml.experimental_bearer_token,
+      );
+      apiType = protocol(
+        first(
+          meta.apiFormat,
+          settings.api_format,
+          settings.apiFormat,
+          active.wire_api,
+          toml.wire_api,
+        ) || "responses",
+      );
+      row.modelIds = [text(toml.model)].filter(Boolean);
+    } else if (["opencode", "pi", "openclaw"].includes(appType)) {
+      const options = record(settings.options);
+      row.baseUrl = first(options.baseURL, settings.baseUrl);
+      apiKey = first(options.apiKey, settings.apiKey);
+      const sdk = text(settings.npm);
+      apiType = protocol(
+        first(meta.apiFormat, settings.api) ||
+          (sdk === "@ai-sdk/anthropic"
+            ? "anthropic"
+            : sdk === "@ai-sdk/openai-compatible"
+              ? "chat"
+              : sdk === "@ai-sdk/openai"
+                ? "responses"
+                : ""),
+      );
+    } else if (appType === "gemini") {
+      row.baseUrl = first(env.GOOGLE_GEMINI_BASE_URL, settings.base_url, settings.baseURL);
+      apiKey = first(env.GEMINI_API_KEY, env.GOOGLE_API_KEY, settings.apiKey, settings.api_key);
+      row.modelIds = [text(env.GEMINI_MODEL)].filter(Boolean);
+    }
+    const sourceBaseUrl = row.baseUrl;
+    // CC Switch 的 Claude 代理拼 /v1/chat/completions；Fleet 的 SDK 只拼 /chat/completions。
+    if (row.baseUrl && apiType && apiType !== "anthropic-messages") {
+      const url = new URL(row.baseUrl);
+      const path = url.pathname.replace(/\/+$/, "");
+      if ((claude && !path.endsWith("/v1")) || (appType === "codex" && !path))
+        url.pathname = `${path}/v1`;
+      row.baseUrl = url.toString().replace(/\/$/, "");
+    }
+    const models = new Map<string, ModelConfigObject>();
+    const localAliases: string[] = [];
+    const addModel = (id: unknown, metadata: unknown = {}) => {
+      const original = text(id);
+      // 只处理有明确 CC Switch 语义的 Claude 本地标记，不泛化剥离真实 API ID 后缀。
+      const modelId = claude ? original.replace(/\[1m\]$/i, "").trim() : original;
+      if (!modelId) return;
+      if (modelId !== original) localAliases.push(original);
+      models.set(modelId, { ...models.get(modelId), ...readImportMetadata(metadata) });
+    };
+    row.modelIds.forEach((id) => addModel(id));
+    if (Array.isArray(settings.modelCatalog))
+      for (const value of settings.modelCatalog) addModel(record(value).model, value);
+    if (Array.isArray(settings.models))
+      for (const value of settings.models) addModel(record(value).id, value);
+    else for (const [id, value] of Object.entries(record(settings.models))) addModel(id, value);
+    row.modelIds = [...models.keys()];
+    const oauth =
+      (claude && raw.category === "official" && !apiKey) ||
+      ["codex_oauth", "github_copilot", "xai_oauth"].includes(text(meta.providerType)) ||
+      (appType === "codex" && raw.id === "codex-official" && raw.category === "official") ||
+      record(meta.authBinding).source === "managed_account" ||
+      /chatgpt\.com\/backend-api|githubcopilot\.com/.test(row.baseUrl) ||
+      /^sk-ant-oat|^ya29\.|^eyJ[^.]*\.|^\s*\{/.test(apiKey) ||
+      (!apiKey && (auth.tokens !== undefined || auth.access_token !== undefined));
+    let reason = oauth
+      ? "oauth-account-not-supported"
+      : appType === "gemini"
+        ? "gemini-native-protocol-not-supported"
+        : !["claude", "claude-desktop", "codex", "opencode", "pi", "openclaw"].includes(appType)
+          ? "app-not-supported"
+          : !apiType
+            ? "protocol-not-supported"
+            : !apiKey
+              ? "api-key-missing"
+              : !row.baseUrl
+                ? "base-url-missing"
+                : undefined;
+    // Full URL 与额外认证头依赖 CC Switch 代理的行为，当前 API Adapter 不能无损复现。
+    if (!reason && meta.isFullUrl === true) reason = "full-endpoint-url-not-supported";
+    const modelValues = Array.isArray(settings.models)
+      ? settings.models
+      : Object.values(record(settings.models));
+    if (
+      !reason &&
+      modelValues.some((value) => {
+        const model = record(value);
+        return (
+          Object.keys(record(model.provider)).length > 0 ||
+          (model.api !== undefined && protocol(text(model.api)) !== apiType)
+        );
+      })
+    )
+      reason = "per-model-route-not-supported";
+    if (
+      !reason &&
+      [
+        settings.headers,
+        record(settings.options).headers,
+        active.http_headers,
+        active.env_http_headers,
+      ].some((headers) => Object.keys(record(headers)).length > 0)
+    )
+      reason = "custom-headers-not-supported";
+    if (row.baseUrl) {
+      try {
+        const url = new URL(row.baseUrl);
+        if (!["https:", "http:"].includes(url.protocol)) reason ??= "invalid-base-url";
+        if (
+          url.username ||
+          url.password ||
+          url.search ||
+          url.hash ||
+          (apiKey && row.baseUrl.includes(apiKey))
+        ) {
+          reason = "credential-bearing-url-not-supported";
+          row.baseUrl = `${url.protocol}//${url.host}`;
+        }
+      } catch {
+        row.baseUrl = "";
+        reason ??= "invalid-base-url";
+      }
+    }
+    // 即使来源把密钥误填进名称/模型，预览也不能把已识别密钥带到 Renderer。
+    if (apiKey) {
+      row.name = row.name.replaceAll(apiKey, "[redacted]");
+      row.modelIds = row.modelIds.map((model) => model.replaceAll(apiKey, "[redacted]"));
+    }
+    return {
+      row: { ...row, apiType, eligible: !reason, ...(reason ? { reason } : {}) },
+      sourceBaseUrl,
+      models,
+      localAliases,
+      ...(!reason && apiType
+        ? {
+            config: {
+              access: { type: "api-key", apiKey },
+              api: { type: apiType, baseUrl: row.baseUrl },
+            },
+          }
+        : {}),
+    };
+  } catch {
+    return { row: { ...row, eligible: false, reason: "invalid-provider-config" } };
+  }
+}
+
+function readImportMetadata(value: unknown): ModelConfigObject {
+  const model = record(value);
+  const limit = record(model.limit);
+  const input = model.inputModalities ?? model.input ?? record(model.modalities).input;
+  const rawContext = model.contextWindow ?? limit.context;
+  const context =
+    typeof rawContext === "string" && /^\d+$/.test(rawContext) ? Number(rawContext) : rawContext;
+  return readDiscoveredModelMetadata({
+    context_window: context,
+    max_output_tokens: model.maxTokens ?? limit.output,
+    input_modalities: input,
+    output_modalities: record(model.modalities).output,
+  });
+}
+
+function protocol(value: string): ApiType {
+  const normalized = value.toLowerCase();
+  if (
+    ["anthropic", "anthropic_messages", "anthropic-messages", "claude", "messages"].includes(
+      normalized,
+    )
+  )
+    return "anthropic-messages";
+  if (
+    [
+      "chat",
+      "chat_completions",
+      "chat-completions",
+      "openai_chat",
+      "openai-chat",
+      "openai_chat_completions",
+      "openai-chat-completions",
+      "openai-completions",
+    ].includes(normalized)
+  )
+    return "openai-chat-completions";
+  if (["responses", "openai_responses", "openai-responses"].includes(normalized))
+    return "openai-responses";
+  return undefined;
+}
