diff --git a/packages/provider/src/route-policy.ts b/packages/provider/src/route-policy.ts
new file mode 100644
index 0000000..a19a8f7
--- /dev/null
+++ b/packages/provider/src/route-policy.ts
@@ -0,0 +1,44 @@
+/**
+ * Connection routes the vendors do not permit for a third-party application such as Fleet. A
+ * restricted connection keeps its saved data but cannot run, and is not offered for new
+ * connections; the UI explains the permitted alternative. Sources (checked 2026-10-06):
+ *
+ * - anthropic-subscription: Anthropic does not allow third-party developers to offer claude.ai
+ *   login or route requests through Free/Pro/Max credentials, including agents built on the Claude
+ *   Agent SDK (code.claude.com/docs/en/legal-and-compliance; /docs/en/agent-sdk/overview). Claude
+ *   runs through an API key or a cloud provider; a subscription only in Claude Code itself.
+ * - google-antigravity: Antigravity Additional Terms §6, "Using third party software, tools, or
+ *   services to access the Service … is a breach", enforced with account suspensions in 2026.
+ * - impersonated-client: the login presents another product's OAuth client (GitHub Copilot as the
+ *   VS Code extension, Grok as the Grok CLI). The vendors' own agents are reachable instead through
+ *   their documented ACP modes (`copilot --acp`, `grok agent stdio`).
+ */
+export type ConnectionRouteRestriction =
+  | "anthropic-subscription"
+  | "google-antigravity"
+  | "impersonated-client";
+
+interface AccessLike {
+  readonly type: string;
+  readonly provider?: string;
+}
+
+export function connectionRouteRestriction(
+  access: AccessLike | null | undefined,
+): ConnectionRouteRestriction | undefined {
+  if (access?.type === "native-cli") {
+    if (access.provider === "claude") return "anthropic-subscription";
+    if (access.provider === "antigravity") return "google-antigravity";
+  }
+  if (access?.type === "subscription" && (access.provider === "github-copilot" || access.provider === "xai"))
+    return "impersonated-client";
+  return undefined;
+}
+
+/** The API-key template a restricted connection points users to. */
+export const RESTRICTED_ROUTE_ALTERNATIVE: Readonly<Record<string, string>> = {
+  claude: "anthropic",
+  antigravity: "fleet-google",
+  xai: "xai",
+  "github-copilot": "fleet-copilot-native",
+};
