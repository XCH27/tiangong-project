diff --git a/packages/ui/src/settings/model-provider-section/RestrictedRouteNotice.tsx b/packages/ui/src/settings/model-provider-section/RestrictedRouteNotice.tsx
new file mode 100644
index 0000000..beb5e00
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/RestrictedRouteNotice.tsx
@@ -0,0 +1,51 @@
+import { ExternalLinkIcon } from "lucide-react";
+import type { ConnectionRouteRestriction } from "@zcode/provider";
+import { Button } from "@/components/ui/button.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { PlanStatusCardSurface } from "./PlanStatusCardSurface.js";
+
+/** Official statements each restriction rests on (see packages/provider/src/route-policy.ts). */
+const SOURCE: Record<ConnectionRouteRestriction, string> = {
+  "anthropic-subscription": "https://code.claude.com/docs/en/legal-and-compliance",
+  "google-antigravity": "https://antigravity.google/terms/",
+  "impersonated-client": "https://docs.github.com/en/copilot/reference/copilot-cli-reference/acp-server",
+};
+
+/**
+ * Replaces the connect controls of a route its vendor does not permit for third-party apps. Saved
+ * data stays; the connection cannot run and the card names the permitted alternative.
+ */
+export function RestrictedRouteNotice({
+  restriction,
+  provider,
+}: {
+  restriction: ConnectionRouteRestriction;
+  provider?: string;
+}) {
+  const { intl } = useZCodeIntl();
+  const platform = usePlatform();
+  const key = restriction === "impersonated-client" && provider === "xai" ? "impersonated-client-xai" : restriction;
+  return (
+    <PlanStatusCardSurface
+      compact
+      planTitle={intl.formatMessage({ id: "settings.modelProvider.routeRestricted.title" })}
+      statusMeta={
+        <p className="text-ui-base text-foreground-subtle">
+          {intl.formatMessage({ id: `settings.modelProvider.routeRestricted.${key}` })}
+        </p>
+      }
+      usageContent={
+        <Button
+          type="button"
+          variant="link"
+          className="h-6 p-0 text-ui-sm"
+          onClick={() => void platform.openExternal(SOURCE[restriction])}
+        >
+          {intl.formatMessage({ id: "settings.modelProvider.routeRestricted.source" })}
+          <ExternalLinkIcon className="size-3.5" aria-hidden="true" />
+        </Button>
+      }
+    />
+  );
+}
