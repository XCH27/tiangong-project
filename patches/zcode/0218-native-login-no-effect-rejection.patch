+++ b/packages/provider/src/native-connection-no-effect.ts
@@ -0,0 +1,7 @@
+/** Internal proof of zero account writes: target preflight/preparation or locked transform rejection. */
+export class NativeConnectionNoEffectError extends Error {
+  constructor(cause: unknown) {
+    super(cause instanceof Error ? cause.message : String(cause), { cause });
+    this.name = "NativeConnectionNoEffectError";
+  }
+}
