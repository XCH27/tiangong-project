+test("real repository IO refusal stays unknown and Cancel cannot delete an admitted login home", { skip: process.getuid?.() === 0 }, async () => {
+  const f = await publicationFailureFixture();
+  try {
+    const before = await readFile(f.personalFilePath, "utf8");
+    const { flowId } = await f.operations.beginNativeCliLogin(f.providerId, { addAccount: true });
+    await chmod(f.directory, 0o555);
+    await assert.rejects(f.operations.pollNativeCliLogin(f.providerId, flowId), (error) => {
+      assert.ok(error instanceof Error);
+      assert.equal(error instanceof NativeConnectionNoEffectError, false);
+      return true;
+    });
+    assert.deepEqual(f.removed, []);
+    await assert.rejects(f.operations.cancelNativeCliLogin(f.providerId, flowId));
+    assert.deepEqual(f.removed, []);
+    assert.equal(await readFile(f.personalFilePath, "utf8"), before);
+  } finally { await chmod(f.directory, 0o755); await f.close(); }
+});
