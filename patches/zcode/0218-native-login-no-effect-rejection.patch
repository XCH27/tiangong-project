+for (const stage of ["facade-preflight", "locked-cas"] as const) {
+  test(`real ${stage} rejection cleans the unpublished login home and lets Cancel end the attempt`, async () => {
+    const f = await publicationFailureFixture();
+    const external = new NodePersonalProviderConfigRepository({ filePath: f.personalFilePath, pollingIntervalMs: false });
+    try {
+      const initial = f.facade.getView().providers.find((provider) => provider.providerId === f.providerId)!.effectiveConfig.access!;
+      const { flowId } = await f.operations.beginNativeCliLogin(f.providerId, { addAccount: true });
+      await external.update((current) => {
+        const rule = current.providers.getRule(f.providerId)!;
+        return { ...current, providers: current.providers.setRule({ ...rule,
+          config: (rule.config ?? new ProviderConfig()).overlay(parseProviderConfig({
+            access: { ...initial, executable: "/authored/changed-codex" },
+          })),
+        }) };
+      });
+      const afterExternal = await readFile(f.personalFilePath, "utf8");
+      if (stage === "facade-preflight") await f.facade.refresh("fixture-other-settings");
+      else {
+        const oldAccess = f.facade.getView().providers.find((provider) => provider.providerId === f.providerId)!.effectiveConfig.access;
+        assert.ok(oldAccess?.type === "native-cli");
+        assert.equal(oldAccess.executable, undefined, "The locked CAS fixture must retain the older facade observation");
+      }
+      await assert.rejects(f.operations.pollNativeCliLogin(f.providerId, flowId), (error) => {
+        assert.ok(error instanceof NativeConnectionNoEffectError);
+        assert.ok(error.cause instanceof Error);
+        assert.equal(error.message, error.cause.message);
+        assert.match(error.message, /Connection changed/);
+        return true;
+      });
+      assert.equal(await readFile(f.personalFilePath, "utf8"), afterExternal, "Rejected login performed an account write");
+      assert.equal(afterExternal.includes(f.cliHome), false);
+      assert.deepEqual(f.removed, [f.cliHome], "A proven no-effect rejection leaked its unpublished home");
+      await f.operations.cancelNativeCliLogin(f.providerId, flowId);
+      await assert.rejects(f.operations.pollNativeCliLogin(f.providerId, flowId), /expired or cancelled/);
+      assert.equal(await readFile(f.personalFilePath, "utf8"), afterExternal);
+      assert.deepEqual(f.removed, [f.cliHome], "Cancel removed the same home twice");
+    } finally { external.dispose(); await f.close(); }
+  });
