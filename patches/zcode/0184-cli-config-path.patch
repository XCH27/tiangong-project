diff --git a/packages/services/src/zcodeCliPaths.ts b/packages/services/src/zcodeCliPaths.ts
new file mode 100644
index 0000000..26b74cf
--- /dev/null
+++ b/packages/services/src/zcodeCliPaths.ts
@@ -0,0 +1,21 @@
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+/**
+ * The CLI's user directory (`~/.zcode/cli`), shared by the desktop readers and the CLI process.
+ * `ZCODE_HOME` names the `~/.zcode` root exactly as the CLI reads it, so an isolated profile's
+ * desktop and agent see the same plugin, skill, hook and MCP configuration and never the
+ * person's real files. An explicit home (tests) still wins.
+ */
+export function zcodeCliDir(homeDir?: string, env: NodeJS.ProcessEnv = process.env): string {
+  if (homeDir?.trim()) return join(homeDir, ".zcode", "cli");
+  const zcodeHome = env.ZCODE_HOME?.trim();
+  if (zcodeHome) return join(zcodeHome, "cli");
+  const home =
+    env.ZCODE_DESKTOP_HOME_DIR?.trim() || env.HOME?.trim() || env.USERPROFILE?.trim() || homedir();
+  return join(home, ".zcode", "cli");
+}
+
+export function zcodeCliConfigPath(homeDir?: string, env: NodeJS.ProcessEnv = process.env): string {
+  return join(zcodeCliDir(homeDir, env), "config.json");
+}
diff --git a/packages/services/test/zcode-cli-paths.test.ts b/packages/services/test/zcode-cli-paths.test.ts
new file mode 100644
index 0000000..1652930
--- /dev/null
+++ b/packages/services/test/zcode-cli-paths.test.ts
@@ -0,0 +1,13 @@
+import assert from "node:assert/strict";
+import { join } from "node:path";
+import test from "node:test";
+import { zcodeCliConfigPath } from "../src/zcodeCliPaths.js";
+
+// The desktop readers and the CLI must name the same config file: ZCODE_HOME first (isolated
+// profiles), then the desktop home, then HOME — never diverging in a review profile again.
+test("desktop readers locate the CLI config exactly as the CLI does", () => {
+  assert.equal(zcodeCliConfigPath(undefined, { ZCODE_HOME: "/p/cli-home", HOME: "/real" }), "/p/cli-home/cli/config.json");
+  assert.equal(zcodeCliConfigPath(undefined, { ZCODE_DESKTOP_HOME_DIR: "/p/desk", HOME: "/real" }), "/p/desk/.zcode/cli/config.json");
+  assert.equal(zcodeCliConfigPath(undefined, { HOME: "/real" }), join("/real", ".zcode", "cli", "config.json"));
+  assert.equal(zcodeCliConfigPath("/test-home", { ZCODE_HOME: "/p" }), "/test-home/.zcode/cli/config.json", "an explicit home wins");
+});
