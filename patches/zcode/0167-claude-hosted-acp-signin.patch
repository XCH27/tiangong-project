index 0000000..0fe3c2a
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/acp-auth.ts
@@ -0,0 +1,102 @@
+import { AcpClient } from "./acp-client.js";
+import { ACP_PROFILES, type AcpExecutorKind } from "./acp-profiles.js";
+import { acpFailure } from "./acp-session.js";
+
+/**
+ * Sign-in through the agent's own ACP `authenticate` methods: the vendor runs its own flow (browser
+ * page, device code) and keeps the credentials; Fleet only asks it to start and waits. Methods that
+ * declare ACP terminal auth are shown as the command to run, since they need an interactive terminal.
+ */
+export interface AcpAuthMethod {
+  id: string;
+  name: string;
+  terminal?: { command: string; args: string[] };
+}
+
+interface Target {
+  kind: AcpExecutorKind;
+  executable: string;
+  cwd: string;
+  env: NodeJS.ProcessEnv;
+}
+
+function client(target: Target) {
+  return new AcpClient({
+    executable: target.executable,
+    args: ACP_PROFILES[target.kind].args,
+    cwd: target.cwd,
+    env: target.env,
+    onNotification: () => {},
+    onRequest: async () => ({ outcome: { outcome: "cancelled" } }),
+    onExit: () => {},
+  });
+}
+
+const initialize = (acp: AcpClient) =>
+  acp.request<{ protocolVersion?: number; authMethods?: unknown[] }>(
+    "initialize",
+    {
+      protocolVersion: 1,
+      clientCapabilities: { fs: { readTextFile: false, writeTextFile: false }, terminal: false },
+      clientInfo: { name: "Fleet", version: "1" },
+    },
+    60_000,
+  );
+
+export function parseAcpAuthMethods(raw: unknown[] | undefined): AcpAuthMethod[] {
+  const methods: AcpAuthMethod[] = [];
+  for (const entry of raw ?? []) {
+    if (!entry || typeof entry !== "object") continue;
+    const value = entry as { id?: unknown; name?: unknown; _meta?: Record<string, unknown> };
+    if (typeof value.id !== "string" || !value.id) continue;
+    // A cached credential is not a sign-in the user can start (Grok `cached_token`).
+    if (/^cached/u.test(value.id)) continue;
+    const terminal = value._meta?.["terminal-auth"] as { command?: unknown; args?: unknown } | undefined;
+    methods.push({
+      id: value.id,
+      name: typeof value.name === "string" && value.name ? value.name : value.id,
+      ...(terminal && typeof terminal.command === "string"
+        ? {
+            terminal: {
+              command: terminal.command,
+              args: Array.isArray(terminal.args) ? terminal.args.filter((arg): arg is string => typeof arg === "string") : [],
+            },
+          }
+        : {}),
+    });
+  }
+  return methods;
+}
+
+export async function listAcpAuthMethods(target: Target): Promise<AcpAuthMethod[]> {
+  const acp = client(target);
+  try {
+    return parseAcpAuthMethods((await initialize(acp)).authMethods);
+  } finally {
+    acp.close();
+  }
+}
+
+/** Runs one vendor sign-in; completes when the agent reports success. Ten minutes at most. */
+export function startAcpLogin(target: Target & { methodId: string; timeoutMs?: number }) {
+  const acp = client(target);
+  let settled = false;
+  const completion = (async () => {
+    await initialize(acp);
+    await acp.request("authenticate", { methodId: target.methodId }, target.timeoutMs ?? 600_000);
+  })()
+    .catch((error: unknown) => {
+      throw acpFailure(target.kind, error);
+    })
+    .finally(() => {
+      settled = true;
+      acp.close();
+    });
+  void completion.catch(() => {});
+  return {
+    completion,
+    cancel() {
+      if (!settled) acp.close();
+    },
+  };
+}
