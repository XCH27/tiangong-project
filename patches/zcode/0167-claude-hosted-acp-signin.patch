+/** Tool output is evidence, not instructions; long output is trimmed to keep the replay bounded. */
+const TOOL_TEXT_LIMIT = 4000;
+const clip = (value: string) =>
+  value.length > TOOL_TEXT_LIMIT ? `${value.slice(0, TOOL_TEXT_LIMIT)}\n[… ${value.length - TOOL_TEXT_LIMIT} more characters]` : value;
+
+function transcriptLine(message: ModelInputMessage): string {
+  const body = text(message.content, false);
+  if (message.role === "tool")
+    return `Tool result${message.toolName ? ` (${message.toolName})` : ""}${message.isError ? " [error]" : ""}: ${clip(body)}`;
+  if (message.role === "assistant") {
+    const calls = (message.toolCalls ?? [])
+      .map((call) => `[Assistant called ${call.name}: ${clip(JSON.stringify(call.input) ?? "")}]`)
+      .join("\n");
+    return [body && `Assistant: ${body}`, calls].filter(Boolean).join("\n");
+  }
+  return body ? `User: ${body}` : "";
+}
