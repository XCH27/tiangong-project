+/**
+ * Claude/Codex sign-ins. One account keeps the compact allowance; several reuse the subscription
+ * account rows (default, allowance, remove) and automatic switching.
+ */
+export function NativeCliAccounts({
+  providerId,
+  kind,
+  busy,
+  adding,
+  onAddAccount,
+  onReconnect,
+  onError,
+}: {
+  providerId: string;
+  kind: "claude" | "openai-codex";
+  busy: boolean;
+  adding: boolean;
+  onReconnect(accountId: string): void;
+  onAddAccount(): void;
+  onError(error: unknown): void;
+}) {
+  const { providerSettingsService } = useServices();
+  const { intl } = useZCodeIntl();
+  const accountList = useSubscriptionAccountList(
+    providerSettingsService,
+    providerId,
+    () => {},
+    onError,
+  );
+  const { accounts, reload } = accountList;
+  const [updating, setUpdating] = useState(false);
+  const update = async (change: { select?: string; remove?: string; autoSwitch?: boolean }) => {
+    if (updating) return;
+    setUpdating(true);
+    try {
+      // 切换要先由官方 CLI 验证目标账号；失败必须提示，不能被列表读取的过期判断吞掉。
+      await providerSettingsService.updateSubscriptionAccounts(providerId, change);
+    } catch (error) {
+      onError(error);
+    } finally {
+      setUpdating(false);
+      void reload();
+    }
+  };
+  const list = accounts?.accounts ?? [];
+  const account = list.find((entry) => entry.active);
+  // Claude keeps one sign-in (Anthropic plan limits assume ordinary, individual use); Codex may add more.
+  const addButton = kind === "claude" ? null : (
+    <Button
+      type="button"
+      variant="ghost"
+      className="h-auto px-0 text-ui-sm"
+      disabled={busy || updating || list.length >= 10}
+      onClick={onAddAccount}
+    >
+      <Plus className="size-4" />
+      {intl.formatMessage({ id: "settings.modelProvider.nativeCli.addAccount" })}
+    </Button>
+  );
+  if (!accounts) return null;
+  if (list.length < 2)
+    return (
+      <div className="space-y-2">
+        {account ? (
+          <SubscriptionUsageSection
+            providerId={providerId}
+            kind={kind}
+            accountId={account.id}
+            revision={accounts.revision}
+            compact
+            showReset={false}
+            onScopeChanged={() => void reload()}
+          />
+        ) : null}
+        {addButton}
+      </div>
+    );
+  return (
+    <NativeCliAccountList
+      providerId={providerId}
+      kind={kind}
+      accounts={list}
+      revision={accounts.revision}
+      autoSwitch={accounts.autoSwitch}
+      busy={busy || updating}
+      adding={adding}
+      onAdd={onAddAccount}
+      onReconnect={onReconnect}
+      onUpdate={(change) => void update(change)}
+      onScopeChanged={() => void reload()}
+    />
+  );
+}
