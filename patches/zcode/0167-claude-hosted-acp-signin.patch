+    { id: "external", name: "Login with Google/Github" },
+    { id: "terminal", name: "Terminal login", _meta: { "terminal-auth": { command: "codebuddy", args: ["login"] } } },
+    { id: "cached_token", name: "cached_token" } ] } });
+  else if (m.method === "authenticate") { fs.writeFileSync(${JSON.stringify(state)}, m.params.methodId); send({ jsonrpc: "2.0", id: m.id, result: {} }); }
+  else if (m.method === "session/new") {
+    if (!fs.existsSync(${JSON.stringify(state)})) send({ jsonrpc: "2.0", id: m.id, error: { code: -32000, message: "Authentication required", data: { category: "auth" } } });
+    else send({ jsonrpc: "2.0", id: m.id, result: { sessionId: "s", configOptions: [{ id: "model", category: "model", currentValue: "hy3", options: [{ value: "hy3", name: "HY3" }] }] } });
+  }
+  else send({ jsonrpc: "2.0", id: m.id, result: {} }); } });
+`,
