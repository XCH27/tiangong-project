   return taskId ?? "__draft__";
 }
 
+/** Map the main process's non-claimable sentinel back to the exact human draft tab.
+ * Do not substitute the active task: late popups must never acquire another task's scope.
+ */
+export function resolveUnscopedBrowserPopup(
+  current: WorkspaceSidePaneState | null,
+  payload: { sourceTabId?: string; workspaceKey?: string; remoteSessionId?: string },
+): { sessionId: null } | null {
+  const source = current?.tabs.find((tab) => tab.id === payload.sourceTabId);
+  if (!source || source.type !== "browser" || source.ownerTaskId != null) return null;
+  if (!payload.workspaceKey || source.workspaceKey !== payload.workspaceKey) return null;
+  if ((source.remoteSessionId ?? "") !== (payload.remoteSessionId ?? "")) return null;
+  return { sessionId: null };
+}
+
