diff --git a/packages/ui/test/browserPopupScope.test.ts b/packages/ui/test/browserPopupScope.test.ts
new file mode 100644
index 0000000..b746aeb
--- /dev/null
+++ b/packages/ui/test/browserPopupScope.test.ts
@@ -0,0 +1,56 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { openBrowserSidePane, resolveUnscopedBrowserPopup } from "../src/lib/workspaceSidePane.js";
+
+test("Unscoped human popup resolves the source draft; no active conversation is inferred", () => {
+  const current = openBrowserSidePane(null, {
+    tabId: "browser:source",
+    workspaceKey: "workspace-a",
+    ownerTaskId: null,
+  });
+  assert.deepEqual(
+    resolveUnscopedBrowserPopup(current, {
+      sourceTabId: "browser:source",
+      workspaceKey: "workspace-a",
+    }),
+    { sessionId: null },
+  );
+  assert.equal(
+    resolveUnscopedBrowserPopup(current, {
+      sourceTabId: "browser:source",
+      workspaceKey: "workspace-b",
+    }),
+    null,
+  );
+  assert.equal(
+    resolveUnscopedBrowserPopup(current, {
+      sourceTabId: "browser:closed",
+      workspaceKey: "workspace-a",
+    }),
+    null,
+  );
+  assert.equal(
+    resolveUnscopedBrowserPopup(current, {
+      sourceTabId: "browser:source",
+      workspaceKey: "workspace-a",
+      remoteSessionId: "foreign",
+    }),
+    null,
+  );
+  assert.equal(resolveUnscopedBrowserPopup(current, { sourceTabId: "browser:source" }), null);
+});
+
+test("A task-owned tab cannot be reassigned to the draft by an unscoped popup", () => {
+  const current = openBrowserSidePane(null, {
+    tabId: "browser:source",
+    workspaceKey: "workspace-a",
+    ownerTaskId: "task-a",
+  });
+  assert.equal(
+    resolveUnscopedBrowserPopup(current, {
+      sourceTabId: "browser:source",
+      workspaceKey: "workspace-a",
+    }),
+    null,
+  );
+});
