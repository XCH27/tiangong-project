+  assert.equal("actualAmount" in subscription.summary, false);
+  assert.equal("allocationBasis" in subscription.summary, false);
+  assert.equal(rows[3]?.authKind, null);
+  assert.equal(rows[4]?.authKind, undefined);
+});
