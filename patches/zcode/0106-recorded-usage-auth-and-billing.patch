+test("recorded auth and billing identities survive reopen without merging otherwise identical usage", async () => {
+  const f = await fixture();
+  const metadata = (authKind?: string, billingProvider?: string) => ({
+    fleetAccounting: {
+      accountId: "a",
+      requestedSpeedMode: "standard",
+      ...(authKind === undefined ? {} : { authKind }),
+      ...(billingProvider === undefined ? {} : { billingProvider }),
+    },
+  });
+  const storedFacts = () => {
+    const db = new DatabaseSync(f.path, { readOnly: true });
+    try {
+      return db.prepare("select id, accounting_json from model_usage order by id").all();
+    } finally {
+      db.close();
+    }
+  };
+  try {
+    const subscription = { startedAt: 100, providerMetadata: metadata("subscription", "openai") };
+    await f.record("subscription", "a", "standard", subscription);
+    await f.record("subscription", "a", "standard", subscription);
+    await f.record("api", "a", "standard", {
+      startedAt: 101,
+      providerMetadata: metadata("api-key", "openai"),
+    });
+    await f.record("other-billing", "a", "standard", {
+      startedAt: 102,
+      providerMetadata: metadata("subscription", "anthropic"),
+    });
+    await f.record("legacy", "a", "standard", {
+      startedAt: 103,
+      providerMetadata: metadata(),
+    });
+    await f.record("outside-range", "a", "standard", {
+      startedAt: 104,
+      providerMetadata: metadata("subscription", "openai"),
+    });
+    const before = storedFacts();
+    f.reopen();
+    const result = await f.query(100, 104);
+    const rows = result.accounting!.map((row) => usageAccountingRowSchema.parse(row));
+    assert.equal(rows.length, 4);
+    assert.deepEqual(
+      new Set(rows.map((row) => JSON.stringify([row.authKind, row.billingProvider]))),
+      new Set([
+        '["subscription","openai"]',
+        '["api-key","openai"]',
+        '["subscription","anthropic"]',
+        "[null,null]",
+      ]),
+    );
+    assert.ok(rows.every((row) => row.requestCount === 1));
+    const legacy = rows.find((row) => row.authKind === null)!;
+    assert.equal(legacy.accountId, "a");
+    assert.equal(legacy.billingProvider, null);
+    assert.equal(legacy.pricedCount, 0);
+    const report = buildUsageCostReport(rows);
+    assert.equal(report.summary.requests, result.totals.modelRequestCount);
+    assert.equal(report.summary.requests, 4);
+    assert.equal(report.summary.totalTokens, 4400);
+    assert.equal(report.models.length, 1);
+    assert.equal(report.models[0]?.requests, 4);
+    assert.equal(report.summary.apiUsd, rows.reduce((sum, row) => sum + row.estimatedUsd, 0));
+    assert.equal((await f.query(104, 105)).accounting?.[0]?.requestCount, 1);
+    assert.deepEqual(storedFacts(), before);
+  } finally {
+    await f.close();
+  }
+});
+
+test("missing or non-string recorded auth identities stay unknown without modifying history", () => {
+  const db = new DatabaseSync(":memory:");
+  try {
+    db.exec(
+      "create table model_usage(provider_id text,model_id text,started_at integer,accounting_json text,query_source text default 'main_turn')",
+    );
+    const insert = db.prepare("insert into model_usage values(?,?,?,?,?)");
+    for (const [at, identity] of [
+      [100, {}],
+      [101, { authKind: null, billingProvider: null }],
+      [102, { authKind: true, billingProvider: 42 }],
+      [103, { authKind: "", billingProvider: "" }],
+    ] as const) {
+      insert.run(
+        "same-provider",
+        "same-model",
+        at,
+        JSON.stringify({ ...identity, estimatedUsd: 1, priceVersion: "frozen" }),
+        "main_turn",
+      );
+    }
+    const before = db.prepare("select * from model_usage order by started_at").all();
+    const rows = queryAccounting(db, 100, 104).map((row) => usageAccountingRowSchema.parse(row));
+    assert.equal(rows.length, 1);
+    assert.equal(rows[0]?.authKind, null);
+    assert.equal(rows[0]?.billingProvider, null);
+    assert.equal(rows[0]?.requestCount, 4);
+    assert.equal(buildUsageCostReport(rows).summary.apiUsd, 4);
+    assert.deepEqual(db.prepare("select * from model_usage order by started_at").all(), before);
+  } finally {
+    db.close();
+  }
+});
