+  const rows = [
+    row({ authKind: "subscription", billingProvider: "openai", estimatedUsd: 3 }),
+    row({ authKind: "api-key", billingProvider: "openai", estimatedUsd: 5 }),
+    row({ authKind: "subscription", billingProvider: "anthropic", estimatedUsd: 7 }),
+    row({ authKind: null, billingProvider: null, estimatedUsd: 11 }),
+    row({ estimatedUsd: 13 }),
