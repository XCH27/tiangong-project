diff --git a/packages/desktop/src/main/embeddedBrowserContextMenu.ts b/packages/desktop/src/main/embeddedBrowserContextMenu.ts
new file mode 100644
index 0000000..aaa833d
--- /dev/null
+++ b/packages/desktop/src/main/embeddedBrowserContextMenu.ts
@@ -0,0 +1,119 @@
+import { clipboard, Menu } from "electron";
+import type { ContextMenuParams, MenuItemConstructorOptions, WebContents } from "electron";
+import { desktopMenuMessageIds, getDesktopMenuMessage, type Locale } from "@zcode/shared";
+
+const browserLabels = {
+  "zh-CN": {
+    openLink: "在新标签页中打开链接",
+    copyLink: "复制链接地址",
+    copyImage: "复制图片",
+    copyImageUrl: "复制图片地址",
+    back: "后退",
+    forward: "前进",
+    reload: "刷新",
+    inspect: "检查元素",
+  },
+  "en-US": {
+    openLink: "Open link in new tab",
+    copyLink: "Copy link address",
+    copyImage: "Copy image",
+    copyImageUrl: "Copy image address",
+    back: "Back",
+    forward: "Forward",
+    reload: "Refresh",
+    inspect: "Inspect element",
+  },
+};
+
+function isWebUrl(value: string): boolean {
+  try {
+    return ["http:", "https:"].includes(new URL(value).protocol);
+  } catch {
+    return false;
+  }
+}
+
+/** Native guest operations use the emitting guest, rather than the shell's focused editor. */
+export function showEmbeddedBrowserContextMenu({
+  guest,
+  params,
+  locale,
+  openLink,
+}: {
+  guest: WebContents;
+  params: ContextMenuParams;
+  locale: Locale;
+  openLink: (url: string) => void;
+}) {
+  const sourceUrl = guest.getURL();
+  let sourceValid = true;
+  const invalidate = (details: { isMainFrame: boolean }) => {
+    if (details.isMainFrame) sourceValid = false;
+  };
+  guest.on("did-start-navigation", invalidate);
+  const labels = browserLabels[locale];
+  const template: MenuItemConstructorOptions[] = [];
+  const guarded = (action: () => void) => () => {
+    if (sourceValid && !guest.isDestroyed() && guest.getURL() === sourceUrl) action();
+  };
+  const separator = () => {
+    if (template.length) template.push({ type: "separator" });
+  };
+  if (isWebUrl(params.linkURL)) {
+    template.push(
+      { label: labels.openLink, click: guarded(() => openLink(params.linkURL)) },
+      { label: labels.copyLink, click: guarded(() => clipboard.writeText(params.linkURL)) },
+    );
+  }
+  if (params.mediaType === "image") {
+    separator();
+    template.push({
+      label: labels.copyImage,
+      click: guarded(() => guest.copyImageAt(params.x, params.y)),
+    });
+    if (isWebUrl(params.srcURL))
+      template.push({
+        label: labels.copyImageUrl,
+        click: guarded(() => clipboard.writeText(params.srcURL)),
+      });
+  }
+  if (params.isEditable) {
+    separator();
+    for (const [id, enabled, action] of [
+      [desktopMenuMessageIds.editUndo, params.editFlags.canUndo, () => guest.undo()],
+      [desktopMenuMessageIds.editRedo, params.editFlags.canRedo, () => guest.redo()],
+      [desktopMenuMessageIds.editCut, params.editFlags.canCut, () => guest.cut()],
+      [desktopMenuMessageIds.editCopy, params.editFlags.canCopy, () => guest.copy()],
+      [desktopMenuMessageIds.editPaste, params.editFlags.canPaste, () => guest.paste()],
+      [desktopMenuMessageIds.editSelectAll, params.editFlags.canSelectAll, () => guest.selectAll()],
+    ] as const)
+      template.push({ label: getDesktopMenuMessage(locale, id), enabled, click: guarded(action) });
+  } else if (params.selectionText.trim()) {
+    separator();
+    template.push({
+      label: getDesktopMenuMessage(locale, desktopMenuMessageIds.editCopy),
+      enabled: params.editFlags.canCopy,
+      click: guarded(() => guest.copy()),
+    });
+  }
+  separator();
+  template.push(
+    {
+      label: labels.back,
+      enabled: guest.navigationHistory.canGoBack(),
+      click: guarded(() => guest.navigationHistory.goBack()),
+    },
+    {
+      label: labels.forward,
+      enabled: guest.navigationHistory.canGoForward(),
+      click: guarded(() => guest.navigationHistory.goForward()),
+    },
+    { label: labels.reload, click: guarded(() => guest.reload()) },
+    { label: labels.inspect, click: guarded(() => guest.inspectElement(params.x, params.y)) },
+  );
+  Menu.buildFromTemplate(template).popup({
+    callback: () => {
+      guest.removeListener("did-start-navigation", invalidate);
+    },
+  });
+}
