diff --git a/packages/ui/test/embeddedBrowser.browser.tsx b/packages/ui/test/embeddedBrowser.browser.tsx
new file mode 100644
index 0000000..f24d891
--- /dev/null
+++ b/packages/ui/test/embeddedBrowser.browser.tsx
@@ -0,0 +1,151 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { BrowserFindBar } from "../src/browser-use/BrowserFindBar.js";
+import { useBrowserFind } from "../src/browser-use/useBrowserFind.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const globals = window as unknown as Record<string, unknown>;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const wait = async (predicate: () => boolean) => {
+  for (let attempt = 0; attempt < 80; attempt++) {
+    if (predicate()) return;
+    await act(async () => {
+      await new Promise((done) => setTimeout(done, 50));
+    });
+  }
+  throw new Error(
+    "Native guest result timed out: " +
+      JSON.stringify(currentFind?.result) +
+      " / " +
+      currentFind?.query,
+  );
+};
+let currentFind: ReturnType<typeof useBrowserFind>;
+function Find({ guest, visible }: { guest: ElectronWebviewTag; visible: boolean }) {
+  const find = useBrowserFind(guest, visible, true);
+  currentFind = find;
+  return find.isOpen ? <BrowserFindBar find={find} /> : null;
+}
+globals.__embeddedBrowserTests = (async () => {
+  const results: { name: string; error?: string }[] = [];
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  const guest = document.createElement("webview");
+  guest.setAttribute("partition", "persist:fleet-browser-proof");
+  guest.style.cssText = "display:flex;width:500px;height:300px";
+  guest.src = `http://127.0.0.1:${new URLSearchParams(location.search).get("port")}/`;
+  const ready = new Promise<void>((done) =>
+    guest.addEventListener("dom-ready", () => done(), { once: true }),
+  );
+  document.body.append(guest);
+  await ready;
+  const render = (locale: "zh-CN" | "en-US", visible = true) =>
+    root.render(
+      <ZCodeIntlProvider initialLocale={locale}>
+        <TooltipProvider>
+          <Find guest={guest} visible={visible} />
+        </TooltipProvider>
+      </ZCodeIntlProvider>,
+    );
+  const test = async (name: string, action: () => Promise<void>) => {
+    try {
+      await action();
+      results.push({ name });
+    } catch (error) {
+      results.push({ name, error: String(error) });
+    }
+  };
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const dark of [false, true]) {
+      await test(`${locale} ${dark ? "dark" : "light"}: real guest find, navigation and stale result`, async () => {
+        document.documentElement.classList.toggle("dark", dark);
+        await act(async () => render(locale));
+        await act(async () => currentFind.open());
+        check(node.querySelector('[role="search"]'), "Search bar missing");
+        check(
+          document.activeElement === node.querySelector("input"),
+          "Search did not receive focus",
+        );
+        await act(async () => currentFind.setQuery("needle"));
+        await wait(() => currentFind.result.matches === 2);
+        await act(async () => currentFind.next());
+        await wait(() => currentFind.result.activeMatchOrdinal === 2);
+        await act(async () => currentFind.previous());
+        await wait(() => currentFind.result.activeMatchOrdinal === 1);
+        await act(async () => currentFind.setQuery("absent"));
+        await wait(() => currentFind.result.matches === 0);
+        const late = new Event("found-in-page") as ElectronWebviewFoundInPageEvent;
+        late.result = { requestId: -1, activeMatchOrdinal: 9, matches: 9, finalUpdate: true };
+        await act(async () => guest.dispatchEvent(late));
+        check(currentFind.result.matches === 0, "Stale query overwrote current result");
+        const navigation = new Event("did-navigate") as ElectronWebviewNavigationEvent;
+        navigation.isMainFrame = true;
+        await act(async () => guest.dispatchEvent(navigation));
+        check(!node.querySelector('[role="search"]'), "Old page search survived navigation");
+        check(
+          node.getBoundingClientRect().width <= document.documentElement.clientWidth,
+          "Find controls overflow",
+        );
+      });
+      await act(async () => root.render(null));
+    }
+  await test("Guest Cmd/Ctrl+F, Escape and hidden-tab isolation", async () => {
+    await act(async () => render("zh-CN"));
+    const inputGuest = guest as unknown as { sendInputEvent(input: Record<string, unknown>): void };
+    guest.focus();
+    inputGuest.sendInputEvent({
+      type: "keyDown",
+      keyCode: "F",
+      modifiers: [navigator.platform.includes("Mac") ? "meta" : "control"],
+    });
+    await wait(() => currentFind.isOpen);
+    await act(async () =>
+      window.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true })),
+    );
+    check(!currentFind.isOpen, "Escape retained guest search");
+    await act(async () => render("zh-CN", false));
+    await act(async () =>
+      window.dispatchEvent(
+        new KeyboardEvent("keydown", { key: "f", ctrlKey: true, bubbles: true }),
+      ),
+    );
+    check(!currentFind.isOpen, "Hidden tab handled another page's shortcut");
+  });
+  await test("Loaded page remains usable and MV3 content script result is observable", async () => {
+    const content = await guest.executeJavaScript(
+      "document.documentElement.dataset.extensionContent",
+    );
+    check(content === "yes", "Native extension did not inject into a real webview guest");
+    const probe = await guest.executeJavaScript("document.documentElement.dataset.extensionProbe");
+    globals.__extensionReport = {
+      contentScript: content,
+      ...(probe ? JSON.parse(String(probe)) : { worker: "no response" }),
+    };
+  });
+  await test("Stop cancels a pending real navigation; reload can be used afterward", async () => {
+    const began = new Promise<void>((done) =>
+      guest.addEventListener("did-start-loading", () => done(), { once: true }),
+    );
+    const stopped = new Promise<void>((done) =>
+      guest.addEventListener("did-stop-loading", () => done(), { once: true }),
+    );
+    void guest.loadURL(new URL("/slow", guest.src).href).catch(() => {});
+    await began;
+    guest.stop();
+    await stopped;
+    await guest.loadURL(new URL("/", guest.src).href);
+    check(
+      String(await guest.executeJavaScript("document.body.textContent")).includes("Browser proof"),
+      "Stop left guest unusable",
+    );
+  });
+  await act(async () => root.unmount());
+  guest.remove();
+  node.remove();
+  return results;
+})();
diff --git a/scripts/desktop-review-guard.mjs b/scripts/desktop-review-guard.mjs
new file mode 100644
index 0000000..d3cb41c
--- /dev/null
+++ b/scripts/desktop-review-guard.mjs
@@ -0,0 +1,46 @@
+import { readFile } from "node:fs/promises";
+import { resolve, join } from "node:path";
+import { spawnSync } from "node:child_process";
+import { createRequire } from "node:module";
+const require = createRequire(import.meta.url);
+
+export async function assertDesktopReviewStopped(root) {
+  // Reuse the development review records: a self-check must not start another Electron
+  // beside the visible candidate. This optional guard does not make standalone builds depend on Fleet.
+  const reviews = resolve(root, "../../.fleet/reviews");
+  for (const name of [
+    "project-audit/desktop",
+    "native-executor",
+    "attachment-preview",
+    "model-settings",
+  ]) {
+    let saved;
+    try {
+      saved = JSON.parse(await readFile(join(reviews, name, "review.json"), "utf8"));
+    } catch {
+      continue;
+    }
+    if (
+      !Number.isSafeInteger(saved.pid) ||
+      saved.pid <= 0 ||
+      saved.executable !== require("electron")
+    )
+      continue;
+    try {
+      process.kill(saved.pid, 0);
+    } catch (error) {
+      if (error.code === "ESRCH") continue;
+      throw error;
+    }
+    if (
+      process.platform !== "win32" &&
+      !/Fleet|Electron/i.test(
+        spawnSync("ps", ["-p", String(saved.pid), "-o", "comm="], { encoding: "utf8" }).stdout,
+      )
+    )
+      continue;
+    throw new Error(
+      "Close the existing Fleet review before renderer self-checks; no second Electron was started.",
+    );
+  }
+}
diff --git a/scripts/test-embedded-browser.mjs b/scripts/test-embedded-browser.mjs
new file mode 100644
index 0000000..f014747
--- /dev/null
+++ b/scripts/test-embedded-browser.mjs
@@ -0,0 +1,135 @@
+// Native guest proof: real Chromium find, preload keyboard bridge and a local MV3 fixture.
+// No user profile, downloaded extension, account, external network or paid inference is used.
+import { mkdtemp, writeFile, readFile, copyFile, rm, mkdir } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { createRequire } from "node:module";
+import { spawn } from "node:child_process";
+import { assertDesktopReviewStopped } from "./desktop-review-guard.mjs";
+
+const root = resolve(import.meta.dirname, "..");
+const require = createRequire(import.meta.url);
+const { build } = createRequire(new URL("../apps/zcode-cli/package.json", import.meta.url))(
+  "esbuild",
+);
+await assertDesktopReviewStopped(root);
+const profile = await mkdtemp(join(tmpdir(), "fleet-browser-proof-"));
+try {
+  await mkdir(join(profile, "extension"));
+  await writeFile(
+    join(profile, "extension/manifest.json"),
+    JSON.stringify({
+      manifest_version: 3,
+      name: "Fleet local compatibility fixture",
+      version: "1.0.0",
+      permissions: ["storage", "tabs"],
+      host_permissions: ["http://127.0.0.1/*"],
+      background: { service_worker: "worker.js" },
+      action: { default_popup: "popup.html" },
+      content_scripts: [{ matches: ["http://127.0.0.1/*"], js: ["content.js"] }],
+    }),
+  );
+  await writeFile(join(profile, "extension/popup.html"), "<p>Local fixture</p>");
+  await writeFile(
+    join(profile, "extension/worker.js"),
+    `
+chrome.runtime.onMessage.addListener((_message, sender, reply) => {
+  chrome.storage.local.set({fixture:true}).then(async () => {
+    const stored = await chrome.storage.local.get('fixture');
+    const tabs = await chrome.tabs.query({});
+    reply({worker:true, storage:stored.fixture, senderTab:sender.tab?.id,
+      tabs:tabs.map(t=>t.id), tabsCreate:typeof chrome.tabs.create, action:typeof chrome.action,
+      contextMenus:typeof chrome.contextMenus, declarativeNetRequest:typeof chrome.declarativeNetRequest,
+      nativeMessaging:typeof chrome.runtime.connectNative, storageSync:typeof chrome.storage.sync});
+  }).catch(e=>reply({worker:true,error:String(e)}));
+  return true;
+});`,
+  );
+  await writeFile(
+    join(profile, "extension/content.js"),
+    `
+document.documentElement.dataset.extensionContent = 'yes';
+chrome.runtime.sendMessage({probe:true}, result => {
+  document.documentElement.dataset.extensionProbe = JSON.stringify(result ?? {error:chrome.runtime.lastError?.message});
+});`,
+  );
+  await build({
+    entryPoints: [join(root, "packages/desktop/src/preload/embeddedBrowserJavaScriptDialog.ts")],
+    outfile: join(profile, "preload.cjs"),
+    bundle: true,
+    format: "cjs",
+    platform: "node",
+    external: ["electron"],
+    tsconfig: join(root, "packages/desktop/tsconfig.json"),
+  });
+  await build({
+    entryPoints: [join(root, "packages/ui/test/embeddedBrowser.browser.tsx")],
+    outfile: join(profile, "test.js"),
+    bundle: true,
+    platform: "browser",
+    format: "esm",
+    tsconfig: join(root, "packages/ui/tsconfig.json"),
+    loader: { ".svg": "dataurl", ".png": "dataurl" },
+    define: {
+      "process.env.NODE_ENV": '"development"',
+      "import.meta.env.DEV": "false",
+      "import.meta.env.PROD": "true",
+    },
+  });
+  const renderer = join(root, "packages/desktop/out/renderer");
+  const html = await readFile(join(renderer, "index.html"), "utf8");
+  const css = html.match(/href="([^"\n]+\.css)"/)?.[1];
+  if (!css) throw new Error("Build desktop styles before this proof");
+  await copyFile(join(renderer, css), join(profile, "test.css"));
+  await writeFile(
+    join(profile, "index.html"),
+    '<link rel="stylesheet" href="./test.css"><script type="module" src="./test.js"></script>',
+  );
+  await writeFile(
+    join(profile, "main.cjs"),
+    `
+const {app,BrowserWindow,session} = require('electron');
+const http = require('node:http');
+app.setPath('userData', ${JSON.stringify(join(profile, "data"))});
+if(process.platform==='darwin') app.dock.hide();
+const server=http.createServer((req,res)=>{
+  if(req.url==='/slow'){res.write('<h1>Pending</h1>');return;}
+  res.end('<h1>Browser proof</h1><p>needle needle</p><input id="field" value="original"><a href="/next">Open next</a>');
+});
+app.whenReady().then(async()=>{
+  await new Promise(done=>server.listen(0,'127.0.0.1',done));
+  const port=server.address().port;
+  const ses=session.fromPartition('persist:fleet-browser-proof');
+  ses.webRequest.onBeforeRequest({urls:['http://*/*','https://*/*']},(r,cb)=>cb({cancel:new URL(r.url).origin!=='http://127.0.0.1:'+port}));
+  const extension=await ses.extensions.loadExtension(${JSON.stringify(join(profile, "extension"))});
+  console.log('Extension loaded:',extension.id,'Electron',process.versions.electron,'Chrome',process.versions.chrome);
+  // Only one disposable window is opened, after the current Fleet review has closed.
+  const win=new BrowserWindow({show:true,width:640,height:600,webPreferences:{webviewTag:true,sandbox:true,contextIsolation:true}});
+  win.webContents.on('will-attach-webview',(_event,prefs)=>{
+    prefs.preload=${JSON.stringify(join(profile, "preload.cjs"))};
+    prefs.sandbox=true;prefs.contextIsolation=true;prefs.nodeIntegration=false;
+  });
+  await win.loadFile(${JSON.stringify(join(profile, "index.html"))},{query:{port:String(port)}});
+  const results=await win.webContents.executeJavaScript('window.__embeddedBrowserTests');
+  if(!Array.isArray(results)) throw new Error('Browser proof did not run');
+  for(const r of results) console.log((r.error?'FAIL ':'PASS ')+r.name+(r.error?': '+r.error:''));
+  const report=await win.webContents.executeJavaScript('window.__extensionReport');
+  console.log('Native extension compatibility:',JSON.stringify(report));
+  app.exit(results.some(r=>r.error)?1:0);
+}).catch(e=>{console.error(e);app.exit(1)});
+setTimeout(()=>{console.error('Browser proof timed out');app.exit(1)},45000);
+`,
+  );
+  const env = { ...process.env };
+  delete env.ELECTRON_RUN_AS_NODE;
+  process.exitCode = await new Promise((done, reject) => {
+    const child = spawn(require("electron"), [join(profile, "main.cjs")], {
+      env,
+      stdio: "inherit",
+    });
+    child.on("error", reject);
+    child.on("exit", (code) => done(code ?? 1));
+  });
+} finally {
+  await rm(profile, { recursive: true, force: true });
+}
