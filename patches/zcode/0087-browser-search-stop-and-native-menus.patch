diff --git a/packages/ui/src/browser-use/BrowserFindBar.tsx b/packages/ui/src/browser-use/BrowserFindBar.tsx
new file mode 100644
index 0000000..ffb7e54
--- /dev/null
+++ b/packages/ui/src/browser-use/BrowserFindBar.tsx
@@ -0,0 +1,65 @@
+import { useEffect, useRef } from "react";
+import { ChevronDown, ChevronUp, X } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Input } from "@/components/ui/input.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { useBrowserFind } from "./useBrowserFind.js";
+
+export function BrowserFindBar({ find }: { find: ReturnType<typeof useBrowserFind> }) {
+  const { intl } = useZCodeIntl();
+  const input = useRef<HTMLInputElement>(null);
+  useEffect(() => {
+    input.current?.focus();
+    input.current?.select();
+  }, [find.focusVersion]);
+  const label = intl.formatMessage({ id: "browser.find" });
+  return (
+    <div
+      role="search"
+      aria-label={label}
+      className="flex shrink-0 items-center gap-1 border-b border-border px-3 pb-2"
+    >
+      <Input
+        ref={input}
+        size="sm"
+        className="h-7"
+        value={find.query}
+        maxLength={2048}
+        aria-label={label}
+        placeholder={label}
+        onChange={(event) => find.setQuery(event.target.value)}
+        onKeyDown={(event) => {
+          if (event.key !== "Enter" || event.nativeEvent.isComposing) return;
+          event.preventDefault();
+          if (event.shiftKey) find.previous();
+          else find.next();
+        }}
+      />
+      <span aria-live="polite" className="shrink-0 text-ui-sm text-foreground-subtle tabular-nums">
+        {find.query ? `${find.result.activeMatchOrdinal}/${find.result.matches}` : "—"}
+      </span>
+      {[
+        { id: "browser.find.previous", icon: ChevronUp, action: find.previous },
+        { id: "browser.find.next", icon: ChevronDown, action: find.next },
+        { id: "browser.find.close", icon: X, action: () => find.close() },
+      ].map(({ id, icon: Icon, action }) => {
+        const title = intl.formatMessage({ id });
+        return (
+          <ControlHintTooltip key={id} title={title}>
+            <Button
+              type="button"
+              variant="ghost"
+              size="icon-md"
+              aria-label={title}
+              disabled={id !== "browser.find.close" && find.result.matches === 0}
+              onClick={action}
+            >
+              <Icon className="size-4" />
+            </Button>
+          </ControlHintTooltip>
+        );
+      })}
+    </div>
+  );
+}
