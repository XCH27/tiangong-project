diff --git a/packages/ui/src/browser-use/useBrowserFind.ts b/packages/ui/src/browser-use/useBrowserFind.ts
new file mode 100644
index 0000000..7daae4b
--- /dev/null
+++ b/packages/ui/src/browser-use/useBrowserFind.ts
@@ -0,0 +1,117 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { EmbeddedBrowserWebviewChannels } from "@zcode/shared";
+import { safeWebviewCall } from "@/embeddedBrowserHelpers.js";
+
+/** Find belongs to this guest, never to the active conversation or another browser tab. */
+export function useBrowserFind(
+  webview: ElectronWebviewTag | null,
+  isVisible: boolean,
+  isReady: boolean,
+) {
+  const [isOpen, setIsOpen] = useState(false);
+  const [focusVersion, setFocusVersion] = useState(0);
+  const [query, setQuery] = useState("");
+  const [result, setResult] = useState({ activeMatchOrdinal: 0, matches: 0 });
+  const requestId = useRef<number | null>(null);
+
+  const close = useCallback(
+    (restoreFocus = true) => {
+      requestId.current = null;
+      setIsOpen(false);
+      setResult({ activeMatchOrdinal: 0, matches: 0 });
+      if (webview)
+        safeWebviewCall(() => {
+          webview.stopFindInPage("clearSelection");
+          if (restoreFocus && isVisible) webview.focus();
+        }, undefined);
+    },
+    [isVisible, webview],
+  );
+
+  const open = useCallback(() => {
+    if (!webview || !isReady || !isVisible) return;
+    setIsOpen(true);
+    setFocusVersion((value) => value + 1);
+  }, [isReady, isVisible, webview]);
+
+  const find = useCallback(
+    (forward: boolean, newSession: boolean) => {
+      if (!webview || !isReady || !query) return;
+      requestId.current = safeWebviewCall(
+        // Electron 41 maps its misleadingly named findNext to Chromium's new_session.
+        // A new query must start a session; subsequent next/previous calls reuse it.
+        () => webview.findInPage(query, { forward, findNext: newSession }),
+        null,
+      );
+    },
+    [isReady, query, webview],
+  );
+
+  useEffect(() => {
+    if (!isOpen || !isReady || !webview) return;
+    requestId.current = null;
+    setResult({ activeMatchOrdinal: 0, matches: 0 });
+    if (query) find(true, true);
+    else safeWebviewCall(() => webview.stopFindInPage("clearSelection"), undefined);
+  }, [find, isOpen, isReady, query, webview]);
+
+  useEffect(() => {
+    if (!webview) return;
+    const onResult = (event: ElectronWebviewFoundInPageEvent) => {
+      // Chromium can finish an older query after the next request/navigation. Ignore it.
+      if (event.result.requestId !== requestId.current) return;
+      setResult({
+        activeMatchOrdinal: event.result.activeMatchOrdinal,
+        matches: event.result.matches,
+      });
+    };
+    const onNavigation = (event: ElectronWebviewNavigationEvent) => {
+      if (event.isMainFrame !== false) close(false);
+    };
+    const onShortcut = (event: ElectronWebviewIpcMessageEvent) => {
+      if (event.channel === EmbeddedBrowserWebviewChannels.Find && isVisible) open();
+    };
+    const onCrash = () => close(false);
+    webview.addEventListener("found-in-page", onResult);
+    webview.addEventListener("did-navigate", onNavigation);
+    webview.addEventListener("did-navigate-in-page", onNavigation);
+    webview.addEventListener("ipc-message", onShortcut);
+    webview.addEventListener("render-process-gone", onCrash);
+    return () => {
+      webview.removeEventListener("found-in-page", onResult);
+      webview.removeEventListener("did-navigate", onNavigation);
+      webview.removeEventListener("did-navigate-in-page", onNavigation);
+      webview.removeEventListener("ipc-message", onShortcut);
+      webview.removeEventListener("render-process-gone", onCrash);
+    };
+  }, [close, isVisible, open, webview]);
+
+  useEffect(() => {
+    if (!isVisible) return;
+    const onKey = (event: KeyboardEvent) => {
+      if ((event.metaKey || event.ctrlKey) && !event.altKey && event.key.toLowerCase() === "f") {
+        if (!isReady) return;
+        event.preventDefault();
+        event.stopPropagation();
+        open();
+      } else if (isOpen && event.key === "Escape") {
+        event.preventDefault();
+        close();
+      }
+    };
+    window.addEventListener("keydown", onKey, true);
+    return () => window.removeEventListener("keydown", onKey, true);
+  }, [close, isOpen, isReady, isVisible, open]);
+
+  return {
+    isOpen,
+    focusVersion,
+    query,
+    result,
+    open,
+    close,
+    setQuery,
+    next: () => find(true, false),
+    previous: () => find(false, false),
+  };
+}
