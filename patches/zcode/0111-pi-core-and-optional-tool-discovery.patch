diff --git a/apps/zcode-cli/packages/core/test/deferred-tools.test.ts b/apps/zcode-cli/packages/core/test/deferred-tools.test.ts
new file mode 100644
index 0000000..354077a
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/deferred-tools.test.ts
@@ -0,0 +1,336 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import type { ToolEntry } from "../src/tool/types.js";
+import { registerMcpTools } from "../src/mcp/index.js";
+
+const optionalName = (index: number) => `mcp__fixture__export_${index}`;
+const search = (id = "search", query = optionalName(0)) => ({
+  id,
+  name: "SearchTools",
+  input: { query, limit: 1 },
+});
+const invoke = (id = "invoke", name = optionalName(0)) => ({
+  id,
+  name,
+  input: { value: "document-saved" },
+});
+async function catalog(streaming = false, count = 25) {
+  const f = await fixture(undefined, streaming, {
+    config: { toolAllowlist: ["Probe", "SearchTools"] },
+  });
+  let optionalEffects = 0;
+  const install = () => {
+    const registry = f.runtime.getToolRegistry();
+    const template = registry.get("Probe")!;
+    for (let index = 0; index < count; index++)
+      registry.register({
+        ...template,
+        deferLoading: true,
+        metadata: {
+          ...template.metadata,
+          name: optionalName(index),
+          description:
+            `Export a document with formatter ${index}. ` +
+            "Detailed optional formatter instructions. ".repeat(30),
+        },
+        handler: async (input: unknown) => {
+          optionalEffects++;
+          return { saved: (input as { value: string }).value };
+        },
+      } as ToolEntry);
+    f.runtime.invalidateToolCache();
+  };
+  install();
+  return { f, install, effects: () => optionalEffects, close: () => f.close() };
+}
+const wireChars = (tools: any[]) =>
+  JSON.stringify(
+    tools.map(({ name, description, inputSchema }) => ({ name, description, inputSchema })),
+  ).length;
+
+for (const streaming of [false, true])
+  test(`optional discovery loads one exact tool through original permission and receipts (${streaming ? "streaming" : "non-streaming"})`, async () => {
+    const c = await catalog(streaming),
+      { f } = c;
+    const originalChars = wireChars(f.runtime.getTools());
+    let initialChars = 0;
+    try {
+      f.steps.push(
+        (request) => {
+          initialChars = wireChars(request.tools);
+          assert.deepEqual(
+            request.tools.map((tool: any) => tool.name),
+            ["SearchTools", "Probe"],
+          );
+          // A hallucinated hidden operation is rejected even alongside a valid search.
+          return reply("find formatter", [search(), invoke("too-early")]);
+        },
+        (request) => {
+          assert.ok(request.tools.some((tool: any) => tool.name === optionalName(0)));
+          assert.equal(
+            request.tools.filter((tool: any) => tool.name.startsWith("mcp__")).length,
+            1,
+          );
+          assert.equal(c.effects(), 0);
+          assert.ok(
+            JSON.stringify(request.messages).includes(
+              "not available in this admitted model request",
+            ),
+          );
+          return reply("export", [invoke()]);
+        },
+        (request) => {
+          assert.ok(JSON.stringify(request.messages).includes("document-saved"));
+          return reply("complete");
+        },
+      );
+      assert.equal(
+        (await f.runtime.executeTurn("Export the document with formatter zero")).response,
+        "complete",
+      );
+      assert.equal(c.effects(), 1);
+      assert.equal(f.permissionCalls, 1);
+      assert.equal(f.requests.length, 3);
+      assert.ok(
+        initialChars < originalChars / 5,
+        `Projection grew: ${initialChars}/${originalChars}`,
+      );
+      console.log(
+        JSON.stringify({
+          fixture: "optional-tools",
+          streaming,
+          fullDeclarationChars: originalChars,
+          initialDeclarationChars: initialChars,
+          loadedTools: 1,
+          providerCalls: f.requests.length,
+        }),
+      );
+      const ledger = await f.store.queryAppUsage({
+        since: 0,
+        until: Date.now() + 1,
+        tzOffsetMs: 0,
+      });
+      assert.equal(ledger.toolTotals.toolCallCount, 3); // search + denied early invoke + admitted invoke
+      assert.equal(ledger.totals.modelRequestCount, 3);
+      await f.reopen();
+      c.install();
+      f.steps.push((request) => {
+        assert.ok(
+          !request.tools.some((tool: any) => tool.name === optionalName(0)),
+          "Cold new input borrowed an earlier discovery",
+        );
+        assert.ok(JSON.stringify(request.messages).includes("document-saved"));
+        return reply("history retained");
+      });
+      assert.equal(
+        (await f.runtime.executeTurn("Continue reading history")).response,
+        "history retained",
+      );
+      assert.equal(c.effects(), 1);
+    } finally {
+      await c.close();
+    }
+  });
+
+test("discovered operations still require the original permission decision", async () => {
+  const c = await catalog(),
+    { f } = c;
+  try {
+    f.deny();
+    f.steps.push(
+      () => reply("find", [search()]),
+      () => reply("try", [invoke()]),
+      (request) => {
+        assert.ok(JSON.stringify(request.messages).includes("denied"));
+        return reply("refused");
+      },
+    );
+    await f.runtime.executeTurn("Try a document export");
+    assert.equal(c.effects(), 0);
+    assert.equal(f.permissionCalls, 1);
+  } finally {
+    await c.close();
+  }
+});
+
+for (const change of ["replace", "handler", "schema", "remove"] as const)
+  test(`a ${change} after discovery retires the old tool binding`, async () => {
+    const c = await catalog(),
+      { f } = c;
+    try {
+      let changed = false;
+      const runtime = f.runtime as any,
+        persist = runtime.persistPart.bind(runtime);
+      runtime.persistPart = async (part: any, ...args: any[]) => {
+        const result = await persist(part, ...args);
+        if (
+          !changed &&
+          part.type === "tool" &&
+          part.tool === "SearchTools" &&
+          part.state?.status === "completed"
+        ) {
+          changed = true;
+          const registry = f.runtime.getToolRegistry(),
+            entry = registry.get(optionalName(0))!;
+          if (change === "remove") registry.unregister(optionalName(0));
+          else if (change === "replace")
+            registry.register(
+              {
+                ...entry,
+                handler: async () => {
+                  throw new Error("replacement must not run");
+                },
+              },
+              { silentDuplicateWarning: true },
+            );
+          else if (change === "handler")
+            entry.handler = async () => {
+              throw new Error("Changed handler must not run");
+            };
+          else
+            entry.inputSchema = {
+              type: "object",
+              properties: { replacement: { type: "string" } },
+              required: ["replacement"],
+            };
+          f.runtime.invalidateToolCache();
+        }
+        return result;
+      };
+      f.steps.push(
+        () => reply("find", [search()]),
+        (request) => {
+          assert.ok(changed);
+          assert.ok(!request.tools.some((tool: any) => tool.name === optionalName(0)));
+          return reply("rediscover", [search("again")]);
+        },
+        (request) => {
+          const tool = request.tools.find((tool: any) => tool.name === optionalName(0));
+          if (change === "remove") assert.equal(tool, undefined);
+          else {
+            assert.ok(tool);
+            if (change === "schema") assert.deepEqual(tool.inputSchema.required, ["replacement"]);
+          }
+          return reply("reconciled");
+        },
+      );
+      await f.runtime.executeTurn("Discover without stale execution");
+      assert.equal(c.effects(), 0);
+      assert.equal(f.permissionCalls, 0);
+    } finally {
+      await c.close();
+    }
+  });
+
+test("turn restrictions remain undiscoverable and unavailable", async () => {
+  const c = await catalog(),
+    { f } = c;
+  try {
+    f.steps.push(
+      () => reply("find", [search()]),
+      (request) => {
+        assert.ok(!request.tools.some((tool: any) => tool.name === optionalName(0)));
+        const results = request.messages.filter((message: any) => message.role === "tool");
+        assert.deepEqual(JSON.parse(results[0].content), { tools: [] });
+        return reply("unavailable");
+      },
+    );
+    await f.runtime.executeTurn("Find a restricted tool", undefined, {
+      toolDisallowlist: [optionalName(0)],
+    });
+    assert.equal(c.effects(), 0);
+  } finally {
+    await c.close();
+  }
+});
+
+test("small optional catalog preserves direct tools without a search step", async () => {
+  const c = await catalog(false, 1),
+    { f } = c;
+  try {
+    f.steps.push(
+      (request) => {
+        assert.ok(request.tools.some((tool: any) => tool.name === optionalName(0)));
+        assert.ok(!request.tools.some((tool: any) => tool.name === "SearchTools"));
+        return reply("direct", [invoke()]);
+      },
+      () => reply("complete"),
+    );
+    await f.runtime.executeTurn("Export directly");
+    assert.equal(c.effects(), 1);
+  } finally {
+    await c.close();
+  }
+});
+
+test("real MCP registration is deferred and invokes its existing semantic transport once", async () => {
+  const f = await fixture(undefined, true, { config: { toolAllowlist: ["Probe", "SearchTools"] } });
+  const calls: unknown[] = [];
+  const port = {
+    callTool: async (input: unknown) => {
+      calls.push(input);
+      return { content: [{ type: "text", text: "MCP_DOCUMENT_RECEIPT" }] };
+    },
+  };
+  const descriptors = Array.from({ length: 20 }, (_, i) => ({
+    serverName: "documents",
+    toolName: `export_${i}`,
+    description: `Document export ${i}. ` + "Optional operation specification. ".repeat(30),
+    inputSchema: { type: "object", properties: { value: { type: "string" } }, required: ["value"] },
+    annotations: { readOnlyHint: false, destructiveHint: false },
+  }));
+  try {
+    registerMcpTools(f.runtime.getToolRegistry(), port as never, descriptors);
+    f.runtime.invalidateToolCache();
+    const name = "mcp__documents__export_0";
+    assert.equal(f.runtime.getToolRegistry().get(name)?.deferLoading, true);
+    f.steps.push(
+      (request) => {
+        assert.ok(!request.tools.some((t: any) => t.name === name));
+        return reply("search", [search("actual", name)]);
+      },
+      (request) => {
+        assert.ok(request.tools.some((t: any) => t.name === name));
+        return reply("invoke", [invoke("actual-call", name)]);
+      },
+      (request) => {
+        assert.ok(JSON.stringify(request.messages).includes("MCP_DOCUMENT_RECEIPT"));
+        return reply("complete");
+      },
+    );
+    await f.runtime.executeTurn("Export through the connected document service");
+    assert.equal(calls.length, 1);
+    assert.equal(f.permissionCalls, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("failed search-result persistence cannot expose tools or execute a later request", async () => {
+  const c = await catalog(),
+    { f } = c;
+  try {
+    const runtime = f.runtime as any,
+      persist = runtime.persistPart.bind(runtime);
+    runtime.persistPart = async (part: any, ...args: any[]) => {
+      if (part.type === "tool" && part.tool === "SearchTools" && part.state?.status === "completed")
+        throw new Error("Fixture discovery save failed");
+      return persist(part, ...args);
+    };
+    f.steps.push(() => reply("search", [search()]));
+    await assert.rejects(f.runtime.executeTurn("Discover a formatter"));
+    assert.equal(f.requests.length, 1);
+    assert.equal(c.effects(), 0);
+    await f.reopen();
+    c.install();
+    f.steps.push((request) => {
+      assert.ok(!request.tools.some((t: any) => t.name === optionalName(0)));
+      return reply("fresh input");
+    });
+    await f.runtime.executeTurn("Start again after recovery");
+    assert.equal(c.effects(), 0);
+  } finally {
+    await c.close();
+  }
+});
