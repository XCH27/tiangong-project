+++ b/apps/zcode-cli/packages/core/src/tool/handlers/search-tools.ts
@@ -0,0 +1,88 @@
+import { z } from "zod";
+import type { ToolEntry } from "../types.js";
+
+export const SEARCH_TOOLS_NAME = "SearchTools";
+const input = z
+  .object({
+    query: z.string().trim().min(1).max(256),
+    limit: z.number().int().min(1).max(5).optional(),
+  })
+  .strict();
+export interface ToolSearchResult {
+  tools: { name: string; description: string }[];
+}
+export type SearchAvailableTools = (query: string, limit: number) => ToolSearchResult;
+
+/** Discovery only; the next request calls the original tool through its original permission path. */
+export const searchToolsEntry: ToolEntry = {
+  capability: "Discover selected optional tools without executing them",
+  metadata: {
+    name: SEARCH_TOOLS_NAME,
+    description:
+      "Find optional connected tools for browser, media, documents or external services. Use a concise query with relevant English tool or capability terms. Matching tool definitions load in the next request; call their original names then. Discovery grants no permission. If no match, try a different query or explain the missing capability.",
+    readOnly: true,
+    destructive: false,
+    concurrentSafe: true,
+    sideEffectScope: "none",
+    riskLevel: "low",
+    needsApproval: false,
+  },
+  inputSchema: {
+    type: "object",
+    properties: {
+      query: { type: "string", minLength: 1, maxLength: 256 },
+      limit: { type: "integer", minimum: 1, maximum: 5 },
+    },
+    required: ["query"],
+    additionalProperties: false,
+  },
+  runtimeInputSchema: input,
+  outputSchema: {
+    type: "object",
+    properties: {
+      tools: {
+        type: "array",
+        items: {
+          type: "object",
+          properties: { name: { type: "string" }, description: { type: "string" } },
+          required: ["name", "description"],
+        },
+      },
+    },
+    required: ["tools"],
+  },
+  handler: async (value, context) => {
+    const request = input.parse(value);
+    context.abortSignal.throwIfAborted();
+    if (!context.searchAvailableTools)
+      throw new Error("Tool discovery is unavailable in this request");
+    return context.searchAvailableTools(request.query, request.limit ?? 5);
+  },
+  permission: {
+    permission: "tools.search",
+    riskLevel: "low",
+    sideEffectScope: "none",
+    needsApproval: false,
+    reason: "Discover available optional tools",
+    patternSources: ["toolName"],
+    denyPriority: "beforeAsk",
+  },
+  resultBudget: {
+    maxInlineBytes: 4096,
+    maxModelBytes: 4096,
+    strategy: "truncate",
+    preview: { maxBytes: 4096, direction: "head" },
+  },
+  timeout: { kind: "timed", defaultMs: 10000, maxMs: 10000, allowCallOverride: false },
+  cancellation: {
+    supported: true,
+    cleanup: "none",
+    userVisibleMessage: "Tool discovery cancelled",
+  },
+  trace: {
+    required: true,
+    propagateToAdapters: false,
+    recordInput: "summary",
+    recordOutput: "summary",
+  },
+};
