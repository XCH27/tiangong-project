diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/deferred-tools.ts b/apps/zcode-cli/packages/core/src/runtime/methods/deferred-tools.ts
new file mode 100644
index 0000000..cf613b1
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/deferred-tools.ts
@@ -0,0 +1,127 @@
+import type { ModelToolContract } from "@zcode/contracts";
+import type { ToolEntry, ToolExecutionResult } from "../../tool/types.js";
+import {
+  SEARCH_TOOLS_NAME,
+  type SearchAvailableTools,
+  type ToolSearchResult,
+} from "../../tool/handlers/search-tools.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { RegularTurnLoopState } from "./turn-loop-state.js";
+
+const DEFERRED_DECLARATION_CHAR_THRESHOLD = 8192;
+const MAX_RESULT_DESCRIPTION_CHARS = 240;
+export interface DiscoveredToolBinding {
+  entry: ToolEntry;
+  handler: ToolEntry["handler"];
+  declaration: string;
+}
+const declaration = (tool: ModelToolContract) =>
+  JSON.stringify({
+    name: tool.name,
+    description: tool.description ?? "",
+    inputSchema: tool.inputSchema,
+    strict: tool.strict,
+  });
+
+/** A per-request projection of the existing Registry, never an additional tool authority. */
+export function projectDeferredTools(
+  runtime: AgentRuntimeInternal,
+  state: RegularTurnLoopState,
+  tools: ModelToolContract[],
+  native: boolean,
+): ModelToolContract[] {
+  const direct = tools.filter((tool) => tool.name !== SEARCH_TOOLS_NAME);
+  state.searchAvailableTools = undefined;
+  state.searchToolCandidates = undefined;
+  if (native || !tools.some((tool) => tool.name === SEARCH_TOOLS_NAME)) {
+    state.discoveredToolBindings?.clear();
+    return direct;
+  }
+  const deferred = direct.filter(
+    (tool) => !tool.providerNative && runtime.registry.get(tool.name)?.deferLoading === true,
+  );
+  if (
+    deferred.reduce((chars, tool) => chars + declaration(tool).length, 0) <=
+    DEFERRED_DECLARATION_CHAR_THRESHOLD
+  ) {
+    state.discoveredToolBindings?.clear();
+    return direct;
+  }
+  const candidates = new Map<string, DiscoveredToolBinding>();
+  for (const tool of deferred) {
+    const entry = runtime.registry.get(tool.name);
+    if (entry)
+      candidates.set(tool.name, { entry, handler: entry.handler, declaration: declaration(tool) });
+  }
+  state.discoveredToolBindings ??= new Map();
+  // 撤销、重注册和模型投影变化都退休旧发现；已有搜索结果不等于当前执行许可。
+  for (const [name, binding] of state.discoveredToolBindings) {
+    const current = candidates.get(name);
+    if (
+      !current ||
+      current.entry !== binding.entry ||
+      current.handler !== binding.handler ||
+      current.declaration !== binding.declaration
+    )
+      state.discoveredToolBindings.delete(name);
+  }
+  state.searchToolCandidates = candidates;
+  const snapshot = deferred.map((tool) => ({
+    name: tool.name,
+    description: tool.description ?? "",
+  }));
+  state.searchAvailableTools = (query, limit) => {
+    const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
+    const ranked = snapshot
+      .map((tool) => {
+        const text = `${tool.name} ${tool.description}`.toLocaleLowerCase();
+        const score = terms.reduce(
+          (sum, term) =>
+            sum +
+            (text.includes(term) ? 1 : 0) +
+            (tool.name.toLocaleLowerCase().includes(term) ? 2 : 0),
+          0,
+        );
+        return { tool, score };
+      })
+      .filter(
+        ({ tool, score }) =>
+          score > 0 && runtime.registry.get(tool.name) === candidates.get(tool.name)?.entry,
+      )
+      .sort((a, b) => b.score - a.score || a.tool.name.localeCompare(b.tool.name))
+      .slice(0, limit);
+    return {
+      tools: ranked.map(({ tool }) => ({
+        name: tool.name,
+        description: tool.description.slice(0, MAX_RESULT_DESCRIPTION_CHARS),
+      })),
+    };
+  };
+  return tools.filter(
+    (tool) => !candidates.has(tool.name) || state.discoveredToolBindings!.has(tool.name),
+  );
+}
+
+/** Called after the original completed tool result has been persisted. No same-batch expansion. */
+export function acceptToolDiscovery(
+  state: RegularTurnLoopState,
+  results: readonly ToolExecutionResult[],
+): void {
+  for (const result of results) {
+    if (
+      !result.success ||
+      result.toolName !== SEARCH_TOOLS_NAME ||
+      !state.searchToolCandidates ||
+      !state.discoveredToolBindings
+    )
+      continue;
+    const output = result.output as Partial<ToolSearchResult> | null;
+    if (!output || !Array.isArray(output.tools)) continue;
+    for (const tool of output.tools) {
+      const candidate = state.searchToolCandidates.get(tool.name);
+      if (candidate) state.discoveredToolBindings.set(tool.name, candidate);
+    }
+  }
+}
+
+export type { SearchAvailableTools };
