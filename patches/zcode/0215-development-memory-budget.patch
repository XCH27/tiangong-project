diff --git a/scripts/renderer-test-process.mjs b/scripts/renderer-test-process.mjs
new file mode 100644
index 00000000..757ca415
--- /dev/null
+++ b/scripts/renderer-test-process.mjs
@@ -0,0 +1,99 @@
+import { execFile, spawn } from "node:child_process";
+
+// Each invocation owns one process group; never target other Electron instances.
+export function runRendererTestProcess(
+  command,
+  args,
+  { env = process.env, stdio = "inherit", timeoutMs = 30_000, killGraceMs = 250 } = {},
+) {
+  if (
+    !Number.isFinite(timeoutMs) ||
+    timeoutMs <= 0 ||
+    !Number.isFinite(killGraceMs) ||
+    killGraceMs < 0
+  )
+    throw new Error("Renderer process deadlines must be finite and positive");
+  return new Promise((resolve, reject) => {
+    const child = spawn(command, args, { env, stdio, detached: process.platform !== "win32" });
+    let reason;
+    let result;
+    let cleanupDone = false;
+    let settled = false;
+    let escalation;
+    let cleanupError;
+    const deadline = setTimeout(() => stop("timeout"), timeoutMs);
+    const onInterrupt = () => stop("SIGINT");
+    const onTerminate = () => stop("SIGTERM");
+    process.on("SIGINT", onInterrupt);
+    process.on("SIGTERM", onTerminate);
+
+    function dispose() {
+      clearTimeout(deadline);
+      clearTimeout(escalation);
+      process.off("SIGINT", onInterrupt);
+      process.off("SIGTERM", onTerminate);
+    }
+    function finish() {
+      if (!settled && cleanupError && cleanupDone && !result) {
+        settled = true;
+        dispose();
+        reject(cleanupError);
+        return;
+      }
+      if (settled || !result || (reason && !cleanupDone)) return;
+      settled = true;
+      dispose();
+      resolve({ ...result, reason: reason ?? "exit", ...(cleanupError ? { cleanupError } : {}) });
+    }
+    function signalGroup(signal) {
+      try {
+        process.kill(-child.pid, signal);
+      } catch (error) {
+        if (error.code !== "ESRCH") cleanupError ??= error;
+      }
+    }
+    function stop(cause) {
+      if (reason || settled) return;
+      reason = cause;
+      clearTimeout(deadline);
+      if (!child.pid) {
+        cleanupDone = true;
+        finish();
+        return;
+      }
+      if (process.platform === "win32") {
+        execFile(
+          "taskkill",
+          ["/PID", String(child.pid), "/T", "/F"],
+          { timeout: 5_000 },
+          (error) => {
+            // A root exit does not prove its descendants exited. Surface every failed cleanup.
+            if (error) cleanupError = error;
+            cleanupDone = true;
+            finish();
+          },
+        );
+      } else {
+        signalGroup("SIGTERM");
+        escalation = setTimeout(() => {
+          // The group can outlive its original parent: always finish escalation.
+          signalGroup("SIGKILL");
+          cleanupDone = true;
+          finish();
+        }, killGraceMs);
+      }
+    }
+    child.once("error", (error) => {
+      if (settled) return;
+      settled = true;
+      dispose();
+      reject(error);
+    });
+    child.once("exit", (code, signal) => {
+      result = { code, signal };
+      if (signal && !reason) stop("signal");
+      else if (code !== 0 && !reason) stop("nonzero");
+      finish();
+    });
+  });
+}
