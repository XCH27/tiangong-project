new file mode 100644
index 00000000..7aa60dca
--- /dev/null
+++ b/scripts/renderer-test-process.test.mjs
@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { runRendererTestProcess } from "./renderer-test-process.mjs";
+
+const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+async function eventually(read, timeout = 5_000) {
+  const until = Date.now() + timeout;
+  do {
+    try {
+      const value = await read();
+      if (value) return value;
+    } catch {}
+    await delay(20);
+  } while (Date.now() < until);
+  throw new Error("Timed out waiting for process evidence");
+}
+function alive(pid) {
+  try {
+    process.kill(pid, 0);
+    // A reparented zombie is terminated and has no running memory workload.
+    if (process.platform !== "win32")
+      return !execFileSync("ps", ["-o", "stat=", "-p", String(pid)], { encoding: "utf8" })
+        .trim()
+        .startsWith("Z");
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+test("renderer child preserves nonzero code and removes parent listeners", async () => {
+  const before = [process.listenerCount("SIGINT"), process.listenerCount("SIGTERM")];
+  assert.deepEqual(
+    await runRendererTestProcess(process.execPath, ["-e", "process.exitCode=7"], {
+      stdio: "ignore",
+    }),
+    { code: 7, signal: null, reason: "nonzero" },
+  );
+  assert.deepEqual([process.listenerCount("SIGINT"), process.listenerCount("SIGTERM")], before);
+});
+
+test("renderer child reports actual signal", { skip: process.platform === "win32" }, async () => {
+  assert.deepEqual(
+    await runRendererTestProcess(process.execPath, ["-e", "process.kill(process.pid,'SIGTERM')"], {
+      stdio: "ignore",
+    }),
+    { code: null, signal: "SIGTERM", reason: "signal" },
+  );
+});
+
+test("spawn failure removes deadline and parent listeners", async () => {
+  const before = [process.listenerCount("SIGINT"), process.listenerCount("SIGTERM")];
+  await assert.rejects(
+    runRendererTestProcess(join(tmpdir(), "missing-renderer-executable"), [], { stdio: "ignore" }),
+    { code: "ENOENT" },
+  );
+  assert.deepEqual([process.listenerCount("SIGINT"), process.listenerCount("SIGTERM")], before);
+});
+
+for (const mode of ["SIGINT", "SIGTERM", "timeout", "nonzero"]) {
+  test(
+    `${mode} stops owned child and grandchild while sentinel survives`,
+    {
+      // process.kill on Windows forcibly terminates a manager instead of delivering POSIX signals.
+      skip: process.platform === "win32" && mode !== "timeout",
+    },
+    async () => {
+      const root = await mkdtemp(join(tmpdir(), "renderer-process-test-"));
+      const pidsPath = join(root, "pids.json");
+      const resultPath = join(root, "result.json");
+      const treePath = join(root, "tree.cjs");
+      const managerPath = join(root, "manager.mjs");
+      const sentinel = spawn(process.execPath, ["-e", "setInterval(()=>{},1000)"], {
+        stdio: "ignore",
+      });
+      let manager;
+      let owned;
+      try {
+        await writeFile(
+          treePath,
+          `
+const {spawn}=require('node:child_process');
+const {writeFileSync}=require('node:fs');
+process.on('SIGTERM',()=>{});
+const grandchild=spawn(process.execPath,['-e',"process.on('SIGTERM',()=>{});process.send('ready');setInterval(()=>{},1000)"],{stdio:['ignore','ignore','ignore','ipc']});
+grandchild.once('message',()=>{
+  writeFileSync(${JSON.stringify(pidsPath)},JSON.stringify([process.pid,grandchild.pid]));
+  ${mode === "nonzero" ? "process.exit(7);" : ""}
+});
+setInterval(()=>{},1000);
+`,
+        );
+        await writeFile(
+          managerPath,
+          `
+import {writeFile} from 'node:fs/promises';
+import {runRendererTestProcess} from ${JSON.stringify(new URL("./renderer-test-process.mjs", import.meta.url).href)};
+const result=await runRendererTestProcess(process.execPath,[${JSON.stringify(treePath)}],{stdio:'ignore',timeoutMs:${mode === "timeout" ? 1000 : 10_000},killGraceMs:100});
+await writeFile(${JSON.stringify(resultPath)},JSON.stringify(result));
+process.exitCode=result.reason==='SIGINT'?130:result.reason==='SIGTERM'?143:result.reason==='nonzero'?result.code:1;
+`,
+        );
+        manager = spawn(process.execPath, [managerPath], { stdio: "ignore" });
+        const exited = new Promise((resolve, reject) => {
+          manager.once("error", reject);
+          manager.once("exit", (code, signal) => resolve({ code, signal }));
+        });
+        owned = await eventually(async () => JSON.parse(await readFile(pidsPath, "utf8")));
+        if (mode === "SIGINT" || mode === "SIGTERM") manager.kill(mode);
+        const result = await eventually(async () => JSON.parse(await readFile(resultPath, "utf8")));
+        assert.equal(result.reason, mode);
+        if (process.platform !== "win32") {
+          assert.equal(result.code, mode === "nonzero" ? 7 : null);
+          if (mode === "nonzero") assert.equal(result.signal, null);
+          else assert.ok(["SIGTERM", "SIGKILL"].includes(result.signal));
+        }
+        assert.deepEqual(await exited, {
+          code: mode === "SIGINT" ? 130 : mode === "SIGTERM" ? 143 : mode === "nonzero" ? 7 : 1,
+          signal: null,
+        });
+        await eventually(() => owned.every((pid) => !alive(pid)));
+        assert.equal(alive(sentinel.pid), true);
+      } finally {
+        if (manager && alive(manager.pid)) manager.kill("SIGKILL");
+        if (owned && process.platform !== "win32") {
+          try {
+            process.kill(-owned[0], "SIGKILL");
+          } catch {}
+        }
+        const sentinelExit = new Promise((resolve) => sentinel.once("exit", resolve));
+        if (alive(sentinel.pid)) {
+          sentinel.kill();
+          await sentinelExit;
+        }
+        await rm(root, { recursive: true, force: true });
+      }
+    },
+  );
+}
