diff --git a/packages/ui/src/LocalHelpDialog.tsx b/packages/ui/src/LocalHelpDialog.tsx
new file mode 100644
index 0000000..944b49c
--- /dev/null
+++ b/packages/ui/src/LocalHelpDialog.tsx
@@ -0,0 +1,43 @@
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog.js";
+import { MessageResponse } from "@/components/ai-elements/message.js";
+import { cn } from "@/components/lib/utils.js";
+import { localHelpSource } from "@/lib/productDocs.js";
+
+/**
+ * Settings 在前台时的本地指南。工作区的侧栏查看器需要先离开 Settings，会卸载未保存的表单
+ * （SHELL-HELP-DRAFT）；这里以对话框覆盖在 Settings 之上，内容与侧栏查看器同源。
+ */
+export function LocalHelpDialog({
+  open,
+  locale,
+  onOpenChange,
+  onOpenExternalUrl,
+}: {
+  open: boolean;
+  locale: string;
+  onOpenChange(open: boolean): void;
+  onOpenExternalUrl?: (url: string) => void;
+}) {
+  const source = localHelpSource(locale);
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-h-[min(85vh,760px)] max-w-2xl overflow-hidden p-0">
+        <DialogHeader className="border-b border-popover-border px-5 pt-4 pb-3">
+          <DialogTitle className="pr-8 text-ui-lg">{source.title}</DialogTitle>
+        </DialogHeader>
+        <div className="max-h-[calc(min(85vh,760px)-4rem)] overflow-y-auto px-5 pb-5">
+          <MessageResponse
+            className={cn(
+              "prose prose-sm max-w-none text-ui-base leading-relaxed text-foreground dark:prose-invert",
+              "prose-headings:font-semibold prose-headings:tracking-tight",
+              "prose-h1:text-ui-lg prose-h2:text-ui-base prose-h3:text-ui-base",
+            )}
+            onOpenExternalUrl={onOpenExternalUrl}
+          >
+            {source.content}
+          </MessageResponse>
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
