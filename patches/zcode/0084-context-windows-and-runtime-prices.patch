diff --git a/packages/shared/src/usage-price-catalog-normalize.ts b/packages/shared/src/usage-price-catalog-normalize.ts
new file mode 100644
index 0000000..078ba1b
--- /dev/null
+++ b/packages/shared/src/usage-price-catalog-normalize.ts
@@ -0,0 +1,160 @@
+import type {
+  CatalogTokenRates,
+  CatalogPrice,
+  CatalogProvider,
+  PriceCatalog,
+} from "./usage-price-catalog.js";
+
+export const USAGE_PRICE_SOURCE_URL = "https://models.dev/api.json";
+const RATE_NAMES = {
+  input: "input",
+  output: "output",
+  cache_read: "cacheRead",
+  cache_write: "cacheWrite",
+  reasoning: "reasoning",
+  input_audio: "inputAudio",
+  output_audio: "outputAudio",
+} as const;
+const RATE_FIELDS = Object.keys(RATE_NAMES);
+const COST_FIELDS = new Set([...RATE_FIELDS, "tiers", "context_over_200k"]);
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === "object" && !Array.isArray(value);
+const isRate = (value: unknown): value is number =>
+  typeof value === "number" &&
+  Number.isFinite(value) &&
+  value >= 0 &&
+  value <= Number.MAX_SAFE_INTEGER;
+
+function safeUrl(value: unknown) {
+  if (typeof value !== "string") return undefined;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && !url.username && !url.password && !url.search && !url.hash
+      ? url.href
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function rates(value: unknown, base?: CatalogTokenRates): CatalogTokenRates | undefined {
+  if (!isRecord(value)) return undefined;
+  for (const field of RATE_FIELDS) {
+    if (Object.hasOwn(value, field) && !isRate(value[field])) return undefined;
+  }
+  const input = value.input ?? base?.input;
+  const output = value.output ?? base?.output;
+  if (!isRate(input) || !isRate(output)) return undefined;
+  const result: CatalogTokenRates = { input, output };
+  for (const [source, destination] of Object.entries(RATE_NAMES)) {
+    const rate = value[source] ?? base?.[destination];
+    if (isRate(rate)) result[destination] = rate;
+  }
+  return result;
+}
+
+function normalizeCost(cost: unknown): CatalogPrice | undefined {
+  if (!isRecord(cost) || Object.keys(cost).some((key) => !COST_FIELDS.has(key))) return undefined;
+  const base = rates(cost);
+  if (!base) return undefined;
+  let tiers: NonNullable<CatalogPrice["tiers"]> | undefined;
+  // models.dev 的显式阈值可能是 256K/272K，不能被旧的 context_over_200k 字段覆盖。
+  if (Object.hasOwn(cost, "tiers")) {
+    if (!Array.isArray(cost.tiers) || cost.tiers.length === 0) return undefined;
+    tiers = [];
+    for (const entry of cost.tiers) {
+      if (
+        !isRecord(entry) ||
+        Object.keys(entry).some((key) => key !== "tier" && !RATE_FIELDS.includes(key)) ||
+        !isRecord(entry.tier) ||
+        Object.keys(entry.tier).some((key) => key !== "type" && key !== "size") ||
+        entry.tier.type !== "context" ||
+        typeof entry.tier.size !== "number" ||
+        !Number.isSafeInteger(entry.tier.size) ||
+        entry.tier.size <= 0 ||
+        !RATE_FIELDS.some((field) => Object.hasOwn(entry, field))
+      )
+        return undefined;
+      const tierRates = rates(entry, base);
+      const above = entry.tier.size;
+      if (!tierRates || tiers.some((tier) => tier.above === above)) return undefined;
+      tiers.push({ above, ...tierRates });
+    }
+    tiers.sort((a, b) => a.above - b.above);
+  } else if (Object.hasOwn(cost, "context_over_200k")) {
+    const legacy = cost.context_over_200k;
+    if (
+      !isRecord(legacy) ||
+      Object.keys(legacy).some((key) => !RATE_FIELDS.includes(key)) ||
+      !RATE_FIELDS.some((field) => Object.hasOwn(legacy, field))
+    )
+      return undefined;
+    const tierRates = rates(legacy, base);
+    if (!tierRates) return undefined;
+    tiers = [{ above: 200_000, ...tierRates }];
+  }
+  return { ...base, ...(tiers ? { tiers } : {}) };
+}
+
+/** Reduce models.dev's USD-per-million text token prices without inventing missing rates. */
+export function normalizeCatalog(
+  payload: unknown,
+  fetchedAt: string,
+  sourceHash: string,
+): PriceCatalog {
+  if (!isRecord(payload) || Object.keys(payload).length === 0)
+    throw new Error("Empty or malformed catalog");
+  if (typeof fetchedAt !== "string" || !Number.isFinite(Date.parse(fetchedAt)))
+    throw new Error("Invalid fetchedAt");
+  if (typeof sourceHash !== "string" || !/^[a-f0-9]{64}$/.test(sourceHash))
+    throw new Error("Invalid sourceHash");
+  const timestamp = new Date(fetchedAt).toISOString();
+  const providers: Array<[string, CatalogProvider]> = [];
+  for (const providerId of Object.keys(payload).sort()) {
+    const provider = payload[providerId];
+    if (
+      !providerId ||
+      !isRecord(provider) ||
+      typeof provider.name !== "string" ||
+      !provider.name.trim() ||
+      !isRecord(provider.models)
+    ) {
+      throw new Error(`Malformed provider: ${providerId}`);
+    }
+    const models: Array<[string, CatalogPrice]> = [];
+    for (const modelId of Object.keys(provider.models).sort()) {
+      const model = provider.models[modelId];
+      const modalities = isRecord(model) && isRecord(model.modalities) ? model.modalities : {};
+      if (
+        !modelId ||
+        !isRecord(model) ||
+        !Array.isArray(modalities.output) ||
+        modalities.output.length !== 1 ||
+        modalities.output[0] !== "text"
+      )
+        continue;
+      const cost = normalizeCost(model.cost);
+      if (cost) models.push([modelId, cost]);
+    }
+    if (!models.length) continue;
+    const api = safeUrl(provider.api);
+    const doc = safeUrl(provider.doc);
+    providers.push([
+      providerId,
+      {
+        name: provider.name,
+        ...(api ? { api } : {}),
+        ...(doc ? { doc } : {}),
+        models: Object.fromEntries(models),
+      },
+    ]);
+  }
+  if (!providers.length) throw new Error("Catalog contains no supported text prices");
+  return {
+    version: `models.dev-${timestamp.slice(0, 10)}-${sourceHash.slice(0, 12)}`,
+    fetchedAt: timestamp,
+    sourceUrl: USAGE_PRICE_SOURCE_URL,
+    sourceHash,
+    providers: Object.fromEntries(providers),
+  };
+}
