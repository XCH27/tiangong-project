+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createUsagePriceCatalogReader } from "../src/storage/usage-price-catalog.js";
+import { SqliteSessionStore } from "../src/storage/session-store/sqlite-session-store.js";
+import { BUNDLED_USAGE_PRICE_CATALOG, estimateUsagePrice } from "@zcode/shared";
+import type { HttpClientRequest, ModelUsageRecord, SessionId, ProjectId } from "@zcode/contracts";
+
+const payload = (input = 1) => ({ fresh: { name: "Fresh", models: { "fresh-model": {
+  modalities: { output: ["text"] }, cost: { input, output: 2, cache_read: 0.1 },
+} } } });
+const response = (body: unknown, status = 200) => ({ status, statusText: "", headers: {},
+  url: "https://models.dev/api.json", body: Buffer.from(JSON.stringify(body)), bytes: 0, durationMs: 0 });
+const time = Date.UTC(2026, 9, 1);
+const facts = { billingProvider: "fresh", modelId: "fresh-model", startedAt: time,
+  inputTokens: 1000, outputTokens: 100, cacheReadTokens: 0, speedMode: "standard" as const };
+
+test("public fetch coalesces concurrent readers, stays anonymous, and refreshes only after six hours", async () => {
+  let at = time;
+  const requests: HttpClientRequest[] = [];
+  let release!: () => void;
+  const gate = new Promise<void>((resolve) => { release = resolve; });
+  const reader = createUsagePriceCatalogReader({ now: () => at, http: { async request(request) {
+    requests.push(request); await gate; return response(payload());
+  } } });
+  assert.equal(reader.peek(), BUNDLED_USAGE_PRICE_CATALOG);
+  const a = reader.read(), b = reader.read();
+  release();
+  assert.equal(await a, await b);
+  assert.equal(requests.length, 1);
+  assert.deepEqual(requests[0], { url: "https://models.dev/api.json", method: "GET",
+    headers: { Accept: "application/json" }, redirect: "manual", timeoutMs: 5000, maxResponseBytes: 12 * 1024 * 1024 });
+  assert.equal(estimateUsagePrice(facts, reader.peek()).estimatedUsd, 0.0012);
+  await reader.read();
+  at += 6 * 60 * 60 * 1000 - 1;
+  await reader.read(); assert.equal(requests.length, 1);
+  at++;
+  await reader.read(); assert.equal(requests.length, 2);
+});
+
+test("restart reuses the hash-checked cache; transient failures retain its dated price and back off", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-price-reader-"));
+  const cachePath = join(dir, "prices.json");
+  let at = time;
+  let calls = 0;
+  try {
+    const reader = createUsagePriceCatalogReader({ cachePath, now: () => at,
+      http: { async request() { return response(payload()); } } });
+    const first = await reader.read();
+    const saved = await readFile(cachePath, "utf8");
+    const restarted = createUsagePriceCatalogReader({ cachePath, now: () => at,
+      http: { async request() { calls++; throw new Error("offline"); } } });
+    assert.equal((await restarted.read()).version, first.version);
+    assert.equal(calls, 0);
+    at += 6 * 60 * 60 * 1000;
+    assert.equal((await restarted.read()).fetchedAt, first.fetchedAt);
+    assert.equal(calls, 1);
+    await restarted.read(); assert.equal(calls, 1);
+    assert.equal(await readFile(cachePath, "utf8"), saved);
+    at += 15 * 60 * 1000;
+    await restarted.read(); assert.equal(calls, 2);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
+
+test("bad download or cache cannot publish partial prices, and a cache write failure retains the download", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-price-validation-"));
+  const cachePath = join(dir, "prices.json");
+  try {
+    for (const bad of ["{", JSON.stringify({}), JSON.stringify({ sourceJson: JSON.stringify(payload(1000)),
+      sourceHash: "a".repeat(64), fetchedAt: new Date(time).toISOString() })]) {
+      await writeFile(cachePath, bad);
+      const reader = createUsagePriceCatalogReader({ cachePath, now: () => time,
+        http: { async request() { return response({}, 503); } } });
+      assert.equal(await reader.read(), BUNDLED_USAGE_PRICE_CATALOG);
+    }
+    for (const invalid of [{}, { fresh: null }, { fresh: { name: "Fresh", models: {} } }]) {
+      const reader = createUsagePriceCatalogReader({ now: () => time, http: { async request() { return response(invalid); } } });
+      assert.equal(await reader.read(), BUNDLED_USAGE_PRICE_CATALOG);
+    }
+    // The cache target is a directory: publication fails, but valid prices remain usable in memory.
+    const reader = createUsagePriceCatalogReader({ cachePath: dir, now: () => time,
+      http: { async request() { return response(payload()); } } });
+    assert.equal((await reader.read()).providers.fresh!.models["fresh-model"]!.input, 1);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
+
+test("live prices fill unpriced facts without ledger writes; duplicate receipts preserve frozen amounts after refresh/reopen", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-price-ledger-"));
+  const dbPath = join(dir, "session.sqlite"), cachePath = join(dir, "prices.json");
+  let at = time, rate = 1;
+  const reader = createUsagePriceCatalogReader({ cachePath, now: () => at,
+    http: { async request() { return response(payload(rate)); } } });
+  let store = new SqliteSessionStore({ dbPath, priceCatalog: reader });
+  const record: ModelUsageRecord = { id: "request", logicalRequestId: "request", sessionID: "s" as SessionId,
+    querySource: "main_turn", providerId: "connection", modelId: facts.modelId, status: "completed", startedAt: time,
+    inputTokens: 1000, outputTokens: 100, rawUsage: { inputTokens: 1000, outputTokens: 100, cacheReadTokens: 0 },
+    providerMetadata: { fleetAccounting: { billingProvider: "fresh", requestedSpeedMode: "standard" } } };
+  const query = () => store.queryAppUsage({ since: time, until: time + 1, tzOffsetMs: 0 });
