@@ -0,0 +1,85 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
+import { dirname } from "node:path";
+import type { HttpClientPort } from "@zcode/contracts";
+import { BUNDLED_USAGE_PRICE_CATALOG, normalizeCatalog, USAGE_PRICE_SOURCE_URL, type PriceCatalog } from "@zcode/shared";
+
+const REFRESH_MS = 6 * 60 * 60 * 1000;
+const RETRY_MS = 15 * 60 * 1000;
+const MAX_BYTES = 12 * 1024 * 1024;
+
+export interface UsagePriceCatalogReader {
+  /** Captured synchronously for a receipt; never delays or changes an admitted model request. */
+  peek(): PriceCatalog;
+  read(): Promise<PriceCatalog>;
+}
+
+/** Public price data only. No credentials, prompts, account IDs or usage leave the Host. */
+export function createUsagePriceCatalogReader(options: {
+  http: Pick<HttpClientPort, "request">;
+  cachePath?: string;
+  now?: () => number;
+}): UsagePriceCatalogReader {
+  const now = options.now ?? Date.now;
+  let current = BUNDLED_USAGE_PRICE_CATALOG;
+  let nextAttempt = 0;
+  let loaded = false;
+  let pending: Promise<PriceCatalog> | undefined;
+  const parse = (bytes: Uint8Array): PriceCatalog => {
+    const value = JSON.parse(Buffer.from(bytes).toString("utf8"));
+    if (!value || typeof value !== "object" || typeof value.sourceJson !== "string" ||
+      Buffer.byteLength(value.sourceJson) > MAX_BYTES || typeof value.fetchedAt !== "string")
+      throw new Error("Invalid price cache");
+    const timestamp = Date.parse(value.fetchedAt);
+    if (!Number.isFinite(timestamp) || timestamp > now() + 60_000)
+      throw new Error("Invalid price cache date");
+    const hash = createHash("sha256").update(value.sourceJson).digest("hex");
+    if (hash !== value.sourceHash) throw new Error("Invalid price cache hash");
+    return normalizeCatalog(JSON.parse(value.sourceJson), value.fetchedAt, hash);
+  };
+  async function refresh(): Promise<PriceCatalog> {
+    if (!loaded) {
+      loaded = true;
+      if (options.cachePath) try {
+        if ((await stat(options.cachePath)).size > MAX_BYTES * 2 + 1024)
+          throw new Error("Price cache is too large");
+        const cached = parse(await readFile(options.cachePath));
+        if (Date.parse(cached.fetchedAt) >= Date.parse(current.fetchedAt)) current = cached;
+      } catch { /* An optional corrupt/missing cache cannot break the usage ledger. */ }
+    }
+    if (now() < nextAttempt || now() - Date.parse(current.fetchedAt) < REFRESH_MS) return current;
+    // Failure backoff starts before IO, so reopen/range changes cannot hammer the public directory.
+    nextAttempt = now() + RETRY_MS;
+    try {
+      const response = await options.http.request({
+        url: USAGE_PRICE_SOURCE_URL, method: "GET", headers: { Accept: "application/json" },
+        redirect: "manual", timeoutMs: 5_000, maxResponseBytes: MAX_BYTES,
+      });
+      if (response.status !== 200 || response.body.byteLength > MAX_BYTES)
+        throw new Error("Price directory is unavailable");
+      const sourceJson = Buffer.from(response.body).toString("utf8");
+      const sourceHash = createHash("sha256").update(sourceJson).digest("hex");
+      const fetchedAt = new Date(now()).toISOString();
+      const catalog = normalizeCatalog(JSON.parse(sourceJson), fetchedAt, sourceHash);
+      current = catalog;
+      nextAttempt = now() + REFRESH_MS;
+      if (options.cachePath) {
+        const temporary = `${options.cachePath}.${randomUUID()}.tmp`;
+        try {
+          await mkdir(dirname(options.cachePath), { recursive: true });
+          await writeFile(temporary, JSON.stringify({ sourceJson, sourceHash, fetchedAt }), { flag: "wx", mode: 0o600 });
+          await rename(temporary, options.cachePath);
+        } catch { /* A full/read-only disk must not discard a valid download. */ }
+        finally { await rm(temporary, { force: true }).catch(() => {}); }
+      }
+    } catch { /* Preserve the dated last good catalog, or the offline bundle. */ }
+    return current;
+  }
+  return {
+    peek: () => current,
+    read() {
+      pending ??= refresh().finally(() => { pending = undefined; });
+      return pending;
+    },
+  };
+}
