diff --git a/packages/services/src/model-provider/modelDiscoveryCatalogs.ts b/packages/services/src/model-provider/modelDiscoveryCatalogs.ts
new file mode 100644
index 0000000..ac28f6b
--- /dev/null
+++ b/packages/services/src/model-provider/modelDiscoveryCatalogs.ts
@@ -0,0 +1,309 @@
+import type { ModelConfigObject } from "@zcode/provider";
+import type { ModelDiscoveryResult, DiscoveredModel } from "./modelDiscovery.js";
+import { readDiscoveredModelMetadata } from "./modelDiscoveryMetadata.js";
+
+const MAX_MODEL_LIST_PAGE_BYTES = 8 * 1024 * 1024;
+export const MAX_MODEL_LIST_ENTRIES = 20_000;
+
+/** Bound each untrusted catalog page before JSON parsing, including unknown body lengths. */
+export async function readModelListPage(response: Response): Promise<unknown> {
+  if (Number(response.headers.get("content-length")) > MAX_MODEL_LIST_PAGE_BYTES) {
+    await response.body?.cancel();
+    throw new Error("The model list response is too large");
+  }
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("The model list response is empty");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const part = await reader.read();
+      if (part.done) break;
+      size += part.value.byteLength;
+      if (size > MAX_MODEL_LIST_PAGE_BYTES) throw new Error("The model list response is too large");
+      chunks.push(part.value);
+    }
+  } finally {
+    await reader.cancel().catch(() => {});
+    reader.releaseLock();
+  }
+  return JSON.parse(Buffer.concat(chunks, size).toString("utf8"));
+}
+
+/** Native Google metadata enriches only the IDs admitted by its compatibility catalog. */
+export async function readGoogleModelMetadata(
+  baseUrl: string,
+  committedHeaders: Headers,
+  key: string,
+  fetch: typeof globalThis.fetch,
+  deadline: AbortSignal,
+): Promise<Map<string, ModelConfigObject>> {
+  const headers = new Headers(committedHeaders);
+  headers.delete("Authorization");
+  headers.delete("x-api-key");
+  headers.set("x-goog-api-key", key);
+  const url = new URL(`${baseUrl}/models`);
+  const models = new Map<string, ModelConfigObject>();
+  const cursors = new Set<string>();
+  for (let page = 0; page < 20; page++) {
+    const response = await fetch(url, { headers, signal: deadline, redirect: "error" });
+    if (!response.ok) {
+      await response.body?.cancel();
+      throw new Error(`Model metadata request failed (${response.status})`);
+    }
+    const body = (await readModelListPage(response)) as {
+      models?: unknown;
+      nextPageToken?: unknown;
+    };
+    if (!Array.isArray(body.models))
+      throw new Error("Google returned an unsupported model metadata catalog");
+    for (const item of body.models) {
+      if (
+        !item ||
+        typeof item !== "object" ||
+        typeof item.name !== "string" ||
+        !item.name.startsWith("models/")
+      )
+        continue;
+      const id = item.name.slice("models/".length);
+      if (!id.trim() || models.has(id))
+        throw new Error("Google returned duplicate or invalid model resources");
+      let config = readDiscoveredModelMetadata(item);
+      if (
+        Array.isArray(item.supportedGenerationMethods) &&
+        !item.supportedGenerationMethods.includes("generateContent")
+      )
+        config = {
+          ...config,
+          properties: { ...config.properties, outputFormat: { supportsText: false } },
+        };
+      models.set(id, config);
+      if (models.size > MAX_MODEL_LIST_ENTRIES)
+        throw new Error("Google model metadata exceeds its entry limit");
+    }
+    if (!body.nextPageToken) return models;
+    if (typeof body.nextPageToken !== "string" || cursors.has(body.nextPageToken))
+      throw new Error("Google returned an invalid pagination cursor");
+    cursors.add(body.nextPageToken);
+    url.searchParams.set("pageToken", body.nextPageToken);
+  }
+  throw new Error("Google model metadata exceeds its page limit");
+}
+
+/** xAI's generic /models has no output class; these key-scoped catalogs are the route authority. */
+export async function discoverXaiModels(
+  origin: string,
+  headers: Headers,
+  fetch: typeof globalThis.fetch,
+): Promise<ModelDiscoveryResult> {
+  const models = new Map<string, DiscoveredModel>();
+  const warnings: NonNullable<ModelDiscoveryResult["warnings"]> = [];
+  const deadline = AbortSignal.timeout(20_000);
+  for (const [route, output, kind] of [
+    ["language-models", "text", "text"],
+    ["image-generation-models", "image", "image"],
+    ["video-generation-models", "video", "video"],
+  ] as const) {
+    const response = await fetch(`${origin}/v1/${route}`, {
+      headers,
+      signal: deadline,
+      redirect: "error",
+    });
+    if (!response.ok) {
+      await response.body?.cancel();
+      if (response.status === 403 || response.status === 404) {
+        warnings.push({ kind, status: response.status });
+        continue;
+      }
+      throw new Error(`Model list request failed (${response.status}) for ${route}`);
+    }
+    const body = (await readModelListPage(response)) as { models?: unknown };
+    if (!Array.isArray(body.models)) {
+      throw new Error(`The provider returned an unsupported ${route} catalog`);
+    }
+    const routeIds = new Set<string>();
+    for (const value of body.models) {
+      if (!value || typeof value !== "object" || Array.isArray(value)) continue;
+      const item = value as Record<string, unknown>;
+      const id = typeof item.id === "string" ? item.id.trim() : "";
+      if (!id) continue;
+      if (routeIds.has(id)) {
+        throw new Error(`The provider returned duplicate model IDs in ${route}`);
+      }
+      routeIds.add(id);
+      const reportedOutputs = item.output_modalities;
+      if (Array.isArray(reportedOutputs) && !reportedOutputs.includes(output)) {
+        throw new Error(`The provider returned a conflicting ${route} output for ${id}`);
+      }
+      const config = readDiscoveredModelMetadata({
+        ...item,
+        output_modalities: reportedOutputs ?? [output],
+      });
+      const name =
+        typeof item.name === "string" && item.name.trim()
+          ? item.name
+          : typeof item.display_name === "string" && item.display_name.trim()
+            ? item.display_name
+            : id;
+      const existing = models.get(id);
+      models.set(
+        id,
+        existing ? mergeDiscoveredOutput(existing, { id, name, config }) : { id, name, config },
+      );
+      if (models.size > MAX_MODEL_LIST_ENTRIES) {
+        throw new Error("The model list exceeds the supported entry limit");
+      }
+    }
+  }
+  if (warnings.length === 3) {
+    throw new Error(
+      `Model list request failed (${warnings[0]!.status}) for all xAI media catalogs`,
+    );
+  }
+  return {
+    source: "provider",
+    models: [...models.values()],
+    ...(warnings.length ? { warnings } : {}),
+  };
+}
+
+function mergeDiscoveredOutput(existing: DiscoveredModel, next: DiscoveredModel): DiscoveredModel {
+  const earlier = existing.config.properties?.outputFormat;
+  const later = next.config.properties?.outputFormat;
+  return {
+    ...existing,
+    config: {
+      ...existing.config,
+      properties: {
+        ...existing.config.properties,
+        ...next.config.properties,
+        outputFormat: {
+          supportsText: earlier?.supportsText === true || later?.supportsText === true,
+          supportsImage: earlier?.supportsImage === true || later?.supportsImage === true,
+          supportsVideo: earlier?.supportsVideo === true || later?.supportsVideo === true,
+        },
+      },
+      optionSpecs: existing.config.optionSpecs ?? next.config.optionSpecs,
+    },
+  };
+}
+
+/** The regional pay-as-you-go Model Studio catalogue has its own path and page-number schema. */
+export function isModelStudioCatalogBase(base: URL): boolean {
+  const regional = [
+    "dashscope.aliyuncs.com",
+    "dashscope-intl.aliyuncs.com",
+    "dashscope-us.aliyuncs.com",
+    "cn-hongkong.dashscope.aliyuncs.com",
+  ].includes(base.hostname);
+  const workspace =
+    /^[^.]+\.(?:cn-beijing|ap-southeast-1|ap-northeast-1|eu-central-1|us-east-1|cn-hongkong)\.maas\.aliyuncs\.com$/.test(
+      base.hostname,
+    ) && !/^(?:token-plan|trial)\./.test(base.hostname);
+  return (
+    base.protocol === "https:" &&
+    (regional || workspace) &&
+    /^\/(?:compatible-mode\/v1|apps\/anthropic)\/?$/.test(base.pathname) &&
+    !base.username &&
+    !base.password &&
+    !base.search &&
+    !base.hash
+  );
+}
+
+export async function discoverModelStudioModels(
+  origin: string,
+  committedHeaders: Headers,
+  key: string,
+  fetch: typeof globalThis.fetch,
+): Promise<ModelDiscoveryResult> {
+  const headers = new Headers(committedHeaders);
+  for (const name of ["x-api-key", "anthropic-version", "anthropic-beta"]) headers.delete(name);
+  headers.set("Authorization", `Bearer ${key}`);
+  const url = new URL(`${origin}/api/v1/models`);
+  url.searchParams.set("page_size", "100");
+  const models = new Map<string, DiscoveredModel>();
+  const deadline = AbortSignal.timeout(20_000);
+  let total: number | undefined;
+  for (let page = 1; page <= 20; page++) {
+    url.searchParams.set("page_no", String(page));
+    const response = await fetch(url, { headers, signal: deadline, redirect: "error" });
+    if (!response.ok) {
+      await response.body?.cancel();
+      throw new Error(`Model list request failed (${response.status})`);
+    }
+    const body = (await readModelListPage(response)) as {
+      success?: unknown;
+      output?: { total?: unknown; page_no?: unknown; models?: unknown };
+    };
+    const output = body.output;
+    if (
+      body.success === false ||
+      !Array.isArray(output?.models) ||
+      !Number.isSafeInteger(output.total) ||
+      Number(output.total) < 0 ||
+      Number(output.total) > MAX_MODEL_LIST_ENTRIES ||
+      output.page_no !== page
+    )
+      throw new Error("Model Studio returned an invalid model catalogue page");
+    if (total !== undefined && total !== output.total)
+      throw new Error("Model Studio catalogue changed during pagination; retry");
+    total = Number(output.total);
+    for (const item of output.models) {
+      if (
+        !item ||
+        typeof item !== "object" ||
+        typeof item.model !== "string" ||
+        !item.model.trim() ||
+        models.has(item.model)
+      )
+        throw new Error("Model Studio returned duplicate or invalid model IDs");
+      const info = item.model_info ?? {};
+      const io = item.inference_metadata ?? {};
+      const lower = (value: unknown) =>
+        Array.isArray(value) && value.every((v) => typeof v === "string")
+          ? value.map((v) => v.toLowerCase())
+          : undefined;
+      const features =
+        Array.isArray(item.features) &&
+        item.features.every((value: unknown) => typeof value === "string")
+          ? item.features
+          : undefined;
+      let config = readDiscoveredModelMetadata({
+        context_window: info.context_window,
+        max_output_tokens: info.max_output_tokens,
+        input_modalities: lower(io.request_modality),
+        output_modalities: lower(io.response_modality),
+        ...(features
+          ? {
+              supports_tool_calls: features.includes("function-calling"),
+              supports_json_schema_output: features.includes("structured-outputs"),
+            }
+          : {}),
+      });
+      if (
+        Array.isArray(item.capabilities) &&
+        item.capabilities.length &&
+        !item.capabilities.some(
+          (v: unknown) => v === "TG" || v === "Reasoning" || v === "Multimodal-Omni",
+        )
+      )
+        config = {
+          ...config,
+          properties: {
+            ...config.properties,
+            outputFormat: { ...config.properties?.outputFormat, supportsText: false },
+          },
+        };
+      models.set(item.model, {
+        id: item.model,
+        name: typeof item.name === "string" ? item.name : item.model,
+        config,
+      });
+    }
+    if (models.size === total) return { source: "provider", models: [...models.values()] };
+    if (!output.models.length || models.size > total)
+      throw new Error("Model Studio returned an incomplete catalogue page");
+  }
+  throw new Error("Model Studio model list exceeds its page limit");
+}
