+
+test("OpenRouter legacy URL aliases retain explicit format selection and custom proxy addresses", async () => {
+  const f = await fixture();
+  try {
+    const service = f.runtime.configService;
+    const templates = (await service.read()).zcodeBuiltinProviderTemplates.toJSON();
+    const routes = resolveTemplateProtocolRoutes("openrouter", templates);
+    assert.equal(routes.length, 3);
+    const { providerId } = await service.createPersonalProvider({ templateId: "openrouter" });
+    await service.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig({
+        api: { type: "anthropic-messages", baseUrl: "https://openrouter.ai/api" },
+        access: { type: "api-key", apiKey: "synthetic" },
+      }),
+    );
+    const next = selectProviderProtocolRoute(
+      "openai-chat-completions",
+      "https://openrouter.ai/api",
+      routes,
+    );
+    assert.equal(next.baseUrl, "https://openrouter.ai/api/v1");
+    const saved = (await service.read()).personalProviders.get(providerId)!.toJSON();
+    await service.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig({ ...saved, api: next }),
+    );
+    assert.equal(
+      (await service.read()).personalProviders.get(providerId)?.access?.apiKey,
+      "synthetic",
+    );
+    assert.deepEqual(
+      selectProviderProtocolRoute("openai-responses", "https://my-proxy.invalid/service", routes),
+      { type: "openai-responses", baseUrl: "https://my-proxy.invalid/service" },
+    );
+  } finally {
+    await f.dispose();
+  }
+});
