+test("real uninstall partial config failure publishes removal without replay or data loss", async (t) => {
+  const { default: fs } = await import("node:fs");
+  const { syncBuiltinESMExports } = await import("node:module");
+  const { getPluginDataDir } =
+    await import("../../../apps/zcode-cli/packages/adapters/src/plugins/index.js");
+  let networkCalls = 0;
+  t.mock.method(globalThis, "fetch", async () => {
+    networkCalls++;
+    throw new Error("Unexpected live transport");
+  });
+  const f = await fixture();
+  try {
+    const warm = await f.create();
+    assert.ok(
+      (await warm.getSkillCatalog()).skills.some((skill) => skill.qualifiedName === "writer:first"),
+    );
+    const data = getPluginDataDir(join(f.root, "storage", "cli", "plugins"), "writer@audit-market");
+    await fs.promises.mkdir(data, { recursive: true });
+    const document = join(data, "authored-original.txt");
+    await fs.promises.writeFile(document, "Keep original data");
+    const rename = fs.promises.rename;
+    let failures = 0;
+    const fault = t.mock.method(fs.promises, "rename", async (from, to) => {
+      if (String(to) === f.userConfigPath) {
+        failures++;
+        throw Object.assign(new Error("authored cleanup failure"), { code: "EIO" });
+      }
+      return rename(from, to);
+    });
+    syncBuiltinESMExports();
+    let receipt;
+    try {
+      receipt = await plugins
+        .getState()
+        .uninstallPluginWithReceipt("writer@audit-market", f.service as never);
+    } finally {
+      fault.mock.restore();
+      syncBuiltinESMExports();
+    }
+    assert.equal(receipt.succeeded, false);
+    assert.equal(receipt.canonicalChanged, true);
+    assert.equal(failures, 1);
+    assert.ok(
+      !(await warm.getSkillCatalog()).skills.some(
+        (skill) => skill.pluginId === "writer@audit-market",
+      ),
+      "Original Core still withdraws removed skills immediately",
+    );
+    const before = f.version();
+    await publishPluginPackageDefinitions({
+      workspacePath: f.workspace.workspacePath,
+      isCurrent: receipt.isCurrent,
+      zcodeSessionService: { closeSession: async () => {} },
+      skillsService: f.skillService as never,
+    });
+    assert.equal(f.version(), before + 1);
+    assert.equal(f.scans(), 1);
+    assert.ok(!skills.getState().skills.some((skill) => skill.name.startsWith("writer:")));
+    assert.match(plugins.getState().error ?? "", /Unable to write config file/);
+    assert.equal(await fs.promises.readFile(document, "utf8"), "Keep original data");
+    assert.equal(networkCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
