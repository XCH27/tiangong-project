+            : projected.concurrency?.limit === expected ||
+              (expected === ceiling && projected.concurrency?.limit === undefined));
+        if (
+          !proved &&
+          context.workflowRunEvents &&
+          entry.workflowControl.issue &&
+          expected !== undefined
+        ) {
+          const events = await context.workflowRunEvents({
+            sessionId,
+            runId: workId,
+            afterSequence: entry.workflowControl.issue.lastEventSequence,
+            limit: 500,
+          });
+          if (!isCurrent()) return false;
+          proved = events.events.some((event) => {
+            const caps = event.payload.caps;
+            const value =
+              caps && typeof caps === "object" && "maxConcurrency" in caps
+                ? caps.maxConcurrency
+                : undefined;
+            return (
+              event.type === "run-caps-changed" &&
+              event.payload.runId === workId &&
+              event.sequence > entry.workflowControl!.issue!.lastEventSequence &&
+              typeof value === "number" &&
+              value === (expected === null ? ceiling : expected)
+            );
+          });
+        }
+      } else if (!proved && context.workflowRuns) {
+        const read = await context.workflowRuns({ sessionId, limit: 64 });
+        if (!isCurrent()) return false;
+        proved = read.runs.some(
+          (run) => run.runId === result.runId && run.toolCallId === result.toolCallId,
+        );
+      }
+      if (!proved || !isCurrent()) return false;
+      onObserved?.();
+      pendingCommandRegistry.settle(sessionId, commandId);
+      return true;
+    },
+    [context, isCurrent, entries, sessionId],
+  );
+  const recovery = useCallback(
+    (workId: string): WorkflowRunSettingsRecovery | undefined => {
+      if (!context) return;
+      const entry = entries(workId).find(
+        (item) =>
+          item.replay.kind === "workflowControl" && item.replay.type === "amendWorkflowRunSettings",
+      );
+      return {
+        phase:
+          entry?.workflowControl?.delivery === "accepted"
+            ? "accepted"
+            : entry && flight.current?.token === token && flight.current.kind === "send"
+              ? "pending"
+              : entry
+                ? "unknown"
+                : undefined,
+        blocked: entries(workId).length > 0,
+        checking: flight.current?.token === token && flight.current.kind === "query",
+        identity: token,
+        contextKey: JSON.stringify([
+          context.scope.workspaceIdentity || context.scope.workspacePath,
+          context.scope.remoteSessionId,
+          sessionId,
+          workId,
+        ]),
+        isCurrent,
+        checkResult: () => check(workId),
+        complete: (commandId, onObserved) => complete(workId, commandId, onObserved),
+      };
+    },
+    [context, entries, token, isCurrent, check, complete],
+  );
+  return { apply, recovery };
+}
