+import { WorkflowArtifactSidePane } from "../src/app-shell/WorkflowArtifactSidePane.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { WorkflowArtifactHtmlCard } from "../src/app-shell/workflow-artifacts/WorkflowArtifactCards.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import type { V4ConversationWorkflowRunArtifactReadResult } from "@zcode/shared/zcode-protocol-v4";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const tick = async () => {
+  for (let i = 0; i < 30; i++) await Promise.resolve();
+};
+const deferred = <T,>() => {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+};
+const payload = (path?: string): V4ConversationWorkflowRunArtifactReadResult => ({
+  dataBase64: btoa("<p>A saved</p>"),
+  totalBytes: 14,
+  nextOffset: null,
+  mediaType: "text/html",
+  ...(path === undefined ? {} : { localSnapshotPath: path }),
+});
+async function scenario(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({
+      name,
+      error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+    });
+  }
+}
+async function fixture() {
+  const path = `/html-identity-${crypto.randomUUID()}`;
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  const a = nativePresentationAgent(),
+    b = nativePresentationAgent();
+  const pending: Array<{
+    agent: typeof a.agent;
+    input: unknown;
+    reply: ReturnType<typeof deferred<V4ConversationWorkflowRunArtifactReadResult>>;
+  }> = [];
+  for (const owner of [a, b])
+    owner.agent.conversationWorkflowRunArtifactReadV4 = async (input) => {
+      if (!input.includeLocalSnapshotPath && input.offset === 0) return payload();
+      const reply = deferred<V4ConversationWorkflowRunArtifactReadResult>();
+      pending.push({ agent: owner.agent, input, reply });
+      return reply.promise;
+    };
+  let latest!: ReturnType<typeof useAppPanels>;
+  function Probe({ owner }: { owner: string }) {
+    latest = useAppPanels({
+      workspaceAbsPath: path,
+      activeTaskId: owner,
+      sidePaneOwnerId: owner,
+      isDesktop: true,
+      defaultWhiteboardNamePrefix: "Board",
+    });
+    return null;
+  }
+  const render = async (
+    agent = a.agent,
+    owner = "A",
+    mode: "main" | "bytes" = "main",
+    version = 1,
+  ) => {
+    await act(async () => {
+      root.render(
+        <PlatformProvider platform={{} as never}>
+          <ServiceProvider
+            services={
+              {
+                zcodeAgentService: agent,
+                zcodeSessionService: { closeSession: async () => {} },
+              } as never
+            }
+          >
+            <TabStoreProvider>
+              <ZCodeIntlProvider locale="en-US">
+                {mode === "main" ? (
+                  <Probe owner={owner} />
+                ) : (
+                  <V4PaneConversationProvider scope={{ workspacePath: path, workspaceKey: path }}>
+                    <BytesProbe version={version} />
+                  </V4PaneConversationProvider>
+                )}
+              </ZCodeIntlProvider>
+            </TabStoreProvider>
+          </ServiceProvider>
+        </PlatformProvider>,
+      );
+      await tick();
+    });
+  };
+  function BytesProbe({ version }: { version: number }) {
+    const state = useWorkflowRunArtifactBytes({
+      sessionId: "A",
+      runId: "run",
+      artifactId: "page",
+      version,
+      includeHtmlSnapshotPath: true,
+    });
+    return (
+      <pre data-testid="bytes-state">
+        {JSON.stringify({
+          path: state.localSnapshotPath,
+          error: state.error,
+          loading: state.loading,
+          bytes: state.bytes?.byteLength ?? null,
+        })}
+      </pre>
+    );
+  }
+  return {
+    path,
+    node,
+    root,
+    a,
+    b,
+    pending,
+    render,
+    get latest() {
+      return latest;
+    },
+    open: async (version = 1) => {
