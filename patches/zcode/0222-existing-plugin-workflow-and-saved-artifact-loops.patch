+                      workspaceKey: scope.workspacePath,
+                      id: `control-${locale}`,
+                      toolCallId: "authored-tool",
+                      runId,
+                      parentSessionId,
+                      ...scope,
+                    }}
+                  />
+                </TooltipProvider>
+              </ZCodeIntlProvider>
+            </TabStoreProvider>
+          </ServiceProvider>
+        </PlatformProvider>,
+      );
+      await tick();
+    });
+  try {
+    await mount();
+    const button = (id: string) =>
+      document.querySelector<HTMLButtonElement>(`[data-testid="${id}"]`);
+    const configure = button("workflow-run-configure");
+    check(configure && !configure.disabled, "actual SidePane receives a configurable live run");
+    await act(async () => {
+      configure.click();
+      await tick();
+    });
+    check(button("workflow-run-settings-bound-decrease"), "actual settings Form is mounted");
+    await act(async () => {
+      button("workflow-run-settings-bound-decrease")!.click();
+      await tick();
+    });
+    check(!button("workflow-run-settings-apply")!.disabled, "changed concurrency is applicable");
+    await act(async () => {
+      button("workflow-run-settings-apply")!.click();
+      await tick();
+    });
+    check(sends === 1 && queries === 1, "actual failed Apply transport queries original key once");
+    check(captured?.type === "amendWorkflowRunSettings", "actual producer sends settings command");
+    check(button("workflow-run-settings-apply")?.disabled, "unknown blocks duplicate Apply");
+    const notice =
+      document.querySelector('[data-testid="workflow-run-settings-recovery"]')?.textContent ?? "";
+    check(
+      locale === "en-US" ? notice.includes("unconfirmed") : notice.includes("尚未确认"),
+      "localized uncertain notice remains visible",
+    );
+    // Remount the actual producer: the retained original registry identity survives Form state.
+    await act(async () => {
+      configure.click();
+      await tick();
+    });
+    await act(async () => {
+      configure.click();
+      await tick();
+    });
+    check(button("workflow-run-settings-apply")?.disabled, "reopened Form retains unknown receipt");
+    queryReceipt = {
+      commandId: captured.commandId,
+      status: "accepted",
+      revisionAtDecision: 0,
+      result: {
+        type: "amendWorkflowRunSettings",
+        runId: result === "inplace" ? runId : "authored-successor",
+        toolCallId: "accepted-tool",
+      },
+    };
+    await act(async () => {
+      button("workflow-run-settings-check")!.click();
+      await tick();
+    });
+    check(sends === 1 && queries === 2, "positive readonly check never sends another Apply");
+    check(
+      pendingCommandRegistry.list(parentSessionId).length === 1,
+      "ACK alone cannot settle accepted settings",
+    );
+    check(follows === 0, "unobserved successor cannot navigate");
+    if (lateProjection) {
+      check(reads === 1, "original successor proof read is held");
+      await act(async () => {
+        publishSuccessor!();
+        await tick();
+      });
+      check(follows === 0 && reads === 1, "positive projection waits for original flight release");
+      await act(async () => {
+        releaseRead({ runs: [] });
+        await tick();
+      });
+      check(
+        reads === 1 && queries === 2,
+        "stale empty completion consumes new projection without query polling",
+      );
+    } else {
+      observed = true;
+      await act(async () => {
+        button("workflow-run-check-result")!.click();
+        await tick();
+      });
+      check(
+        sends === 1 && queries === 3,
+        "journal/target recovery still uses readonly original key",
+      );
+    }
+    check(
+      pendingCommandRegistry.list(parentSessionId).length === 0,
+      "original target/caps evidence settles retained receipt",
+    );
+    check(
+      follows === (result === "successor" ? 1 : 0),
+      "only proven successor follows; inplace preserves creator identity",
+    );
+  } finally {
+    releaseRead({ runs: [] });
+    await act(async () => root.unmount());
+    node.remove();
+    for (const entry of pendingCommandRegistry.list(parentSessionId))
+      pendingCommandRegistry.settle(parentSessionId, entry.commandId);
+    useDynamicWorkflowAvailabilityStore.setState(
+      useDynamicWorkflowAvailabilityStore.getInitialState(),
+      true,
+    );
+  }
+}
+
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    for (const item of [
+      { result: "successor", late: false },
+      { result: "inplace", late: false },
+      { result: "successor", late: true },
+    ] as const) {
+      const { result, late } = item;
+      const name = `actual settings Form/SidePane ${locale}: ${late ? "late positive projection during stale empty read" : `lost ACK, reopen, readonly ${result} recovery`}`;
+      try {
+        await scenario(locale, result, late);
+        results.push({ name });
+      } catch (error) {
+        results.push({
+          name,
+          error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+        });
+      }
+    }
+  }
+  document.body.dataset.testResults = JSON.stringify(results);
+  (globalThis as { __TEST_RESULTS__?: unknown }).__TEST_RESULTS__ = results;
+}
+declare global {
+  interface Window {
+    __workflowRunSettingsRecoveryTests: Promise<Array<{ name: string; error?: string }>>;
+  }
+}
+window.__workflowRunSettingsRecoveryTests = run().then(() => results);
