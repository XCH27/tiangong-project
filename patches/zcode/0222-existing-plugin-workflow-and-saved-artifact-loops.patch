+  let queries = 0;
+  let queryReceipt: CommandAck | "unknown" = "unknown";
+  let captured: CommandEnvelope | undefined;
+  let observed = false;
+  let follows = 0;
+  fixture.agent.sendConversationCommandV4 = async ({ envelope }) => {
+    captured = envelope;
+    sends++;
+    throw new Error("Authored accepted reply loss");
+  };
+  fixture.agent.queryConversationCommandsV4 = async ({ commands }) => {
+    queries++;
+    check(
+      commands.length === 1 && commands[0]?.commandId === captured?.commandId,
+      "check uses original command identity",
+    );
+    return { results: commands.map((key) => ({ key, result: queryReceipt })) };
+  };
+  fixture.agent.conversationWorkflowRunArtifactsV4 = async () => ({ artifacts: [] });
