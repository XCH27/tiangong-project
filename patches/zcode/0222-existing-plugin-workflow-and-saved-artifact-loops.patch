+          type: "workflow-run",
+          parentSessionId: app.sessionId,
+          toolCallId: "authored-predecessor",
+          runId: start.runId,
+          workspacePath: h.workspace.workspacePath,
+          workspaceIdentity: h.workspace.workspaceIdentity,
+          workspaceKey: h.workspace.workspaceKey,
+        },
+      });
+      uiHost = settings.host;
+      return null;
+    }
+    renderToStaticMarkup(createElement(Probe));
+    await assert.rejects(uiHost.apply({ maxConcurrency: 1 }));
+    const firstAck = accepted[0];
+    assert.equal(firstAck.result?.type, "amendWorkflowRunSettings");
+    const firstChild = firstAck.result.runId;
+    assert.equal(firstChild === start.runId, mode === "inplace");
+    assert.equal(
+      pendingCommandRegistry.list(app.sessionId).some((x) => x.commandId === sent[0].commandId),
+      true,
+    );
+    queryKnown = true;
+    const repeat = await uiHost.apply({ maxConcurrency: 2 });
+    assert.equal(repeat.result?.type, "amendWorkflowRunSettings");
+    const secondChild = repeat.result.runId;
+    assert.equal(secondChild, firstChild);
+    assert.equal(sent.length, 1);
+    assert.equal(
+      await uiHost.recovery?.complete(sent[0].commandId),
+      true,
+      "original target/caps read proves the accepted effect without a new mutation",
+    );
+    release();
+    await waitForRun(app, firstChild);
+    await waitForRun(app, secondChild);
+    const facts = (await app.listDynamicWorkflowRuns?.({ limit: 64 })) ?? [];
+    assert.equal(facts.length, mode === "successor" ? 2 : 1);
+    const beforeCold = await transport.queryCommands({
+      commands: [{ sessionId: app.sessionId, commandId: sent[0].commandId }],
+    });
+    assert.notEqual(beforeCold.results[0]?.result, "unknown");
+    const source = h.store.workflowJournalStore().getRun(start.runId);
+    assert.equal(source?.status, mode === "successor" ? "stopped" : "completed");
+    const sessionId = app.sessionId;
+    await h.restart();
+    await h.request(zcodeProtocolMethods.sessionResume, {
+      sessionId,
+      workspace: h.workspace,
+      dynamicWorkflowEnabled: true,
+    });
+    const cold = await transport.queryCommands({
+      commands: [{ sessionId, commandId: sent[0].commandId }],
+    });
+    const coldApp = h.apps.get(sessionId);
+    const coldRuns = (await coldApp?.listDynamicWorkflowRuns?.({ limit: 64 })) ?? [];
+    assert.equal(coldRuns.length, mode === "successor" ? 2 : 1);
+    const coldRowIds = new Set(
+      (await h.store.messages({ sessionID: sessionId })).map((row) => row.info.id),
+    );
+    assert.ok(
+      originalRows.every((id) => coldRowIds.has(id)),
+      "original Session rows survive amendment and cold reopen",
+    );
+    assert.notEqual(cold.results[0]?.result, "unknown");
+    const duplicate = commandAckSchema.parse(await h.request(V4_METHODS.command, sent[0]));
+    assert.equal(duplicate.status, "duplicate");
+    assert.equal(duplicate.result?.type, "amendWorkflowRunSettings");
+    assert.equal(
+      (await coldApp?.listDynamicWorkflowRuns?.({ limit: 64 }))?.length,
+      mode === "successor" ? 2 : 1,
+    );
+    assert.equal(h.f.httpCalls, 0);
+    console.log(
+      JSON.stringify({
+        proof: "actual-ui-hook-configure-lost-ack",
+        candidate: "cf093a50",
+        sessionId,
+        predecessor: start.runId,
+        sourceStatus: source?.status,
+        sourceSupersededBy: source?.supersededBy ?? null,
+        commandIds: sent.map((x) => x.commandId),
+        successors: [firstChild, secondChild],
+        mode,
+        runs: facts.length,
+        coldRuns: coldRuns.length,
+        coldReceipt: cold.results[0]?.result,
+        rendererRegistryTracked: true,
+        httpCalls: h.f.httpCalls,
+      }),
+    );
+  } finally {
+    release();
+    for (const entry of pendingCommandRegistry.list(h.apps.keys().next().value ?? ""))
+      pendingCommandRegistry.settle(entry.sessionId, entry.commandId);
+    await h.close();
+  }
+}
+
+for (const mode of ["successor", "inplace"] as const) {
+  test(`actual Configure ${mode}: lost ACK keeps one command, cold receipt/duplicate preserve one intended effect`, () =>
+    scenario(mode));
+}
