+      return;
+    }
+    const result = ack.result;
+    if (result?.type === "amendWorkflowRunSettings") {
+      if (onAccepted)
+        onAccepted({
+          runId: result.runId,
+          toolCallId: result.toolCallId,
+          commandId: ack.commandId,
+        });
+      else if (host.recovery && !(await host.recovery.complete(ack.commandId))) {
+        if (isCurrent()) setPending(false);
+        return;
+      }
+    }
+    if (isCurrent()) onClose();
+  };
+  const failed = (error: unknown) => {
+    if (!isCurrent()) return;
+    if (
+      error instanceof WorkflowRunSettingsUncertainError &&
+      error.code === "client.workflowSettingsUnconfirmed"
+    ) {
+      setRejection(undefined);
+    } else
+      setRejection({
+        reason:
+          error instanceof WorkflowRunSettingsUncertainError &&
+          error.code === "client.workflowControlReceiptUnavailable"
+            ? "receipt_unavailable"
+            : "generic",
+        code: error instanceof Error ? error.message : String(error),
+      });
+    setPending(false);
+  };
+  const handleApply = () => {
+    if (change === undefined || pending || retained) return;
+    setPending(true);
+    setRejection(undefined);
+    void host.apply(change).then(consume).catch(failed);
+  };
+  const handleCheck = () => {
+    if (!host.recovery || host.recovery.checking) return;
+    setPending(true);
+    void host.recovery
+      .checkResult()
+      .then(async (ack) => {
+        if (ack) await consume(ack);
+        else if (isCurrent()) setPending(false);
+      })
+      .catch(failed);
+  };
+
+  const rejectionDetail =
+    rejection === undefined ? undefined : workflowRunSettingsRejectionDetail(rejection);
+  return (
+    <>
+      <PopoverTitle>{format("chat.toolCall.workflow.run.settings.title")}</PopoverTitle>
+      <WorkflowRunSettingsModelField
+        disabled={pending || retained || view === null}
+        groups={groups}
+        leadingItem={sessionModelItem}
+        noCatalog={view !== null && groups.length === 0}
+        onLevelChange={(level) => {
+          if (draftModel.kind !== "model" || level === draftModel.level) return;
+          updateDraft({ ...draft, model: { ...draftModel, level } });
+        }}
+        onValueChange={handleModelChange}
+        thoughtOption={thoughtOption}
+        triggerLabel={triggerLabel}
+        value={modelValue}
+        {...(draftModel.kind === "session"
+          ? { badge: { text: sessionBadge, tone: "subtle" as const } }
+          : unavailable
+            ? {
+                badge: {
+                  text: format("chat.toolCall.workflow.run.settings.model.unavailable"),
+                  tone: "warning" as const,
+                },
+              }
+            : {})}
+      />
+      <WorkflowRunSettingsBoundField
+        bound={draft.bound}
+        ceiling={ceiling}
+        disabled={pending || retained}
+        onChange={(bound) => updateDraft({ ...draft, bound })}
+      />
+      <p
+        className="text-ui-sm text-foreground-subtle"
+        data-testid="workflow-run-settings-consequence"
+      >
+        {format(workflowRunSettingsConsequenceId(run.status, change))}
+      </p>
+      {host.recovery?.phase === undefined ? null : (
+        <div
+          className="text-ui-sm text-warning"
+          role="status"
+          data-testid="workflow-run-settings-recovery"
+        >
+          {format(
+            host.recovery.phase === "accepted"
+              ? "chat.toolCall.workflow.run.settings.control.accepted"
+              : `chat.toolCall.workflow.run.control.${host.recovery.phase}`,
+          )}
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            onClick={handleCheck}
+            disabled={pending || host.recovery.checking}
+            data-testid="workflow-run-settings-check"
+          >
+            {format(
+              `chat.toolCall.workflow.run.control.${host.recovery.checking ? "checking" : "check"}`,
+            )}
+          </Button>
+        </div>
+      )}
+      {rejection === undefined ? null : (
+        <div
+          className="text-ui-xs text-warning"
+          data-testid="workflow-run-settings-rejection"
+          role="status"
+        >
+          <span>
+            {format(workflowRunSettingsRejectionMessageId(rejection), {
+              code: rejection.code,
+              message: rejection.message ?? rejection.code,
+            })}
+          </span>
+          {rejectionDetail === undefined ? null : (
+            <pre className="mt-1 max-h-24 overflow-auto whitespace-pre-wrap font-mono text-ui-xs text-foreground-subtle">
+              {rejectionDetail}
+            </pre>
+          )}
+        </div>
+      )}
+      <div className="flex justify-end">
+        <Button
+          data-testid="workflow-run-settings-apply"
+          disabled={change === undefined || pending || retained || unavailable}
+          onClick={handleApply}
+          size="default"
+          type="button"
+          variant="default"
+        >
+          {pending ? <Spinner className="size-3.5" /> : null}
+          {format(
+            pending
+              ? "chat.toolCall.workflow.run.settings.applying"
+              : "chat.toolCall.workflow.run.settings.apply",
+          )}
+        </Button>
+      </div>
+    </>
+  );
+}
