+    },
+    [context, isCurrent, token, entries, check, sessionId, receipt, refresh],
+  );
+  const complete = useCallback(
+    async (workId: string, commandId: string, onObserved?: () => void): Promise<boolean> => {
+      if (
+        !context ||
+        !isCurrent() ||
+        context.status !== "live" ||
+        context.snapshot?.sessionId !== sessionId
+      )
+        return false;
+      const entry = entries(workId).find((item) => item.commandId === commandId);
+      const result = entry?.workflowControl?.amendResult;
+      if (!entry || !result || entry.workflowControl?.delivery !== "accepted") return false;
+      const issueEpoch = entry.workflowControl.issue?.logEpoch;
+      if (
+        issueEpoch !== context.snapshot.logEpoch &&
+        entry.workflowControl.acceptedObservation?.logEpoch !== context.snapshot.logEpoch
+      )
