index 00000000..213b7f25
--- /dev/null
+++ b/packages/ui/src/components/workflow-timeline/useWorkflowRunSettingsControl.ts
@@ -0,0 +1,299 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import type {
+  CommandAck,
+  ConversationSnapshot,
+  V4ConversationWorkflowRunsParams,
+  V4ConversationWorkflowRunsResult,
+  V4ConversationWorkflowRunEventsParams,
+  V4ConversationWorkflowRunEventsResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import type { PaneWorkspaceScope } from "@/v4/paneLayoutStore.js";
+import type { SessionDataLayer } from "@/v4/sessionDataLayer.js";
+import { createCommandEnvelope } from "@/v4/commandFactory.js";
+import { pendingCommandRegistry } from "@/v4/pendingCommandRegistry.js";
+import { workflowAmendReceipt, workflowControlAckDisposition } from "@/v4/pendingCommandReplay.js";
+import {
+  checkWorkflowRunControl,
+  dispatchWorkflowRunControl,
+  workflowRunControlEntries,
+  type WorkflowRunControlOutcome,
+} from "@/app-shell/useWorkflowRunControlHelpers.js";
+import type { WorkflowRunSettingsChange } from "./workflowRunSettings.js";
+
+export interface WorkflowRunSettingsRecoveryContext {
+  layer: Pick<SessionDataLayer, "queryCommands">;
+  sendCommand: (
+    envelope: Parameters<typeof dispatchWorkflowRunControl>[0]["envelope"],
+  ) => Promise<CommandAck>;
+  scope: PaneWorkspaceScope;
+  snapshot: Pick<
+    ConversationSnapshot,
+    "sessionId" | "logEpoch" | "revision" | "workflowRuns"
+  > | null;
+  status: "connecting" | "live" | "error" | "closed";
+  subscriptionId: string | null;
+  workflowRuns?: (
+    params: V4ConversationWorkflowRunsParams,
+  ) => Promise<V4ConversationWorkflowRunsResult>;
+  workflowRunEvents?: (
+    params: V4ConversationWorkflowRunEventsParams,
+  ) => Promise<V4ConversationWorkflowRunEventsResult>;
+}
+export interface WorkflowRunSettingsRecovery {
+  phase: "pending" | "unknown" | "accepted" | undefined;
+  checking: boolean;
+  blocked: boolean;
+  contextKey: string;
+  identity: symbol;
+  isCurrent: () => boolean;
+  checkResult: () => Promise<CommandAck | undefined>;
+  complete: (commandId: string, onObserved?: () => void) => Promise<boolean>;
+}
+export class WorkflowRunSettingsUncertainError extends Error {
+  constructor(readonly code = "client.workflowSettingsUnconfirmed") {
+    super(code);
+  }
+}
+
+/** 两个原 UI producer 共用原 registry；不另持 accepted queue 或配置 truth。 */
+export function useWorkflowRunSettingsControl(
+  context: WorkflowRunSettingsRecoveryContext | undefined,
+  sessionId: string,
+) {
+  const token = useMemo(
+    () => Symbol("settings-context"),
+    [
+      context?.layer,
+      context?.sendCommand,
+      context?.scope.workspacePath,
+      context?.scope.workspaceIdentity,
+      context?.scope.remoteSessionId,
+      context?.snapshot?.logEpoch,
+      context?.status,
+      context?.subscriptionId,
+      sessionId,
+    ],
+  );
+  const current = useRef(token);
+  const flight = useRef<{ token: symbol; commandId: string; kind: "send" | "query" } | null>(null);
+  const [version, setVersion] = useState(0);
+  const refresh = useCallback(() => setVersion((value) => value + 1), []);
+  useLayoutEffect(() => {
+    current.current = token;
+    return () => {
+      if (current.current === token) current.current = Symbol("closed");
+    };
+  }, [token]);
+  useEffect(() => pendingCommandRegistry.subscribe(refresh), [refresh]);
+  void version;
+  const isCurrent = useCallback(() => current.current === token, [token]);
+  const entries = useCallback(
+    (workId: string) =>
+      context ? workflowRunControlEntries(sessionId, workId, context.scope) : [],
+    [context, sessionId],
+  );
+  const receipt = useCallback(
+    (outcome: WorkflowRunControlOutcome): CommandAck => {
+      if (!isCurrent())
+        throw new WorkflowRunSettingsUncertainError("client.workflowSettingsContextChanged");
+      if (outcome.kind === "receipt") {
+        const disposition = workflowControlAckDisposition("amendWorkflowRunSettings", outcome.ack);
+        if (
+          disposition === "settled" ||
+          (disposition === "accepted" && workflowAmendReceipt(outcome.ack))
+        )
+          return outcome.ack;
+      }
+      throw new WorkflowRunSettingsUncertainError(
+        outcome.kind === "not_sent" ? outcome.code : undefined,
+      );
+    },
+    [isCurrent],
+  );
+  const check = useCallback(
+    async (workId: string): Promise<CommandAck | undefined> => {
+      if (!context || !isCurrent() || flight.current?.token === token) return;
+      const entry = entries(workId).find(
+        (item) =>
+          item.replay.kind === "workflowControl" && item.replay.type === "amendWorkflowRunSettings",
+      );
+      const snapshot = context.snapshot;
+      if (!entry || !snapshot || snapshot.sessionId !== sessionId || context.status !== "live")
+        return;
+      const operation = { token, commandId: entry.commandId, kind: "query" as const };
+      flight.current = operation;
+      refresh();
+      try {
+        return receipt(
+          await checkWorkflowRunControl({
+            entry,
+            observation: { logEpoch: snapshot.logEpoch, revision: snapshot.revision },
