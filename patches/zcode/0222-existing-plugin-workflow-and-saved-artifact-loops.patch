+    reads++;
+    if (lateProjection) return heldRead;
+    return {
+      runs: observed
+        ? [
+            {
+              runId: "authored-successor",
+              toolCallId: "accepted-tool",
+              status: "running",
+              resumable: false,
+            },
+          ]
+        : [],
+    };
+  };
