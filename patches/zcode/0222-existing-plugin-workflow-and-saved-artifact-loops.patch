+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  resolveWorkflowArtifactHtmlBrowserUrl,
+  workflowArtifactSnapshotUrl,
+  observeWorkflowArtifactHtmlOpenScope,
+  type WorkflowArtifactHtmlOpenAttempt,
+} from "../src/hooks/workflowArtifactHtmlOpen.js";
+import type { OpenScopedWorkflowArtifactSideTabRequest } from "../src/lib/workspaceSidePane.js";
+const request: OpenScopedWorkflowArtifactSideTabRequest = {
+  workspacePath: "/authored/workspace",
+  parentSessionId: "A",
+  runId: "run",
+  artifactId: "page",
+  version: 1,
+  contentType: "text/html",
+  sourcePath: "page.html",
+};
+const metadata = async () => ({ artifacts: [] });
+const result = { dataBase64: "", mediaType: "text/html", totalBytes: 0, nextOffset: null };
+
+test("selected historical version reads original tuple even when mutable sourcePath is present", async () => {
+  const reads: unknown[] = [];
+  const url = await resolveWorkflowArtifactHtmlBrowserUrl(
+    request,
+    async () => {
+      assert.fail("explicit version must not resolve latest metadata");
+    },
+    async (params) => {
+      reads.push(params);
+      return { ...result, localSnapshotPath: "/authored/store/selected#1.html" };
+    },
+  );
+  assert.equal(url, "file:///authored/store/selected%231.html");
+  assert.deepEqual(reads, [
+    {
+      workspacePath: request.workspacePath,
+      sessionId: "A",
+      runId: "run",
+      artifactId: "page",
+      version: 1,
+      offset: 0,
+      limit: 1,
+      includeLocalSnapshotPath: true,
+    },
+  ]);
+});
+test("missing original path cannot fall back to current source; foreign parent read rejects", async () => {
+  assert.equal(
+    await resolveWorkflowArtifactHtmlBrowserUrl(request, metadata, async () => result),
+    null,
+  );
+  await assert.rejects(
+    resolveWorkflowArtifactHtmlBrowserUrl(request, metadata, async () => {
+      throw new Error("foreign parent");
+    }),
+    /foreign parent/,
+  );
+});
+test("remote response path is ignored without requesting local read", async () => {
+  for (const remote of [{ workspaceIdentity: "ssh-host" }, { remoteSessionId: "remote" }]) {
+    assert.equal(
+      await resolveWorkflowArtifactHtmlBrowserUrl({ ...request, ...remote }, metadata, async () => {
+        assert.fail("remote path must not be read as local");
+      }),
+      null,
+    );
+  }
+});
+test("latest chip without a version uses canonical artifact version before snapshot read", async () => {
+  let version = 0;
+  const { version: _version, ...latest } = request;
+  const url = await resolveWorkflowArtifactHtmlBrowserUrl(
+    latest,
+    async () => ({
+      artifacts: [
+        {
+          id: "page",
+          kind: "file",
+          version: 7,
+          sourcePath: "new.html",
+          versions: [],
+          itemCount: 0,
+        },
+      ],
+    }),
+    async (params) => {
+      version = params.version;
+      return { ...result, localSnapshotPath: "/store/v7.html" };
+    },
+  );
+  assert.equal(version, 7);
+  assert.equal(url, "file:///store/v7.html");
+});
+test("snapshot URL refuses missing/relative/control-character/overbound paths", () => {
+  for (const value of [
+    undefined,
+    "",
+    "new.html",
+    "https://example.invalid/new.html",
+    "/store/\nnew.html",
+    "/".repeat(4097),
+  ]) {
+    assert.equal(workflowArtifactSnapshotUrl(value), null);
+  }
+});
+test("original history owner transition is permitted once, later parent ABA is revoked", () => {
+  const service = {};
+  const attempt: WorkflowArtifactHtmlOpenAttempt = {
+    scope: { service, workspaceKey: "W", owner: "B" },
+    targetOwner: "A",
+    selected: false,
+    invalid: false,
+  };
+  observeWorkflowArtifactHtmlOpenScope(attempt, { service, workspaceKey: "W", owner: "A" });
+  assert.equal(attempt.invalid, false);
+  observeWorkflowArtifactHtmlOpenScope(attempt, { service, workspaceKey: "W", owner: "B" });
+  observeWorkflowArtifactHtmlOpenScope(attempt, { service, workspaceKey: "W", owner: "A" });
+  assert.equal(attempt.invalid, true);
