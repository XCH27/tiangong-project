+
+async function scenario(observation: "exact" | "empty" | "mismatched" | "scopeChanged") {
+  const sessionId = `authored-follow-${observation}`;
+  const originalRun: WorkflowRunState = {
+    runId: "parent-run",
+    status: "stopped",
+    resumable: true,
+    stopReason: "user",
+    concurrencyCeiling: 4,
+    usage: { spentTokens: 0, nodesUsed: 0 },
+    actors: [],
+    nodes: [],
+    lastEventSequence: 1,
+  };
+  const child: WorkflowRunState = {
+    ...originalRun,
+    runId: "child-run",
+    toolCallId: observation === "mismatched" ? "wrong-tool" : "child-tool",
+    status: "running",
+    lastEventSequence: 2,
+  };
