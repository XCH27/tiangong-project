+      const pending = entries(workId);
+      if (pending.length) {
+        const ack = await check(workId);
+        if (ack) return ack;
+        throw new WorkflowRunSettingsUncertainError();
+      }
+      const snapshot = context.snapshot;
+      const run = snapshot?.workflowRuns?.runs.find((candidate) => candidate.runId === workId);
+      if (!snapshot || !run || snapshot.sessionId !== sessionId || context.status !== "live")
+        throw new WorkflowRunSettingsUncertainError("client.workflowSettingsContextUnavailable");
+      const envelope = createCommandEnvelope({
+        type: "amendWorkflowRunSettings",
+        sessionId,
+        payload: { workId, ...change },
