+test("amend start_failed stays query-only; generic control projection cannot clear accepted settings", async () => {
+  const { createCommandEnvelope } = await import("../src/v4/commandFactory.js");
+  const envelope = createCommandEnvelope({
+    type: "amendWorkflowRunSettings",
+    sessionId: "authored-amend-uncertain",
+    payload: { workId: "authored-amend-run", maxConcurrency: 2 },
+  });
+  pendingCommandRegistry.record(envelope, undefined, {
+    logEpoch: "authored",
+    revision: 1,
+    lastEventSequence: 1,
+    status: "stopped",
+    expectedConcurrency: 2,
+  });
+  try {
+    pendingCommandRegistry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "failed",
+      revisionAtDecision: 1,
+      reasonCode: "fault.command.workflowRunSettingsRejected.start_failed",
+    });
+    assert.equal(
+      pendingCommandRegistry.list(envelope.sessionId)[0]?.workflowControl?.delivery,
+      "unknown",
+    );
+    assert.equal(
+      pendingCommandRegistry.consumeReplay({
+        sessionId: envelope.sessionId,
+        commandId: envelope.commandId,
+      }),
+      null,
+    );
+    pendingCommandRegistry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 1,
+      result: {
+        type: "amendWorkflowRunSettings",
+        runId: "authored-amend-run",
+        toolCallId: "settings-new-id",
+      },
+    });
+    pendingCommandRegistry.reconcileWorkflowControlProjection(envelope.commandId, {
+      sessionId: envelope.sessionId,
+      logEpoch: "authored",
+      revision: 2,
+      workflowRuns: {
+        revision: 2,
+        runs: [{ runId: "authored-amend-run", status: "running", lastEventSequence: 2 }],
+      },
+    });
+    assert.equal(
+      pendingCommandRegistry.list(envelope.sessionId).length,
+      1,
+      "only settings target/caps consumer may settle amendment",
+    );
+  } finally {
+    pendingCommandRegistry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
