+  let workspacePath = "/authored/follow";
+  let revision = 1;
+  let reads = 0;
+  let follows = 0;
+  let release!: (value: { runs: [] }) => void;
+  const held = new Promise<{ runs: [] }>((resolve) => {
+    release = resolve;
+  });
+  const workflowRuns = async () => {
+    reads++;
+    return held;
+  };
+  const layer = { queryCommands: async () => ({ results: [] }) };
+  const sendCommand = async (envelope: { commandId: string }): Promise<CommandAck> => ({
+    commandId: envelope.commandId,
+    status: "accepted",
+    revisionAtDecision: 1,
+    result: { type: "amendWorkflowRunSettings", runId: "child-run", toolCallId: "child-tool" },
+  });
+  let settings!: ReturnType<typeof useWorkflowRunPaneSettings>;
+  function Probe() {
+    settings = useWorkflowRunPaneSettings({
+      enabled: true,
+      run: originalRun,
+      runs,
+      sendCommand,
+      sessionConfig: undefined,
+      onOpenWorkflowRun: () => {
+        follows++;
+      },
+      recoveryContext: {
+        layer,
+        sendCommand,
+        scope: { workspacePath },
+        snapshot: { sessionId, logEpoch: "owned", revision, workflowRuns: { revision, runs } },
+        status: "live",
+        subscriptionId: "owned-sub",
+        workflowRuns,
+      },
+      tab: {
+        type: "workflow-run",
+        id: "authored-tab",
+        runId: originalRun.runId,
+        toolCallId: "creator",
+        parentSessionId: sessionId,
+        workspaceKey: "/authored/follow",
+        workspacePath: "/authored/follow",
