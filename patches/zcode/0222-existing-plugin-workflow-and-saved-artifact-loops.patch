+      if (result.runId === workId) {
+        const expected = entry.workflowControl.issue?.expectedConcurrency;
+        const ceiling = projected?.concurrencyCeiling ?? projected?.concurrency?.ceiling;
+        proved =
+          projected !== undefined &&
+          expected !== undefined &&
+          projected.lastEventSequence >
+            (entry.workflowControl.issue?.lastEventSequence ?? Infinity) &&
