+    act(async () => {
+      renderer.updateContainer(createElement(Probe), root, null, null);
+    });
+  try {
+    await render();
+    await act(async () => {
+      const ack = await settings.host.apply({ maxConcurrency: 3 });
+      assert.equal(ack.result?.type, "amendWorkflowRunSettings");
+      settings.onAccepted({ ...ack.result, commandId: ack.commandId });
+    });
+    assert.equal(reads, 1);
+    assert.equal(follows, 0);
+    if (observation !== "empty") runs = [originalRun, child];
+    if (observation === "scopeChanged") workspacePath = "/authored/other-workspace";
+    revision++;
+    await render();
+    assert.equal(reads, 1, "positive render during original flight cannot start another read");
+    await act(async () => {
+      release({ runs: [] });
+    });
+    assert.equal(
+      follows,
+      observation === "exact" ? 1 : 0,
+      "already arrived exact projection is consumed after old empty read",
+    );
+    assert.equal(pendingCommandRegistry.list(sessionId).length, observation === "exact" ? 0 : 1);
+    assert.equal(
+      reads,
+      1,
+      "empty or mismatched proof cannot poll; exact projection needs no reread",
+    );
+  } finally {
+    release({ runs: [] });
+    await act(async () => {
+      renderer.updateContainer(null, root, null, null);
+    });
+    for (const entry of pendingCommandRegistry.list(sessionId))
+      pendingCommandRegistry.settle(sessionId, entry.commandId);
+  }
+}
+for (const observation of ["exact", "empty", "mismatched", "scopeChanged"] as const)
+  test(`original settings follow: ${observation} projection during held read, stale empty completion`, () =>
+    scenario(observation));
