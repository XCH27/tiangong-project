+    },
+    resolve: async (index: number, result = payload("/store/A-v1.html")) => {
+      await act(async () => {
+        pending[index]!.reply.resolve(result);
+        await tick();
+      });
+    },
+    close: async () => {
+      await act(async () => root.unmount());
+      node.remove();
+    },
+  };
