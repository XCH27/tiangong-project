index 00000000..992cfdf6
--- /dev/null
+++ b/packages/ui/src/hooks/workflowArtifactHtmlOpen.ts
@@ -0,0 +1,115 @@
+import type {
+  V4ConversationWorkflowRunArtifactsResult,
+  V4ConversationWorkflowRunArtifactReadResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import type { OpenScopedWorkflowArtifactSideTabRequest } from "../lib/workspaceSidePane.js";
+import { toFileUrl } from "../lib/path.js";
+
+/** Only the authorized original-store reader may supply this path. */
+export function workflowArtifactSnapshotUrl(path: string | undefined): string | null {
+  if (!path || path.length > 4096) return null;
+  for (let index = 0; index < path.length; index++) {
+    const code = path.charCodeAt(index);
+    if (code < 32 || code === 127) return null;
+  }
+  if (!(path.startsWith("/") || /^[A-Za-z]:[\\/]/u.test(path) || path.startsWith("\\\\")))
+    return null;
+  return toFileUrl(path);
+}
+
+/** Resolve the selected durable version; sourcePath is exclusively a workspace reveal hint. */
+export async function resolveWorkflowArtifactHtmlBrowserUrl(
+  request: OpenScopedWorkflowArtifactSideTabRequest,
+  readArtifacts: (params: {
+    workspacePath: string;
+    sessionId: string;
+    runId: string;
+  }) => Promise<V4ConversationWorkflowRunArtifactsResult>,
+  readArtifact: (params: {
+    workspacePath: string;
+    sessionId: string;
+    runId: string;
+    artifactId: string;
+    version: number;
+    offset: number;
+    limit: number;
+    includeLocalSnapshotPath: true;
+  }) => Promise<V4ConversationWorkflowRunArtifactReadResult>,
+): Promise<string | null> {
+  if (request.workspaceIdentity?.trim() || request.remoteSessionId?.trim()) return null;
+  const scope = {
+    workspacePath: request.workspacePath,
+    sessionId: request.parentSessionId,
+    runId: request.runId,
+  };
+  const version =
+    request.version ??
+    (await readArtifacts(scope)).artifacts.find((artifact) => artifact.id === request.artifactId)
+      ?.version;
+  if (version === undefined) return null;
+  const result = await readArtifact({
+    ...scope,
+    artifactId: request.artifactId,
+    version,
+    offset: 0,
+    limit: 1,
+    includeLocalSnapshotPath: true,
+  });
+  if (result.mediaType !== "text/html") return null;
+  return workflowArtifactSnapshotUrl(result.localSnapshotPath);
+}
+
+export interface WorkflowArtifactHtmlOpenScope {
+  service: object;
+  workspaceKey: string;
+  owner: string | null | undefined;
+  workspacePath?: string;
+  remoteSessionId?: string | null | undefined;
+}
+export interface WorkflowArtifactHtmlOpenAttempt {
+  scope: WorkflowArtifactHtmlOpenScope;
+  targetOwner: string;
+  selected: boolean;
+  invalid: boolean;
+}
+/** Permit the initiating history click's one owner transition; later changes fence ABA. */
+export function observeWorkflowArtifactHtmlOpenScope(
+  attempt: WorkflowArtifactHtmlOpenAttempt,
+  next: WorkflowArtifactHtmlOpenScope,
+): void {
+  if (attempt.invalid) return;
+  const previous = attempt.scope;
+  if (
+    next.service !== previous.service ||
+    next.workspaceKey !== previous.workspaceKey ||
+    next.workspacePath !== previous.workspacePath ||
+    next.remoteSessionId !== previous.remoteSessionId
+  ) {
+    attempt.invalid = true;
+  } else if (next.owner !== previous.owner) {
+    if (!attempt.selected && next.owner === attempt.targetOwner) attempt.selected = true;
+    else attempt.invalid = true;
