+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 40; i++) await Promise.resolve();
+};
+
+async function scenario(
+  locale: "en-US" | "zh-CN",
+  result: "successor" | "inplace",
+  lateProjection = false,
+) {
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  const fixture = nativePresentationAgent();
+  const scope = { workspacePath: `/authored/workflow-settings/${locale}/${crypto.randomUUID()}` };
+  const runId = `run-${locale}`;
+  const parentSessionId = `parent-${locale}`;
+  let publishSuccessor: (() => void) | undefined;
+  let releaseRead!: (value: { runs: [] }) => void;
+  const heldRead = new Promise<{ runs: [] }>((resolve) => {
+    releaseRead = resolve;
+  });
+  let reads = 0;
+  const framePort = fixture.agent.onDynamicConversationFrame;
+  fixture.agent.onDynamicConversationFrame = () => (listener) =>
+    framePort()((candidate) => {
+      const wire = conversationTopicWireFrameSchema.parse(candidate);
+      if (wire.kind !== "complete" || wire.frame.payload.kind !== "snapshot")
+        return listener(candidate);
+      const snapshot = conversationSnapshotSchema.parse({
+        ...wire.frame.payload.snapshot,
+        workflowRuns: {
+          revision: 1,
+          runs: [
+            {
+              runId,
+              status: result === "successor" ? "stopped" : "running",
+              concurrencyCeiling: 4,
+              toolCallId: "authored-tool",
+              resumable: true,
+              stopReason: "user",
+              usage: { spentTokens: 0, nodesUsed: 0 },
+              actors: [],
+              nodes: [],
+              lastEventSequence: 1,
+            },
+          ],
+        },
+      });
+      publishSuccessor = () => {
+        const value = conversationSnapshotSchema.parse({
+          ...snapshot,
+          seq: 1,
+          revision: 1,
+          workflowRuns: {
+            revision: 2,
+            runs: [
+              ...snapshot.workflowRuns!.runs,
+              {
+                ...snapshot.workflowRuns!.runs[0],
+                runId: "authored-successor",
+                toolCallId: "accepted-tool",
+                status: "running",
+                lastEventSequence: 2,
+              },
+            ],
+          },
+        });
+        listener(
+          conversationTopicWireFrameSchema.parse({
+            ...wire,
+            deliveryKind: "online",
+            logicalFrameId: crypto.randomUUID(),
+            logicalFrameOrdinal: 2,
+            frame: {
+              ...wire.frame,
+              fromSeq: 0,
+              toSeq: 1,
+              payload: { kind: "snapshot", snapshot: value },
+            },
+          }),
+        );
+      };
+      listener({ ...wire, frame: { ...wire.frame, payload: { kind: "snapshot", snapshot } } });
+    });
