+import type {
+  WorkflowRunSettingsAccepted,
+  WorkflowRunSettingsHost,
+} from "./WorkflowRunSettingsPopover.js";
+import { WorkflowRunSettingsUncertainError } from "./useWorkflowRunSettingsControl.js";
+const SESSION_MODEL_VALUE = "workflow-settings:session-model";
+export function WorkflowRunSettingsForm({
+  host,
+  onAccepted,
+  onClose,
+  run,
+}: {
+  host: WorkflowRunSettingsHost;
+  onAccepted?: (accepted: WorkflowRunSettingsAccepted) => void;
+  onClose: () => void;
+  run: WorkflowRunState;
+}) {
+  const alive = useRef(true);
+  useEffect(() => {
+    alive.current = true;
+    return () => {
+      alive.current = false;
+    };
+  }, []);
+  const isCurrent = () => alive.current && (host.recovery?.isCurrent() ?? true);
+  const { intl } = useZCodeIntl();
+  const format = useCallback(
