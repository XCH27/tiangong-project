+  const mount = async () =>
+    act(async () => {
+      root.render(
+        <PlatformProvider platform={{} as IPlatformService}>
+          <ServiceProvider
+            services={
+              {
+                zcodeAgentService: fixture.agent,
+                modelSelectionService: {
+                  getView: async () => ({ revision: 0, providers: [] }),
+                  onDidChange: () => ({ dispose() {} }),
+                },
+              } as unknown as IServiceAccessor
+            }
+          >
+            <TabStoreProvider>
+              <ZCodeIntlProvider initialLocale={locale}>
+                <TooltipProvider>
