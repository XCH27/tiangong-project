index 00000000..ee9e0256
--- /dev/null
+++ b/packages/ui/test/workflowArtifactPreviewForwarding.test.ts
@@ -0,0 +1,208 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+// This peer is an authored transport-contract consumer, not a real Host or replacement
+// production service. Real Host/Store admission is covered by workflowArtifactHtmlIdentityHost.
+const peerSource = String.raw`
+const {createInterface} = require('node:readline');
+const {appendFileSync, readFileSync} = require('node:fs');
+const [log, snapshot] = process.argv.slice(2);
+const allowed = new Set(['sessionId','runId','artifactId','version','offset','limit','includeLocalSnapshotPath']);
+const lines = createInterface({input:process.stdin});
+lines.on('line', line => {
+  const request = JSON.parse(line);
+  appendFileSync(log, JSON.stringify(request)+'\n');
+  if (request.method !== 'v4/conversation/workflowRunArtifactRead') {
+    process.stdout.write(JSON.stringify({id:request.id,error:{code:-32601,message:'Unexpected fixture method'}})+'\n'); return;
+  }
+  const p = request.params;
+  if (Object.keys(p).some(key => !allowed.has(key)) ||
+      ('includeLocalSnapshotPath' in p && p.includeLocalSnapshotPath !== true) ||
+      p.sessionId !== 'original-parent' || p.runId !== 'original-run' || p.artifactId !== 'page' || p.version !== 1) {
+    process.stdout.write(JSON.stringify({id:request.id,error:{code:-32602,message:'Invalid authored tuple/flag'}})+'\n'); return;
+  }
+  const bytes = readFileSync(snapshot);
+  const start = Math.min(p.offset,bytes.length), end = Math.min(start+p.limit,bytes.length);
+  const result = {dataBase64:bytes.subarray(start,end).toString('base64'),mediaType:'text/html',totalBytes:bytes.length,nextOffset:end<bytes.length?end:null};
+  if (p.includeLocalSnapshotPath === true) result.localSnapshotPath = snapshot;
+  process.stdout.write(JSON.stringify({id:request.id,result})+'\n');
+});
+`;
+
+test(
+  "real AgentConversationTransport → AgentService → readonly stdio client preserves saved HTML opt-in",
+  { timeout: 15000 },
+  async (t) => {
+    const root = await mkdtemp(join(tmpdir(), "fleet-html-forwarding-"));
+    const workspacePath = join(root, "workspace"),
+      snapshot = join(root, "selected.html"),
+      log = join(root, "requests.jsonl");
+    const envValues = {
+      ZCODE_DATA_BASE_DIR: root,
+      ZCODE_DESKTOP_HOME_DIR: root,
+      ZCODE_HOME: join(root, "cli-home"),
+      ZCODE_STORAGE_DIR: join(root, "cli-storage"),
+      ZCODE_SESSION_DB: join(root, "session.sqlite"),
+    };
+    const previous = Object.fromEntries(
+      Object.keys(envValues).map((key) => [key, process.env[key]]),
+    );
+    Object.assign(process.env, envValues);
+    let networkCalls = 0;
+    t.mock.method(globalThis, "fetch", async () => {
+      networkCalls++;
+      throw new Error("No network is authorized in fixture");
+    });
+    let service:
+      | (import("@zcode/services").IZCodeAgentService & { disposeAllAndWait(): Promise<void> })
+      | undefined;
+    try {
+      await mkdir(workspacePath);
+      const html = "<!doctype html><title>original version</title><p>A</p>";
+      await writeFile(snapshot, html);
+      const peer = join(root, "peer.cjs");
+      await writeFile(peer, peerSource);
+      // Constructor imports happen only after all original storage roots are isolated.
+      const { setDataBaseDir } = await import("../../services/src/paths.js");
+      setDataBaseDir(root);
+      const { createZCodeAgentService } =
+        await import("../../services/src/zcode-agent/zcodeAgentService.js");
+      const { createAgentConversationTransport } =
+        await import("../src/v4/agentConversationTransport.js");
+      const { resolveWorkflowArtifactHtmlBrowserUrl } =
+        await import("../src/hooks/workflowArtifactHtmlOpen.js");
+      const agentService = createZCodeAgentService({
+        requestTimeoutMs: 3000,
+        commandResolver: () => ({
+          command: process.execPath,
+          args: [peer, log, snapshot],
+          cwd: workspacePath,
+          supportsStorageStartup: false,
+          env: envValues,
+        }),
+      });
+      service = agentService;
+      const transport = createAgentConversationTransport(agentService, { workspacePath });
+      const base = {
+        sessionId: "original-parent",
+        runId: "original-run",
+        artifactId: "page",
+        version: 1,
+        offset: 0,
+        limit: 4,
+      };
+      await t.test(
+        "transport opt-in reaches actual readonly client and JSON decode returns the selected bytes",
+        async () => {
+          const result = await transport.workflowRunArtifactRead({
+            ...base,
+            includeLocalSnapshotPath: true,
+          });
+          assert.equal(result.localSnapshotPath, snapshot);
+          assert.equal(Buffer.from(result.dataBase64, "base64").toString(), html.slice(0, 4));
+          assert.equal(result.nextOffset, 4);
+          assert.equal(
+            Object.hasOwn(result, "bytes"),
+            false,
+            "JSON chunk carries base64, not a typed-array wire field",
+          );
+        },
+      );
+      await t.test(
+        "ordinary subsequent chunks and false opt-in omit the flag and retain old strict reply shape",
+        async () => {
+          for (const extra of [{}, { includeLocalSnapshotPath: false }]) {
+            const result = await transport.workflowRunArtifactRead({
+              ...base,
+              offset: 4,
+              ...extra,
+            });
+            assert.deepEqual(
+              Object.keys(result).sort(),
+              ["dataBase64", "mediaType", "nextOffset", "totalBytes"].sort(),
+            );
+            assert.equal(result.localSnapshotPath, undefined);
+            assert.equal(Buffer.from(result.dataBase64, "base64").toString(), html.slice(4, 8));
+          }
+        },
+      );
+      await t.test(
+        "actual direct HTML consumer resolves the saved URL through real service forwarding",
+        async () => {
+          const url = await resolveWorkflowArtifactHtmlBrowserUrl(
+            {
+              workspacePath,
+              parentSessionId: base.sessionId,
+              runId: base.runId,
+              artifactId: base.artifactId,
+              version: 1,
+              contentType: "text/html",
+              sourcePath: "newer.html",
+            },
+            async () => {
+              assert.fail("explicit version must not read latest metadata");
+            },
+            (params) => agentService.conversationWorkflowRunArtifactReadV4(params),
+          );
+          assert.ok(url);
+          assert.equal(await readFile(fileURLToPath(url), "utf8"), html);
+        },
+      );
+      await t.test(
+        "remote HTML consumers refuse local snapshot resolution before any readonly query",
+        async () => {
+          for (const remote of [
+            { workspaceIdentity: "ssh-authored" },
+            { remoteSessionId: "authored-remote" },
+          ]) {
+            const url = await resolveWorkflowArtifactHtmlBrowserUrl(
+              {
+                workspacePath,
+                parentSessionId: base.sessionId,
+                runId: base.runId,
+                artifactId: base.artifactId,
+                version: 1,
+                contentType: "text/html",
+                ...remote,
+              },
+              async () => {
+                assert.fail("remote preview must not read metadata");
+              },
+              (params) => agentService.conversationWorkflowRunArtifactReadV4(params),
+            );
+            assert.equal(url, null);
+          }
+        },
+      );
+      const requests: Array<{ method: string; params: Record<string, unknown> }> = (
+        await readFile(log, "utf8")
+      )
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line));
+      assert.equal(requests.length, 4);
+      assert.deepEqual(
+        requests.map((row) => row.params.includeLocalSnapshotPath),
+        [true, undefined, undefined, true],
+      );
+      assert.ok(
+        requests.every((row) => row.method === "v4/conversation/workflowRunArtifactRead"),
+        "only original readonly query was sent",
+      );
+      assert.equal(networkCalls, 0);
+    } finally {
+      await service?.disposeAllAndWait();
+      const { setDataBaseDir } = await import("../../services/src/paths.js");
+      setDataBaseDir(null);
+      for (const [key, value] of Object.entries(previous)) {
+        if (value === undefined) delete process.env[key];
+        else process.env[key] = value;
+      }
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+);
