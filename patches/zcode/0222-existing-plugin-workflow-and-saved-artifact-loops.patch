+        if (input.includeLocalSnapshotPath) {
+          optIn++;
+          throw new Error("Unrecognized includeLocalSnapshotPath");
+        }
+        return payload();
+      };
+      try {
+        await f.render(f.a.agent, "A", "bytes");
+        const state = JSON.parse(f.node.querySelector('[data-testid="bytes-state"]')!.textContent!);
+        check(
+          optIn === 1 && state.bytes === 14 && state.error === null && state.path === null,
+          "legacy reader retains bytes without granting current-source preview",
+        );
+      } finally {
+        await f.close();
+      }
+    },
+  );
+  await scenario("selected non-HTML version never opts into local snapshot paths", async () => {
+    const f = await fixture();
+    let optIn = 0;
+    f.a.agent.conversationWorkflowRunArtifactReadV4 = async (input) => {
+      if (input.includeLocalSnapshotPath) optIn++;
+      return { dataBase64: btoa("x"), mediaType: "text/plain", totalBytes: 1, nextOffset: null };
+    };
+    try {
+      await f.render(f.a.agent, "A", "bytes");
+      const state = JSON.parse(f.node.querySelector('[data-testid="bytes-state"]')!.textContent!);
+      check(
+        optIn === 0 && state.bytes === 1 && state.path === null,
+        "ordinary selected version keeps original query shape",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  return results;
+}
+(
+  window as Window & { __workflowArtifactHtmlIdentityTests?: unknown }
+).__workflowArtifactHtmlIdentityTests = run();
diff --git a/packages/ui/test/workflowArtifactHtmlIdentityHost.test.ts b/packages/ui/test/workflowArtifactHtmlIdentityHost.test.ts
new file mode 100644
index 00000000..6a2b11f6
--- /dev/null
+++ b/packages/ui/test/workflowArtifactHtmlIdentityHost.test.ts
@@ -0,0 +1,171 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile, writeFile, unlink } from "node:fs/promises";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  V4_METHODS,
+  v4ConversationWorkflowRunArtifactsResultSchema,
+  v4ConversationWorkflowRunArtifactReadResultSchema,
+} from "@zcode/shared/zcode-protocol-v4";
+import {
+  productionHandoffFixture,
+  waitForRun,
+} from "../../../apps/zcode-cli/packages/bootstrap/test/helpers/production-handoff-fixture.js";
+import { resolveWorkflowArtifactHtmlBrowserUrl } from "../src/hooks/workflowArtifactHtmlOpen.js";
+
+const saved = "<!doctype html><title>A saved version</title><p>A-v1</p>";
+const replacement = "<!doctype html><title>B current file</title><p>B-current</p>";
+const finish = {
+  text: "authored completion",
+  finishReason: "stop" as const,
+  usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
+};
+
+test("actual Host saved HTML keeps original version after another Session and external edit then cold reopen", async () => {
+  const h = await productionHandoffFixture();
+  try {
+    const a = await h.createSession();
+    const write = async (app: typeof a, content: string) => {
+      h.f.steps([
+        {
+          ...finish,
+          text: "",
+          finishReason: "tool-calls",
+          toolCalls: [
+            {
+              id: `authored-write-${content.length}`,
+              name: "Write",
+              input: { file_path: "page.html", content },
+            },
+          ],
+        },
+        finish,
+      ]);
+      await app.submitPrompt("Write the authored fixture page");
+    };
+    await write(a, saved);
+    await h.saveWorkflow(
+      a,
+      "saved-html",
+      'await artifact.file("page", "page.html", {contentType:"text/html",primary:true});',
+    );
+    assert.ok(a.startSavedWorkflow);
+    const started = await a.startSavedWorkflow({ name: "saved-html", scope: "project" });
+    assert.ok(started.ok, JSON.stringify(started));
+    assert.equal((await waitForRun(a, started.runId)).status, "completed");
+    const parentSessionId = String(a.sessionId);
+    const b = await h.createSession();
+    assert.notEqual(String(b.sessionId), parentSessionId);
+    h.f.steps([finish]);
+    await b.submitPrompt("Authored alternate Session current view");
+    const otherSessionId = String(b.sessionId);
+    // Authored external-file edit is also a supported way the workspace source can change.
+    await writeFile(join(h.workspace.workspacePath, "page.html"), replacement);
+    assert.equal(await readFile(join(h.workspace.workspacePath, "page.html"), "utf8"), replacement);
+    await h.restart();
+    const params = { sessionId: parentSessionId, runId: started.runId };
+    const metadata = v4ConversationWorkflowRunArtifactsResultSchema.parse(
+      await h.request(V4_METHODS.conversationWorkflowRunArtifacts, params),
+    );
+    assert.equal(metadata.artifacts[0]?.version, 1);
+    const original = v4ConversationWorkflowRunArtifactReadResultSchema.parse(
+      await h.request(V4_METHODS.conversationWorkflowRunArtifactRead, {
+        ...params,
+        artifactId: "page",
+        version: 1,
+        offset: 0,
+        limit: 1024,
+      }),
+    );
+    assert.equal(Buffer.from(original.dataBase64, "base64").toString(), saved);
+    assert.deepEqual(
+      Object.keys(original).sort(),
+      ["dataBase64", "mediaType", "nextOffset", "totalBytes"].sort(),
+      "ordinary read retains exact legacy reply shape",
+    );
+    const foreign = await h.raw(V4_METHODS.conversationWorkflowRunArtifactRead, {
+      sessionId: otherSessionId,
+      runId: started.runId,
+      artifactId: "page",
+      version: 1,
+      offset: 0,
+      limit: 1,
+      includeLocalSnapshotPath: true,
+    });
+    assert.ok(foreign && "error" in foreign, JSON.stringify(foreign));
+    assert.match(JSON.stringify(foreign.error), /workflowRunArtifactRead.notFound/);
+    const url = await resolveWorkflowArtifactHtmlBrowserUrl(
+      {
+        workspacePath: h.workspace.workspacePath,
+        parentSessionId,
+        runId: started.runId,
+        artifactId: "page",
+        version: 1,
+        contentType: "text/html",
+      },
+      async ({ workspacePath: _workspacePath, ...request }) =>
+        v4ConversationWorkflowRunArtifactsResultSchema.parse(
+          await h.request(V4_METHODS.conversationWorkflowRunArtifacts, request),
+        ),
+      async ({ workspacePath: _workspacePath, ...request }) =>
+        v4ConversationWorkflowRunArtifactReadResultSchema.parse(
+          await h.request(V4_METHODS.conversationWorkflowRunArtifactRead, request),
+        ),
+    );
+    assert.ok(url);
+    assert.equal(
+      await readFile(fileURLToPath(url), "utf8"),
+      saved,
+      "The production HTML open route must show stored version 1, not B's mutable source",
+    );
+    const optedParams = {
+      ...params,
+      artifactId: "page",
+      version: 1,
+      offset: 0,
+      limit: 1,
+      includeLocalSnapshotPath: true,
+    };
+    const selected = v4ConversationWorkflowRunArtifactReadResultSchema.parse(
+      await h.request(V4_METHODS.conversationWorkflowRunArtifactRead, optedParams),
+    );
+    assert.equal(selected.localSnapshotPath, fileURLToPath(url));
+    assert.match(selected.localSnapshotPath!, /\.html$/);
+    await writeFile(selected.localSnapshotPath!, "X".repeat(Buffer.byteLength(saved)));
+    const changed = await h.raw(V4_METHODS.conversationWorkflowRunArtifactRead, optedParams);
+    assert.ok(changed && "error" in changed, JSON.stringify(changed));
+    assert.match(
+      JSON.stringify(changed.error),
+      /snapshotChanged/,
+      "same-length warm snapshot divergence is refused",
+    );
+    const legacyCached = v4ConversationWorkflowRunArtifactReadResultSchema.parse(
+      await h.request(V4_METHODS.conversationWorkflowRunArtifactRead, {
+        ...params,
+        artifactId: "page",
+        version: 1,
+        offset: 0,
+        limit: 1024,
+      }),
+    );
+    assert.equal(legacyCached.localSnapshotPath, undefined);
+    assert.equal(
+      Buffer.from(legacyCached.dataBase64, "base64").toString(),
+      saved,
+      "ordinary cached bytes remain readable without granting a browser path",
+    );
+    await writeFile(selected.localSnapshotPath!, saved);
+    await unlink(selected.localSnapshotPath!);
+    const missing = await h.raw(V4_METHODS.conversationWorkflowRunArtifactRead, optedParams);
+    assert.ok(missing && "error" in missing, JSON.stringify(missing));
+    await writeFile(selected.localSnapshotPath!, saved);
+    const restored = v4ConversationWorkflowRunArtifactReadResultSchema.parse(
+      await h.request(V4_METHODS.conversationWorkflowRunArtifactRead, optedParams),
+    );
+    assert.equal(restored.localSnapshotPath, selected.localSnapshotPath);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    await h.close();
+  }
+});
