diff --git a/packages/ui/src/chat-input-toolbar/VirtualComposerModelList.tsx b/packages/ui/src/chat-input-toolbar/VirtualComposerModelList.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a81fe07119afa9c6493b492921b052e5d93de684
--- /dev/null
+++ b/packages/ui/src/chat-input-toolbar/VirtualComposerModelList.tsx
@@ -0,0 +1,145 @@
+import { defaultRangeExtractor, useVirtualizer } from "@tanstack/react-virtual";
+import {
+  cloneElement,
+  isValidElement,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+  type AriaAttributes,
+  type ReactNode,
+  type RefObject,
+} from "react";
+import { DropdownMenuRadioGroup } from "@/components/ui/dropdown-menu.js";
+import type { ModelSelectGroup, ModelSelectGroupItem } from "@/ModelConfigSelect.js";
+
+/** Large catalogs retain the same menu rows; only mounting and full-list keyboard travel differ. */
+export function VirtualComposerModelList({
+  groups,
+  value,
+  renderHeading,
+  renderItem,
+  focusFirstRef,
+}: {
+  groups: readonly ModelSelectGroup[];
+  value: string;
+  renderHeading: (group: ModelSelectGroup) => ReactNode;
+  renderItem: (item: ModelSelectGroupItem) => ReactNode;
+  focusFirstRef: RefObject<(() => void) | null>;
+}) {
+  const rows = useMemo(
+    () =>
+      groups.flatMap((group) => [
+        { key: JSON.stringify(["heading", group.key]), group, item: undefined },
+        ...group.items.map((item) => ({
+          key: JSON.stringify(["model", group.key, item.key]),
+          group,
+          item,
+        })),
+      ]),
+    [groups],
+  );
+  const modelIndexes = useMemo(
+    () => rows.flatMap((row, index) => (row.item ? [index] : [])),
+    [rows],
+  );
+  const scroller = useRef<HTMLDivElement>(null);
+  const [focusedIndex, setFocusedIndex] = useState<number | null>(null);
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scroller.current,
+    getItemKey: (index) => rows[index]?.key ?? index,
+    estimateSize: () => 32,
+    overscan: 4,
+    // Keep both a pending keyboard destination and actual native/pointer focus.
+    // The latter must be read before scrolling unmounts its DOM row.
+    rangeExtractor: (range) => {
+      const active = document.activeElement;
+      const activeRow =
+        active instanceof HTMLElement && scroller.current?.contains(active)
+          ? active.closest<HTMLElement>("[data-index]")
+          : null;
+      const activeIndex = activeRow ? Number(activeRow.dataset.index) : undefined;
+      return [
+        ...new Set([
+          ...defaultRangeExtractor(range),
+          ...(focusedIndex === null ? [] : [focusedIndex]),
+          ...(activeIndex === undefined ? [] : [activeIndex]),
+        ]),
+      ].sort((a, b) => a - b);
+    },
+  });
+  const move = (index: number | undefined) => {
+    if (index === undefined) return;
+    setFocusedIndex(index);
+    virtualizer.scrollToIndex(index, { align: "auto" });
+  };
+  useLayoutEffect(() => {
+    focusFirstRef.current = () => move(modelIndexes[0]);
+    return () => {
+      focusFirstRef.current = null;
+    };
+  });
+  useLayoutEffect(() => {
+    if (focusedIndex === null) return;
+    scroller.current
+      ?.querySelector<HTMLElement>(`[data-index="${focusedIndex}"] [role^="menuitem"]`)
+      ?.focus({ preventScroll: true });
+  }, [focusedIndex]);
+
+  return (
+    <div
+      ref={scroller}
+      className="h-60 overflow-y-auto"
+      data-composer-virtual-model-list="true"
+      onKeyDownCapture={(event) => {
+        if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
+        if (!(event.target as HTMLElement).closest('[role^="menuitem"]')) return;
+        const row = (event.target as HTMLElement).closest<HTMLElement>("[data-index]");
+        if (!row) return;
+        const current = modelIndexes.indexOf(Number(row.dataset.index));
+        const next =
+          event.key === "Home"
+            ? 0
+            : event.key === "End"
+              ? modelIndexes.length - 1
+              : Math.min(
+                  modelIndexes.length - 1,
+                  Math.max(0, current + (event.key === "ArrowDown" ? 1 : -1)),
+                );
+        event.preventDefault();
+        event.stopPropagation();
+        move(modelIndexes[next]);
+      }}
+    >
+      <DropdownMenuRadioGroup
+        value={value}
+        className="relative"
+        style={{ height: virtualizer.getTotalSize() }}
+      >
+        {virtualizer.getVirtualItems().map((row) => {
+          const source = rows[row.index];
+          if (!source) return null;
+          const item = source.item ? renderItem(source.item) : undefined;
+          const content = isValidElement<AriaAttributes>(item)
+            ? cloneElement(item, {
+                "aria-setsize": modelIndexes.length,
+                "aria-posinset": modelIndexes.indexOf(row.index) + 1,
+              })
+            : item;
+          return (
+            <div
+              key={row.key}
+              ref={virtualizer.measureElement}
+              data-index={row.index}
+              className="absolute top-0 left-0 w-full"
+              style={{ transform: `translateY(${row.start}px)` }}
+            >
+              {source.item ? content : renderHeading(source.group)}
+            </div>
+          );
+        })}
+      </DropdownMenuRadioGroup>
+    </div>
+  );
+}
