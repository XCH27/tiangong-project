+test("display groups model IDs across identities without mutating source accounting rows", () => {
+  const rows = Object.freeze([
+    Object.freeze(row({ inputTokens: 100, estimatedUsd: 0.25, pricedCount: 1 })),
+    Object.freeze(
+      row({
+        accountId: "account-b",
+        inputTokens: 200,
+        estimatedUsd: 0.5,
+        pricedCount: 1,
+      }),
+    ),
+    Object.freeze(
+      row({
+        providerId: "provider-b",
+        accountId: null,
+        inputTokens: 300,
+        reportedCount: 1,
+      }),
+    ),
+    Object.freeze(row({ modelId: "model-b", inputTokens: 50 })),
+  ]);
+  const before = structuredClone(rows);
+  const { models, total } = aggregateUsageAccounting(rows);
+  assert.deepEqual(rows, before);
+  assert.equal(models.length, 2);
+  assert.equal(models[0]?.modelId, "model-a");
+  assert.equal(models[0]?.requests, 3);
+  assert.equal(models[0]?.input, 600);
+  assert.equal(models[0]?.usd, 0.75);
+  assert.equal(models[0]?.priced, 2);
+  assert.equal(models[0]?.reports, 1);
+  assert.equal(total.requests, 4);
+  assert.equal(total.input, 650);
+  assert.equal(total.usd, 0.75);
+});
