index 0000000000000000000000000000000000000000..4683a2de2134d1c3a61e6968809d9c318b3e259d
--- /dev/null
+++ b/packages/ui/src/settings/usage-stats/usageAccountingViewModel.ts
@@ -0,0 +1,71 @@
+import type { UsageAccountingRow } from "@zcode/shared";
+
+export interface UsageAccountingTotals {
+  requests: number;
+  reports: number;
+  input: number;
+  output: number;
+  cache: number;
+  cacheInput: number;
+  cacheReports: number;
+  usd: number;
+  priced: number;
+  fast: number;
+  speedReports: number;
+}
+
+export interface UsageAccountingModel extends UsageAccountingTotals {
+  modelId: string;
+}
+
+function emptyTotals(): UsageAccountingTotals {
+  return {
+    requests: 0,
+    reports: 0,
+    input: 0,
+    output: 0,
+    cache: 0,
+    cacheInput: 0,
+    cacheReports: 0,
+    usd: 0,
+    priced: 0,
+    fast: 0,
+    speedReports: 0,
+  };
+}
+
+function addRow(target: UsageAccountingTotals, row: UsageAccountingRow): void {
+  target.requests += row.requestCount;
+  target.reports += row.reportedCount;
+  target.input += row.inputTokens;
+  target.output += row.outputTokens;
+  target.cache += row.cacheReadTokens;
+  target.cacheInput += row.cacheInputTokens;
+  target.cacheReports += row.cacheReportedCount;
+  target.usd += row.estimatedUsd;
+  target.priced += row.pricedCount;
+  if (row.speedMode === "fast") target.fast += row.requestCount;
+  // 历史记录或未知速度值不等于标准模式，覆盖率只计入明确记录的请求模式。
+  if (row.speedMode === "standard" || row.speedMode === "fast")
+    target.speedReports += row.requestCount;
+}
+
+/** Display-only grouping; retain denominators and coverage instead of averaging rates. */
+export function aggregateUsageAccounting(rows: readonly UsageAccountingRow[]): {
+  models: UsageAccountingModel[];
+  total: UsageAccountingTotals;
+} {
+  const groups = new Map<string, UsageAccountingModel>();
+  const total = emptyTotals();
+  for (const row of rows) {
+    const model = groups.get(row.modelId) ?? { modelId: row.modelId, ...emptyTotals() };
+    addRow(model, row);
+    addRow(total, row);
+    groups.set(row.modelId, model);
+  }
+  const models = [...groups.values()].sort((a, b) => {
+    const tokenDifference = b.input + b.output - (a.input + a.output);
+    return tokenDifference || (a.modelId < b.modelId ? -1 : a.modelId > b.modelId ? 1 : 0);
+  });
+  return { models, total };
+}
