+import { useMemo } from "react";
+import { Cell, Pie, PieChart } from "recharts";
+import { ChartContainer, ChartTooltip, ChartTooltipContent } from "@/components/ui/chart.js";
+import { Progress } from "@/components/ui/progress.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+
+export interface UsageChartSegment {
+  key: string;
+  label: string;
+  value: number;
+  color: string;
+  displayValue: string;
+}
+export interface UsageChartLegendRow {
+  key: string;
+  label: string;
+  color: string;
+  value: string;
+  detail?: string;
+  hint?: string;
+  ratio?: number;
+}
+
+/** Original ZCode model donut and legend, shared by its metrics and account-period allocation. */
+export function UsageDistributionChart({
+  segments,
+  rows,
+  value,
+  label,
+}: {
+  segments: UsageChartSegment[];
+  rows: UsageChartLegendRow[];
+  value: string;
+  label: string;
+}) {
+  const config = useMemo(
+    () =>
+      Object.fromEntries(
+        segments.map((item) => [item.key, { label: item.label, color: item.color }]),
+      ),
+    [segments],
+  );
+  const positive = useMemo(() => segments.filter((item) => item.value > 0), [segments]);
+  return (
+    <div className="grid gap-4 px-3 py-3 md:grid-cols-2">
+      <div className="relative mx-auto h-56 w-full max-w-64 self-center md:h-64 md:max-w-72">
+        {positive.length ? (
+          <ChartContainer config={config} className="relative z-20 h-56 w-full md:h-64">
+            <PieChart accessibilityLayer margin={{ top: 4, right: 4, bottom: 4, left: 4 }}>
+              <ChartTooltip
+                cursor={false}
+                content={
+                  <ChartTooltipContent
+                    hideLabel
+                    formatter={(_value, _name, item) => {
+                      const segment = item.payload as UsageChartSegment;
+                      return (
+                        <>
+                          <span
+                            className="size-2 shrink-0 self-center rounded-full"
+                            style={{ backgroundColor: segment.color }}
+                          />
+                          <span className="min-w-0 flex-1 truncate text-foreground-subtle">
+                            {segment.label}
+                          </span>
+                          <span className="font-mono font-medium tabular-nums">
+                            {segment.displayValue}
+                          </span>
+                        </>
+                      );
+                    }}
+                  />
+                }
+              />
+              <Pie
+                data={positive}
+                dataKey="value"
+                nameKey="key"
+                innerRadius="56%"
+                outerRadius="86%"
+                paddingAngle={positive.length > 1 ? 2 : 0}
+                stroke="var(--color-surface)"
+                strokeWidth={2}
+              >
+                {positive.map((item) => (
+                  <Cell key={item.key} fill={`var(--color-${item.key})`} />
+                ))}
+              </Pie>
+            </PieChart>
+          </ChartContainer>
+        ) : null}
+        <div className="pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center px-8 text-center">
+          <div className="max-w-full truncate text-ui-sm font-semibold text-foreground">
+            {value}
+          </div>
+          <div className="max-w-full truncate text-ui-sm text-foreground-subtle">{label}</div>
+        </div>
+      </div>
+      <div className="min-w-0 self-center max-h-80 overflow-y-auto" role="list">
+        {rows.map((row) => {
+          const content = (
+            <div
+              key={row.key}
+              tabIndex={row.hint ? 0 : undefined}
+              aria-label={row.hint ? `${row.label}: ${row.value}. ${row.hint}` : undefined}
+              className="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-2 gap-y-1 border-b border-border/70 py-2 last:border-b-0"
+              role="listitem"
+            >
+              <span
+                className="size-2.5 shrink-0 rounded-sm"
+                style={{ backgroundColor: row.color }}
+              />
+              <span className="min-w-0 truncate font-mono text-ui-sm text-foreground">
+                {row.label}
+              </span>
+              <span className="font-mono text-ui-sm text-foreground-subtle tabular-nums">
+                {row.value}
+              </span>
+              {row.detail ? (
+                <span className="col-start-2 min-w-0 truncate text-ui-sm text-foreground-subtle">
+                  {row.detail}
+                </span>
+              ) : null}
+              {row.ratio !== undefined ? (
+                <Progress
+                  className="col-start-2 col-span-2 mt-1"
+                  value={row.ratio * 100}
+                  aria-label={row.label}
+                  aria-valuenow={row.ratio * 100}
+                  segments={[{ id: row.key, percent: 1, style: { backgroundColor: row.color } }]}
+                />
+              ) : null}
+            </div>
+          );
+          return row.hint ? (
+            <ControlHintTooltip key={row.key} title={row.hint} triggerClassName="shrink">
+              {content}
+            </ControlHintTooltip>
+          ) : (
+            content
+          );
+        })}
+      </div>
+    </div>
+  );
+}
