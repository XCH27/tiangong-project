+++ b/packages/ui/src/settings/usage-stats/SubscriptionPaymentChart.tsx
@@ -0,0 +1,68 @@
+import { useMemo } from "react";
+import type { allocateSubscriptionPayment, SubscriptionPayment } from "@zcode/shared";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { UsageDistributionChart } from "./UsageDistributionChart.js";
+import { getAppUsageModelChartColor } from "./appUsageChartPalette.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+
+export function SubscriptionPaymentChart({
+  payment,
+  allocation,
+}: {
+  payment: SubscriptionPayment;
+  allocation: ReturnType<typeof allocateSubscriptionPayment>;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const view = useMemo(() => {
+    const money = (value: number) =>
+      new Intl.NumberFormat(locale, {
+        style: "currency",
+        currency: payment.currency,
+        maximumFractionDigits: 4,
+      }).format(value);
+    const basis = intl.formatMessage({
+      id: `settings.usage.payments.${allocation.basis === "credits" ? "credits" : "api"}`,
+    });
+    const segments = allocation.models.map((model, index) => ({
+      key: `model${index}`,
+      label: model.modelId,
+      value: model.amount,
+      color: getAppUsageModelChartColor(index),
+      displayValue: money(model.amount),
+    }));
+    return {
+      value: money(payment.amount),
+      label: intl.formatMessage({ id: "settings.usage.payments.amount" }),
+      segments,
+      rows: allocation.models.map((model, index) => ({
+        key: `model${index}`,
+        label: model.modelId,
+        color: getAppUsageModelChartColor(index),
+        value: money(model.amount),
+        detail:
+          model.perMillionTokens !== null
+            ? `${money(model.perMillionTokens)} / 1M Tokens`
+            : undefined,
+        hint:
+          payment.end > Date.now()
+            ? `${basis}\n${intl.formatMessage({ id: "settings.usage.payments.provisional" })}`
+            : basis,
+      })),
+    };
+  }, [allocation, payment, intl, locale]);
+  return allocation.basis === "unavailable" ? (
+    <div className="flex items-center justify-between gap-3 px-3 py-3">
+      <div className="flex items-baseline gap-2">
+        <span className="text-ui-base text-foreground-subtle">{view.label}</span>
+        <span className="text-ui-lg font-medium tabular-nums">{view.value}</span>
+      </div>
+      <ControlHintTooltip title={intl.formatMessage({ id: "settings.usage.payments.unavailable" })}>
+        <span tabIndex={0} className="text-ui-sm text-foreground-subtle">
+          {intl.formatMessage({ id: "settings.usage.payments.unallocated" })}
+        </span>
+      </ControlHintTooltip>
+    </div>
+  ) : (
+    <UsageDistributionChart {...view} />
+  );
+}
