@@ -0,0 +1,158 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { UsageAccountingRow } from "@zcode/shared";
+import { aggregateUsageAccounting } from "../src/settings/usage-stats/usageAccountingViewModel.js";
+
+function row(overrides: Partial<UsageAccountingRow> = {}): UsageAccountingRow {
+  return {
+    providerId: "provider-a",
+    accountId: "account-a",
+    modelId: "model-a",
+    speedMode: null,
+    requestCount: 1,
+    reportedCount: 0,
+    inputTokens: 0,
+    outputTokens: 0,
+    cacheReadTokens: 0,
+    cacheInputTokens: 0,
+    cacheReportedCount: 0,
+    estimatedUsd: 0,
+    pricedCount: 0,
+    estimatedCredits: 0,
+    creditCount: 0,
+    firstAt: 1,
+    lastAt: 1,
+    priceVersions: null,
+    ...overrides,
+  };
+}
+
+test("cache rate uses combined token denominators, never the average of row rates", () => {
+  const { models, total } = aggregateUsageAccounting([
+    row({
+      reportedCount: 1,
+      inputTokens: 100,
+      outputTokens: 10,
+      cacheReadTokens: 90,
+      cacheInputTokens: 100,
+      cacheReportedCount: 1,
+    }),
+    row({
+      requestCount: 3,
+      reportedCount: 3,
+      inputTokens: 900,
+      outputTokens: 20,
+      cacheReadTokens: 90,
+      cacheInputTokens: 900,
+      cacheReportedCount: 3,
+    }),
+  ]);
+  assert.equal(models.length, 1);
+  assert.equal(models[0]?.cache, 180);
+  assert.equal(models[0]?.cacheInput, 1_000);
+  assert.equal(total.cache / total.cacheInput, 0.18);
+  assert.equal(total.requests, 4);
+  assert.equal(total.cacheReports, 4);
+  assert.equal(total.input, 1_000);
+  assert.equal(total.output, 30);
+});
+
+test("reported zero remains distinct from unknown price, usage, cache and speed", () => {
+  const result = aggregateUsageAccounting([
+    row({
+      requestCount: 2,
+      reportedCount: 2,
