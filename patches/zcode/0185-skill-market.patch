+test("a source added from the Skill market lists its SKILL.md folders even beside a plugin manifest", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-skill-source-"));
+  try {
+    const repo = join(root, "mixed");
+    await mkdir(join(repo, ".claude-plugin"), { recursive: true });
+    await mkdir(join(repo, "skills", "pdf"), { recursive: true });
+    await writeFile(join(repo, ".claude-plugin", "marketplace.json"), JSON.stringify({ name: "mixed", plugins: [{ name: "bundle", source: "./" }] }));
+    await writeFile(join(repo, "skills", "pdf", "SKILL.md"), "---\nname: pdf\ndescription: PDFs\n---\n");
+    const storageRoot = join(root, "storage");
+    const asPlugins = await addMarketplace({ source: { source: "directory", path: repo }, storageRoot });
+    assert.equal(asPlugins.id, "mixed", "the Plugin market keeps the repository's own catalog");
+    const asSkills = await addMarketplace({ source: { source: "directory", path: repo, catalog: "skills" }, storageRoot });
+    assert.equal(asSkills.id, "skills.mixed");
+    assert.deepEqual(loadMarketplaceManifestSync(storageRoot, asSkills.id)?.plugins.map((entry) => entry.name), ["pdf"]);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
