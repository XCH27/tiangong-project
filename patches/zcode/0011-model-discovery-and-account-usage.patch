+        resolveProviderBuiltinModelIds(builtin, current.providers, id);
+      const personal = [...(provider.personalModelIds ?? [])];
+      const existing = new Set([...inherited, ...personal]);
+      let rules = current.models;
+      for (const model of incoming) {
+        if (existing.has(model.modelId)) continue;
+        existing.add(model.modelId);
+        personal.push(model.modelId);
+        rules = rules.setExact(
+          id,
+          model.modelId,
+          model.config.overlay(new ModelConfig({ enabled: true })),
+        );
+      }
+      return {
+        providers: current.providers.set(
+          id,
+          provider
+            .withPersonalModelIds(personal)
+            .withModelOrder(normalizeModelOrder(inherited, personal, provider.modelOrder ?? [])),
+        ),
+        models: rules,
+        providerOrder: current.providerOrder,
+      };
+    });
