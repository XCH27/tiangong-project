diff --git a/packages/services/src/model-provider/subscriptionUsageCache.ts b/packages/services/src/model-provider/subscriptionUsageCache.ts
new file mode 100644
index 0000000..cfed80c
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionUsageCache.ts
@@ -0,0 +1,90 @@
+import { createHash } from "node:crypto";
+import { readSubscriptionUsage, type SubscriptionUsageResult } from "./subscriptionUsage.js";
+import type {
+  SavedConnection,
+  SubscriptionKind,
+  SubscriptionRequestAuth,
+} from "./subscriptionConnectionTypes.js";
+
+// Derived readings belong to the subscription owner instance, never a page or credential store.
+export function createSubscriptionUsageReader(options: {
+  now: () => number;
+  fetch: typeof fetch;
+  load(id: string, kind: SubscriptionKind): Promise<SavedConnection | undefined>;
+  getKind(id: string): Promise<SubscriptionKind>;
+}) {
+  const now = options.now;
+  const usageCache = new Map<
+    string,
+    {
+      identity: string;
+      value?: SubscriptionUsageResult;
+      pending?: Promise<SubscriptionUsageResult>;
+    }
+  >();
+  return {
+    invalidate(id: string) {
+      usageCache.delete(id);
+    },
+    async read(
+      id: string,
+      kind: SubscriptionKind,
+      auth: SubscriptionRequestAuth,
+      refresh: boolean,
+    ): Promise<SubscriptionUsageResult> {
+      const snapshot = await options.load(id, kind);
+      const account = snapshot?.accounts?.find((a) => a.id === snapshot.activeAccountId);
+      if (
+        !account ||
+        account.id !== auth.credentialSelection?.accountId ||
+        snapshot?.revision !== auth.credentialSelection.revision
+      )
+        return { status: "unavailable" };
+      const identity = JSON.stringify([
+        kind,
+        snapshot.revision,
+        account.id,
+        createHash("sha256").update(account.credential.access).digest("hex"),
+      ]);
+      let entry = usageCache.get(id);
+      if (entry?.identity !== identity) {
+        entry = { identity };
+        usageCache.set(id, entry);
+      }
+      if (!refresh && entry.value) return entry.value;
+      if (entry.pending) return entry.pending;
+      const request = (async (): Promise<SubscriptionUsageResult> => {
+        const result = await readSubscriptionUsage(kind, account.credential, options.fetch, now);
+        // 切换/删除/重新授权的迟到读数不能发布到另一个账号，包括跨窗口的变更。
+        try {
+          if ((await options.getKind(id)) !== kind) return { status: "unavailable" };
+          const current = await options.load(id, kind);
+          const selected = current?.accounts?.find((a) => a.id === current.activeAccountId);
+          if (
+            current?.revision !== snapshot.revision ||
+            selected?.id !== account.id ||
+            selected.credential.access !== account.credential.access
+          )
+            return { status: "unavailable" };
+        } catch {
+          return { status: "unavailable" };
+        }
+        // 同一账号保留最近成功读数；失败不把原额度清空，也不伪装成最新数据。
+        const value: SubscriptionUsageResult =
+          result.status !== "available" &&
+          result.status !== "auth-required" &&
+          entry.value?.status === "available"
+            ? { ...entry.value, refreshError: result.status, refreshAfter: now() + 60_000 }
+            : { ...result, refreshAfter: now() + 60_000 };
+        if (usageCache.get(id) === entry) entry.value = value;
+        return value;
+      })();
+      entry.pending = request;
+      try {
+        return await request;
+      } finally {
+        if (entry.pending === request) entry.pending = undefined;
+      }
+    },
+  };
+}
diff --git a/packages/services/test/model-discovery-persistence.test.ts b/packages/services/test/model-discovery-persistence.test.ts
new file mode 100644
index 0000000..af2d477
--- /dev/null
+++ b/packages/services/test/model-discovery-persistence.test.ts
@@ -0,0 +1,193 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../src/model-provider/providerRuntime.js";
+import type { SubscriptionConnectionOwner } from "../src/model-provider/subscriptionConnections.js";
+
+async function fixture(subscriptions?: SubscriptionConnectionOwner) {
+  const root = await mkdtemp(join(tmpdir(), "fleet-model-discovery-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let fetcher = async () => Response.json({ data: [{ id: "gpt-4.1" }, { id: "gpt-4.1-mini" }] });
+  const create = () =>
+    new ProviderRuntime({
+      configRuntime: createProviderConfigRuntime(options),
+      fetch: (() => fetcher()) as typeof fetch,
+      subscriptions,
+    });
+  let runtime = create();
+  await runtime.start();
+  const { providerId } = await runtime.providerSettings.createPersonalProvider({
+    ...(subscriptions ? { templateId: "fleet-openai-codex" } : {}),
+    initialConfig: subscriptions
+      ? { access: { type: "subscription", provider: "openai-codex", connected: true } }
+      : {
+          api: { type: "openai-responses", baseUrl: "https://catalog.example/v1" },
+          access: { type: "api-key", apiKey: "synthetic" },
+        },
+  });
+  return {
+    providerId,
+    get service() {
+      return runtime.providerSettings;
+    },
+    get runtime() {
+      return runtime;
+    },
+    setFetch(value: typeof fetcher) {
+      fetcher = value;
+    },
+    disk: () => readFile(options.personalFilePath, "utf8"),
+    async models() {
+      return (await runtime.providerSettings.getView()).providers.find(
+        (p) => p.providerId === providerId,
+      )!.models;
+    },
+    async restart() {
+      runtime.dispose();
+      runtime = create();
+      await runtime.start();
+    },
+    async dispose() {
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+test("discovery persists the whole catalog, survives restart, and preserves disabled, edited and manual models", async () => {
+  const f = await fixture();
+  try {
+    await f.service.addPersonalModel(f.providerId, "manual-private-model", {
+      properties: { contextWindow: 12345 },
+    });
+    await f.service.discoverModels(f.providerId);
+    assert.deepEqual(
+      (await f.models()).map((m) => m.modelId),
+      ["manual-private-model", "gpt-4.1", "gpt-4.1-mini"],
+    );
+    await f.service.setPersonalModelEnabled(f.providerId, "gpt-4.1", false);
+    await f.service.reorderPersonalModels(f.providerId, [
+      "gpt-4.1-mini",
+      "manual-private-model",
+      "gpt-4.1",
+    ]);
+    const before = await f.models();
+    let requests = 0;
+    const response = Promise.withResolvers<Response>();
+    const requested = Promise.withResolvers<void>();
+    f.setFetch(() => {
+      requests++;
+      requested.resolve();
+      return response.promise;
+    });
+    const readers = Promise.all([
+      f.service.discoverModels(f.providerId),
+      f.service.discoverModels(f.providerId),
+    ]);
+    await requested.promise;
+    response.resolve(Response.json({ data: [{ id: "gpt-4.1" }, { id: "gpt-4.1-mini" }] }));
+    await readers;
+    assert.equal(requests, 1, "concurrent readers share one catalog request");
+    assert.deepEqual(await f.models(), before);
+    await f.restart();
+    assert.deepEqual(await f.models(), before);
+    const selection = await f.runtime.modelSelection.getView();
+    const ids = selection.providers
+      .find((p) => p.providerId === f.providerId)!
+      .models.map((m) => m.modelId);
+    assert.ok(ids.includes("gpt-4.1-mini"));
+    assert.ok(!ids.includes("gpt-4.1"));
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("failed or partial catalogs never alter persisted models; manual add remains available", async () => {
+  const f = await fixture();
+  try {
+    await f.service.discoverModels(f.providerId);
+    const before = await f.disk();
+    let page = 0;
+    f.setFetch(async () =>
+      ++page === 1
+        ? Response.json({
+            data: [{ id: "must-not-import" }],
+            has_more: true,
+            last_id: "must-not-import",
+          })
+        : new Response("unavailable", { status: 503 }),
+    );
+    await assert.rejects(f.service.discoverModels(f.providerId), /503/);
+    assert.equal(await f.disk(), before);
+    await f.service.addPersonalModel(f.providerId, "not-in-catalog", {});
+    assert.ok((await f.models()).some((m) => m.modelId === "not-in-catalog"));
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("connection edits and deletion reject late discovery without reviving old models", async () => {
+  const f = await fixture();
+  try {
+    for (const remove of [false, true]) {
+      const requested = Promise.withResolvers<void>();
+      const response = Promise.withResolvers<Response>();
+      f.setFetch(() => {
+        requested.resolve();
+        return response.promise;
+      });
+      const discovery = f.service.discoverModels(f.providerId);
+      const rejected = assert.rejects(discovery, /changed|no longer exists|不存在/i);
+      await requested.promise;
+      if (remove) await f.service.deletePersonalProvider(f.providerId);
+      else
+        await f.service.savePersonalProviderOverlay(f.providerId, {
+          api: { type: "openai-responses", baseUrl: "https://new.example/v1" },
+          access: { type: "api-key", apiKey: "new-synthetic" },
+        });
+      const saved = await f.disk();
+      response.resolve(Response.json({ data: [{ id: "stale-model" }] }));
+      await rejected;
+      assert.equal(await f.disk(), saved);
+    }
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("subscription account changes during discovery cannot populate the new account from the old catalog", async () => {
+  let revision = "first";
+  const requested = Promise.withResolvers<void>();
+  const catalog = Promise.withResolvers<any>();
+  const subscriptions = {
+    accounts: async () => ({ accounts: [], autoSwitch: false, revision }),
+    models: () => {
+      requested.resolve();
+      return catalog.promise;
+    },
+  } as unknown as SubscriptionConnectionOwner;
+  const f = await fixture(subscriptions);
+  try {
+    const discovery = f.service.discoverModels(f.providerId);
+    const rejected = assert.rejects(discovery, /account changed/i);
+    await requested.promise;
+    revision = "second";
+    const before = await f.disk();
+    catalog.resolve({ source: "provider", models: [{ id: "stale", name: "Stale", config: {} }] });
+    await rejected;
+    assert.equal(await f.disk(), before);
+  } finally {
+    await f.dispose();
+  }
+});
