diff --git a/packages/services/src/model-provider/codexResetCredits.ts b/packages/services/src/model-provider/codexResetCredits.ts
new file mode 100644
index 0000000..a1cefb4
--- /dev/null
+++ b/packages/services/src/model-provider/codexResetCredits.ts
@@ -0,0 +1,171 @@
+import type { SubscriptionRequestAuth } from "./subscriptionConnectionTypes.js";
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+
+// Source: OpenAI codex-rs/backend-client/src/client/rate_limit_resets.rs and types.rs.
+export interface CodexResetCredit {
+  id: string;
+  resetType: string;
+  status: string;
+  expiresAt?: number;
+  title?: string;
+}
+export interface CodexResetCredits {
+  revision: string;
+  availableCount: number;
+  credits: CodexResetCredit[];
+}
+export interface CodexResetRequest {
+  revision: string;
+  creditId: string;
+  requestId: string;
+}
+export type CodexResetResult = "reset" | "nothing_to_reset" | "no_credit" | "already_redeemed";
+
+async function request(
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+  body?: { credit_id: string; redeem_request_id: string },
+): Promise<any> {
+  if (typeof credential.accountId !== "string" || !credential.accountId)
+    throw new Error("Subscription account identity unavailable");
+  const response = await fetcher(
+    `https://chatgpt.com/backend-api/wham/rate-limit-reset-credits${body ? "/consume" : ""}`,
+    {
+      method: body ? "POST" : "GET",
+      redirect: "error",
+      signal: AbortSignal.timeout(10_000),
+      headers: {
+        Authorization: `Bearer ${credential.access}`,
+        "ChatGPT-Account-Id": credential.accountId,
+        Accept: "application/json",
+        ...(body ? { "Content-Type": "application/json" } : {}),
+      },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    },
+  );
+  if (!response.ok) {
+    await response.body?.cancel();
+    throw new Error(`Reset request failed (${response.status})`);
+  }
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("Empty reset response");
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  try {
+    for (;;) {
+      const part = await reader.read();
+      if (part.done) break;
+      length += part.value.byteLength;
+      if (length > 256 * 1024) {
+        await reader.cancel();
+        throw new Error("Reset response too large");
+      }
+      chunks.push(part.value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const result = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+  if (result?.account_id && result.account_id !== credential.accountId)
+    throw new Error("Reset account mismatch");
+  return result;
+}
+
+export async function readCodexResetCredits(
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+): Promise<Omit<CodexResetCredits, "revision">> {
+  const body = await request(credential, fetcher);
+  if (
+    !Number.isSafeInteger(body?.available_count) ||
+    body.available_count < 0 ||
+    !Array.isArray(body.credits)
+  )
+    throw new Error("Invalid reset credit response");
+  const credits = body.credits.map((credit: any): CodexResetCredit => {
+    if (
+      typeof credit?.id !== "string" ||
+      !credit.id ||
+      credit.id.length > 256 ||
+      typeof credit.status !== "string" ||
+      typeof credit.reset_type !== "string"
+    )
+      throw new Error("Invalid reset credit");
+    const expiry = credit.expires_at == null ? undefined : Date.parse(credit.expires_at);
+    if (expiry !== undefined && !Number.isFinite(expiry)) throw new Error("Invalid reset expiry");
+    return {
+      id: credit.id,
+      status: credit.status,
+      resetType: credit.reset_type,
+      ...(expiry === undefined ? {} : { expiresAt: expiry }),
+      ...(typeof credit.title === "string" ? { title: credit.title.slice(0, 256) } : {}),
+    };
+  });
+  return { availableCount: body.available_count, credits };
+}
+
+export async function consumeCodexResetCredit(
+  credential: OAuthCredential,
+  input: CodexResetRequest,
+  fetcher: typeof fetch,
+): Promise<CodexResetResult> {
+  if (
+    !/^[a-zA-Z0-9-]{16,128}$/.test(input.requestId) ||
+    !input.creditId ||
+    input.creditId.length > 256
+  )
+    throw new Error("Invalid reset confirmation");
+  // 固定 credit_id 与 redeem_request_id；超时重试不能另选一张卡或重新生成请求身份。
+  const body = await request(credential, fetcher, {
+    credit_id: input.creditId,
+    redeem_request_id: input.requestId,
+  });
+  if (!["reset", "nothing_to_reset", "no_credit", "already_redeemed"].includes(body?.code))
+    throw new Error("Reset result unknown; refresh before continuing");
+  return body.code;
+}
+
+// Commands execute under the existing subscription account lock; there is no alternate account fallback.
+export function createSubscriptionResetActions(options: {
+  fetch: typeof fetch;
+  now: () => number;
+  invalidate(id: string): void;
+  withAccount<T>(
+    id: string,
+    auth: SubscriptionRequestAuth,
+    revision: string | undefined,
+    operation: (credential: OAuthCredential, revision: string) => Promise<T>,
+  ): Promise<T>;
+}) {
+  return {
+    read(id: string, auth: SubscriptionRequestAuth): Promise<CodexResetCredits> {
+      return options.withAccount(id, auth, undefined, async (credential, revision) => ({
+        ...(await readCodexResetCredits(credential, options.fetch)),
+        revision,
+      }));
+    },
+    consume(
+      id: string,
+      input: CodexResetRequest,
+      auth: SubscriptionRequestAuth,
+    ): Promise<CodexResetResult> {
+      if (!input.revision) throw new Error("Reset account revision required");
+      return options.withAccount(id, auth, input.revision, async (credential) => {
+        const details = await readCodexResetCredits(credential, options.fetch);
+        const credit = details.credits.find((c) => c.id === input.creditId);
+        if (
+          !credit ||
+          credit.resetType !== "codex_rate_limits" ||
+          !["available", "redeeming", "redeemed"].includes(credit.status) ||
+          (credit.expiresAt !== undefined && credit.expiresAt <= options.now())
+        )
+          throw new Error("Reset credit no longer available; refresh its details");
+        try {
+          return await consumeCodexResetCredit(credential, input, options.fetch);
+        } finally {
+          options.invalidate(id);
+        }
+      });
+    },
+  };
+}
