diff --git a/packages/ui/src/settings/model-provider-section/SubscriptionResetCredits.tsx b/packages/ui/src/settings/model-provider-section/SubscriptionResetCredits.tsx
new file mode 100644
index 0000000..213c209
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/SubscriptionResetCredits.tsx
@@ -0,0 +1,149 @@
+import { useEffect, useRef, useState } from "react";
+import { Button } from "@/components/ui/button.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+// Follow Codex's usage picker → selected credit → explicit confirmation, within the account card.
+export function SubscriptionResetCredits({
+  providerId,
+  revision,
+  count,
+  onConsumed,
+}: {
+  providerId: string;
+  revision: string;
+  count: number;
+  onConsumed: () => void;
+}) {
+  const { providerSettingsService: service } = useServices();
+  const { intl, locale } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.reset.${key}` });
+  const [details, setDetails] =
+    useState<Awaited<ReturnType<typeof service.getSubscriptionResetCredits>>>();
+  const [selected, setSelected] = useState<{ id: string; requestId: string }>();
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<string>();
+  const active = useRef(true);
+  const pending = useRef(false);
+  useEffect(() => {
+    active.current = true;
+    return () => {
+      active.current = false;
+    };
+  }, []);
+  const read = async () => {
+    if (pending.current) return;
+    pending.current = true;
+    setBusy(true);
+    setMessage(undefined);
+    try {
+      const value = await service.getSubscriptionResetCredits(providerId);
+      if (active.current && value.revision === revision) setDetails(value);
+    } catch {
+      if (active.current) setMessage(t("loadFailed"));
+    } finally {
+      pending.current = false;
+      if (active.current) setBusy(false);
+    }
+  };
+  const consume = async () => {
+    if (!selected || !details || pending.current) return;
+    pending.current = true;
+    setBusy(true);
+    setMessage(undefined);
+    try {
+      const code = await service.consumeSubscriptionResetCredit(providerId, {
+        revision: details.revision,
+        creditId: selected.id,
+        requestId: selected.requestId,
+      });
+      if (active.current) {
+        setMessage(t(code));
+        setSelected(undefined);
+        setDetails(undefined);
+        onConsumed();
+      }
+    } catch {
+      // 保留同一确认的请求身份，网络结果不明时重试不会消耗另一张卡。
+      if (active.current) setMessage(t("failed"));
+    } finally {
+      pending.current = false;
+      if (active.current) setBusy(false);
+    }
+  };
+  const available = details?.credits.filter(
+    (c) =>
+      c.status === "available" &&
+      c.resetType === "codex_rate_limits" &&
+      (c.expiresAt === undefined || c.expiresAt > Date.now()),
+  );
+  return (
+    <div className="space-y-2 border-t border-border pt-3">
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-ui-base">
+          {intl.formatMessage(
+            { id: "settings.modelProvider.reset.count" },
+            { count: details?.availableCount ?? count },
+          )}
+        </span>
+        {count > 0 || details ? (
+          <Button
+            variant="ghost"
+            size="sm"
+            disabled={busy}
+            onClick={() => (details ? setDetails(undefined) : void read())}
+          >
+            {details ? t("close") : t("view")}
+          </Button>
+        ) : null}
+      </div>
+      {available?.map((credit) => (
+        <div key={credit.id} className="flex items-center justify-between gap-3 text-ui-base">
+          <span>
+            {credit.title ?? t("full")}
+            {credit.expiresAt ? (
+              <span className="block text-ui-caption text-foreground-subtle">
+                {t("expires")}{" "}
+                {new Intl.DateTimeFormat(locale, {
+                  dateStyle: "medium",
+                  timeStyle: "short",
+                }).format(credit.expiresAt)}
+              </span>
+            ) : null}
+          </span>
+          <Button
+            variant="secondary"
+            size="sm"
+            disabled={busy || Boolean(selected)}
+            onClick={() => setSelected({ id: credit.id, requestId: crypto.randomUUID() })}
+          >
+            {t("use")}
+          </Button>
+        </div>
+      ))}
+      {selected ? (
+        <div className="space-y-2 rounded-lg border border-border p-3">
+          <p className="text-ui-base">{t("confirm")}</p>
+          <div className="flex justify-end gap-2">
+            <Button
+              variant="ghost"
+              size="sm"
+              disabled={busy}
+              onClick={() => setSelected(undefined)}
+            >
+              {intl.formatMessage({ id: "common.cancel" })}
+            </Button>
+            <Button size="sm" disabled={busy} onClick={() => void consume()}>
+              {t("confirmUse")}
+            </Button>
+          </div>
+        </div>
+      ) : null}
+      {message ? (
+        <p role="status" className="text-ui-caption text-foreground-subtle">
+          {message}
+        </p>
+      ) : null}
+    </div>
+  );
+}
