+test("removing the final key can be saved on an existing provider without deleting models or connection settings", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-remove-key-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  const runtime = createProviderConfigRuntime(options);
+  const reopened = createProviderConfigRuntime(options);
+  try {
+    await runtime.start();
+    const config = {
+      api: { type: "openai-chat-completions" as const, baseUrl: "https://keys.example/v1" },
+      access: { type: "api-key" as const, apiKey: "synthetic-last-key" },
+    };
+    const draft = {
+      baseUrl: config.api.baseUrl,
+      api: config.api.type,
+      primary: "",
+      additional: [],
+      automatic: false,
+    };
+    assert.equal(
+      providerSetupConfig({ config }, draft),
+      undefined,
+      "new connection still requires a key",
+    );
+    const cleared = providerSetupConfig({ config }, draft, [], { allowEmptyCredentials: true });
+    assert.ok(cleared);
+    const created = await runtime.configService.createPersonalProvider({
+      initialConfig: parseProviderConfig(config),
+    });
+    await runtime.configService.addPersonalModel(
+      created.providerId,
+      "retained-model",
+      parseModelConfig({}),
+    );
+    await runtime.configService.savePersonalProviderOverlay(
+      created.providerId,
+      parseProviderConfig({ ...config, ...cleared }),
+    );
+    await reopened.start();
+    const stored = JSON.parse(await readFile(options.personalFilePath, "utf8"));
+    const serialized = JSON.stringify(stored);
+    assert.ok(!serialized.includes("synthetic-last-key"));
+    assert.ok(serialized.includes("retained-model"));
+    assert.ok(serialized.includes("https://keys.example/v1"));
+  } finally {
+    runtime.dispose();
+    reopened.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
