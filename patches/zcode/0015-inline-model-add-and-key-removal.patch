+test("name-only manual addition persists without catalog access or fabricated capabilities and rejects duplicates", async () => {
+  const f = await fixture();
+  try {
+    f.setFetch(async () => {
+      throw new Error("manual addition must not fetch or infer");
+    });
+    const model = createManualProviderModel("  private-model-2026  ");
+    assert.equal(model.modelId, "private-model-2026");
+    assert.deepEqual(model.personalConfig, {});
+    assert.deepEqual(model.config, {});
+    assert.equal(model.useRecommendedConfig, true);
+    assert.throws(() => createManualProviderModel("  "), /model/i);
+    await f.service.addPersonalModel(
+      f.providerId,
+      model.modelId,
+      model.personalConfig,
+      model.useRecommendedConfig,
+    );
+    const before = await f.disk();
+    await assert.rejects(
+      f.service.addPersonalModel(f.providerId, model.modelId, {
+        properties: { contextWindow: 999999 },
+      }),
+      /已存在/,
+    );
+    assert.equal(await f.disk(), before, "duplicate cannot overwrite an existing model");
+    await f.restart();
+    assert.ok((await f.models()).some((m) => m.modelId === model.modelId));
+    assert.equal(await f.disk(), before);
+  } finally {
+    await f.dispose();
+  }
+});
