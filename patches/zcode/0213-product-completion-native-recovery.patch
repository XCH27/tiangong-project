diff --git a/packages/shared/src/whiteboard.ts b/packages/shared/src/whiteboard.ts
new file mode 100644
index 00000000..7a3e8fc1
--- /dev/null
+++ b/packages/shared/src/whiteboard.ts
@@ -0,0 +1,173 @@
+import { z } from "zod";
+import { zcodeWorkspaceRefSchema } from "./zcode-protocol-legacy-types.js";
+
+export const WHITEBOARD_DOCUMENT_MAX_BYTES = 8 * 1024 * 1024;
+const uuid = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
+export const whiteboardIdSchema = z.string().regex(new RegExp(`^whiteboard:${uuid}$`));
+const point = z
+  .object({ x: z.number().finite().min(0).max(1280), y: z.number().finite().min(0).max(800) })
+  .strict();
+export const whiteboardStrokeSchema = z
+  .object({
+    id: z.string().regex(new RegExp(`^stroke:${uuid}$`)),
+    tool: z.enum(["pen", "eraser"]),
+    color: z.string().regex(/^#[0-9a-fA-F]{6}$/),
+    width: z.number().finite().positive().max(256),
+    points: z.array(point).min(1).max(200_000),
+  })
+  .strict();
+
+export const whiteboardDocumentSchema = z
+  .object({
+    id: whiteboardIdSchema,
+    name: z.string().trim().min(1).max(128),
+    width: z.literal(1280),
+    height: z.literal(800),
+    strokes: z.array(whiteboardStrokeSchema).max(4096),
+    undoneStrokes: z.array(whiteboardStrokeSchema).max(4096),
+    createdAt: z.number().finite().nonnegative(),
+    updatedAt: z.number().finite().nonnegative(),
+  })
+  .strict()
+  .superRefine((board, context) => {
+    const all = [...board.strokes, ...board.undoneStrokes];
+    if (
+      all.length > 4096 ||
+      all.reduce((count, stroke) => count + stroke.points.length, 0) > 200_000
+    )
+      context.addIssue({
+        code: "custom",
+        message: "Whiteboard exceeds its stroke or point budget",
+      });
+    if (new Set(all.map((stroke) => stroke.id)).size !== all.length)
+      context.addIssue({ code: "custom", message: "Whiteboard stroke identities must be unique" });
+  });
+
+export const whiteboardFileRevisionSchema = z
+  .object({
+    id: z.string().min(1),
+    hash: z.string().regex(/^sha256:[a-f0-9]{64}$/),
+    mtimeMs: z.number().finite().nonnegative().optional(),
+    sizeBytes: z.number().int().nonnegative().optional(),
+  })
+  .strict();
+
+export const nativeWhiteboardSchema = z
+  .object({
+    schemaVersion: z.literal(1),
+    revision: z.number().int().positive(),
+    mutationId: z.string().uuid(),
+    mutationDigest: z.string().regex(/^[a-f0-9]{64}$/),
+    board: whiteboardDocumentSchema,
+  })
+  .strict();
+
+export const whiteboardUpdateInputSchema = z
+  .object({
+    document: whiteboardDocumentSchema,
+    mutationId: z.string().uuid(),
+    expectedAbsent: z.boolean().optional(),
+    expectedFileRevision: whiteboardFileRevisionSchema.optional(),
+  })
+  .strict()
+  .superRefine((input, context) => {
+    if (
+      input.expectedAbsent === true
+        ? input.expectedFileRevision !== undefined
+        : input.expectedFileRevision === undefined
+    )
+      context.addIssue({
+        code: "custom",
+        message: "Choose expected absence or a current file revision",
+      });
+  });
+
+export const whiteboardReadInputSchema = z.union([
+  z.object({ boardId: whiteboardIdSchema }).strict(),
+  z.object({ list: z.literal(true) }).strict(),
+]);
+export const whiteboardControlInputSchema = z.discriminatedUnion("operation", [
+  z.object({ operation: z.literal("read"), input: whiteboardReadInputSchema }).strict(),
+  z.object({ operation: z.literal("update"), input: whiteboardUpdateInputSchema }).strict(),
+]);
+export const whiteboardReadInputJsonSchema = z.toJSONSchema(whiteboardReadInputSchema);
+export const whiteboardUpdateInputJsonSchema = z.toJSONSchema(whiteboardUpdateInputSchema);
+export const whiteboardControlParamsSchema = z
+  .object({
+    sessionId: z.string().trim().min(1),
+    workspace: zcodeWorkspaceRefSchema,
+    operationId: z.string().uuid(),
+    command: whiteboardControlInputSchema,
+  })
+  .strict();
+/** A file projection cannot carry an operation identity, tool name or mutation input. */
+export const whiteboardProjectionParamsSchema = z
+  .object({
+    sessionId: z.string().trim().min(1),
+    workspace: zcodeWorkspaceRefSchema,
+    input: whiteboardReadInputSchema,
+  })
+  .strict();
+export const whiteboardControlResultSchema = z.discriminatedUnion("status", [
+  z
+    .object({
+      status: z.literal("completed"),
+      document: nativeWhiteboardSchema,
+      fileRevision: whiteboardFileRevisionSchema,
+      filePath: z.string(),
+      observed: z.boolean().optional(),
+    })
+    .strict(),
+  z
+    .object({
+      status: z.literal("rejected"),
+      reason: z.enum(["busy", "unavailable", "shutting_down"]),
+    })
+    .strict(),
+  z
+    .object({
+      status: z.literal("listed"),
+      items: z
+        .array(
+          z
+            .object({
+              boardId: whiteboardIdSchema,
+              name: z.string(),
+              revision: z.number().int().positive(),
+              updatedAt: z.number(),
+            })
+            .strict(),
+        )
+        .max(200),
+      errors: z.array(z.object({ fileName: z.string(), message: z.string() }).strict()).max(200),
+      truncated: z.boolean(),
+    })
+    .strict(),
+  z
+    .object({
+      status: z.literal("failed"),
+      message: z.string(),
+      code: z.string().optional(),
+      effectStatus: z.literal("not_confirmed"),
+    })
+    .strict(),
+]);
+export type WhiteboardControlResult = z.infer<typeof whiteboardControlResultSchema>;
+export type WhiteboardDocumentData = z.infer<typeof whiteboardDocumentSchema>;
+export type WhiteboardStrokeData = z.infer<typeof whiteboardStrokeSchema>;
+export type NativeWhiteboardDocument = z.infer<typeof nativeWhiteboardSchema>;
+export type WhiteboardFileRevision = z.infer<typeof whiteboardFileRevisionSchema>;
+export type WhiteboardUpdateInput = z.infer<typeof whiteboardUpdateInputSchema>;
+export type WhiteboardControlInput = z.infer<typeof whiteboardControlInputSchema>;
+export type WhiteboardReadInput = z.infer<typeof whiteboardReadInputSchema>;
+
+/** No names or caller-provided paths become a filesystem target. */
+export function whiteboardRelativePath(boardId: string): string {
+  return `.zcode/whiteboards/${whiteboardIdSchema.parse(boardId).slice("whiteboard:".length)}.json`;
+}
+
+export function parseNativeWhiteboardText(text: string): NativeWhiteboardDocument {
+  if (new TextEncoder().encode(text).byteLength > WHITEBOARD_DOCUMENT_MAX_BYTES)
+    throw new Error("Whiteboard exceeds its file size budget");
+  return nativeWhiteboardSchema.parse(JSON.parse(text));
+}
