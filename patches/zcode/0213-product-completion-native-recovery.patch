+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ProjectId, SessionId, SessionEntryInfo } from "@zcode/contracts";
+import { SqliteSessionStore } from "../src/storage/session-store/sqlite-session-store.js";
+
+test("two original SQLite connections admit one immutable entry and retain its first scope across reopen", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-session-entry-once-"));
+  const dbPath = join(dir, "sessions.sqlite"),
+    sessionID = "native-owner" as SessionId;
+  const first = new SqliteSessionStore({ dbPath }),
+    second = new SqliteSessionStore({ dbPath });
+  let closed = false;
+  try {
+    await first.createSession({
+      id: sessionID,
+      projectID: "project" as ProjectId,
+      slug: "native",
+      directory: dir,
+      title: "Authored native admission",
+      version: "fixture",
+    });
+    const entry: SessionEntryInfo = {
+      id: "global-native-admission",
+      sessionID,
+      type: "runtime/native_plugin_view_operation",
+      touchSession: false,
+      time: { created: 1, updated: 1 },
+      data: { operation: "first" },
+    };
+    const outcomes = await Promise.all([
+      first.saveSessionEntryOnce(entry),
+      second.saveSessionEntryOnce({ ...entry, data: { operation: "second" } }),
+    ]);
+    assert.equal(outcomes.filter((result) => result.created).length, 1);
+    const committed = (await second.sessionEntries({ sessionID }))[0]!;
+    assert.deepEqual(committed.data, { operation: "first" });
+    const otherID = "other-native-owner" as SessionId;
+    await first.createSession({
+      id: otherID,
+      projectID: "project" as ProjectId,
+      slug: "other",
+      directory: dir,
+      title: "Other owner",
+      version: "fixture",
+    });
+    assert.deepEqual(
+      await second.saveSessionEntryOnce({
+        ...entry,
+        sessionID: otherID,
+        data: { operation: "foreign overwrite" },
+      }),
+      { created: false },
+    );
+    assert.deepEqual(await first.sessionEntries({ sessionID: otherID }), []);
+    assert.deepEqual((await first.sessionEntries({ sessionID }))[0]!.data, committed.data);
+    first.close();
+    second.close();
+    closed = true;
+    const reopened = new SqliteSessionStore({ dbPath });
+    try {
+      assert.deepEqual(
+        await reopened.saveSessionEntryOnce({ ...entry, data: { operation: "retry" } }),
+        { created: false },
+      );
+      assert.deepEqual((await reopened.sessionEntries({ sessionID }))[0]!.data, committed.data);
+    } finally {
+      reopened.close();
+    }
+  } finally {
+    if (!closed) {
+      first.close();
+      second.close();
+    }
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/apps/zcode-cli/packages/adapters/test/sqlite-fork-transaction.test.ts b/apps/zcode-cli/packages/adapters/test/sqlite-fork-transaction.test.ts
