@@ -77,3 +77,25 @@ export function sessionEntries(
 
   return (rows as unknown as SessionEntryRow[]).map(decodeSessionEntryRow);
 }
+
+export function saveSessionEntryOnce(
+  db: DatabaseSync,
+  input: SessionEntryInfo,
+): { created: boolean } {
+  const encoded = encodeJson(
+    input.type === SESSION_ENTRY_MODEL_SELECTION
+      ? { modelSelection: input.data ?? null }
+      : input.data,
+  );
+  if (!encoded) throw new Error("Session entry data must be JSON-serializable");
+  const result = db
+    .prepare(`
+    insert into session_entry (id, session_id, type, time_created, time_updated, data)
+    values (?, ?, ?, ?, ?, ?) on conflict(id) do nothing
+  `)
+    .run(input.id, input.sessionID, input.type, input.time.created, input.time.updated, encoded);
+  const created = Number(result.changes) === 1;
+  if (created && input.touchSession !== false)
+    touchSession(db, input.sessionID, input.time.updated);
+  return { created };
+}
diff --git a/apps/zcode-cli/packages/adapters/src/storage/session-store/repositories/usage-app-query.ts b/apps/zcode-cli/packages/adapters/src/storage/session-store/repositories/usage-app-query.ts
