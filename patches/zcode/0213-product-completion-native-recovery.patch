+import { act } from "react";
+
+export function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+export const tick = async () => {
+  for (let i = 0; i < 16; i++) await Promise.resolve();
+};
+export const pause = () => new Promise((resolve) => setTimeout(resolve, 10));
+export async function until(predicate: () => boolean, message: string) {
+  const start = performance.now();
+  while (!predicate() && performance.now() - start < 2000)
+    await act(async () => {
+      await pause();
+      await tick();
+    });
+  check(predicate(), message);
+}
+export const html = (marker: string) => `<html><body>${marker}<script>
+addEventListener('message',event=>{
+ if(event.data.fixtureReload){location.reload();return;}
+ if(event.data.fixtureRequest)parent.postMessage(event.data.fixtureRequest,'*');
+ else if(event.data.jsonrpc)parent.postMessage({fixtureReply:event.data},'*');
+});parent.postMessage({jsonrpc:'2.0',id:'automatic',method:'ui/initialize'},'*');parent.postMessage({fixtureReady:true},'*');
+</script></body></html>`;
