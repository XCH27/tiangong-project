-function parseMessageEvent<T>(event: Event): T | null {
-  const data = (event as MessageEvent<string>).data;
-  if (typeof data !== "string") return null;
-  try {
-    return JSON.parse(data) as T;
-  } catch {
-    return null;
-  }
