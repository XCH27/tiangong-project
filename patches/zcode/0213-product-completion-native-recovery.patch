@@ -0,0 +1,44 @@
+import type { NativePluginViewTarget } from "./nativePluginViewControl.js";
+import type { NativeWhiteboardActionTarget } from "./nativeWhiteboardDraft.js";
+
+export const NATIVE_WHITEBOARD_SESSION_NAVIGATION = "zcode:native-whiteboard-session-navigation";
+export const NATIVE_WHITEBOARD_PRESERVE_TAB = "zcode:native-whiteboard-preserve-tab";
+export type NativeSurfaceNavigation = {
+  target: NativeWhiteboardActionTarget | NativePluginViewTarget;
+  sessionId: string;
+  handled?: boolean;
+};
+
+export type NativeWhiteboardNavigation = NativeSurfaceNavigation & {
+  target: NativeWhiteboardActionTarget;
+};
+
+/** Projection intent consumed by the original layout/navigation and side-pane owners. */
+export function showNativeWhiteboardSession(
+  target: NativeWhiteboardActionTarget,
+  sessionId: string,
+): void {
+  showNativeSurfaceSession(target, sessionId);
+}
+
+export function showNativePluginViewSession(
+  target: NativePluginViewTarget,
+  sessionId: string,
+): void {
+  showNativeSurfaceSession(target, sessionId);
+}
+
+function showNativeSurfaceSession(
+  target: NativeSurfaceNavigation["target"],
+  sessionId: string,
+): void {
+  const detail: NativeSurfaceNavigation = { target, sessionId };
+  window.dispatchEvent(new CustomEvent(NATIVE_WHITEBOARD_PRESERVE_TAB, { detail }));
+  window.dispatchEvent(new CustomEvent(NATIVE_WHITEBOARD_SESSION_NAVIGATION, { detail }));
+  if (!detail.handled)
+    throw new Error(
+      "boardId" in target
+        ? "whiteboard.navigationUnavailable"
+        : "Plugin view Session navigation is unavailable",
+    );
+}
