+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-restore-model-restore-persisted-model-selection.ts
@@ -0,0 +1,46 @@
+import { AgentRuntime, type ResumeSessionResult } from "@zcode/core";
+
+import type { ZCodeAppOptions } from "./types.js";
+
+import { readSessionModelSelection } from "./session-store.js";
+
+import type { SessionStorePort, SessionId } from "@zcode/contracts";
+import type { Logger } from "@zcode/core";
+
+export function createAppRestoreModelRestorePersistedModelSelection(factoryBindings: {
+  readonly options: ZCodeAppOptions;
+  readonly sessionStore: SessionStorePort;
+  readonly sessionId: SessionId;
+  readonly logger: Logger;
+  readonly getRuntime: () => AgentRuntime;
+}): () => Promise<ResumeSessionResult["modelSelection"]> {
+  const restorePersistedModelSelection = async (): Promise<
+    ResumeSessionResult["modelSelection"]
+  > => {
+    const registry = factoryBindings.options.providerRegistry;
+    let selection: ResumeSessionResult["modelSelection"];
+    try {
+      // 数据库启动已完成版本化迁移；恢复只读新字段，不按会话重复补迁。
+      selection = await readSessionModelSelection(
+        factoryBindings.sessionStore,
+        factoryBindings.sessionId,
+      );
+    } catch (error) {
+      // 选择 entry 的读取/解析故障不能拖垮独立的历史恢复；留下真实存储错误，
+      // 不读取旧消息或默认模型来掩盖失败。
+      factoryBindings.logger.warn("Session model selection restore failed", {
+        error: error instanceof Error ? error.message : String(error),
+        event: "session.model_selection.restore_failed",
+        sessionId: factoryBindings.sessionId,
+      });
+    }
+    const validation = selection && registry.validateSelection(selection);
+    // 只查模型是否存在会把缺档位/已删除的选择重新绑定进 Runtime，
+    // 抵消了未绑定初始化。历史恢复不要求可执行模型，只有完整选择可以绑定。
+    factoryBindings.getRuntime().setSessionModelSelection(validation?.ok ? selection : undefined);
+    // 恢复结果是保存意图，不是执行绑定。过去在这里置空/删档位，Host 的
+    // Selection View 就再也拿不到原意图，账号切换和配置恢复后也无法重新解析。
+    return selection;
+  };
+  return restorePersistedModelSelection;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-resume-store-resume-from-store.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-resume-store-resume-from-store.ts
