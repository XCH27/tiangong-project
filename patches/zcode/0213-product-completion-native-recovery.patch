+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import { compact } from "./goal-compact-turn.js";
+import { pauseGoal, resumeGoal } from "./goal-command-continuation.js";
+import { sendGoalCommand } from "./goal-command-write.js";
+
+export const goalCompactHandlers = { compact, pauseGoal, resumeGoal, sendGoalCommand };
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/commands/handlers/goal-compact-turn.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/commands/handlers/goal-compact-turn.ts
