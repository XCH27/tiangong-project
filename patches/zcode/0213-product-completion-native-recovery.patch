+import { createNodeSkillAdapter } from "@zcode/adapters/skills";
+import { NodeToolArtifactStore, SqliteSessionStore } from "@zcode/adapters/storage";
+import {
+  SAVED_WORKFLOW_FILE_EXTENSION,
+  SAVED_WORKFLOW_PROJECT_DIR,
+  type ModelTextResult,
+} from "@zcode/contracts";
+import { zcodeProtocolMethods, type ZCodeProtocolMessage } from "@zcode/shared";
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { appModelFixture } from "./app-model-completion-fixture.js";
+
+const tools = ["Skill", "SaveWorkflow", "CreateWorkflow", "Write", "Read", "WorkflowSubmit"];
+const reply = (toolCalls?: ModelTextResult["toolCalls"]): ModelTextResult => ({
+  text: toolCalls ? "" : "authored completion",
+  finishReason: toolCalls ? "tool-calls" : "stop",
+  usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
+  ...(toolCalls ? { toolCalls } : {}),
+});
+
+export async function productionHandoffFixture() {
+  const f = await appModelFixture();
+  const workspace = {
+    workspacePath: join(f.root, "workspace"),
+    workspaceIdentity: "authored-production",
+    workspaceKey: "authored-production",
+  };
+  const dbPath = join(f.root, "production.sqlite");
+  const artifactRoot = join(f.root, "artifacts");
+  const artifacts = new NodeToolArtifactStore({
+    rootDir: artifactRoot,
+    imageCacheRootDir: join(f.root, "image-cache"),
+    videoCacheRootDir: join(f.root, "video-cache"),
+  });
+  let store = new SqliteSessionStore({ dbPath });
+  let server: ZCodeProtocolAgentServer;
+  let id = 0;
+  let permissions = 0;
+  const apps = new Map<string, Awaited<ReturnType<typeof f.create>>>();
+  function createHost() {
+    server = new ZCodeProtocolAgentServer({
+      env: {},
+      cwd: workspace.workspacePath,
+      sessionStore: store,
+      createZCodeApp: async (options) => {
+        const app = await f.create({
+          ...options,
+          sessionStore: store,
+          artifactStore: artifacts,
+          skillPort: createNodeSkillAdapter({
+            homeDirectory: join(f.root, "empty-home"),
+            extraRoots: [fileURLToPath(new URL("../../../bundled-skills/skills", import.meta.url))],
+          }),
+          configuredDefaultModelSelection: {
+            providerId: f.providerId,
+            modelId: "standard",
+            options: { reasoningLevel: "high" },
+          },
+          runtimeConfig: {
+            ...options?.runtimeConfig,
+            workingDirectory: workspace.workspacePath,
+            mcp: { enabled: false, servers: {} },
+            memory: { enabled: false },
+            toolAllowlist: tools,
+            dynamicWorkflowEnabled: true,
+            modelStreaming: "off",
+          },
+        });
+        apps.set(String(app.sessionId), app);
+        return app;
+      },
+    });
+    server.setNotificationSink((message: ZCodeProtocolMessage) => {
+      if (!("method" in message) || !("id" in message)) return;
+      if (message.method === zcodeProtocolMethods.sessionRequestRuntimePreferences) {
+        void server.handleMessage({
+          id: message.id,
+          result: { nativeSearchEnhancementsEnabled: true, memoryEnabled: false },
+        });
+      }
+      if (message.method === zcodeProtocolMethods.interactionRequestPermission) {
+        permissions++;
+        void server.handleMessage({ id: message.id, result: { decision: "allow" } });
+      }
+    });
+  }
+  createHost();
+  async function raw(method: string, params: unknown) {
+    return server.handleMessage({ id: ++id, method, params } as ZCodeProtocolMessage);
+  }
+  async function request(method: string, params: unknown): Promise<unknown> {
+    const response = await raw(method, params);
+    assert.ok(response && "result" in response, JSON.stringify(response));
+    return response.result;
+  }
+  return {
+    f,
+    workspace,
+    artifactRoot,
+    artifacts,
+    apps,
+    raw,
+    request,
+    get store() {
+      return store;
+    },
+    get permissions() {
+      return permissions;
+    },
+    async createSession() {
+      const result = await request(zcodeProtocolMethods.sessionCreate, {
+        workspace,
+        persistence: "deferred",
+        dynamicWorkflowEnabled: true,
+        toolAllowlist: tools,
+      });
+      assert.ok(result && typeof result === "object" && "session" in result);
+      const session = result.session;
+      assert.ok(
+        session &&
+          typeof session === "object" &&
+          "sessionId" in session &&
+          typeof session.sessionId === "string",
+      );
+      const app = apps.get(session.sessionId);
+      assert.ok(app);
+      return app;
+    },
+    async saveWorkflow(
+      app: Awaited<ReturnType<typeof f.create>>,
+      name: string,
+      script: string,
+      output?: string,
+    ) {
+      f.steps([
+        reply([{ id: `${name}-skill`, name: "Skill", input: { skill: "dynamic-workflows" } }]),
+        reply([
+          {
+            id: `${name}-save`,
+            name: "SaveWorkflow",
+            input: {
+              name,
+              description: "Authored deterministic production handoff",
+              scope: "project",
+              script,
+            },
+          },
+        ]),
+        ...(output === undefined
+          ? []
+          : [
+              reply([
+                {
+                  id: `${name}-write`,
+                  name: "Write",
+                  input: { file_path: "output.csv", content: output },
+                },
+              ]),
+            ]),
+        reply(),
+      ]);
+      const turn = await app.submitPrompt("Save authored production workflow and output");
+      console.log(
+        JSON.stringify({
+          fixture: "registered-save-turn",
+          permissions,
+          events: turn.events.map((event) => event.type),
+          models: f.calls.map((call) => call.modelId),
+        }),
+      );
+      const messages = await store.messages({ sessionID: app.sessionId });
+      console.log(
+        JSON.stringify({
+          fixture: "tool-parts",
+          tools: messages
+            .flatMap((message) => message.parts)
+            .filter((part) => part.type === "tool")
+            .map((part) => ({
+              tool: part.tool,
+              status: part.state.status,
+              callID: part.callID,
+              output:
+                part.state.status === "completed"
+                  ? part.state.output.slice(0, 600)
+                  : part.state.status === "error"
+                    ? part.state.error
+                    : undefined,
+            })),
+        }),
+      );
+      const saved = await readFile(
+        join(
+          workspace.workspacePath,
+          SAVED_WORKFLOW_PROJECT_DIR,
+          `${name}${SAVED_WORKFLOW_FILE_EXTENSION}`,
+        ),
+        "utf8",
+      );
+      assert.match(saved, /zcode-workflow/);
+      if (output !== undefined)
+        assert.equal(await readFile(join(workspace.workspacePath, "output.csv"), "utf8"), output);
+    },
+    async restart() {
+      await server.shutdown();
+      server.disposeProjections();
+      apps.clear();
+      store.close();
+      store = new SqliteSessionStore({ dbPath });
+      createHost();
+    },
+    async close() {
+      await server.shutdown();
+      server.disposeProjections();
+      await f.close();
+      store.close();
+    },
+  };
+}
+
+export async function waitForRun(
+  app: Awaited<ReturnType<Awaited<ReturnType<typeof productionHandoffFixture>>["createSession"]>>,
+  runId: string,
+) {
+  const deadline = Date.now() + 20_000;
+  for (;;) {
+    const run = (await app.listDynamicWorkflowRuns?.({ limit: 64 }))?.find(
+      (item) => item.runId === runId,
+    );
+    if (run && ["completed", "errored", "stopped"].includes(run.status)) return run;
+    assert.ok(
+      Date.now() < deadline,
+      `actual workflow ${runId} did not settle: ${JSON.stringify(run)}`,
+    );
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+}
