@@ -0,0 +1,121 @@
+import { appendFileSync, readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { createInterface } from "node:readline";
+
+// Only authored plugin-data is touched; this server has no network, provider, credential or UI code.
+const data = process.env.ZCODE_PLUGIN_DATA;
+if (!data) throw new Error("Owned plugin-data path is required");
+mkdirSync(data, { recursive: true });
+const file = join(data, "counter.json");
+const writeTool = process.env.ZCODE_PLUGIN_WRITE_TOOL ?? "increment";
+const count = () => {
+  try {
+    return JSON.parse(readFileSync(file, "utf8")).value;
+  } catch {
+    return 0;
+  }
+};
+const send = (id, result) =>
+  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", id, result })}\n`);
+const schema = {
+  type: "object",
+  properties: { delayMs: { type: "number" } },
+  additionalProperties: false,
+};
+createInterface({ input: process.stdin }).on("line", (line) => {
+  const request = JSON.parse(line);
+  if (request.id === undefined) return;
+  if (request.method === "initialize")
+    return send(request.id, {
+      protocolVersion: request.params.protocolVersion,
+      capabilities: { tools: {}, resources: {} },
+      serverInfo: { name: "owned-native-control", version: "1" },
+    });
+  if (request.method === "tools/list")
+    return send(request.id, {
+      tools: [
+        {
+          name: writeTool,
+          description: "Write one owned counter",
+          inputSchema: schema,
+          annotations: { readOnlyHint: false, destructiveHint: true },
+        },
+        {
+          name: "read_counter",
+          description: "Read the owned counter",
+          inputSchema: schema,
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: "report_error",
+          description: "Report an authored MCP error",
+          inputSchema: schema,
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: "read_cwd",
+          description: "Read authored process cwd",
+          inputSchema: schema,
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: "effect_then_error",
+          description: "Owned uncertain effect followed by a peer error",
+          inputSchema: schema,
+          annotations: { destructiveHint: true, readOnlyHint: false },
+        },
+      ],
+    });
+  if (request.method === "resources/read")
+    return send(request.id, {
+      contents: [
+        {
+          uri: "ui://owned/main",
+          mimeType: "text/html;profile=mcp-app",
+          text: "<!doctype html><html><body>Owned view</body></html>",
+        },
+      ],
+    });
+  if (request.method === "ping") return send(request.id, {});
+  if (request.method === "tools/call") {
+    const { name, arguments: args = {} } = request.params;
+    if (
+      ![writeTool, "read_counter", "report_error", "read_cwd", "effect_then_error"].includes(name)
+    ) {
+      process.stdout.write(
+        `${JSON.stringify({ jsonrpc: "2.0", id: request.id, error: { code: -32601, message: "Unlisted owned tool" } })}\n`,
+      );
+      return;
+    }
+    if (name === writeTool || name === "effect_then_error") {
+      appendFileSync(
+        join(data, "effects.ndjson"),
+        `${JSON.stringify({ pid: process.pid, tool: name })}\n`,
+      );
+      writeFileSync(file, JSON.stringify({ value: count() + 1 }));
+    }
+    if (name === "effect_then_error") {
+      process.stdout.write(
+        `${JSON.stringify({
+          jsonrpc: "2.0",
+          id: request.id,
+          error: { code: -32603, message: "Not connected" },
+        })}\n`,
+      );
+      return;
+    }
+    const result = {
+      content: [
+        { type: "text", text: name === "report_error" ? "Authored error" : String(count()) },
+      ],
+      structuredContent: name === "read_cwd" ? { cwd: process.cwd() } : { value: count() },
+      ...(name === "report_error" ? { isError: true } : {}),
+    };
+    if (args.delayMs) setTimeout(() => send(request.id, result), args.delayMs);
+    else send(request.id, result);
+    return;
+  }
+  process.stdout.write(
+    `${JSON.stringify({ jsonrpc: "2.0", id: request.id, error: { code: -32601, message: "Unknown owned request" } })}\n`,
+  );
+});
