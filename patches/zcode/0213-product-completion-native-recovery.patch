+} from "@zcode/contracts";
+import type { ZCodeSessionEndedSubagent, ZCodeSessionRunningSubagent } from "@zcode/shared";
+
+export const SUBAGENT_TOOL_NAMES = new Set(["Agent", "Task", "subagent"]);
+
+export const CANCELLATION_PATTERN = /abort|cancel|interrupt|stop/i;
+
+export interface SubagentCandidate {
+  agentId?: string;
+  childSessionId: string;
+  runInBackground: boolean;
+  output: Record<string, unknown> | null;
+  part: ToolPart;
+  subagentType: string;
+  summary?: string;
+  startedAt?: number;
+  stoppedAt?: number;
+  stoppedStatus?: "success" | "failed" | "cancelled";
+  title: string;
+}
