-function workflowSessionLinkStatusFromActivity(
-  status: WorkflowNodeStatus,
-): WorkflowSessionLinkStatus {
-  switch (status) {
-    case "active":
-      return "running";
-    case "completed":
-      return "completed";
-    case "failed":
-      return "failed";
-    case "cancelled":
-    case "skipped":
-      return "cancelled";
-    case "pending":
-    default:
-      return "starting";
-  }
-}
