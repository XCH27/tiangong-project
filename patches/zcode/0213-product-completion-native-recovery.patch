+export function installConversationTopicPublisherMethods(
+  prototype: ConversationTopicPublisherOwner,
+  ConversationTopicPublisher: Parameters<typeof createRehydrateMethod>[0],
+): void {
+  const accessors = Object.fromEntries(
+    ["currentSeq"].map((name) => [name, Object.getOwnPropertyDescriptor(prototype, name)!]),
+  );
+  for (const name of ["currentSeq"]) Reflect.deleteProperty(prototype, name);
+  const methods = {
+    getSnapshot,
+    getWireSnapshotLogicalBytes,
+    resolveStableForkCandidate,
+    seedConfig,
+    seedSharedContextImport,
+    seedUsage,
+    seedSubagents,
+    getWireSnapshot,
+    getWireSnapshotForProfile,
+    getWireSnapshotForSubscription,
+    encodeDeltasForSubscription,
