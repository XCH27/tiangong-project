+  );
+  assert.equal(creates, 0);
+  assert.equal(store.getState().getBoard(f.target), f.board);
+});
+
+test("expired original pending callback cannot cancel a newer Save and listeners leave on start failure", async () => {
+  const f = fresh(),
+    projection = nativePresentationAgent(),
+    held = Promise.withResolvers<void>();
+  projection.hold(held.promise);
+  const agent = {
+    ...projection.agent,
+    performWhiteboardControl: async ({ command }: { command: WhiteboardControlInput }) =>
+      receipt(command),
+  } as unknown as IZCodeAgentService;
+  const old = saveNativeWhiteboardDraft({
+    target: f.target,
+    agent,
+    sessionId: "pending-owner",
+    showSession() {},
+  });
+  await tick();
+  const pending =
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending!;
+  pending.cancel!();
+  assert.equal(await old, false);
+  const newer = saveNativeWhiteboardDraft({
+    target: f.target,
+    agent,
+    sessionId: "pending-owner",
+    showSession() {},
+  });
+  await tick();
+  const current =
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending!;
+  assert.notEqual(current.requestId, pending.requestId);
+  pending.cancel!();
+  assert.equal(
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending,
+    current,
+  );
+  held.resolve();
+  assert.equal(await newer, true);
+  const signal = new AbortController().signal;
+  let adds = 0,
+    removes = 0;
+  const add = signal.addEventListener.bind(signal),
+    remove = signal.removeEventListener.bind(signal);
+  signal.addEventListener = (...args) => {
+    adds++;
+    return add(...args);
+  };
+  signal.removeEventListener = (...args) => {
+    removes++;
+    return remove(...args);
+  };
+  assert.equal(
+    await saveNativeWhiteboardDraft({
+      target: f.target,
+      agent,
+      sessionId: "pending-owner",
+      abortSignal: signal,
+      onStarted() {
+        throw new Error("Owned start failure");
+      },
+      showSession() {},
+    }),
+    false,
+  );
+  assert.equal(adds, 1);
+  assert.equal(removes, 1);
+  assert.equal(
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending,
+    undefined,
+  );
+});
diff --git a/packages/ui/test/nativeWhiteboardPreparationStop.test.ts b/packages/ui/test/nativeWhiteboardPreparationStop.test.ts
new file mode 100644
index 00000000..bd5ade62
--- /dev/null
+++ b/packages/ui/test/nativeWhiteboardPreparationStop.test.ts
@@ -0,0 +1,137 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { zcodeProtocolMethods as M, whiteboardRelativePath } from "@zcode/shared";
+import { V4_METHODS as V } from "@zcode/shared/zcode-protocol-v4";
+import { nativePresentationHost, waitFor } from "./helpers/nativePresentationHost.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+import { logger } from "../src/logger.js";
+
+for (const window of ["creation", "initial"] as const) {
+  test(`Stop during real ${window} preparation settles the draft and late owned receipt cannot dispatch`, async (t) => {
+    const h = await nativePresentationHost("whiteboard"),
+      controller = new AbortController();
+    store.setState({ ...store.getInitialState() }, true);
+    const board = store.getState().createBoard({ ...h.workspace, defaultNamePrefix: "Owned Stop" });
+    const target = { ...h.workspace, boardId: board.id };
+    const releases: Array<{ event?: string; refCount?: number }> = [];
+    const originalLog = logger.lifecycle.info;
+    logger.lifecycle.info = (...args: unknown[]) => {
+      if (args[1] && typeof args[1] === "object") releases.push(args[1]);
+      originalLog(...args);
+    };
+    let sessionId: string | undefined,
+      dispatched = false;
+    if (window === "creation") h.holdCreation();
+    else h.holdFrames();
+    const saving = saveNativeWhiteboardDraft({
+      target,
+      agent: h.agent,
+      abortSignal: controller.signal,
+      onDispatch: () => {
+        dispatched = true;
+      },
+      onSessionResolved: (id) => {
+        sessionId = id;
+      },
+      showSession() {},
+    });
+    try {
+      await waitFor(
+        () =>
+          window === "creation"
+            ? h.heldCreations === 1
+            : !!sessionId && h.methods.includes(V.conversationSubscribe),
+        "held original preparation",
+      );
+      const pending =
+        store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+      assert.ok(pending);
+      assert.equal(dispatched, false);
+      // Original hook aborts its matching private handle in this phase; no actor was dispatched.
+      controller.abort();
+      assert.equal(await saving, false);
+      const failed = store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!;
+      assert.equal(failed.pending, undefined);
+      assert.equal(failed.committed, undefined);
+      assert.equal(store.getState().getBoard(target), board);
+      assert.match(failed.error!, /saveStopped/);
+      assert.ok(
+        releases.some(
+          (item) => item.event === "v4.workspace_connection.release" && item.refCount === 1,
+        ),
+      );
+      if (window === "initial")
+        assert.ok(
+          releases.some((item) => item.event === "v4.session_data.release" && item.refCount === 0),
+        );
+      h.releaseCreation();
+      h.releaseFrames();
+      await new Promise((resolve) => setTimeout(resolve, 30));
+      assert.equal(dispatched, false);
+      assert.equal(h.methods.includes(M.sessionWhiteboardControl), false);
+      assert.equal(h.permission, undefined);
+      assert.equal(h.f.calls.length, 0);
+      assert.equal(h.f.httpCalls, 0);
+      await assert.rejects(readFile(join(target.workspacePath, whiteboardRelativePath(board.id))), {
+        code: "ENOENT",
+      });
+    } finally {
+      controller.abort();
+      h.releaseCreation();
+      h.releaseFrames();
+      await saving;
+      logger.lifecycle.info = originalLog;
+      await h.close(t);
+    }
+  });
+}
+
+test("after dispatch only the original backend Stop settles an uncertain actor receipt", async (t) => {
+  const h = await nativePresentationHost("whiteboard"),
+    controller = new AbortController();
+  store.setState({ ...store.getInitialState() }, true);
+  const board = store
+    .getState()
+    .createBoard({ ...h.workspace, defaultNamePrefix: "Owned dispatched Stop" });
+  const target = { ...h.workspace, boardId: board.id };
+  let sessionId: string | undefined,
+    dispatched = false;
+  const saving = saveNativeWhiteboardDraft({
+    target,
+    agent: h.agent,
+    abortSignal: controller.signal,
+    onDispatch: () => {
+      dispatched = true;
+    },
+    onSessionResolved: (id) => {
+      sessionId = id;
+    },
+    showSession() {},
+  });
+  try {
+    await waitFor(() => !!h.permission, "original actor approval");
+    assert.ok(sessionId && dispatched);
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+    assert.ok(pending);
+    // Even a local abort after dispatch cannot pretend an uncertain RPC settled.
+    controller.abort();
+    assert.equal(
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending,
+      pending,
+    );
+    assert.equal(await saving, false);
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+    await assert.rejects(readFile(join(target.workspacePath, whiteboardRelativePath(board.id))), {
+      code: "ENOENT",
+    });
+  } finally {
+    if (h.permission) h.answer("deny");
+    await saving;
+    await h.close(t);
+  }
+});
diff --git a/packages/ui/test/nativeWhiteboardProjection.test.ts b/packages/ui/test/nativeWhiteboardProjection.test.ts
