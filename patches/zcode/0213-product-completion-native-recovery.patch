diff --git a/packages/ui/test/toolbarConfigSnapshot.browser.test.tsx b/packages/ui/test/toolbarConfigSnapshot.browser.test.tsx
new file mode 100644
index 00000000..bc4cdc0a
--- /dev/null
+++ b/packages/ui/test/toolbarConfigSnapshot.browser.test.tsx
@@ -0,0 +1,98 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { createSessionTraceId, type ZCodeConfigOption } from "@zcode/shared";
+import { useToolbarConfigOptions } from "../src/hooks/useZCodeConfig.js";
+import { resolveTaskRestorePreloadConfigOptions } from "../src/lib/taskModelRecovery.js";
+import { useZCodeSessionStore as store } from "../src/store/zcodeSessionStore.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+async function run() {
+  for (const cached of [true, false]) {
+    store.setState({ ...store.getInitialState() }, true);
+    const workspace = `/authored/toolbar-snapshot-${crypto.randomUUID()}`,
+      task = "authored-session";
+    const meta = {
+      taskId: task,
+      traceId: createSessionTraceId(),
+      workspacePath: workspace,
+      title: "Authored",
+      createdAt: 1,
+      updatedAt: 1,
+      mode: "build",
+      provider: "glm",
+      model: "authored/model",
+    } as const;
+    store.getState().setActiveTaskId(workspace, task);
+    // Metadata arrives after selection, before the Session config cache is hydrated.
+    store.getState().setTaskListCache(workspace, [meta]);
+    const cachedOptions: ZCodeConfigOption[] = [
+      {
+        id: "mode",
+        name: "Mode",
+        category: "mode",
+        type: "select",
+        currentValue: "build",
+        options: [{ value: "build", name: "Build" }],
+      },
+    ];
+    if (cached) store.getState().setTaskConfigOptions(workspace, task, cachedOptions);
+    const expected = cached
+      ? cachedOptions
+      : resolveTaskRestorePreloadConfigOptions({
+          taskMeta: { provider: meta.provider, model: meta.model },
+        });
+    const errors: string[] = [];
+    let renders = 0,
+      writes = 0;
+    const snapshots: ReturnType<typeof useToolbarConfigOptions>[] = [];
+    const unsubscribe = store.subscribe(() => {
+      writes++;
+    });
+    const node = document.createElement("div");
+    document.body.append(node);
+    const root = createRoot(node, {
+      onUncaughtError: (error) => errors.push(String(error)),
+      onCaughtError: (error) => errors.push(String(error)),
+    });
+    function ActualHook() {
+      renders++;
+      const value = useToolbarConfigOptions(workspace, task);
+      snapshots.push(value);
+      return <span>{value.configOptions.length}</span>;
+    }
+    try {
+      for (let pass = 0; pass < 2; pass++) {
+        await act(async () => {
+          root.render(
+            <TabStoreProvider>
+              <ActualHook />
+            </TabStoreProvider>,
+          );
+          for (let i = 0; i < 10; i++) await Promise.resolve();
+        });
+      }
+      if (renders !== 2 || snapshots[0]?.configOptions !== snapshots[1]?.configOptions)
+        throw new Error("Unchanged original inputs did not produce stable option references");
+      if (JSON.stringify(snapshots[0]?.configOptions) !== JSON.stringify(expected))
+        throw new Error("Snapshot stabilization changed restored/cached model options");
+      if (snapshots[0]?.status !== (cached ? "ready" : "loading") || writes !== 0)
+        throw new Error("Reading changed status or wrote the original preference/config authority");
+      results.push({
+        name: `actual toolbar ${cached ? "cached" : "uncached"} Session snapshot`,
+        ...(errors.length ? { error: errors.join("\n") } : {}),
+      });
+    } catch (error) {
+      results.push({ name: "actual toolbar snapshot", error: String(error) });
+    } finally {
+      unsubscribe();
+      await act(async () => root.unmount());
+      node.remove();
+    }
+  }
+  return results;
+}
+(
+  window as unknown as { __toolbarConfigSnapshotTests: Promise<typeof results> }
+).__toolbarConfigSnapshotTests = run();
diff --git a/packages/ui/test/whiteboardNativeDraft.test.ts b/packages/ui/test/whiteboardNativeDraft.test.ts
new file mode 100644
index 00000000..414acfd7
--- /dev/null
+++ b/packages/ui/test/whiteboardNativeDraft.test.ts
@@ -0,0 +1,63 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { useWhiteboardStore } from "../src/store/whiteboardStore.js";
+import { isWhiteboardDirty } from "../src/store/whiteboardNativeProjection.js";
+
+const target = { workspacePath: "/authored/workspace" };
+function fresh() {
+  useWhiteboardStore.setState({ workspaces: {} });
+  const board = useWhiteboardStore.getState().createBoard({ ...target, defaultNamePrefix: "Drawing" });
+  return { board, scoped: { ...target, boardId: board.id }, store: useWhiteboardStore.getState };
+}
+const receipt = (board: any, mutationId: string) => ({ schemaVersion: 1 as const, revision: 1, mutationId,
+  mutationDigest: "a".repeat(64), board });
+const revision = { id: "mtime:100:size:100", hash: "sha256:" + "b".repeat(64) };
+
+test("a save ACK cannot consume drawing made while approval or publication was in flight", () => {
+  const f = fresh(), pending = f.store().beginNativeSave(f.scoped)!;
+  f.store().renameBoard({ ...f.scoped, name: "Later draft" });
+  const later = f.store().getBoard(f.scoped)!;
+  f.store().acknowledgeNativeSave({ ...f.scoped, requestId: pending.requestId,
+    document: receipt(f.board, pending.mutationId), fileRevision: revision });
+  assert.equal(f.store().getBoard(f.scoped), later);
+  assert.equal(isWhiteboardDirty(later, f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]), true);
+});
+
+test("failed or uncertain save retains the draft and mutation identity, without claiming persisted state", () => {
+  const f = fresh(), first = f.store().beginNativeSave(f.scoped)!;
+  f.store().failNativeSave({ ...f.scoped, requestId: first.requestId, error: "Authored lost acknowledgement" });
+  assert.equal(f.store().getBoard(f.scoped), f.board);
+  const retry = f.store().beginNativeSave(f.scoped)!;
+  assert.equal(retry.mutationId, first.mutationId);
+  assert.notEqual(retry.requestId, first.requestId);
+  // An old response cannot finish a new attempt, including after switching away and back.
+  f.store().acknowledgeNativeSave({ ...f.scoped, requestId: first.requestId,
+    document: receipt(f.board, first.mutationId), fileRevision: revision });
+  assert.equal(f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]!.pending?.requestId, retry.requestId);
+});
+
+test("canonical read merges clean boards and retains dirty conflict data for explicit reconciliation", () => {
+  const f = fresh(), pending = f.store().beginNativeSave(f.scoped)!;
+  f.store().acknowledgeNativeSave({ ...f.scoped, requestId: pending.requestId,
+    document: receipt(f.board, pending.mutationId), fileRevision: revision });
+  f.store().renameBoard({ ...f.scoped, name: "User draft" });
+  const incoming = { ...receipt({ ...f.board, name: "Agent edit" }, pending.mutationId), revision: 2 };
+  f.store().receiveNativeBoard({ ...f.scoped, document: incoming,
+    fileRevision: { ...revision, hash: "sha256:" + "c".repeat(64) } });
+  assert.equal(f.store().getBoard(f.scoped)?.name, "User draft");
+  assert.equal(f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]!.incoming?.document.board.name, "Agent edit");
+  assert.equal(f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]!.committed?.fileRevision.hash, revision.hash);
+  // Creating another draft must not erase the first board's canonical projection.
+  f.store().createBoard({ ...target, defaultNamePrefix: "Other" });
+  assert.equal(f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]!.committed?.fileRevision.hash, revision.hash);
+});
+
+test("cold file hydration and explicit discard use the existing store without a draft database", () => {
+  const f = fresh();
+  useWhiteboardStore.setState({ workspaces: {} });
+  f.store().receiveNativeBoard({ ...f.scoped, document: receipt(f.board, "00000000-0000-4000-8000-000000000001"), fileRevision: revision });
+  assert.equal(isWhiteboardDirty(f.store().getBoard(f.scoped)!, f.store().workspaces[target.workspacePath]!.nativeById![f.board.id]), false);
+  f.store().renameBoard({ ...f.scoped, name: "Discard me" });
+  f.store().discardDraft(f.scoped);
+  assert.equal(f.store().getBoard(f.scoped)?.name, f.board.name);
+});
diff --git a/packages/ui/test/whiteboardNativePane.browser.test.tsx b/packages/ui/test/whiteboardNativePane.browser.test.tsx
new file mode 100644
index 00000000..5d193f47
--- /dev/null
+++ b/packages/ui/test/whiteboardNativePane.browser.test.tsx
@@ -0,0 +1,470 @@
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import enUS from "../src/i18n/locales/en-US.js";
+import zhCN from "../src/i18n/locales/zh-CN.js";
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { WhiteboardPane } from "../src/WhiteboardPane.js";
+import { ConfirmDialogHost } from "../src/ConfirmDialog.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+import { useConfirmDialogStore as dialogs } from "../src/store/confirmDialogStore.js";
+import { installNativeWhiteboardCloseBridge } from "../src/lib/nativeWhiteboardCloseBridge.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import type {
+  WhiteboardControlInput,
+  WhiteboardControlResult,
+  WhiteboardReadInput,
+} from "@zcode/shared";
+import type { IZCodeAgentService } from "@zcode/services";
+
+declare global {
+  var IS_REACT_ACT_ENVIRONMENT: boolean;
+}
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 12; i++) await Promise.resolve();
+};
+const revision = (n: number) => ({ id: `authored-${n}`, hash: `sha256:${String(n).repeat(64)}` });
+
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    const container = document.createElement("div");
+    container.style.cssText = "width:900px;height:640px";
+    document.body.append(container);
+    const root = createRoot(container);
+    store.setState({ ...store.getInitialState() }, true);
+    const scope = { workspacePath: `/authored-native-pane-${crypto.randomUUID()}` };
+    const initial = store
+      .getState()
+      .createBoard({ ...scope, defaultNamePrefix: "Authored drawing" });
+    const target = { ...scope, boardId: initial.id };
+    let saved: Extract<WhiteboardControlResult, { status: "completed" }> | undefined;
+    let releaseSave: (() => void) | undefined;
+    let holdRead = false;
+    let releaseRead: (() => void) | undefined;
+    let holdSave = true;
+    let refusal = false;
+    const updates: Array<Extract<WhiteboardControlInput, { operation: "update" }>> = [];
+    const sessions: string[] = [];
+    const commands: string[] = [];
+    const opened: string[] = [];
+    const makeAgent = () =>
+      ({
+        ...nativePresentationAgent().agent,
+        async sendConversationCommandV4({
+          envelope,
+        }: Parameters<IZCodeAgentService["sendConversationCommandV4"]>[0]) {
+          commands.push(envelope.type);
+          throw new Error("Authored existing Session must not send a creation/model command");
+        },
+        async readWhiteboardProjection({
+          input,
+        }: {
+          input: WhiteboardReadInput;
+        }): Promise<WhiteboardControlResult> {
+          if ("list" in input)
+            return {
+              status: "listed",
+              items: saved
+                ? [
+                    {
+                      boardId: target.boardId,
+                      name: saved.document.board.name,
+                      revision: saved.document.revision,
+                      updatedAt: 1,
+                    },
+                  ]
+                : [],
+              errors: [],
+              truncated: false,
+            };
+          check(saved, "Read without authored native file");
+          const snapshot = structuredClone(saved);
+          if (holdRead)
+            await new Promise<void>((resolve) => {
+              releaseRead = resolve;
+            });
+          return snapshot;
+        },
+        async performWhiteboardControl({
+          command,
+        }: {
+          command: WhiteboardControlInput;
+        }): Promise<WhiteboardControlResult> {
+          check(command.operation === "update", "Viewing must not dispatch an actor Read tool");
+          updates.push(structuredClone(command));
+          if (holdSave)
+            await new Promise<void>((resolve) => {
+              releaseSave = resolve;
+            });
+          if (refusal)
+            return {
+              status: "failed",
+              code: "PERMISSION_DENIED",
+              message: "Authored approval denied",
+              effectStatus: "not_confirmed",
+            };
+          saved = {
+            status: "completed",
+            filePath: "/authored/.zcode/whiteboards/file.json",
+            fileRevision: revision(updates.length),
+            document: {
+              schemaVersion: 1,
+              revision: updates.length,
+              mutationId: command.input.mutationId,
+              mutationDigest: "a".repeat(64),
+              board: structuredClone(command.input.document),
+            },
+          };
+          return structuredClone(saved);
+        },
+      }) as unknown as IZCodeAgentService;
+    let agent = makeAgent();
+    const render = async () => {
+      await act(async () =>
+        root.render(
+          <ServiceProvider services={{ zcodeAgentService: agent } as never}>
+            <TabStoreProvider>
+              <ZCodeIntlProvider initialLocale={locale}>
+                <TooltipProvider>
+                  <WhiteboardPane
+                    {...scope}
+                    boardId={target.boardId}
+                    sessionId="original-session"
+                    showSession={(_, session) => sessions.push(session)}
+                    onOpenBoard={(id) => {
+                      opened.push(id);
+                    }}
+                  />
+                  <ConfirmDialogHost />
+                </TooltipProvider>
+              </ZCodeIntlProvider>
+            </TabStoreProvider>
+          </ServiceProvider>,
+        ),
+      );
+    };
+    const click = async (selector: string) => {
+      const button =
+        container.querySelector<HTMLElement>(selector) ??
+        document.querySelector<HTMLElement>(selector);
+      check(button, `Missing ${selector}`);
+      await act(async () => {
+        button.click();
+        await tick();
+      });
+    };
+    const pointer = async (type: string, id: number, offset: number) => {
+      const canvas = container.querySelector<HTMLCanvasElement>("canvas");
+      check(canvas, "Canvas missing");
+      // Browser capture requires physical pointer provenance. Only capture is shimmed; actual
+      // React pointer handlers, bounds mapping, stroke refs and Canvas2D renderer execute.
+      canvas.setPointerCapture = () => {};
+      canvas.hasPointerCapture = () => false;
+      const box = canvas.getBoundingClientRect();
+      check(box.width > 100 && box.height > 100, "Styled canvas has no bounds");
+      await act(async () =>
+        canvas.dispatchEvent(
+          new PointerEvent(type, {
+            bubbles: true,
+            button: 0,
+            pointerId: id,
+            clientX: box.left + offset,
+            clientY: box.top + offset,
+          }),
+        ),
+      );
+    };
+    try {
+      await render();
+      await pointer("pointerdown", 1, 10);
+      await pointer("pointermove", 1, 30);
+      check(
+        store.getState().getBoard(target)!.strokes.length === 0,
+        "Active gesture prematurely committed",
+      );
+      await click('[data-testid="whiteboard-save"]');
+      check(
+        updates.length === 1 && updates[0]!.input.document.strokes.length === 1,
+        `Save omitted active pen gesture; updates=${updates.length}; strokes=${store.getState().getBoard(target)!.strokes.length}; error=${store.getState().workspaces[scope.workspacePath]?.nativeById?.[target.boardId]?.error}`,
+      );
+      const pendingProjection =
+        store.getState().workspaces[scope.workspacePath]?.nativeById?.[target.boardId];
+      check(
+        pendingProjection?.pending && !pendingProjection.committed,
+        "Save lost its pending draft or claimed a durable receipt before ACK",
+      );
+      check(
+        container
+          .querySelector('[data-testid="whiteboard-save-status"]')
+          ?.textContent?.includes(locale === "en-US" ? "Saving" : "正在保存"),
+        "Save claimed confirmed before ACK",
+      );
+      await pointer("pointerdown", 2, 40);
+      await pointer("pointerup", 2, 50);
+      await act(async () => {
+        releaseSave!();
+        await tick();
+      });
+      check(store.getState().getBoard(target)!.strokes.length === 2, "ACK consumed later drawing");
+      check(
+        sessions.length > 0 && sessions.every((id) => id === "original-session"),
+        "Save changed original Session",
+      );
+      check(commands.length === 0, "Provided Session created an extra Session or model command");
+
+      await click('[data-testid="whiteboard-open"]');
+      const catalogRow = Array.from(
+        document.querySelectorAll<HTMLButtonElement>(
+          '[data-testid="whiteboard-open-dialog"] button',
+        ),
+      ).find((button) => button.textContent === saved!.document.board.name);
+      check(catalogRow, "Saved drawing discovery is missing");
+      await act(async () => catalogRow.click());
+      check(
+        opened.at(-1) === target.boardId,
+        "Saved Open did not use the validated original board identity",
+      );
+
+      await act(async () => store.getState().discardDraft(target));
+      holdRead = true;
+      await click('[data-testid="whiteboard-refresh"]');
+      await pointer("pointerdown", 7, 40);
+      await pointer("pointerup", 7, 50);
+      holdSave = false;
+      await click('[data-testid="whiteboard-save"]');
+      const committedAfterWrite =
+        store.getState().workspaces[scope.workspacePath]!.nativeById![target.boardId]!.committed!;
+      holdRead = false;
+      await act(async () => {
+        releaseRead!();
+        await tick();
+      });
+      check(
+        store.getState().workspaces[scope.workspacePath]!.nativeById![target.boardId]!.committed
+          ?.fileRevision.hash === committedAfterWrite.fileRevision.hash,
+        "Older held read rolled back newer confirmed Save",
+      );
+      const strokesBeforeIncoming = store.getState().getBoard(target)!.strokes.length;
+
+      await pointer("pointerdown", 3, 60);
+      saved = {
+        ...saved!,
+        document: {
+          ...saved!.document,
+          revision: saved!.document.revision + 1,
+          board: { ...saved!.document.board, name: "Agent saved version" },
+        },
+        fileRevision: revision(saved!.document.revision + 1),
+      };
+      await click('[data-testid="whiteboard-refresh"]');
+      check(
+        store.getState().getBoard(target)!.name !== "Agent saved version",
+        "Incoming read erased active gesture's draft",
+      );
+      check(
+        container.querySelector('[data-testid="whiteboard-conflict"]'),
+        "Conflict version was concealed",
+      );
+      await pointer("pointerup", 3, 80);
+      check(
+        store.getState().getBoard(target)!.strokes.length === strokesBeforeIncoming + 1,
+        "Incoming read cut off the active gesture",
+      );
+
+      holdSave = false;
+      refusal = true;
+      const deniedDraft = structuredClone(store.getState().getBoard(target));
+      await click('[data-testid="whiteboard-save"]');
+      check(
+        container.querySelector('[data-testid="whiteboard-native-error"]')?.textContent ===
+          (locale === "en-US" ? enUS : zhCN)["whiteboard.saveUnapproved"],
+        "Denied Save did not show the local neutral unapproved outcome",
+      );
+      check(
+        JSON.stringify(store.getState().getBoard(target)) === JSON.stringify(deniedDraft),
+        "Denied Save changed the retained original draft",
+      );
+      check(
+        !container.querySelector<HTMLButtonElement>('[data-testid="whiteboard-export-json"]')
+          ?.disabled,
+        "Failed save removed draft export",
+      );
+
+      let closeListener:
+        | ((request: { requestId: string; phase?: "request" | "cancelled" }) => void)
+        | undefined;
+      const closeReplies: Array<{ requestId: string; allowClose: boolean }> = [];
+      const messages = locale === "en-US" ? enUS : zhCN;
+      const removeClose = installNativeWhiteboardCloseBridge(
+        {
+          onNativeWhiteboardCloseRequest: (listener) => {
+            closeListener = listener;
+            return { dispose() {} };
+          },
+          publishNativeWhiteboardDraftState: () => {},
+          completeNativeWhiteboardClose: async (result) => {
+            closeReplies.push(result);
+          },
+        },
+        {
+          format: (id, values) =>
+            (messages[id as keyof typeof messages] ?? id).replace(
+              /\{(\w+)\}/g,
+              (match, key) => values?.[key] ?? match,
+            ),
+          save: (boardTarget) =>
+            saveNativeWhiteboardDraft({
+              target: boardTarget,
+              agent,
+              sessionId: "original-session",
+              showSession: () => {},
+            }),
+        },
+      );
+      const closeId = crypto.randomUUID();
+      await act(async () => {
+        closeListener!({ requestId: closeId });
+        await tick();
+      });
+      const dialog = document.querySelector<HTMLElement>(
+        `[data-testid="whiteboard-close-${closeId}"]`,
+      );
+      check(dialog, "Actual close dialog missing");
+      const cancel = Array.from(dialog.querySelectorAll("button")).find(
+        (button) => button.textContent === messages["common.cancel"],
+      );
+      check(cancel, "Visible Cancel action missing");
+      await act(async () => {
+        cancel.click();
+        await tick();
+      });
+      check(
+        closeReplies.at(-1)?.allowClose === false && store.getState().getBoard(target),
+        "Cancel lost draft or admitted close",
+      );
+      const deniedCloseId = crypto.randomUUID();
+      await act(async () => {
+        closeListener!({ requestId: deniedCloseId });
+        await tick();
+      });
+      const deniedDialog = document.querySelector<HTMLElement>(
+        `[data-testid="whiteboard-close-${deniedCloseId}"]`,
+      )!;
+      const saveButton = Array.from(deniedDialog.querySelectorAll("button")).find(
+        (button) => button.textContent === messages["whiteboard.save"],
+      );
+      check(saveButton, "Visible Save action missing");
+      await act(async () => {
+        saveButton.click();
+        await tick();
+      });
+      check(
+        closeReplies.at(-1)?.allowClose === false && store.getState().getBoard(target),
+        "Denied close-save discarded data or admitted close",
+      );
+      await act(async () => {
+        store.getState().createBoard({
+          workspacePath: "/authored-hidden-workspace",
+          defaultNamePrefix: "Hidden",
+        });
+      });
+      const discardCloseId = crypto.randomUUID();
+      await act(async () => {
+        closeListener!({ requestId: discardCloseId });
+        await tick();
+      });
+      for (let i = 0; i < 2; i++) {
+        const discardDialog = document.querySelector<HTMLElement>(
+          `[data-testid="whiteboard-close-${discardCloseId}"]`,
+        )!;
+        const discardButton = Array.from(discardDialog.querySelectorAll("button")).find(
+          (button) => button.textContent === messages["whiteboard.discard"],
+        );
+        check(discardButton, "Visible Discard action missing");
+        await act(async () => {
+          discardButton.click();
+          await tick();
+        });
+      }
+      check(
+        closeReplies.at(-1)?.allowClose === true && store.getState().nativeCloseFrozen,
+        "Hidden-workspace close did not freeze after explicit decisions",
+      );
+      check(
+        !store.getState().workspaces["/authored-hidden-workspace"]?.boardIds.length,
+        "Hidden draft escaped close decisions",
+      );
+      const frozenStrokes = store.getState().getBoard(target)!.strokes.length;
+      await pointer("pointerdown", 9, 100);
+      await pointer("pointerup", 9, 120);
+      check(
+        store.getState().getBoard(target)!.strokes.length === frozenStrokes,
+        "Ink changed after close ACK",
+      );
+      await act(async () => {
+        closeListener!({ requestId: discardCloseId, phase: "cancelled" });
+        await tick();
+      });
+      check(!store.getState().nativeCloseFrozen, "Cancelled quit left window frozen");
+      await pointer("pointerdown", 10, 100);
+      await pointer("pointerup", 10, 120);
+      removeClose();
+
+      holdSave = true;
+      refusal = false;
+      await click('[data-testid="whiteboard-save"]');
+      const originalAgent = agent;
+      agent = makeAgent();
+      await render();
+      agent = originalAgent;
+      await render();
+      await act(async () => {
+        releaseSave!();
+        await tick();
+      });
+      const projection =
+        store.getState().workspaces[scope.workspacePath]!.nativeById![target.boardId]!;
+      check(
+        projection.retry &&
+          !projection.pending &&
+          projection.committed?.document.mutationId !== updates.at(-1)!.input.mutationId,
+        "A→B→A late ACK claimed accepted state",
+      );
+      const strokesBeforeUnmount = store.getState().getBoard(target)!.strokes.length;
+      await pointer("pointerdown", 42, 100);
+      await pointer("pointermove", 42, 130);
+      await act(async () => root.render(<div />));
+      check(
+        store.getState().getBoard(target)!.strokes.length === strokesBeforeUnmount + 1,
+        "Pane unmount discarded active gesture",
+      );
+      await render();
+      results.push({
+        name: `${locale}: styled native pane flush, receipt, conflict, refusal, visible Cancel and A→B→A ownership`,
+      });
+    } catch (error) {
+      results.push({
+        name: `${locale}: styled native pane`,
+        error: error instanceof Error ? error.stack : String(error),
+      });
+    } finally {
+      await act(async () => {
+        dialogs.getState().settleChoice("dismiss");
+        root.unmount();
+      });
+      container.remove();
+    }
+  }
+  return results;
+}
+(
+  window as unknown as { __whiteboardNativePaneTests: Promise<typeof results> }
+).__whiteboardNativePaneTests = run();
diff --git a/packages/ui/test/whiteboardPaneClose.browser.test.tsx b/packages/ui/test/whiteboardPaneClose.browser.test.tsx
new file mode 100644
index 00000000..b77e938d
--- /dev/null
+++ b/packages/ui/test/whiteboardPaneClose.browser.test.tsx
@@ -0,0 +1,311 @@
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import { act, useEffect } from "react";
+import { createRoot } from "react-dom/client";
+import { useAppPanels } from "../src/hooks/useAppPanels.js";
+import { useNativeWhiteboardWindowClose } from "../src/hooks/useNativeWhiteboardWindowClose.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { ConfirmDialogHost } from "../src/ConfirmDialog.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+import { useConfirmDialogStore as dialogs } from "../src/store/confirmDialogStore.js";
+import { useZCodeSessionStore } from "../src/store/zcodeSessionStore.js";
+import { saveTaskSidePaneMemoryState } from "../src/lib/taskSidePaneMemory.js";
+import { openWhiteboardSidePane, openCodeViewerSidePane } from "../src/lib/workspaceSidePane.js";
+import {
+  NATIVE_WHITEBOARD_SESSION_NAVIGATION,
+  type NativeWhiteboardNavigation,
+  showNativePluginViewSession,
+} from "../src/lib/nativeWhiteboardNavigation.js";
+import type { WhiteboardControlInput } from "@zcode/shared";
+import type { IServiceAccessor } from "@zcode/services";
+import enUS from "../src/i18n/locales/en-US.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 12; i++) await Promise.resolve();
+};
+
+async function fixture() {
+  store.setState({ ...store.getInitialState() }, true);
+  const path = `/pane-native-close-${crypto.randomUUID()}`,
+    owner = "original-session";
+  const first = store.getState().createBoard({ workspacePath: path, defaultNamePrefix: "First" });
+  const second = store.getState().createBoard({ workspacePath: path, defaultNamePrefix: "Second" });
+  useZCodeSessionStore.getState().setActiveTaskId(path, owner);
+  let initial = openWhiteboardSidePane(null, { boardId: first.id, title: first.name });
+  initial = openWhiteboardSidePane(initial, { boardId: second.id, title: second.name });
+  initial = openCodeViewerSidePane(initial, {
+    type: "file",
+    path: `${path}/keep.md`,
+    title: "Keep",
+  });
+  initial.tabs = initial.tabs.map((tab) => ({ ...tab, ownerTaskId: owner, workspaceKey: path }));
+  saveTaskSidePaneMemoryState(path, { sidePaneState: initial, isSidePaneCollapsed: false });
+  const keepId = initial.activeTabId;
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  let latest!: ReturnType<typeof useAppPanels>;
+  let releaseSave: (() => void) | undefined;
+  let hold = false;
+  let writes = 0;
+  const services = {
+    zcodeSessionService: { closeSession: async () => {} },
+    zcodeAgentService: {
+      ...nativePresentationAgent().agent,
+      async sendConversationCommandV4() {
+        throw new Error("Authored close must reuse its existing Session without a model command");
+      },
+      async performWhiteboardControl({ command }: { command: WhiteboardControlInput }) {
+        check(command.operation === "update", "Unexpected native read");
+        writes++;
+        if (hold)
+          await new Promise<void>((resolve) => {
+            releaseSave = resolve;
+          });
+        return {
+          status: "completed",
+          filePath: "/authored/native.json",
+          fileRevision: { id: "authored", hash: `sha256:${"a".repeat(64)}` },
+          document: {
+            schemaVersion: 1,
+            revision: 1,
+            mutationId: command.input.mutationId,
+            mutationDigest: "a".repeat(64),
+            board: command.input.document,
+          },
+        };
+      },
+    },
+  } as unknown as IServiceAccessor;
+  function Probe({ workspace }: { workspace: string }) {
+    latest = useAppPanels({
+      workspaceAbsPath: workspace,
+      activeTaskId: owner,
+      sidePaneOwnerId: owner,
+      defaultWhiteboardNamePrefix: "Authored",
+      isDesktop: false,
+    });
+    useNativeWhiteboardWindowClose({
+      localServices: services,
+      platform: null,
+      format: (id, values) =>
+        (enUS[id as keyof typeof enUS] ?? id).replace(
+          /\{(\w+)\}/g,
+          (match, key) => values?.[key] ?? match,
+        ),
+    });
+    useEffect(() => {
+      const show = (event: Event) => {
+        (event as CustomEvent<NativeWhiteboardNavigation>).detail.handled = true;
+      };
+      window.addEventListener(NATIVE_WHITEBOARD_SESSION_NAVIGATION, show);
+      return () => window.removeEventListener(NATIVE_WHITEBOARD_SESSION_NAVIGATION, show);
+    }, []);
+    return <ConfirmDialogHost />;
+  }
+  const render = async (workspace = path) => {
+    await act(async () =>
+      root.render(
+        <ServiceProvider services={services}>
+          <ZCodeIntlProvider initialLocale="en-US">
+            <Probe workspace={workspace} />
+          </ZCodeIntlProvider>
+        </ServiceProvider>,
+      ),
+    );
+  };
+  const choose = async (label: string) => {
+    const button = Array.from(
+      document.querySelectorAll<HTMLButtonElement>('[data-testid="whiteboard-close-pane"] button'),
+    ).find((node) => node.textContent === label);
+    check(button, `Missing original dialog choice ${label}`);
+    await act(async () => {
+      button.click();
+      await tick();
+    });
+  };
+  await render();
+  return {
+    path,
+    first,
+    second,
+    keepId,
+    render,
+    choose,
+    get latest() {
+      return latest;
+    },
+    get writes() {
+      return writes;
+    },
+    setHold(value: boolean) {
+      hold = value;
+    },
+    async release() {
+      await act(async () => {
+        releaseSave!();
+        await tick();
+      });
+    },
+    async close() {
+      await act(async () => {
+        dialogs.getState().settleChoice("dismiss");
+        root.unmount();
+      });
+      node.remove();
+    },
+  };
+}
+async function run() {
+  const cases: Array<[string, (f: Awaited<ReturnType<typeof fixture>>) => Promise<void>]> = [
+    [
+      "original Session navigation preserves the exact plugin tab and other native surfaces",
+      async (f) => {
+        await act(async () => {
+          f.latest.handleOpenPluginView({
+            pluginId: "authored@market",
+            viewId: "own-view",
+            title: "Authored",
+          });
+          f.latest.handleOpenPluginView({
+            pluginId: "authored@market",
+            viewId: "other-view",
+            title: "Other",
+          });
+          await tick();
+        });
+        await act(async () => {
+          showNativePluginViewSession(
+            { workspacePath: f.path, pluginId: "authored@market", viewId: "own-view" },
+            "new-original-session",
+          );
+          await tick();
+        });
+        const tabs = f.latest.sidePaneState!.tabs;
+        check(
+          tabs.find((tab) => tab.id === "plugin-view:authored@market:own-view")?.ownerTaskId ===
+            "new-original-session",
+          "Plugin tab was not preserved for its approval Session",
+        );
+        check(
+          tabs.find((tab) => tab.id === "plugin-view:authored@market:other-view")?.ownerTaskId !==
+            "new-original-session",
+          "Navigation reassigned another view",
+        );
+        check(
+          tabs.some((tab) => tab.id === `whiteboard:${f.first.id}`),
+          "Plugin navigation removed original whiteboard",
+        );
+      },
+    ],
+    [
+      "original close-one Cancel retains native draft and tab",
+      async (f) => {
+        await act(async () => {
+          f.latest.handleCloseSidePaneTab(`whiteboard:${f.first.id}`);
+          await tick();
+        });
+        await f.choose("Cancel");
+        check(
+          f.latest.sidePaneState?.tabs.some((tab) => tab.id === `whiteboard:${f.first.id}`),
+          "Cancel removed tab",
+        );
+        check(
+          store.getState().getBoard({ workspacePath: f.path, boardId: f.first.id }),
+          "Cancel removed draft",
+        );
+      },
+    ],
+    [
+      "original Close Others settles Discard and Save before closing captured boards",
+      async (f) => {
+        await act(async () => {
+          f.latest.handleCloseOtherSidePaneTabs(f.keepId);
+          await tick();
+        });
+        await f.choose("Discard");
+        await f.choose("Save");
+        check(
+          f.latest.sidePaneState?.tabs.length === 1 &&
+            f.latest.sidePaneState.tabs[0]?.id === f.keepId,
+          "Close Others lost retained tab or left captured tabs",
+        );
+        check(
+          f.writes === 1 &&
+            store.getState().workspaces[f.path]?.nativeById?.[f.second.id]?.committed,
+          "Close Others skipped actual save receipt",
+        );
+      },
+    ],
+    [
+      "original Close All decisions cover every visible board",
+      async (f) => {
+        await act(async () => {
+          f.latest.handleCloseAllSidePaneTabs();
+          await tick();
+        });
+        await f.choose("Discard");
+        await f.choose("Discard");
+        check(!f.latest.sidePaneState?.tabs.length, "Close All left captured tabs");
+        check(
+          !store.getState().workspaces[f.path]?.boardIds.length,
+          "Close All lost explicit discard projection",
+        );
+      },
+    ],
+    [
+      "A→B→A native close cannot close a renewed owner after held Save ACK",
+      async (f) => {
+        f.setHold(true);
+        await act(async () => {
+          f.latest.handleCloseSidePaneTab(`whiteboard:${f.first.id}`);
+          await tick();
+        });
+        await f.choose("Save");
+        await f.render("/authored-other-workspace");
+        await f.render();
+        await f.release();
+        check(
+          f.latest.sidePaneState?.tabs.some((tab) => tab.id === `whiteboard:${f.first.id}`),
+          "Late close removed renewed owner",
+        );
+        check(
+          store.getState().workspaces[f.path]?.nativeById?.[f.first.id]?.committed,
+          "Known original save receipt was lost",
+        );
+      },
+    ],
+    [
+      "same renderer hook prevents manual unload with original dirty/pending data",
+      async (f) => {
+        const event = new Event("beforeunload", { cancelable: true });
+        await act(async () => window.dispatchEvent(event));
+        check(event.defaultPrevented, "Dirty reload was admitted");
+        check(
+          store.getState().getBoard({ workspacePath: f.path, boardId: f.first.id }),
+          "Unload guard consumed draft",
+        );
+      },
+    ],
+  ];
+  for (const [name, body] of cases) {
+    const f = await fixture();
+    try {
+      await body(f);
+      results.push({ name });
+    } catch (error) {
+      results.push({ name, error: error instanceof Error ? error.stack : String(error) });
+    } finally {
+      await f.close();
+    }
+  }
+  return results;
+}
+(
+  window as unknown as { __whiteboardPaneCloseTests: Promise<typeof results> }
+).__whiteboardPaneCloseTests = run();
