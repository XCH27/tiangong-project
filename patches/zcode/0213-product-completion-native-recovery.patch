+import assert from "node:assert/strict";
+import test from "node:test";
+import { createDesktopTelemetryFetch } from "../src/main/desktopTelemetryFetch.js";
+
+test("declared fetch URL input reaches Electron as a string and retains the original receiver/options", async () => {
+  const seen: Array<{ receiver: unknown; input: string | Request; init?: RequestInit }> = [];
+  const source = { async fetch(input: string | Request, init?: RequestInit) {
+    seen.push({ receiver: this, input, init }); return new Response("authored");
+  } };
+  const fetch = createDesktopTelemetryFetch(source);
+  const init = { method: "POST", body: "authored" };
+  await fetch(new URL("https://example.invalid/report?q=authored"), init);
+  assert.equal(seen[0]!.input, "https://example.invalid/report?q=authored");
+  assert.equal(seen[0]!.receiver, source);
+  assert.equal(seen[0]!.init, init);
+  const request = new Request("https://example.invalid/report");
+  await fetch(request);
+  assert.equal(seen[1]!.input, request);
+});
diff --git a/packages/desktop/test/helpers/main-consumer-fixture.mjs b/packages/desktop/test/helpers/main-consumer-fixture.mjs
new file mode 100644
index 00000000..6e61572a
--- /dev/null
+++ b/packages/desktop/test/helpers/main-consumer-fixture.mjs
@@ -0,0 +1,82 @@
+import { build } from "esbuild";
+import { createRequire } from "node:module";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = fileURLToPath(new URL("../../../../", import.meta.url));
+let nextFixture = 0;
+
+// Executes current Main consumers with an authored Electron boundary. No app launch.
+// Optional private exports exist only in the test bundle, not the product ABI.
+export async function loadMainConsumer(t, filename, options = {}) {
+  const directory = await mkdtemp(join(tmpdir(), "main-consumer-"));
+  const key = `__mainConsumerFixture${nextFixture++}`;
+  const entry = join(root, "packages/desktop/src/main", filename);
+  globalThis[key] = options.electron ?? {};
+  t.after(async () => {
+    delete globalThis[key];
+    await rm(directory, { recursive: true, force: true });
+  });
+  const outfile = join(directory, "consumer.cjs");
+  await build({
+    entryPoints: [entry],
+    outfile,
+    bundle: true,
+    platform: "node",
+    format: "cjs",
+    logLevel: "silent",
+    plugins: [
+      {
+        name: "authored-main-boundary",
+        setup(builder) {
+          for (const [specifier, contents] of Object.entries(options.stubs ?? {})) {
+            const namespace = key + specifier;
+            builder.onResolve(
+              { filter: new RegExp("^" + specifier.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "$") },
+              () => ({ path: specifier, namespace }),
+            );
+            builder.onLoad({ filter: /.*/, namespace }, () => ({ contents }));
+          }
+          builder.onResolve({ filter: /^electron$/ }, () => ({ path: "electron", namespace: key }));
+          builder.onLoad({ filter: /.*/, namespace: key }, () => ({
+            contents: `const fixture=globalThis[${JSON.stringify(key)}]; export const {app,BrowserWindow,Menu,MessageChannelMain,ipcMain,dialog,crashReporter,shell,nativeImage,nativeTheme,screen,webContents}=fixture;`,
+          }));
+          builder.onResolve({ filter: /^@zcode\/services\/node$/ }, () => ({
+            path: "services",
+            namespace: key + "stub",
+          }));
+          builder.onResolve(
+            { filter: /^\.\/(logger|editors|windowsAumidIcon)\.js$/ },
+            ({ path }) => ({ path, namespace: key + "stub" }),
+          );
+          builder.onLoad({ filter: /.*/, namespace: key + "stub" }, ({ path }) => ({
+            contents:
+              path === "services"
+                ? 'export function getAppConfigDir(){throw new Error("no real profile access in fixture");}'
+                : "export const logger={info(){},warn(){},error(){},debug(){}}; export function getAppIconDataUrl(){} export function readWindowsAumidIcon(){}",
+          }));
+          builder.onLoad({ filter: /\.ts$/ }, async ({ path }) => {
+            if (path !== entry) return;
+            const source =
+              options.source ??
+              (await readFile(
+                process.env.MAIN_CONSUMER_BASE_DIR
+                  ? join(process.env.MAIN_CONSUMER_BASE_DIR, filename)
+                  : path,
+                "utf8",
+              ));
+            return {
+              contents:
+                source +
+                (options.exports?.length ? `\nexport {${options.exports.join(",")}};` : ""),
+              loader: "ts",
+            };
+          });
+        },
+      },
+    ],
+  });
+  return createRequire(import.meta.url)(outfile);
+}
diff --git a/packages/desktop/test/main-binary-consumers.test.mjs b/packages/desktop/test/main-binary-consumers.test.mjs
