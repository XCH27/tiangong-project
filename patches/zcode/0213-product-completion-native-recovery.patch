@@ -0,0 +1,96 @@
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import type { ForkCommitBundle, ProjectId, SessionId } from "@zcode/contracts";
+import type { ForkCommitFaultStage } from "../src/storage/session-store/options.js";
+import { SqliteSessionStore } from "../src/storage/session-store/sqlite-session-store.js";
+
+test("the original SQLite fork transaction rolls back every fault stage and cold retries once", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "sqlite-fork-owner-"));
+  const stages: ForkCommitFaultStage[] = [
+    "afterChild",
+    "afterMessages",
+    "afterGoal",
+    "afterEntries",
+    "afterInput",
+    "afterCommandFact",
+    "beforeCommit",
+  ];
+  try {
+    for (const stage of stages) {
+      const dbPath = join(dir, `${stage}.sqlite`);
+      const parentID = "parent" as SessionId;
+      const childID = "child" as SessionId;
+      let store = new SqliteSessionStore({ dbPath, forkCommitFaultAt: stage });
+      const session = {
+        projectID: "project" as ProjectId,
+        slug: "fixture",
+        directory: dir,
+        title: "fixture",
+        version: "fixture",
+      };
+      const bundle: ForkCommitBundle = {
+        child: { ...session, id: childID, parentID },
+        messages: [],
+        entries: [
+          {
+            id: "child-entry",
+            sessionID: childID,
+            type: "v4/command_fact",
+            time: { created: 1, updated: 1 },
+            data: {},
+          },
+        ],
+        initialInput: {
+          id: "child-input",
+          sessionID: childID,
+          kind: "text",
+          delivery: "startNow",
+          payload: { text: "fixture" },
+        },
+        commandFact: {
+          parentSessionId: parentID,
+          sourceCommandId: "fork-once",
+          ack: {
+            commandId: "fork-once",
+            status: "accepted",
+            revisionAtDecision: 0,
+            result: { type: "forkAssistant", sessionId: childID },
+          },
+          metadata: {},
+        },
+      };
+      try {
+        await store.createSession({ ...session, id: parentID });
+        await assert.rejects(
+          store.commitForkBundle(bundle),
+          new RegExp(`injected fork commit fault: ${stage}`),
+        );
+        assert.equal(await store.getSession(childID), null);
+        assert.deepEqual(await store.sessionEntries({ sessionID: parentID }), []);
+        store.close();
+        store = await SqliteSessionStore.openStartup({ dbPath });
+        assert.equal(await store.getSession(childID), null);
+        assert.equal(await store.getSessionInputById("child-input"), null);
+        assert.deepEqual(await store.sessionEntries({ sessionID: childID }), []);
+        const first = await store.commitForkBundle(bundle);
+        const duplicate = await store.commitForkBundle(bundle);
+        assert.equal(first.id, childID);
+        assert.equal(duplicate.id, childID);
+        assert.equal((await store.sessionEntries({ sessionID: parentID })).length, 1);
+        assert.equal((await store.sessionEntries({ sessionID: childID })).length, 1);
+        assert.equal((await store.getSessionInputById("child-input"))?.sessionID, childID);
+        store.close();
+        store = new SqliteSessionStore({ dbPath });
+        assert.equal((await store.commitForkBundle(bundle)).id, childID);
+        assert.equal((await store.listSessions()).length, 2);
+      } finally {
+        store.close();
+      }
+    }
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
