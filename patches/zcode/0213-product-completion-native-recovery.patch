+
+export class CommandInbox implements CommandInboxMethods {
+  private readonly inFlight = new Map<string, Map<string, InFlightEntry>>();
+  private readonly liveInputs = new Map<string, Map<string, LiveInputEntry>>();
+  private readonly settled = new Map<string, Map<string, CommandAck>>();
+  private readonly admissionSeq = new Map<string, number>();
+  private readonly keyGates = new AsyncGateRegistry();
+  private readonly sessionGates = new AsyncGateRegistry();
+
+  constructor(private readonly host: CommandInboxHost) {}
+
+  declare private queryOne: OmitThisParameter<typeof queryOne>;
+
+  declare private lookupExact: OmitThisParameter<typeof lookupExact>;
+
+  declare private decide: OmitThisParameter<typeof decide>;
+
+  declare private retryAck: OmitThisParameter<typeof retryAck>;
+
+  declare private queryUnavailableAck: OmitThisParameter<typeof queryUnavailableAck>;
+
+  declare private ackOnly: OmitThisParameter<typeof ackOnly>;
+
+  declare private bucketKey: OmitThisParameter<typeof bucketKey>;
+
+  declare private keyGateKey: OmitThisParameter<typeof keyGateKey>;
+
+  declare private mapFor: OmitThisParameter<typeof mapFor>;
+
+  declare private touchSettled: OmitThisParameter<typeof touchSettled>;
+
+  declare private rememberSettled: OmitThisParameter<typeof rememberSettled>;
+
+  declare private extractCommandId: OmitThisParameter<typeof extractCommandId>;
+}
