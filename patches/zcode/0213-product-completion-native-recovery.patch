@@ -0,0 +1,222 @@
+import type { StoreApi } from "zustand";
+import { createUuid } from "@zcode/shared";
+import { buildWhiteboardWorkspaceKey } from "../lib/whiteboard.js";
+import { acknowledgeWhiteboard, receiveWhiteboard } from "./whiteboardNativeProjection.js";
+import { getWorkspaceState } from "./whiteboardWorkspace.js";
+import type { WhiteboardStoreState } from "./whiteboardStore.js";
+
+/** Methods capture the original Zustand set/get; there is no second draft or native owner. */
+export function createNativeWhiteboardActions(
+  set: StoreApi<WhiteboardStoreState>["setState"],
+  get: StoreApi<WhiteboardStoreState>["getState"],
+): Pick<
+  WhiteboardStoreState,
+  | "rememberNativeWorkspace"
+  | "beginNativeSave"
+  | "failNativeSave"
+  | "reportNativeSaveError"
+  | "acknowledgeNativeSave"
+  | "receiveNativeBoard"
+  | "discardDraft"
+  | "resolveNativeConflict"
+> {
+  return {
+    rememberNativeWorkspace: (scope) => {
+      const key = buildWhiteboardWorkspaceKey(scope);
+      set((state) => ({
+        workspaces: {
+          ...state.workspaces,
+          [key]: {
+            ...getWorkspaceState(state, key),
+            scope: { ...scope },
+          },
+        },
+      }));
+    },
+    beginNativeSave: (target, cancel) => {
+      const key = buildWhiteboardWorkspaceKey(target),
+        workspace = get().workspaces[key];
+      const board = workspace?.boardsById[target.boardId],
+        native = workspace?.nativeById?.[target.boardId];
+      if (!board || native?.pending) return null;
+      const pending = {
+        requestId: createUuid(),
+        mutationId: native?.retry?.draft === board ? native.retry.mutationId : createUuid(),
+        draft: board,
+        ...(cancel ? { cancel } : {}),
+      };
+      set((state) => ({
+        workspaces: {
+          ...state.workspaces,
+          [key]: {
+            ...state.workspaces[key]!,
+            nativeById: {
+              ...state.workspaces[key]?.nativeById,
+              [target.boardId]: { ...native, pending, error: undefined },
+            },
+          },
+        },
+      }));
+      return pending;
+    },
+    reportNativeSaveError: (target) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      set((state) => {
+        const workspace = state.workspaces[key],
+          native = workspace?.nativeById?.[target.boardId];
+        if (native?.pending?.requestId !== target.requestId) return state;
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace!,
+              nativeById: {
+                ...workspace?.nativeById,
+                [target.boardId]: { ...native, error: target.error },
+              },
+            },
+          },
+        };
+      });
+    },
+    failNativeSave: (target) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      set((state) => {
+        const workspace = state.workspaces[key],
+          native = workspace?.nativeById?.[target.boardId];
+        if (!native?.pending || native.pending.requestId !== target.requestId) return state;
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace!,
+              nativeById: {
+                ...workspace?.nativeById,
+                [target.boardId]: {
+                  ...native,
+                  pending: undefined,
+                  retry: { mutationId: native.pending.mutationId, draft: native.pending.draft },
+                  error: target.error,
+                },
+              },
+            },
+          },
+        };
+      });
+    },
+    acknowledgeNativeSave: (target) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      set((state) => {
+        const workspace = state.workspaces[key],
+          native = workspace?.nativeById?.[target.boardId];
+        if (!workspace || !native) return state;
+        const ack = acknowledgeWhiteboard(workspace.boardsById[target.boardId], native, target);
+        if (!ack) return state;
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace,
+              boardsById: { ...workspace.boardsById, [target.boardId]: ack.board! },
+              nativeById: { ...workspace.nativeById, [target.boardId]: ack.native },
+            },
+          },
+        };
+      });
+    },
+    receiveNativeBoard: (target) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      if (target.document.board.id !== target.boardId)
+        throw new Error("Native whiteboard identity mismatch");
+      set((state) => {
+        const workspace = getWorkspaceState(state, key),
+          board = workspace.boardsById[target.boardId];
+        const received = receiveWhiteboard(
+          board,
+          workspace.nativeById?.[target.boardId],
+          target,
+          target.preserveDraft,
+        );
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace,
+              scope: workspace.scope ?? {
+                workspacePath: target.workspacePath,
+                workspaceIdentity: target.workspaceIdentity,
+              },
+              boardIds: workspace.boardIds.includes(target.boardId)
+                ? workspace.boardIds
+                : [...workspace.boardIds, target.boardId],
+              boardsById: {
+                ...workspace.boardsById,
+                ...(received.board ? { [target.boardId]: received.board } : {}),
+              },
+              nativeById: { ...workspace.nativeById, [target.boardId]: received.native },
+            },
+          },
+        };
+      });
+    },
+    discardDraft: (target) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      set((state) => {
+        if (state.nativeCloseFrozen) return state;
+        const workspace = state.workspaces[key];
+        if (!workspace || workspace.nativeById?.[target.boardId]?.pending) return state;
+        const committed = workspace.nativeById?.[target.boardId]?.committed;
+        const boards = { ...workspace.boardsById },
+          native = { ...workspace.nativeById };
+        if (committed) {
+          boards[target.boardId] = committed.document.board;
+          native[target.boardId] = { committed };
+        } else {
+          delete boards[target.boardId];
+          delete native[target.boardId];
+        }
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace,
+              boardsById: boards,
+              nativeById: native,
+              boardIds: committed
+                ? workspace.boardIds
+                : workspace.boardIds.filter((id) => id !== target.boardId),
+            },
+          },
+        };
+      });
+    },
+    resolveNativeConflict: (target, choice) => {
+      const key = buildWhiteboardWorkspaceKey(target);
+      set((state) => {
+        const workspace = state.workspaces[key],
+          projection = workspace?.nativeById?.[target.boardId];
+        if (state.nativeCloseFrozen || !workspace || projection?.pending || !projection?.incoming)
+          return state;
+        return {
+          workspaces: {
+            ...state.workspaces,
+            [key]: {
+              ...workspace,
+              boardsById:
+                choice === "saved"
+                  ? {
+                      ...workspace.boardsById,
+                      [target.boardId]: projection.incoming.document.board,
+                    }
+                  : workspace.boardsById,
+              nativeById: {
+                ...workspace.nativeById,
+                [target.boardId]: { committed: projection.incoming },
+              },
+            },
+          },
+        };
+      });
+    },
+  };
+}
