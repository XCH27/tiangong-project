+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IZCodeAgentService } from "@zcode/services";
+import type { ZCodeWorkflowsListResult } from "@zcode/shared";
+import {
+  selectSavedWorkflowState,
+  useSavedWorkflowStore,
+} from "../src/store/savedWorkflowStore.js";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+
+function fixture() {
+  const pending: ReturnType<typeof deferred<ZCodeWorkflowsListResult>>[] = [];
+  const service = {
+    listSavedWorkflows: () => {
+      const request = deferred<ZCodeWorkflowsListResult>();
+      pending.push(request);
+      return request.promise;
+    },
+    listSavedWorkflowRuns: async () => ({ runs: [] }),
+  } as unknown as IZCodeAgentService;
+  const complete = (index: number, name: string) =>
+    pending[index]!.resolve({
+      workflows: [{ name, description: name, scope: "project", path: `/authored/${name}.ts` }],
+      invalid: [],
+      dir: "/authored/.zcode/workflows",
+    });
+  return { service, pending, complete };
+}
+
+const target = { workspacePath: "/authored/saved-workflow-requests" };
+const snapshot = () => selectSavedWorkflowState(useSavedWorkflowStore.getState(), target);
+const reset = () => useSavedWorkflowStore.setState(useSavedWorkflowStore.getInitialState(), true);
+
+test("late initial list cannot restore a workflow removed by the latest refresh", async () => {
+  reset();
+  const f = fixture();
+  const initial = useSavedWorkflowStore.getState().load(target, f.service);
+  const refresh = useSavedWorkflowStore.getState().load(target, f.service, { bypassCache: true });
+  f.complete(1, "current");
+  await refresh;
+  f.complete(0, "removed");
+  await initial;
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["current"],
+  );
+});
+
+test("replacement Host reads its own list instead of joining the previous service", async () => {
+  reset();
+  const old = fixture();
+  const replacement = fixture();
+  const oldLoad = useSavedWorkflowStore.getState().load(target, old.service);
+  const newLoad = useSavedWorkflowStore.getState().load(target, replacement.service);
+  assert.equal(replacement.pending.length, 1, "replacement service must start its own read");
+  replacement.complete(0, "replacement");
+  await newLoad;
+  old.pending[0]!.reject(new Error("old Host unavailable"));
+  await oldLoad;
+  assert.equal(snapshot().error, null);
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["replacement"],
+  );
+});
+
+test("A to B to A cannot let the original A response settle the returned context", async () => {
+  reset();
+  const a = fixture();
+  const b = fixture();
+  const firstA = useSavedWorkflowStore.getState().load(target, a.service);
+  const loadB = useSavedWorkflowStore.getState().load(target, b.service);
+  const returnedA = useSavedWorkflowStore.getState().load(target, a.service);
+  a.complete(0, "old A");
+  b.pending[0]!.reject(new Error("old B error"));
+  await Promise.all([firstA, loadB]);
+  assert.equal(snapshot().loading, true);
+  assert.equal(snapshot().error, null);
+  assert.deepEqual(snapshot().entries, []);
+  a.complete(1, "current A");
+  await returnedA;
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["current A"],
+  );
+  assert.equal(snapshot().loading, false);
+});
+
+test("projection reset starts a new read even when the same service still has an old request", async () => {
+  reset();
+  const f = fixture();
+  const old = useSavedWorkflowStore.getState().load(target, f.service);
+  reset();
+  const restored = useSavedWorkflowStore.getState().load(target, f.service);
+  assert.equal(f.pending.length, 2);
+  f.complete(0, "before reset");
+  await old;
+  assert.equal(snapshot().loading, true);
+  f.complete(1, "after reset");
+  await restored;
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["after reset"],
+  );
+});
+
+test("a changed remote connection cannot reuse the same workspace's pending Host read", async () => {
+  reset();
+  const f = fixture();
+  const base = { ...target, workspaceIdentity: "ssh:authored" };
+  const old = useSavedWorkflowStore.getState().load({ ...base, remoteSessionId: "old" }, f.service);
+  const current = useSavedWorkflowStore
+    .getState()
+    .load({ ...base, remoteSessionId: "new" }, f.service);
+  assert.equal(f.pending.length, 2);
+  f.complete(1, "current Host");
+  await current;
+  f.complete(0, "old Host");
+  await old;
+  assert.deepEqual(
+    selectSavedWorkflowState(useSavedWorkflowStore.getState(), base).entries.map((e) => e.name),
+    ["current Host"],
+  );
+});
+
+test("sibling workspaces publish independently and old finally does not release the latest refresh", async () => {
+  reset();
+  const f = fixture();
+  const sibling = { workspacePath: "/authored/sibling" };
+  const first = useSavedWorkflowStore.getState().load(target, f.service);
+  const refresh = useSavedWorkflowStore.getState().load(target, f.service, { bypassCache: true });
+  const other = useSavedWorkflowStore.getState().load(sibling, f.service);
+  f.complete(0, "old");
+  await first;
+  const joined = useSavedWorkflowStore.getState().load(target, f.service);
+  assert.equal(f.pending.length, 3);
+  f.complete(2, "sibling");
+  f.complete(1, "current");
+  await Promise.all([refresh, other, joined]);
+  assert.deepEqual(
+    snapshot().entries.map((e) => e.name),
+    ["current"],
+  );
+  assert.deepEqual(
+    selectSavedWorkflowState(useSavedWorkflowStore.getState(), sibling).entries.map((e) => e.name),
+    ["sibling"],
+  );
+});
+
+test("history failure preserves the known snapshot and reports an error instead of never-run", async () => {
+  reset();
+  const f = fixture();
+  f.service.listSavedWorkflowRuns = async () => ({
+    runs: [
+      {
+        runId: "known-run",
+        name: "current",
+        status: "completed",
+        createdAt: 1,
+        updatedAt: 2,
+        spentTokens: 3,
+      },
+    ],
+  });
+  const initial = useSavedWorkflowStore.getState().load(target, f.service);
+  f.complete(0, "current");
+  await initial;
+  f.service.listSavedWorkflowRuns = async () => {
+    throw new Error("authored history unavailable");
+  };
+  const refresh = useSavedWorkflowStore.getState().load(target, f.service, { bypassCache: true });
+  f.complete(1, "not yet a complete snapshot");
+  await refresh;
+  assert.equal(snapshot().error, "authored history unavailable");
+  assert.equal(snapshot().loading, false);
+  assert.deepEqual(
+    snapshot().runs.map((run) => run.runId),
+    ["known-run"],
+  );
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["current"],
+  );
+});
+
+test("a stale success cannot clear the current error or settle a current retry", async () => {
+  reset();
+  const f = fixture();
+  const old = useSavedWorkflowStore.getState().load(target, f.service);
+  const current = useSavedWorkflowStore.getState().load(target, f.service, { bypassCache: true });
+  f.pending[1]!.reject(Object.assign(new Error("current source unavailable"), { code: 42 }));
+  await current;
+  f.complete(0, "stale success");
+  await old;
+  assert.equal(snapshot().error, "current source unavailable");
+  assert.equal(snapshot().errorCode, 42);
+  assert.equal(snapshot().loading, false);
+  assert.deepEqual(snapshot().entries, []);
+  const retry = useSavedWorkflowStore.getState().load(target, f.service);
+  assert.equal(snapshot().loading, true);
+  f.complete(2, "retry succeeded");
+  await retry;
+  assert.equal(snapshot().error, null);
+  assert.deepEqual(
+    snapshot().entries.map((entry) => entry.name),
+    ["retry succeeded"],
+  );
+});
+
+test("replacement Host does not present the previous Host's completed snapshot while unavailable", async () => {
+  reset();
+  const a = fixture();
+  const b = fixture();
+  const initial = useSavedWorkflowStore.getState().load(target, a.service);
+  a.complete(0, "Host A only");
+  await initial;
+  const replacement = useSavedWorkflowStore.getState().load(target, b.service);
+  assert.deepEqual(snapshot().entries, []);
+  b.pending[0]!.reject(new Error("Host B unavailable"));
+  await replacement;
+  assert.deepEqual(snapshot().entries, []);
+  assert.equal(snapshot().error, "Host B unavailable");
+});
