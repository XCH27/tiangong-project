+++ b/apps/zcode-cli/packages/core/src/runtime/methods/turn-regular-execution.ts
@@ -0,0 +1,250 @@
+import type {
+  HookRunResult,
+  MessageId,
+  SessionEvent,
+  SessionGoal,
+  TraceContext,
+  TurnId,
+  TurnState,
+} from "../deps.js";
+import { SessionEventType, TurnMachineImpl, createModelUsageSummaryFromEvents } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { ActiveTurnSteeringState, ExecuteTurnOptions, TurnResult } from "../types.js";
+import {
+  closeGoalStateChangeReminderDeferral,
+  openGoalStateChangeReminderDeferral,
+} from "./goal-state-reminder.js";
+import { completeRegularTurn } from "./turn-completion.js";
+import { failRegularTurn } from "./turn-failure.js";
+import { prepareRegularTurnInput } from "./turn-input.js";
+import type { RegularTurnLoopState } from "./turn-loop-state.js";
+import { runRegularTurnLoop } from "./turn-loop.js";
+import { finishOutputTokenRecovery } from "./turn-output-token-continuation.js";
+import { clearActiveTurnSteerable } from "./turn-steerable-clear.js";
+import { recordTurnUsageFact } from "./usage-observability.js";
+
+interface RegularTurnExecutionInput {
+  activeTurn: ActiveTurnSteeringState;
+  admittedModel?: RegularTurnLoopState["model"];
+  submissionModel?: RegularTurnLoopState["model"];
+  admittedOutputStyle: RegularTurnLoopState["turnOutputStyle"];
+  attachments?: TurnState["attachments"];
+  options?: ExecuteTurnOptions;
+  input: string;
+  displayInput: string;
+  events: SessionEvent[];
+  startedTarget: SessionGoal | null;
+  targetRunInputID: string;
+  turnStartedAtMs: number;
+  turnMachine: TurnMachineImpl;
+  turnId: TurnId;
+  traceId: TraceContext["traceId"];
+  turnTraceContext: TraceContext;
+  turnAbortSignal: AbortSignal;
+  userMessageId: MessageId;
+  startTurnPhase: (phase: string) => number;
+  completeTurnPhase: (phase: string, startedAt: number) => void;
+  setStartedTarget: (target: SessionGoal | null) => void;
+  onFailureHandled: () => void;
+}
+
+/** Execute the original prepared turn; the Runtime and caller's target/failure ownership remain shared. */
+export async function runPreparedRegularTurn(
+  this: AgentRuntimeInternal,
+  context: RegularTurnExecutionInput,
+): Promise<TurnResult> {
+  const {
+    activeTurn,
+    admittedModel,
+    submissionModel,
+    admittedOutputStyle,
+    attachments,
+    options,
+    input,
+    displayInput,
+    events,
+    startedTarget,
+    targetRunInputID,
+    turnStartedAtMs,
+    turnId,
+    traceId,
+    turnTraceContext,
+    turnAbortSignal,
+    userMessageId,
+    startTurnPhase,
+    completeTurnPhase,
+    setStartedTarget,
+    onFailureHandled,
+  } = context;
+  let turnMachine = context.turnMachine;
+  let phaseStartedAt: number;
+  let loopState: RegularTurnLoopState | undefined;
+  let shouldRetryTitleGenerationAfterTurn = false;
+  try {
+    phaseStartedAt = startTurnPhase("user_prompt_hooks");
+    const userPromptHookResult: HookRunResult = options?.skipUserPromptSubmitHooks
+      ? { additionalContexts: [] }
+      : await this.runUserPromptSubmitHooks(input, attachments, turnTraceContext, turnAbortSignal);
+    completeTurnPhase("user_prompt_hooks", phaseStartedAt);
+    if (userPromptHookResult.preventContinuation) {
+      const response =
+        userPromptHookResult.stopReason ?? "Prompt blocked by UserPromptSubmit hook.";
+      // Live control.steerable clear before TurnComplete (≠ Ready invent).
+      await clearActiveTurnSteerable(this, activeTurn, turnTraceContext);
+      turnMachine = new TurnMachineImpl(turnMachine.complete(response, "success"));
+      const turnUsage = createModelUsageSummaryFromEvents(events);
+      const completeEvent = this.createEvent(
+        SessionEventType.TurnComplete,
+        {
+          response,
+          tokenCount: 0,
+          usage: turnUsage,
+          toolCallCount: 0,
+          duration: Date.now() - turnMachine.state.startedAt.getTime(),
+          resultType: "success",
+          cacheStats: this.messageHistory.getCacheStats(),
+          inputId: options?.inputId,
+        },
+        turnTraceContext,
+      );
+      await this.appendEvent(completeEvent, turnTraceContext);
+      events.push(completeEvent);
+      await recordTurnUsageFact(this, {
+        completedAt: Date.now(),
+        events,
+        startedAt: turnStartedAtMs,
+        status: "completed",
+        traceContext: turnTraceContext,
+        turnId,
+      });
+      this.turnNumber++;
+      const projection = await this.rebuildProjection();
+      await this.accountTargetTurnCompletion({
+        inputID: targetRunInputID,
+        startedAtMs: turnStartedAtMs,
+        startedTarget,
+        traceContext: turnTraceContext,
+        usage: turnUsage,
+      });
+      return {
+        response,
+        turnId,
+        traceId,
+        usage: turnUsage,
+        events,
+        projection,
+      };
+    }
+    shouldRetryTitleGenerationAfterTurn = await prepareRegularTurnInput.call(this, {
+      turnId,
+      input,
+      attachments,
+      options,
+      turnTraceContext,
+      turnAbortSignal,
+      userMessageId,
+      displayInput,
+      userPromptHookResult,
+    });
+
+    this.messageHistory.setCacheMiss();
+    const loopModel = submissionModel ?? admittedModel;
+    if (!loopModel) {
+      throw new Error("Turn model was not created before execution");
+    }
+    loopState = {
+      activeTurn,
+      ...(options?.automationId ? { automationId: options.automationId } : {}),
+      // 闲时派发轮的身份进入 loop state，供工具执行边界 deny OffPeakCreate。
+      ...(options?.offPeakTaskId ? { offPeakTaskId: options.offPeakTaskId } : {}),
+      anomalyWarningsInjected: 0,
+      backgroundSubagentResultConsumed: options?.backgroundSubagentResultConsumed === true,
+      workflowResultConsumed: options?.workflowResultConsumed === true,
+      currentUserMessageId: userMessageId,
+      events,
+      input,
+      modelResponse: "",
+      model: loopModel,
+      ...(options?.modelExecution?.selectionScope === "execution"
+        ? { modelSelectionScope: "execution" as const }
+        : {}),
+      ...(options?.modelExecution?.subagents && options.intent?.modelSelection
+        ? {
+            subagentModelOverride: {
+              selection: options.intent.modelSelection,
+              requestDependencies: options.modelExecution.requestDependencies,
+              background: options.modelExecution.subagents.background,
+            },
+          }
+        : {}),
+      modelStepCount: 0,
+      historyRoundCount: 0,
+      reactiveCompactAttemptedInCurrentModelStep: false,
+      repeatedToolCallSignature: undefined,
+      repeatedToolCallStreakCount: 0,
+      stopHookContinuationCount: 0,
+      streamRecoveryRetryCount: 0,
+      tokenCount: 0,
+      toolCallCount: 0,
+      turnRequestState: {
+        // Turn 只借一次 canonical 成员集合，之后由显式 commit 推进；entry 本身
+        // 遵循 MessageHistory 的不可变约定。
+        entries: [...this.messageHistory.borrowReadOnlyRuntimeEntries()],
+        outputTokenContinuationCount: 0,
+      },
+      toolDisallowlist: options?.toolDisallowlist,
+      traceId,
+      turnAbortSignal,
+      turnId,
+      turnMachine,
+      turnOutputStyle: admittedOutputStyle,
+      turnTraceContext,
+      userMessageId,
+    };
+
+    openGoalStateChangeReminderDeferral(activeTurn);
+    phaseStartedAt = startTurnPhase("regular_turn_loop");
+    try {
+      await runRegularTurnLoop.call(this, loopState);
+      completeTurnPhase("regular_turn_loop", phaseStartedAt);
+    } finally {
+      finishOutputTokenRecovery(loopState.turnRequestState);
+      await closeGoalStateChangeReminderDeferral.call(this, activeTurn, turnTraceContext);
+    }
+    turnMachine = loopState.turnMachine;
+
+    return await completeRegularTurn.call(this, {
+      options,
+      turnTraceContext,
+      events,
+      turnStartedAtMs,
+      targetRunInputID,
+      startedTarget,
+      turnMachine,
+      loopState,
+      userMessageId,
+      shouldRetryTitleGenerationAfterTurn,
+      displayInput,
+      turnId,
+      traceId,
+    });
+  } catch (error) {
+    onFailureHandled();
+    return await failRegularTurn.call(this, {
+      options,
+      turnTraceContext,
+      events,
+      turnStartedAtMs,
+      targetRunInputID,
+      startedTarget,
+      turnMachine,
+      loopState,
+      userMessageId,
+      turnId,
+      activeTurn,
+      turnAbortSignal,
+      error,
+      setStartedTarget,
+    });
+  }
+}
