-function materializeCommandMetadataRoot(
-  input: { dataPath: string; diagnostics: PluginDiagnostic[]; loaded: LoadedPlugin },
-  priority: number,
-): CustomCommandRoot | null {
-  const spec = input.loaded.manifest.commands;
-  if (!isRecord(spec)) return null;
-
-  const generatedRoot = join(input.dataPath, "generated-commands");
-  const commands = new Map<string, string>();
-
-  for (const [rawName, rawMetadata] of Object.entries(spec)) {
-    if (!isRecord(rawMetadata)) {
-      input.diagnostics.push({
-        code: "plugin_manifest_invalid",
-        message: `Plugin command metadata must be an object: ${rawName}`,
-        path: input.loaded.manifestPath,
-        pluginId: input.loaded.id,
-        severity: "error",
-      });
-      continue;
-    }
-
-    const name = normalizeGeneratedCommandName(rawName);
-    if (!name) {
-      input.diagnostics.push({
-        code: "plugin_manifest_invalid",
-        message: `Invalid plugin command name: ${rawName}`,
-        path: input.loaded.manifestPath,
-        pluginId: input.loaded.id,
-        severity: "error",
-      });
-      continue;
-    }
-
-    const source = typeof rawMetadata.source === "string" ? rawMetadata.source : undefined;
-    const content = typeof rawMetadata.content === "string" ? rawMetadata.content : undefined;
-    if ((source && content) || (!source && !content)) {
-      input.diagnostics.push({
-        code: "plugin_manifest_invalid",
-        message: `Plugin command '${rawName}' must provide exactly one of source or content`,
-        path: input.loaded.manifestPath,
-        pluginId: input.loaded.id,
-        severity: "error",
-      });
-      continue;
-    }
-
-    let markdown = content;
-    if (source) {
-      const sourcePath = resolveInside(input.loaded.rootPath, trimRelativePrefix(source));
-      if (!sourcePath) {
-        input.diagnostics.push({
-          code: "plugin_component_path_invalid",
-          message: `Plugin command source escapes plugin root: ${source}`,
-          path: input.loaded.manifestPath,
-          pluginId: input.loaded.id,
-          severity: "error",
-        });
-        continue;
-      }
-      if (!fileExists(sourcePath)) {
-        input.diagnostics.push({
-          code: "plugin_component_path_invalid",
-          message: `Plugin command source file not found: ${source}`,
-          path: sourcePath,
-          pluginId: input.loaded.id,
-          severity: "error",
-        });
-        continue;
-      }
-      markdown = readFileSync(sourcePath, "utf8");
-    }
-    if (markdown === undefined) continue;
-
-    commands.set(`${name}.md`, applyCommandMetadataFrontmatter(markdown, rawMetadata));
-  }
-
-  // This reserved directory is a derived manifest projection, not plugin user data.
-  // Rebuild it so an update/reinstall cannot rediscover removed or renamed commands.
-  // Reject redirected parents; deleting an entry below is never allowed to follow a link.
-  for (const path of [dirname(input.dataPath), input.dataPath, generatedRoot]) {
-    const entry = lstatSync(path, { throwIfNoEntry: false });
-    if (entry && !entry.isDirectory()) {
-      input.diagnostics.push({
-        code: "plugin_component_path_invalid",
-        message:
-          "Generated plugin commands require an ordinary directory, not a file or symbolic link",
-        path,
-        pluginId: input.loaded.id,
-        severity: "error",
-      });
-      return null;
-    }
-  }
-  replaceGeneratedCommands(generatedRoot, commands);
-
-  return commands.size > 0
-    ? {
-        path: generatedRoot,
-        plugin: createHookPluginContext(input.loaded, input.dataPath),
-        priority,
-        scope: input.loaded.source === "official" ? "system" : "user",
-        source: "plugin",
-      }
-    : null;
-}
-
-function replaceGeneratedCommands(root: string, commands: ReadonlyMap<string, string>): void {
-  mkdirSync(dirname(root), { recursive: true });
-  const stage = mkdtempSync(join(dirname(root), ".generated-commands-"));
-  const next = join(stage, "next");
-  const previous = join(stage, "previous");
-  let preservePrevious = false;
-  try {
-    mkdirSync(next);
-    for (const [fileName, markdown] of commands) {
-      writeFileSync(join(next, fileName), markdown, { encoding: "utf8", flag: "wx" });
-    }
-    const hadPrevious = lstatSync(root, { throwIfNoEntry: false }) !== undefined;
-    if (hadPrevious) renameSync(root, previous);
-    try {
-      renameSync(next, root);
-    } catch (error) {
-      if (hadPrevious) {
-        try {
-          renameSync(previous, root);
-        } catch (rollbackError) {
-          // Keep the last complete derived copy available for recovery on a failed rollback.
-          preservePrevious = true;
-          throw new AggregateError(
-            [error, rollbackError],
-            `Generated commands retained at ${previous}`,
-          );
-        }
-      }
-      throw error;
-    }
-  } finally {
-    // Only this invocation's staging directory is removed; user data is never swept.
-    if (!preservePrevious) rmSync(stage, { recursive: true, force: true });
-  }
-}
