+      assert.ok(started.ok, JSON.stringify(started));
+      assert.equal((await waitForRun(app, started.runId)).status, "completed");
+      const artifacts = await app.listDynamicWorkflowRunArtifacts?.({ runId: started.runId });
+      assert.equal(artifacts?.length, ARTIFACT_CAPS.maxArtifactsPerRun);
+      const versions = Array.from(
+        { length: ARTIFACT_CAPS.maxVersionsPerArtifact + 1 },
+        (_, i) => `artifact.markdown("report", "${i}", ${i === 0 ? "{primary:true}" : "{}"})`,
+      );
+      await h.saveWorkflow(
+        app,
+        "version-cap",
