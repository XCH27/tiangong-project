+} from "./helpers/native-whiteboard-fork-fixture.js";
+
+function nativeReceipt(messages: MessageWithParts[]) {
+  const receipt = messages.findLast((message) =>
+    message.parts.some(
+      (part) =>
+        part.type === "tool" &&
+        part.tool === "WhiteboardUpdate" &&
+        part.state.status === "completed",
+    ),
+  );
+  assert.ok(receipt && receipt.info.role === "assistant");
+  return receipt;
+}
+for (const kind of ["core-stable-boundary", "workspace-message", "workspace-checkpoint"] as const) {
+  test(`native ${kind} fork cold-resumes, keeps parent journals, and creates only child-owned checkpoints`, async () => {
+    const scenario = await nativeForkFixture(),
+      { f } = scenario;
+    try {
+      const board = drawing();
+      const first = await save(f.runtime, board),
+        firstBytes = await scenario.bytes(board.id);
+      const second = await save(
+        f.runtime,
+        { ...board, name: "Parent later drawing" },
+        first.fileRevision,
+      );
+      const secondBytes = await scenario.bytes(board.id);
+      const parentMessages = await f.store.messages({ sessionID: f.runtime.getSessionId() });
+      const receipt = nativeReceipt(parentMessages);
+      const checkpoints = await f.runtime.listWorkspaceCheckpoints();
+      assert.equal(checkpoints.length, 2);
+      const parentJournal = await f.store.sessionEntries({
+        sessionID: f.runtime.getSessionId(),
+        type: "native/whiteboard_checkpoint",
+      });
+      assert.equal(parentJournal.length, 2);
+      const result =
+        kind === "core-stable-boundary"
+          ? await f.runtime.forkStableConversationAtMessage({
+              sourceCommandId: `native-${kind}`,
+              goalBoundary: { kind: "none" },
+              // The raw segment is real SQLite evidence; product hints are authored Core inputs,
+              // so this case does not claim acceptance by the public V4 target resolver.
+              target: {
+                productTurnId: String(receipt.info.anchor?.productTurnId ?? receipt.info.id),
+                transcriptTurnId: String(receipt.info.anchor?.turnId ?? receipt.info.id),
+                orderedMessageIds: parentMessages
+                  .slice(-2)
+                  .map((message) => String(message.info.id)),
+                boundaryMessageId: String(receipt.info.id),
+              },
+            })
+          : await f.runtime.forkWorkspaceFromCheckpoint(
+              kind === "workspace-message"
+                ? { targetMessageId: receipt.info.id }
+                : { targetCheckpointId: checkpoints[0]!.checkpointId },
+            );
+      const childMessages = await f.store.messages({ sessionID: result.forkedSessionId });
+      assert.ok(childMessages.length > 0);
+      assert.ok(
+        childMessages.every((message) => message.info.sessionID === result.forkedSessionId),
+      );
+      assert.ok(
+        childMessages.every(
+          (message) => !parentMessages.some((parent) => parent.info.id === message.info.id),
+        ),
+      );
+      assert.equal(
+        (
+          await f.store.sessionEntries({
+            sessionID: result.forkedSessionId,
+            type: "native/whiteboard_checkpoint",
+          })
+        ).length,
+        0,
+        "Parent native journals cannot become child actions",
+      );
+      assert.equal(
+        (
+          await f.store.sessionEntries({
+            sessionID: result.forkedSessionId,
+            type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+          })
+        ).length,
+        0,
+      );
+      assert.equal(
+        await scenario.bytes(board.id),
+        kind === "workspace-checkpoint" ? firstBytes : secondBytes,
+      );
+      assert.deepEqual(
+        await f.store.sessionEntries({
+          sessionID: f.runtime.getSessionId(),
+          type: "native/whiteboard_checkpoint",
+        }),
+        parentJournal,
+      );
+      const writesAtFork = scenario.writes;
+      await scenario.reopen();
+      const child = await scenario.child(result.forkedSessionId);
+      assert.equal((await child.listWorkspaceCheckpoints()).length, 0);
+      const read = completed(
+        await child.performWhiteboardControl({ operation: "read", input: { boardId: board.id } }),
+      );
+      assert.equal(
+        read.document.board.name,
+        kind === "workspace-checkpoint" ? board.name : second.document.board.name,
+      );
+      const childSave = await save(
+        child,
+        { ...read.document.board, name: "Child-owned drawing" },
+        read.fileRevision,
+      );
+      const childEntries = await f.store.sessionEntries({
+        sessionID: result.forkedSessionId,
+        type: "native/whiteboard_checkpoint",
+      });
+      assert.equal(childEntries.length, 1);
+      assert.match(
+        childEntries[0]!.id,
+        new RegExp(`^${result.forkedSessionId}:native-whiteboard:`),
+      );
+      assert.equal(childEntries[0]!.data.filePath, join(f.dir, whiteboardRelativePath(board.id)));
+      const childStored = await f.store.messages({ sessionID: result.forkedSessionId });
+      const childCheckpoint = (
+        await f.store.sessionEntries({
+          sessionID: result.forkedSessionId,
+          type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+        })
+      )[0]!;
+      const childPayload = parseCheckpointCreatedPayload(childCheckpoint.data.payload);
+      assert.ok(childStored.some((message) => message.info.id === childPayload.messageId));
+      assert.ok(childStored.some((message) => message.info.id === childPayload.toolMessageId));
+      assert.ok(!parentMessages.some((message) => message.info.id === childPayload.messageId));
+      assert.equal(scenario.writes, writesAtFork + 1);
+      const committed = await scenario.bytes(board.id);
+      await scenario.reopen();
+      const coldChild = await scenario.child(result.forkedSessionId);
+      assert.equal((await coldChild.listWorkspaceCheckpoints()).length, 1);
+      assert.equal(
+        (await coldChild.getSessionEventStore().getEvents(result.forkedSessionId)).filter(
+          (event) => event.type === SessionEventType.CheckpointCreated,
+        ).length,
+        1,
+      );
+      assert.equal(await scenario.bytes(board.id), committed);
+      assert.equal(scenario.writes, writesAtFork + 1);
+      assert.deepEqual(
+        await f.store.sessionEntries({
+          sessionID: f.runtime.getSessionId(),
+          type: "native/whiteboard_checkpoint",
+        }),
+        parentJournal,
+      );
+      assert.equal(
+        completed(
+          await coldChild.performWhiteboardControl({
+            operation: "read",
+            input: { boardId: board.id },
+          }),
+        ).fileRevision.hash,
+        childSave.fileRevision.hash,
+      );
+      assert.equal(f.requests.length, 0);
+      assert.equal(scenario.childFactories, 0);
+      assert.equal(f.permissionCalls, 2);
+      assert.equal(scenario.childPermissions, 1);
+    } finally {
+      await scenario.close();
+    }
+  });
+}
+
+test("actual App fork facade and SQLite reopen retain native child receipt ownership without model calls", async () => {
+  const { appModelFixture } =
+    await import("../../bootstrap/test/helpers/app-model-completion-fixture.js");
+  const { SqliteSessionStore } =
