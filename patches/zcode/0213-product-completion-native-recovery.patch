diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-return-resolve-prompt-attachment-preview-source.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-return-resolve-prompt-attachment-preview-source.ts
