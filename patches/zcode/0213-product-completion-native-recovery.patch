+
+test("original projection failure retains the draft and refuses native write dispatch", async () => {
+  const f = fresh(),
+    projection = nativePresentationAgent();
+  let effects = 0;
+  projection.fail(new Error("Owned subscription unavailable"));
+  const agent = {
+    ...projection.agent,
+    performWhiteboardControl: async () => {
+      effects++;
+      throw new Error("Unreachable");
+    },
+  } as unknown as IZCodeAgentService;
+  assert.equal(
+    await saveNativeWhiteboardDraft({
+      target: f.target,
+      agent,
+      sessionId: "owned-session",
+      showSession() {},
+    }),
+    false,
+  );
+  assert.equal(effects, 0);
+  assert.equal(store.getState().getBoard(f.target), f.board);
+  const native = store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!;
+  assert.equal(native.committed, undefined);
+  assert.ok(native.retry);
+  assert.match(native.error!, /Owned subscription unavailable/);
+});
+
+test("cancelled original creation handles its late rejected RPC without touching a newer pending Save", async () => {
+  const f = fresh(),
+    creation = Promise.withResolvers<never>(),
+    first = new AbortController();
+  const agent = service(async (command) => receipt(command));
+  agent.sendConversationCommandV4 = () => creation.promise;
+  const stopped = saveNativeWhiteboardDraft({
+    target: f.target,
+    agent,
+    abortSignal: first.signal,
+    showSession() {},
+  });
+  await tick();
+  first.abort();
+  assert.equal(await stopped, false);
+  const originalDraft = store.getState().getBoard(f.target);
+  const second = new AbortController(),
+    effect = Promise.withResolvers<void>();
+  let dispatched = false;
+  agent.performWhiteboardControl = async ({ command }) => {
+    await effect.promise;
+    return receipt(command);
+  };
+  const saving = saveNativeWhiteboardDraft({
+    target: f.target,
+    agent,
+    sessionId: "new-owner-session",
+    abortSignal: second.signal,
+    onDispatch: () => {
+      dispatched = true;
+    },
+    showSession() {},
+  });
+  await tick();
+  assert.equal(dispatched, true);
+  const newer =
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending;
+  creation.reject(new Error("Owned late creation rejection"));
+  first.abort();
+  await tick();
+  assert.equal(
+    store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!.pending,
+    newer,
+  );
+  assert.equal(store.getState().getBoard(f.target), originalDraft);
+  effect.resolve();
+  assert.equal(await saving, true);
+});
+
+test("an already stopped intent does not send an original create command", async () => {
+  const f = fresh(),
+    controller = new AbortController();
+  let creates = 0;
+  const agent = service(async (command) => receipt(command));
+  agent.sendConversationCommandV4 = async () => {
+    creates++;
+    throw new Error("Unreachable creation");
+  };
+  controller.abort();
+  assert.equal(
+    await saveNativeWhiteboardDraft({
+      target: f.target,
+      agent,
+      abortSignal: controller.signal,
