diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection-permission-interactions.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection-permission-interactions.ts
