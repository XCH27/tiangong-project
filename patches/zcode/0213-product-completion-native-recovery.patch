+import type { V4CommandCoreHost } from "../zcode-protocol-v4/commands/types.js";
+
+import { afterStateMutation } from "./server-operations.js";
+import type {
+  ZCodeProtocolAgentServerContext,
+  ZCodeProtocolSessionRecord,
+} from "./server-types.js";
+
+export function createV4CoreHostAfterLegacyStateMutation(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+  readonly autoDrainV4QueueIfReady: (record: ZCodeProtocolSessionRecord) => Promise<void>;
+}): V4CommandCoreHost["afterLegacyStateMutation"] {
+  return (
+    {
+      afterLegacyStateMutation: async (record, reason) => {
+        await afterStateMutation(
+          factoryBindings.context,
+          record as ZCodeProtocolSessionRecord,
+          reason,
+        );
+        await factoryBindings.autoDrainV4QueueIfReady(record as ZCodeProtocolSessionRecord);
+      },
+    } satisfies Pick<V4CommandCoreHost, "afterLegacyStateMutation">
+  ).afterLegacyStateMutation;
+}
