+import type { ToolExecutionContext } from "../types.js";
+import type { WorkspaceCheckpointArtifact } from "@zcode/contracts";
+import type { WhiteboardUpdateInput } from "@zcode/shared";
+import { captureEffectiveWhiteboardInput } from "./whiteboard-effective-input.js";
+
+export const NATIVE_WHITEBOARD_CHECKPOINT_ENTRY = "native/whiteboard_checkpoint";
+
+/** Prepared before the native file changes; original Session journal + derived ArtifactStore only. */
+export async function prepareWhiteboardCheckpoint(context: ToolExecutionContext, input: {
+  mutationId: string; mutationDigest: string; filePath: string; before: string | null; after: string;
+  expectedHash?: string;
+  effectiveInput: WhiteboardUpdateInput;
+}) {
+  if (!context.artifactStore || !context.sessionStore?.saveSessionEntry || !context.sessionStore.sessionEntries)
+    throw new Error("Native whiteboard updates require durable Session checkpoints");
+  const id = `${context.sessionId}:native-whiteboard:${input.mutationId}`;
+  const existing = (await context.sessionStore.sessionEntries({ sessionID: context.sessionId,
+    type: NATIVE_WHITEBOARD_CHECKPOINT_ENTRY })).find(entry => entry.id === id);
+  if (existing) {
+    const data = existing.data as { filePath?: string; mutationDigest?: string; expectedHash?: string; snapshotRef?: string };
+    if (data.filePath !== input.filePath || data.mutationDigest !== input.mutationDigest || data.expectedHash !== input.expectedHash || !data.snapshotRef)
+      throw new Error("Native mutation identity cannot be reused for another file or expected revision");
+    const effectiveInputs = await captureEffectiveWhiteboardInput(context,
+      (existing.data as { effectiveInputs?: unknown }).effectiveInputs, input.effectiveInput);
+    await context.sessionStore.saveSessionEntry({ ...existing, touchSession: false,
+      data: { ...existing.data as object, effectiveInputs } });
+    context.abortSignal.throwIfAborted();
+    return { journalId: id, snapshotRef: data.snapshotRef };
+  }
+  const effectiveInputs = await captureEffectiveWhiteboardInput(context, undefined, input.effectiveInput);
+  const artifact: WorkspaceCheckpointArtifact = {
+    createdAt: new Date().toISOString(), kind: "workspace_file_before_change", version: 1,
+    toolCallId: context.toolCallId, toolName: "WhiteboardUpdate",
+    files: [{ path: input.filePath, beforeContent: input.before, existedBefore: input.before !== null,
+      afterContent: input.after, afterContentLength: input.after.length, structuredPatch: [] }],
+  };
+  const stored = await context.artifactStore.writeToolResultArtifact({
+    sessionId: context.sessionId, turnId: context.turnId, toolCallId: context.toolCallId, toolName: "WhiteboardUpdate",
+    content: JSON.stringify(artifact), contentType: "application/vnd.zcode.workspace-checkpoint+json",
+    retention: "session",
+  }, { signal: context.abortSignal });
+  context.abortSignal.throwIfAborted();
+  const now = Date.now();
+  await context.sessionStore.saveSessionEntry({ id, sessionID: context.sessionId, type: NATIVE_WHITEBOARD_CHECKPOINT_ENTRY,
+    touchSession: false, time: { created: now, updated: now },
+    data: { filePath: input.filePath, mutationId: input.mutationId, mutationDigest: input.mutationDigest,
+      expectedHash: input.expectedHash, snapshotRef: stored.uri, toolCallId: context.toolCallId,
+      turnId: context.turnId, status: "prepared", effectiveInputs },
+  });
+  context.abortSignal.throwIfAborted();
+  return { journalId: id, snapshotRef: stored.uri };
+}
+
+export async function observeWhiteboardCheckpoint(context: ToolExecutionContext, mutationId: string, filePath: string, digest: string,
+  effectiveInput: WhiteboardUpdateInput) {
+  const id = `${context.sessionId}:native-whiteboard:${mutationId}`;
+  const entry = (await context.sessionStore?.sessionEntries?.({ sessionID: context.sessionId,
+    type: NATIVE_WHITEBOARD_CHECKPOINT_ENTRY }))?.find(item => item.id === id);
+  const data = entry?.data as { filePath?: string; mutationDigest?: string; snapshotRef?: string } | undefined;
+  if (data?.filePath !== filePath || data.mutationDigest !== digest || !data.snapshotRef || !entry) return undefined;
+  const effectiveInputs = await captureEffectiveWhiteboardInput(context,
+    (entry.data as { effectiveInputs?: unknown }).effectiveInputs, effectiveInput);
+  await context.sessionStore!.saveSessionEntry!({ ...entry, touchSession: false,
+    data: { ...entry.data as object, effectiveInputs } });
+  context.abortSignal.throwIfAborted();
+  return { journalId: id, snapshotRef: data.snapshotRef };
+}
