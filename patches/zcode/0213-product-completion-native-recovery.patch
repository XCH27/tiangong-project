+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import test from "node:test";
+import { createMcpAdapter } from "../src/mcp/index.js";
+import type { McpServerConfig } from "@zcode/contracts";
+
+test("public MCP keeps one connection owner through reconfigure, stale completion and caller Stop", async () => {
+  let releaseOld!: () => void;
+  let markOld!: () => void;
+  const oldSeen = new Promise<void>((resolve) => {
+    markOld = resolve;
+  });
+  const oldGate = new Promise<void>((resolve) => {
+    releaseOld = resolve;
+  });
+  let dispatched = 0;
+  const server = createServer(async (request, response) => {
+    if (request.method !== "POST") {
+      response.writeHead(405).end();
+      return;
+    }
+    let body = "";
+    for await (const chunk of request) body += chunk;
+    const rpc = JSON.parse(body);
+    if (rpc.id == null) {
+      response.writeHead(202).end();
+      return;
+    }
+    let result: unknown;
+    if (rpc.method === "initialize") {
+      result = {
+        protocolVersion: "2025-03-26",
+        capabilities: { tools: {}, resources: {} },
+        serverInfo: { name: "owned-fixture", version: "1" },
+      };
+    } else if (rpc.method === "tools/list") {
+      if (request.url === "/old") {
+        markOld();
+        await oldGate;
+      }
+      result = {
+        tools: [
+          {
+            name: request.url === "/old" ? "old" : "current",
+            inputSchema: { type: "object", properties: {} },
+          },
+        ],
+      };
+    } else if (rpc.method === "tools/call") {
+      dispatched++;
+      if (rpc.params.arguments?.wait)
+        await new Promise<void>((resolve) => response.once("close", resolve));
+      result = { content: [{ type: "text", text: "current-response" }] };
+    } else if (rpc.method === "resources/read") {
+      result = { contents: [{ uri: rpc.params.uri, text: "current-resource" }] };
+    } else if (rpc.method === "ping") result = {};
+    else {
+      response.writeHead(400).end();
+      return;
+    }
+    if (!response.destroyed)
+      response
+        .writeHead(200, { "content-type": "application/json" })
+        .end(JSON.stringify({ jsonrpc: "2.0", id: rpc.id, result }));
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const address = server.address();
+  assert.ok(address && typeof address !== "string");
+  const url = `http://127.0.0.1:${address.port}`;
+  const old: McpServerConfig = {
+    type: "http",
+    url: `${url}/old`,
+    protocolVersion: "legacy",
+    timeoutMs: 2000,
+  };
+  const current: McpServerConfig = { ...old, url: `${url}/current` };
+  const adapter = createMcpAdapter({ env: {}, workingDirectory: "/owned-fixture" });
+  const prototype = Object.getPrototypeOf(adapter);
+  try {
+    const stale = adapter.connectServer("fixture", old);
+    await oldSeen;
+    const connected = await adapter.connectServer("fixture", current);
+    assert.equal(connected.status, "connected");
+    releaseOld();
+    await stale;
+    assert.equal(Object.getPrototypeOf(adapter), prototype);
+    assert.equal((await adapter.status()).fixture.status, "connected");
+    assert.deepEqual(
+      (await adapter.listTools()).map((tool) => tool.name),
+      ["mcp__fixture__current"],
+    );
+    await assert.rejects(
+      adapter.callTool(
+        { serverName: "fixture", toolName: "current", arguments: {} },
+        { expectedServerConfig: old },
+      ),
+      /configuration changed/,
+    );
+    assert.equal(dispatched, 0);
+    const result = await adapter.callTool(
+      { serverName: "fixture", toolName: "current", arguments: {} },
+      { expectedServerConfig: current },
+    );
+    assert.equal(result.content[0]?.type, "text");
+    assert.equal(dispatched, 1);
+    assert.ok(adapter.readResource);
+    const resource = await adapter.readResource("fixture", "fixture://current");
+    assert.equal(resource.contents[0]?.text, "current-resource");
+    const controller = new AbortController();
+    const stopped = adapter.callTool(
+      { serverName: "fixture", toolName: "current", arguments: { wait: true } },
+      { signal: controller.signal },
+    );
+    while (dispatched < 2) await new Promise((resolve) => setImmediate(resolve));
+    controller.abort();
+    await assert.rejects(stopped);
+    assert.equal((await adapter.status()).fixture.status, "connected");
+    await adapter.disconnectServer("fixture");
+    assert.equal((await adapter.status()).fixture.status, "disconnected");
+  } finally {
+    releaseOld();
+    await adapter.close();
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
