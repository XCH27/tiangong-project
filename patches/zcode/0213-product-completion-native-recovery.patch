diff --git a/packages/ui/src/hooks/useNativeWhiteboardControls.ts b/packages/ui/src/hooks/useNativeWhiteboardControls.ts
new file mode 100644
index 00000000..fdcffbd8
--- /dev/null
+++ b/packages/ui/src/hooks/useNativeWhiteboardControls.ts
@@ -0,0 +1,259 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { IZCodeAgentService } from "@zcode/services";
+import type { WhiteboardControlResult } from "@zcode/shared";
+import { useWhiteboardStore } from "../store/whiteboardStore.js";
+import { buildWhiteboardWorkspaceKey } from "../lib/whiteboard.js";
+import {
+  ensureNativeWhiteboardSession,
+  readNativeWhiteboardProjection,
+} from "../lib/nativeWhiteboardControl.js";
+import {
+  saveNativeWhiteboardDraft,
+  type NativeWhiteboardActionTarget,
+  type ShowNativeWhiteboardSession,
+} from "../lib/nativeWhiteboardDraft.js";
+import { hasWhiteboardGesture } from "../lib/whiteboardGesture.js";
+
+export function useNativeWhiteboardControls(input: {
+  target: NativeWhiteboardActionTarget;
+  agent: IZCodeAgentService;
+  sessionId?: string | null;
+  rpcReady: boolean;
+  showSession: ShowNativeWhiteboardSession;
+}) {
+  const { target, agent, sessionId, rpcReady, showSession } = input;
+  // A distinct transition token fences A→B→A, while the original store owns all draft data.
+  const owner = useMemo(
+    () => ({}),
+    [
+      target.workspacePath,
+      target.workspaceIdentity,
+      target.remoteSessionId,
+      target.boardId,
+      agent,
+      rpcReady,
+    ],
+  );
+  const currentOwner = useRef(owner);
+  currentOwner.current = owner;
+  const readOwner = useMemo(() => ({}), [owner, sessionId]);
+  const currentReadOwner = useRef(readOwner);
+  const previousReadOwner = useRef(readOwner);
+  if (currentReadOwner.current !== readOwner) {
+    previousReadOwner.current = currentReadOwner.current;
+    currentReadOwner.current = readOwner;
+  }
+  const currentSession = useRef(sessionId);
+  currentSession.current = sessionId;
+  const ownedSave = useRef<
+    | {
+        requestId: string;
+        sessionId?: string;
+      }
+    | undefined
+  >(undefined);
+  const readGeneration = useRef(0);
+  const listGeneration = useRef(0);
+  const pendingObserver = useRef<{ owner: object; token: object } | undefined>(undefined);
+  const [error, setError] = useState<string>();
+  const [busy, setBusy] = useState(false);
+  const current = useCallback(() => currentOwner.current === owner, [owner]);
+  const currentRead = useCallback(
+    () => current() && currentReadOwner.current === readOwner,
+    [current, readOwner],
+  );
+  const currentReadForSession = useCallback(
+    (admittedId?: string) =>
+      currentRead() ||
+      (sessionId == null &&
+        admittedId !== undefined &&
+        current() &&
+        currentSession.current === admittedId &&
+        previousReadOwner.current === readOwner),
+    [current, currentRead, readOwner, sessionId],
+  );
+  const key = buildWhiteboardWorkspaceKey(target);
+  const native = useWhiteboardStore((state) => state.workspaces[key]?.nativeById?.[target.boardId]);
+  const frozen = useWhiteboardStore((state) => state.nativeCloseFrozen);
+  useEffect(() => {
+    useWhiteboardStore.getState().rememberNativeWorkspace(target);
+    setError(undefined);
+    setBusy(false);
+    return () => {
+      readGeneration.current++;
+      listGeneration.current++;
+      const pending =
+        useWhiteboardStore.getState().workspaces[key]?.nativeById?.[target.boardId]?.pending;
+      if (pending?.requestId === ownedSave.current?.requestId) pending?.cancel?.();
+      if (ownedSave.current)
+        useWhiteboardStore.getState().failNativeSave({
+          ...target,
+          requestId: ownedSave.current.requestId,
+          error: "whiteboard.contextChanged",
+        });
+      ownedSave.current = undefined;
+    };
+  }, [owner]);
+  useEffect(() => {
+    // Session changes release only the old read presentation; the Save's own admission
+    // and any exact one-step read admission retain their original operation identity.
+    setBusy(false);
+    setError(undefined);
+  }, [readOwner]);
+  const prepare = useCallback(async () => {
+    if (!rpcReady) throw new Error("whiteboard.hostUnavailable");
+    const id = await ensureNativeWhiteboardSession(agent, target, sessionId);
+    if (!currentRead()) throw new Error("whiteboard.contextChanged");
+    showSession(target, id);
+    return id;
+  }, [agent, target, sessionId, rpcReady, currentRead, showSession]);
+  const save = useCallback(async () => {
+    if (!rpcReady || frozen) {
+      setError("whiteboard.hostUnavailable");
+      return false;
+    }
+    const admittedSession = sessionId ?? null;
+    let requestId: string | undefined;
+    const saveCurrent = () =>
+      current() &&
+      (currentRead() ||
+        (admittedSession === null &&
+          currentSession.current === ownedSave.current?.sessionId &&
+          previousReadOwner.current === readOwner));
+    const succeeded = await saveNativeWhiteboardDraft({
+      target,
+      agent,
+      sessionId,
+      showSession,
+      isCurrent: saveCurrent,
+      onStopError: (failure) => {
+        if (current() && ownedSave.current?.requestId === requestId)
+          setError(failure instanceof Error ? failure.message : String(failure));
+      },
+      onStarted: (id) => {
+        readGeneration.current++;
+        listGeneration.current++;
+        setBusy(false);
+        setError(undefined);
+        requestId = id;
+        ownedSave.current = { requestId: id };
+      },
+      onSessionResolved: (id) => {
+        if (ownedSave.current && ownedSave.current.requestId === requestId && current())
+          ownedSave.current.sessionId = id;
+      },
+    });
+    if (current() && ownedSave.current?.requestId === requestId) ownedSave.current = undefined;
+    return succeeded;
+  }, [target, agent, sessionId, showSession, current, currentRead, readOwner, rpcReady, frozen]);
+  const read = useCallback(
+    async (explicit = true) => {
+      if (!explicit && pendingObserver.current?.owner === owner) return;
+      const observerToken = explicit ? undefined : {};
+      if (observerToken) pendingObserver.current = { owner, token: observerToken };
+      const generation = ++readGeneration.current;
+      let admittedId: string | undefined;
+      const projection =
+        useWhiteboardStore.getState().workspaces[key]?.nativeById?.[target.boardId];
+      const ownsRead = () =>
+        currentReadForSession(admittedId) &&
+        generation === readGeneration.current &&
+        useWhiteboardStore.getState().workspaces[key]?.nativeById?.[target.boardId] === projection;
+      if (currentRead()) {
+        setBusy(true);
+        setError(undefined);
+      }
+      try {
+        const id = explicit ? await prepare() : sessionId;
+        if (!id || !rpcReady) throw new Error("whiteboard.hostUnavailable");
+        admittedId = id;
+        const result = await readNativeWhiteboardProjection(agent, target, id, {
+          boardId: target.boardId,
+        });
+        if (!ownsRead()) return;
+        if (result.status !== "completed")
+          throw new Error(
+            result.status === "failed"
+              ? result.message
+              : `whiteboard.${result.status === "rejected" ? result.reason : "invalidReceipt"}`,
+          );
+        useWhiteboardStore.getState().receiveNativeBoard({
+          ...target,
+          ...result,
+          preserveDraft: hasWhiteboardGesture(target),
+        });
+      } catch (failure) {
+        if (ownsRead()) setError(failure instanceof Error ? failure.message : String(failure));
+      } finally {
+        if (observerToken && pendingObserver.current?.token === observerToken)
+          pendingObserver.current = undefined;
+        if (currentReadForSession(admittedId) && generation === readGeneration.current)
+          setBusy(false);
+      }
+    },
+    [target, agent, sessionId, rpcReady, prepare, currentRead, currentReadForSession, owner],
+  );
+  useEffect(() => {
+    if (native?.pending) {
+      readGeneration.current++;
+      setBusy(false);
+    }
+  }, [native?.pending]);
+  const list = useCallback(async (): Promise<
+    Extract<WhiteboardControlResult, { status: "listed" }> | undefined
+  > => {
+    const generation = ++listGeneration.current;
+    let admittedId: string | undefined;
+    setBusy(true);
+    setError(undefined);
+    try {
+      const id = await prepare();
+      admittedId = id;
+      const result = await readNativeWhiteboardProjection(agent, target, id, { list: true });
+      if (!currentReadForSession(admittedId) || generation !== listGeneration.current) return;
+      if (result.status !== "listed")
+        throw new Error(
+          result.status === "failed"
+            ? result.message
+            : `whiteboard.${result.status === "rejected" ? result.reason : "invalidReceipt"}`,
+        );
+      return result;
+    } catch (failure) {
+      if (currentReadForSession(admittedId) && generation === listGeneration.current)
+        setError(failure instanceof Error ? failure.message : String(failure));
+    } finally {
+      if (currentReadForSession(admittedId) && generation === listGeneration.current)
+        setBusy(false);
+    }
+  }, [agent, target, prepare, currentReadForSession]);
+  const readRef = useRef(read);
+  readRef.current = read;
+  const hasCommitted = Boolean(native?.committed);
+  useEffect(() => {
+    const board = useWhiteboardStore.getState().getBoard(target);
+    if (
+      !sessionId ||
+      !rpcReady ||
+      useWhiteboardStore.getState().nativeCloseFrozen ||
+      (board && !native?.committed)
+    )
+      return;
+    void readRef.current(false);
+    const timer = setInterval(() => {
+      const state = useWhiteboardStore.getState();
+      if (!state.nativeCloseFrozen && !state.workspaces[key]?.nativeById?.[target.boardId]?.pending)
+        void readRef.current(false);
+    }, 5000);
+    return () => clearInterval(timer);
+  }, [owner, sessionId, hasCommitted]);
+  const stop = async () => {
+    const pending = native?.pending;
+    const latestPending =
+      useWhiteboardStore.getState().workspaces[key]?.nativeById?.[target.boardId]?.pending;
+    if (!current() || !pending || latestPending?.requestId !== pending.requestId) return;
+    // Preparation aborts locally. A dispatched request retains this intent until the
+    // original leased projection proves its exact foreground owner, then sends Stop.
+    pending.cancel?.();
+  };
+  return { save, read, list, stop, busy, error: error ?? native?.error, native, frozen, owner };
+}
diff --git a/packages/ui/src/hooks/useNativeWhiteboardWindowClose.ts b/packages/ui/src/hooks/useNativeWhiteboardWindowClose.ts
