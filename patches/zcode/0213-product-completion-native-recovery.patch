+      { activityId: "active-b", nodeId: "b", phase: "other", status: "active" },
+    ],
+    sessionLinks: [],
+    status: "running",
+    updatedAt: "before",
+  } as never;
+  const input = JSON.stringify(snapshot);
+  const repaired = reconcileWorkflowSnapshotForResume(snapshot, {
+    nodeIds: ["a"],
+    timestamp: "repair",
