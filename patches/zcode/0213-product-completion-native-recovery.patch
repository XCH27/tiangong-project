+++ b/packages/ui/test/nativeWhiteboardProjection.test.ts
@@ -0,0 +1,488 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IZCodeAgentService } from "@zcode/services";
+import { V4_WIRE_PROTOCOL_VERSION } from "@zcode/shared/zcode-protocol-v4";
+import type { WhiteboardControlResult } from "@zcode/shared";
+import type { WhiteboardControlInput } from "@zcode/shared";
+import { readNativeWhiteboardProjection } from "../src/lib/nativeWhiteboardControl.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+import { buildWhiteboardWorkspaceKey } from "../src/lib/whiteboard.js";
+import { whiteboardProjectionHookFixture } from "./helpers/whiteboardProjectionHookFixture.js";
+
+type ProjectionRequest = Parameters<IZCodeAgentService["readWhiteboardProjection"]>[0];
+const tick = async () => {
+  for (let i = 0; i < 16; i++) await Promise.resolve();
+};
+function service(handle: (input: ProjectionRequest) => Promise<WhiteboardControlResult>) {
+  return {
+    helloConversationV4: async () => ({
+      kind: "hello",
+      protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+      connectionId: crypto.randomUUID(),
+      clientMode: "web-remote-replayable",
+      deliveryProfile: "replayable",
+      serverTime: Date.now(),
+      capabilities: {
+        nativeDialogs: false,
+        localTerminal: false,
+        binaryFrames: false,
+        compression: "none",
+        independentPlanState: true,
+      },
+      auth: {},
+    }),
+    initializeConversationV4: async () => {},
+    onDynamicConversationFrame: () => () => ({ dispose() {} }),
+    onAgentRuntimeRestarted: () => ({ dispose() {} }),
+    sendConversationCommandV4: async () => {
+      throw new Error("Viewing must not create or dispatch a Session turn");
+    },
+    performWhiteboardControl: async () => {
+      throw new Error("Viewing must not fall back to an actor Read tool");
+    },
+    readWhiteboardProjection: handle,
+  } as unknown as IZCodeAgentService;
+}
+function fresh() {
+  store.setState({ ...store.getInitialState() }, true);
+  const workspacePath = `/owned-projection-${crypto.randomUUID()}`;
+  const board = store.getState().createBoard({ workspacePath, defaultNamePrefix: "Owned" });
+  const target = { workspacePath, boardId: board.id };
+  const receipt = (name: string): Extract<WhiteboardControlResult, { status: "completed" }> => ({
+    status: "completed",
+    document: {
+      schemaVersion: 1,
+      revision: 1,
+      mutationId: crypto.randomUUID(),
+      mutationDigest: "a".repeat(64),
+      board: { ...board, name },
+    },
+    fileRevision: { id: "owned", hash: `sha256:${"a".repeat(64)}` },
+    filePath: ".zcode/whiteboards/owned.json",
+  });
+  store.getState().receiveNativeBoard({ ...target, ...receipt("Committed") });
+  store.getState().resolveNativeConflict(target, "saved");
+  return { target, receipt, key: buildWhiteboardWorkspaceKey(target) };
+}
+
+test("production hook immediate/poll/view/gallery use projection without any actor or creation command", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    calls: ProjectionRequest[] = [],
+    hook = whiteboardProjectionHookFixture();
+  const agent = service(async (input) => {
+    calls.push(input);
+    return "list" in input.input
+      ? { status: "listed", items: [], errors: [], truncated: false }
+      : f.receipt("Current file");
+  });
+  try {
+    const controls = hook.render({
+      target: f.target,
+      agent,
+      sessionId: "original",
+      rpcReady: true,
+      showSession() {},
+    });
+    await tick();
+    hook.tick();
+    await tick();
+    await controls.read();
+    await controls.list();
+    assert.equal(calls.length, 4);
+    assert.ok(calls.every((call) => call.sessionId === "original"));
+    assert.ok(calls.every((call) => !("operationId" in call) && !("command" in call)));
+    assert.equal("list" in calls[3]!.input, true);
+  } finally {
+    hook.close();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("missing or failed projection never falls back to an actor tool", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    missing = service(async () => ({ status: "rejected", reason: "unavailable" }));
+  Reflect.deleteProperty(missing, "readWhiteboardProjection");
+  await assert.rejects(
+    readNativeWhiteboardProjection(missing, f.target, "original", { boardId: f.target.boardId }),
+    /readWhiteboardProjection/,
+  );
+  const refused = service(async () => {
+    throw new Error("Authored disconnected original Host");
+  });
+  await assert.rejects(
+    readNativeWhiteboardProjection(refused, f.target, "original", { boardId: f.target.boardId }),
+    /disconnected original Host/,
+  );
+  t.mock.timers.tick(30_001);
+});
+
+test("late read from a removed Session cannot install a projection after Session ownership changes", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    held = Promise.withResolvers<WhiteboardControlResult>(),
+    hook = whiteboardProjectionHookFixture();
+  const agent = service(() => held.promise);
+  try {
+    hook.render({ target: f.target, agent, sessionId: "old", rpcReady: true, showSession() {} });
+    await tick();
+    hook.render({ target: f.target, agent, sessionId: null, rpcReady: true, showSession() {} });
+    held.resolve(f.receipt("Stale removed Session"));
+    await tick();
+    assert.equal(store.getState().getBoard(f.target)?.name, "Committed");
+    assert.equal(
+      store.getState().workspaces[f.key]!.nativeById![f.target.boardId]!.committed?.document.board
+        .name,
+      "Committed",
+    );
+  } finally {
+    held.resolve(f.receipt("Cleanup"));
+    hook.close();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("A-to-B-to-A service replacement fences the original held reply and dispatches via renewed service", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    held = Promise.withResolvers<WhiteboardControlResult>(),
+    hook = whiteboardProjectionHookFixture();
+  let first = true,
+    renewedCalls = 0;
+  const original = service(async () => {
+    if (first) {
+      first = false;
+      return held.promise;
+    }
+    return f.receipt("Latest A");
+  });
+  const renewed = service(async () => {
+    renewedCalls++;
+    return f.receipt("Renewed B");
+  });
+  try {
+    const input = { target: f.target, sessionId: "original", rpcReady: true, showSession() {} };
+    hook.render({ ...input, agent: original });
+    await tick();
+    hook.render({ ...input, agent: renewed });
+    await tick();
+    assert.equal(renewedCalls, 1);
+    hook.render({ ...input, agent: original });
+    await tick();
+    held.resolve(f.receipt("Stale A"));
+    await tick();
+    assert.equal(store.getState().getBoard(f.target)?.name, "Latest A");
+  } finally {
+    held.resolve(f.receipt("Cleanup"));
+    hook.close();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("successful first Save keeps its original owner when admission shows the newly created Session", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  store.setState({ ...store.getInitialState() }, true);
+  const workspacePath = `/owned-first-save-${crypto.randomUUID()}`;
+  const board = store.getState().createBoard({ workspacePath, defaultNamePrefix: "First Save" });
+  const target = { workspacePath, boardId: board.id },
+    hook = whiteboardProjectionHookFixture();
+  const held = Promise.withResolvers<WhiteboardControlResult>();
+  let admitted: Extract<WhiteboardControlInput, { operation: "update" }> | undefined;
+  let shown = 0,
+    creations = 0;
+  const agent = {
+    ...service(async () => {
+      throw new Error("Uncommitted first Save must not auto read");
+    }),
+    async sendConversationCommandV4({
+      envelope,
+    }: Parameters<IZCodeAgentService["sendConversationCommandV4"]>[0]) {
+      assert.equal(envelope.type, "createSession");
+      creations++;
+      return {
+        status: "accepted",
+        result: { type: "createSession", sessionId: "created-original" },
+      };
+    },
+    async performWhiteboardControl({
+      command,
+    }: Parameters<IZCodeAgentService["performWhiteboardControl"]>[0]) {
+      assert.equal(command.operation, "update");
+      if (command.operation !== "update") throw new Error("Unexpected read actor");
+      admitted = command;
+      return held.promise;
+    },
+  } as unknown as IZCodeAgentService;
+  const showSession = (_target: typeof target, id: string) => {
+    shown++;
+    assert.equal(id, "created-original");
+    hook.render({ target, agent, sessionId: id, rpcReady: true, showSession });
+  };
+  try {
+    const controls = hook.render({ target, agent, sessionId: null, rpcReady: true, showSession });
+    const saving = controls.save();
+    await tick();
+    assert.ok(admitted);
+    held.resolve({
+      status: "completed",
+      document: {
