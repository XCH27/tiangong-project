index 00000000..34f0137c
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/product-projection-delivery.test.ts
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createInMemorySessionEventStore } from "@zcode/contracts";
+import {
+  DELIVERY_PROFILES,
+  conversationTopicFrameSchema,
+  filterConversationRowsForProfile,
+} from "@zcode/shared/zcode-protocol-v4";
+import { fixture, reply, call } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { ConversationTopicPublisher } from "../src/zcode-protocol-v4/conversation-topic-publisher.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { mergeColdConversationEvents } from "../src/zcode-protocol-v4/cold-event-merge.js";
+
+for (const streaming of [false, true]) {
+  test(`actual local Host/SQLite events preserve Desktop and mobile gap replay (${streaming ? "streaming" : "non-streaming"})`, async () => {
+    const store = createInMemorySessionEventStore();
+    const f = await fixture(undefined, streaming, { deps: { eventStore: store } });
+    try {
+      f.steps.push(
+        () => reply("calling controlled tool", [call("original-tool-id", "authored-only")]),
+        () => reply("saved local result"),
+      );
+      const result = await f.runtime.executeTurn("original local request");
+      assert.equal(result.response, "saved local result");
+      assert.equal(f.effects, 1);
+      const events = await store.getEvents("session" as never);
+      assert.ok(events.length > 10);
+      const publisher = new ConversationTopicPublisher("session", "owner-replay", {
+        now: () => 10000,
+      });
+      const desktop = publisher.subscribeReserved({
+        connectionId: "desktop",
+        deliveryProfile: "continuous",
+      });
+      assert.ok(desktop.reservation?.commit());
+      conversationTopicFrameSchema.parse(desktop.reservation!.frame);
+      const middle = Math.floor(events.length / 2);
+      for (const event of events.slice(0, middle)) {
+        publisher.ingest(event);
+        const frame = publisher.flush(desktop.ack.subscriptionId);
+        if (frame) conversationTopicFrameSchema.parse(frame);
+      }
+      const mobile = publisher.subscribeReserved({
+        connectionId: "mobile",
+        deliveryProfile: "replayable",
+      });
+      const base = { logEpoch: mobile.ack.logEpoch, seq: mobile.reservation!.frame.toSeq };
+      assert.ok(mobile.reservation?.commit());
+      for (const event of events.slice(middle)) publisher.ingest(event);
+      const replacement = publisher.subscribeReserved({
+        connectionId: "mobile",
+        deliveryProfile: "replayable",
+        base,
+      });
+      assert.equal(replacement.ack.mode, "resume");
+      assert.ok(replacement.reservation?.commit());
+      conversationTopicFrameSchema.parse(replacement.reservation!.frame);
+      assert.equal(publisher.flush(mobile.ack.subscriptionId), null);
+      const resumed = publisher.resync(replacement.ack.subscriptionId)!;
+      conversationTopicFrameSchema.parse(resumed);
+      assert.equal(resumed.payload.kind, "snapshot");
+      if (resumed.payload.kind !== "snapshot")
+        throw new Error("Expected canonical mobile snapshot");
+      const full = new ProductProjection("session", "owner-replay");
+      for (const event of events) full.applyEventAtomically(event, () => true);
+      assert.deepEqual(publisher.getSnapshot(), full.getSnapshot());
+      assert.deepEqual(
+        resumed.payload.snapshot.rows.window,
+        filterConversationRowsForProfile(
+          full.getSnapshot().rows.window,
+          DELIVERY_PROFILES.replayable,
+        ),
+      );
+      const desktopSnapshot = publisher.resync(desktop.ack.subscriptionId)!;
+      conversationTopicFrameSchema.parse(desktopSnapshot);
+      assert.equal(desktopSnapshot.payload.kind, "snapshot");
+      if (desktopSnapshot.payload.kind === "snapshot")
+        assert.deepEqual(
+          desktopSnapshot.payload.snapshot.rows.window,
+          filterConversationRowsForProfile(
+            full.getSnapshot().rows.window,
+            DELIVERY_PROFILES.continuous,
+          ),
+        );
+      await f.reopen();
+      const messages = await f.store.messages({ sessionID: "session" as never });
+      const cold = new ProductProjection("session", "owner-cold");
+      cold.beginHydrationReplay();
+      for (const event of mergeColdConversationEvents({
+        sessionId: "session",
+        messages,
+        memoryEvents: [],
+      }).events)
+        cold.applyHydrationEvent(event);
+      cold.completeHydrationReplay();
+      assert.ok(cold.getSnapshot().rows.window.some((row) => row.kind === "userInput"));
+      assert.ok(cold.getSnapshot().rows.window.some((row) => row.kind === "toolCall"));
+      assert.equal(
+        new Set(cold.getSnapshot().rows.window.map((row) => row.rowId)).size,
+        cold.getSnapshot().rows.window.length,
+      );
+    } finally {
+      await f.close();
+    }
+  });
+}
