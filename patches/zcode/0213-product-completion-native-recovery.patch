+import { createApiMediaGenerationPort } from "./api-media-generation-port.js";
+
+import { ApiProviderModelRuntime } from "./provider-registry-model-runtime.js";
+import { completeAuxiliaryRegistryModelSelection } from "./provider-registry-selection.js";
+
+export function createAppWorkflowResources(factoryBindings: {
+  readonly providerModelRuntime: ApiProviderModelRuntime;
+  readonly modelTelemetry: ModelTelemetryBootstrap;
+  readonly options: ZCodeAppOptions;
+  readonly appVersion: string;
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly configResult: ConfigResult;
+  readonly fileSystemPort: FileSystemPort;
+  readonly httpClientPort: HttpClientPort;
+  readonly imageProcessorPort: ImageProcessorPort;
+  readonly pdfDocumentPort: PdfDocumentPort;
+  readonly logger: Logger;
+  readonly mcpPort: McpPort | undefined;
+  readonly permissionService: PermissionService;
+  readonly prepareUserExecutionBoundary: PrepareUserExecutionBoundary;
+  readonly getRuntime: () => AgentRuntime;
+  readonly runtimeConfig: AgentRuntimeConfig;
+  readonly sessionId: SessionId;
+  readonly sessionStore: SessionStorePort;
+  readonly storageRoot: string;
+  readonly traceContext: TraceContext;
+  readonly workingDirectory: string;
+  readonly workflowConcurrencyGovernor: ReturnType<typeof getWorkflowConcurrencyGovernor>;
+  readonly executionPort: ExecutionPort;
+}): {
+  modelFactory: ApiProviderModelRuntime["modelFactory"];
+  scriptWorkflowFacade: ReturnType<typeof createScriptWorkflowBridge>;
+  dynamicWorkflowJournal: ReturnType<typeof resolveDynamicWorkflowJournalStore>;
+  dynamicWorkflowRunPort: ReturnType<typeof createDynamicWorkflowRunService> | undefined;
+  dynamicWorkflowSnippetPort: ReturnType<typeof createDynamicWorkflowSnippetService>;
+  modelCatalogPort: ReturnType<typeof createModelCatalogPort>;
+  mediaGenerationPort: ReturnType<typeof createApiMediaGenerationPort> | undefined;
+  decisionModelPort: ReturnType<typeof createDecisionModelPort> | undefined;
+} {
+  const modelFactory = factoryBindings.providerModelRuntime.modelFactory;
+  const scriptWorkflowFacade = createScriptWorkflowBridge(
+    createAppScriptWorkflowOptionsOptions({
+      modelTelemetry: factoryBindings.modelTelemetry,
+      options: factoryBindings.options,
+      appVersion: factoryBindings.appVersion,
+      artifactStore: factoryBindings.artifactStore,
+      configResult: factoryBindings.configResult,
+      fileSystemPort: factoryBindings.fileSystemPort,
+      httpClientPort: factoryBindings.httpClientPort,
+      imageProcessorPort: factoryBindings.imageProcessorPort,
+      pdfDocumentPort: factoryBindings.pdfDocumentPort,
+      logger: factoryBindings.logger,
+      mcpPort: factoryBindings.mcpPort,
+      modelFactory,
+      permissionService: factoryBindings.permissionService,
+      prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+      getRuntime: factoryBindings.getRuntime,
+      runtimeConfig: factoryBindings.runtimeConfig,
+      sessionId: factoryBindings.sessionId,
+      sessionStore: factoryBindings.sessionStore,
+      storageRoot: factoryBindings.storageRoot,
+      traceContext: factoryBindings.traceContext,
+      workingDirectory: factoryBindings.workingDirectory,
+    }),
+  );
+
+  // workflow run service：CreateWorkflow 的确认窗 Allow 之后真启动引擎的那一侧。
+  // journal 窄化失败（store 不带 dwf_* 表）时**不构造**服务——端口保持 undefined，
+  // CreateWorkflow 因此回到占位诊断路径。这是一个记了日志的可见降级，而不是一条
+  // 会静默丢掉持久化的运行路径（详见 dynamic-workflow-run-service.ts 的文件头）。
+  const dynamicWorkflowJournal = resolveDynamicWorkflowJournalStore(
+    factoryBindings.sessionStore,
+    factoryBindings.logger,
+  );
+  const dynamicWorkflowRunPort =
+    dynamicWorkflowJournal === undefined
+      ? undefined
+      : createDynamicWorkflowRunService(
+          createAppDynamicWorkflowOptionsOptions({
+            workflowConcurrencyGovernor: factoryBindings.workflowConcurrencyGovernor,
+            getRuntime: factoryBindings.getRuntime,
+            modelTelemetry: factoryBindings.modelTelemetry,
+            options: factoryBindings.options,
+            appVersion: factoryBindings.appVersion,
+            artifactStore: factoryBindings.artifactStore,
+            configResult: factoryBindings.configResult,
+            fileSystemPort: factoryBindings.fileSystemPort,
+            httpClientPort: factoryBindings.httpClientPort,
+            imageProcessorPort: factoryBindings.imageProcessorPort,
+            logger: factoryBindings.logger,
+            mcpPort: factoryBindings.mcpPort,
+            modelFactory,
+            permissionService: factoryBindings.permissionService,
+            runtimeConfig: factoryBindings.runtimeConfig,
+            sessionId: factoryBindings.sessionId,
+            sessionStore: factoryBindings.sessionStore,
+            storageRoot: factoryBindings.storageRoot,
+            workingDirectory: factoryBindings.workingDirectory,
+            traceContext: factoryBindings.traceContext,
+            executionPort: factoryBindings.executionPort,
+            dynamicWorkflowJournal,
+          }),
+        );
+  // dwf snippet service：EvalWorkflowSnippet 的执行面。刻意**不**依赖 dwf journal——
+  // snippet 完全瞬态（内存 journal），不该被 run service 的 durability 前提连坐；
+  // 所以即使 run 端口因 journal 缺席而不构造，实验通道仍然可用。
+  const dynamicWorkflowSnippetPort = createDynamicWorkflowSnippetService({
+    executionPort: factoryBindings.executionPort,
+    fileSystemPort: factoryBindings.fileSystemPort,
+    logger: factoryBindings.logger,
+  });
+  // 模型目录：工具层把用户说的模型名解析成 workflow run 的子代理选型（model-catalog-port.ts）。
+  const modelCatalogPort = createModelCatalogPort({
+    registry: factoryBindings.options.providerRegistry,
+    currentSelection: () => factoryBindings.getRuntime().getSessionModelSelection(),
+  });
+  const mediaGenerationPort = factoryBindings.options.providerRegistry.getSnapshot
+    ? createApiMediaGenerationPort({
+        registry: {
+          getSnapshot: () => factoryBindings.options.providerRegistry.getSnapshot?.() ?? null,
+        },
+        http: factoryBindings.httpClientPort,
+      })
+    : undefined;
+  const decisionModelPort = factoryBindings.options.providerRegistry.getSnapshot
+    ? createDecisionModelPort({
+        registry: {
+          getSnapshot: () => factoryBindings.options.providerRegistry.getSnapshot?.() ?? null,
+          refresh: factoryBindings.options.providerRegistry.refresh?.bind(
+            factoryBindings.options.providerRegistry,
+          ),
+        },
+        http: factoryBindings.httpClientPort,
+        // 辅助选择只有身份，须沿既有 Registry 策略补齐档位后才进严格 Factory。
+        chatModel: (selection) =>
+          modelFactory({
+            selection: completeAuxiliaryRegistryModelSelection(
+              factoryBindings.options.providerRegistry,
+              selection,
+            ),
+          }),
+      })
+    : undefined;
+  return {
+    modelFactory,
+    scriptWorkflowFacade,
+    dynamicWorkflowJournal,
+    dynamicWorkflowRunPort,
+    dynamicWorkflowSnippetPort,
+    modelCatalogPort,
+    mediaGenerationPort,
+    decisionModelPort,
+  };
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/bundled-plugin-cache.ts b/apps/zcode-cli/packages/bootstrap/src/app/bundled-plugin-cache.ts
new file mode 100644
index 00000000..b4d56a59
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/bundled-plugin-cache.ts
@@ -0,0 +1,215 @@
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import { existsSync, mkdirSync, readdirSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { writeBundledOfficialMarketplacePartitionSync } from "@zcode/adapters";
+import { type Logger } from "@zcode/contracts";
+import {
+  getOfficialPluginCacheRetryAttempts,
+  type OfficialPluginCacheRetryBudget,
+  removeOfficialPluginCacheDirectory,
+  renameOfficialPluginCachePath,
+} from "./official-plugin-cache-fs.js";
+import { type OfficialPluginDefinition } from "./official-plugin-definitions.js";
+import {
+  type OfficialPluginSeedSource,
+  OFFICIAL_PLUGIN_MARKETPLACE,
+  officialPluginCacheRoot,
+  type OfficialPluginSeedPluginSource,
+  SEED_MARKER_FILE,
+  type seedMarker,
+  isNotFoundFsError,
+} from "./bundled-plugin-values.js";
+import { readSeedFileBytes } from "./bundled-plugin-source.js";
+
+export function writeOfficialMarketplace(
+  storageRoot: string,
+  source: OfficialPluginSeedSource,
+): void {
+  writeBundledOfficialMarketplacePartitionSync({
+    manifest: {
+      name: OFFICIAL_PLUGIN_MARKETPLACE,
+      plugins: source.plugins.map((plugin) => {
+        // 商店信息（listing）与描述随目录条目下发：键名与 CDN 目录 schema 一致，
+        // 由 adapter 的同一套 parseEntryStoreListing 解析，UI 才能给内置插件渲染
+        // 显示名/分类/作者/示例提示词。描述取自插件包内 plugin.json（单一事实源）。
+        const description = readSeedPluginDescription(source, plugin);
+        return {
+          cachePath: officialPluginCacheRoot(storageRoot, plugin.definition),
+          ...(description ? { description } : {}),
+          name: plugin.definition.name,
+          source: source.kind,
+          version: plugin.definition.version,
+          ...(plugin.definition.listing ?? {}),
+        };
+      }),
+      version: 1,
+    },
+    storageRoot,
+  });
+}
+
+/** 从 seed 文件集中读插件 plugin.json 的 description；读取/解析失败按 undefined 降级。 */
+function readSeedPluginDescription(
+  source: OfficialPluginSeedSource,
+  plugin: OfficialPluginSeedPluginSource,
+): string | undefined {
+  const manifestFile = plugin.files.find((file) => file.path === ".zcode-plugin/plugin.json");
+  if (!manifestFile) return undefined;
+  try {
+    const parsed = JSON.parse(readSeedFileBytes(source, plugin, manifestFile).toString("utf8")) as {
+      description?: unknown;
+    };
+    return typeof parsed.description === "string" && parsed.description.trim().length > 0
+      ? parsed.description
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export function isSeedCurrent(targetRoot: string, plugin: OfficialPluginSeedPluginSource): boolean {
+  const markerPath = join(targetRoot, SEED_MARKER_FILE);
+  if (!existsSync(markerPath)) return false;
+  try {
+    const marker = JSON.parse(readFileSync(markerPath, "utf8")) as ReturnType<typeof seedMarker>;
+    return marker.hash === plugin.hash && marker.pluginVersion === plugin.definition.version;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * 旧版本缓存只要插件清单和运行所需文件完整，就可以继续服务当前会话。
+ * marker hash 不匹配只表示需要升级，不能把一个可用的旧缓存当成启动失败。
+ */
+function isSeedUsable(targetRoot: string, definition: OfficialPluginDefinition): boolean {
+  try {
+    const manifest = JSON.parse(
+      readFileSync(join(targetRoot, ".zcode-plugin", "plugin.json"), "utf8"),
+    ) as { name?: unknown };
+    if (manifest.name !== definition.name) return false;
+  } catch {
+    return false;
+  }
+
+  return (definition.requiredSeedPaths ?? []).every((requiredPath) =>
+    existsSync(join(targetRoot, ...requiredPath.split("/"))),
+  );
+}
+
+export function findUsableOfficialPluginFallback(
+  storageRoot: string,
+  definition: OfficialPluginDefinition,
+): string | undefined {
+  const targetRoot = officialPluginCacheRoot(storageRoot, definition);
+  if (isSeedUsable(targetRoot, definition)) return undefined;
+
+  let entries;
+  try {
+    entries = readdirSync(dirname(targetRoot), { withFileTypes: true });
+  } catch (error) {
+    if (isNotFoundFsError(error)) return undefined;
+    throw error;
+  }
+
+  return entries
+    .filter(
+      (entry) =>
+        entry.isDirectory() &&
+        entry.name !== definition.version &&
+        !entry.name.includes(".backup") &&
+        // 锁目录（含 .seed-lock.stale-*）与版本目录同级；超时降级后锁必然在场，
+        // 不能依赖 isSeedUsable 的内容检查兜底，按名字直接排除。
+        !entry.name.includes(".seed-lock") &&
+        !entry.name.includes(".tmp-"),
+    )
+    .sort((left, right) =>
+      right.name.localeCompare(left.name, undefined, { numeric: true, sensitivity: "base" }),
+    )
+    .map((entry) => join(dirname(targetRoot), entry.name))
+    .find((rootPath) => isSeedUsable(rootPath, definition));
+}
+
+export function replaceSeedRoot(
+  temporaryRoot: string,
+  targetRoot: string,
+  plugin: OfficialPluginSeedPluginSource,
+  retryBudget: OfficialPluginCacheRetryBudget,
+): void {
+  const backupRoot = createSeedBackupRoot(targetRoot);
+  let movedTargetToBackup = false;
+  mkdirSync(dirname(targetRoot), { recursive: true });
+  if (existsSync(targetRoot)) {
+    try {
+      renameOfficialPluginCachePath(targetRoot, backupRoot, retryBudget);
+      movedTargetToBackup = true;
+    } catch (error) {
+      // 官方插件缓存由桌面窗口、协议与 CLI 入口共享。existsSync 之后，
+      // 另一个进程可能先移走 target；此处只收敛这个 TOCTOU 的 ENOENT，随后继续
+      // promote 或由 isSeedCurrent 识别并发赢家，其他缺失错误仍保持原有 fatal 语义。
+      if (!isNotFoundFsError(error)) throw error;
+    }
+  }
+
+  try {
+    renameOfficialPluginCachePath(temporaryRoot, targetRoot, retryBudget);
+  } catch (error) {
+    if (isSeedCurrent(targetRoot, plugin)) {
+      removeOfficialPluginCacheDirectory(temporaryRoot, retryBudget);
+      if (movedTargetToBackup) {
+        removeOfficialPluginCacheDirectory(backupRoot, retryBudget);
+      }
+      cleanupLegacySeedBackup(targetRoot, retryBudget);
+      return;
+    }
+    if (movedTargetToBackup && !existsSync(targetRoot) && existsSync(backupRoot)) {
+      renameOfficialPluginCachePath(backupRoot, targetRoot, retryBudget);
+    }
+    throw error;
+  }
+
+  if (movedTargetToBackup) {
+    removeOfficialPluginCacheDirectory(backupRoot, retryBudget);
+  }
+  cleanupLegacySeedBackup(targetRoot, retryBudget);
+}
+
+export function cleanupLegacySeedBackup(
+  targetRoot: string,
+  retryBudget: OfficialPluginCacheRetryBudget,
+): void {
+  const backupRoot = `${targetRoot}.backup`;
+  if (!existsSync(backupRoot)) return;
+
+  // 旧版固定 backup 没有事务归属，target 暂时缺失时可能属于另一个仍在
+  // promote 的进程，不能把它恢复回去。仅在当前 seed 已确认可用后清理这个遗留目录。
+  removeOfficialPluginCacheDirectory(backupRoot, retryBudget);
+}
+
+function createSeedBackupRoot(targetRoot: string): string {
+  // 固定 backup 会被并发启动进程共同当作 rollback 点；每次替换使用唯一目录，
+  // catch 分支只恢复自己移动出的 target，避免一个进程窃取另一个进程的事务状态。
+  return `${targetRoot}.backup-${process.pid}-${Date.now()}`;
+}
+
+export function warnCacheDegraded(
+  logger: Logger | undefined,
+  input: {
+    error: NodeJS.ErrnoException;
+    missingSeedPaths?: readonly string[];
+    operation: "remove_suppressed_plugin" | "seed_plugin";
+    pluginId: string;
+    targetRoot: string;
+  },
+): void {
+  logger?.warn("Official plugin cache operation degraded", {
+    attempts: getOfficialPluginCacheRetryAttempts(input.error),
+    degraded: true,
+    errorCode: input.error.code,
+    ...(input.missingSeedPaths ? { missingSeedPaths: input.missingSeedPaths } : {}),
+    module: "bootstrap.official_plugin_cache",
+    operation: input.operation,
+    pluginId: input.pluginId,
+    targetRoot: input.targetRoot,
+  });
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/bundled-plugin-roots.ts b/apps/zcode-cli/packages/bootstrap/src/app/bundled-plugin-roots.ts
