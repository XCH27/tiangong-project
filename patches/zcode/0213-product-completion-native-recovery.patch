+
+test(
+  "native canonical workspace aliases share a create-only lock across two processes",
+  { timeout: 20000 },
+  async () => {
+    const root = await mkdtemp(join(tmpdir(), "fleet-native-create-race-"));
+    const children: ReturnType<typeof fork>[] = [];
+    try {
+      const workspace = join(root, "workspace"),
+        alias = join(root, "alias");
+      await mkdir(workspace);
+      await symlink(workspace, alias, "dir");
+      const worker = join(root, "worker.mts");
+      const adapter = new URL("../src/fs/index.ts", import.meta.url).href;
+      await writeFile(
+        worker,
+        `import {NodeFileSystemAdapter} from ${JSON.stringify(adapter)};
+process.send({ready:true});
+process.on("message",async()=>{try{await new NodeFileSystemAdapter().writeTextFile({path:process.argv[2],boundaryRoot:process.argv[3],content:process.argv[4],createParents:true,expectedAbsent:true});process.send({ok:true});}catch(e){process.send({ok:false,code:e.code});}finally{process.disconnect();}});`,
+      );
+      const spawn = (path: string, boundaryRoot: string, value: string) => {
+        const child = fork(worker, [path, boundaryRoot, value], {
+          execArgv: process.execArgv,
+          stdio: ["ignore", "ignore", "pipe", "ipc"],
+        });
+        children.push(child);
+        const ready = new Promise<void>((resolve, reject) => {
+          child.once("error", reject);
+          child.once("message", () => resolve());
+        });
+        const result = new Promise<{ ok: boolean; code?: string }>((resolve, reject) => {
+          child.on("message", (message: { ready?: boolean; ok?: boolean; code?: string }) => {
+            if (message.ok !== undefined) resolve(message as { ok: boolean; code?: string });
+          });
+          child.once("error", reject);
+        });
+        return { child, ready, result };
+      };
+      const a = spawn(join(workspace, "native", "board.json"), workspace, "writer A");
+      const b = spawn(join(alias, "native", "board.json"), alias, "writer B");
+      await Promise.all([a.ready, b.ready]);
+      a.child.send("create");
+      b.child.send("create");
+      const outcomes = await Promise.all([a.result, b.result]);
+      assert.equal(outcomes.filter((value) => value.ok).length, 1);
+      assert.equal(outcomes.find((value) => !value.ok)?.code, "stale_write");
+      assert.ok(
+        ["writer A", "writer B"].includes(
+          await readFile(join(workspace, "native", "board.json"), "utf8"),
+        ),
+      );
+      assert.deepEqual(await readdir(join(workspace, "native")), ["board.json"]);
+      const read = await new NodeFileSystemAdapter().readTextFile({
+        path: join(workspace, "native", "board.json"),
+        boundaryRoot: alias,
+      });
+      assert.ok(read.revision.hash);
+    } finally {
+      for (const child of children) if (child.exitCode === null) child.kill();
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+);
+
+test("native create-only rechecks publication after an external creation during staging", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-staging-"));
