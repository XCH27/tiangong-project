@@ -0,0 +1,40 @@
+import { getEnabledApiKeys } from "@zcode/provider";
+
+import { createModelAdapter } from "../model-factory.js";
+
+import type { ZCodeAppOptions } from "./types.js";
+
+import type { Logger } from "@zcode/core";
+import type { AiSdkModelExecutionConfig, ConfigResult } from "@zcode/adapters";
+import type { ModelTelemetryBootstrap } from "@zcode/telemetry";
+
+export function createAppModelAdapterOptionsOptions(factoryBindings: {
+  readonly options: ZCodeAppOptions;
+  readonly modelLogger: Logger;
+  readonly modelIoDir: string;
+  readonly modelExecutionConfig: AiSdkModelExecutionConfig;
+  readonly modelTelemetry: ModelTelemetryBootstrap;
+  readonly configResult: ConfigResult;
+}): Parameters<typeof createModelAdapter>[0] {
+  return {
+    env: factoryBindings.options.env,
+    logger: factoryBindings.modelLogger,
+    modelIoDir: factoryBindings.modelIoDir,
+    modelIoFullRetentionEnabled: factoryBindings.options.modelIoFullRetentionEnabled,
+    executionConfig: {
+      ...factoryBindings.modelExecutionConfig,
+      // 仅查询现有 Registry 的密钥启用事实；不会改变已绑定 Model 的地址或协议。
+      isApiKeyEnabled: (providerId, key) => {
+        const access =
+          factoryBindings.options.providerRegistry.getProvider(providerId)?.config.access;
+        return (
+          !!access &&
+          (access.type === "api-key" || access.type === "zhipu-coding-plan-api-key") &&
+          getEnabledApiKeys(access).includes(key.trim())
+        );
+      },
+    },
+    statusSink: factoryBindings.modelTelemetry.statusSink,
+    streamIdleTimeoutMs: factoryBindings.configResult.config.modelStream.idleTimeoutMs,
+  };
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-model-resources.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-model-resources.ts
