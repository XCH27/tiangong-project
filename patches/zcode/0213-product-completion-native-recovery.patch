-    const hookInvocationId = payload.hookInvocationId;
-    const hookCount = payload.hookCount;
-    if (
-      !hookInvocationId ||
-      !payload.hookRunId ||
-      !Number.isInteger(hookCount) ||
-      (hookCount ?? 0) <= 0 ||
-      !Number.isInteger(payload.hookIndex) ||
-      payload.hookIndex < 0
