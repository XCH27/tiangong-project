index 00000000..f9f5f95c
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-user-message-id-for-row.ts
@@ -0,0 +1,33 @@
+import { isConversationRealUserTurnStarter } from "@zcode/shared";
+
+import type { V4CommandCoreHost } from "../zcode-protocol-v4/commands/types.js";
+
+import type { SessionId } from "@zcode/contracts";
+
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function createV4CoreHostResolveUserMessageIdForRow(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+}): V4CommandCoreHost["resolveUserMessageIdForRow"] {
+  return (
+    {
+      resolveUserMessageIdForRow: async (sessionId, rowId) => {
+        const turnId = factoryBindings.context.v4Gateway?.getTurnIdForRow(sessionId, rowId) ?? null;
+        const sessionStore = factoryBindings.context.deps.sessionStore;
+        if (!turnId || !sessionStore) return null;
+        const messages = await sessionStore.messages({
+          sessionID: sessionId as SessionId,
+        });
+        const user = messages
+          .filter(
+            (message) =>
+              message.info.role === "user" &&
+              String(message.info.anchor?.turnId ?? "") === turnId &&
+              isConversationRealUserTurnStarter(message),
+          )
+          .at(-1);
+        return user ? String(user.info.id) : null;
+      },
+    } satisfies Pick<V4CommandCoreHost, "resolveUserMessageIdForRow">
+  ).resolveUserMessageIdForRow;
+}
