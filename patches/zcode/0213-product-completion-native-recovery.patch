+    assert.deepEqual(await readdir(root), ["board.json"]);
+  } finally {
+    fs.open = originalOpen;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("native boundary rechecks descendants after lock-path resolution and rejects a late symlink", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-late-link-"));
+  const workspace = join(root, "workspace"),
+    outside = join(root, "outside"),
+    native = join(workspace, "native");
+  const path = join(native, "board.json"),
+    originalRealpath = fs.realpath;
+  let swapped = false;
+  try {
+    await mkdir(workspace);
+    await mkdir(outside);
+    await mkdir(native);
+    fs.realpath = async (value, ...rest) => {
+      if (value === path && !swapped) {
+        swapped = true;
+        await rename(native, join(workspace, "original-native"));
+        await symlink(outside, native, "dir");
+      }
+      return originalRealpath(value, ...rest);
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path,
+        boundaryRoot: workspace,
+        content: "must not escape",
+        expectedAbsent: true,
+      }),
+      (error: { code?: string }) => error.code === "permission_denied",
+    );
+    assert.equal(swapped, true);
+    assert.deepEqual(await readdir(outside), []);
+  } finally {
+    fs.realpath = originalRealpath;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("native non-directory root and cancelled or failed staging never create a document", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-failures-"));
+  const originalOpen = fs.open;
+  try {
+    const fileRoot = join(root, "not-a-directory");
+    await writeFile(fileRoot, "unchanged");
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path: join(fileRoot, "child", "board.json"),
+        boundaryRoot: fileRoot,
+        createParents: true,
+        content: "no",
+      }),
+      (error: { code?: string }) => error.code === "not_file",
+    );
+    const path = join(root, "board.json"),
+      controller = new AbortController();
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(path + ".tmp.")) {
+        const sync = handle.sync.bind(handle);
+        handle.sync = async () => {
+          await sync();
+          controller.abort();
+        };
+      }
+      return handle;
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile(
+        { path, boundaryRoot: root, expectedAbsent: true, content: "no" },
+        { signal: controller.signal },
+      ),
+      (error: { code?: string }) => error.code === "cancelled",
+    );
+    assert.deepEqual(await readdir(root), ["not-a-directory"]);
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(path + ".tmp."))
+        handle.writeFile = async () => {
+          throw Object.assign(new Error("authored disk full"), { code: "ENOSPC" });
+        };
+      return handle;
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path,
+        boundaryRoot: root,
+        expectedAbsent: true,
+        content: "no",
+      }),
+      (error: { code?: string; cause?: { code?: string } }) =>
+        error.code === "io_error" && error.cause?.code === "ENOSPC",
+    );
+    assert.deepEqual(await readdir(root), ["not-a-directory"]);
+  } finally {
+    fs.open = originalOpen;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("native directory discovery rejects outside enumeration before reading entries", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-directory-outside-"));
