--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-gateway-host-resume-persisted-session.ts
@@ -0,0 +1,53 @@
+import type { V4GatewayHost } from "../zcode-protocol-v4/v4-gateway.js";
+
+import { type ZCodeWorkspaceRef } from "@zcode/shared";
+
+import type { SessionId } from "@zcode/contracts";
+
+import { activateSessionForResume } from "./server-operations.js";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function createV4GatewayHostResumePersistedSession(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+}): V4GatewayHost["resumePersistedSession"] {
+  return (
+    {
+      resumePersistedSession: async (
+        sessionId,
+        resumeThoughtLevel,
+        workspace?: ZCodeWorkspaceRef,
+      ) => {
+        const persisted = await factoryBindings.context.deps.sessionStore?.getSession(
+          sessionId as SessionId,
+        );
+        if (!persisted) {
+          factoryBindings.context.logger?.warn(
+            "ZCode Protocol v4 cold resume has no persisted session",
+            {
+              activeSessionCount: factoryBindings.context.sessions.size,
+              event: "zcode_protocol.v4.resume_persisted_missing",
+              module: "bootstrap.zcode_protocol",
+              sessionId,
+            },
+          );
+          return { status: "notFound" };
+        }
+        const activated = await activateSessionForResume(
+          factoryBindings.context,
+          {
+            sessionId,
+            // session.path 可能是规范化后的执行 cwd，不能覆盖当前 attachment
+            // 已知的 workspace 身份。旧 session 没有 attachment 上下文时仍走原有持久化回退。
+            ...(workspace ? { workspace } : {}),
+            ...(resumeThoughtLevel ? { thoughtLevel: resumeThoughtLevel } : {}),
+          },
+          { reusePersistedMessages: true },
+        );
+        return {
+          status: "resumed",
+          persistedMessages: activated.persistedMessages,
+        };
+      },
+    } satisfies Pick<V4GatewayHost, "resumePersistedSession">
+  ).resumePersistedSession;
+}
