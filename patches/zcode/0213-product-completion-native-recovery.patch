+      pluginId: info().id,
+      viewId: "main",
+    }),
+    async count() {
+      try {
+        return JSON.parse(await readFile(join(info().dataPath, "counter.json"), "utf8"))
+          .value as number;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ENOENT") return 0;
+        throw error;
+      }
+    },
+    revoke: () => revokeZCodePluginGrant({ ...paths, plugin: info().id }),
+    disable: () => setZCodePluginEnabled({ ...paths, plugin: info().id, enabled: false }),
+    async changeServerAndGrant() {
+      const manifestPath = info().manifestPath;
+      const manifest = JSON.parse(await readFile(manifestPath, "utf8"));
+      manifest.mcpServers.counter.env = { ZCODE_PLUGIN_WRITE_TOOL: "replacement_write" };
+      await writeFile(manifestPath, JSON.stringify(manifest));
+      const current = info();
+      assert.ok(current.grant);
+      grantZCodePlugin({ ...paths, plugin: current.id, fingerprint: current.grant.fingerprint });
+    },
+    async close() {
+      await mcp.close();
+      await f.close();
+    },
+  };
+}
