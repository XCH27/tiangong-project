@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { join } from "node:path";
+import { readFile } from "node:fs/promises";
+import { createInMemorySessionEventStore, type SessionId } from "@zcode/contracts";
+import {
+  nativeWhiteboardSchema,
+  whiteboardFileRevisionSchema,
+  whiteboardRelativePath,
+  type WhiteboardDocumentData,
+} from "@zcode/shared";
+import { NodeFileSystemAdapter } from "../../../adapters/src/fs/index.js";
+import { NodeToolArtifactStore } from "../../../adapters/src/storage/index.js";
+import { AgentRuntime } from "../../src/runtime/agent-runtime.js";
+import { fixture } from "./pi-runtime-fixture.js";
+
+export const drawing = (): WhiteboardDocumentData => ({
+  id: `whiteboard:${randomUUID()}`,
+  name: "Authored parent drawing",
+  width: 1280,
+  height: 800,
+  strokes: [],
+  undoneStrokes: [],
+  createdAt: 1,
+  updatedAt: 1,
+});
+export async function nativeForkFixture() {
+  const files = new NodeFileSystemAdapter(),
+    write = files.writeTextFile.bind(files);
+  let writes = 0,
+    childPermissions = 0,
+    childFactories = 0;
+  files.writeTextFile = async (...args) => {
+    writes++;
+    return write(...args);
+  };
+  const f = await fixture(undefined, false, {
+    config: {
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      titleGeneration: { enabled: false },
+    },
+    deps: { fileSystemPort: files },
+  });
+  const children = new Set<AgentRuntime>();
+  const child = async (id: SessionId) => {
+    const session = await f.store.getSession(id);
+    assert.ok(session);
+    const runtime = new AgentRuntime(
+      id,
+      {
+        workingDirectory: session.directory,
+        modelSelection: f.runtime.getSessionModelSelection(),
+        mode: "build",
+        titleGeneration: { enabled: false },
+        memory: { use: false },
+        dynamicWorkflowEnabled: false,
+        mcp: { enabled: false, servers: {} },
+        toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      },
+      {
+        sessionStore: f.store,
+        eventStore: createInMemorySessionEventStore(),
+        fileSystemPort: files,
+        artifactStore: new NodeToolArtifactStore({
+          rootDir: join(f.dir, "artifacts"),
+          imageCacheRootDir: join(f.dir, "images"),
+          videoCacheRootDir: join(f.dir, "videos"),
+        }),
+        modelFactory: () => {
+          childFactories++;
+          throw new Error("Native fork acceptance must not create a model");
+        },
+        permissionBroker: {
+          async requestPermission() {
+            childPermissions++;
+            return { decision: "allow" };
+          },
+        },
+      },
+    );
+    children.add(runtime);
+    await runtime.resumeFromStore();
+    return runtime;
+  };
+  return {
+    f,
+    files,
+    child,
+    get writes() {
+      return writes;
+    },
+    get childPermissions() {
+      return childPermissions;
+    },
+    get childFactories() {
+      return childFactories;
+    },
+    bytes: (boardId: string) => readFile(join(f.dir, whiteboardRelativePath(boardId)), "utf8"),
+    async reopen() {
+      for (const runtime of children) {
+        runtime.beginShutdown();
+        await runtime.waitForShutdownSettlement();
+      }
+      children.clear();
+      await f.reopen();
+    },
+    async close() {
+      for (const runtime of children) {
+        runtime.beginShutdown();
+        await runtime.waitForShutdownSettlement();
+      }
+      await f.close();
+    },
+  };
+}
+export async function save(
+  runtime: Pick<AgentRuntime, "performWhiteboardControl">,
+  document: WhiteboardDocumentData,
+  expectedFileRevision?: import("@zcode/shared").WhiteboardFileRevision,
+) {
+  const response = await runtime.performWhiteboardControl({
+    operation: "update",
+    input: {
+      document,
+      mutationId: randomUUID(),
+      ...(expectedFileRevision ? { expectedFileRevision } : { expectedAbsent: true }),
+    },
+  });
+  return completed(response);
+}
+export function completed(response: Awaited<ReturnType<AgentRuntime["performWhiteboardControl"]>>) {
+  assert.ok(response.accepted, JSON.stringify(response));
+  assert.ok(response.result.success, JSON.stringify(response.result.error));
+  const output = response.result.output;
+  assert.ok(output && typeof output === "object" && !Array.isArray(output));
+  const value = output as Record<string, unknown>;
+  assert.equal(typeof value.filePath, "string");
+  return {
+    document: nativeWhiteboardSchema.parse(value.document),
+    fileRevision: whiteboardFileRevisionSchema.parse(value.fileRevision),
+    filePath: String(value.filePath),
+  };
+}
diff --git a/apps/zcode-cli/packages/core/test/native-plugin-operation-race.test.ts b/apps/zcode-cli/packages/core/test/native-plugin-operation-race.test.ts
