@@ -0,0 +1,61 @@
+import type { CommandInboxOwner } from "./command-inbox-owner.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import type { CommandAck, CommandKey } from "@zcode/shared/zcode-protocol-v4";
+import { PROTOCOL_V4_LIMITS } from "@zcode/shared/zcode-protocol-v4";
+import { GLOBAL_BUCKET } from "./command-inbox-types.js";
+
+export function bucketKey(this: CommandInboxOwner, sessionId: string | null): string {
+  return sessionId ?? GLOBAL_BUCKET;
+}
+
+export function keyGateKey(this: CommandInboxOwner, key: CommandKey): string {
+  return `${this.bucketKey(key.sessionId)}\0${key.commandId}`;
+}
+
+export function mapFor<T>(
+  this: CommandInboxOwner,
+  store: Map<string, Map<string, T>>,
+  bucketKey: string,
+): Map<string, T> {
+  let bucket = store.get(bucketKey);
+  if (!bucket) {
+    bucket = new Map();
+    store.set(bucketKey, bucket);
+  }
+  return bucket;
+}
+
+export function touchSettled(
+  this: CommandInboxOwner,
+  bucketKey: string,
+  commandId: string,
+  ack: CommandAck,
+): void {
+  const bucket = this.mapFor(this.settled, bucketKey);
+  bucket.delete(commandId);
+  bucket.set(commandId, ack);
+}
+
+export function rememberSettled(
+  this: CommandInboxOwner,
+  bucketKey: string,
+  commandId: string,
+  ack: CommandAck,
+): void {
+  const bucket = this.mapFor(this.settled, bucketKey);
+  bucket.delete(commandId);
+  bucket.set(commandId, ack);
+  while (bucket.size > PROTOCOL_V4_LIMITS.idempotencyTablePerSession) {
+    const oldest = bucket.keys().next().value;
+    if (oldest === undefined) break;
+    bucket.delete(oldest);
+  }
+}
+
+export function extractCommandId(this: CommandInboxOwner, raw: unknown): string {
+  if (typeof raw === "object" && raw !== null && "commandId" in raw) {
+    const id = (raw as { commandId: unknown }).commandId;
+    if (typeof id === "string") return id;
+  }
+  return "";
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/command-inbox-types.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/command-inbox-types.ts
