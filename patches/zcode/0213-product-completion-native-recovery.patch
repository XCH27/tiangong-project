-  // 让 validatePluginRoot 走与已安装插件完全相同的 manifest/MCP 校验。
-  return validatePluginRoot({
-    entry: { name: name || basename(rootPath), raw: {} },
-    marketplace: "inline",
-    rootPath,
-    storageRoot: input.storageRoot,
-  });
