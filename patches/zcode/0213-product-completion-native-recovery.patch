-async function persistSessionModelSelection(
-  deps: CreateSessionFacadeDeps,
-  selection: ModelSelection,
-): Promise<void> {
-  if (!deps.sessionStore.saveSessionEntry) return;
-  // An unsent conversation is a Host draft; first input creates and snapshots it.
-  // Existing Sessions must still commit before publishing a configuration change.
-  if (!(await deps.sessionStore.getSession(deps.sessionId))) return;
-  const timestamp = Date.now();
-  try {
-    await deps.sessionStore.saveSessionEntry({
-      id: `${deps.sessionId}:runtime-model-selection`,
-      sessionID: deps.sessionId,
-      type: SESSION_ENTRY_MODEL_SELECTION,
-      touchSession: false,
-      time: { created: timestamp, updated: timestamp },
-      // 模型与思考档位是 session-local 原子选型；切换后立即落同一稳定 entry，
-      // 不必等下一条消息，也不会在冷恢复时读取 workspace/draft 的全局最新选择。
-      // 同时配置补写不代表用户新活动，不能触发 session.time_updated 变成“刚刚”。
-      data: {
