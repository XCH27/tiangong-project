index 00000000..a6c05944
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-whiteboard-checkpoint.ts
@@ -0,0 +1,372 @@
+import { resolve } from "node:path";
+import {
+  parseNativeWhiteboardText,
+  WHITEBOARD_DOCUMENT_MAX_BYTES,
+  whiteboardRelativePath,
+  whiteboardUpdateInputSchema,
+  type NativeWhiteboardDocument,
+} from "@zcode/shared";
+import {
+  RewindScope,
+  SessionEventType,
+  SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+  parseWorkspaceCheckpointArtifact,
+  createChildTraceContext,
+  type MessageId,
+  type MessageWithParts,
+  type SessionEntryInfo,
+  type ToolExecutionResult,
+  type TraceContext,
+} from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { NATIVE_WHITEBOARD_CHECKPOINT_ENTRY } from "../../tool/handlers/whiteboard-checkpoint.js";
+import {
+  effectiveWhiteboardInputFacts,
+  readEffectiveWhiteboardInput,
+} from "../../tool/handlers/whiteboard-effective-input.js";
+import { persistWorkspaceCheckpointEntry } from "./workspace-checkpoint-persistence.js";
+import { recordTurnFileChange } from "../helpers/index.js";
+
+interface NativeCheckpointData {
+  filePath: string;
+  mutationId: string;
+  mutationDigest: string;
+  snapshotRef: string;
+  toolCallId: string;
+  expectedHash?: string;
+  effectiveInputs?: unknown;
+  status: "prepared" | "committed" | "published";
+  turnId?: string;
+  messageId?: string;
+  toolMessageId?: string;
+}
+
+function checkpointData(entry: SessionEntryInfo, sessionId: string): NativeCheckpointData {
+  const data = entry.data as NativeCheckpointData;
+  if (
+    entry.sessionID !== sessionId ||
+    !data ||
+    ![data.filePath, data.mutationId, data.mutationDigest, data.snapshotRef, data.toolCallId].every(
+      (value) => typeof value === "string",
+    ) ||
+    entry.id !== `${sessionId}:native-whiteboard:${data.mutationId}` ||
+    !["prepared", "committed", "published"].includes(data.status)
+  )
+    throw new Error("Invalid native whiteboard checkpoint journal");
+  return data;
+}
+
+async function snapshotFor(runtime: AgentRuntimeInternal, data: NativeCheckpointData) {
+  const stored = await runtime.artifactStore!.readToolResultArtifact({ uri: data.snapshotRef });
+  const artifact = parseWorkspaceCheckpointArtifact(JSON.parse(stored.content));
+  const file = artifact.files[0];
+  if (
+    artifact.files.length !== 1 ||
+    artifact.toolName !== "WhiteboardUpdate" ||
+    artifact.toolCallId !== data.toolCallId ||
+    !file?.afterContent ||
+    file.path !== data.filePath
+  )
+    throw new Error("Native checkpoint belongs to another file operation");
+  const after = parseNativeWhiteboardText(file.afterContent);
+  if (
+    resolve(runtime.workspaceRoot, whiteboardRelativePath(after.board.id)) !== data.filePath ||
+    after.mutationId !== data.mutationId ||
+    after.mutationDigest !== data.mutationDigest
+  )
+    throw new Error("Native checkpoint does not match its prepared mutation");
+  return { file, after };
+}
+
+async function publishCheckpoint(
+  runtime: AgentRuntimeInternal,
+  entry: SessionEntryInfo,
+  data: NativeCheckpointData,
+  anchors: { messageId: MessageId; toolMessageId?: MessageId },
+  trace: TraceContext,
+) {
+  if (data.status === "published") return;
+  const { file } = await snapshotFor(runtime, data);
+  const checkpointId = `${entry.id}:checkpoint`;
+  const event = runtime.createEvent(
+    SessionEventType.CheckpointCreated,
+    {
+      checkpointId,
+      messageId: anchors.messageId,
+      targetMessageId: anchors.messageId,
+      toolMessageId: anchors.toolMessageId,
+      scope: RewindScope.Workspace,
+      snapshotRef: data.snapshotRef,
+      diffRef: data.snapshotRef,
+      fileCount: 1,
+    },
+    trace,
+  );
+  event.id = `${entry.id}:checkpoint-event` as typeof event.id;
+  const committed = {
+    ...data,
+    status: "committed" as const,
+    messageId: String(anchors.messageId),
+    ...(anchors.toolMessageId ? { toolMessageId: String(anchors.toolMessageId) } : {}),
+    ...(trace.turnId ? { turnId: String(trace.turnId) } : {}),
+  };
+  await runtime.sessionStore!.saveSessionEntry!({ ...entry, touchSession: false, data: committed });
+  const durable = await runtime.sessionStore!.sessionEntries!({
+    sessionID: runtime.sessionId,
+    type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+  });
+  const recorded = durable.some(
+    (item) => (item.data as { eventId?: string }).eventId === String(event.id),
+  );
+  if (!recorded) {
+    const live = await runtime.eventStore.getEvents(runtime.sessionId);
+    if (!live.some((item) => item.id === event.id)) await runtime.appendEvent(event, trace);
+    // Existing generic checkpoint persistence logs failures. Native Save requires that same writer's durable result.
+    await persistWorkspaceCheckpointEntry(runtime, event, trace, { propagateFailure: true });
+  }
+  await runtime.sessionStore!.saveSessionEntry!({
+    ...entry,
+    touchSession: false,
+    data: { ...committed, status: "published" },
+  });
+  recordTurnFileChange(runtime.currentTurnFileChanges, {
+    path: data.filePath,
+    beforeContent: file.beforeContent,
+    afterContent: file.afterContent,
+    structuredPatch: file.structuredPatch ?? [],
+    toolName: "WhiteboardUpdate",
+  });
+}
+
+async function committedAnchors(
+  runtime: AgentRuntimeInternal,
+  data: NativeCheckpointData,
+  messages: MessageWithParts[],
+  after: NativeWhiteboardDocument,
+) {
+  if (
+    typeof data.messageId !== "string" ||
+    !data.messageId ||
+    typeof data.toolMessageId !== "string" ||
+    !data.toolMessageId
+  )
+    throw new Error("Committed native checkpoint is missing its action anchors");
+  const user = messages.find((message) => message.info.id === data.messageId);
+  const receipt = messages.find((message) => message.info.id === data.toolMessageId);
+  if (!user || !receipt) return undefined; // Original rewind/deletion removed the accepted action.
+  if (
+    user.info.sessionID !== runtime.sessionId ||
+    receipt.info.sessionID !== runtime.sessionId ||
+    user.info.role !== "user" ||
+    receipt.info.role !== "assistant" ||
+    receipt.info.parentID !== user.info.id
+  )
+    throw new Error("Committed native checkpoint belongs to another action");
+  const facts = effectiveWhiteboardInputFacts(data.effectiveInputs);
+  const parts = receipt.parts.filter(
+    (item) =>
+      item.type === "tool" &&
+      item.tool === "WhiteboardUpdate" &&
+      item.state.status === "completed" &&
+      (data.effectiveInputs === undefined
+        ? item.state.input.mutationId === data.mutationId
+        : facts.some(
+            (fact) => fact.toolCallId === item.callID && fact.turnId === user.info.anchor?.turnId,
+          )),
+  );
+  const part = parts.length === 1 ? parts[0] : undefined;
+  if (
+    !part ||
+    part.type !== "tool" ||
+    part.state.status !== "completed" ||
+    part.sessionID !== runtime.sessionId ||
+    part.messageID !== receipt.info.id
+  )
+    throw new Error("Committed native checkpoint has no successful tool receipt");
+  let input: unknown = part.state.input;
+  if (data.effectiveInputs !== undefined) {
+    const matched = facts.filter(
+      (fact) => fact.toolCallId === part.callID && fact.turnId === user.info.anchor?.turnId,
+    );
+    if (matched.length !== 1) throw new Error("Ambiguous effective whiteboard action trace");
+    input = await readEffectiveWhiteboardInput(
+      runtime.artifactStore!,
+      String(runtime.sessionId),
+      matched[0]!,
+    );
+  } else if (typeof part.state.input.inputRef === "string") {
+    const stored = await runtime.artifactStore!.readToolResultArtifact({
+      uri: part.state.input.inputRef,
+    });
+    if (Buffer.byteLength(stored.content, "utf8") > WHITEBOARD_DOCUMENT_MAX_BYTES)
+      throw new Error("Committed native action input exceeds its size budget");
+    input = JSON.parse(stored.content);
+  }
+  const parsed = whiteboardUpdateInputSchema.safeParse(input);
+  if (
+    !parsed.success ||
+    parsed.data.mutationId !== data.mutationId ||
+    (data.effectiveInputs !== undefined &&
+      parsed.data.expectedFileRevision?.hash !== data.expectedHash) ||
+    JSON.stringify(parsed.data.document) !== JSON.stringify(after.board)
+  )
+    throw new Error("Committed native checkpoint receipt describes another mutation");
+  return { messageId: user.info.id, toolMessageId: receipt.info.id };
+}
+
+async function preparedRetryAnchors(
+  runtime: AgentRuntimeInternal,
+  data: NativeCheckpointData,
+  messages: MessageWithParts[],
+  after: NativeWhiteboardDocument,
+) {
+  const facts = effectiveWhiteboardInputFacts(data.effectiveInputs);
+  const candidates = messages.filter(
+    (message) =>
+      message.info.role === "assistant" &&
+      message.parts.some(
+        (part) =>
+          part.type === "tool" &&
+          part.tool === "WhiteboardUpdate" &&
+          part.state.status === "completed" &&
+          (data.effectiveInputs === undefined
+            ? part.state.input.mutationId === data.mutationId
+            : facts.some(
+                (fact) =>
+                  fact.toolCallId === part.callID &&
+                  fact.turnId ===
+                    messages.find(
+                      (user) =>
+                        user.info.id ===
+                        (message.info.role === "assistant" ? message.info.parentID : undefined),
+                    )?.info.anchor?.turnId,
+              )),
+      ),
+  );
+  if (candidates.length === 0) return { kind: "none" as const };
+  const proven = [];
+  for (const receipt of candidates) {
+    if (receipt.info.role !== "assistant") continue;
+    const anchors = await committedAnchors(
+      runtime,
+      { ...data, messageId: String(receipt.info.parentID), toolMessageId: String(receipt.info.id) },
+      messages,
+      after,
+    );
+    const user = messages.find((message) => message.info.id === anchors?.messageId);
+    const turnId = user?.info.anchor?.turnId;
+    if (anchors && typeof turnId === "string" && turnId) proven.push({ anchors, turnId });
+  }
+  // 完成 receipt 是原 Session 的确定事实。没有唯一的完整动作/trace，不能借旧失败 callId 猜 owner。
+  return proven.length === 1 && candidates.length === 1
+    ? { kind: "proven" as const, ...proven[0]! }
+    : { kind: "unresolved" as const };
+}
+
+export async function emitPreparedNativeWhiteboardCheckpoint(
+  runtime: AgentRuntimeInternal,
+  options: {
+    result: ToolExecutionResult;
+    messageId: MessageId;
+    toolMessageId?: MessageId;
+    traceContext: TraceContext;
+  },
+): Promise<boolean> {
+  if (options.result.toolName !== "WhiteboardUpdate" || !options.result.success) return false;
+  const output = options.result.output as {
+    preparedCheckpoint?: { journalId?: string; snapshotRef?: string };
+  };
+  const prepared = output?.preparedCheckpoint;
+  if (!prepared) return false;
+  const entry = (
+    await runtime.sessionStore!.sessionEntries!({
+      sessionID: runtime.sessionId,
+      type: NATIVE_WHITEBOARD_CHECKPOINT_ENTRY,
+    })
+  ).find((item) => item.id === prepared.journalId);
+  if (!entry) throw new Error("Native whiteboard checkpoint journal is missing");
+  const data = checkpointData(entry, String(runtime.sessionId));
+  if (data.snapshotRef !== prepared.snapshotRef)
+    throw new Error("Native checkpoint reference changed");
+  await publishCheckpoint(runtime, entry, data, options, options.traceContext);
+  return true;
+}
+
+/** Recovery observes existing file/receipt facts only. It never executes a tool or repeats a write. */
+export async function recoverNativeWhiteboardCheckpoints(
+  runtime: AgentRuntimeInternal,
+): Promise<void> {
+  if (
+    !runtime.sessionStore?.sessionEntries ||
+    !runtime.sessionStore.saveSessionEntry ||
+    !runtime.artifactStore ||
+    !runtime.fileSystemPort
+  )
+    return;
+  const messages = await runtime.sessionStore.messages({ sessionID: runtime.sessionId });
+  for (const entry of await runtime.sessionStore.sessionEntries({
+    sessionID: runtime.sessionId,
+    type: NATIVE_WHITEBOARD_CHECKPOINT_ENTRY,
+  })) {
+    const data = checkpointData(entry, String(runtime.sessionId));
+    if (data.status === "published") continue;
+    const { after } = await snapshotFor(runtime, data);
+    // 准备时的 callId 只证明原始 preimage。写失败后的重试可能由新 receipt 成功提交；
+    // committed 的持久 anchors 才证明实际成功动作，不能把撤销移回早先失败的动作。
+    let anchors =
+      data.status === "committed"
+        ? await committedAnchors(runtime, data, messages, after)
+        : undefined;
+    if (data.status === "committed" && !anchors) continue;
+    const retry =
+      data.status === "prepared"
+        ? await preparedRetryAnchors(runtime, data, messages, after)
+        : undefined;
+    if (retry?.kind === "unresolved") continue;
+    if (retry?.kind === "proven") anchors = retry.anchors;
+    const owner = anchors
+      ? messages.find((message) => message.info.id === anchors.toolMessageId)
+      : messages.find((message) =>
+          message.parts.some((part) => part.type === "tool" && part.callID === data.toolCallId),
+        );
+    if (!owner) continue; // Rewind/deletion removed the original action; never recreate it.
+    const part = owner.parts.find(
+      (part) => part.type === "tool" && part.callID === data.toolCallId,
+    );
+    if (!anchors && part?.type === "tool" && part.state.status === "error") continue;
+    let committed =
+      Boolean(anchors) ||
+      data.status === "committed" ||
+      (part?.type === "tool" && part.state.status === "completed");
+    if (!committed) {
+      try {
+        const read = await runtime.fileSystemPort.readTextFile({
+          path: resolve(runtime.workspaceRoot, data.filePath),
+          boundaryRoot: runtime.workspaceRoot,
+          maxBytes: WHITEBOARD_DOCUMENT_MAX_BYTES,
+        });
+        committed =
+          !read.truncated &&
+          JSON.stringify(parseNativeWhiteboardText(read.content)) === JSON.stringify(after);
+      } catch {
+        continue;
+      }
+    }
+    if (!committed) continue;
+    const userId = owner.info.role === "assistant" ? owner.info.parentID : owner.info.id;
+    if (!messages.some((message) => message.info.id === userId && message.info.role === "user"))
+      continue;
+    const turnId = retry?.kind === "proven" ? retry.turnId : data.turnId;
+    const trace = createChildTraceContext(
+      runtime.rootTraceContext,
+      turnId ? { turnId: turnId as TraceContext["turnId"] } : {},
+    );
+    await publishCheckpoint(
+      runtime,
+      entry,
+      data,
+      anchors ?? { messageId: userId, toolMessageId: owner.info.id },
+      trace,
+    );
+  }
+}
