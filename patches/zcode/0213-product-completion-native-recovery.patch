index 00000000..ee1f8d20
--- /dev/null
+++ b/packages/ui/src/hooks/useNativeWhiteboardWindowClose.ts
@@ -0,0 +1,86 @@
+import { useEffect, useRef } from "react";
+import type { IServiceAccessor } from "@zcode/services";
+import {
+  installNativeWhiteboardCloseBridge,
+  type NativeWhiteboardCloseBridge,
+} from "../lib/nativeWhiteboardCloseBridge.js";
+import {
+  nativeWhiteboardServices,
+  currentNativeWhiteboardWorkspace,
+} from "../lib/nativeWhiteboardServices.js";
+import { saveNativeWhiteboardDraft } from "../lib/nativeWhiteboardDraft.js";
+import { showNativeWhiteboardSession } from "../lib/nativeWhiteboardNavigation.js";
+import { useZCodeSessionStore } from "../store/zcodeSessionStore.js";
+import { requestNativeWhiteboardDraftClose } from "../lib/nativeWhiteboardClose.js";
+import { dirtyWhiteboardTargets } from "../lib/nativeWhiteboardClose.js";
+import { flushWhiteboardGestures } from "../lib/whiteboardGesture.js";
+import {
+  NATIVE_WHITEBOARD_PANE_CLOSE,
+  type NativeWhiteboardPaneCloseRequest,
+} from "../lib/nativeWhiteboardPaneClose.js";
+
+export function useNativeWhiteboardWindowClose(input: {
+  platform: NativeWhiteboardCloseBridge | null | undefined;
+  localServices: IServiceAccessor;
+  format: (id: string, values?: Record<string, string>) => string;
+}) {
+  const latest = useRef(input);
+  latest.current = input;
+  useEffect(() => {
+    const options: Pick<
+      Parameters<typeof requestNativeWhiteboardDraftClose>[0],
+      "format" | "save"
+    > = {
+      format: (id, values) => latest.current.format(id, values),
+      save: async (target) => {
+        try {
+          const currentTarget = { ...target, ...currentNativeWhiteboardWorkspace(target) };
+          const agent = nativeWhiteboardServices(
+            currentTarget,
+            latest.current.localServices,
+          ).zcodeAgentService;
+          return await saveNativeWhiteboardDraft({
+            target: currentTarget,
+            agent,
+            sessionId: useZCodeSessionStore
+              .getState()
+              .getWorkspaceState(target.workspacePath, target.workspaceIdentity).activeTaskId,
+            showSession: showNativeWhiteboardSession,
+            isCurrent: () =>
+              nativeWhiteboardServices(currentTarget, latest.current.localServices)
+                .zcodeAgentService === agent,
+          });
+        } catch {
+          return false;
+        }
+      },
+    };
+    const removeBridge = input.platform
+      ? installNativeWhiteboardCloseBridge(input.platform, options)
+      : () => {};
+    const paneClose = (event: Event) => {
+      const request = (event as CustomEvent<NativeWhiteboardPaneCloseRequest>).detail;
+      if (request.handled) return;
+      request.handled = true;
+      void requestNativeWhiteboardDraftClose({
+        ...options,
+        targets: request.targets,
+        isCurrent: request.isCurrent,
+      }).then(request.resolve, () => request.resolve(false));
+    };
+    window.addEventListener(NATIVE_WHITEBOARD_PANE_CLOSE, paneClose);
+    const beforeUnload = (event: BeforeUnloadEvent) => {
+      flushWhiteboardGestures();
+      if (dirtyWhiteboardTargets().length > 0) {
+        event.preventDefault();
+        event.returnValue = "";
+      }
+    };
+    window.addEventListener("beforeunload", beforeUnload);
+    return () => {
+      removeBridge();
+      window.removeEventListener(NATIVE_WHITEBOARD_PANE_CLOSE, paneClose);
+      window.removeEventListener("beforeunload", beforeUnload);
+    };
+  }, [input.platform]);
+}
