@@ -0,0 +1,57 @@
+// Same adapter owner; extracted directory-listing responsibility.
+import { readdir, stat } from "node:fs/promises";
+import { join } from "node:path";
+import {
+  createFileSystemError,
+  type FileSystemListDirectoryRequest,
+  type FileSystemListDirectoryResult,
+} from "@zcode/contracts";
+import { resolveNativeFileBoundary, assertNativeFileBoundary } from "./native-boundary.js";
+import { toFileSystemError, throwIfAborted } from "./file-errors.js";
+import { direntKind, resolveAbsoluteRequestPath } from "./file-values.js";
+
+export async function listNodeDirectory(
+  request: FileSystemListDirectoryRequest,
+  options?: { signal?: AbortSignal },
+): Promise<FileSystemListDirectoryResult> {
+  let path = resolveAbsoluteRequestPath(request.path);
+  const boundaryRoot = request.boundaryRoot;
+  const startedAt = Date.now();
+
+  try {
+    throwIfAborted(options?.signal);
+    const boundary =
+      boundaryRoot === undefined
+        ? undefined
+        : await resolveNativeFileBoundary(path, boundaryRoot, options?.signal);
+    if (boundary) path = boundary.path;
+    const info = await stat(path);
+    if (!info.isDirectory()) {
+      throw createFileSystemError({
+        code: "not_file",
+        path,
+        message: `Directory listing path must be a directory: ${path}`,
+      });
+    }
+
+    const entries = await readdir(path, { withFileTypes: true });
+    throwIfAborted(options?.signal);
+    if (boundary) await assertNativeFileBoundary(boundary, options?.signal);
+    const mapped = entries
+      .map((entry) => ({
+        kind: direntKind(entry),
+        name: entry.name,
+        path: join(path, entry.name),
+      }))
+      .sort((left, right) => left.name.localeCompare(right.name));
+
+    return {
+      path,
+      durationMs: Math.max(0, Date.now() - startedAt),
+      entries: mapped,
+      numEntries: mapped.length,
+    };
+  } catch (error) {
+    throw toFileSystemError(error, path);
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/fs/file-errors.ts b/apps/zcode-cli/packages/adapters/src/fs/file-errors.ts
