-      options.marketplace &&
-      declarationSource &&
-      knownRecord &&
-      !isDeepStrictEqual(knownRecord.source, declarationSource)
-    ) {
-      declarationDiagnostics.push(createMarketplaceSourceRepointDiagnostic(marketplaceId));
-      continue;
-    }
-    if (declarationSource && !knownRecord) {
