+test("automatic observer refresh stays bounded while the same board read is pending", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    hook = whiteboardProjectionHookFixture(),
+    held = Promise.withResolvers<WhiteboardControlResult>();
+  let calls = 0;
+  const agent = service(async () => {
+    calls++;
+    return calls === 1 ? held.promise : f.receipt("Committed");
+  });
+  try {
+    hook.render({
+      target: f.target,
+      agent,
+      sessionId: "original",
+      rpcReady: true,
+      showSession() {},
+    });
+    await tick();
+    for (let i = 0; i < 50; i++) hook.tick();
+    await tick();
+    assert.equal(calls, 1, "ticks cannot accumulate backend reads behind one pending observer");
+    held.resolve(f.receipt("Committed"));
+    await tick();
+    hook.tick();
+    await tick();
+    assert.equal(calls, 2, "settlement releases the original local observer token");
+  } finally {
+    held.resolve(f.receipt("Cleanup"));
+    hook.close();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("Session changes on the same board cannot accumulate observers or clear a renewed Host's pending token", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const f = fresh(),
+    hook = whiteboardProjectionHookFixture();
+  const first = Promise.withResolvers<WhiteboardControlResult>(),
+    renewed = Promise.withResolvers<WhiteboardControlResult>();
+  let oldCalls = 0,
+    newCalls = 0;
+  const old = service(async () => {
+    oldCalls++;
+    return first.promise;
+  });
+  const next = service(async () => {
+    newCalls++;
+    return renewed.promise;
+  });
+  const input = { target: f.target, rpcReady: true, showSession() {} };
+  try {
+    hook.render({ ...input, agent: old, sessionId: "A" });
+    await tick();
+    hook.render({ ...input, agent: old, sessionId: "B" });
+    await tick();
+    for (let i = 0; i < 20; i++) hook.tick();
+    await tick();
+    assert.equal(oldCalls, 1);
+    hook.render({ ...input, agent: next, sessionId: "B" });
+    await tick();
+    assert.equal(newCalls, 1);
+    first.resolve(f.receipt("Stale original Host"));
+    await tick();
+    for (let i = 0; i < 20; i++) hook.tick();
+    await tick();
+    assert.equal(newCalls, 1);
+    renewed.resolve(f.receipt("Committed"));
+    await tick();
+    assert.equal(store.getState().getBoard(f.target)?.name, "Committed");
+  } finally {
+    first.resolve(f.receipt("Cleanup"));
+    renewed.resolve(f.receipt("Cleanup"));
+    hook.close();
+    t.mock.timers.tick(30_001);
+  }
+});
diff --git a/packages/ui/test/nativeWhiteboardQueuedStop.test.ts b/packages/ui/test/nativeWhiteboardQueuedStop.test.ts
new file mode 100644
index 00000000..3d7ae440
--- /dev/null
+++ b/packages/ui/test/nativeWhiteboardQueuedStop.test.ts
@@ -0,0 +1,262 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { zcodeProtocolMethods as M, whiteboardRelativePath } from "@zcode/shared";
+import { nativePresentationHost, waitFor } from "./helpers/nativePresentationHost.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+
+test("queued native Stop intent waits for its original foreground and sends one targeted Stop", async (t) => {
+  const h = await nativePresentationHost("whiteboard");
+  store.setState({ ...store.getInitialState() }, true);
+  const created = await h.request(M.sessionCreate, {
+    workspace: h.workspace,
+    persistence: "deferred",
+  });
+  const sessionId = created.session.sessionId,
+    pane = h.observer.layer.acquire(sessionId);
+  await waitFor(() => pane.store.hasCurrentSubscriptionProjection(), "real initial projection");
+  const originalRead = h.store.getSession.bind(h.store),
+    entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  let hold = true;
+  h.store.getSession = async (id) => {
+    if (hold) {
+      hold = false;
+      entered.resolve();
+      await release.promise;
+    }
+    return originalRead(id);
+  };
+  const ordinary = h.request(M.sessionRead, { sessionId });
+  await entered.promise;
+  let forwarded = 0;
+  const native = h.agent.performWhiteboardControl.bind(h.agent),
+    command = h.agent.sendConversationCommandV4.bind(h.agent);
+  const stops: Array<{ sessionId: string | null; expectedForegroundExecutionId?: string }> = [];
+  h.agent.performWhiteboardControl = (input) => {
+    forwarded++;
+    return native(input);
+  };
+  h.agent.sendConversationCommandV4 = async (input) => {
+    if (input.envelope.type === "stop")
+      stops.push({
+        sessionId: input.envelope.sessionId,
+        expectedForegroundExecutionId: input.envelope.payload.expectedForegroundExecutionId,
+      });
+    return command(input);
+  };
+  const board = store
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned queued Stop" }),
+    target = { ...h.workspace, boardId: board.id },
+    controller = new AbortController();
+  let settled = false;
+  const saving = saveNativeWhiteboardDraft({
+    target,
+    agent: h.agent,
+    sessionId,
+    abortSignal: controller.signal,
+    showSession() {},
+  }).then((result) => {
+    settled = true;
+    return result;
+  });
+  try {
+    await waitFor(() => forwarded === 1, "public native RPC sent");
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+    assert.ok(pending);
+    assert.equal(h.methods.includes(M.sessionWhiteboardControl), false);
+    controller.abort();
+    await Promise.resolve();
+    assert.equal(stops.length, 0, "Sending is not actual foreground admission");
+    assert.equal(
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending,
+      pending,
+    );
+    release.resolve();
+    await ordinary;
+    await waitFor(() => settled, "real targeted Stop settles original actor");
+    assert.equal(await saving, false);
+    assert.deepEqual(stops, [
+      { sessionId, expectedForegroundExecutionId: `native-whiteboard:${pending.requestId}` },
+    ]);
+    assert.equal(h.methods.filter((method) => method === M.sessionWhiteboardControl).length, 1);
+    const projection = store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!;
+    assert.equal(projection.pending, undefined);
+    assert.equal(projection.committed, undefined);
+    assert.equal(store.getState().getBoard(target), board);
+    assert.ok(["whiteboard.saveStopped", "whiteboard.saveUnapproved"].includes(projection.error!));
+    await assert.rejects(readFile(join(target.workspacePath, whiteboardRelativePath(board.id))), {
+      code: "ENOENT",
+    });
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    release.resolve();
+    await ordinary;
+    if (!settled) {
+      await waitFor(() => settled || !!h.permission, "owned fixture rescue");
+      if (h.permission) h.answer("deny");
+    }
+    await saving;
+    pane.release();
+    await h.close(t);
+  }
+});
+
+test("a failed exact Stop delivery preserves pending until the actual authorized receipt", async (t) => {
+  const h = await nativePresentationHost("whiteboard"),
+    controller = new AbortController();
+  store.setState({ ...store.getInitialState() }, true);
+  const board = store
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned uncertain Stop" }),
+    target = { ...h.workspace, boardId: board.id };
+  const original = h.agent.sendConversationCommandV4.bind(h.agent);
+  let stops = 0;
+  const failures: unknown[] = [];
+  h.agent.sendConversationCommandV4 = async (input) => {
+    if (input.envelope.type === "stop") {
+      stops++;
+      throw new Error("Owned Stop delivery failed");
+    }
+    return original(input);
+  };
+  let settled = false;
+  const saving = saveNativeWhiteboardDraft({
+    target,
+    agent: h.agent,
+    abortSignal: controller.signal,
+    onStopError: (error) => failures.push(error),
+    showSession() {},
+  }).then((result) => {
+    settled = true;
+    return result;
+  });
+  try {
+    await waitFor(() => !!h.permission, "actual original approval");
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending;
+    controller.abort();
+    await waitFor(() => failures.length === 1, "visible Stop delivery failure");
+    assert.equal(stops, 1);
+    assert.equal(settled, false);
+    assert.equal(
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending,
+      pending,
+    );
+    controller.abort();
+    assert.equal(stops, 1);
+    h.answer("allow");
+    assert.equal(await saving, true);
+    const file = JSON.parse(
+      await readFile(join(target.workspacePath, whiteboardRelativePath(board.id)), "utf8"),
+    );
+    assert.deepEqual(file.board, board);
+    assert.equal(stops, 1);
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    if (!settled && h.permission) h.answer("deny");
+    await saving;
+    await h.close(t);
+  }
+});
+
+test("an aborted intent rechecks the original retained native foreground after resume ACK unwinds", async (t) => {
+  const { nativePresentationResume } = await import("./helpers/nativePresentationResume.js");
+  const { watchNativeDispatchCancellation } =
+    await import("../src/lib/nativeSessionDispatchCancellation.js");
+  const { stopNativeWhiteboardControl } = await import("../src/lib/nativeWhiteboardControl.js");
+  const h = await nativePresentationHost("whiteboard");
+  store.setState({ ...store.getInitialState() }, true);
+  const board = store
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned resume Stop" }),
+    target = { ...h.workspace, boardId: board.id };
+  let sessionId: string | undefined,
+    settled = false,
+    stops = 0;
+  const saving = saveNativeWhiteboardDraft({
+    target,
+    agent: h.agent,
+    showSession: (_, id) => {
+      sessionId = id;
+    },
+  }).then((result) => {
+    settled = true;
+    return result;
+  });
+  let pane: ReturnType<typeof h.observer.layer.acquire> | undefined,
+    resume: ReturnType<typeof nativePresentationResume> | undefined,
+    dispose: (() => void) | undefined;
+  try {
+    await waitFor(() => !!h.permission && !!sessionId, "real Host native permission");
+    pane = h.observer.layer.acquire(sessionId!);
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+    const expected = `native-whiteboard:${pending.requestId}`;
+    await waitFor(
+      () =>
+        !!pane!.store
+          .getState()
+          .snapshot?.control.activeWorks.some((work) => work.foregroundExecutionId === expected),
+      "actual original Host foreground identity",
+    );
+    const captured = pane.store.getState().snapshot!;
+    // The resume carrier is authored; native authority below is unchanged real Host data.
+    resume = nativePresentationResume(captured);
+    await resume.store.connect();
+    const signal = new AbortController();
+    const first = resume.store.getState().subscriptionId;
+    let abortAtAck = false;
+    const off = resume.store.subscribe(() => {
+      if (
+        !abortAtAck &&
+        resume!.store.getState().status === "live" &&
+        resume!.store.getState().subscriptionId !== first
+      ) {
+        abortAtAck = true;
+        signal.abort();
+        assert.equal(resume!.store.hasCurrentSubscriptionProjection(), false);
+      }
+    });
+    dispose = watchNativeDispatchCancellation(resume.store, resume.transport, sessionId!, {
+      signal: signal.signal,
+      foregroundExecutionId: expected,
+      requestStop: async () => {
+        stops++;
+        await stopNativeWhiteboardControl(h.agent, target, sessionId!, pending.requestId);
+      },
+    });
+    await resume.store.connect();
+    off();
+    assert.equal(abortAtAck, true);
+    assert.equal(resume.store.getState().snapshot, captured);
+    assert.equal(resume.store.hasCurrentSubscriptionProjection(), true);
+    // No nudge frame and no authored Deny: only a post-unwind read can deliver this Stop.
+    await waitFor(() => settled, "post-unwind actual targeted Stop receipt");
+    assert.equal(await saving, false);
+    assert.equal(stops, 1);
+    assert.equal(store.getState().getBoard(target), board);
+    await assert.rejects(readFile(join(target.workspacePath, whiteboardRelativePath(board.id))), {
+      code: "ENOENT",
+    });
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    dispose?.();
+    await resume?.close();
+    if (!settled && sessionId) {
+      const pending =
+        store.getState().workspaces[target.workspacePath]?.nativeById?.[board.id]?.pending;
+      if (pending) await stopNativeWhiteboardControl(h.agent, target, sessionId, pending.requestId);
+    }
+    await saving;
+    pane?.release();
+    await h.close(t);
+  }
+});
diff --git a/packages/ui/test/nativeWorkbench.browser.test.tsx b/packages/ui/test/nativeWorkbench.browser.test.tsx
