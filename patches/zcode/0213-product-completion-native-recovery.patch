+import {
+  handle,
+  query,
+  pinLiveInput,
+  releaseLiveInput,
+  hasPinnedSessionState,
+  clearSession,
+  queryOne,
+  lookupExact,
+} from "./command-inbox-admission.js";
+import { decide, retryAck, queryUnavailableAck, ackOnly } from "./command-inbox-decision.js";
+import {
+  bucketKey,
+  keyGateKey,
+  mapFor,
+  touchSettled,
+  rememberSettled,
+  extractCommandId,
+} from "./command-inbox-settlement.js";
+import type { CommandInboxOwner } from "./command-inbox-owner.js";
+
+export function installCommandInboxMethods(prototype: CommandInboxOwner): void {
+  const methods = {
+    handle,
+    query,
+    pinLiveInput,
+    releaseLiveInput,
+    hasPinnedSessionState,
+    clearSession,
+    queryOne,
+    lookupExact,
+    decide,
+    retryAck,
+    queryUnavailableAck,
+    ackOnly,
+    bucketKey,
+    keyGateKey,
+    mapFor,
+    touchSettled,
+    rememberSettled,
+    extractCommandId,
+  };
+  Object.defineProperties(
+    prototype,
+    Object.fromEntries(
+      Object.entries(methods).map(([name, value]) => [
+        name,
+        { value, writable: true, configurable: true, enumerable: false },
+      ]),
+    ),
+  );
+}
