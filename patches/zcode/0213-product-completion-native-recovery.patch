-      code: "not_file",
-      path,
-      message: `Grep search path must be a file or directory: ${path}`,
-    });
-  }
-
-  await walkFiles(root, signal, addIfCandidate);
-  candidates.sort((left, right) => left.path.localeCompare(right.path));
