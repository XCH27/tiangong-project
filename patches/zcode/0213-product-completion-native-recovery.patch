+++ b/packages/ui/test/nativePluginViewControl.test.ts
@@ -0,0 +1,225 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type {
+  IZCodeAgentService,
+  IPluginManagementService,
+  IServiceAccessor,
+} from "@zcode/services";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import { callNativePluginViewTool } from "../src/lib/nativePluginViewControl.js";
+import {
+  NATIVE_WHITEBOARD_SESSION_NAVIGATION,
+  NATIVE_WHITEBOARD_PRESERVE_TAB,
+  type NativeSurfaceNavigation,
+} from "../src/lib/nativeWhiteboardNavigation.js";
+
+import { useRemoteWorkspaceSessionStore as remote } from "../src/store/remoteWorkspaceSessionStore.js";
+
+let events: EventTarget;
+let priorWindow: PropertyDescriptor | undefined;
+test.beforeEach((t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  remote.setState({ ...remote.getInitialState() }, true);
+  priorWindow = Object.getOwnPropertyDescriptor(globalThis, "window");
+  events = new EventTarget();
+  Object.defineProperty(globalThis, "window", { configurable: true, value: events });
+});
+test.afterEach((t) => {
+  t.mock.timers.tick(30_001);
+  remote.setState({ ...remote.getInitialState() }, true);
+  if (priorWindow) Object.defineProperty(globalThis, "window", priorWindow);
+  else Reflect.deleteProperty(globalThis, "window");
+});
+function fixture() {
+  const order: string[] = [];
+  const commands: Array<Parameters<IZCodeAgentService["sendConversationCommandV4"]>[0]> = [];
+  const calls: Array<Parameters<IPluginManagementService["callPluginViewTool"]>[0]> = [];
+  const target = {
+    workspacePath: `/plugin-native-${crypto.randomUUID()}`,
+    pluginId: "authored@market",
+    viewId: "write-view",
+  };
+  let gate: Promise<void> | undefined;
+  const agent = {
+    ...nativePresentationAgent().agent,
+    async sendConversationCommandV4(
+      input: Parameters<IZCodeAgentService["sendConversationCommandV4"]>[0],
+    ) {
+      commands.push(input);
+      order.push("create");
+      await gate;
+      return {
+        status: "accepted",
+        result: { type: "createSession", sessionId: "original-empty-session" },
+      };
+    },
+  } as unknown as IZCodeAgentService;
+  const result = {
+    content: [{ type: "text", text: "authored SDK reply" }],
+    structuredContent: { value: 1 },
+    isError: true,
+  };
+  const plugins = {
+    async callPluginViewTool(input: Parameters<IPluginManagementService["callPluginViewTool"]>[0]) {
+      calls.push(input);
+      order.push("call");
+      return result;
+    },
+  } as unknown as IPluginManagementService;
+  events.addEventListener(NATIVE_WHITEBOARD_PRESERVE_TAB, () => order.push("preserve"));
+  const navigate = (event: Event) => {
+    const detail = (event as CustomEvent<NativeSurfaceNavigation>).detail;
+    assert.deepEqual(detail.target, target);
+    assert.ok(!("boardId" in detail.target));
+    order.push("navigate");
+    detail.handled = true;
+  };
+  events.addEventListener(NATIVE_WHITEBOARD_SESSION_NAVIGATION, navigate);
+  return {
+    target,
+    agent,
+    plugins,
+    result,
+    order,
+    commands,
+    calls,
+    navigate,
+    hold(value: Promise<void>) {
+      gate = value;
+    },
+    input: {
+      target,
+      agent,
+      plugins,
+      tool: "write_local",
+      arguments: { value: 1 },
+      isCurrent: () => true,
+    },
+  };
+}
+
+test("provided original Session navigates before single tool call and retains raw SDK reply", async () => {
+  const f = fixture();
+  assert.equal(
