@@ -0,0 +1,89 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import { AgentRuntime } from "../src/runtime/agent-runtime.js";
+import type { Model } from "@zcode/contracts";
+
+// The shared turn fixture emits deltas only. Compaction requires a committed text block.
+function withCommittedText(model: Model): Model {
+  return {
+    ...model,
+    bind(options) {
+      return withCommittedText(model.bind(options));
+    },
+    async *streamText(request) {
+      for await (const event of model.streamText(request)) {
+        if (event.type === "finish") yield { type: "text_end", id: "authored-text" };
+        yield event.type === "text_delta" ? { ...event, id: "authored-text" } : event;
+      }
+    },
+  };
+}
+class CommittedTextRuntime extends AgentRuntime {
+  constructor(...[id, config, deps]: ConstructorParameters<typeof AgentRuntime>) {
+    super(id, config, {
+      ...deps,
+      modelFactory: (input) => withCommittedText(deps.modelFactory(input)),
+    });
+  }
+}
+
+test("public compact commits one SQLite boundary and cold context before the next turn", async () => {
+  const f = await fixture(undefined, false, { runtimeConstructor: CommittedTextRuntime });
+  try {
+    f.steps.push(
+      () => reply("first authored reply"),
+      () => reply("second authored reply"),
+    );
+    await f.runtime.executeTurn("first authored input");
+    await f.runtime.executeTurn("second authored input");
+    f.steps.push(() => reply("Authored compact summary: keep the two user requests."));
+    const result = await f.runtime.executeTurn("/compact retain authored facts");
+    assert.equal(result.response, "Compacted");
+    const persisted = await f.store.messages({ sessionID: f.runtime.sessionId });
+    assert.match(JSON.stringify(persisted), /Authored compact summary/);
+    const before = JSON.stringify(persisted);
+    await f.reopen();
+    assert.equal(
+      JSON.stringify(await f.store.messages({ sessionID: f.runtime.sessionId })),
+      before,
+    );
+    f.steps.push(() => reply("continued from compact context"));
+    await f.runtime.executeTurn("continue authored task");
+    assert.match(JSON.stringify(f.requests.at(-1)!.messages), /Authored compact summary/);
+    assert.equal(f.requests.length, 4);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("rejected compact summary leaves original SQLite conversation available after reopen", async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(
+      () => reply("first reply"),
+      () => reply("second reply"),
+    );
+    await f.runtime.executeTurn("first input");
+    await f.runtime.executeTurn("second input");
+    f.steps.push(() =>
+      reply("", [{ id: "forbidden-compact-tool", name: "Probe", input: { value: "never" } }]),
+    );
+    await assert.rejects(f.runtime.executeTurn("/compact"), (error: Error & { cause?: Error }) => {
+      assert.equal(error.message, "Compact failed");
+      assert.match(error.cause!.message, /Tool use is not allowed during compaction/);
+      return true;
+    });
+    await f.reopen();
+    const persisted = await f.store.messages({ sessionID: f.runtime.sessionId });
+    assert.match(JSON.stringify(persisted), /first input/);
+    assert.match(JSON.stringify(persisted), /second reply/);
+    assert.equal(f.effects, 0);
+    f.steps.push(() => reply("continued after refusal"));
+    await f.runtime.executeTurn("continue");
+    assert.match(JSON.stringify(f.requests.at(-1)!.messages), /first input/);
+  } finally {
+    await f.close();
+  }
+});
