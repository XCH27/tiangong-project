--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-persistence.ts
@@ -0,0 +1,187 @@
+import {
+  createMessageId,
+  createPartId,
+  type MessageId,
+  type ToolCall,
+  type ToolExecutionResult,
+  type TraceContext,
+} from "../deps.js";
+import type { ToolPart } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { emptyTokenUsageInfo } from "../helpers/index.js";
+import { modelContentForToolResult } from "../helpers/tool-result.js";
+import { completedToolPartMetadata } from "./tool-part-metadata.js";
+import { buildProjectionAnchor } from "./projection-anchor.js";
+import { createNativePluginOperationEntry } from "./native-plugin-operation.js";
+
+export interface NativeToolPresentation {
+  source: "native_whiteboard" | "native_plugin_view";
+  agent: string;
+}
+
+/** A system-owned tool receipt is visible evidence, never fabricated model output or provider context. */
+export async function persistNativeToolStart(
+  runtime: AgentRuntimeInternal,
+  call: ToolCall,
+  summary: string,
+  trace: TraceContext,
+  presentation: NativeToolPresentation,
+  operationId?: string,
+) {
+  const userId = createMessageId();
+  const receiptId = createMessageId();
+  const partId = createPartId();
+  const started = Date.now();
+  const artifact = await runtime.artifactStore!.writeToolResultArtifact({
+    sessionId: runtime.sessionId,
+    turnId: trace.turnId,
+    toolCallId: call.id,
+    toolName: call.name,
+    content: JSON.stringify(call.input),
+    contentType: "application/vnd.zcode.native-action-input+json",
+    retention: "session",
+    trace,
+  });
+  const input = {
+    inputRef: artifact.uri,
+    operation: call.name,
+    ...(typeof call.input === "object" && call.input
+      ? Object.fromEntries(
+          Object.entries(call.input).filter(([key]) => key === "boardId" || key === "mutationId"),
+        )
+      : {}),
+  };
+  const action = {
+    toolName: call.name,
+    inputRef: artifact.uri,
+    ...(operationId ? { operationId } : {}),
+  };
+  if (presentation.source === "native_plugin_view") {
+    if (!operationId || !runtime.sessionStore?.saveSessionEntryOnce)
+      throw new Error("Native plugin control needs atomic durable original Session admission");
+    const admitted = await runtime.sessionStore.saveSessionEntryOnce(
+      createNativePluginOperationEntry(runtime, call, trace, artifact.uri, operationId),
+    );
+    if (!admitted.created)
+      throw Object.assign(
+        new Error("Native plugin operation was already accepted; inspect the original receipt"),
+        { code: "native_operation_already_recorded" },
+      );
+  }
+  await runtime.persistMessage(
+    {
+      id: userId,
+      sessionID: runtime.sessionId,
+      role: "user",
+      time: { created: started },
+      agent: "human",
+      anchor: buildProjectionAnchor(trace, "realUser"),
+      metadata: { executionKind: "controlOnly", nativeAction: action },
+      semantics: {
+        origin: "real_user",
+        kind: "user_prompt",
+        source: presentation.source,
+        uiVisibility: "visible",
+        providerVisibility: "hidden",
+        transcriptVisibility: "visible",
+      },
+    },
+    trace,
+  );
+  await runtime.persistPart(
+    {
+      id: createPartId(),
+      sessionID: runtime.sessionId,
+      messageID: userId,
+      type: "text",
+      text: summary,
+      time: { start: started, end: started },
+    },
+    trace,
+  );
+  runtime.latestConversationMessageId = userId;
+  await runtime.persistMessage(
+    {
+      id: receiptId,
+      sessionID: runtime.sessionId,
+      parentID: userId,
+      role: "assistant",
+      time: { created: started },
+      mode: runtime.config.mode ?? "build",
+      planEnabled: runtime.getPlanEnabled(),
+      agent: presentation.agent,
+      path: { cwd: runtime.workingDirectory, root: runtime.workspaceRoot },
+      cost: 0,
+      tokens: emptyTokenUsageInfo(),
+      semantics: {
+        origin: "system",
+        kind: "timeline_event",
+        source: presentation.source,
+        uiVisibility: "visible",
+        providerVisibility: "hidden",
+        transcriptVisibility: "visible",
+      },
+      metadata: { nativeAction: action, executionKind: "controlOnly" },
+    },
+    trace,
+  );
+  const pending: ToolPart = {
+    id: partId,
+    sessionID: runtime.sessionId,
+    messageID: receiptId,
+    type: "tool",
+    callID: call.id,
+    declarationIndex: 0,
+    tool: call.name,
+    metadata: {
+      nativeAction: true,
+      inputRef: artifact.uri,
+      actor: "human",
+      ...(operationId ? { operationId } : {}),
+    },
+    state: { status: "pending", input, raw: JSON.stringify(input) },
+  };
+  await runtime.persistPart(pending, trace);
+  return { userId, receiptId, pending, started };
+}
+
+export async function persistNativeToolResult(
+  runtime: AgentRuntimeInternal,
+  pending: ToolPart,
+  result: ToolExecutionResult,
+  trace: TraceContext,
+) {
+  const output = modelContentForToolResult(result);
+  const text = typeof output === "string" ? output : JSON.stringify(output);
+  const part: ToolPart = {
+    ...pending,
+    state: result.success
+      ? {
+          status: "completed",
+          input: pending.state.input,
+          output: text,
+          title: result.toolName,
+          metadata: { ...completedToolPartMetadata(result), nativeAction: true },
+          time: { start: result.startedAt.getTime(), end: result.completedAt.getTime() },
+        }
+      : {
+          status: "error",
+          input: pending.state.input,
+          error: result.error?.message ?? text,
+          metadata: {
+            nativeAction: true,
+            ...(result.lateSettlement ? { lateSettlement: "pending" } : {}),
+          },
+          time: { start: result.startedAt.getTime(), end: result.completedAt.getTime() },
+        },
+  };
+  await runtime.persistPart(part, trace);
+  return part;
+}
+
+export type NativeToolReceiptAnchor = {
+  userId: MessageId;
+  receiptId: MessageId;
+  pending: ToolPart;
+  started: number;
+};
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-whiteboard-checkpoint.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-whiteboard-checkpoint.ts
