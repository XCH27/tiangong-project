+  assert.equal(repaired.snapshot.graph.nodes[0].status, "pending");
+  assert.equal(repaired.snapshot.graph.nodes[1].status, "active");
+  assert.equal(repaired.snapshot.activities[0].completedAt, "repair");
+  assert.equal(repaired.snapshot.activities[1].status, "active");
+  const cancelled = cancelWorkflowSnapshot(repaired.snapshot, { timestamp: "cancel" });
+  assert.equal(cancelled.snapshot.activities[0].completedAt, "repair");
+  assert.equal(cancelled.snapshot.activities[1].completedAt, "cancel");
+  assert.equal(JSON.stringify(snapshot), input);
+});
