--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-return-resolve-prompt-attachment-preview-source.ts
@@ -0,0 +1,52 @@
+import type { ToolArtifactStorePort } from "@zcode/contracts";
+
+import { isAbsolute } from "node:path";
+
+import type { ZCodeApp } from "./types.js";
+
+export function createAppReturnResolvePromptAttachmentPreviewSource(factoryBindings: {
+  readonly resolvePromptAttachment: (input: {
+    ref: string;
+    mime: string;
+    messageId?: string;
+    toolCallId?: string;
+    attachmentIndex?: number;
+  }) => Promise<{ ref: string; mediaType: string; artifactUri?: string }>;
+  readonly artifactStore: ToolArtifactStorePort;
+}): ZCodeApp["resolvePromptAttachmentPreviewSource"] {
+  return (
+    {
+      resolvePromptAttachmentPreviewSource: async (input) => {
+        const resolved = await factoryBindings.resolvePromptAttachment(input);
+        if (!resolved.mediaType.startsWith("video/")) return { kind: "chunked" };
+        if (resolved.artifactUri) {
+          if (!factoryBindings.artifactStore.ensureMediaAttachmentPath) return { kind: "chunked" };
+          try {
+            const materialized = await factoryBindings.artifactStore.ensureMediaAttachmentPath({
+              uri: resolved.artifactUri,
+              mediaType: resolved.mediaType,
+            });
+            if (materialized.status === "ready" && materialized.path.trim()) {
+              return {
+                kind: "local_path",
+                path: materialized.path,
+                mediaType: resolved.mediaType,
+              };
+            }
+          } catch {
+            // artifact 仍是不可变事实；派生文件失败只允许 gateway 回到 artifact chunk。
+          }
+          return { kind: "chunked" };
+        }
+        if (isAbsolute(resolved.ref)) {
+          return {
+            kind: "local_path",
+            path: resolved.ref,
+            mediaType: resolved.mediaType,
+          };
+        }
+        return { kind: "chunked" };
+      },
+    } satisfies Pick<ZCodeApp, "resolvePromptAttachmentPreviewSource">
+  ).resolvePromptAttachmentPreviewSource;
+}
