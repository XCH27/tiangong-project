+import assert from "node:assert/strict";
+import test from "node:test";
+import { ownedMcpFixture } from "./helpers/owned-mcp-fixture.js";
+import {
+  withMcpDispatchAvailability,
+  withMcpDispatchFetch,
+} from "../src/mcp/dispatch-availability.js";
+
+test("the real SDK awaits an async availability rejection before a tool or resource request", async () => {
+  const x = await ownedMcpFixture();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    const options = {
+      expectedServerConfig: x.original,
+      assertAvailable: async () => {
+        await Promise.resolve();
+        throw new Error("Owned availability withdrawn");
+      },
+    };
+    await assert.rejects(
+      x.mcp.callTool({ serverName: "counter", toolName: "increment", arguments: {} }, options),
+      /withdrawn/,
+    );
+    await assert.rejects(x.mcp.readResource!("counter", "ui://owned/main", options), /withdrawn/);
+    assert.equal(await x.effectCalls(), 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("the real stdio send gate awaits late async rejection after all initial adapter checks pass", async () => {
+  const x = await ownedMcpFixture();
+  let checks = 0;
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    await assert.rejects(
+      x.mcp.callTool(
+        { serverName: "counter", toolName: "increment", arguments: {} },
+        {
+          expectedServerConfig: x.original,
+          assertAvailable: async () => {
+            if (++checks <= 3) return;
+            await Promise.resolve();
+            throw new Error("Owned late dispatch withdrawn");
+          },
+        },
+      ),
+      /late dispatch withdrawn/,
+    );
+    assert.ok(checks >= 4, "the actual SDK transport send gate must execute");
+    assert.equal(await x.effectCalls(), 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("async availability waits consume the original call deadline without sending an SDK effect", async () => {
+  const x = await ownedMcpFixture(),
+    release = Promise.withResolvers<void>();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    await assert.rejects(
+      x.mcp.callTool(
+        { serverName: "counter", toolName: "increment", arguments: {} },
+        {
+          timeoutMs: 30,
+          expectedServerConfig: x.original,
+          assertAvailable: async () => {
+            await release.promise;
+            throw new Error("Owned late checker failure");
+          },
+        },
+      ),
+      /timed out/,
+    );
+    assert.equal(await x.effectCalls(), 0);
+  } finally {
+    release.resolve();
+    await x.close();
+  }
+});
+
+test("Stop interrupts the async availability waiter and leaves its original SDK connection alive", async () => {
+  const x = await ownedMcpFixture(),
+    release = Promise.withResolvers<void>(),
+    entered = Promise.withResolvers<void>();
+  const controller = new AbortController();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    const call = x.mcp.callTool(
+      { serverName: "counter", toolName: "increment", arguments: {} },
+      {
+        signal: controller.signal,
+        expectedServerConfig: x.original,
+        assertAvailable: async () => {
+          entered.resolve();
+          await release.promise;
+        },
+      },
+    );
+    await entered.promise;
+    const rejected = assert.rejects(call, /Owned Stop/);
+    controller.abort(new Error("Owned Stop"));
+    await rejected;
+    assert.equal(await x.effectCalls(), 0);
+    assert.equal((await x.mcp.status()).counter?.status, "connected");
+  } finally {
+    release.resolve();
+    await x.close();
+  }
+});
+
+test("a current configuration change during an awaited availability check refuses the former owner", async () => {
+  const x = await ownedMcpFixture();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    await assert.rejects(
+      x.mcp.callTool(
+        { serverName: "counter", toolName: "increment", arguments: {} },
+        {
+          expectedServerConfig: x.original,
+          assertAvailable: async () => {
+            await x.mcp.connectServer("counter", x.config("replacement"), {
+              workingDirectory: x.f.dir,
+            });
+          },
+        },
+      ),
+      /configuration changed/i,
+    );
+    assert.equal(await x.effectCalls(), 0);
+    assert.equal(await x.count("replacement"), 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("the existing HTTP dispatch wrapper awaits rejected async availability before its authored fetch", async () => {
+  let sends = 0;
+  const fetch = withMcpDispatchFetch(async () => {
+    sends++;
+    return new Response("{}");
+  });
+  await assert.rejects(
+    withMcpDispatchAvailability(
+      async () => {
+        throw new Error("Owned HTTP dispatch withdrawn");
+      },
+      () =>
+        fetch("https://owned.invalid", {
+          method: "POST",
+          body: JSON.stringify({ method: "tools/call" }),
+        }),
+    ),
+    /withdrawn/,
+  );
+  assert.equal(sends, 0);
+});
+
+test("a real peer error named Not connected preserves its first external effect without SDK retry", async () => {
+  const x = await ownedMcpFixture();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
+    await assert.rejects(
+      x.mcp.callTool(
+        { serverName: "counter", toolName: "effect_then_error", arguments: {} },
+        { expectedServerConfig: x.original },
+      ),
+      (error: unknown) =>
+        (error as { name: string; code: unknown; message: string }).name === "ProtocolError" &&
+        (error as { code: unknown }).code === -32603 &&
+        (error as Error).message === "Not connected",
