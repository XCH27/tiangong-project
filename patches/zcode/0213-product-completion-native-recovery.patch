+++ b/apps/zcode-cli/packages/bootstrap/test/native-foreground-host.test.ts
@@ -0,0 +1,167 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { whiteboardRelativePath, zcodeProtocolMethods as M } from "@zcode/shared";
+import {
+  nativePresentationHost,
+  waitFor,
+} from "../../../../../packages/ui/test/helpers/nativePresentationHost.js";
+import { saveNativeWhiteboardDraft } from "../../../../../packages/ui/src/lib/nativeWhiteboardDraft.js";
+import { stopNativeWhiteboardControl } from "../../../../../packages/ui/src/lib/nativeWhiteboardControl.js";
+import { useWhiteboardStore as boards } from "../../../../../packages/ui/src/store/whiteboardStore.js";
+
+for (const decision of ["allow", "deny"] as const) {
+  test(`actual native foreground identity and ${decision} terminal stay on the original public Host projection`, async (t) => {
+    const h = await nativePresentationHost("whiteboard");
+    boards.setState({ ...boards.getInitialState() }, true);
+    const board = boards
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned foreground" });
+    const target = { ...h.workspace, boardId: board.id };
+    let sessionId: string | undefined;
+    const saving = saveNativeWhiteboardDraft({
+      target,
+      agent: h.agent,
+      onSessionResolved: (id) => {
+        sessionId = id;
+      },
+      showSession() {},
+    });
+    try {
+      await waitFor(() => !!h.permission, "actual permission request");
+      assert.ok(sessionId);
+      const lease = h.observer.layer.acquire(sessionId);
+      try {
+        const pending =
+          boards.getState().workspaces[h.workspace.workspacePath]!.nativeById![board.id]!.pending!;
+        await waitFor(
+          () =>
+            lease.store.getState().snapshot?.control.activeWorks[0]?.foregroundExecutionId ===
+            `native-whiteboard:${pending.requestId}`,
+          "exact original foreground projection",
+        );
+        const control = lease.store.getState().snapshot!.control;
+        assert.equal(control.canStop, true);
+        assert.equal(control.stopTargetKind, "tool");
+        assert.equal(control.steerable, false);
+        h.answer(decision);
+        assert.equal(await saving, decision === "allow");
+        await waitFor(
+          () => lease.store.getState().snapshot?.control.activeWorks.length === 0,
+          "actual native terminal",
+        );
+        assert.equal(lease.store.getState().snapshot?.control.canStop, false);
+        if (decision === "allow")
+          assert.deepEqual(
+            JSON.parse(
+              await readFile(
+                join(h.workspace.workspacePath, whiteboardRelativePath(board.id)),
+                "utf8",
+              ),
+            ).board,
+            board,
+          );
+        else
+          await assert.rejects(
+            readFile(join(h.workspace.workspacePath, whiteboardRelativePath(board.id))),
+            { code: "ENOENT" },
+          );
+        assert.equal(h.f.calls.length, 0);
+        assert.equal(h.f.httpCalls, 0);
+      } finally {
+        lease.release();
+      }
+    } finally {
+      if (h.permission) h.answer("deny");
+      await saving;
+      await h.close(t);
+    }
+  });
+}
+
+test("queued cancellation intent observes exact admission and sends one real Stop without an authored Deny or write", async (t) => {
+  const h = await nativePresentationHost("whiteboard");
+  boards.setState({ ...boards.getInitialState() }, true);
+  const created = await h.request(M.sessionCreate, {
+    workspace: h.workspace,
+    persistence: "deferred",
+  });
+  const sessionId: string = created.session.sessionId,
+    pane = h.observer.layer.acquire(sessionId);
+  await waitFor(() => pane.store.hasCurrentSubscriptionProjection(), "original current projection");
+  const get = h.store.getSession.bind(h.store),
+    entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  let hold = true;
+  h.store.getSession = async (id) => {
+    if (hold) {
+      hold = false;
+      entered.resolve();
+      await release.promise;
+    }
+    return get(id);
+  };
+  const ordinary = h.request(M.sessionRead, { sessionId });
+  await entered.promise;
+  let forwarded = 0;
+  const forward = h.agent.performWhiteboardControl.bind(h.agent);
+  h.agent.performWhiteboardControl = (params) => {
+    forwarded++;
+    return forward(params);
+  };
+  const board = boards
+    .getState()
+    .createBoard({ ...h.workspace, defaultNamePrefix: "Owned queued Stop" });
+  const target = { ...h.workspace, boardId: board.id };
+  const saving = saveNativeWhiteboardDraft({ target, agent: h.agent, sessionId, showSession() {} });
+  let off = () => {},
+    stops = 0;
+  const stopped = Promise.withResolvers<void>();
+  try {
+    await waitFor(() => forwarded === 1, "public native RPC forwarded");
+    assert.equal(h.methods.filter((method) => method === M.sessionWhiteboardControl).length, 0);
+    const pending =
+      boards.getState().workspaces[h.workspace.workspacePath]!.nativeById![board.id]!.pending!;
+    const expected = `native-whiteboard:${pending.requestId}`;
+    // This authored cancellation monitor uses only the ORIGINAL current detail projection.
+    // The production UI operation watcher is independently verified by its owner C.
+    off = pane.store.subscribe(() => {
+      if (
+        stops ||
+        !pane.store
+          .getState()
+          .snapshot?.control.activeWorks.some((work) => work.foregroundExecutionId === expected)
+      )
+        return;
+      stops++;
+      void stopNativeWhiteboardControl(h.agent, target, sessionId, pending.requestId).then(
+        () => stopped.resolve(),
+        (error) => stopped.reject(error),
+      );
+    });
+    release.resolve();
+    await ordinary;
+    await stopped.promise;
+    assert.equal(await saving, false);
+    assert.equal(stops, 1);
+    await waitFor(
+      () => pane.store.getState().snapshot?.control.activeWorks.length === 0,
+      "actual Stop terminal releases native work",
+    );
+    assert.equal(pane.store.getState().snapshot?.control.canStop, false);
+    await assert.rejects(
+      readFile(join(h.workspace.workspacePath, whiteboardRelativePath(board.id))),
+      { code: "ENOENT" },
+    );
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    off();
+    release.resolve();
+    await ordinary;
+    pane.release();
+    // No authored permission response rescues this case; the original Stop/shutdown owns settlement.
+    await h.close(t);
+  }
+});
