@@ -0,0 +1,327 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { mkdtemp, mkdir, rm, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { createMcpAdapter } from "../../adapters/src/mcp/index.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { nativePluginOperationEntryId } from "../src/runtime/methods/native-plugin-operation.js";
+import { setWorkingDirectory } from "../src/runtime/methods/config.js";
+
+test("original Core plugin control asks, records one SDK effect and refuses a durable duplicate operation", async () => {
+  const mcp = createMcpAdapter({ env: {} });
+  const data = await mkdtemp(join(tmpdir(), "owned-native-plugin-"));
+  const config = {
+    type: "stdio" as const,
+    command: process.execPath,
+    args: [
+      resolve(
+        import.meta.dirname,
+        "../../bootstrap/test/fixtures/plugin-view/native-control-server.mjs",
+      ),
+    ],
+    protocolVersion: "legacy" as const,
+    env: { ZCODE_PLUGIN_DATA: data },
+  };
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: undefined, mcp: { enabled: true, servers: { counter: config } } },
+    deps: { mcpPort: mcp },
+  });
+  try {
+    const operationId = randomUUID();
+    const run = () =>
+      f.runtime.performPluginViewControl(
+        { serverName: "counter", toolName: "increment", arguments: {} },
+        {
+          operationId,
+          expectedServerConfig: config,
+          assertAvailable: async (signal) => signal.throwIfAborted(),
+        },
+      );
+    const result = await run();
+    assert.ok(result.accepted && result.result.success, JSON.stringify(result));
+    assert.deepEqual(result.rawResult?.structuredContent, { value: 1 }, JSON.stringify(result));
+    assert.equal(f.permissionCalls, 1);
+    const messages = await f.store.messages({ sessionID: f.runtime.getSessionId() });
+    assert.equal(
+      messages.filter((message) => message.info.semantics?.source === "native_plugin_view").length,
+      2,
+    );
+    assert.ok(
+      messages.some((message) =>
+        message.parts.some((part) => part.type === "tool" && part.state.status === "completed"),
+      ),
+    );
+    await assert.rejects(
+      run(),
+      (error: unknown) => (error as { code?: string }).code === "native_operation_already_recorded",
+    );
+    assert.equal(JSON.parse(await readFile(join(data, "counter.json"), "utf8")).value, 1);
+    assert.equal(f.permissionCalls, 1);
+    assert.equal(f.requests.length, 0);
+  } finally {
+    await mcp.close();
+    await f.close();
+    await rm(data, { recursive: true, force: true });
+  }
+});
+
+import { nativePluginFixture } from "./helpers/native-plugin-fixture.js";
+
+test("same Session refreshes selected config/new tool without disconnecting or replacing its sibling", async () => {
+  const x = await nativePluginFixture(true);
+  try {
+    assert.ok((await x.run()).accepted);
+    const sibling = x.f.runtime.getToolRegistry().get("mcp__sibling__increment");
+    assert.ok(sibling);
+    const refreshed = await x.run("new_increment", x.config("replacement", "new_increment"));
+    assert.ok(refreshed.accepted && refreshed.result.success);
+    assert.deepEqual(refreshed.rawResult?.structuredContent, { value: 1 });
+    assert.equal(x.f.runtime.getToolRegistry().get("mcp__counter__increment"), undefined);
+    assert.equal(x.f.runtime.getToolRegistry().get("mcp__sibling__increment"), sibling);
+    assert.equal((await x.mcp.status()).sibling?.status, "connected");
+    const raw = await x.mcp.callTool(
+      { serverName: "sibling", toolName: "read_counter", arguments: {} },
+      { expectedServerConfig: x.sibling },
+    );
+    assert.deepEqual(raw.structuredContent, { value: 0 });
+    assert.equal(await x.count(), 1);
+    assert.equal(await x.count("replacement"), 1);
+    assert.equal(x.f.requests.length, 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("approval denial records error, refuses duplicate after actual SQLite reopen, and has zero SDK effects", async () => {
+  const x = await nativePluginFixture();
+  try {
+    x.f.deny();
+    const operation = randomUUID(),
+      result = await x.run("increment", x.original, undefined, operation);
+    assert.ok(result.accepted && !result.result.success);
+    assert.equal(result.rawResult, undefined);
+    assert.equal(await x.count(), 0);
+    await x.f.reopen();
+    await assert.rejects(
+      x.run("increment", x.original, undefined, operation),
+      (error: unknown) => (error as { code?: string }).code === "native_operation_already_recorded",
+    );
+    assert.equal(await x.count(), 0);
+    assert.equal(x.f.permissionCalls, 1);
+    assert.equal(x.f.requests.length, 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("grant withdrawn while approval waits is revalidated before the same SDK effect", async () => {
+  const x = await nativePluginFixture();
+  let available = true;
+  try {
+    x.f.permissionWith(async () => {
+      available = false;
+      return { decision: "allow" };
+    });
+    const result = await x.run("increment", x.original, async (signal) => {
+      signal.throwIfAborted();
+      if (!available) throw new Error("Canonical plugin grant withdrawn");
+    });
+    assert.ok(result.accepted && !result.result.success);
+    assert.equal(result.rawResult, undefined);
+    assert.equal(await x.count(), 0);
+    assert.equal(x.f.permissionCalls, 1);
+  } finally {
+    await x.close();
+  }
+});
+
+test("the same admitted SDK reply preserves isError without a second tool call", async () => {
+  const x = await nativePluginFixture();
+  try {
+    const result = await x.run("report_error");
+    assert.ok(result.accepted);
+    assert.equal(result.rawResult?.isError, true);
+    assert.deepEqual(result.rawResult?.content, [{ type: "text", text: "Authored error" }]);
+    assert.equal(await x.count(), 0);
+    assert.equal(x.f.requests.length, 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("selected descriptor collision refuses before replacing a foreign original registry entry", async () => {
+  const x = await nativePluginFixture();
+  try {
+    assert.ok((await x.run("read_counter")).accepted);
+    const registry = x.f.runtime.getToolRegistry(),
+      probe = registry.get("Probe")!;
+    const foreign = { ...probe, metadata: { ...probe.metadata, name: "mcp__counter__increment" } };
+    registry.unregister("mcp__counter__increment");
+    registry.register(foreign);
+    await assert.rejects(x.run(), /conflicts with an existing tool identity/);
+    assert.equal(registry.get("mcp__counter__increment"), foreign);
+    assert.equal(await x.count(), 0);
+    assert.equal(x.f.effects, 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("Stop while approval waits prevents SDK dispatch and records the accepted operation", async () => {
+  const x = await nativePluginFixture();
+  const controller = new AbortController();
+  try {
+    x.f.permissionWith(async () => {
+      controller.abort(new Error("Owned Stop"));
+      return { decision: "allow" };
+    });
+    const result = await x.run("increment", x.original, undefined, randomUUID(), controller.signal);
+    assert.ok(result.accepted && !result.result.success);
+    assert.equal(result.rawResult, undefined);
+    assert.equal(await x.count(), 0);
+  } finally {
+    await x.close();
+  }
+});
+
+test("the original native lease rejects a concurrent operation before preparation or MCP effects", async () => {
