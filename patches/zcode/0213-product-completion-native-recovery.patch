+++ b/apps/zcode-cli/packages/adapters/src/plugins/plugin-metadata.ts
@@ -0,0 +1,222 @@
+// Same adapter owner; extracted plugin-metadata responsibility.
+import { mkdirSync } from "node:fs";
+import { createHash } from "node:crypto";
+import type {
+  HookEventName,
+  HookMatcherConfig,
+  PluginDiagnostic,
+  PluginDiscoverRequest,
+  PluginHookDetail,
+  PluginMetadata,
+} from "@zcode/contracts";
+import { isOfficialMarketplaceId } from "@zcode/contracts";
+import { isRecord } from "./helpers.js";
+import { resolvePluginMcpServers } from "./mcp.js";
+import { enumeratePluginComponents } from "./plugin-components.js";
+import { normalizeAuthorValue } from "./marketplace.js";
+import type { LoadedPlugin, PluginCandidate, PluginComponents } from "./types.js";
+import {
+  resolveSkillRoots,
+  resolveCommandRoots,
+  countSkillFiles,
+} from "./plugin-component-roots.js";
+
+export function createPluginMetadata(
+  loaded: LoadedPlugin,
+  component: PluginComponents,
+  dataPath: string,
+  enabled: boolean,
+  declaredMcpServerNames: string[],
+  configuredOptions: Record<string, string | number | boolean>,
+  grant?: PluginMetadata["grant"],
+  views: PluginMetadata["views"] = [],
+): PluginMetadata {
+  // manifest 的 author/homepage 作为详情页信息区的回退来源（商店 listing 优先）。
+  const author = normalizeAuthorValue(loaded.manifest.author);
+  const homepage =
+    typeof loaded.manifest.homepage === "string" && loaded.manifest.homepage.trim().length > 0
+      ? loaded.manifest.homepage
+      : undefined;
+  return {
+    ...(author?.name ? { author: author.name } : {}),
+    ...(author?.url ? { authorUrl: author.url } : {}),
+    ...(homepage ? { homepage } : {}),
+    commandRootCount: component.commandRoots.length,
+    // 详情 UI 过去靠 plugin.skillCount（权威计数）+ 一条 UI 侧 join（按 pluginName 过滤
+    // skillsService 结果）拿名称，二者数据源分离。停用插件走 emptyComponents() 使 skillCount=0、
+    // 且 UI join 对停用插件不产出名称（skillsService 里 `if (!enabled) continue`），导致：停用时
+    // 整个技能分组消失、启用时只有数量没有名称。这里改为对插件根目录做权威枚举（与启用态无关），
+    // 直接把名称+描述随 list 下发，UI 不再需要脆弱的 join。
+    components: enumeratePluginComponents(loaded.rootPath, loaded.manifest, { loaded }),
+    configuredOptions,
+    dataPath,
+    declaredMcpServerNames,
+    description: loaded.manifest.description,
+    enabled,
+    id: loaded.id,
+    manifestPath: loaded.manifestPath,
+    marketplace: loaded.marketplace,
+    mcpServerNames: Object.keys(component.mcpServers),
+    name: loaded.manifest.name,
+    hookDetails: component.hookDetails,
+    rootPath: loaded.rootPath,
+    skillCount: component.skillCount,
+    skillRootCount: component.skillRoots.length,
+    source: loaded.source,
+    userConfig: loaded.manifest.userConfig,
+    ...(grant ? { grant } : {}),
+    ...(views.length > 0 ? { views } : {}),
+    version: loaded.manifest.version,
+  };
+}
+
+export function resolveEnabledComponents(input: {
+  dataPath: string;
+  diagnostics: PluginDiagnostic[];
+  env: Record<string, string | undefined>;
+  hookDetails: PluginHookDetail[];
+  hookEvents: Partial<Record<HookEventName, HookMatcherConfig[]>>;
+  loaded: LoadedPlugin;
+  mcpServerDefinitions: Record<string, unknown>;
+  options: Record<string, string | number | boolean>;
+  priority: number;
+  workingDirectory: string;
+}): PluginComponents {
+  mkdirSync(input.dataPath, { recursive: true });
+
+  const skillRoots = resolveSkillRoots(input, input.priority);
+  return {
+    commandRoots: resolveCommandRoots(input, input.priority + 1),
+    hooks: input.hookEvents,
+    hookDetails: input.hookDetails,
+    mcpServers: resolvePluginMcpServers({
+      ...input,
+      definitions: input.mcpServerDefinitions,
+    }),
+    // 插件页要展示真实技能数量。之前只统计 skills root 数，
+    // document-skills 这种一个 root 下有多个 SKILL.md 的插件会被显示成 1。
+    skillCount: countSkillFiles(skillRoots),
+    skillRoots,
+  };
+}
+
+export const VIEW_ID_PATTERN = /^[a-z0-9][a-z0-9-]{0,63}$/;
+
+/** Namespace for Fleet-only data inside an Agent Plugins manifest's `extensions`. */
+export const FLEET_EXTENSION_NAMESPACE = "fleet.workbench";
+
+/** `fleet.views[]` → validated view contributions; an invalid entry is dropped with a diagnostic. */
+export function parsePluginViews(
+  loaded: LoadedPlugin,
+  mcpServerDefinitions: Record<string, unknown>,
+  diagnostics: PluginDiagnostic[],
+): NonNullable<PluginMetadata["views"]> {
+  // Fleet manifests use `fleet.views`; an Agent Plugins package carries them under its
+  // reverse-domain `extensions` (§8), which other clients ignore.
+  const extensions = (loaded.manifest as { extensions?: unknown }).extensions;
+  const fromExtensions = isRecord(extensions) ? extensions[FLEET_EXTENSION_NAMESPACE] : undefined;
+  const fleet = isRecord(loaded.manifest.fleet) ? loaded.manifest.fleet : fromExtensions;
+  const declared = isRecord(fleet) && Array.isArray(fleet.views) ? fleet.views : [];
+  const views: NonNullable<PluginMetadata["views"]> = [];
+  const invalid = (message: string) =>
+    diagnostics.push({
+      code: "plugin_view_invalid",
+      message: `${loaded.id}: ${message}`,
+      path: loaded.manifestPath,
+      pluginId: loaded.id,
+      severity: "warning",
+    });
+  for (const view of declared) {
+    if (!isRecord(view)) continue;
+    const id = typeof view.id === "string" ? view.id : "";
+    if (!VIEW_ID_PATTERN.test(id) || views.some((existing) => existing.id === id)) {
+      invalid(`view id must be unique lowercase words joined by hyphens: ${String(view.id)}`);
+      continue;
+    }
+    if (typeof view.server !== "string" || !(view.server in mcpServerDefinitions)) {
+      invalid(`view ${id} must name one of this plugin's MCP servers`);
+      continue;
+    }
+    if (typeof view.resource !== "string" || !view.resource.startsWith("ui://")) {
+      invalid(`view ${id} must name a ui:// resource`);
+      continue;
+    }
+    const titleI18n = isRecord(view.title_i18n)
+      ? Object.fromEntries(
+          Object.entries(view.title_i18n).filter(
+            (entry): entry is [string, string] => typeof entry[1] === "string",
+          ),
+        )
+      : undefined;
+    views.push({
+      id,
+      title: typeof view.title === "string" && view.title.trim() ? view.title.trim() : id,
+      ...(titleI18n && Object.keys(titleI18n).length > 0 ? { titleI18n } : {}),
+      ...(typeof view.description === "string" ? { description: view.description } : {}),
+      server: view.server,
+      resource: view.resource,
+      placement: "side-pane",
+    });
+  }
+  return views;
+}
+
+/**
+ * Grant state for a plugin that can run host code. Packages installed from a third-party
+ * marketplace need a grant; built-in, official and person-declared folders do not. Undefined when
+ * the plugin declares neither MCP servers nor hooks.
+ */
+export function resolvePluginGrant(input: {
+  candidate: PluginCandidate;
+  grants: PluginDiscoverRequest["pluginGrants"];
+  hookDetails: PluginHookDetail[];
+  loaded: LoadedPlugin;
+  mcpServerDefinitions: Record<string, unknown>;
+}): PluginMetadata["grant"] | undefined {
+  if (Object.keys(input.mcpServerDefinitions).length === 0 && input.hookDetails.length === 0) {
+    return undefined;
+  }
+  const fingerprint = pluginSurfaceFingerprint(input.mcpServerDefinitions, input.hookDetails);
+  const required =
+    input.candidate.source === "cache" && !isOfficialMarketplaceId(input.loaded.marketplace);
+  const granted =
+    !required || input.grants === undefined || input.grants[input.loaded.id] === fingerprint;
+  return { fingerprint, granted, required };
+}
+
+/** Stable hash of what the plugin would execute: MCP launch definitions and hook commands. */
+export function pluginSurfaceFingerprint(
+  mcpServerDefinitions: Record<string, unknown>,
+  hookDetails: readonly PluginHookDetail[],
+): string {
+  const hooks = hookDetails
+    .map((hook) => ({
+      args: hook.args ?? [],
+      command: hook.command,
+      event: hook.event,
+      matcher: hook.matcher ?? "",
+      shell: hook.shell ?? false,
+    }))
+    .sort((left, right) => JSON.stringify(left).localeCompare(JSON.stringify(right)));
+  return createHash("sha256")
+    .update(canonicalJson({ hooks, mcp: mcpServerDefinitions }))
+    .digest("hex")
+    .slice(0, 32);
+}
+
+export function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+  if (isRecord(value)) {
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalJson(value[key])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(value ?? null);
+}
+
+export function canRunPluginHooks(candidate: PluginCandidate): boolean {
+  // 用户安装/声明的插件 hook 默认放行（与内置/官方一致）。只由 Project 配置声明的 inline 根
+  // 不放行：Project 直写的 hook 要过工作区 hook 信任审查，插件声明不能成为绕过它的通道（DOM-01）。
+  return !candidate.projectDeclared;
+}
