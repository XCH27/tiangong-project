+import { createUuid } from "@zcode/shared";
+import type { IZCodeAgentService, IPluginManagementService } from "@zcode/services";
+import {
+  ensureNativeWhiteboardSession,
+  type NativeWhiteboardWorkspace,
+} from "./nativeWhiteboardControl.js";
+import {
+  getRegisteredBaseWorkspaceServices,
+  getRemoteWorkspaceServicesForIdentity,
+  getRemoteWorkspaceSession,
+  useRemoteWorkspaceSessionStore,
+} from "../store/remoteWorkspaceSessionStore.js";
+import { showNativePluginViewSession } from "./nativeWhiteboardNavigation.js";
+import { withNativeSessionPresentation } from "./nativeSessionPresentation.js";
+
+export type NativePluginViewTarget = NativeWhiteboardWorkspace & {
+  pluginId: string;
+  viewId: string;
+};
+
+/** Read the original registry again at publication/action time, before React may commit. */
+export function isNativePluginViewConnectionCurrent(
+  target: NativeWhiteboardWorkspace,
+  agent: IZCodeAgentService,
+  plugins: IPluginManagementService,
+): boolean {
+  const registered = target.workspaceIdentity
+    ? getRemoteWorkspaceServicesForIdentity(target.workspaceIdentity)
+    : target.remoteSessionId
+      ? getRemoteWorkspaceSession(target.remoteSessionId)?.services
+      : getRegisteredBaseWorkspaceServices();
+  if ((target.workspaceIdentity || target.remoteSessionId) && !registered) return false;
+  if (
+    target.workspaceIdentity &&
+    useRemoteWorkspaceSessionStore.getState().sessionIdByWorkspaceIdentity[
+      target.workspaceIdentity
+    ] !== target.remoteSessionId
+  )
+    return false;
+  return (
+    !registered ||
+    (registered.zcodeAgentService === agent && registered.pluginManagementService === plugins)
+  );
+}
+
+/** The original Session, lease and Host tool executor own approval and the single effect. */
+export async function callNativePluginViewTool(input: {
+  target: NativePluginViewTarget;
+  agent: IZCodeAgentService;
+  plugins: IPluginManagementService;
+  sessionId?: string | null;
+  tool: string;
+  arguments?: Record<string, unknown>;
+  isCurrent: () => boolean;
+}) {
+  const checkCurrent = () => {
+    if (
+      !input.isCurrent() ||
+      !isNativePluginViewConnectionCurrent(input.target, input.agent, input.plugins)
+    )
+      throw new Error("Plugin view context changed; the tool was not dispatched");
+  };
+  checkCurrent();
+  const sessionId = await ensureNativeWhiteboardSession(input.agent, input.target, input.sessionId);
+  checkCurrent();
+  const { workspacePath, workspaceIdentity, remoteSessionId, pluginId, viewId } = input.target;
+  return withNativeSessionPresentation({
+    agent: input.agent,
+    workspace: input.target,
+    sessionId,
+    isCurrent: () => {
+      return (
+        input.isCurrent() &&
+        isNativePluginViewConnectionCurrent(input.target, input.agent, input.plugins)
+      );
+    },
+    present: () => showNativePluginViewSession(input.target, sessionId),
+    dispatch: () =>
+      input.plugins.callPluginViewTool({
+        workspacePath,
+        ...(workspaceIdentity ? { workspaceIdentity } : {}),
+        ...(remoteSessionId ? { remoteSessionId } : {}),
+        pluginId,
+        viewId,
+        sessionId,
+        operationId: createUuid(),
+        tool: input.tool,
+        ...(input.arguments ? { arguments: input.arguments } : {}),
+      }),
+  });
+}
diff --git a/packages/ui/src/lib/nativeSessionDispatchCancellation.ts b/packages/ui/src/lib/nativeSessionDispatchCancellation.ts
new file mode 100644
index 00000000..fa92be92
--- /dev/null
+++ b/packages/ui/src/lib/nativeSessionDispatchCancellation.ts
@@ -0,0 +1,72 @@
+import type { ConversationProjectionStore } from "../v4/conversationProjectionStore.js";
+import type { ConversationTransport } from "../v4/transport.js";
+
+export interface NativeDispatchCancellation {
+  signal: AbortSignal;
+  foregroundExecutionId: string;
+  requestStop(): Promise<void>;
+  onFailure?(error: unknown): void;
+}
+
+/** A sent RPC is not admission. Only the original current Session projection proves its owner. */
+export function watchNativeDispatchCancellation(
+  store: ConversationProjectionStore,
+  transport: ConversationTransport,
+  sessionId: string,
+  intent: NativeDispatchCancellation,
+): () => void {
+  let closed = false;
+  let attempted = false;
+  let recheck: ReturnType<typeof setInterval> | undefined;
+  const clearRecheck = () => {
+    if (recheck !== undefined) clearInterval(recheck);
+    recheck = undefined;
+  };
+  const failure = (error: unknown) => {
+    if (!closed) intent.onFailure?.(error);
+  };
+  const check = () => {
+    if (closed || attempted || !intent.signal.aborted) return;
+    // A resume ACK can notify while connectInFlight still hides an otherwise valid
+    // base. Its finally does not emit; observe only while this original intent waits.
+    recheck ??= setInterval(check, 100);
+    const state = store.getState();
+    if (state.status === "closed" || state.status === "error") {
+      attempted = true;
+      clearRecheck();
+      failure(new Error("whiteboard.hostUnavailable"));
+      return;
+    }
+    if (
+      !store.hasCurrentSubscriptionProjection() ||
+      state.snapshot?.sessionId !== sessionId ||
+      !state.snapshot.control.activeWorks.some(
+        (work) => work.foregroundExecutionId === intent.foregroundExecutionId,
+      )
+    )
+      return;
+    attempted = true;
+    clearRecheck();
+    // Preserve the exact original Stop command; never replay or synthesize an actor result.
+    void intent.requestStop().catch(failure);
+  };
+  const off = store.subscribe(check);
+  const offFrame = transport.onFrame(check);
+  const offLifecycle = transport.onRuntimeLifecycle?.((state) => {
+    if (state === "unavailable" && intent.signal.aborted && !attempted) {
+      attempted = true;
+      clearRecheck();
+      failure(new Error("whiteboard.hostUnavailable"));
+    }
+  });
+  intent.signal.addEventListener("abort", check, { once: true });
+  check();
+  return () => {
+    closed = true;
+    clearRecheck();
+    off();
+    offFrame();
+    offLifecycle?.();
+    intent.signal.removeEventListener("abort", check);
+  };
+}
diff --git a/packages/ui/src/lib/nativeSessionPresentation.ts b/packages/ui/src/lib/nativeSessionPresentation.ts
new file mode 100644
index 00000000..700db6b1
--- /dev/null
+++ b/packages/ui/src/lib/nativeSessionPresentation.ts
@@ -0,0 +1,161 @@
+import type { IZCodeAgentService } from "@zcode/services";
+import type { ConversationProjectionStore } from "../v4/conversationProjectionStore.js";
+import type { ConversationTransport } from "../v4/transport.js";
+import { acquireWorkspaceConnection } from "../v4/workspaceConnectionRegistry.js";
+import type { NativeWhiteboardWorkspace } from "./nativeWhiteboardControl.js";
+import {
+  watchNativeDispatchCancellation,
+  type NativeDispatchCancellation,
+} from "./nativeSessionDispatchCancellation.js";
+
+const PRESENTATION_TIMEOUT_MS = 30_000;
+
+function stoppedPreparation(): Error {
+  return new Error("whiteboard.saveStopped");
+}
+
+export function assertNativePreparationActive(signal?: AbortSignal): void {
+  if (signal?.aborted) throw stoppedPreparation();
+}
+
+/** Cancel this caller's preparation wait, while observing the original RPC's late settlement. */
+export function waitForNativePreparation<T>(
+  preparation: Promise<T>,
+  signal?: AbortSignal,
+): Promise<T> {
+  if (!signal) return preparation;
+  return new Promise((resolve, reject) => {
+    const abort = () => {
+      signal.removeEventListener("abort", abort);
+      reject(stoppedPreparation());
+    };
+    signal.addEventListener("abort", abort, { once: true });
+    preparation.then(
+      (value) => {
+        signal.removeEventListener("abort", abort);
+        if (signal.aborted) reject(stoppedPreparation());
+        else resolve(value);
+      },
+      (error: unknown) => {
+        signal.removeEventListener("abort", abort);
+        reject(error);
+      },
+    );
+    if (signal.aborted) abort();
+  });
+}
+
+/** Observe the original subscription; connect() would replace another pane's ownership. */
+function waitForPresentation(
+  store: ConversationProjectionStore,
+  sessionId: string,
+  isCurrent: () => boolean,
+  transport: ConversationTransport,
+  signal?: AbortSignal,
+): Promise<void> {
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    let off = () => {};
+    let offLifecycle = () => {};
+    let offFrame = () => {};
+    const finish = (error?: Error) => {
+      if (settled) return;
+      settled = true;
+      off();
+      offLifecycle();
+      offFrame();
+      clearTimeout(timeout);
+      clearInterval(contextCheck);
+      signal?.removeEventListener("abort", abort);
+      if (error) reject(error);
+      else resolve();
+    };
+    const check = () => {
+      if (settled) return;
+      if (signal?.aborted) {
+        finish(stoppedPreparation());
+        return;
+      }
+      if (!isCurrent()) {
+        finish(new Error("Native Session presentation context changed"));
+        return;
+      }
+      const state = store.getState();
+      if (state.status === "error" || state.status === "closed") {
+        finish(new Error(state.lastError ?? "Native Session presentation is unavailable"));
+      } else if (
+        store.hasCurrentSubscriptionProjection() &&
+        state.snapshot?.sessionId === sessionId
+      ) {
+        finish();
+      }
+    };
+    const timeout = setTimeout(
+      () => finish(new Error("Native Session presentation timed out before dispatch")),
+      PRESENTATION_TIMEOUT_MS,
+    );
+    const contextCheck = setInterval(check, 100);
+    const abort = () => finish(stoppedPreparation());
+    signal?.addEventListener("abort", abort, { once: true });
+    // Original connect publishes ACK/frame before its finally releases connectInFlight.
+    // Re-read after that synchronous notification completes; no additional RPC is sent.
+    const afterNotification = () => queueMicrotask(check);
+    off = store.subscribe(afterNotification);
+    // Layer applies this frame first; aligned resume may retain snapshot identity.
+    offFrame = transport.onFrame(afterNotification);
+    offLifecycle =
+      transport.onRuntimeLifecycle?.((state) => {
+        if (state === "unavailable") finish(new Error("Native Session presentation disconnected"));
+      }) ?? (() => {});
+    check();
+  });
+}
+
+/** Hold the existing workspace/detail leases until the admitted actor RPC settles. */
+export async function withNativeSessionPresentation<T>(input: {
+  agent: IZCodeAgentService;
+  workspace: NativeWhiteboardWorkspace;
+  sessionId: string;
+  isCurrent: () => boolean;
+  present: () => void;
+  dispatch: () => Promise<T>;
+  abortSignal?: AbortSignal;
+  onDispatch?: () => void;
+  dispatchCancellation?: NativeDispatchCancellation;
+}): Promise<T> {
+  assertNativePreparationActive(input.abortSignal);
+  const workspace = acquireWorkspaceConnection(input.workspace, input.agent);
+  let detail: ReturnType<typeof workspace.layer.acquire> | undefined;
+  try {
+    workspace.activateRemoteService();
+    detail = workspace.layer.acquire(input.sessionId);
+    input.present();
+    await waitForPresentation(
+      detail.store,
+      input.sessionId,
+      input.isCurrent,
+      workspace.transport,
+      input.abortSignal,
+    );
+    if (!input.isCurrent()) throw new Error("Native Session presentation context changed");
+    if (input.abortSignal?.aborted) throw stoppedPreparation();
+    const releaseCancellation = input.dispatchCancellation
+      ? watchNativeDispatchCancellation(
+          detail.store,
+          workspace.transport,
+          input.sessionId,
+          input.dispatchCancellation,
+        )
+      : () => {};
+    try {
+      // This synchronous boundary marks dispatch, not a claim of remote admission.
+      input.onDispatch?.();
+      return await input.dispatch();
+    } finally {
+      releaseCancellation();
+    }
+  } finally {
+    detail?.release();
+    workspace.release();
+  }
+}
diff --git a/packages/ui/src/lib/nativeWhiteboardClose.ts b/packages/ui/src/lib/nativeWhiteboardClose.ts
new file mode 100644
index 00000000..94401c6c
--- /dev/null
+++ b/packages/ui/src/lib/nativeWhiteboardClose.ts
@@ -0,0 +1,62 @@
+import { useWhiteboardStore } from "../store/whiteboardStore.js";
+import { useConfirmDialogStore } from "../store/confirmDialogStore.js";
+import { isWhiteboardDirty } from "../store/whiteboardNativeProjection.js";
+import { flushWhiteboardGestures } from "./whiteboardGesture.js";
+import type { NativeWhiteboardActionTarget } from "./nativeWhiteboardDraft.js";
+import { buildWhiteboardWorkspaceKey } from "./whiteboard.js";
+
+export function dirtyWhiteboardTargets(): NativeWhiteboardActionTarget[] {
+  return Object.entries(useWhiteboardStore.getState().workspaces).flatMap(([key, workspace]) =>
+    [...new Set([...Object.keys(workspace.boardsById), ...Object.keys(workspace.nativeById ?? {})])]
+      .filter(
+        (id) =>
+          isWhiteboardDirty(workspace.boardsById[id], workspace.nativeById?.[id]) ||
+          workspace.nativeById?.[id]?.pending,
+      )
+      .map((boardId) => ({ ...(workspace.scope ?? { workspacePath: key }), boardId })),
+  );
+}
+
+/** Reuses the original draft and confirmation owners for pane and window close. */
+export async function requestNativeWhiteboardDraftClose(input: {
+  targets?: readonly NativeWhiteboardActionTarget[];
+  save: (target: NativeWhiteboardActionTarget) => Promise<boolean>;
+  format: (id: string, values?: Record<string, string>) => string;
+  isCurrent?: () => boolean;
+  requestId?: string;
+}): Promise<boolean> {
+  const current = () => input.isCurrent?.() !== false;
+  flushWhiteboardGestures();
+  const matches = (target: NativeWhiteboardActionTarget) =>
+    !input.targets ||
+    input.targets.some(
+      (candidate) =>
+        candidate.boardId === target.boardId &&
+        buildWhiteboardWorkspaceKey(candidate) === buildWhiteboardWorkspaceKey(target),
+    );
+  while (current()) {
+    const target = dirtyWhiteboardTargets().find(matches);
+    if (!target) return true;
+    const workspace = useWhiteboardStore.getState().workspaces[buildWhiteboardWorkspaceKey(target)];
+    const board = workspace?.boardsById[target.boardId];
+    if (!board || workspace.nativeById?.[target.boardId]?.pending) return false;
+    const choice = await useConfirmDialogStore.getState().requestChoice({
+      testId: `whiteboard-close-${input.requestId ?? "pane"}`,
+      title: input.format("whiteboard.closeTitle"),
+      description: input.format("whiteboard.closeDescription", { name: board.name }),
+      confirmLabel: input.format("whiteboard.save"),
+      cancelLabel: input.format("whiteboard.discard"),
+      dismissLabel: input.format("common.cancel"),
+      showKeyboardHints: false,
+      showCloseButton: true,
+    });
+    if (!current() || choice === "dismiss") return false;
+    if (choice === "cancel") {
+      // Drawing made while the dialog was open requires its own explicit decision.
+      if (useWhiteboardStore.getState().getBoard(target) !== board) continue;
+      useWhiteboardStore.getState().discardDraft(target);
+    } else if (!(await input.save(target))) return false;
+    flushWhiteboardGestures();
+  }
+  return false;
+}
diff --git a/packages/ui/src/lib/nativeWhiteboardCloseBridge.ts b/packages/ui/src/lib/nativeWhiteboardCloseBridge.ts
new file mode 100644
index 00000000..2aa45b4b
--- /dev/null
+++ b/packages/ui/src/lib/nativeWhiteboardCloseBridge.ts
@@ -0,0 +1,92 @@
+import type { IPlatformService } from "@zcode/shared";
+import { useWhiteboardStore } from "../store/whiteboardStore.js";
+import { useConfirmDialogStore } from "../store/confirmDialogStore.js";
+import {
+  dirtyWhiteboardTargets,
+  requestNativeWhiteboardDraftClose,
+} from "./nativeWhiteboardClose.js";
+
+/** The Lead-owned optional platform contract. No command or permission override crosses it. */
+export type NativeWhiteboardCloseBridge = Pick<
+  IPlatformService,
+  | "onNativeWhiteboardCloseRequest"
+  | "completeNativeWhiteboardClose"
+  | "publishNativeWhiteboardDraftState"
+>;
+
+export function installNativeWhiteboardCloseBridge(
+  platform: NativeWhiteboardCloseBridge,
+  options: Omit<
+    Parameters<typeof requestNativeWhiteboardDraftClose>[0],
+    "requestId" | "targets" | "isCurrent"
+  >,
+): () => void {
+  if (
+    !platform.onNativeWhiteboardCloseRequest ||
+    !platform.completeNativeWhiteboardClose ||
+    !platform.publishNativeWhiteboardDraftState
+  )
+    return () => {};
+  let active: { requestId: string; cancelled: boolean } | undefined;
+  let disposed = false;
+  const listener = platform.onNativeWhiteboardCloseRequest((request) => {
+    if (request.phase === "cancelled") {
+      if (active?.requestId === request.requestId) active.cancelled = true;
+      const store = useWhiteboardStore.getState();
+      if (store.nativeCloseRequestId === request.requestId) {
+        store.setNativeCloseFrozen(false);
+        store.setNativeCloseRequestId(null);
+      }
+      if (
+        useConfirmDialogStore.getState().pendingRequest?.testId ===
+        `whiteboard-close-${request.requestId}`
+      )
+        useConfirmDialogStore.getState().settleChoice("dismiss");
+      return;
+    }
+    if (active && !active.cancelled) return;
+    const operation = { requestId: request.requestId, cancelled: false };
+    active = operation;
+    const isCurrent = () => !disposed && !operation.cancelled && active === operation;
+    void (async () => {
+      let allowClose = false;
+      try {
+        allowClose = await requestNativeWhiteboardDraftClose({
+          ...options,
+          requestId: request.requestId,
+          isCurrent,
+        });
+        if (!isCurrent()) return;
+        if (allowClose) {
+          const store = useWhiteboardStore.getState();
+          store.setNativeCloseRequestId(request.requestId);
+          store.setNativeCloseFrozen(true);
+        }
+        await platform.completeNativeWhiteboardClose!({ requestId: request.requestId, allowClose });
+      } catch {
+        if (isCurrent() && !allowClose) {
+          await platform.completeNativeWhiteboardClose!({
+            requestId: request.requestId,
+            allowClose: false,
+          }).catch(() => {});
+        }
+      } finally {
+        if (active === operation) active = undefined;
+      }
+    })();
+  });
+  const publish = () => {
+    void Promise.resolve(
+      platform.publishNativeWhiteboardDraftState!({ dirty: dirtyWhiteboardTargets().length > 0 }),
+    ).catch(() => {});
+  };
+  const unsubscribe = useWhiteboardStore.subscribe(publish);
+  // Listener is live before registering this renderer, including its initially clean state.
+  publish();
+  return () => {
+    disposed = true;
+    if (active) active.cancelled = true;
+    unsubscribe();
+    listener.dispose();
+  };
+}
diff --git a/packages/ui/src/lib/nativeWhiteboardControl.ts b/packages/ui/src/lib/nativeWhiteboardControl.ts
new file mode 100644
index 00000000..bd685e9f
--- /dev/null
+++ b/packages/ui/src/lib/nativeWhiteboardControl.ts
@@ -0,0 +1,99 @@
+import {
+  createUuid,
+  type WhiteboardControlInput,
+  type WhiteboardControlResult,
+  type WhiteboardReadInput,
+} from "@zcode/shared";
+import type { IZCodeAgentService } from "@zcode/services";
+import { createCommandEnvelope } from "@/v4/commandFactory.js";
+import { acquireWorkspaceConnection } from "@/v4/workspaceConnectionRegistry.js";
+import {
+  assertNativePreparationActive,
+  waitForNativePreparation,
+} from "./nativeSessionPresentation.js";
+
+export type NativeWhiteboardWorkspace = {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  remoteSessionId?: string;
+};
+
+/** Reuse the workspace connection and original V4 Session owner; never start a model turn. */
+export async function ensureNativeWhiteboardSession(
+  agent: IZCodeAgentService,
+  workspace: NativeWhiteboardWorkspace,
+  sessionId?: string | null,
+  abortSignal?: AbortSignal,
+): Promise<string> {
+  assertNativePreparationActive(abortSignal);
+  const lease = acquireWorkspaceConnection(workspace, agent);
+  try {
+    lease.activateRemoteService();
+    if (sessionId) return await waitForNativePreparation(Promise.resolve(sessionId), abortSignal);
+    const ack = await waitForNativePreparation(
+      lease.transport.sendCommand(
+        createCommandEnvelope({
+          type: "createSession",
+          sessionId: null,
+          payload: { workspaceId: workspace.workspaceIdentity?.trim() || workspace.workspacePath },
+        }),
+      ),
+      abortSignal,
+    );
+    if (
+      (ack.status !== "accepted" && ack.status !== "duplicate") ||
+      ack.result?.type !== "createSession"
+    )
+      throw new Error(ack.message ?? "Could not establish the original project Session");
+    return ack.result.sessionId;
+  } finally {
+    lease.release();
+  }
+}
+
+export async function nativeWhiteboardControl(
+  agent: IZCodeAgentService,
+  workspace: NativeWhiteboardWorkspace,
+  sessionId: string,
+  command: WhiteboardControlInput,
+  operationId = createUuid(),
+): Promise<WhiteboardControlResult> {
+  return agent.performWhiteboardControl({ ...workspace, sessionId, operationId, command });
+}
+
+/** Viewing uses the original scoped file projection and never falls back to an actor turn. */
+export async function readNativeWhiteboardProjection(
+  agent: IZCodeAgentService,
+  workspace: NativeWhiteboardWorkspace,
+  sessionId: string,
+  input: WhiteboardReadInput,
+): Promise<WhiteboardControlResult> {
+  const lease = acquireWorkspaceConnection(workspace, agent);
+  try {
+    lease.activateRemoteService();
+    return await agent.readWhiteboardProjection({ ...workspace, sessionId, input });
+  } finally {
+    lease.release();
+  }
+}
+
+export async function stopNativeWhiteboardControl(
+  agent: IZCodeAgentService,
+  workspace: NativeWhiteboardWorkspace,
+  sessionId: string,
+  operationId: string,
+): Promise<void> {
+  const lease = acquireWorkspaceConnection(workspace, agent);
+  try {
+    lease.activateRemoteService();
+    await lease.transport.sendCommand(
+      createCommandEnvelope({
+        type: "stop",
+        sessionId,
+        payload: { expectedForegroundExecutionId: `native-whiteboard:${operationId}` },
+      }),
+    );
+  } finally {
+    lease.release();
+  }
+}
diff --git a/packages/ui/src/lib/nativeWhiteboardDraft.ts b/packages/ui/src/lib/nativeWhiteboardDraft.ts
new file mode 100644
index 00000000..b8812507
--- /dev/null
+++ b/packages/ui/src/lib/nativeWhiteboardDraft.ts
@@ -0,0 +1,147 @@
+import type { IZCodeAgentService } from "@zcode/services";
+import { whiteboardDocumentSchema, WHITEBOARD_DOCUMENT_MAX_BYTES } from "@zcode/shared";
+import { useWhiteboardStore } from "../store/whiteboardStore.js";
+import type { WhiteboardTarget } from "../store/whiteboardNativeProjection.js";
+import { buildWhiteboardWorkspaceKey } from "./whiteboard.js";
+import {
+  ensureNativeWhiteboardSession,
+  nativeWhiteboardControl,
+  stopNativeWhiteboardControl,
+  type NativeWhiteboardWorkspace,
+} from "./nativeWhiteboardControl.js";
+import { flushWhiteboardGestures } from "./whiteboardGesture.js";
+import { withNativeSessionPresentation } from "./nativeSessionPresentation.js";
+
+export type NativeWhiteboardActionTarget = WhiteboardTarget & NativeWhiteboardWorkspace;
+export type ShowNativeWhiteboardSession = (
+  target: NativeWhiteboardActionTarget,
+  sessionId: string,
+) => void;
+
+/** Snapshot after gesture flush; only the registered tool receipt may advance committed state. */
+export async function saveNativeWhiteboardDraft(input: {
+  target: NativeWhiteboardActionTarget;
+  agent: IZCodeAgentService;
+  sessionId?: string | null;
+  showSession: ShowNativeWhiteboardSession;
+  isCurrent?: () => boolean;
+  onStarted?: (requestId: string) => void;
+  onSessionResolved?: (sessionId: string) => void;
+  abortSignal?: AbortSignal;
+  onDispatch?: () => void;
+  onStopError?: (error: unknown) => void;
+}): Promise<boolean> {
+  const { target, agent } = input;
+  flushWhiteboardGestures(target);
+  const store = useWhiteboardStore.getState();
+  const controller = new AbortController();
+  const pending = store.beginNativeSave(target, () => controller.abort());
+  if (!pending) return false;
+  const externalAbort = () => pending.cancel?.();
+  input.abortSignal?.addEventListener("abort", externalAbort, { once: true });
+  if (input.abortSignal?.aborted) externalAbort();
+  const current = () => input.isCurrent?.() !== false;
+  try {
+    input.onStarted?.(pending.requestId);
+    const document = whiteboardDocumentSchema.parse(pending.draft);
+    if (
+      new TextEncoder().encode(JSON.stringify(document)).byteLength > WHITEBOARD_DOCUMENT_MAX_BYTES
+    )
+      throw new Error("Whiteboard exceeds its file size budget");
+    const sessionId = await ensureNativeWhiteboardSession(
+      agent,
+      target,
+      input.sessionId,
+      controller.signal,
+    );
+    if (!current()) throw new Error("whiteboard.contextChanged");
+    input.onSessionResolved?.(sessionId);
+    const committed =
+      useWhiteboardStore.getState().workspaces[buildWhiteboardWorkspaceKey(target)]?.nativeById?.[
+        target.boardId
+      ]?.committed;
+    const result = await withNativeSessionPresentation({
+      agent,
+      workspace: target,
+      sessionId,
+      isCurrent: current,
+      abortSignal: controller.signal,
+      onDispatch: input.onDispatch,
+      dispatchCancellation: {
+        signal: controller.signal,
+        foregroundExecutionId: `native-whiteboard:${pending.requestId}`,
+        requestStop: () => stopNativeWhiteboardControl(agent, target, sessionId, pending.requestId),
+        onFailure: (failure) => {
+          useWhiteboardStore.getState().reportNativeSaveError({
+            ...target,
+            requestId: pending.requestId,
+            error: failure instanceof Error ? failure.message : String(failure),
+          });
+          input.onStopError?.(failure);
+        },
+      },
+      present: () => input.showSession(target, sessionId),
+      dispatch: () =>
+        nativeWhiteboardControl(
+          agent,
+          target,
+          sessionId,
+          {
+            operation: "update",
+            input: {
+              document,
+              mutationId: pending.mutationId,
+              ...(committed
+                ? { expectedFileRevision: committed.fileRevision }
+                : { expectedAbsent: true }),
+            },
+          },
+          pending.requestId,
+        ),
+    });
+    if (!current()) throw new Error("whiteboard.contextChanged");
+    if (result.status !== "completed")
+      throw new Error(
+        result.status === "failed"
+          ? result.code === "PERMISSION_DENIED"
+            ? "whiteboard.saveUnapproved"
+            : result.code === "PERMISSION_TIMEOUT"
+              ? "whiteboard.approvalExpired"
+              : result.code === "TOOL_CANCELLED"
+                ? "whiteboard.saveStopped"
+                : result.message
+          : `whiteboard.${result.status === "rejected" ? result.reason : "invalidReceipt"}`,
+      );
+    if (JSON.stringify(result.document.board) !== JSON.stringify(document)) {
+      const owner = useWhiteboardStore.getState();
+      owner.failNativeSave({
+        ...target,
+        requestId: pending.requestId,
+        error: "whiteboard.conflict",
+      });
+      owner.receiveNativeBoard({
+        ...target,
+        document: result.document,
+        fileRevision: result.fileRevision,
+        preserveDraft: true,
+      });
+      return false;
+    }
+    useWhiteboardStore.getState().acknowledgeNativeSave({
+      ...target,
+      requestId: pending.requestId,
+      document: result.document,
+      fileRevision: result.fileRevision,
+    });
+    return true;
+  } catch (error) {
+    useWhiteboardStore.getState().failNativeSave({
+      ...target,
+      requestId: pending.requestId,
+      error: error instanceof Error ? error.message : String(error),
+    });
+    return false;
+  } finally {
+    input.abortSignal?.removeEventListener("abort", externalAbort);
+  }
+}
