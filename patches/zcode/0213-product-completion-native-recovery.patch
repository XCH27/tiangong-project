+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import {
+  cancelWorkflowSnapshot,
+  reconcileWorkflowSnapshotForResume,
+} from "../src/workflow/lifecycle.js";
+
+// Q/Core extraction: test the original registered tool path and its actual SQLite result.
+test("registered Read retains numbered content, cache state and missing-file suggestions", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-read-extraction-"));
+  await writeFile(join(root, "notes.txt"), "First\nSecond\n");
+  const f = await fixture(undefined, false, {
+    config: { workingDirectory: root, toolAllowlist: ["Read"] },
+    deps: { fileSystemPort: new NodeFileSystemAdapter() },
+  });
+  try {
+    f.steps.push(
+      () => reply("", [{ id: "first-read", name: "Read", input: { file_path: "notes.txt" } }]),
+      (request) => {
+        assert.match(JSON.stringify(request.messages), /1\\tFirst|1\tFirst/);
+        return reply("", [{ id: "cached-read", name: "Read", input: { file_path: "notes.txt" } }]);
+      },
+      (request) => {
+        assert.match(
+          JSON.stringify(request.messages),
+          /file has not been modified|File has not changed|file has not changed|No changes|unchanged/i,
+        );
+        return reply("", [{ id: "missing-read", name: "Read", input: { file_path: "note.txt" } }]);
+      },
+      (request) => {
+        assert.match(JSON.stringify(request.messages), /Did you mean notes.txt/);
+        return reply("done");
+      },
+    );
+    await f.runtime.executeTurn("Read the authored fixture");
+    const parts = (await f.store.messages({ sessionID: f.runtime.sessionId }))
+      .flatMap((message) => message.parts)
+      .filter((part) => part.type === "tool") as any[];
+    assert.equal(parts.find((part) => part.callID === "first-read").state.status, "completed");
+    assert.equal(parts.find((part) => part.callID === "missing-read").state.status, "error");
+    await f.reopen();
+    assert.match(
+      JSON.stringify(await f.store.messages({ sessionID: f.runtime.sessionId })),
+      /First|notes.txt/,
+    );
+  } finally {
+    await f.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("registered ReadSessionContext extracts from original SQLite history through the existing model port", async () => {
+  const f = await fixture(undefined, false, { config: { toolAllowlist: ["ReadSessionContext"] } });
+  try {
+    const sessionID = "sess_partition_target" as never;
+    await f.store.createSession({
+      id: sessionID,
+      projectID: "project" as never,
+      directory: f.dir,
+      slug: "fixture-target",
+      title: "Context target",
+      version: "fixture",
+    });
+    await f.store.saveMessage({
+      id: "target-message" as never,
+      sessionID,
+      role: "user",
+      time: { created: 1 },
+    } as never);
+    await f.store.savePart({
+      id: "target-part" as never,
+      messageID: "target-message" as never,
+      sessionID,
+      type: "text",
+      text: "The authored fixture needs a concrete handoff about the notes file.",
+    } as never);
+    f.steps.push(
+      () =>
+        reply("", [
+          {
+            id: "context-read",
+            name: "ReadSessionContext",
+            input: {
+              sessionId: sessionID,
+              query: "notes file handoff",
+              strategy: "handoff",
+              maxTokens: 1000,
+            },
+          },
+        ]),
+      (request) => {
