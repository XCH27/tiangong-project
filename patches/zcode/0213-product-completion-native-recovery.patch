+test("Stop after actual artifact bytes commit then cold resume reuses the same physical artifact", async () => {
+  const h = await productionHandoffFixture();
+  let release: (() => void) | undefined;
+  try {
+    const app = await h.createSession();
+    await h.saveWorkflow(
+      app,
+      "interrupted-publish",
+      'await artifact.markdown("report", "committed once");',
+    );
+    const originalWrite = h.artifacts.writeToolResultArtifact.bind(h.artifacts);
+    let observe: (() => void) | undefined;
+    const published = new Promise<void>((resolve) => {
+      observe = resolve;
+    });
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    let held = false;
+    h.artifacts.writeToolResultArtifact = async (...args) => {
+      const receipt = await originalWrite(...args);
+      if (!held && args[0].toolName === "CreateWorkflow") {
+        held = true;
+        observe?.();
+        await gate;
+      }
+      return receipt;
+    };
+    assert.ok(app.startSavedWorkflow && app.cancelBackgroundTask);
+    const started = await app.startSavedWorkflow({ name: "interrupted-publish", scope: "project" });
+    assert.ok(started.ok, JSON.stringify(started));
+    await published;
+    const before = (await readdir(join(h.artifactRoot, app.sessionId), { withFileTypes: true }))
+      .filter((entry) => entry.isFile())
+      .map((entry) => entry.name);
+    assert.equal(
+      before.length,
+      1,
+      "original ArtifactStore really committed bytes before delayed receipt",
+    );
+    const stop = app.cancelBackgroundTask(started.runId);
+    // Observe the original durable cancellation, not a guessed timer or fake row.
+    const deadline = Date.now() + 2000;
+    while (h.store.workflowJournalStore().getRun(started.runId)?.status !== "stopped") {
+      assert.ok(Date.now() < deadline, "original Stop did not commit its durable terminal");
+      await new Promise((resolve) => setTimeout(resolve, 5));
+    }
+    assert.ok(release);
+    release();
+    const stopped = await stop;
+    assert.equal(stopped.cancelled, true, JSON.stringify(stopped));
+    const parentSessionId = app.sessionId;
+    await h.restart();
+    await h.request(zcodeProtocolMethods.sessionResume, {
+      sessionId: parentSessionId,
+      workspace: h.workspace,
+      dynamicWorkflowEnabled: true,
+    });
+    const reopened = h.apps.get(parentSessionId);
+    assert.ok(reopened?.resumeWorkflowRun);
+    const resumed = await reopened.resumeWorkflowRun({ workId: started.runId });
+    assert.equal(resumed.ok, true, JSON.stringify(resumed));
+    const settled = await waitForRun(reopened, started.runId);
+    assert.equal(settled.status, "completed", JSON.stringify(settled));
+    const after = (await readdir(join(h.artifactRoot, parentSessionId), { withFileTypes: true }))
+      .filter((entry) => entry.isFile())
+      .map((entry) => entry.name);
+    const report = await reopened.listDynamicWorkflowRunArtifacts?.({ runId: started.runId });
+    console.log(
+      JSON.stringify({
+        proof: "actual-stop-published-bytes-cold-resume",
+        runId: started.runId,
+        before,
+        after,
+        report,
+      }),
+    );
+    assert.deepEqual(
+      after,
+      before,
+      "same publication identity must not write a second native artifact on cold resume",
+    );
+  } finally {
+    release?.();
+    await h.close();
+  }
+});
