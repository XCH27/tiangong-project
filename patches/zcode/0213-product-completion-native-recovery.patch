--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-generate-image.ts
@@ -0,0 +1,198 @@
+import type { MediaRegistrySource } from "./api-media-generation-values.js";
+
+import {
+  MediaSubmissionNotStartedError,
+  type HttpClientPort,
+  type MediaGenerationModel,
+  type MediaGenerationPort,
+} from "@zcode/contracts";
+import { createHash } from "node:crypto";
+import {
+  MAX_RESPONSE_BYTES,
+  MAX_IMAGE_BYTES,
+  sniffImageMime,
+} from "./api-media-generation-values.js";
+
+export function createApiMediaGenerateImage(factoryBindings: {
+  readonly available: () => MediaGenerationModel[];
+  readonly imageBindings: Map<
+    string,
+    {
+      key: string;
+      vendor: "xai" | "openai";
+      origin: string;
+      images?: readonly { mediaType: string; bytes: Uint8Array }[];
+    }
+  >;
+  readonly imageBinding: (
+    providerId: string,
+    modelId: string,
+    prompt: string,
+    frozenKey?: string,
+  ) => { binding: string; origin: string; vendor: "xai" | "openai"; key: string } | null;
+  readonly connectionHeaders: (providerId: string) => { [k: string]: string };
+  readonly input: { registry: MediaRegistrySource; http: Pick<HttpClientPort, "request"> };
+}): MediaGenerationPort["generateImage"] {
+  return (
+    {
+      async generateImage(request) {
+        // 每次执行重新读取同一 Provider owner；设置页停用或删掉模型后不能沿用旧目录。
+        if (
+          !factoryBindings
+            .available()
+            .some(
+              (model) =>
+                model.kind === "image" &&
+                model.status === "requires-check" &&
+                model.providerId === request.providerId &&
+                model.modelId === request.modelId,
+            )
+        ) {
+          throw new MediaSubmissionNotStartedError(
+            "Image generation model or connection is unavailable; no request was submitted",
+          );
+        }
+        const prepared = factoryBindings.imageBindings.get(request.binding);
+        if (!prepared)
+          throw new MediaSubmissionNotStartedError(
+            "Image generation confirmation is no longer available; no request was submitted",
+          );
+        const selected = factoryBindings.imageBinding(
+          request.providerId,
+          request.modelId,
+          request.prompt,
+          prepared.key,
+        );
+        if (!selected)
+          throw new MediaSubmissionNotStartedError(
+            "Image generation connection changed after confirmation; no request was submitted",
+          );
+        const expectedBinding =
+          prepared &&
+          createHash("sha256")
+            .update(
+              JSON.stringify([
+                selected.binding,
+                prepared.images?.map((image) =>
+                  createHash("sha256").update(image.bytes).digest("hex"),
+                ),
+              ]),
+            )
+            .digest("hex");
+        if (!prepared || expectedBinding !== request.binding) {
+          throw new MediaSubmissionNotStartedError(
+            "Image generation connection changed after confirmation; no request was submitted",
+          );
+        }
+        if (request.signal.aborted)
+          throw new MediaSubmissionNotStartedError(
+            "Image generation stopped before submission; no request was submitted",
+          );
+        factoryBindings.imageBindings.delete(request.binding);
+        let headers: Record<string, string> = {
+          ...factoryBindings.connectionHeaders(request.providerId),
+          Authorization: `Bearer ${selected.key}`,
+          "Content-Type": "application/json",
+          Accept: "application/json",
+        };
+        let body = Buffer.from(
+          JSON.stringify({
+            model: request.modelId,
+            prompt: request.prompt,
+            ...(selected.vendor === "xai"
+              ? { response_format: "b64_json" }
+              : { n: 1, output_format: "png" }),
+            ...(prepared.images?.length && selected.vendor === "xai"
+              ? {
+                  ...(prepared.images.length === 1
+                    ? {
+                        image: {
+                          type: "image_url",
+                          url: `data:${prepared.images[0]!.mediaType};base64,${Buffer.from(prepared.images[0]!.bytes).toString("base64")}`,
+                        },
+                      }
+                    : {
+                        images: prepared.images.map((image) => ({
+                          type: "image_url",
+                          url: `data:${image.mediaType};base64,${Buffer.from(image.bytes).toString("base64")}`,
+                        })),
+                      }),
+                }
+              : {}),
+          }),
+        );
+        if (prepared.images?.length && selected.vendor === "openai") {
+          const form = new FormData();
+          form.set("model", request.modelId);
+          form.set("prompt", request.prompt);
+          form.set("n", "1");
+          for (const [index, image] of prepared.images.entries())
+            form.append(
+              "image[]",
+              new Blob([new Uint8Array(image.bytes)], { type: image.mediaType }),
+              `reference-${index + 1}.${image.mediaType === "image/jpeg" ? "jpg" : image.mediaType === "image/webp" ? "webp" : "png"}`,
+            );
+          const encoded = new Request(`${selected.origin}/v1/images/edits`, {
+            method: "POST",
+            body: form,
+          });
+          headers = { ...headers, "Content-Type": encoded.headers.get("content-type")! };
+          body = Buffer.from(await encoded.arrayBuffer());
+        }
+        const response = await factoryBindings.input.http.request(
+          {
+            url: `${selected.origin}/v1/images/${prepared.images?.length ? "edits" : "generations"}`,
+            method: "POST",
+            headers,
+            body,
+            maxResponseBytes: MAX_RESPONSE_BYTES,
+            timeoutMs: 120_000,
+            redirect: "manual",
+          },
+          { signal: request.signal },
+        );
+        if (response.status !== 200) {
+          throw new Error(`Image generation request failed (HTTP ${response.status})`);
+        }
+        const payload = JSON.parse(Buffer.from(response.body).toString("utf8")) as Record<
+          string,
+          unknown
+        >;
+        const image = Array.isArray(payload.data)
+          ? (payload.data[0] as Record<string, unknown> | undefined)
+          : undefined;
+        const encoded = typeof image?.b64_json === "string" ? image.b64_json : "";
+        if (
+          !encoded ||
+          encoded.length > MAX_IMAGE_BYTES * 2 ||
+          !/^[A-Za-z0-9+/]+={0,2}$/u.test(encoded)
+        ) {
+          throw new Error("Image generation returned no valid base64 image");
+        }
+        const bytes = Buffer.from(encoded, "base64");
+        if (bytes.length === 0 || bytes.length > MAX_IMAGE_BYTES) {
+          throw new Error("Image generation returned an invalid image size");
+        }
+        const mimeType = sniffImageMime(bytes);
+        if (!mimeType) throw new Error("Image generation returned an unsupported image format");
+        const ticks = (payload.usage as Record<string, unknown> | undefined)?.cost_in_usd_ticks;
+        return {
+          bytes,
+          mimeType,
+          billingProvider: selected.vendor,
+          authKind: "api-key",
+          ...(payload.usage &&
+          typeof payload.usage === "object" &&
+          !Array.isArray(payload.usage) &&
+          JSON.stringify(payload.usage).length < 16000
+            ? { providerUsage: payload.usage as Record<string, unknown> }
+            : {}),
+          ...(typeof payload.model === "string" ? { reportedModelId: payload.model } : {}),
+          ...(typeof ticks === "number" && Number.isFinite(ticks) && ticks >= 0
+            ? { reportedCostUsd: ticks / 10_000_000_000 }
+            : {}),
+        };
+      },
+    } satisfies Pick<MediaGenerationPort, "generateImage">
+  ).generateImage;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/api-media-generation-entry.ts b/apps/zcode-cli/packages/bootstrap/src/app/api-media-generation-entry.ts
new file mode 100644
index 00000000..d433e5ae
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-generation-entry.ts
@@ -0,0 +1,235 @@
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import { createApiMediaPrepareVideo } from "./api-media-prepare-video.js";
+import { createApiMediaSubmitVideo } from "./api-media-submit-video.js";
+import { createApiMediaReadVideo } from "./api-media-read-video.js";
+import { createApiMediaPrepareImage } from "./api-media-prepare-image.js";
+import { createApiMediaGenerateImage } from "./api-media-generate-image.js";
+import { getEnabledApiKeys, isOfficialOpenaiImageModel } from "@zcode/provider";
+import {
+  type HttpClientPort,
+  type MediaGenerationModel,
+  type MediaGenerationPort,
+} from "@zcode/contracts";
+import { createHash } from "node:crypto";
+import {
+  type MediaRegistrySource,
+  isGlobalXaiApi,
+  mediaApiOrigin,
+} from "./api-media-generation-values.js";
+
+export function createApiMediaGenerationPort(input: {
+  registry: MediaRegistrySource;
+  http: Pick<HttpClientPort, "request">;
+}): MediaGenerationPort {
+  const imageBindings = new Map<
+    string,
+    {
+      key: string;
+      vendor: "xai" | "openai";
+      origin: string;
+      images?: readonly { mediaType: string; bytes: Uint8Array }[];
+    }
+  >();
+  const videoBindings = new Map<
+    string,
+    { key: string; body: Record<string, unknown>; reference: string; referenceBytes: number }
+  >();
+  const connectionHeaders = (providerId: string) => {
+    const headers =
+      input.registry
+        .getSnapshot()
+        ?.resolution.resolvedProviders.find((provider) => provider.providerId === providerId)
+        ?.config.api?.headers ?? {};
+    return Object.fromEntries(
+      Object.entries(headers).filter(
+        ([name]) => !["authorization", "content-type", "accept"].includes(name.toLowerCase()),
+      ),
+    );
+  };
+  const credential = (providerId: string, reference?: string) => {
+    const provider = input.registry
+      .getSnapshot()
+      ?.resolution.resolvedProviders.find((provider) => provider.providerId === providerId);
+    const access = provider?.config.access;
+    if (
+      !provider?.enabled ||
+      provider.providerIssues.length ||
+      !isGlobalXaiApi(provider.config.api?.baseUrl) ||
+      access?.type !== "api-key"
+    )
+      throw new Error("The original video connection is unavailable");
+    const keys = getEnabledApiKeys(access);
+    const key = reference
+      ? keys.find(
+          (key) =>
+            createHash("sha256")
+              .update(JSON.stringify([providerId, key, connectionHeaders(providerId)]))
+              .digest("hex") === reference,
+        )
+      : keys[0];
+    if (!key)
+      throw new Error("The original video credential is unavailable; no new request was made");
+    return {
+      key,
+      reference: createHash("sha256")
+        .update(JSON.stringify([providerId, key, connectionHeaders(providerId)]))
+        .digest("hex"),
+    };
+  };
+  const jsonRequest = async (
+    providerId: string,
+    path: string,
+    key: string,
+    body?: Record<string, unknown>,
+    signal?: AbortSignal,
+  ) => {
+    const response = await input.http.request(
+      {
+        url: `https://api.x.ai/v1/${path}`,
+        method: body ? "POST" : "GET",
+        headers: {
+          ...connectionHeaders(providerId),
+          Authorization: `Bearer ${key}`,
+          Accept: "application/json",
+          ...(body ? { "Content-Type": "application/json" } : {}),
+        },
+        ...(body ? { body: Buffer.from(JSON.stringify(body)) } : {}),
+        maxResponseBytes: 1024 * 1024,
+        timeoutMs: 30_000,
+        redirect: "manual",
+      },
+      { signal: signal ?? AbortSignal.timeout(30_000) },
+    );
+    if (response.status < 200 || response.status >= 300)
+      throw new Error(`Media request failed (HTTP ${response.status})`);
+    return JSON.parse(Buffer.from(response.body).toString("utf8")) as {
+      id?: unknown;
+      aliases?: unknown;
+      output_modalities?: unknown;
+      request_id?: unknown;
+      status?: unknown;
+      model?: unknown;
+      video?: { url?: string; duration?: unknown };
+      usage?: { cost_in_usd_ticks?: unknown };
+    };
+  };
+  const available = () =>
+    input.registry.getSnapshot()?.resolution.resolvedProviders.flatMap((provider) => {
+      if (
+        !provider.enabled ||
+        provider.providerIssues.length ||
+        !mediaApiOrigin(provider.config.api?.baseUrl)
+      ) {
+        return [];
+      }
+      const access = provider.config.access;
+      if (access?.type !== "api-key" || getEnabledApiKeys(access).length === 0) return [];
+      return provider.models.flatMap((model): MediaGenerationModel[] => {
+        if (!model.enabled || model.issues.length) return [];
+        const output = model.config.properties?.outputFormat;
+        return [
+          ...(output?.supportsImage === true &&
+          (isGlobalXaiApi(provider.config.api?.baseUrl) ||
+            isOfficialOpenaiImageModel(provider.config.api?.baseUrl, model.modelId))
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "image" as const,
+                  status: "requires-check" as const,
+                  billingProvider: mediaApiOrigin(provider.config.api?.baseUrl)!.vendor,
+                },
+              ]
+            : []),
+          ...(output?.supportsVideo === true && isGlobalXaiApi(provider.config.api?.baseUrl)
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "video" as const,
+                  status: "requires-check" as const,
+                  billingProvider: "xai",
+                },
+              ]
+            : []),
+        ];
+      });
+    }) ?? [];
+  const targetScope = (providerId: string, modelId: string) => {
+    const provider = input.registry
+      .getSnapshot()
+      ?.resolution.resolvedProviders.find((candidate) => candidate.providerId === providerId);
+    return [
+      provider?.config.api,
+      provider?.models.find((model) => model.modelId === modelId)?.config,
+    ];
+  };
+  const imageBinding = (
+    providerId: string,
+    modelId: string,
+    prompt: string,
+    frozenKey?: string,
+  ) => {
+    const snapshot = input.registry.getSnapshot();
+    const provider = snapshot?.resolution.resolvedProviders.find(
+      (candidate) => candidate.providerId === providerId,
+    );
+    const model = provider?.models.find((candidate) => candidate.modelId === modelId);
+    const access = provider?.config.access;
+    const keys = access?.type === "api-key" ? getEnabledApiKeys(access) : [];
+    const key = frozenKey ? keys.find((key) => key === frozenKey) : keys[0];
+    if (
+      !snapshot ||
+      !provider?.enabled ||
+      provider.providerIssues.length ||
+      !mediaApiOrigin(provider.config.api?.baseUrl) ||
+      !model?.enabled ||
+      model.issues.length ||
+      model.config.properties?.outputFormat?.supportsImage !== true ||
+      !key
+    )
+      return null;
+    return {
+      key,
+      ...mediaApiOrigin(provider!.config.api?.baseUrl)!,
+      binding: createHash("sha256")
+        .update(
+          JSON.stringify([targetScope(providerId, modelId), providerId, modelId, prompt, key]),
+        )
+        .digest("hex"),
+    };
+  };
+  return {
+    listModels: available,
+    prepareVideo: createApiMediaPrepareVideo({
+      available,
+      credential,
+      jsonRequest,
+      targetScope,
+      videoBindings,
+    }),
+    submitVideo: createApiMediaSubmitVideo({
+      videoBindings,
+      available,
+      credential,
+      targetScope,
+      jsonRequest,
+    }),
+    readVideo: createApiMediaReadVideo({ credential, jsonRequest, input }),
+    prepareImage: createApiMediaPrepareImage({
+      imageBinding,
+      input,
+      connectionHeaders,
+      imageBindings,
+    }),
+    generateImage: createApiMediaGenerateImage({
+      available,
+      imageBindings,
+      imageBinding,
+      connectionHeaders,
+      input,
+    }),
+  };
+}
