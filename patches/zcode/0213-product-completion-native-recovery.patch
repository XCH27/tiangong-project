+import { superviseFlow, requestReview } from "./workspace-hook-review-flow.js";
+import { respond, toggle, revoke, revokeCurrent } from "./workspace-hook-review-mutations.js";
+import {
+  refreshPendingFlow,
+  openReviewFlowForNewPendingItems,
+  openOrReuseFlow,
+  buildRequest,
+} from "./workspace-hook-review-pending-flow.js";
+import {
+  applyPersistentTrust,
+  enqueueMutation,
+  emitAdmissionUpdatedAfterMutation,
+} from "./workspace-hook-review-trust-write.js";
+
+import type { WorkspaceHookReviewControllerOwner } from "./workspace-hook-review-controller-owner.js";
+
+export function installWorkspaceHookReviewControllerMethods(
+  prototype: WorkspaceHookReviewControllerOwner,
+): void {
+  const methods = {
+    superviseFlow,
+    requestReview,
+    respond,
+    toggle,
+    revoke,
+    revokeCurrent,
+    refreshPendingFlow,
+    openReviewFlowForNewPendingItems,
+    openOrReuseFlow,
+    buildRequest,
+    applyPersistentTrust,
+    enqueueMutation,
+    emitAdmissionUpdatedAfterMutation,
+  };
+  Object.defineProperties(
+    prototype,
+    Object.fromEntries(
+      Object.entries(methods).map(([name, value]) => [
+        name,
+        { value, writable: true, configurable: true, enumerable: false },
+      ]),
+    ),
+  );
+}
