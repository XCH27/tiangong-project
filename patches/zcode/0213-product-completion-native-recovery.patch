+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { SESSION_ENTRY_WORKSPACE_CHECKPOINT, SessionEventType } from "@zcode/contracts";
+import { whiteboardRelativePath } from "@zcode/shared";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+async function failedThenCommittedRetry(failureTarget: "checkpoint" | "commit" = "checkpoint") {
+  const files = new NodeFileSystemAdapter();
+  const write = files.writeTextFile.bind(files);
+  let failWrite = true;
+  let writeCalls = 0;
+  files.writeTextFile = async (request, options) => {
+    writeCalls++;
+    if (failWrite) {
+      failWrite = false;
+      throw new Error("Authored failure before publication");
+    }
+    return write(request, options);
+  };
+  const f = await fixture(undefined, false, {
+    config: {
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      titleGeneration: { enabled: false },
+    },
+    deps: { fileSystemPort: files },
+  });
+  try {
+    const board = {
+      id: `whiteboard:${randomUUID()}`,
+      name: "Owned retry",
+      width: 1280 as const,
+      height: 800 as const,
+      strokes: [],
+      undoneStrokes: [],
+      createdAt: 1,
+      updatedAt: 1,
+    };
+    const mutationId = randomUUID();
+    const save = () =>
+      f.runtime.performWhiteboardControl({
+        operation: "update",
+        input: { document: board, mutationId, expectedAbsent: true },
+      });
+    const first = await save();
+    assert.equal(first.accepted && first.result.success, false);
+    await assert.rejects(readFile(join(f.dir, whiteboardRelativePath(board.id))), {
+      code: "ENOENT",
+    });
+    const original = f.store.saveSessionEntry.bind(f.store);
+    f.store.saveSessionEntry = async (entry) => {
+      if (
+        (failureTarget === "checkpoint" && entry.type === SESSION_ENTRY_WORKSPACE_CHECKPOINT) ||
+        (failureTarget === "commit" &&
+          entry.type === "native/whiteboard_checkpoint" &&
+          entry.data.status === "committed")
+      )
+        throw new Error("Authored retry checkpoint failure");
+      return original(entry);
+    };
+    await assert.rejects(save(), /Authored retry checkpoint failure/);
+    const messages = await f.store.messages({ sessionID: f.runtime.getSessionId() });
+    const completed = messages.find((message) =>
+      message.parts.some(
+        (part) =>
+          part.type === "tool" &&
+          part.tool === "WhiteboardUpdate" &&
+          part.state.status === "completed",
+      ),
+    );
+    const failed = messages.find((message) =>
+      message.parts.some(
+        (part) =>
+          part.type === "tool" && part.tool === "WhiteboardUpdate" && part.state.status === "error",
+      ),
+    );
+    assert.ok(completed && completed.info.role === "assistant");
+    assert.ok(failed && failed.info.role === "assistant");
+    assert.notEqual(completed.info.parentID, failed.info.parentID);
+    const bytes = await readFile(join(f.dir, whiteboardRelativePath(board.id)), "utf8");
+    const prepared = await f.store.sessionEntries({
+      sessionID: f.runtime.getSessionId(),
+      type: "native/whiteboard_checkpoint",
+    });
+    if (failureTarget === "checkpoint")
+      assert.equal(
+        prepared[0]?.data.messageId,
+        completed.info.parentID,
+        "the accepted retry anchor was already durably known",
+      );
+    else assert.equal(prepared[0]?.data.status, "prepared");
+    const liveCheckpoint = (
+      await f.runtime.getSessionEventStore().getEvents(f.runtime.getSessionId())
+    ).findLast((event) => event.type === SessionEventType.CheckpointCreated);
+    if (failureTarget === "checkpoint") assert.ok(liveCheckpoint);
+    return {
+      f,
+      board,
+      mutationId,
+      save,
+      bytes,
+      prepared: prepared[0]!,
+      successfulUserId: completed.info.parentID,
+      successfulReceiptId: completed.info.id,
+      failedUserId: failed.info.parentID,
+      successfulTurnId: messages.find((message) => message.info.id === completed.info.parentID)
+        ?.info.anchor?.turnId,
+      get writes() {
+        return writeCalls;
+      },
+    };
+  } catch (error) {
+    await f.close();
+    throw error;
+  }
+}
