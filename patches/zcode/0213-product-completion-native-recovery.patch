+++ b/scripts/build-desktop-agent-cli.test.mjs
@@ -0,0 +1,161 @@
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, readFile, writeFile, copyFile, symlink, rm } from "node:fs/promises";
+import { spawnSync } from "node:child_process";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import test from "node:test";
+
+// Actual build entry and staging owner. Only compiler/runtime build processes are authored fixture
+// programs; no reviewed source, provider input, installed runtime or profile executes in this test.
+async function fixture(fail = false) {
+  const root = await mkdtemp(join(tmpdir(), "zcode-bootstrap-build-"));
+  const put = async (path, content, executable = false) => {
+    const target = join(root, path);
+    await mkdir(resolve(target, ".."), { recursive: true });
+    await writeFile(target, content, executable ? { mode: 0o755 } : undefined);
+  };
+  const production = resolve(import.meta.dirname, "..");
+  for (const path of [
+    "scripts/build-desktop-agent-cli.mjs",
+    "scripts/spawn-command.mjs",
+    "scripts/builtin-provider-config.mjs",
+    "scripts/load-endpoint-env.mjs",
+    "packages/desktop/scripts/stage-agent-bundle.mjs",
+  ]) {
+    const target = join(root, path);
+    await mkdir(resolve(target, ".."), { recursive: true });
+    await copyFile(join(production, path), target);
+  }
+  await symlink(join(production, "node_modules"), join(root, "node_modules"), "dir");
+  await put("package.json", JSON.stringify({ type: "module" }));
+  await put("config/provider/zcode-builtin.json", await readFile(join(production, "config/provider/zcode-builtin.json")));
+  await mkdir(join(root, "packages"), { recursive: true });
+  await symlink(join(production, "packages/provider-node"), join(root, "packages/provider-node"), "dir");
+  await put("apps/zcode-cli/packages/zcode-guide-plugin/README.md", "Authored guide fixture");
+  await put("apps/zcode-cli/packages/cli/dist/zcode.cjs", "OLD_ARTIFACT");
+  await put("apps/zcode-cli/packages/cli/src/index.ts", "CURRENT_SOURCE");
+  for (const name of [
+    "shared-types",
+    "contracts",
+    "dynamic-workflow",
+    "dynamic-workflow-runtime",
+    "core",
+    "adapters",
+    "i18n",
+    "telemetry",
+    "bootstrap",
+  ])
+    await mkdir(join(root, "apps/zcode-cli/packages", name), { recursive: true });
+  await put(
+    "apps/zcode-cli/node_modules/typescript/bin/tsc",
+    `
+const fs=require('node:fs');
+fs.appendFileSync(process.env.FLEET_BUILD_LOG,process.cwd()+'\\n');
+if(process.env.FLEET_BUILD_FAIL==='1')process.exit(9);
+if(process.env.FLEET_BUILD_FAIL==='signal')process.kill(process.pid,'SIGTERM');
+`,
+  );
+  await put("apps/zcode-cli/packages/dynamic-workflow/scripts/generate-libs.mjs", "");
+  await put(
+    "apps/zcode-cli/packages/cli/scripts/build.mjs",
+    `
+import {readFile,writeFile} from 'node:fs/promises';
+await writeFile('dist/zcode.cjs',await readFile('src/index.ts'));
+`,
+  );
+  await put(
+    "bin/pnpm",
+    `#!/bin/sh\nexec "$FLEET_BUILD_NODE" "$FLEET_BUILD_ROOT/runtime-build.cjs" "$@"\n`,
+    true,
+  );
+  await put(
+    "runtime-build.cjs",
+    `
+const fs=require('node:fs'),path=require('node:path');
+const base=path.join(process.env.FLEET_BUILD_ROOT,'apps/zcode-cli/packages');
+const name=process.argv[3];
+if(name==='@zcode/node-repl-host'){fs.mkdirSync(path.join(base,'node-repl-host/dist/mcp'),{recursive:true});fs.writeFileSync(path.join(base,'node-repl-host/dist/mcp/server.js'),'CURRENT_RUNTIME')}
+if(name==='@zcode/browser-use-plugin'){fs.mkdirSync(path.join(base,'browser-use-plugin/scripts'),{recursive:true});fs.writeFileSync(path.join(base,'browser-use-plugin/scripts/browser-client.mjs'),'CURRENT_CLIENT')}
+`,
+  );
+  const log = join(root, "build.log");
+  const result = spawnSync(process.execPath, [join(root, "scripts/build-desktop-agent-cli.mjs")], {
+    cwd: root,
+    env: {
+      ...process.env,
+      PATH: join(root, "bin") + ":" + process.env.PATH,
+      ZCODE_BOOTSTRAP_WITH_REMOTE: "1",
+      ZCODE_ENV: "production",
+      FLEET_BUILD_ROOT: root,
+      FLEET_BUILD_NODE: process.execPath,
+      FLEET_BUILD_LOG: log,
+      FLEET_BUILD_FAIL: fail === "signal" ? "signal" : fail ? "1" : "0",
+    },
+    encoding: "utf8",
+    timeout: 20_000,
+  });
+  return { root, log, result };
+}
+
+test("bootstrap rebuilds current source despite an existing agent bundle before staging", async () => {
+  const f = await fixture();
+  try {
+    assert.equal(f.result.status, 0, f.result.stderr);
+    const calls = (await readFile(f.log, "utf8")).trim().split("\n");
+    assert.equal(calls.length, 9);
