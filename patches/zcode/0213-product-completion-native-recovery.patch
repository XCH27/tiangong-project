+import { randomUUID } from "node:crypto";
+import { whiteboardControlInputSchema, type WhiteboardControlInput } from "@zcode/shared";
+import type { TraceContext } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { performNativeToolControl, type NativeToolControlResult } from "./native-tool-control.js";
+import { recoverNativeWhiteboardCheckpoints } from "./native-whiteboard-checkpoint.js";
+
+export type NativeWhiteboardControlResult = NativeToolControlResult;
+
+/** No arbitrary tool name, model selection, approval override or caller-selected workspace. */
+export function performWhiteboardControl(
+  this: AgentRuntimeInternal,
+  raw: WhiteboardControlInput,
+  options: { abortSignal?: AbortSignal; traceContext?: TraceContext; operationId?: string } = {},
+): Promise<NativeWhiteboardControlResult> {
+  const input = whiteboardControlInputSchema.parse(raw);
+  const name = input.operation === "update" ? "WhiteboardUpdate" : "ReadWhiteboard";
+  if (!this.fileSystemPort || !this.registry.get(name))
+    return Promise.resolve({ accepted: false, reason: "unavailable" });
+  const summary =
+    input.operation === "update"
+      ? `Save whiteboard: ${input.input.document.name}`
+      : "boardId" in input.input
+        ? `Open whiteboard: ${input.input.boardId}`
+        : "List saved whiteboards";
+  return performNativeToolControl(this, {
+    ...options,
+    foregroundPrefix: "native-whiteboard",
+    presentation: { source: "native_whiteboard", agent: "native-whiteboard" },
+    prepare: async () => ({
+      call: { id: `native-${randomUUID()}`, name, input: input.input },
+      summary,
+    }),
+    recover: () => recoverNativeWhiteboardCheckpoints(this),
+  });
+}
