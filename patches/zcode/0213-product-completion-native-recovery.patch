+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection-model-completion.ts
@@ -0,0 +1,170 @@
+import type { ProductProjectionOwner } from "./product-projection-owner.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import type { ModelCompletePayload, ModelUsage, SessionEvent } from "@zcode/contracts";
+import type {
+  ConversationDelta,
+  SessionUsageState,
+  ContextWindowMeasurement,
+} from "@zcode/shared/zcode-protocol-v4";
+import { HYDRATION_TRACE_ID } from "./projection-state.js";
+
+export function onModelComplete(
+  this: ProductProjectionOwner,
+  event: SessionEvent,
+): ConversationDelta[] {
+  const payload = event.payload as ModelCompletePayload;
+  const retryClearDeltas = this.acceptsActiveModelEvent(event) ? this.setApiRetry(null) : [];
+  // 与旧 reducer 同一裁决：只有主会话往返才能覆盖 context 水位。
+  const isMainTurn =
+    payload.querySource !== undefined
+      ? payload.querySource === "main_turn"
+      : payload.stopReason !== "tool_internal";
+  if (isMainTurn) this.outputContinuationTextRowId = null;
+  if (
+    isMainTurn &&
+    (payload.outcome === undefined || payload.outcome === "completed") &&
+    payload.stopReason?.trim().toLowerCase() === "length" &&
+    payload.toolCallCount === 0
+  ) {
+    const lastVisibleRow = this.snapshot.rows.window.at(-1);
+    if (
+      lastVisibleRow?.kind === "assistantText" &&
+      lastVisibleRow.turnId === this.turnIdOf(event) &&
+      lastVisibleRow.state === "complete"
+    ) {
+      this.outputContinuationTextRowId = lastVisibleRow.rowId;
+    }
+  }
+  // subagent ModelComplete 的 usage 仍不是主会话水位，但它携带的
+  // fileChanges 是 child session 自己的 workspace 事实，必须独立投影到 child turn header。
+  const supportsFileChangeSummary = isMainTurn || payload.querySource === "subagent";
+  const deltas: ConversationDelta[] = [];
+  if (supportsFileChangeSummary && payload.fileChanges && payload.fileChanges.files > 0) {
+    const turnId = this.turnIdOf(event);
+    const headerRowId = this.turnHeaderRowIdByTurnId.get(turnId);
+    const headerRow = headerRowId !== undefined ? this.findRow(headerRowId) : undefined;
+    if (headerRow?.kind === "turnHeader") {
+      deltas.push({
+        op: "row.upserted",
+        row: {
+          ...headerRow,
+          fileChanges: {
+            additions: payload.fileChanges.additions,
+            deletions: payload.fileChanges.deletions,
+            files: payload.fileChanges.files,
+            state: "active",
+          },
+        },
+      });
+    }
+  }
+  if (!isMainTurn) return [...deltas, ...retryClearDeltas];
+  // hydration 的合成 ModelComplete 只有零占位，不是一次新 provider 测量。
+  if (String(event.traceId) === HYDRATION_TRACE_ID) return [...deltas, ...retryClearDeltas];
+  const usage = (payload.usage ?? {}) as ModelUsage;
+  const reported = (value: unknown): value is number =>
+    typeof value === "number" && Number.isFinite(value) && value >= 0;
+  // 单独 output/cache/input 不足以证明完整占用；明细仍保留每个已知字段。
+  const inputAndOutput =
+    reported(usage.inputTokens) && reported(usage.outputTokens)
+      ? usage.inputTokens + usage.outputTokens
+      : undefined;
+  const count = reported(inputAndOutput)
+    ? inputAndOutput
+    : reported(usage.totalTokens)
+      ? usage.totalTokens
+      : undefined;
+  const measured = count !== undefined;
+  const usedTokens = measured ? (count ?? 0) : this.contextWindowState.usedTokens;
+  const pending = this.contextWindowState.request;
+  const request =
+    pending?.traceId === String(event.traceId) && pending.turnId === event.turnId
+      ? pending
+      : undefined;
+  const selection = this.snapshot.config;
+  const modelChanged = request
+    ? Boolean(
+        selection.provider &&
+        selection.model &&
+        (request.providerId !== selection.provider || request.modelId !== selection.model),
+      )
+    : this.contextWindowState.measurement?.staleReason === "model-change";
+  const measurement: ContextWindowMeasurement = measured
+    ? {
+        source: "provider-usage",
+        state: modelChanged ? "stale" : "current",
+        observedAt: this.ms(event),
+        ...(request ? { providerId: request.providerId, modelId: request.modelId } : {}),
+        ...(modelChanged ? { staleReason: "model-change" as const } : {}),
+      }
+    : {
+        ...(this.contextWindowState.measurement ?? { source: "unknown" }),
+        state: "stale",
+      };
+  // 每个主请求替换其报告；缺项保持未知，不能让上一次完整报告冒充本次结果。
+  const lastRequest: NonNullable<SessionUsageState["lastRequest"]> = request
+    ? { providerId: request.providerId, modelId: request.modelId }
+    : {};
+  if (typeof payload.accountId === "string" && payload.accountId) {
+    lastRequest.accountId = payload.accountId;
+    lastRequest.observedAt = this.ms(event);
+  }
+  for (const key of [
+    "inputTokens",
+    "outputTokens",
+    "cacheReadTokens",
+    "cacheWriteTokens",
+    "reasoningTokens",
+  ] as const) {
+    const value = usage[key];
+    if (typeof value === "number" && Number.isFinite(value) && value >= 0) {
+      lastRequest[key] = value;
+      lastRequest.observedAt = this.ms(event);
+    }
+  }
+  this.contextWindowState.usedTokens = usedTokens;
+  this.contextWindowState.measurement = measurement;
+  this.contextWindowState.measuredByEvent ||= measured;
+  if (request) this.contextWindowState.request = undefined;
+  // 切模后到达的旧请求仍可计消费，但不能把旧模型容量覆盖回当前 Registry 容量。
+  const maxTokens = modelChanged
+    ? this.contextWindowState.maxTokens
+    : payload.contextWindow !== undefined
+      ? payload.contextWindow
+      : this.contextWindowState.maxTokens;
+  this.contextWindowState.maxTokens = maxTokens;
+  const cumulative = this.snapshot.usage.cumulative;
+  deltas.push({
+    op: "state.updated",
+    patch: {
+      usage: {
+        lastRequest,
+        // 新主请求的 null 清除同一模型历史确认容量；仅旧事件缺字段才沿用。
+        // token 继续在侧状态和累计值中更新，未知容量不制造零分母。
+        contextWindow:
+          maxTokens === null
+            ? null
+            : {
+                usedTokens,
+                maxTokens,
+                measurement,
+                autoCompactThresholdTokens:
+                  this.snapshot.usage.contextWindow?.autoCompactThresholdTokens ?? null,
+                ...(payload.cacheHit ? { cache: payload.cacheHit } : {}),
+                ...(payload.contextUsageBreakdown && payload.contextUsageBreakdown.length > 0
+                  ? { breakdown: payload.contextUsageBreakdown }
+                  : {}),
+              },
+        cumulative: {
+          inputTokens: cumulative.inputTokens + (lastRequest.inputTokens ?? 0),
+          outputTokens: cumulative.outputTokens + (lastRequest.outputTokens ?? 0),
+          cacheReadTokens: cumulative.cacheReadTokens + (lastRequest.cacheReadTokens ?? 0),
+          cacheWriteTokens: cumulative.cacheWriteTokens + (lastRequest.cacheWriteTokens ?? 0),
+        },
+      },
+    },
+  });
+  // ModelComplete 是缺少 network completed 事件时的成功兜底，不能让重试提示悬挂。
+  deltas.push(...retryClearDeltas);
+  return deltas;
+}
