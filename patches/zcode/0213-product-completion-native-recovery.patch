+      assert.ok(report);
+      assert.equal(report.version, ARTIFACT_CAPS.maxVersionsPerArtifact);
+      assert.deepEqual(
+        report.versions.map((item) => item.version),
+        Array.from({ length: ARTIFACT_CAPS.maxVersionsPerArtifact }, (_, i) => i + 1),
+      );
+      assert.ok(report.versions.every((item) => item.primary === true));
+    } finally {
+      await h.close();
+    }
+  });
+
+  test("different IDs publish concurrently while a real same-owner receipt remains held", async () => {
+    const h = await productionHandoffFixture();
+    let release: (() => void) | undefined;
+    try {
+      const app = await h.createSession();
+      await h.saveWorkflow(
+        app,
+        "independent-artifacts",
+        'await Promise.all([artifact.markdown("slow", "slow"), artifact.markdown("fast", "fast")]);',
+      );
+      const original = h.artifacts.writeToolResultArtifact.bind(h.artifacts);
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      h.artifacts.writeToolResultArtifact = async (...args) => {
+        const receipt = await original(...args);
+        if (args[0].content === "slow") await gate;
+        return receipt;
+      };
+      assert.ok(app.startSavedWorkflow);
+      const started = await app.startSavedWorkflow({
+        name: "independent-artifacts",
+        scope: "project",
+      });
+      assert.ok(started.ok, JSON.stringify(started));
+      const deadline = Date.now() + 2000;
+      while (
+        !(await app.listDynamicWorkflowRunArtifacts?.({ runId: started.runId }))?.some(
+          (item) => item.id === "fast",
+        )
+      ) {
+        assert.ok(Date.now() < deadline, "healthy independent ID blocked behind held receipt");
+        await new Promise((resolve) => setTimeout(resolve, 5));
+      }
+      assert.equal(
+        (await app.listDynamicWorkflowRunArtifacts?.({ runId: started.runId }))?.some(
+          (item) => item.id === "slow",
+        ),
+        false,
+      );
+      assert.ok(release);
+      release();
+      assert.equal((await waitForRun(app, started.runId)).status, "completed");
+    } finally {
+      release?.();
+      await h.close();
+    }
+  });
+  test("original Stop prevents a queued same-ID publisher from dispatching another byte write", async () => {
+    const h = await productionHandoffFixture();
+    let release: (() => void) | undefined;
+    try {
+      const app = await h.createSession();
+      await h.saveWorkflow(
+        app,
+        "stop-queued-artifact",
+        'await Promise.all([artifact.markdown("report", "A"), artifact.markdown("report", "B")]);',
+      );
+      const original = h.artifacts.writeToolResultArtifact.bind(h.artifacts);
+      let observed: (() => void) | undefined;
+      const written = new Promise<void>((resolve) => {
+        observed = resolve;
+      });
+      const gate = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      let writes = 0;
+      h.artifacts.writeToolResultArtifact = async (...args) => {
+        const receipt = await original(...args);
+        if (args[0].toolName === "CreateWorkflow") {
+          writes++;
+          observed?.();
+          await gate;
+        }
+        return receipt;
+      };
+      assert.ok(app.startSavedWorkflow && app.cancelBackgroundTask);
+      const started = await app.startSavedWorkflow({
+        name: "stop-queued-artifact",
+        scope: "project",
+      });
+      assert.ok(started.ok, JSON.stringify(started));
+      await written;
+      const stop = app.cancelBackgroundTask(started.runId);
+      const deadline = Date.now() + 2000;
+      while (h.store.workflowJournalStore().getRun(started.runId)?.status !== "stopped") {
+        assert.ok(Date.now() < deadline);
+        await new Promise((resolve) => setTimeout(resolve, 5));
+      }
+      assert.ok(release);
+      release();
+      await stop;
+      await h.restart();
+      assert.equal(writes, 1);
+      assert.equal((await files(h.artifactRoot, app.sessionId)).length, 1);
+    } finally {
+      release?.();
+      await h.close();
+    }
+  });
+}
