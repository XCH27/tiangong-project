+import assert from "node:assert/strict";
+import test from "node:test";
+import { join } from "node:path";
+import { ProviderRegistry } from "@zcode/provider";
+import { createZCodeApp } from "../src/app/create-app.js";
+import { ApiProviderModelRuntime } from "../src/app/provider-registry-model-runtime.js";
+import { fixture } from "../../core/test/helpers/pi-runtime-fixture.js";
+
+test("partial real App initialization disposes its one original provider owner and preserves a borrowed SQLite store", async () => {
+  const f = await fixture();
+  await f.runtime.ensureSessionPersistedForExternalActivity("authored caller-owned row");
+  const originalDispose = ApiProviderModelRuntime.prototype.dispose;
+  const disposed: ApiProviderModelRuntime[] = [];
+  let reads = 0;
+  ApiProviderModelRuntime.prototype.dispose = function () {
+    disposed.push(this);
+    return originalDispose.call(this);
+  };
+  try {
+    const options: Parameters<typeof createZCodeApp>[0] = {
+      sessionId: "session" as never,
+      sessionStore: f.store,
+      providerRegistry: new ProviderRegistry([]),
+      skipUserConfig: true,
+      officialPluginRoots: [],
+      pluginStorageRoot: join(f.dir, "plugins"),
+      runtimeConfig: {
+        workingDirectory: f.dir,
+        memory: { use: false },
+        mcp: { enabled: false },
+        dynamicWorkflowEnabled: false,
+      },
+      env: { ZCODE_HOME: join(f.dir, "app-home"), ZCODE_STORAGE_DIR: join(f.dir, "app-storage") },
+    };
+    // This read occurs after the original provider's start, within Runtime options construction.
+    Object.defineProperty(options, "pageAssistantPort", {
+      get() {
+        reads++;
+        throw new Error("authored partial initialization failure");
+      },
+    });
+    await assert.rejects(createZCodeApp(options), /authored partial initialization failure/);
+    assert.equal(reads, 1);
+    assert.equal(disposed.length, 1);
+    assert.ok(disposed[0] instanceof ApiProviderModelRuntime);
+    assert.throws(
+      () =>
+        disposed[0]!.modelFactory({
+          selection: { providerId: "fixture", modelId: "never-requested" },
+        }),
+      /start/,
+    );
+    assert.ok(
+      await f.store.getSession("session" as never),
+      "borrowed store remains owned and usable by its original caller",
+    );
+    assert.equal(f.requests.length, 0);
+  } finally {
+    ApiProviderModelRuntime.prototype.dispose = originalDispose;
+    await f.close();
+  }
+});
