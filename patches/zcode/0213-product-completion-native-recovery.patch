+
+test("workflow lifecycle public functions retain immutable scope and terminal timestamps", () => {
+  const snapshot = {
+    graph: {
+      nodes: [
+        { id: "a", phase: "work", status: "active" },
+        { id: "b", phase: "other", status: "active" },
+      ],
+      edges: [],
+    },
+    phases: [
+      { phase: "work", status: "active" },
+      { phase: "other", status: "active" },
