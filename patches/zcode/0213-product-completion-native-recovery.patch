+  updateTargetStatus(status: GoalStatus): Promise<SessionGoal | null>;
+  clearTarget(): Promise<boolean>;
+  continueActiveTarget(options?: SubmitPromptOptions): Promise<TurnResult | null>;
+  recordInputHistory(
+    input: PromptInput,
