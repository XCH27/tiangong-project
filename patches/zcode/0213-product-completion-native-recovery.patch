@@ -0,0 +1,69 @@
+import { AgentRuntime } from "@zcode/core";
+
+import { type TraceContext, createSessionEvent } from "@zcode/contracts";
+
+import type { ZCodeAppOptions } from "./types.js";
+
+import { createWorkspaceHookRuntimeSecurity } from "./workspace-hook-trust.js";
+
+import type { Logger, AgentRuntimeConfig } from "@zcode/core";
+import type { ConfigResult } from "@zcode/adapters";
+import type { SessionId } from "@zcode/contracts";
+
+export function createAppHookSecurityOptions(factoryBindings: {
+  readonly appVersion: string;
+  readonly logger: Logger;
+  readonly options: ZCodeAppOptions;
+  readonly configResult: ConfigResult;
+  readonly runtimeConfig: AgentRuntimeConfig;
+  readonly sessionId: SessionId;
+  readonly workingDirectory: string;
+  readonly runtime: AgentRuntime | undefined;
+  readonly traceContext: TraceContext;
+}): Parameters<typeof createWorkspaceHookRuntimeSecurity>[0] {
+  return {
+    appVersion: factoryBindings.appVersion,
+    logger: factoryBindings.logger,
+    projectConfigPath: factoryBindings.options.projectConfigPath,
+    policy: factoryBindings.options.workspaceHookPolicy,
+    policyProvider: factoryBindings.options.workspaceHookPolicyProvider,
+    reviewHost: factoryBindings.options.workspaceHookReviewHost,
+    workspaceHookTrustEnabled: factoryBindings.options.workspaceHookTrustEnabled,
+    runtimeRoot: factoryBindings.configResult.sources.project.workspaceHookRuntimeRoot ?? {
+      // Fallback 只在 config-factory 未导出时生效（理论上不会发生）。
+      // 此处原本无条件按单层 runtimeConfig.hooks 重建 runtimeRoot，与
+      // config-factory 遍历 default/user/project/env/cli 全部层的推导不一致，
+      // 导致 review 快照与 toggle 重建的 bundleDigest 不同，
+      // 「审核中 toggle」被误报为 workspace_hooks_snapshot_mismatch。
+      enabled: factoryBindings.runtimeConfig.hooks?.enabled === true,
+      timeoutMs: factoryBindings.runtimeConfig.hooks?.timeoutMs ?? 60_000,
+      maxOutputBytes: factoryBindings.runtimeConfig.hooks?.maxOutputBytes ?? 32_768,
+    },
+    sessionId: factoryBindings.sessionId,
+    snapshot: factoryBindings.configResult.sources.project.workspaceHookSnapshot,
+    userConfigPath: factoryBindings.configResult.sources.user.path,
+    workingDirectory: factoryBindings.workingDirectory,
+    ...(factoryBindings.options.workspaceHookReviewHost
+      ? {
+          emitReviewEvent: async (event) => {
+            if (!factoryBindings.runtime) throw new Error("ZCode runtime is not initialized yet.");
+            await factoryBindings.runtime.appendEvent(
+              createSessionEvent(event.type, factoryBindings.sessionId, event.payload, {
+                traceId: factoryBindings.traceContext.traceId,
+              }),
+              factoryBindings.traceContext,
+            );
+          },
+          emitAdmissionEvent: async (event) => {
+            if (!factoryBindings.runtime) throw new Error("ZCode runtime is not initialized yet.");
+            await factoryBindings.runtime.appendEvent(
+              createSessionEvent(event.type, factoryBindings.sessionId, event.payload, {
+                traceId: factoryBindings.traceContext.traceId,
+              }),
+              factoryBindings.traceContext,
+            );
+          },
+        }
+      : {}),
+  };
+}
