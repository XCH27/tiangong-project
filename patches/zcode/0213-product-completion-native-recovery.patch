@@ -0,0 +1,97 @@
+import { lstat, realpath, stat } from "node:fs/promises";
+import { isAbsolute, join, relative, sep } from "node:path";
+import { createFileSystemError } from "@zcode/contracts";
+import { throwIfAborted } from "./file-errors.js";
+import { resolveAbsoluteRequestPath } from "./file-values.js";
+
+export interface NativeFileBoundary {
+  readonly requestedRoot: string;
+  readonly root: string;
+  readonly path: string;
+}
+
+function descendantPath(root: string, path: string): string | undefined {
+  const child = relative(root, path);
+  return child && !isAbsolute(child) && child !== ".." && !child.startsWith(`..${sep}`)
+    ? child
+    : undefined;
+}
+
+function denied(path: string) {
+  return createFileSystemError({
+    code: "permission_denied",
+    path,
+    message: "Native document path must remain inside its workspace without descendant symlinks",
+  });
+}
+
+export async function resolveNativeFileBoundary(
+  path: string,
+  boundaryRoot: string,
+  signal?: AbortSignal,
+): Promise<NativeFileBoundary> {
+  throwIfAborted(signal);
+  const requestedRoot = resolveAbsoluteRequestPath(boundaryRoot);
+  const root = await realpath(requestedRoot);
+  const child = descendantPath(requestedRoot, path) ?? descendantPath(root, path);
+  if (child === undefined) throw denied(path);
+  const boundary = { requestedRoot, root, path: join(root, child) };
+  await assertNativeFileBoundary(boundary, signal);
+  return boundary;
+}
+
+/**
+ * 原通用文件路径不承担原生文档边界；显式 boundaryRoot 才启用这条保护。
+ * 仅规范化 workspace 本身，所有子路径（包括目标文件）拒绝软链接，避免保存逃逸。
+ */
+export async function assertNativeFileBoundary(
+  boundary: NativeFileBoundary,
+  signal?: AbortSignal,
+): Promise<void> {
+  throwIfAborted(signal);
+  if ((await realpath(boundary.requestedRoot)) !== boundary.root) throw denied(boundary.path);
+  if (!(await stat(boundary.root)).isDirectory()) {
+    throw createFileSystemError({
+      code: "not_file",
+      path: boundary.root,
+      message: "Native document workspace root must be a directory",
+    });
+  }
+  const child = descendantPath(boundary.root, boundary.path);
+  if (child === undefined) throw denied(boundary.path);
+  const parts = child.split(sep);
+  let current = boundary.root;
+  for (const [index, part] of parts.entries()) {
+    throwIfAborted(signal);
+    current = join(current, part);
+    try {
+      const info = await lstat(current);
+      if (info.isSymbolicLink()) throw denied(current);
+      if (index < parts.length - 1 && !info.isDirectory()) {
+        throw createFileSystemError({
+          code: "not_file",
+          path: current,
+          message: "Native document parent must be a directory",
+        });
+      }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+      throw error;
+    }
+  }
+  throwIfAborted(signal);
+}
+
+export async function assertFileExpectedAbsent(path: string): Promise<void> {
+  try {
+    await lstat(path);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+    throw error;
+  }
+  throw createFileSystemError({
+    code: "stale_write",
+    path,
+    message: `File already exists; create-only write refused: ${path}`,
+  });
+}
