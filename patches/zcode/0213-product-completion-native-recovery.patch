@@ -0,0 +1,94 @@
+import type { NativeWhiteboardDocument, WhiteboardFileRevision } from "@zcode/shared";
+import type { WhiteboardDocument } from "@/lib/whiteboard.js";
+
+export interface WhiteboardNativeProjection {
+  committed?: { document: NativeWhiteboardDocument; fileRevision: WhiteboardFileRevision };
+  incoming?: { document: NativeWhiteboardDocument; fileRevision: WhiteboardFileRevision };
+  pending?: {
+    requestId: string;
+    mutationId: string;
+    draft: WhiteboardDocument;
+    /** Original RAM operation intent only; never enters the document or durable retry. */
+    cancel?: () => void;
+  };
+  retry?: { mutationId: string; draft: WhiteboardDocument };
+  error?: string;
+}
+export type WhiteboardTarget = {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  boardId: string;
+};
+
+/** Only a renderer draft/projection. The versioned workspace file remains the editable authority. */
+export function isWhiteboardDirty(
+  board: WhiteboardDocument | undefined,
+  native?: WhiteboardNativeProjection,
+): boolean {
+  return Boolean(
+    board &&
+    (!native?.committed ||
+      JSON.stringify(board) !== JSON.stringify(native.committed.document.board)),
+  );
+}
+
+export function acknowledgeWhiteboard(
+  board: WhiteboardDocument | undefined,
+  projection: WhiteboardNativeProjection,
+  input: {
+    requestId: string;
+    document: NativeWhiteboardDocument;
+    fileRevision: WhiteboardFileRevision;
+  },
+) {
+  if (projection.pending?.requestId !== input.requestId) return null;
+  if (input.document.board.id !== board?.id)
+    throw new Error("Saved whiteboard belongs to another document");
+  const incoming =
+    projection.incoming &&
+    projection.incoming.document.revision >= input.document.revision &&
+    projection.incoming.fileRevision.hash !== input.fileRevision.hash
+      ? projection.incoming
+      : undefined;
+  return {
+    board: board === projection.pending.draft ? input.document.board : board,
+    native: {
+      committed: { document: input.document, fileRevision: input.fileRevision },
+      ...(incoming ? { incoming, error: "whiteboard.conflict" } : {}),
+    } as WhiteboardNativeProjection,
+  };
+}
+
+export function receiveWhiteboard(
+  board: WhiteboardDocument | undefined,
+  projection: WhiteboardNativeProjection | undefined,
+  incoming: { document: NativeWhiteboardDocument; fileRevision: WhiteboardFileRevision },
+  preserveDraft = false,
+) {
+  if (
+    !projection?.pending &&
+    board &&
+    JSON.stringify(board) === JSON.stringify(incoming.document.board)
+  )
+    return {
+      board: incoming.document.board,
+      native: { committed: incoming } as WhiteboardNativeProjection,
+    };
+  if (projection?.pending || preserveDraft || isWhiteboardDirty(board, projection)) {
+    // A read cannot consume the user's draft or rebase its expected revision.
+    if (projection?.committed?.fileRevision.hash === incoming.fileRevision.hash)
+      return { board, native: projection };
+    return {
+      board,
+      native: {
+        ...projection,
+        incoming,
+        error: "whiteboard.conflict",
+      } as WhiteboardNativeProjection,
+    };
+  }
+  return {
+    board: incoming.document.board,
+    native: { committed: incoming } as WhiteboardNativeProjection,
+  };
+}
