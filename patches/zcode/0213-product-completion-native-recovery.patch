@@ -0,0 +1,196 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SESSION_ENTRY_MODEL_SELECTION } from "@zcode/contracts";
+import { appModelFixture } from "./helpers/app-model-completion-fixture.js";
+
+test("actual App automatic target uses current registry policy and persists complete selection", async () => {
+  const f = await appModelFixture();
+  try {
+    const app = await f.create();
+    const runtime = app.runtime as any;
+    runtime.decisionModelPort = {
+      ...runtime.decisionModelPort,
+      automaticModel: async () => ({
+        selection: { providerId: f.providerId, modelId: "fast" },
+        tier: "fast",
+        reason: "decision",
+      }),
+    };
+    await app.runtime.executeTurn("Authored automatic selection", [], {
+      intent: {
+        allowAutomaticModelSelection: true,
+        modelSelection: {
+          providerId: f.providerId,
+          modelId: "standard",
+          options: { reasoningLevel: "off" },
+        },
+      },
+    });
+    assert.deepEqual(app.runtime.getSessionModelSelection(), {
+      providerId: f.providerId,
+      modelId: "fast",
+      options: { reasoningLevel: "high" },
+    });
+    assert.equal(f.calls.at(-1)?.modelId, "fast");
+    assert.equal(f.calls.at(-1)?.options.reasoningLevel, "high");
+    const entries = await runtime.sessionStore.sessionEntries({
+      sessionID: app.sessionId,
+      type: SESSION_ENTRY_MODEL_SELECTION,
+    });
+    assert.deepEqual(entries.at(-1).data, app.runtime.getSessionModelSelection());
+    assert.equal(f.httpCalls, 0);
+    await app.close?.();
+    await app.waitForClose?.();
+    const reopened = await f.create({ sessionId: app.sessionId, resume: true });
+    const restored = await reopened.resume();
+    assert.deepEqual(restored.modelSelection, {
+      providerId: f.providerId,
+      modelId: "fast",
+      options: { reasoningLevel: "high" },
+    });
+    assert.deepEqual(reopened.runtime.getSessionModelSelection(), restored.modelSelection);
+    assert.equal(f.httpCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("invalid or withdrawn automatic target preserves the offered complete model", async () => {
+  const f = await appModelFixture();
+  try {
+    const app = await f.create({
+      resolveEffectiveModelSelection: (selection) => ({
+        effectiveSelection: { ...selection, options: { reasoningLevel: "not-supported" } },
+      }),
+    });
+    const runtime = app.runtime as any;
+    runtime.decisionModelPort = {
+      ...runtime.decisionModelPort,
+      automaticModel: async () => ({
+        selection: { providerId: f.providerId, modelId: "fast" },
+        tier: "fast",
