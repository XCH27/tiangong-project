+import type { ModelTelemetryBootstrap } from "@zcode/telemetry";
+
+import type { ZCodeApp } from "./types.js";
+
+import { ApiProviderModelRuntime } from "./provider-registry-model-runtime.js";
+
+export function createAppReturnClose(factoryBindings: {
+  readonly closeSession: (() => Promise<void>) | undefined;
+  readonly providerModelRuntime: ApiProviderModelRuntime | undefined;
+  readonly modelTelemetry: ModelTelemetryBootstrap;
+}): ZCodeApp["close"] {
+  return (
+    {
+      close: async () => {
+        try {
+          await factoryBindings.closeSession?.();
+        } finally {
+          try {
+            factoryBindings.providerModelRuntime?.dispose();
+          } finally {
+            await factoryBindings.modelTelemetry.shutdown();
+          }
+        }
+      },
+    } satisfies Pick<ZCodeApp, "close">
+  ).close;
+}
