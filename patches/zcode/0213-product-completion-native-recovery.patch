-function formatByteCount(bytes: number): string {
-  if (bytes < 1024) return `${bytes}B`;
-  if (bytes < 1024 * 1024) return `${formatByteUnit(bytes / 1024)}KB`;
-  return `${formatByteUnit(bytes / (1024 * 1024))}MB`;
