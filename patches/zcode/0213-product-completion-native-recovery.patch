@@ -0,0 +1,75 @@
+import type { ProtocolServerOwner } from "./server-owner-types.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import {
+  zcodePluginsCancelOperationParamsSchema,
+  zcodeWorkspaceCancelGenerateTextParamsSchema,
+} from "@zcode/shared";
+import type { ZCodeProtocolRequest } from "@zcode/shared";
+import { ProtocolRequestError, parseParams } from "./server-types.js";
+import { getPluginOperationId, getOperationId } from "./server-helper-values.js";
+
+export async function withPluginOperationSignal<T>(
+  owner: ProtocolServerOwner,
+  request: ZCodeProtocolRequest,
+  run: (signal?: AbortSignal) => Promise<T>,
+): Promise<T> {
+  const operationId = getPluginOperationId(request.params);
+  if (!operationId) return await run();
+
+  const controller = new AbortController();
+  owner.pluginOperationControllers.set(operationId, controller);
+  try {
+    return await run(controller.signal);
+  } finally {
+    if (owner.pluginOperationControllers.get(operationId) === controller) {
+      owner.pluginOperationControllers.delete(operationId);
+    }
+  }
+}
+
+export function cancelPluginOperation(this: ProtocolServerOwner, rawParams: unknown) {
+  const params = parseParams(zcodePluginsCancelOperationParamsSchema, rawParams);
+  const controller = this.pluginOperationControllers.get(params.operationId);
+  if (!controller) return { operationId: params.operationId, cancelled: false };
+  // 插件同步的可取消能力必须保留在 V4 server；仅按 operationId 中止对应链路。
+  controller.abort();
+  this.pluginOperationControllers.delete(params.operationId);
+  return { operationId: params.operationId, cancelled: true };
+}
+
+export async function withWorkspaceGenerateTextSignal<T>(
+  owner: ProtocolServerOwner,
+  request: ZCodeProtocolRequest,
+  run: (signal?: AbortSignal) => Promise<T>,
+): Promise<T> {
+  const operationId = getOperationId(request.params);
+  if (!operationId) return await run();
+
+  if (owner.workspaceGenerateTextControllers.has(operationId)) {
+    // 重复 operationId 会覆盖首个请求的 AbortController，导致首个请求失去取消能力。
+    // 活跃 operationId 必须保持唯一；请求结束后 finally 会释放，之后才允许复用。
+    throw new ProtocolRequestError(
+      -32600,
+      `Workspace generate operation is already active: ${operationId}`,
+    );
+  }
+
+  const controller = new AbortController();
+  owner.workspaceGenerateTextControllers.set(operationId, controller);
+  try {
+    return await run(controller.signal);
+  } finally {
+    if (owner.workspaceGenerateTextControllers.get(operationId) === controller) {
+      owner.workspaceGenerateTextControllers.delete(operationId);
+    }
+  }
+}
+
+export function cancelWorkspaceGenerateText(this: ProtocolServerOwner, rawParams: unknown) {
+  const params = parseParams(zcodeWorkspaceCancelGenerateTextParamsSchema, rawParams);
+  const controller = this.workspaceGenerateTextControllers.get(params.operationId);
+  if (!controller) return { operationId: params.operationId, cancelled: false };
+  controller.abort(new DOMException("Workspace model request cancelled", "AbortError"));
+  this.workspaceGenerateTextControllers.delete(params.operationId);
+  return { operationId: params.operationId, cancelled: true };
+}
