+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+
+export interface MediaRegistrySource {
+  getSnapshot(): {
+    sourceRevisions: { config: string };
+    resolution: {
+      resolvedProviders: readonly {
+        providerId: string;
+        providerName?: string | null;
+        enabled: boolean;
+        providerIssues: readonly unknown[];
+        config: {
+          api?: {
+            baseUrl?: string | null;
+            headers?: Readonly<Record<string, string>> | null;
+          } | null;
+          access?: {
+            type: string;
+            apiKey?: string | null;
+            additionalApiKeys?: readonly string[] | null;
+            apiKeyEnabledFlags?: readonly boolean[] | null;
+          } | null;
+        };
+        models: readonly {
+          modelId: string;
+          enabled: boolean;
+          issues: readonly unknown[];
+          config: {
+            properties?: {
+              outputFormat?: {
+                supportsText?: boolean | null;
+                supportsImage?: boolean | null;
+                supportsVideo?: boolean | null;
+              } | null;
+            } | null;
+          };
+        }[];
+      }[];
+    };
+  } | null;
+}
+
+export const MAX_RESPONSE_BYTES = 24 * 1024 * 1024;
+
+export const MAX_IMAGE_BYTES = 16 * 1024 * 1024;
+
+export const MAX_REFERENCE_BYTES = 24 * 1024 * 1024;
+
+export const MAX_RETAINED_REFERENCE_BYTES = 64 * 1024 * 1024;
+
+export function mediaApiOrigin(
+  value: string | null | undefined,
+): { origin: string; vendor: "xai" | "openai" } | undefined {
+  if (!value) return;
+  try {
+    const url = new URL(value);
+    if (
+      url.pathname.replace(/\/+$/, "") !== "/v1" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    )
+      return;
+    if (url.origin === "https://api.x.ai") return { origin: url.origin, vendor: "xai" };
+    if (url.origin === "https://api.openai.com") return { origin: url.origin, vendor: "openai" };
+  } catch {
+    return;
+  }
+}
+
+export function isGlobalXaiApi(value: string | null | undefined): boolean {
+  if (!value) return false;
+  try {
+    const url = new URL(value);
+    return mediaApiOrigin(value)?.vendor === "xai";
+  } catch {
+    return false;
+  }
+}
+
+export function sniffImageMime(
+  bytes: Uint8Array,
+): "image/jpeg" | "image/png" | "image/webp" | null {
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return "image/jpeg";
+  if (Buffer.from(bytes.subarray(0, 8)).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])))
+    return "image/png";
+  if (
+    Buffer.from(bytes.subarray(0, 4)).toString("ascii") === "RIFF" &&
+    Buffer.from(bytes.subarray(8, 12)).toString("ascii") === "WEBP"
+  )
+    return "image/webp";
+  return null;
+}
