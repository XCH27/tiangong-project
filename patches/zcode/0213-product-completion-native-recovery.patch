--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/native-whiteboard.ts
@@ -0,0 +1,43 @@
+import {
+  whiteboardControlParamsSchema, whiteboardControlResultSchema,
+  whiteboardRelativePath, nativeWhiteboardSchema,
+  type WhiteboardControlResult,
+} from "@zcode/shared";
+import { parseParams, requireSession, ProtocolRequestError,
+  type ZCodeProtocolAgentServerContext } from "./server-types.js";
+import { activateSessionForResume } from "./server-operations.js";
+
+/** Authenticated Host control for one original Session/tool pair; never a generic tool gateway. */
+export async function performNativeWhiteboardControl(
+  context: ZCodeProtocolAgentServerContext, raw: unknown,
+): Promise<WhiteboardControlResult> {
+  const params = parseParams(whiteboardControlParamsSchema, raw);
+  // Cold activation derives the stored workspace. A caller cannot rebind a Session before validation.
+  if (!context.sessions.has(params.sessionId)) await activateSessionForResume(context, { sessionId: params.sessionId });
+  const record = requireSession(context, params.sessionId, { operation: "native-whiteboard" });
+  if (record.workspace.workspaceKey !== params.workspace.workspaceKey ||
+      record.workspace.workspacePath !== params.workspace.workspacePath ||
+      record.workspace.workspaceIdentity !== params.workspace.workspaceIdentity ||
+      record.workspace.remoteSessionId !== params.workspace.remoteSessionId)
+    throw new ProtocolRequestError(-32602, "Native whiteboard target does not belong to this Session workspace");
+  if (record.restoreWarning) return { status: "failed", effectStatus: "not_confirmed", message: record.restoreWarning.message };
+  try {
+    const outcome = await record.app.runtime.performWhiteboardControl(params.command, {
+      operationId: params.operationId, traceContext: record.traceContext,
+    });
+    if (!outcome.accepted) return { status: "rejected", reason: outcome.reason };
+    if (!outcome.result.success) return { status: "failed", effectStatus: "not_confirmed",
+      message: outcome.result.error?.message ?? "Native whiteboard operation failed",
+      ...(outcome.result.error?.code ? { code: outcome.result.error.code } : {}) };
+    const value = outcome.result.output as Record<string, unknown>;
+    if (params.command.operation === "read" && "list" in params.command.input)
+      return whiteboardControlResultSchema.parse({ status: "listed", ...value });
+    return whiteboardControlResultSchema.parse({ status: "completed", document: value.document,
+      fileRevision: value.fileRevision, filePath: whiteboardRelativePath(nativeWhiteboardSchema.parse(value.document).board.id),
+      ...(typeof value.observed === "boolean" ? { observed: value.observed } : {}) });
+  } catch (error) {
+    // Publication may precede a lost receipt/checkpoint. Keep the draft and reconcile the native file.
+    return { status: "failed", effectStatus: "not_confirmed",
+      message: error instanceof Error ? error.message : String(error) };
+  }
+}
