index 00000000..fd1bf578
--- /dev/null
+++ b/scripts/verify-delivery.mjs
@@ -0,0 +1,33 @@
+import { dirname, resolve } from "node:path";
+import { realpathSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { runCommand } from "./spawn-command.mjs";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+// 发布、Git pre-push 和 Fleet 重建入口共用一条检查链，不能各自遗漏严格 CLI 检查。
+export const deliverySteps = [
+  [process.execPath, ["--test", "packages/desktop/scripts/desktop-vite-config.test.mjs"]],
+  [process.execPath, ["scripts/build-desktop-agent-cli.mjs"]],
+  ["pnpm", ["typecheck"]],
+  ["pnpm", ["-r", "--filter", "./apps/zcode-cli/packages/*", "--if-present", "run", "typecheck"]],
+  ["pnpm", ["verify:pre-push"]],
+  ["pnpm", ["--filter", "@zcode/desktop", "build:no-runtime-assets"]],
+  ["pnpm", ["test:staged-agent-recovery"]],
+  ["pnpm", ["test:page-assistant-ui"]],
+  ["pnpm", ["test:plugin-market-ui"]],
+  ["pnpm", ["test:product-completion-ui"]],
+  ["pnpm", ["lint:cli"]],
+];
+
+export function verifyDelivery(run = runCommand) {
+  for (const [command, args] of deliverySteps) {
+    run(command, args, {
+      cwd: root,
+      env: { ...process.env, PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN: "false" },
+      stdio: "inherit",
+    });
+  }
+}
+
+if (process.argv[1] && realpathSync(resolve(process.argv[1])) === fileURLToPath(import.meta.url))
+  verifyDelivery();
