+import type { StartupTimer } from "../startup-logging.js";
+import type { ConfigResult } from "@zcode/adapters/config";
+import type { Logger } from "@zcode/core";
+
+import { createAppPluginAvailabilityOptions } from "./app-plugin-availability-options.js";
+
+import type { ZCodeAppOptions } from "./types.js";
+
+import { createPluginAvailability } from "./plugin-availability.js";
+
+import { resolveStartupPlugins, startupPluginStorageRoot } from "./startup-marks.js";
+export function createAppPluginResources(factoryBindings: {
+  readonly cliStorageRoot: string;
+  readonly configResult: ConfigResult;
+  readonly options: ZCodeAppOptions;
+  readonly logger: Logger;
+  readonly startupTimer: StartupTimer;
+  readonly workingDirectory: string;
+}) {
+  const pluginOutcome = resolveStartupPlugins({
+    cliStorageRoot: factoryBindings.cliStorageRoot,
+    configResult: factoryBindings.configResult,
+    env: factoryBindings.options.env,
+    logger: factoryBindings.logger,
+    options: factoryBindings.options,
+    startupTimer: factoryBindings.startupTimer,
+    workingDirectory: factoryBindings.workingDirectory,
+  });
+  const pluginStorageRoot = startupPluginStorageRoot({
+    cliStorageRoot: factoryBindings.cliStorageRoot,
+    options: factoryBindings.options,
+  });
+  const pluginAvailability = createPluginAvailability(
+    createAppPluginAvailabilityOptions({
+      pluginOutcome,
+      options: factoryBindings.options,
+      workingDirectory: factoryBindings.workingDirectory,
+      logger: factoryBindings.logger,
+      pluginStorageRoot,
+      configResult: factoryBindings.configResult,
+    }),
+  );
+  return { pluginOutcome, pluginStorageRoot, pluginAvailability };
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-public-interface-options.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-public-interface-options.ts
