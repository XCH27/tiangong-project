+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { mkdir, readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { whiteboardRelativePath } from "@zcode/shared";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+const board = () => ({
+  id: `whiteboard:${randomUUID()}`,
+  name: "Owned acceptance",
+  width: 1280 as const,
+  height: 800 as const,
+  strokes: [],
+  undoneStrokes: [],
+  createdAt: 1,
+  updatedAt: 1,
+});
+const native = (mode: "build" | "yolo" = "build", planEnabled = false) =>
+  fixture(undefined, false, {
+    config: {
+      mode,
+      planEnabled,
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      titleGeneration: { enabled: false },
+    },
+    deps: { fileSystemPort: new NodeFileSystemAdapter() },
+  });
+
+test("human native Save asks in yolo and plan; ordinary Agent plan tools retain the file", async () => {
+  const f = await native("yolo");
+  try {
+    const document = board();
+    const first = await f.runtime.performWhiteboardControl({
+      operation: "update",
+      input: { document, mutationId: randomUUID(), expectedAbsent: true },
+    });
+    assert.ok(first.accepted && first.result.success);
+    assert.equal(f.permissionCalls, 1);
+    assert.ok(f.runtime.getTools().some((tool) => tool.name === "WhiteboardUpdate"));
+    const content = await readFile(join(f.dir, whiteboardRelativePath(document.id)), "utf8");
+    await f.runtime.setExecutionState({ planEnabled: true });
+    assert.ok(!f.runtime.getTools().some((tool) => tool.name === "WhiteboardUpdate"));
+    assert.ok(f.runtime.getTools().some((tool) => tool.name === "ReadWhiteboard"));
+    const savedInPlan = await f.runtime.performWhiteboardControl({
+      operation: "update",
+      input: {
+        document: { ...document, name: "Explicit human edit" },
+        mutationId: randomUUID(),
+        expectedFileRevision: (first.result.output as any).fileRevision,
+      },
+    });
+    assert.ok(savedInPlan.accepted && savedInPlan.result.success);
+    assert.equal(f.runtime.getPlanEnabled(), true);
+    const savedContent = await readFile(join(f.dir, whiteboardRelativePath(document.id)), "utf8");
+    assert.notEqual(savedContent, content);
+    assert.equal(f.permissionCalls, 2);
+    const read = await f.runtime.performWhiteboardControl({
+      operation: "read",
+      input: { boardId: document.id },
+    });
+    assert.ok(read.accepted && read.result.success);
+    assert.equal(f.requests.length, 0);
+    f.steps.push(
+      () =>
+        reply("", [
+          {
+            id: "unavailable-plan-write",
+            name: "WhiteboardUpdate",
+            input: {
+              document: { ...document, name: "Unavailable Agent edit" },
+              mutationId: randomUUID(),
+              expectedFileRevision: (savedInPlan.result.output as any).fileRevision,
+            },
+          },
+        ]),
+      () => reply("Authored plan response"),
+    );
+    await f.runtime.executeTurn("Authored plan-only request");
+    assert.ok(f.requests.every((request) => !request.tools.includes("WhiteboardUpdate")));
+    assert.equal(
+      await readFile(join(f.dir, whiteboardRelativePath(document.id)), "utf8"),
+      savedContent,
+    );
+    assert.equal(f.permissionCalls, 2);
+    await f.runtime.setExecutionState({ planEnabled: false });
+    assert.ok(f.runtime.getTools().some((tool) => tool.name === "WhiteboardUpdate"));
+    await f.runtime.setExecutionState({ planEnabled: true });
+    assert.ok(!f.runtime.getTools().some((tool) => tool.name === "WhiteboardUpdate"));
+  } finally {
+    await f.close();
+  }
+});
+
+test("native checkpoint restores the exact preimage after cwd changes and actual SQLite reopen", async () => {
+  const f = await native();
+  try {
+    const document = board();
+    const first = await f.runtime.performWhiteboardControl({
+      operation: "update",
+      input: { document, mutationId: randomUUID(), expectedAbsent: true },
+    });
+    assert.ok(first.accepted && first.result.success);
+    const path = join(f.dir, whiteboardRelativePath(document.id));
+    const preimage = await readFile(path, "utf8");
+    const moved = join(f.dir, "bash-cwd");
+    await mkdir(moved);
+    f.runtime.setWorkingDirectory(moved);
+    const second = await f.runtime.performWhiteboardControl({
+      operation: "update",
+      input: {
+        document: { ...document, name: "Later drawing" },
+        mutationId: randomUUID(),
+        expectedFileRevision: (first.result.output as any).fileRevision,
+      },
+    });
+    assert.ok(second.accepted && second.result.success);
+    await assert.rejects(readFile(join(moved, whiteboardRelativePath(document.id))), {
+      code: "ENOENT",
+    });
+    assert.notEqual(await readFile(path, "utf8"), preimage);
+    await f.reopen();
+    const preview = await f.runtime.previewWorkspaceFileRewind();
+    assert.equal(preview.canApply, true, JSON.stringify(preview));
+    assert.equal(preview.safeFiles.length, 1);
+    assert.equal(preview.safeFiles[0]?.path, path);
+    const undone = await f.runtime.applyWorkspaceFileRewind();
+    assert.equal(undone.applied, true, JSON.stringify(undone));
+    assert.equal(await readFile(path, "utf8"), preimage);
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.permissionCalls, 2);
+  } finally {
+    await f.close();
+  }
+});
+
+test("an old build discovery projection cannot reexpose WhiteboardUpdate after plan is enabled", async () => {
+  const f = await fixture(undefined, false, {
+    config: {
+      mode: "yolo",
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate", "SearchTools"],
+      titleGeneration: { enabled: false },
+    },
+    deps: { fileSystemPort: new NodeFileSystemAdapter() },
+  });
+  try {
+    const document = board(),
+      entry = f.runtime.getToolRegistry().get("WhiteboardUpdate")!;
+    f.runtime
+      .getToolRegistry()
+      .register({
+        ...entry,
+        deferLoading: true,
+        metadata: {
+          ...entry.metadata,
+          description: `${entry.metadata.description} ${"Owned deferred description ".repeat(500)}`,
+        },
+      });
+    f.runtime.invalidateToolCache();
+    f.steps.push(
+      async () => {
+        await f.runtime.setExecutionState({ planEnabled: true });
+        return reply("", [
+          { id: "native-search", name: "SearchTools", input: { query: "WhiteboardUpdate" } },
+        ]);
+      },
+      () =>
+        reply("", [
+          {
+            id: "forged-discovered-write",
+            name: "WhiteboardUpdate",
+            input: {
+              document,
+              mutationId: randomUUID(),
+              expectedAbsent: true,
+            },
+          },
+        ]),
+      () => reply("Authored plan response"),
+    );
+    await f.runtime.executeTurn("Authored native discovery request");
+    assert.ok(f.requests[0]?.tools.includes("SearchTools"));
+    assert.ok(f.requests.every((request) => !request.tools.includes("WhiteboardUpdate")));
+    const messages = await f.store.messages({ sessionID: f.runtime.getSessionId() });
+    const search = messages
+      .flatMap((message) => message.parts)
+      .find((part) => part.type === "tool" && part.tool === "SearchTools");
+    assert.ok(search?.type === "tool" && search.state.status === "completed");
+    const found = JSON.parse(search.state.output).tools;
+    assert.ok(found.every((tool: { name: string }) => tool.name !== "WhiteboardUpdate"));
+    assert.ok(found.some((tool: { name: string }) => tool.name === "ReadWhiteboard"));
+    await assert.rejects(readFile(join(f.dir, whiteboardRelativePath(document.id))), {
+      code: "ENOENT",
+    });
+    assert.equal(f.permissionCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
