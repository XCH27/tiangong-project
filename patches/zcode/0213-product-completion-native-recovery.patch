@@ -0,0 +1,34 @@
+import { createWhiteboardPngFile } from "./whiteboard.js";
+import type { WhiteboardDocument } from "./whiteboard.js";
+import type { NativeWhiteboardDocument } from "@zcode/shared";
+
+/** Derived user exports only; this does not write the canonical workspace document. */
+export function exportWhiteboardDrawing(
+  board: WhiteboardDocument,
+  format: "png" | "json",
+  native?: NativeWhiteboardDocument,
+): void {
+  const name =
+    Array.from(board.name.replace(/[<>:"/\\|?*]/g, "-"))
+      .filter((character) => character.charCodeAt(0) >= 32)
+      .join("") || "whiteboard";
+  const file =
+    format === "png"
+      ? createWhiteboardPngFile(board)
+      : new File(
+          [JSON.stringify(native ?? { board, draft: true }, null, 2)],
+          `${name}${native ? "" : ".draft"}.json`,
+          { type: "application/json" },
+        );
+  const url = URL.createObjectURL(file);
+  try {
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = file.name;
+    document.body.append(link);
+    link.click();
+    link.remove();
+  } finally {
+    setTimeout(() => URL.revokeObjectURL(url), 0);
+  }
+}
diff --git a/packages/ui/src/lib/whiteboardGesture.ts b/packages/ui/src/lib/whiteboardGesture.ts
