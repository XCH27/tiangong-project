+import assert from "node:assert/strict";
+import test from "node:test";
+import { z } from "zod";
+import { zcodeProtocolMethods, type ZCodeProtocolMessage } from "@zcode/shared";
+import { ZCodeProtocolAgentServer } from "../src/zcode-protocol/server.js";
+
+function fixture() {
+  const messages: ZCodeProtocolMessage[] = [];
+  const server = new ZCodeProtocolAgentServer({ env: {}, createZCodeApp: async () => { throw new Error("Reverse-client fixture must not create an App or model"); } });
+  server.setNotificationSink(message => messages.push(message));
+  return { server, messages, client: server.officialMcpAuthRequestContext };
+}
+
+test("real server reverse request reannouncement shares one pending owner and releases every id", async () => {
+  const f = fixture();
+  try {
+    let settled = 0;
+    const pending = f.client.requestClient(zcodeProtocolMethods.interactionRequestPermission, {}, z.object({ granted: z.boolean() }), { reannounceIntervalMs: 10, timeoutMs: 500 });
+    void pending.then(() => settled++);
+    const deadline = Date.now() + 200;
+    while (f.messages.length < 2 && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+    assert.ok(f.messages.length >= 2);
+    const first = f.messages[0] as { id: string };
+    const second = f.messages[1] as { id: string };
+    assert.notEqual(first.id, second.id);
+    await f.server.handleMessage({ id: second.id, result: { granted: true } });
+    assert.deepEqual(await pending, { granted: true });
+    await f.server.handleMessage({ id: first.id, result: { granted: false } });
+    assert.equal(settled, 1);
+    assert.equal((f.server as unknown as { pendingClientRequests: Map<string, unknown> }).pendingClientRequests.size, 0);
+  } finally { await f.server.shutdown(); }
+});
+
+test("real server disconnect rejects the original reverse call and reconnect does not accept its late id", async () => {
+  const f = fixture();
+  try {
+    const old = f.client.requestClient(zcodeProtocolMethods.interactionRequestPermission, {}, z.object({ granted: z.boolean() }));
+    const oldId = (f.messages[0] as { id: string }).id;
+    const disconnected = assert.rejects(old, /fixture transport closed/);
+    f.server.disconnectClient(new Error("fixture transport closed"));
+    await disconnected;
+    f.server.setNotificationSink(message => f.messages.push(message));
+    const next = f.client.requestClient(zcodeProtocolMethods.interactionRequestPermission, {}, z.object({ granted: z.boolean() }));
+    const nextId = (f.messages.at(-1) as { id: string }).id;
+    let nextSettled = false;
+    void next.then(() => { nextSettled = true; });
+    await f.server.handleMessage({ id: oldId, result: { granted: false } });
+    assert.equal(nextSettled, false);
+    await f.server.handleMessage({ id: nextId, result: { granted: true } });
+    assert.deepEqual(await next, { granted: true });
+  } finally { await f.server.shutdown(); }
+});
