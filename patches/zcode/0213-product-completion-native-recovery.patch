index 00000000..60ea2e28
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-public-interface-options.ts
@@ -0,0 +1,308 @@
+import type { createModelAdapter } from "../model-factory.js";
+import type { createModelTelemetry } from "@zcode/telemetry";
+import type { createDynamicWorkflowRunService } from "./dynamic-workflow-run-service.js";
+import type { createScriptWorkflowBridge } from "./script-workflow-methods.js";
+
+import { createAppReturnRespondWorkspaceHookReview } from "./app-return-respond-workspace-hook-review.js";
+import { createAppReturnToggleWorkspaceHookReviewItem } from "./app-return-toggle-workspace-hook-review-item.js";
+import { createAppReturnRevokeWorkspaceHookTrust } from "./app-return-revoke-workspace-hook-trust.js";
+import { createAppReturnRequestWorkspaceHookReview } from "./app-return-request-workspace-hook-review.js";
+import { createAppReturnReloadWorkspaceHookTrust } from "./app-return-reload-workspace-hook-trust.js";
+import { createAppReturnSetModelIoFullRetentionEnabled } from "./app-return-set-model-io-full-retention-enabled.js";
+import { createAppReturnReadToolResultArtifact } from "./app-return-read-tool-result-artifact.js";
+import { createAppReturnWritePromptAttachment } from "./app-return-write-prompt-attachment.js";
+import { createAppReturnReadPromptAttachment } from "./app-return-read-prompt-attachment.js";
+import { createAppReturnStatPromptAttachment } from "./app-return-stat-prompt-attachment.js";
+import { createAppReturnResolvePromptAttachmentPreviewSource } from "./app-return-resolve-prompt-attachment-preview-source.js";
+import { createAppReturnClose } from "./app-return-close.js";
+import { createAppReturnGetPluginReferenceCatalog } from "./app-return-get-plugin-reference-catalog.js";
+import { createAppReturnGetSkillCatalog } from "./app-return-get-skill-catalog.js";
+import { createNativeWhiteboardReadPort } from "./native-whiteboard-read-port.js";
+
+import { AgentRuntime, type AmendWorkflowRunSettingsInput } from "@zcode/core";
+import { type TraceContext } from "@zcode/contracts";
+
+import type { PrepareUserExecutionBoundary, ZCodeApp, ZCodeAppOptions } from "./types.js";
+
+import { createWorkflowFacade } from "./workflow-facade.js";
+
+import { createInputFacade } from "./input-facade.js";
+import { createPluginFacadeForApp } from "./plugin-facade.js";
+
+import { createSessionFacade } from "./session-facade.js";
+
+import { createWorkspaceHookRuntimeSecurity } from "./workspace-hook-trust.js";
+
+import { ApiProviderModelRuntime } from "./provider-registry-model-runtime.js";
+
+import type {
+  SessionId,
+  ToolArtifactStorePort,
+  FileSystemPort,
+  PluginReferenceCatalog,
+} from "@zcode/contracts";
+import type { ConfigResult } from "@zcode/adapters/config";
+import type { ResumeOptions } from "./types.js";
+import type { ResumeSessionResult } from "@zcode/core";
+
+export function createAppPublicInterfaceOptions(factoryBindings: {
+  readonly sessionId: SessionId;
+  readonly traceContext: TraceContext;
+  readonly runtime: AgentRuntime;
+  readonly workspaceHookRuntimeSecurity:
+    | NonNullable<ReturnType<typeof createWorkspaceHookRuntimeSecurity>>
+    | undefined;
+  readonly modelAdapter: ReturnType<typeof createModelAdapter>;
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly resolvePromptAttachment: (input: {
+    ref: string;
+    mime: string;
+    messageId?: string;
+    toolCallId?: string;
+    attachmentIndex?: number;
+  }) => Promise<{ ref: string; mediaType: string; artifactUri?: string }>;
+  readonly fileSystemPort: FileSystemPort;
+  readonly sessionFacade: ReturnType<typeof createSessionFacade>;
+  readonly closeSession: (() => Promise<void>) | undefined;
+  readonly providerModelRuntime: ApiProviderModelRuntime | undefined;
+  readonly modelTelemetry: ReturnType<typeof createModelTelemetry>;
+  readonly workflowFacade: ReturnType<typeof createWorkflowFacade>;
+  readonly scriptWorkflowFacade: ReturnType<typeof createScriptWorkflowBridge>;
+  readonly dynamicWorkflowRunPort: ReturnType<typeof createDynamicWorkflowRunService> | undefined;
+  readonly getRuntime: () => AgentRuntime;
+  readonly prepareUserExecutionBoundary: PrepareUserExecutionBoundary;
+  readonly configResult: ConfigResult;
+  readonly options: ZCodeAppOptions;
+  readonly workingDirectory: string;
+  readonly pluginReferenceCatalog: PluginReferenceCatalog;
+  readonly resumeFromStore: (resumeOptions?: ResumeOptions) => Promise<ResumeSessionResult>;
+  readonly inputFacade: ReturnType<typeof createInputFacade>;
+}): ZCodeApp {
+  const dynamicWorkflowRunPort = factoryBindings.dynamicWorkflowRunPort;
+  return {
+    sessionId: factoryBindings.sessionId,
+    traceId: factoryBindings.traceContext.traceId,
+    runtime: factoryBindings.runtime,
+    nativeWhiteboardReadPort: createNativeWhiteboardReadPort(factoryBindings.fileSystemPort),
+    respondWorkspaceHookReview: createAppReturnRespondWorkspaceHookReview({
+      workspaceHookRuntimeSecurity: factoryBindings.workspaceHookRuntimeSecurity,
+    }),
+    toggleWorkspaceHookReviewItem: createAppReturnToggleWorkspaceHookReviewItem({
+      workspaceHookRuntimeSecurity: factoryBindings.workspaceHookRuntimeSecurity,
+    }),
+    revokeWorkspaceHookTrust: createAppReturnRevokeWorkspaceHookTrust({
+      workspaceHookRuntimeSecurity: factoryBindings.workspaceHookRuntimeSecurity,
+    }),
+    requestWorkspaceHookReview: createAppReturnRequestWorkspaceHookReview({
+      workspaceHookRuntimeSecurity: factoryBindings.workspaceHookRuntimeSecurity,
+    }),
+    // Settings pretrust 写盘后由 server 按 workspace 调用：重载 Trust store 到本
+    // session 的 coordinator 并重发 admission 状态（详见 types.ts 注释）。
+    reloadWorkspaceHookTrust: createAppReturnReloadWorkspaceHookTrust({
+      workspaceHookRuntimeSecurity: factoryBindings.workspaceHookRuntimeSecurity,
+    }),
+    setModelIoFullRetentionEnabled: createAppReturnSetModelIoFullRetentionEnabled({
+      modelAdapter: factoryBindings.modelAdapter,
+    }),
+    readToolResultArtifact: createAppReturnReadToolResultArtifact({
+      artifactStore: factoryBindings.artifactStore,
+      traceContext: factoryBindings.traceContext,
+    }),
+    // wire/staging 全程是 decoded chunk；只有完整 checksum commit 后才在
+    // CLI 进程内恢复既有 data-URL artifact 形态，保持 provider 读取链兼容。
+    writePromptAttachment: createAppReturnWritePromptAttachment({
+      artifactStore: factoryBindings.artifactStore,
+      sessionId: factoryBindings.sessionId,
+      traceContext: factoryBindings.traceContext,
+    }),
+    readPromptAttachment: createAppReturnReadPromptAttachment({
+      resolvePromptAttachment: factoryBindings.resolvePromptAttachment,
+      artifactStore: factoryBindings.artifactStore,
+      traceContext: factoryBindings.traceContext,
+      fileSystemPort: factoryBindings.fileSystemPort,
+    }),
+    statPromptAttachment: createAppReturnStatPromptAttachment({
+      resolvePromptAttachment: factoryBindings.resolvePromptAttachment,
+      artifactStore: factoryBindings.artifactStore,
+      traceContext: factoryBindings.traceContext,
+      fileSystemPort: factoryBindings.fileSystemPort,
+    }),
+    resolvePromptAttachmentPreviewSource: createAppReturnResolvePromptAttachmentPreviewSource({
+      resolvePromptAttachment: factoryBindings.resolvePromptAttachment,
+      artifactStore: factoryBindings.artifactStore,
+    }),
+    ...factoryBindings.sessionFacade,
+    close: createAppReturnClose({
+      closeSession: factoryBindings.closeSession,
+      get providerModelRuntime() {
+        return factoryBindings.providerModelRuntime;
+      },
+      modelTelemetry: factoryBindings.modelTelemetry,
+    }),
+    ...factoryBindings.workflowFacade,
+    ...factoryBindings.scriptWorkflowFacade,
+    // dwf 事件日志的读面。**可选能力**：journal 不可用时 run service 整个不构造，
+    // 这个方法随之缺席，v4 网关据此回结构化的能力不支持错误——「没有事件」与
+    // 「这个会话没有这个能力」必须能被 renderer 区分。
+    ...(dynamicWorkflowRunPort === undefined
+      ? {}
+      : {
+          listDynamicWorkflowRunEvents: async (input: {
+            runId: string;
+            afterSequence?: number;
+            limit?: number;
+          }) =>
+            dynamicWorkflowRunPort.listEvents(input.runId, {
+              ...(input.afterSequence === undefined ? {} : { afterSequence: input.afterSequence }),
+              ...(input.limit === undefined ? {} : { limit: input.limit }),
+            }),
+        }),
+    // workflow run 的**用户面产物**读面。三条一起注册、
+    // 一起缺席：它们是同一个 journal 读面的三个切片，部分在场只会让 UI 拿到一张有卡片
+    // 却打不开的侧板。三个端口成员都是可选的（stub 端口不陪跑），所以逐个探测。
+    // ⚠ 术语：artifact = 脚本发布给用户看的产出，不是端口上的 `output`（顶层返回值）。
+    ...(dynamicWorkflowRunPort === undefined ||
+    typeof dynamicWorkflowRunPort.listArtifacts !== "function" ||
+    typeof dynamicWorkflowRunPort.listArtifactItems !== "function" ||
+    typeof dynamicWorkflowRunPort.readArtifact !== "function"
+      ? {}
+      : {
+          listDynamicWorkflowRunArtifacts: async (input: { runId: string }) =>
+            dynamicWorkflowRunPort.listArtifacts!(input.runId),
+          listDynamicWorkflowRunArtifactItems: async (input: {
+            runId: string;
+            artifactId: string;
+            afterSequence?: number;
+            limit: number;
+          }) =>
+            dynamicWorkflowRunPort.listArtifactItems!(input.runId, input.artifactId, {
+              ...(input.afterSequence === undefined ? {} : { afterSequence: input.afterSequence }),
+              limit: input.limit,
+            }),
+          readDynamicWorkflowRunArtifact: async (input: {
+            runId: string;
+            artifactId: string;
+            version: number;
+          }) => dynamicWorkflowRunPort.readArtifact!(input.runId, input.artifactId, input.version),
+        }),
+    // workflow run 的工作区 transcript：两条一起
+    // 注册、一起缺席，理由同产物的三条。
+    ...(dynamicWorkflowRunPort === undefined ||
+    typeof dynamicWorkflowRunPort.listWorkspaceNodes !== "function" ||
+    typeof dynamicWorkflowRunPort.readWorkspaceNodeResult !== "function"
+      ? {}
+      : {
+          listDynamicWorkflowRunWorkspaceNodes: async (input: { runId: string }) =>
+            dynamicWorkflowRunPort.listWorkspaceNodes!(input.runId),
+          readDynamicWorkflowRunNodeResult: async (input: {
+            runId: string;
+            siteId: string;
+            ordinal: number;
+            maxBytes: number;
+          }) =>
+            dynamicWorkflowRunPort.readWorkspaceNodeResult!(
+              input.runId,
+              input.siteId,
+              input.ordinal,
+              { maxBytes: input.maxBytes },
+            ),
+        }),
+    // workflow run 的会话级生命周期读面（在飞计数 + 结算订阅）。消费者是宿主的 provider registry
+    // 安全边界：子代理共用本会话的 live adapter，在飞 run 期间不能 replace registry。缺席条件同上。
+    ...(dynamicWorkflowRunPort === undefined ? {} : {}),
+    // workflow run 的枚举面（重启后的发现查询）。能力缺席条件同上；端口的 listRunsForSession
+    // 是可选成员，方法缺席时本能力同样不注册。
+    ...(dynamicWorkflowRunPort === undefined ||
+    typeof dynamicWorkflowRunPort.listRunsForSession !== "function"
+      ? {}
+      : {
+          listDynamicWorkflowRuns: async (input: { limit?: number }) =>
+            dynamicWorkflowRunPort.listRunsForSession!(input.limit),
+        }),
+    // workflow run 的冷回放。能力缺席条件同上。
+    ...(dynamicWorkflowRunPort === undefined ||
+    typeof dynamicWorkflowRunPort.replayProgressForSession !== "function"
+      ? {}
+      : {
+          replayDynamicWorkflowRuns: async (input: { excludeRunIds: ReadonlySet<string> }) =>
+            dynamicWorkflowRunPort.replayProgressForSession!(input),
+        }),
+    // dwf run 的恢复。能力缺席条件同上；此外
+    // 端口的 resume 是可选成员（stub 端口不陪跑），方法缺席时本能力同样不注册——
+    // 对 renderer「端口缺席」与「方法缺席」是同一个业务事实。
+    ...(dynamicWorkflowRunPort === undefined || typeof dynamicWorkflowRunPort.resume !== "function"
+      ? {}
+      : {
+          resumeWorkflowRun: async (input: { workId: string; name?: string }) => {
+            const result = await dynamicWorkflowRunPort.resume!(input.workId);
+            if (result.ok) {
+              // 追踪重臂必须紧随成功的 resume：registry 登记（回收护栏）、backgroundWorks
+              // 条目（cancellable）、终态通知。port.resume 已先替换注册表条目，
+              // waiter 因此挂在新的结算 promise 上（run service 文件头不变式 5）。
+              await factoryBindings.getRuntime().trackResumedDynamicWorkflowRun({
+                runId: result.runId,
+                ...(result.toolCallId === undefined ? {} : { toolCallId: result.toolCallId }),
+                ...(input.name === undefined ? {} : { name: input.name }),
+                traceContext: factoryBindings.traceContext,
+              });
+            }
+            return result;
+          },
+        }),
+    // 中枢直接启动一个已保存的工作流。能力缺席条件与
+    // resumeWorkflowRun 家族一致：dwf 端口整体缺席（stub / 单测宿主）时不注册——GUI 据此拿到
+    // 能力不支持错误并原样显示，而不是把「不支持直接启动」误当成一次失败的启动。
+    // 与 /goal 控制轮同构：先走统一用户执行边界（否则首次持久化前 shell selection 为空，
+    // 冷恢复退回 legacy fallback），再由 runtime 解析 + 校验 + 编译 + 落启动轮 + submit。
+    ...(dynamicWorkflowRunPort === undefined
+      ? {}
+      : {
+          startSavedWorkflow: async (input: {
+            name: string;
+            scope?: "project" | "global";
+            args?: Record<string, unknown>;
+          }) => {
+            await factoryBindings.prepareUserExecutionBoundary({
+              traceContext: factoryBindings.traceContext,
+            });
+            return await factoryBindings
+              .getRuntime()
+              .startSavedWorkflowRun({ ...input, traceContext: factoryBindings.traceContext });
+          },
+        }),
+    // GUI「配置」。它
+    // 沿用前驱的脚本，所以端口必须既能 amend 又能读回脚本；缺一就不注册，GUI 拿到能力不支持。
+    // 与 startSavedWorkflow 同一条用户执行边界：冷恢复的会话先恢复 Session 边界再落设置轮。
+    ...(dynamicWorkflowRunPort === undefined ||
+    typeof dynamicWorkflowRunPort.amend !== "function" ||
+    typeof dynamicWorkflowRunPort.getScript !== "function"
+      ? {}
+      : {
+          amendWorkflowRunSettings: async (
+            input: Omit<AmendWorkflowRunSettingsInput, "traceContext">,
+          ) => {
+            await factoryBindings.prepareUserExecutionBoundary({
+              traceContext: factoryBindings.traceContext,
+            });
+            return await factoryBindings
+              .getRuntime()
+              .amendWorkflowRunSettings({ ...input, traceContext: factoryBindings.traceContext });
+          },
+        }),
+    ...createPluginFacadeForApp({
+      configResult: factoryBindings.configResult,
+      options: factoryBindings.options,
+      workingDirectory: factoryBindings.workingDirectory,
+    }),
+    getPluginReferenceCatalog: createAppReturnGetPluginReferenceCatalog({
+      pluginReferenceCatalog: factoryBindings.pluginReferenceCatalog,
+    }),
+    getSkillCatalog: createAppReturnGetSkillCatalog({
+      prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+      traceContext: factoryBindings.traceContext,
+      getRuntime: factoryBindings.getRuntime,
+    }),
+    resume: factoryBindings.resumeFromStore,
+    ...factoryBindings.inputFacade,
+  };
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-resolve-attachment-resolve-prompt-attachment.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-resolve-attachment-resolve-prompt-attachment.ts
new file mode 100644
index 00000000..15163b2e
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-resolve-attachment-resolve-prompt-attachment.ts
@@ -0,0 +1,63 @@
+import { resolvePersistedToolAttachment } from "./tool-output-attachment.js";
+
+import { type MessageId } from "@zcode/contracts";
+
+import type { SessionStorePort, SessionId } from "@zcode/contracts";
+
+export function createAppResolveAttachmentResolvePromptAttachment(factoryBindings: {
+  readonly sessionStore: SessionStorePort;
+  readonly sessionId: SessionId;
+}): (input: {
+  ref: string;
+  mime: string;
+  messageId?: string;
+  toolCallId?: string;
+  attachmentIndex?: number;
+}) => Promise<{ ref: string; mediaType: string; artifactUri?: string }> {
+  const resolvePromptAttachment = async (input: {
+    ref: string;
+    mime: string;
+    messageId?: string;
+    toolCallId?: string;
+    attachmentIndex?: number;
+  }): Promise<{ ref: string; mediaType: string; artifactUri?: string }> => {
+    if (input.toolCallId !== undefined) {
+      return resolvePersistedToolAttachment(
+        factoryBindings.sessionStore,
+        factoryBindings.sessionId,
+        input,
+      );
+    }
+    let ref = input.ref;
+    let mediaType = input.mime;
+    let artifactUri: string | undefined;
+    if (input.messageId && input.attachmentIndex !== undefined) {
+      // 预览单个附件曾通过 messages() 解码整段会话；长会话会同步扫描
+      // 所有 parts，且无关坏行也会让目标预览失败。按 session/message 定点读取即可。
+      const persistedMessage = await factoryBindings.sessionStore.messageWithParts({
+        sessionID: factoryBindings.sessionId,
+        messageID: input.messageId as MessageId,
+      });
+      const persistedAttachment = persistedMessage?.parts.filter((part) => part.type === "file")[
+        input.attachmentIndex
+      ];
+      if (persistedAttachment?.type === "file") {
+        mediaType = persistedAttachment.mime;
+        // live row 的 ref 仍是原始路径；如果直接读取，源文件删除或覆盖后
+        // 热态预览会和冷恢复 artifact 不一致。同一 message/index 必须优先取不可变副本。
+        artifactUri =
+          persistedAttachment.metadata?.artifactUri ??
+          (persistedAttachment.url.startsWith("zcode-artifact://")
+            ? persistedAttachment.url
+            : undefined);
+        ref =
+          artifactUri ??
+          (!persistedAttachment.url.startsWith("data:") ? persistedAttachment.url : input.ref);
+      }
+      // message row 会先于后续 FilePart 逐条落库；目标 part 尚未可见时仍应
+      // 使用已经由当前 projection 授权的 input.ref，不能制造短暂的预览失败窗口。
+    }
+    return { ref, mediaType, ...(artifactUri ? { artifactUri } : {}) };
+  };
+  return resolvePromptAttachment;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-restore-model-restore-persisted-model-selection.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-restore-model-restore-persisted-model-selection.ts
