-        resolve: () => {
-          if (settled) return;
-          settled = true;
-          cleanup();
-          resolve();
-        },
-        reject: (error) => {
-          if (settled) return;
-          settled = true;
-          cleanup();
-          reject(error);
-        },
-      };
