@@ -0,0 +1,129 @@
+import {
+  WHITEBOARD_DOCUMENT_MAX_BYTES,
+  whiteboardUpdateInputSchema,
+  type WhiteboardUpdateInput,
+} from "@zcode/shared";
+import type { ToolArtifactStorePort } from "@zcode/contracts";
+import type { ToolExecutionContext } from "../types.js";
+
+export interface EffectiveWhiteboardInputFact {
+  version: 1;
+  toolCallId: string;
+  turnId: string;
+  traceId: string;
+  inputRef: string;
+}
+const nonEmpty = (value: unknown): value is string => typeof value === "string" && !!value.trim();
+
+export function effectiveWhiteboardInputFacts(value: unknown): EffectiveWhiteboardInputFact[] {
+  if (value === undefined) return [];
+  if (!Array.isArray(value) || value.length > 32)
+    throw new Error("Invalid effective whiteboard input evidence");
+  const keys = new Set<string>();
+  return value.map((item) => {
+    if (
+      !item ||
+      typeof item !== "object" ||
+      item.version !== 1 ||
+      Object.keys(item).some(
+        (key) => !["version", "toolCallId", "turnId", "traceId", "inputRef"].includes(key),
+      ) ||
+      ![item.toolCallId, item.turnId, item.traceId, item.inputRef].every(nonEmpty)
+    )
+      throw new Error("Invalid effective whiteboard input evidence");
+    const key = JSON.stringify([item.toolCallId, item.turnId, item.traceId]);
+    if (keys.has(key)) throw new Error("Ambiguous effective whiteboard input evidence");
+    keys.add(key);
+    return item as EffectiveWhiteboardInputFact;
+  });
+}
+
+export async function readEffectiveWhiteboardInput(
+  store: ToolArtifactStorePort,
+  sessionId: string,
+  fact: EffectiveWhiteboardInputFact,
+): Promise<WhiteboardUpdateInput> {
+  const stored = await store.readToolResultArtifact({ uri: fact.inputRef });
+  if (Buffer.byteLength(stored.content, "utf8") > WHITEBOARD_DOCUMENT_MAX_BYTES)
+    throw new Error("Effective whiteboard input exceeds its existing budget");
+  const envelope = JSON.parse(stored.content);
+  if (
+    !envelope ||
+    envelope.version !== 1 ||
+    envelope.sessionId !== sessionId ||
+    envelope.toolCallId !== fact.toolCallId ||
+    envelope.turnId !== fact.turnId ||
+    envelope.traceId !== fact.traceId ||
+    Object.keys(envelope).some(
+      (key) => !["version", "sessionId", "toolCallId", "turnId", "traceId", "input"].includes(key),
+    )
+  )
+    throw new Error("Effective whiteboard input belongs to another action or Session");
+  return whiteboardUpdateInputSchema.parse(envelope.input);
+}
+
+/** 最终 handler 输入来自原 hooks/permission 校验链；请求 inputRef 保持独立，不能拿它替代实际输入。 */
+export async function captureEffectiveWhiteboardInput(
+  context: ToolExecutionContext,
+  previous: unknown,
+  input: WhiteboardUpdateInput,
+): Promise<EffectiveWhiteboardInputFact[]> {
+  const facts = effectiveWhiteboardInputFacts(previous);
+  if (
+    !context.artifactStore ||
+    ![context.toolCallId, context.turnId, context.traceId].every(nonEmpty)
+  )
+    throw new Error("Effective whiteboard input requires original artifact/trace ownership");
+  const existing = facts.find(
+    (fact) =>
+      fact.toolCallId === context.toolCallId &&
+      fact.turnId === context.turnId &&
+      fact.traceId === context.traceId,
+  );
+  if (existing) {
+    const recorded = await readEffectiveWhiteboardInput(
+      context.artifactStore,
+      context.sessionId,
+      existing,
+    );
+    if (JSON.stringify(recorded) !== JSON.stringify(input))
+      throw new Error("Effective whiteboard action identity was reused for another input");
+    return facts;
+  }
+  if (facts.length >= 32)
+    throw new Error("Effective whiteboard input evidence limit reached; original anchors retained");
+  const content = JSON.stringify({
+    version: 1,
+    sessionId: context.sessionId,
+    toolCallId: context.toolCallId,
+    turnId: context.turnId,
+    traceId: context.traceId,
+    input,
+  });
+  if (Buffer.byteLength(content, "utf8") > WHITEBOARD_DOCUMENT_MAX_BYTES)
+    throw new Error("Effective whiteboard input exceeds its existing budget");
+  context.abortSignal.throwIfAborted();
+  const stored = await context.artifactStore.writeToolResultArtifact(
+    {
+      sessionId: context.sessionId,
+      toolCallId: context.toolCallId,
+      turnId: context.turnId,
+      toolName: "WhiteboardUpdate",
+      content,
+      contentType: "application/vnd.zcode.native-whiteboard-effective-input+json",
+      retention: "session",
+    },
+    { signal: context.abortSignal },
+  );
+  context.abortSignal.throwIfAborted();
+  return [
+    ...facts,
+    {
+      version: 1,
+      toolCallId: context.toolCallId,
+      turnId: context.turnId!,
+      traceId: context.traceId,
+      inputRef: stored.uri,
+    },
+  ];
+}
diff --git a/apps/zcode-cli/packages/core/src/tool/handlers/whiteboard-files.ts b/apps/zcode-cli/packages/core/src/tool/handlers/whiteboard-files.ts
new file mode 100644
index 00000000..7027c880
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/handlers/whiteboard-files.ts
@@ -0,0 +1,246 @@
+import { createHash } from "node:crypto";
+import { resolve } from "node:path";
+import {
+  WHITEBOARD_DOCUMENT_MAX_BYTES,
+  parseNativeWhiteboardText,
+  whiteboardFileRevisionSchema,
+  whiteboardIdSchema,
+  whiteboardRelativePath,
+  type NativeWhiteboardDocument,
+  type WhiteboardFileRevision,
+  type WhiteboardUpdateInput,
+} from "@zcode/shared";
+import {
+  createFileSystemError,
+  isFileSystemPortError,
+  type FileSystemPort,
+} from "@zcode/contracts";
+import type { ToolExecutionContext } from "../types.js";
+import { createStructuredPatch } from "../diff.js";
+import {
+  prepareWhiteboardCheckpoint,
+  observeWhiteboardCheckpoint,
+} from "./whiteboard-checkpoint.js";
+
+export type WhiteboardReadContext = Pick<
+  ToolExecutionContext,
+  "workspaceRoot" | "traceId" | "spanId" | "sessionId" | "turnId" | "abortSignal"
+> & {
+  fileSystemPort?: Pick<FileSystemPort, "readTextFile" | "listDirectory">;
+};
+
+export function whiteboardTarget(boardId: string, context: WhiteboardReadContext) {
+  if (!context.workspaceRoot || !context.fileSystemPort)
+    throw new Error("Native whiteboards require the original Session workspace and file adapter");
+  const root = resolve(context.workspaceRoot);
+  return {
+    root,
+    relativePath: whiteboardRelativePath(boardId),
+    path: resolve(root, whiteboardRelativePath(boardId)),
+  };
+}
+
+export async function readWhiteboardFile(boardId: string, context: WhiteboardReadContext) {
+  const target = whiteboardTarget(boardId, context);
+  const file = await context.fileSystemPort!.readTextFile(
+    {
+      path: target.path,
+      boundaryRoot: target.root,
+      maxBytes: WHITEBOARD_DOCUMENT_MAX_BYTES,
+      trace: {
+        traceId: context.traceId,
+        spanId: context.spanId,
+        sessionId: context.sessionId,
+        turnId: context.turnId,
+      },
+    },
+    { signal: context.abortSignal },
+  );
+  if (file.truncated) throw new Error("Native whiteboard read must contain the complete file");
+  const document = parseNativeWhiteboardText(file.content);
+  if (document.board.id !== boardId)
+    throw new Error("Native whiteboard identity does not match its filename");
+  if (document.mutationDigest !== whiteboardMutationDigest(document.board))
+    throw new Error(
+      "Native whiteboard content does not match its saved mutation; retain both versions and reconcile",
+    );
+  return {
+    ...target,
+    document,
+    fileRevision: whiteboardFileRevisionSchema.parse(file.revision),
+    content: file.content,
+  };
+}
+
+export async function listWhiteboardFiles(context: WhiteboardReadContext) {
+  if (!context.workspaceRoot || !context.fileSystemPort)
+    throw new Error("Native workspace files are unavailable");
+  const root = resolve(context.workspaceRoot);
+  let entries;
+  try {
+    entries = (
+      await context.fileSystemPort.listDirectory(
+        { path: resolve(root, ".zcode/whiteboards"), boundaryRoot: root },
+        { signal: context.abortSignal },
+      )
+    ).entries;
+  } catch (error) {
+    if (isFileSystemPortError(error) && error.code === "not_found")
+      return { items: [], errors: [], truncated: false };
+    throw error;
+  }
+  const candidates = entries
+    .filter(
+      (file) =>
+        file.kind !== "directory" &&
+        file.name.endsWith(".json") &&
+        whiteboardIdSchema.safeParse(`whiteboard:${file.name.slice(0, -5)}`).success,
+    )
+    .sort((a, b) => a.name.localeCompare(b.name));
+  const items: Array<{ boardId: string; name: string; revision: number; updatedAt: number }> = [];
+  const errors: Array<{ fileName: string; message: string }> = [];
+  for (const file of candidates.slice(0, 200)) {
+    context.abortSignal.throwIfAborted();
+    try {
+      const read = await readWhiteboardFile(`whiteboard:${file.name.slice(0, -5)}`, context);
+      items.push({
+        boardId: read.document.board.id,
+        name: read.document.board.name,
+        revision: read.document.revision,
+        updatedAt: read.document.board.updatedAt,
+      });
+    } catch (error) {
+      errors.push({
+        fileName: file.name,
+        message: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  return { items, errors, truncated: candidates.length > 200 };
+}
+
+/** Both human and Agent updates use this handler and the adapter's original CAS/atomic writer. */
+export async function updateWhiteboardFile(
+  input: WhiteboardUpdateInput,
+  context: ToolExecutionContext,
+) {
+  const target = whiteboardTarget(input.document.id, context);
+  const digest = whiteboardMutationDigest(input.document);
+  let current: Awaited<ReturnType<typeof readWhiteboardFile>> | undefined;
+  try {
+    current = await readWhiteboardFile(input.document.id, context);
+  } catch (error) {
+    if (!isFileSystemPortError(error) || error.code !== "not_found") throw error;
+  }
+  if (current?.document.mutationId === input.mutationId) {
+    if (current.document.mutationDigest !== digest)
+      throw new Error("Mutation identity was reused for a different drawing");
+    return {
+      ...observedResult(current.document, current.fileRevision, target.relativePath),
+      preparedCheckpoint: await observeWhiteboardCheckpoint(
+        context,
+        input.mutationId,
+        target.path,
+        digest,
+        input,
+      ),
+    };
+  }
+  if (
+    input.expectedAbsent === true
+      ? current !== undefined
+      : !current ||
+        current.fileRevision.id !== input.expectedFileRevision?.id ||
+        current.fileRevision.hash !== input.expectedFileRevision?.hash
+  )
+    throw createFileSystemError({
+      code: "stale_write",
+      path: target.path,
+      message: "The native whiteboard changed; retain the draft and reconcile both versions",
+    });
+  const envelope: NativeWhiteboardDocument = {
+    schemaVersion: 1,
+    revision: (current?.document.revision ?? 0) + 1,
+    mutationId: input.mutationId,
+    mutationDigest: digest,
+    board: input.document,
+  };
+  const content = JSON.stringify(envelope, null, 2) + "\n";
+  if (Buffer.byteLength(content, "utf8") > WHITEBOARD_DOCUMENT_MAX_BYTES)
+    throw new Error("Whiteboard exceeds its file size budget; keep the draft and export it");
+  context.abortSignal.throwIfAborted();
+  const preparedCheckpoint = await prepareWhiteboardCheckpoint(context, {
+    mutationId: input.mutationId,
+    mutationDigest: digest,
+    filePath: target.path,
+    before: current?.content ?? null,
+    after: content,
+    expectedHash: input.expectedFileRevision?.hash,
+    effectiveInput: input,
+  });
+  try {
+    const written = await context.fileSystemPort!.writeTextFile(
+      {
+        path: target.path,
+        content,
+        createParents: true,
+        atomic: true,
+        encoding: "utf8",
+        boundaryRoot: target.root,
+        expectedAbsent: input.expectedAbsent,
+        expectedRevision: input.expectedFileRevision,
+        trace: {
+          traceId: context.traceId,
+          spanId: context.spanId,
+          sessionId: context.sessionId,
+          turnId: context.turnId,
+        },
+      },
+      { signal: context.abortSignal },
+    );
+    return {
+      document: envelope,
+      fileRevision: whiteboardFileRevisionSchema.parse(written.revision),
+      observed: false,
+      type: current ? "update" : "create",
+      filePath: target.path,
+      content,
+      originalFile: current?.content ?? null,
+      structuredPatch: current
+        ? createStructuredPatch({
+            filePath: target.relativePath,
+            oldContent: current.content,
+            newContent: content,
+          })
+        : [],
+      userModified: false,
+      preparedCheckpoint,
+    };
+  } catch (error) {
+    // A retry racing the original writer observes that exact completed mutation. Never rebase another edit.
+    if (isFileSystemPortError(error) && error.code === "stale_write") {
+      const committed = await readWhiteboardFile(input.document.id, context);
+      if (
+        committed.document.mutationId === input.mutationId &&
+        committed.document.mutationDigest === digest
+      )
+        return {
+          ...observedResult(committed.document, committed.fileRevision, target.relativePath),
+          preparedCheckpoint,
+        };
+    }
+    throw error;
+  }
+}
+
+function observedResult(
+  document: NativeWhiteboardDocument,
+  fileRevision: WhiteboardFileRevision,
+  filePath: string,
+) {
+  return { document, fileRevision, filePath, observed: true };
+}
+
+function whiteboardMutationDigest(document: NativeWhiteboardDocument["board"]): string {
+  return createHash("sha256").update(JSON.stringify(document)).digest("hex");
+}
diff --git a/apps/zcode-cli/packages/core/src/tool/handlers/whiteboard.ts b/apps/zcode-cli/packages/core/src/tool/handlers/whiteboard.ts
