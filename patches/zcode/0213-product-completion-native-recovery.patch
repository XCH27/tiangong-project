@@ -0,0 +1,63 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { loadMainConsumer } from "./helpers/main-consumer-fixture.mjs";
+
+async function provider(t, manifest) {
+  const { ManifestUpdateProvider } = await loadMainConsumer(t, "manifestUpdateProvider.ts");
+  const instance = new ManifestUpdateProvider(
+    {
+      provider: "custom",
+      endpointOrigin: "https://fixture.invalid",
+      releasePlatform: "darwin-aarch64",
+    },
+    {},
+    { platform: "darwin", executor: {} },
+  );
+  instance.httpRequest = async () => JSON.stringify(manifest);
+  return instance;
+}
+
+test("actual Provider rejects missing artifact before getLatestVersion announces available", async (t) => {
+  for (const manifest of [
+    { version: "1.2.3" },
+    { version: "1.2.3", files: [{ url: "app.zip" }] },
+    { version: "1.2.3", files: [{ sha512: "checksum" }] },
+    {
+      version: "1.2.3",
+      files: [{ url: "app.zip", sha512: "checksum" }],
+      packages: { [process.arch]: { sha512: "sum" } },
+    },
+  ]) {
+    const instance = await provider(t, manifest);
+    await assert.rejects(instance.getLatestVersion());
+  }
+});
+
+test("modern and legacy manifests retain metadata and package artifacts without invented release metadata", async (t) => {
+  for (const manifest of [
+    {
+      version: "1.2.3",
+      files: [{ url: "app.zip", sha512: "checksum", size: 4 }],
+      releaseNotes: "notes",
+      packages: { [process.arch]: { path: "package.7z", sha512: "package-sum" } },
+    },
+    { version: "1.2.3", path: "legacy.zip", sha2: "legacy-sum", releaseName: "legacy" },
+  ]) {
+    const instance = await provider(t, manifest);
+    const info = await instance.getLatestVersion();
+    assert.deepEqual(info, { ...manifest, zcodeReleaseChannel: "stable" });
+    const resolved = instance.resolveFiles(info);
+    assert.equal(resolved.length, 1);
+    assert.equal(resolved[0].url.origin, "https://fixture.invalid");
+    if (manifest.packages)
+      assert.equal(resolved[0].packageInfo.path, "https://fixture.invalid/package.7z");
+  }
+});
+
+test("current YAML date scalar remains a string through the SDK boundary", async (t) => {
+  const instance = await provider(t, {});
+  instance.httpRequest = async () =>
+    "version: 1.2.3\nfiles:\n  - url: app.zip\n    sha512: checksum\nreleaseDate: 2026-10-12T00:00:00.000Z\n";
+  const info = await instance.getLatestVersion();
+  assert.equal(info.releaseDate, "2026-10-12T00:00:00.000Z");
+});
diff --git a/packages/desktop/test/native-whiteboard-close.test.ts b/packages/desktop/test/native-whiteboard-close.test.ts
new file mode 100644
index 00000000..af3eadfb
--- /dev/null
+++ b/packages/desktop/test/native-whiteboard-close.test.ts
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { NativeWhiteboardCloseBroker, type NativeWhiteboardCloseRequest } from "../src/main/nativeWhiteboardClose.js";
+
+function fixture(timeout = 100) {
+  const broker = new NativeWhiteboardCloseBroker(timeout);
+  const requests = new Map<number, NativeWhiteboardCloseRequest[]>();
+  const register = (id: number, dirty = false) => {
+    requests.set(id, []);
+    broker.register(id, { alive: () => true, send: request => requests.get(id)!.push(request) }, dirty);
+  };
+  return { broker, requests, register };
+}
+
+test("Main asks a capable renderer even when the last dirty projection is false", async () => {
+  const f = fixture(); f.register(1, false);
+  const closing = f.broker.prepareAll();
+  const request = f.requests.get(1)![0]!;
+  assert.equal(f.broker.complete(2, request.requestId, true), false);
+  assert.equal(f.broker.complete(1, "stale-request", true), false);
+  let settled = false; void closing.then(() => { settled = true; });
+  await Promise.resolve(); assert.equal(settled, false);
+  assert.equal(f.broker.complete(1, request.requestId, true), true);
+  assert.equal(await closing, true);
+});
+
+test("cancel in another window unfreezes every prior approval and preserves close ownership", async () => {
+  const f = fixture(); f.register(1, true); f.register(2, true);
+  const closing = f.broker.prepareAll();
+  f.broker.complete(1, f.requests.get(1)![0]!.requestId, true);
+  await new Promise(resolve => setImmediate(resolve));
+  f.broker.complete(2, f.requests.get(2)![0]!.requestId, false);
+  assert.equal(await closing, false);
+  assert.equal(f.requests.get(1)!.at(-1)?.phase, "cancelled");
+  const retry = f.broker.prepareAll();
+  const newer = f.requests.get(1)!.at(-1)!;
+  assert.notEqual(newer.requestId, f.requests.get(1)![0]!.requestId);
+  assert.equal(f.broker.complete(1, f.requests.get(1)![0]!.requestId, true), false);
+  f.broker.complete(1, newer.requestId, false);
+  assert.equal(await retry, false);
+});
+
+test("timeout and renderer loss deny close without discarding drafts or borrowing another reply", async () => {
+  const f = fixture(5); f.register(1, true);
+  assert.equal(await f.broker.prepareAll(), false);
+  assert.equal(f.requests.get(1)!.at(-1)?.phase, "cancelled");
+  const closing = f.broker.prepareWindow(1);
+  f.broker.forget(1);
+  assert.equal(await closing, false);
+});
+
+test("repeated quit shares one request and cannot create a second close workflow", async () => {
+  const f = fixture(); f.register(1, true);
+  const first = f.broker.prepareAll(), second = f.broker.prepareAll();
+  assert.equal(first, second);
+  assert.equal(f.requests.get(1)!.length, 1);
+  f.broker.complete(1, f.requests.get(1)![0]!.requestId, true);
+  assert.equal(await first, true);
+});
diff --git a/packages/desktop/test/task-realtime-wire-consumer.test.mjs b/packages/desktop/test/task-realtime-wire-consumer.test.mjs
new file mode 100644
index 00000000..063a8468
--- /dev/null
+++ b/packages/desktop/test/task-realtime-wire-consumer.test.mjs
@@ -0,0 +1,225 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { EventEmitter } from "node:events";
+import { MessageChannel } from "node:worker_threads";
+import { loadMainConsumer } from "./helpers/main-consumer-fixture.mjs";
+
+const variants = {
+  agent_message_chunk: { content: "message", parentToolUseId: null, messageId: "m" },
+  agent_thought_chunk: { content: "thought", parentToolUseId: null },
+  tool_call: { toolId: "tool", input: { x: 1 }, kind: "read", title: "Read", raw: {} },
+  tool_call_update: { toolId: "tool", status: "completed", raw: {}, content: { output: "ok" } },
+  plan: { steps: [{ id: "s", title: "Step", status: "pending" }] },
+  permission_request: {
+    requestId: "permission",
+    description: "Permit",
+    kind: "write",
+    options: [],
+    raw: {},
+  },
+  permission_response: {
+    requestId: "permission",
+    optionId: "deny",
+    response: { decision: "deny" },
+  },
+  elicitation_request: { requestId: "question", message: "Choose", options: [] },
+  elicitation_response: { requestId: "question", action: "cancel" },
+  task_complete: { stopReason: "end_turn" },
+  task_run_started: { startedAt: 1 },
+  task_warning: { warning: "warning" },
+  task_error: { error: "controlled error" },
+  config_option_update: { configOptions: [] },
+  available_commands_update: { commands: [] },
+  mode_update: { currentModeId: "code", availableModes: [] },
+  session_info_update: { title: "Title", apiRetry: null },
+  goal_verification_update: { verification: { passed: true, reason: "owned verification" } },
+  task_token_usage_delta: {
+    eventKey: "usage",
+    usage: { inputTokens: 1, outputTokens: 2, totalTokens: 3 },
+  },
+  task_network_debug_status: {
+    eventKey: "network",
+    statusType: "model_request_completed",
+    requestHeaders: {},
+    responseHeaders: {},
+    requestHeaderCount: 0,
+    responseHeaderCount: 0,
+  },
+  usage_update: { size: 100, used: 3 },
+  background_bash_jobs_update: { jobs: [] },
+};
+
+async function relay(t) {
+  const { TaskRealtimeBus } = await loadMainConsumer(t, "taskRealtimeBus.ts");
+  const bus = new TaskRealtimeBus({ logger: { info() {}, warn() {} } });
+  const errors = [];
+  const hosts = [];
+  function host(id, workspaceKeys) {
+    const { port1, port2 } = new MessageChannel();
+    const child = new EventEmitter();
+    child.postMessage = (message) => port1.postMessage(message);
+    const messages = [];
+    port1.on("message", (message) => {
+      try {
+        child.emit("message", message);
+      } catch (error) {
+        errors.push(error);
+      }
+    });
+    port2.on("message", (message) => messages.push(message));
+    bus.registerHost({ hostId: id, windowId: hosts.length + 1, child, workspaceKeys });
+    const fixture = { id, messages, send: (message) => port2.postMessage(message), port1, port2 };
+    hosts.push(fixture);
+    return fixture;
+  }
+  t.after(() => {
+    try {
+      for (const fixture of hosts) bus.unregisterHost(fixture.id);
+    } finally {
+      for (const fixture of hosts) {
+        fixture.port1.close();
+        fixture.port2.close();
+      }
+    }
+  });
+  return { bus, errors, host };
+}
+
+async function until(predicate) {
+  const deadline = Date.now() + 2000;
+  while (!predicate()) {
+    assert.ok(Date.now() < deadline, "controlled port response timed out");
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+}
+const targetFor = (id) => ({
+  workspacePath: "/fixture",
+  workspaceKey: "/fixture",
+  taskId: id,
+  runId: `run-${id}`,
+  traceId: `run-${id}`,
+});
+async function acquire(host, target) {
+  host.send({
+    type: "task-run-lease-acquire",
+    request: { ...target, leaseRequestId: target.taskId },
+  });
+  await until(() =>
+    host.messages.some((message) => message.result?.leaseRequestId === target.taskId),
+  );
+  assert.equal(
+    host.messages.find((message) => message.result?.leaseRequestId === target.taskId).result
+      .acquired,
+    true,
+  );
+}
+const batches = (host) =>
+  host.messages
+    .filter((message) => message.event?.type === "task_stream_mirror_batch")
+    .map((message) => message.event);
+
+// Node MessageChannel is real; EventEmitter adapts UtilityProcess's public message
+// surface. This proves Main wire handling and transport, not Electron/SSH execution.
+test("current port relays all 22 event variants and unknown fields with original scope and sequence", async (t) => {
+  const { errors, host } = await relay(t);
+  const owner = host("owner", ["/fixture"]);
+  const observer = host("observer", ["/fixture"]);
+  const excluded = host("excluded", ["/other"]);
+  const payloads = { ...variants, future_extension: { opaque: { nested: [1, "two"] } } };
+  const source = await readFile(
+    new URL("../../shared/src/zcode-task-types-core.ts", import.meta.url),
+    "utf8",
+  );
+  const union = source.match(/export type TaskStreamMirrorableEvent = \(([\s\S]*?)\) &/)[1];
+  const declaredTypes = [...union.matchAll(/\| (ZCode\w+)/g)].map(
+    (match) =>
+      source.match(new RegExp(`export interface ${match[1]} \\{[\\s\\S]*?type: "([^"]+)"`))[1],
+  );
+  assert.equal(declaredTypes.length, 22);
+  assert.deepEqual(Object.keys(variants).sort(), declaredTypes.sort());
+  for (const [type, fields] of Object.entries(payloads)) {
+    const target = targetFor(type);
+    await acquire(owner, target);
+    const event = {
+      type,
+      taskId: target.taskId,
+      traceId: target.traceId,
+      inputId: "input",
+      ...fields,
+      extension: { retained: true },
+    };
+    owner.send({ type: "task-stream-op-publish", target, op: { kind: "stream_event", event } });
+    owner.send({ type: "task-run-lease-release", target });
+    await until(() => batches(observer).some((batch) => batch.taskId === target.taskId));
+    const batch = batches(observer).find((item) => item.taskId === target.taskId);
+    assert.deepEqual(batch.ops, [{ kind: "stream_event", event, seq: 1 }]);
+    assert.equal(batch.fromSeq, 1);
+    assert.equal(batch.toSeq, 1);
+    assert.equal(batch.traceId, target.traceId);
+    assert.equal(batch.runId, target.runId);
+    assert.equal(batch.deliveryPurpose, "observer");
+    await until(() => batches(owner).some((item) => item.taskId === target.taskId));
+    assert.equal(
+      batches(owner).find((item) => item.taskId === target.taskId).deliveryPurpose,
+      "relay_owner",
+    );
+  }
+  assert.equal(batches(excluded).length, 0);
+  assert.deepEqual(errors, []);
+});
+
+test("wire-valid opaque chunk does not crash; text merge, owner/run fence and replay stay intact", async (t) => {
+  const { errors, host } = await relay(t);
+  const owner = host("owner", ["/fixture"]);
+  const observer = host("observer", ["/fixture"]);
+  const target = targetFor("opaque");
+  await acquire(owner, target);
+  const opaque = {
+    type: "agent_message_chunk",
+    taskId: target.taskId,
+    traceId: target.traceId,
+    extension: { noContent: true },
+  };
+  owner.send({
+    type: "task-stream-op-publish",
+    target,
+    op: { kind: "stream_event", event: opaque },
+  });
+  owner.send({ type: "task-run-lease-release", target });
+  await until(
+    () => errors.length > 0 || batches(observer).some((batch) => batch.taskId === target.taskId),
+  );
+  assert.deepEqual(errors, []);
+  assert.deepEqual(batches(observer)[0].ops[0].event, opaque);
+  const text = targetFor("text");
+  await acquire(owner, text);
+  const sendText = (producer, target, content) =>
+    producer.send({
+      type: "task-stream-op-publish",
+      target,
+      op: {
+        kind: "stream_event",
+        event: {
+          type: "agent_message_chunk",
+          taskId: target.taskId,
+          traceId: target.traceId,
+          content,
+          messageId: "same",
+        },
+      },
+    });
+  sendText(observer, text, "foreign owner");
+  sendText(owner, { ...text, runId: "old", traceId: "old" }, "old run");
+  sendText(owner, { ...text, traceId: "mismatched" }, "invalid trace");
+  sendText(owner, text, "a");
+  sendText(owner, text, "b");
+  owner.send({ type: "task-run-lease-release", target: text });
+  await until(() => batches(observer).some((batch) => batch.taskId === "text"));
+  const batch = batches(observer).find((item) => item.taskId === "text");
+  assert.equal(batch.ops.length, 1);
+  assert.equal(batch.ops[0].event.content, "ab");
+  const reopened = host("reopened", ["/fixture"]);
+  await until(() => batches(reopened).some((item) => item.taskId === "text"));
+  assert.deepEqual(batches(reopened).find((item) => item.taskId === "text").ops, batch.ops);
+});
