+      // Restore ordinary writer before corrupting the authored row; no production data is rewritten.
+      delete (x.f.store as unknown as Record<string, unknown>).saveSessionEntry;
+      await x.f.store.saveSessionEntry({ ...entry, data });
+      const before = await x.bytes(),
