diff --git a/packages/ui/src/WhiteboardNativeControls.tsx b/packages/ui/src/WhiteboardNativeControls.tsx
new file mode 100644
index 00000000..80562b93
--- /dev/null
+++ b/packages/ui/src/WhiteboardNativeControls.tsx
@@ -0,0 +1,266 @@
+import { useEffect, useRef, useState } from "react";
+import type { WhiteboardControlResult } from "@zcode/shared";
+import { Button } from "./components/ui/button.js";
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "./components/ui/dialog.js";
+import { useZCodeIntl } from "./i18n/IntlProvider.js";
+import { useWorkspaceServicesResolution } from "./hooks/useWorkspaceServices.js";
+import { useNativeWhiteboardControls } from "./hooks/useNativeWhiteboardControls.js";
+import { useWhiteboardStore } from "./store/whiteboardStore.js";
+import { isWhiteboardDirty } from "./store/whiteboardNativeProjection.js";
+import { drawWhiteboardDocument, type WhiteboardDocument } from "./lib/whiteboard.js";
+import { exportWhiteboardDrawing } from "./lib/whiteboardExport.js";
+import { flushWhiteboardGestures } from "./lib/whiteboardGesture.js";
+import { showNativeWhiteboardSession } from "./lib/nativeWhiteboardNavigation.js";
+import type {
+  NativeWhiteboardActionTarget,
+  ShowNativeWhiteboardSession,
+} from "./lib/nativeWhiteboardDraft.js";
+
+function SavedWhiteboardPreview({ board }: { board: WhiteboardDocument }) {
+  const canvas = useRef<HTMLCanvasElement>(null);
+  useEffect(() => {
+    const context = canvas.current?.getContext("2d");
+    if (context) drawWhiteboardDocument(context, board);
+  }, [board]);
+  return (
+    <canvas
+      ref={canvas}
+      width={1280}
+      height={800}
+      className="w-full rounded border bg-white"
+      aria-label={board.name}
+    />
+  );
+}
+
+export function WhiteboardNativeControls({
+  target,
+  board,
+  sessionId,
+  onOpenBoard,
+  showSession = showNativeWhiteboardSession,
+}: {
+  target: NativeWhiteboardActionTarget;
+  board?: WhiteboardDocument;
+  sessionId?: string | null;
+  onOpenBoard?: (boardId: string, name: string) => void;
+  showSession?: ShowNativeWhiteboardSession;
+}) {
+  const { intl } = useZCodeIntl();
+  const resolution = useWorkspaceServicesResolution(
+    target.workspacePath,
+    target.remoteSessionId,
+    target.workspaceIdentity,
+  );
+  const controls = useNativeWhiteboardControls({
+    target,
+    agent: resolution.services.zcodeAgentService,
+    sessionId,
+    rpcReady: resolution.rpcReady,
+    showSession,
+  });
+  const [catalog, setCatalog] = useState<{
+    owner: object;
+    result: Extract<WhiteboardControlResult, { status: "listed" }>;
+  }>();
+  const [preview, setPreview] = useState<object>();
+  const [exportError, setExportError] = useState<string>();
+  const t = (id: string) => intl.formatMessage({ id });
+  const error = exportError ?? controls.error;
+  const native = controls.native;
+  const dirty = isWhiteboardDirty(board, native);
+  const pending = Boolean(native?.pending);
+  const saved = native?.incoming ?? native?.committed;
+  const doExport = (format: "png" | "json", savedVersion = false) => {
+    try {
+      flushWhiteboardGestures(target);
+      const latest = useWhiteboardStore.getState().getBoard(target);
+      if (!latest) throw new Error(t("whiteboard.exportMissing"));
+      exportWhiteboardDrawing(
+        savedVersion && saved ? saved.document.board : latest,
+        format,
+        savedVersion ? saved?.document : undefined,
+      );
+      setExportError(undefined);
+    } catch (failure) {
+      setExportError(failure instanceof Error ? failure.message : String(failure));
+    }
+  };
+  return (
+    <>
+      <div
+        className="flex flex-wrap items-center gap-2 border-b border-border px-2 py-2"
+        data-testid="whiteboard-native-controls"
+      >
+        <span
+          className="mr-auto text-ui-sm text-foreground-subtle"
+          data-testid="whiteboard-save-status"
+        >
+          {t(
+            pending
+              ? "whiteboard.saving"
+              : dirty || !native?.committed
+                ? "whiteboard.unsaved"
+                : "whiteboard.saved",
+          )}
+        </span>
+        <Button
+          size="sm"
+          disabled={!board || pending || controls.frozen || !resolution.rpcReady}
+          onClick={() => {
+            setExportError(undefined);
+            void controls.save();
+          }}
+          data-testid="whiteboard-save"
+        >
+          {t("whiteboard.save")}
+        </Button>
+        {pending ? (
+          <Button
+            size="sm"
+            variant="outline"
+            onClick={() => {
+              void controls.stop();
+            }}
+            data-testid="whiteboard-stop"
+          >
+            {t("whiteboard.stopSave")}
+          </Button>
+        ) : null}
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={controls.busy || controls.frozen || !resolution.rpcReady}
+          onClick={() => {
+            void controls.list().then((result) => {
+              if (result) setCatalog({ owner: controls.owner, result });
+            });
+          }}
+          data-testid="whiteboard-open"
+        >
+          {t("whiteboard.open")}
+        </Button>
+        <Button
+          size="sm"
+          variant="ghost"
+          disabled={controls.busy || pending || controls.frozen || !resolution.rpcReady}
+          onClick={() => {
+            void controls.read();
+          }}
+          data-testid="whiteboard-refresh"
+        >
+          {t("whiteboard.refresh")}
+        </Button>
+        <Button
+          size="sm"
+          variant="ghost"
+          disabled={!board}
+          onClick={() => doExport("png")}
+          data-testid="whiteboard-export-png"
+        >
+          {t("whiteboard.exportPng")}
+        </Button>
+        <Button
+          size="sm"
+          variant="ghost"
+          disabled={!board}
+          onClick={() => doExport("json")}
+          data-testid="whiteboard-export-json"
+        >
+          {t("whiteboard.exportJson")}
+        </Button>
+        {saved ? (
+          <Button size="sm" variant="ghost" onClick={() => doExport("json", true)}>
+            {t("whiteboard.exportSaved")}
+          </Button>
+        ) : null}
+      </div>
+      {error || !resolution.rpcReady ? (
+        <p
+          role="alert"
+          className="px-3 py-2 text-ui-sm text-destructive"
+          data-testid="whiteboard-native-error"
+        >
+          {error?.startsWith("whiteboard.") ? t(error) : (error ?? t("whiteboard.hostUnavailable"))}
+        </p>
+      ) : null}
+      {native?.incoming ? (
+        <div
+          className="flex flex-wrap items-center gap-2 border-b px-3 py-2 text-ui-sm"
+          data-testid="whiteboard-conflict"
+        >
+          <span>{t("whiteboard.conflict")}</span>
+          <Button size="sm" variant="outline" onClick={() => setPreview(controls.owner)}>
+            {t("whiteboard.savedPreview")}
+          </Button>
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={pending || controls.frozen}
+            onClick={() => {
+              flushWhiteboardGestures(target);
+              useWhiteboardStore.getState().resolveNativeConflict(target, "saved");
+            }}
+          >
+            {t("whiteboard.useSaved")}
+          </Button>
+          <Button
+            size="sm"
+            variant="outline"
+            disabled={pending || controls.frozen}
+            onClick={() => {
+              flushWhiteboardGestures(target);
+              useWhiteboardStore.getState().resolveNativeConflict(target, "draft");
+            }}
+          >
+            {t("whiteboard.keepDraft")}
+          </Button>
+        </div>
+      ) : null}
+      <Dialog
+        open={catalog?.owner === controls.owner}
+        onOpenChange={(open) => {
+          if (!open) setCatalog(undefined);
+        }}
+      >
+        <DialogContent data-testid="whiteboard-open-dialog">
+          <DialogHeader>
+            <DialogTitle>{t("whiteboard.open")}</DialogTitle>
+          </DialogHeader>
+          {catalog?.result.items.map((item) => (
+            <Button
+              key={item.boardId}
+              variant="outline"
+              onClick={() => {
+                onOpenBoard?.(item.boardId, item.name);
+                setCatalog(undefined);
+              }}
+            >
+              {item.name}
+            </Button>
+          ))}
+          {catalog?.result.items.length === 0 ? <p>{t("whiteboard.noSavedBoards")}</p> : null}
+          {catalog?.result.errors.map((item) => (
+            <p role="alert" key={item.fileName}>
+              {item.fileName}: {item.message}
+            </p>
+          ))}
+          {catalog?.result.truncated ? <p>{t("whiteboard.catalogTruncated")}</p> : null}
+        </DialogContent>
+      </Dialog>
+      <Dialog
+        open={preview === controls.owner && Boolean(saved)}
+        onOpenChange={(open) => {
+          if (!open) setPreview(undefined);
+        }}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>{t("whiteboard.savedPreview")}</DialogTitle>
+          </DialogHeader>
+          {saved ? <SavedWhiteboardPreview board={saved.document.board} /> : null}
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
