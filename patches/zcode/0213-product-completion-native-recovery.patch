@@ -0,0 +1,73 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { join } from "node:path";
+import { createMcpAdapter } from "../../adapters/src/mcp/index.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { nativePluginFixture } from "./helpers/native-plugin-fixture.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+
+test("two original Runtime/SQLite owners racing the same Session operation admit exactly one SDK effect", async () => {
+  const x = await nativePluginFixture();
+  let secondStore: SqliteSessionStore | undefined;
+  let second: Awaited<ReturnType<typeof fixture>> | undefined;
+  const port = createMcpAdapter({ env: {} });
+  try {
+    // Establish the SAME original Session before opening a second real database connection.
+    await x.run("read_counter");
+    secondStore = new SqliteSessionStore({ dbPath: join(x.f.dir, "session.sqlite") });
+    second = await fixture(undefined, false, {
+      config: {
+        workingDirectory: x.f.dir,
+        toolAllowlist: undefined,
+        mcp: { enabled: true, servers: { counter: x.original } },
+      },
+      deps: { sessionStore: secondStore, mcpPort: port },
+    });
+    const barrier = Promise.withResolvers<void>();
+    let arrivals = 0;
+    const guard = () => {
+      let first = true;
+      return async (signal: AbortSignal) => {
+        signal.throwIfAborted();
+        if (first) {
+          first = false;
+          if (++arrivals === 2) barrier.resolve();
+          await barrier.promise;
+        }
+      };
+    };
+    const operationId = randomUUID();
+    const results = await Promise.allSettled([
+      x.run("increment", x.original, guard(), operationId),
+      second.runtime.performPluginViewControl(
+        { serverName: "counter", toolName: "increment", arguments: {} },
+        { operationId, expectedServerConfig: x.original, assertAvailable: guard() },
+      ),
+    ]);
+    assert.equal(
+      results.filter(
+        (result) =>
+          result.status === "fulfilled" && result.value.accepted && result.value.result.success,
+      ).length,
+      1,
+    );
+    assert.equal(
+      results.filter(
+        (result) =>
+          result.status === "rejected" &&
+          result.reason.code === "native_operation_already_recorded",
+      ).length,
+      1,
+    );
+    // Counter values alone could mask a concurrent overwrite; each real SDK write also appends a fact.
+    assert.equal(await x.effectCalls(), 1);
+    assert.equal(await x.count(), 1);
+    assert.equal(x.f.requests.length + second.requests.length, 0);
+  } finally {
+    await port.close();
+    await second?.close();
+    secondStore?.close();
+    await x.close();
+  }
+});
diff --git a/apps/zcode-cli/packages/core/test/native-plugin-view.test.ts b/apps/zcode-cli/packages/core/test/native-plugin-view.test.ts
