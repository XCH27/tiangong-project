+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { PassThrough } from "node:stream";
+import { NodeFileSystemAdapter } from "../../../adapters/src/fs/index.js";
+import { SqliteSessionStore } from "../../../adapters/src/storage/session-store/sqlite-session-store.js";
+import type { SessionId } from "@zcode/contracts";
+import {
+  whiteboardControlResultSchema,
+  zcodeProtocolMethods,
+  zcodeProtocolMessageSchema,
+  type WhiteboardControlInput,
+  type WhiteboardReadInput,
+  type ZCodeProtocolMessage,
+} from "@zcode/shared";
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { createNativeWhiteboardReadPort } from "../../src/app/native-whiteboard-read-port.js";
+import { ZCodeProtocolNdjsonConnection } from "../../src/zcode-protocol/transport.js";
+import { appModelFixture } from "./app-model-completion-fixture.js";
+import { projectionWireFixture } from "./native-projection-ndjson-fixture.js";
+
+export const projectionBoard = () => ({
+  id: `whiteboard:${randomUUID()}`,
+  name: "Owned projection board",
+  width: 1280 as const,
+  height: 800 as const,
+  strokes: [],
+  undoneStrokes: [],
+  createdAt: 1,
+  updatedAt: 1,
+});
+
+export async function projectionHostFixture(options: { missingActiveReadPort?: boolean } = {}) {
+  const f = await appModelFixture(),
+    files = new NodeFileSystemAdapter();
+  const dbPath = join(f.root, "projection.sqlite"),
+    workspace = {
+      workspacePath: join(f.root, "workspace"),
+      workspaceKey: join(f.root, "workspace"),
+    };
+  let store = new SqliteSessionStore({ dbPath }),
+    server: ZCodeProtocolAgentServer;
+  let requestId = 0,
+    appCreations = 0,
+    reads = 0;
+  const events: ZCodeProtocolMessage[] = [];
+  const read = files.readTextFile.bind(files),
+    list = files.listDirectory.bind(files);
+  files.readTextFile = async (...args) => {
+    reads++;
+    return read(...args);
+  };
+  files.listDirectory = async (...args) => {
+    reads++;
+    return list(...args);
+  };
+  const create = () => {
+    server = new ZCodeProtocolAgentServer({
+      env: {},
+      cwd: workspace.workspacePath,
+      sessionStore: store,
+      nativeWhiteboardReadPort: createNativeWhiteboardReadPort(files),
+      createZCodeApp: async (appOptions) => {
+        appCreations++;
+        const app = await f.create({
+          ...appOptions,
+          sessionStore: store,
+          fileSystemPort: files,
+          runtimeConfig: {
+            ...appOptions?.runtimeConfig,
+            workingDirectory: workspace.workspacePath,
+            mcp: { enabled: false, servers: {} },
+            memory: { enabled: false },
+            toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+          },
+        });
+        if (options.missingActiveReadPort) Reflect.deleteProperty(app, "nativeWhiteboardReadPort");
+        return app;
+      },
+    });
+    server.setNotificationSink((message) => {
+      events.push(message);
+      if (!("method" in message) || !("id" in message)) return;
+      if (message.method === zcodeProtocolMethods.sessionRequestRuntimePreferences)
+        void server.handleMessage({
+          id: message.id,
+          result: { nativeSearchEnhancementsEnabled: true, memoryEnabled: false },
+        });
+      if (message.method === zcodeProtocolMethods.interactionRequestPermission)
+        void server.handleMessage({ id: message.id, result: { decision: "allow" } });
+    });
+  };
+  create();
+  const request = async (method: string, params: unknown) => {
+    const response = await server.handleMessage({ id: ++requestId, method, params });
+    assert.ok(response && "result" in response, JSON.stringify(response));
+    return response.result;
+  };
+  const created = (await request(zcodeProtocolMethods.sessionCreate, {
+    workspace,
+    persistence: "deferred",
+  })) as { session: { sessionId: string } };
+  const sessionId = created.session.sessionId as SessionId;
+  return {
+    f,
+    files,
+    workspace,
+    sessionId,
+    get store() {
+      return store;
+    },
+    get appCreations() {
+      return appCreations;
+    },
+    get reads() {
+      return reads;
+    },
+    events,
+    shutdown: () => server.shutdown(),
+    openWire: () => projectionWireFixture((message) => server.handleMessage(message)),
+    request,
+    raw: (params: unknown) =>
+      server.handleMessage({
+        id: ++requestId,
+        method: zcodeProtocolMethods.sessionWhiteboardProjection,
+        params,
+      }),
+    projection: async (input: WhiteboardReadInput) =>
+      whiteboardControlResultSchema.parse(
+        await request(zcodeProtocolMethods.sessionWhiteboardProjection, {
+          workspace,
+          sessionId,
+          input,
+        }),
+      ),
+    async ndjsonProjection(input: WhiteboardReadInput) {
+      const incoming = new PassThrough(),
+        outgoing = new PassThrough();
+      const reply = Promise.withResolvers<unknown>();
+      let buffered = "";
+      outgoing.on("data", (chunk: Buffer) => {
+        buffered += chunk.toString("utf8");
+        const end = buffered.indexOf("\n");
+        if (end >= 0)
+          reply.resolve(zcodeProtocolMessageSchema.parse(JSON.parse(buffered.slice(0, end))));
+      });
+      const connection = new ZCodeProtocolNdjsonConnection({
+        input: incoming,
+        output: outgoing,
+        handleMessage: (message) => server.handleMessage(message),
+      });
+      connection.start();
+      const bytes =
+        JSON.stringify({
+          id: ++requestId,
+          method: zcodeProtocolMethods.sessionWhiteboardProjection,
+          params: { workspace, sessionId, input },
+        }) + "\n";
+      incoming.write(bytes.slice(0, 17));
+      incoming.write(bytes.slice(17));
+      const response = await reply.promise;
+      incoming.end();
+      await connection.waitForClose();
+      outgoing.destroy();
+      assert.ok(
+        typeof response === "object" && response !== null && "result" in response,
+        JSON.stringify(response),
+      );
+      return whiteboardControlResultSchema.parse(response.result);
+    },
+    control: async (command: WhiteboardControlInput) =>
+      whiteboardControlResultSchema.parse(
+        await request(zcodeProtocolMethods.sessionWhiteboardControl, {
+          workspace,
+          sessionId,
+          operationId: randomUUID(),
+          command,
+        }),
+      ),
+    async facts() {
+      const db = new DatabaseSync(dbPath, { readOnly: true });
+      try {
+        return {
+          session: await store.getSession(sessionId),
+          messages: await store.messages({ sessionID: sessionId }),
+          entries: await store.sessionEntries({ sessionID: sessionId }),
+          usage: ["model_usage", "tool_usage", "turn_usage"].map((table) =>
+            db.prepare(`select * from ${table}`).all(),
+          ),
+        };
+      } finally {
+        db.close();
+      }
+    },
+    async restart() {
+      await server.shutdown();
+      server.disposeProjections();
+      store.close();
+      store = new SqliteSessionStore({ dbPath });
+      create();
+    },
+    async close() {
+      await server.shutdown();
+      server.disposeProjections();
+      store.close();
+      await f.close();
+    },
+  };
+}
