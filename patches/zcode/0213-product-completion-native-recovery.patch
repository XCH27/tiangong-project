@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import { SESSION_ENTRY_MODEL_SELECTION } from "@zcode/contracts";
+
+test("public side-chat fork retains accepted model and remaps copied SQLite identities without inference", async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(
+      () => reply("", [{ id: "parent-effect", name: "Probe", input: { value: "authored" } }]),
+      () => reply("parent complete"),
+    );
+    await f.runtime.executeTurn("Authored parent input");
+    const parent = await f.store.messages({ sessionID: f.runtime.sessionId });
+    const parentIds = new Set(
+      parent.flatMap((message) => [
+        String(message.info.id),
+        ...message.parts.map((part) => String(part.id)),
+      ]),
+    );
+    const result = await f.runtime.createSelectionSideConversation({
+      sourceCommandId: "authored-side-chat",
+    });
+    const child = await f.store.messages({ sessionID: result.forkedSessionId });
+    assert.ok(child.length >= parent.length);
+    assert.ok(child.every((message) => message.info.sessionID === result.forkedSessionId));
+    assert.ok(
+      child
+        .flatMap((message) => [
+          String(message.info.id),
+          ...message.parts.map((part) => String(part.id)),
+        ])
+        .every((id) => !parentIds.has(id)),
+    );
+    assert.match(JSON.stringify(child), /inherited from the parent task/);
+    const selection = (
+      await f.store.sessionEntries({
+        sessionID: result.forkedSessionId,
+        type: SESSION_ENTRY_MODEL_SELECTION,
+      })
+    ).at(-1)!;
+    assert.deepEqual(selection.data, f.runtime.getSessionModelSelection());
+    const before = JSON.stringify(child);
+    await f.reopen();
+    assert.equal(
+      JSON.stringify(await f.store.messages({ sessionID: result.forkedSessionId })),
+      before,
+    );
+    assert.equal(f.requests.length, 2);
+    assert.equal(f.effects, 1);
+  } finally {
+    await f.close();
+  }
+});
