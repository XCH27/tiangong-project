@@ -0,0 +1,63 @@
+import { PassThrough } from "node:stream";
+import { zcodeProtocolMessageSchema, type ZCodeProtocolMessage } from "@zcode/shared";
+import { ZCodeProtocolNdjsonConnection } from "../../src/zcode-protocol/transport.js";
+
+export function projectionWireFixture(
+  handleMessage: ConstructorParameters<typeof ZCodeProtocolNdjsonConnection>[0]["handleMessage"],
+) {
+  const input = new PassThrough(),
+    output = new PassThrough();
+  const messages: ZCodeProtocolMessage[] = [];
+  const waiters = new Map<number, ReturnType<typeof Promise.withResolvers<ZCodeProtocolMessage>>>();
+  let buffer = "",
+    nextId = 0;
+  output.on("data", (chunk: Buffer) => {
+    buffer += chunk.toString("utf8");
+    let end: number;
+    while ((end = buffer.indexOf("\n")) >= 0) {
+      const message = zcodeProtocolMessageSchema.parse(JSON.parse(buffer.slice(0, end)));
+      buffer = buffer.slice(end + 1);
+      messages.push(message);
+      if ("id" in message && typeof message.id === "number") {
+        waiters.get(message.id)?.resolve(message);
+        waiters.delete(message.id);
+      }
+    }
+  });
+  const connection = new ZCodeProtocolNdjsonConnection({ input, output, handleMessage });
+  connection.start();
+  return {
+    messages,
+    connection,
+    request(method: string, params: unknown) {
+      const id = ++nextId,
+        waiter = Promise.withResolvers<ZCodeProtocolMessage>();
+      waiters.set(id, waiter);
+      input.write(JSON.stringify({ id, method, params }) + "\n");
+      return waiter.promise;
+    },
+    end() {
+      input.end();
+      return connection.waitForClose();
+    },
+    async close() {
+      input.end();
+      await connection.waitForClose();
+      output.destroy();
+    },
+  };
+}
+
+export async function within<T>(promise: Promise<T>, label: string, ms = 500): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`${label} remained queued`)), ms);
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
