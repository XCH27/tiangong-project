@@ -0,0 +1,30 @@
+import type { V4CommandCoreHost } from "../zcode-protocol-v4/commands/types.js";
+
+import { resolveStableForkTargetFromTranscript } from "../zcode-protocol-v4/stable-fork-target.js";
+
+import type { SessionId } from "@zcode/contracts";
+
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function createV4CoreHostResolveStableForkTarget(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+}): V4CommandCoreHost["resolveStableForkTarget"] {
+  return (
+    {
+      resolveStableForkTarget: async (sessionId, rowId) => {
+        const candidate =
+          factoryBindings.context.v4Gateway?.resolveStableForkCandidate(sessionId, rowId) ?? null;
+        if (!candidate) return { ok: false, reasonCode: "guard.forkTargetAmbiguous" };
+        if (!candidate.ok) return candidate;
+        const store = factoryBindings.context.deps.sessionStore;
+        if (!store) return { ok: false, reasonCode: "guard.forkTargetAmbiguous" };
+        const messages = await store.messages({ sessionID: sessionId as SessionId });
+        return await resolveStableForkTargetFromTranscript({
+          candidate: candidate.candidate,
+          messages,
+          store,
+        });
+      },
+    } satisfies Pick<V4CommandCoreHost, "resolveStableForkTarget">
+  ).resolveStableForkTarget;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-turn-user-prompt.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-turn-user-prompt.ts
new file mode 100644
index 00000000..03a0ac72
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-turn-user-prompt.ts
@@ -0,0 +1,35 @@
+import type { V4CommandCoreHost } from "../zcode-protocol-v4/commands/types.js";
+
+import type { SessionId } from "@zcode/contracts";
+
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function createV4CoreHostResolveTurnUserPrompt(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+}): V4CommandCoreHost["resolveTurnUserPrompt"] {
+  return (
+    {
+      resolveTurnUserPrompt: async (sessionId, assistantMessageId) => {
+        const sessionStore = factoryBindings.context.deps.sessionStore;
+        if (!sessionStore) return null;
+        const messages = await sessionStore.messages({
+          sessionID: sessionId as SessionId,
+        });
+        const assistantInfo = messages.find(
+          (message) => message.info.id === assistantMessageId,
+        )?.info;
+        if (assistantInfo?.role !== "assistant") return null;
+        const user = messages.find((message) => message.info.id === assistantInfo.parentID);
+        if (!user || user.info.role !== "user") return null;
+        const text = user.parts
+          .filter(
+            (part): part is Extract<(typeof user.parts)[number], { type: "text" }> =>
+              part.type === "text" && part.ignored !== true,
+          )
+          .map((part) => part.text)
+          .join("");
+        return text.length > 0 ? text : null;
+      },
+    } satisfies Pick<V4CommandCoreHost, "resolveTurnUserPrompt">
+  ).resolveTurnUserPrompt;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-user-message-id-for-row.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-core-host-resolve-user-message-id-for-row.ts
