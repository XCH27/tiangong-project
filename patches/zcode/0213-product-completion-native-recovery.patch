+// 同一 telemetry owner 的职责拆分；状态、Writer 和指标调用保持原路径。
+import { type Attributes, type Context, type Span } from "@opentelemetry/api";
+import type {
+  AgentStepSpanWriter,
+  AgentTelemetryCancellationReason,
+  AgentTelemetryErrorCategory,
+  AgentTurnSpanWriter,
+  CommandExecutionSpanWriter,
