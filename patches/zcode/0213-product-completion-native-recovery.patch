+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: String(error) + "\n" + errors.join("\n") });
+      } finally {
+        fixture.releaseWrite();
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    }
+  }
