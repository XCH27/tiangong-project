index 00000000..18356478
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/mcp/adapter-owner.ts
@@ -0,0 +1,168 @@
+import type { McpPort } from "@zcode/contracts";
+// Same adapter owner; extracted adapter-owner responsibility.
+import { randomUUID } from "node:crypto";
+import type { Logger, McpServerStatus } from "@zcode/contracts";
+import { type OfficialMcpAuthFailureKind } from "@zcode/shared";
+import { type NetworkEgressEnvPolicy } from "./network.js";
+import { type McpConnectionContext } from "./pool.js";
+import { type McpOAuthRuntimeOptions } from "./oauth.js";
+import { type SharedZCodeCredentialStore } from "../auth/shared-credentials.js";
+import type { McpTelemetryTracker } from "./telemetry.js";
+import { type CreateMcpAdapterOptions, type McpServerRecord } from "./adapter-types.js";
+import { connectMethods } from "./adapter-connect-methods.js";
+import { callMethods } from "./adapter-call-methods.js";
+import { authorizationMethods } from "./adapter-authorization-methods.js";
+import { openingMethods } from "./adapter-opening-methods.js";
+import { oauthMethods } from "./adapter-oauth-methods.js";
+import { transportMethods } from "./adapter-transport-methods.js";
+import { recordsMethods } from "./adapter-records-methods.js";
+import type { McpAdapterMethods, McpAdapterPublicMethods } from "./adapter-method-surface.js";
+// Same adapter owner; extracted adapter-owner responsibility.
+
+export {
+  DEFAULT_MCP_TIMEOUT_MS,
+  MCP_PING_TIMEOUT_MS,
+  MCP_STDIO_STDERR_LOG_MAX_CHARS,
+  MAX_TRACKED_SERVER_REQUEST_IDS,
+  type CreateMcpAdapterOptions,
+  type McpClient,
+  type OfficialMcpAuthMetaPayload,
+  type McpServerRecord,
+} from "./adapter-types.js";
+// Same adapter owner; extracted adapter-owner responsibility.
+
+export class NodeMcpAdapter implements McpPort, McpAdapterPublicMethods {
+  private readonly adapterInstanceId = randomUUID();
+  private readonly clientName: string;
+  private readonly clientVersion: string;
+  private readonly connectionContext?: McpConnectionContext;
+  private readonly env?: NodeJS.ProcessEnv;
+  private readonly logger?: Logger;
+  private readonly mcpOAuth?: McpOAuthRuntimeOptions;
+  private readonly network?: NetworkEgressEnvPolicy;
+  private readonly officialMcpAuth?: CreateMcpAdapterOptions["officialMcpAuth"];
+  private readonly telemetry?: McpTelemetryTracker;
+  private readonly connectionGenerations = new Map<string, number>();
+  private credentialStore?: SharedZCodeCredentialStore;
+  /**
+   * 官方鉴权失败分类的暂存槽。不能从 error 对象读——SDK 的 version
+   * negotiation 会把 OfficialMcpAuthError 重新包装成普通 Error，instanceof 失效；
+   * 也不允许按错误文本反解。因此在抛出点写入，failConnection 取用后立即清除。
+   */
+  private readonly lastOfficialAuthKind = new Map<string, OfficialMcpAuthFailureKind>();
+  /**
+   * span → 服务端 request id。只有官方 MCP 会写入（唯一能看到响应头的地方是 auth fetch
+   * wrapper），供 in-band 失败（HTTP 200 + `isError`）把 id 带回 tool result。
+   *
+   * 用 span 而不是 traceId 作键：traceId 覆盖整个顶层 session，同一 session 的多次调用
+   * 共用它，关联会串号；span 是一次 tool call 的粒度。
+   *
+   * 有界并即取即删：拿不到匹配的 span（如 initialize / tools/list，它们没有 `_meta`）
+   * 就让条目自然被挤出，绝不"取最近一次"兜底——那会把上一次调用的 id 贴到这一次的失败上。
+   */
+  private readonly serverRequestIdBySpan = new Map<string, string>();
+  private readonly connectionDiagnosticByServer = new Map<
+    string,
+    Pick<McpServerStatus, "failureKind" | "serverRequestId">
+  >();
+  private readonly records = new Map<string, McpServerRecord>();
+  private readonly workingDirectory?: string;
+
+  constructor(options: CreateMcpAdapterOptions) {
+    this.clientName = options.clientName ?? "zcode";
+    this.clientVersion = options.clientVersion ?? "0.0.0";
+    this.connectionContext = options.connectionContext;
+    this.env = options.env;
+    this.logger = options.logger?.child({
+      ...this.connectionContext,
+      module: "adapters.mcp",
+    });
+    this.mcpOAuth = options.mcpOAuth;
+    this.network = options.network;
+    this.officialMcpAuth = options.officialMcpAuth;
+    this.telemetry = options.telemetry;
+    this.workingDirectory = options.workingDirectory;
+  }
+  declare private assertExpectedConfiguration: McpAdapterMethods["assertExpectedConfiguration"];
+  declare private rememberServerResponse: McpAdapterMethods["rememberServerResponse"];
+  declare private takeServerRequestId: McpAdapterMethods["takeServerRequestId"];
+  declare private resolveOfficialStdioAuthMeta: McpAdapterMethods["resolveOfficialStdioAuthMeta"];
+  declare private callToolOnClient: McpAdapterMethods["callToolOnClient"];
+  declare private reconnectForCall: McpAdapterMethods["reconnectForCall"];
+  declare private recoverToolCallAuthorization: McpAdapterMethods["recoverToolCallAuthorization"];
+  declare private ensureToolCallAuthorizationRecovery: McpAdapterMethods["ensureToolCallAuthorizationRecovery"];
+  declare private runToolCallAuthorizationRecovery: McpAdapterMethods["runToolCallAuthorizationRecovery"];
+  declare private waitForSharedConnection: McpAdapterMethods["waitForSharedConnection"];
+  declare private openServerConnection: McpAdapterMethods["openServerConnection"];
+  declare private runInteractiveOAuthAuthorization: McpAdapterMethods["runInteractiveOAuthAuthorization"];
+  declare private failConnection: McpAdapterMethods["failConnection"];
+  declare private createTransport: McpAdapterMethods["createTransport"];
+  declare private createOfficialAuthFetch: McpAdapterMethods["createOfficialAuthFetch"];
+  declare private createOAuthClientProvider: McpAdapterMethods["createOAuthClientProvider"];
+  declare private resolveCredentialStore: McpAdapterMethods["resolveCredentialStore"];
+  declare private createAuthorizationCodeOAuthOptions: McpAdapterMethods["createAuthorizationCodeOAuthOptions"];
+  declare private attachStdioLogging: McpAdapterMethods["attachStdioLogging"];
+  declare private closeRecord: McpAdapterMethods["closeRecord"];
+  declare private closeClientAndTransport: McpAdapterMethods["closeClientAndTransport"];
+  declare private terminateStdioProcessTree: McpAdapterMethods["terminateStdioProcessTree"];
+  declare private nextConnectionGeneration: McpAdapterMethods["nextConnectionGeneration"];
+  declare private isCurrentConnection: McpAdapterMethods["isCurrentConnection"];
+  declare private updateCurrentRecord: McpAdapterMethods["updateCurrentRecord"];
+  declare private updateCurrentRecordStatus: McpAdapterMethods["updateCurrentRecordStatus"];
+  declare private createStatus: McpAdapterMethods["createStatus"];
+}
+
+const extractedMethods = {
+  ...connectMethods,
+  ...callMethods,
+  ...authorizationMethods,
+  ...openingMethods,
+  ...oauthMethods,
+  ...transportMethods,
+  ...recordsMethods,
+};
+for (const name of [
+  "connectConfiguredServers",
+  "connectServer",
+  "disconnectServer",
+  "status",
+  "pingServer",
+  "listTools",
+  "callTool",
+  "readResource",
+  "assertExpectedConfiguration",
+  "rememberServerResponse",
+  "takeServerRequestId",
+  "resolveOfficialStdioAuthMeta",
+  "callToolOnClient",
+  "reconnectForCall",
+  "recoverToolCallAuthorization",
+  "ensureToolCallAuthorizationRecovery",
+  "runToolCallAuthorizationRecovery",
+  "close",
+  "waitForSharedConnection",
+  "openServerConnection",
+  "runInteractiveOAuthAuthorization",
+  "failConnection",
+  "createTransport",
+  "createOfficialAuthFetch",
+  "createOAuthClientProvider",
+  "resolveCredentialStore",
+  "createAuthorizationCodeOAuthOptions",
+  "attachStdioLogging",
+  "closeRecord",
+  "closeClientAndTransport",
+  "terminateStdioProcessTree",
+  "nextConnectionGeneration",
+  "isCurrentConnection",
+  "updateCurrentRecord",
+  "updateCurrentRecordStatus",
+  "createStatus",
+]) {
+  Object.defineProperty(NodeMcpAdapter.prototype, name, {
+    value: extractedMethods[name as keyof typeof extractedMethods],
+    writable: true,
+    configurable: true,
+    enumerable: false,
+  });
+}
diff --git a/apps/zcode-cli/packages/adapters/src/mcp/adapter-records-methods.ts b/apps/zcode-cli/packages/adapters/src/mcp/adapter-records-methods.ts
new file mode 100644
index 00000000..fd2e5cbc
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/mcp/adapter-records-methods.ts
@@ -0,0 +1,255 @@
+import { mcpConfigIdentity } from "./config-identity.js";
+import type { McpServerConfig, McpServerStatus } from "@zcode/contracts";
+import { OfficialMcpAuthError, type OfficialMcpServerResponseInfo } from "./official-auth.js";
+import { type McpServerFailureKind } from "@zcode/shared";
+import { McpTimeoutError } from "./timeout.js";
+import { getStdioTransportPid, type McpTransport } from "./adapter-values.js";
+import {
+  MAX_TRACKED_SERVER_REQUEST_IDS,
+  type McpClient,
+  type McpServerRecord,
+} from "./adapter-types.js";
+import type { McpAdapterInternal } from "./adapter-method-receiver.js";
+export interface McpRecordsMethods {
+  assertExpectedConfiguration(name: string, expected?: McpServerConfig): void;
+  rememberServerResponse(serverName: string, response: OfficialMcpServerResponseInfo): void;
+  takeServerRequestId(spanId: string | undefined): string | undefined;
+  failConnection(input: {
+    client?: McpClient;
+    config: McpServerConfig;
+    connectDurationMs?: number;
+    error: unknown;
+    failureKind?: McpServerFailureKind;
+    generation: number;
+    getRecentStderr?: () => string | undefined;
+    listToolsDurationMs?: number;
+    name: string;
+    startedAt: number;
+    transport?: McpTransport;
+  }): Promise<McpServerStatus>;
+  nextConnectionGeneration(name: string): number;
+  isCurrentConnection(name: string, generation: number): boolean;
+  updateCurrentRecord(
+    name: string,
+    generation: number,
+    patch: Partial<Pick<McpServerRecord, "client" | "transport">>,
+  ): void;
+  updateCurrentRecordStatus(
+    name: string,
+    generation: number,
+    patch: Partial<McpServerStatus>,
+  ): void;
+  createStatus(
+    config: McpServerConfig,
+    status: McpServerStatus["status"],
+    extra?: {
+      authorization?: McpServerStatus["authorization"];
+      error?: string;
+      failureKind?: McpServerStatus["failureKind"];
+      protocolEra?: McpServerStatus["protocolEra"];
+      serverRequestId?: string;
+      toolCount?: number;
+    },
+  ): McpServerStatus;
+}
+export const recordsMethods = {
+  /** 异步连接/恢复之后重查完整配置；旧 view 不能借同名的新连接执行到另一个包。 */
+  assertExpectedConfiguration(
+    this: McpAdapterInternal,
+    name: string,
+    expected?: McpServerConfig,
+  ): void {
+    if (expected && this.records.get(name)?.configIdentity !== mcpConfigIdentity(expected))
+      throw new Error(`MCP server configuration changed before dispatch: ${name}`);
+  },
+
+  /** 连接期诊断按 server 保存；tool call request id 继续按 span 隔离。 */
+  rememberServerResponse(
+    this: McpAdapterInternal,
+    serverName: string,
+    response: OfficialMcpServerResponseInfo,
+  ): void {
+    if (
+      !response.spanId &&
+      response.rpcMethod !== "tools/call" &&
+      this.records.get(serverName)?.status.status === "connecting"
+    ) {
+      if (response.failureKind) {
+        this.connectionDiagnosticByServer.set(serverName, {
+          failureKind: response.failureKind,
+          ...(response.serverRequestId ? { serverRequestId: response.serverRequestId } : {}),
+        });
+      }
+      return;
+    }
+    if (!response.spanId) return;
+    if (!response.serverRequestId) return;
+    // 401 重试会对同一 span 产生两条响应，后写覆盖——留下的是最终那次，正是要报的那个。
+    this.serverRequestIdBySpan.set(response.spanId, response.serverRequestId);
+    while (this.serverRequestIdBySpan.size > MAX_TRACKED_SERVER_REQUEST_IDS) {
+      const oldest = this.serverRequestIdBySpan.keys().next();
+      if (oldest.done) break;
+      this.serverRequestIdBySpan.delete(oldest.value);
+    }
+  },
+
+  /** 取出并清除该 span 的 request id。取不到返回 undefined，不做任何兜底猜测。 */
+  takeServerRequestId(this: McpAdapterInternal, spanId: string | undefined): string | undefined {
+    if (!spanId) return undefined;
+    const requestId = this.serverRequestIdBySpan.get(spanId);
+    if (requestId !== undefined) this.serverRequestIdBySpan.delete(spanId);
+    return requestId;
+  },
+
+  async failConnection(
+    this: McpAdapterInternal,
+    input: {
+      client?: McpClient;
+      config: McpServerConfig;
+      connectDurationMs?: number;
+      error: unknown;
+      failureKind?: McpServerFailureKind;
+      generation: number;
+      getRecentStderr?: () => string | undefined;
+      listToolsDurationMs?: number;
+      name: string;
+      startedAt: number;
+      transport?: McpTransport;
+    },
+  ): Promise<McpServerStatus> {
+    const {
+      client,
+      config,
+      connectDurationMs,
+      error,
+      failureKind: fallbackFailureKind,
+      generation,
+      getRecentStderr,
+      listToolsDurationMs,
+      name,
+      startedAt,
+      transport,
+    } = input;
+    const message = error instanceof Error ? error.message : String(error);
+    // 官方 MCP 鉴权失败的稳定分类必须落进日志：failConnection 原先只记
+    // error.message，而多数分类并不出现在 message 文本里（只有 auth-port 那条带上了），
+    // 导致 official_mcp_origin_untrusted / official_auth_rejected 等在生产日志里 grep 不到。
+    const officialAuthKind =
+      (error instanceof OfficialMcpAuthError ? error.kind : undefined) ??
+      this.lastOfficialAuthKind.get(name);
+    this.lastOfficialAuthKind.delete(name);
+    const responseDiagnostic = this.connectionDiagnosticByServer.get(name);
+    this.connectionDiagnosticByServer.delete(name);
+    const failureKind =
+      (officialAuthKind === "official_mcp_origin_untrusted"
+        ? "official_origin_untrusted"
+        : undefined) ??
+      responseDiagnostic?.failureKind ??
+      (error instanceof McpTimeoutError && fallbackFailureKind !== "tool_list_failed"
+        ? "connection_timeout"
+        : undefined) ??
+      fallbackFailureKind ??
+      "connection_failed";
+    const displayMessage = responseDiagnostic?.serverRequestId
+      ? `${message} - ${responseDiagnostic.serverRequestId}`
+      : message;
+    const status = this.createStatus(config, "failed", {
+      error: displayMessage,
+      failureKind,
+      ...(responseDiagnostic?.serverRequestId
+        ? { serverRequestId: responseDiagnostic.serverRequestId }
+        : {}),
+    });
+    const recentStderr = getRecentStderr?.();
+    const mcpTransportPid = getStdioTransportPid(transport);
+    await this.closeClientAndTransport(name, client, transport);
+    if (!this.isCurrentConnection(name, generation)) {
+      return this.records.get(name)?.status ?? status;
+    }
+    this.records.set(name, {
+      config,
+      configIdentity: mcpConfigIdentity(config),
+      status,
+      tools: [],
+    });
+    this.logger?.warn("MCP server connection failed", {
+      ...this.connectionContext,
+      connectDurationMs,
+      durationMs: Date.now() - startedAt,
+      error: displayMessage,
+      event: "mcp.server.failed",
+      listToolsDurationMs,
+      mcpServerName: name,
+      ...(officialAuthKind ? { officialAuthKind } : {}),
+      ...(mcpTransportPid != null ? { mcpTransportPid } : {}),
+      status: "failed",
+      ...(recentStderr ? { stderr: recentStderr } : {}),
+      transport: config.type,
+    });
+    return status;
+  },
+
+  nextConnectionGeneration(this: McpAdapterInternal, name: string): number {
+    const generation = (this.connectionGenerations.get(name) ?? 0) + 1;
+    this.connectionGenerations.set(name, generation);
+    return generation;
+  },
+
+  isCurrentConnection(this: McpAdapterInternal, name: string, generation: number): boolean {
+    return this.connectionGenerations.get(name) === generation;
+  },
+
+  updateCurrentRecord(
+    this: McpAdapterInternal,
+    name: string,
+    generation: number,
+    patch: Partial<Pick<McpServerRecord, "client" | "transport">>,
+  ): void {
+    if (!this.isCurrentConnection(name, generation)) return;
+    const record = this.records.get(name);
+    if (!record) return;
+    Object.assign(record, patch);
+  },
+
+  updateCurrentRecordStatus(
+    this: McpAdapterInternal,
+    name: string,
+    generation: number,
+    patch: Partial<McpServerStatus>,
+  ): void {
+    if (!this.isCurrentConnection(name, generation)) return;
+    const record = this.records.get(name);
+    if (!record) return;
+    record.status = {
+      ...record.status,
+      ...patch,
+      updatedAt: new Date().toISOString(),
+    };
+  },
+
+  createStatus(
+    this: McpAdapterInternal,
+    config: McpServerConfig,
+    status: McpServerStatus["status"],
+    extra: {
+      authorization?: McpServerStatus["authorization"];
+      error?: string;
+      failureKind?: McpServerStatus["failureKind"];
+      protocolEra?: McpServerStatus["protocolEra"];
+      serverRequestId?: string;
+      toolCount?: number;
+    } = {},
+  ): McpServerStatus {
+    return {
+      status,
+      transport: config.type,
+      toolCount: extra.toolCount ?? 0,
+      updatedAt: new Date().toISOString(),
+      authorization: extra.authorization,
+      error: extra.error,
+      failureKind: extra.failureKind,
+      protocolEra: extra.protocolEra,
+      serverRequestId: extra.serverRequestId,
+    };
+  },
+};
diff --git a/apps/zcode-cli/packages/adapters/src/mcp/adapter-transport-methods.ts b/apps/zcode-cli/packages/adapters/src/mcp/adapter-transport-methods.ts
