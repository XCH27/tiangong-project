@@ -0,0 +1,27 @@
+import type { NativeWhiteboardActionTarget } from "./nativeWhiteboardDraft.js";
+
+export const NATIVE_WHITEBOARD_PANE_CLOSE = "zcode:native-whiteboard-pane-close";
+export interface NativeWhiteboardPaneCloseRequest {
+  targets: readonly NativeWhiteboardActionTarget[];
+  isCurrent: () => boolean;
+  resolve: (allowClose: boolean) => void;
+  handled: boolean;
+}
+
+/** The existing pane owner awaits the one window draft-close controller. */
+export function closeNativeWhiteboardPanes(
+  targets: readonly NativeWhiteboardActionTarget[],
+  isCurrent: () => boolean,
+): Promise<boolean> {
+  if (targets.length === 0) return Promise.resolve(true);
+  const receipt = Promise.withResolvers<boolean>();
+  const detail: NativeWhiteboardPaneCloseRequest = {
+    targets,
+    isCurrent,
+    resolve: receipt.resolve,
+    handled: false,
+  };
+  window.dispatchEvent(new CustomEvent(NATIVE_WHITEBOARD_PANE_CLOSE, { detail }));
+  if (!detail.handled) receipt.resolve(false);
+  return receipt.promise;
+}
