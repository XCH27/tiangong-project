+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { isFileSystemPortError } from "@zcode/contracts";
+import { NodeFileSystemAdapter, setRipgrepWorkerFactoryForTests } from "../src/fs/index.js";
+
+test("public file search preserves glob, context, matching and runtime-only fallback over authored files", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-file-search-"));
+  try {
+    await mkdir(join(root, "nested"));
+    await mkdir(join(root, ".git"));
+    const first = join(root, "first.md"),
+      second = join(root, "nested", "second.md");
+    await writeFile(first, "before\nalpha beta\nafter\n");
+    await writeFile(second, "alpha gamma\n");
+    await writeFile(join(root, ".git", "excluded.md"), "alpha secret\n");
+    await writeFile(join(root, "binary.bin"), "alpha\0binary");
+    const javascript = new NodeFileSystemAdapter({ textSearchEngine: "javascript" });
+    const glob = await javascript.searchFiles({ path: root, pattern: "*.md" });
+    assert.deepEqual(new Set(glob.files), new Set([first, second]));
+    const context = await javascript.searchText({
+      path: first,
+      pattern: "alpha",
+      outputMode: "content",
+      context: 1,
+      showLineNumbers: true,
+    });
+    assert.deepEqual(
+      context.entries.map((entry) => [entry.lineNumber, entry.text, entry.matched]),
+      [
+        [1, "before", false],
+        [2, "alpha beta", true],
+        [3, "after", false],
+      ],
+    );
+    const request = {
+      path: root,
+      pattern: "alpha",
+      outputMode: "content" as const,
+      onlyMatching: true,
+      glob: "*.md",
+      headLimit: 0,
+    };
+    const expected = await javascript.searchText(request);
+    setRipgrepWorkerFactoryForTests(() => {
+      throw new Error("authored unavailable worker");
+    });
+    const fallback = await new NodeFileSystemAdapter().searchText(request);
+    assert.deepEqual(fallback.entries, expected.entries);
+    assert.deepEqual(new Set(fallback.files), new Set([first, second]));
+    const cancelled = new AbortController();
+    cancelled.abort();
+    await assert.rejects(
+      javascript.searchText(request, { signal: cancelled.signal }),
+      (error: unknown) => isFileSystemPortError(error) && error.code === "cancelled",
+    );
+  } finally {
+    setRipgrepWorkerFactoryForTests(undefined);
+    await rm(root, { recursive: true, force: true });
+  }
+});
diff --git a/apps/zcode-cli/packages/adapters/test/helpers/owned-mcp-fixture.ts b/apps/zcode-cli/packages/adapters/test/helpers/owned-mcp-fixture.ts
