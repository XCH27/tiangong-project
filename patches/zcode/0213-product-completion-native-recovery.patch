+import type { IServiceAccessor } from "@zcode/services";
+import type {
+  IPlatformService,
+  WhiteboardControlInput,
+  WhiteboardControlResult,
+  ZCodeTaskMeta,
+} from "@zcode/shared";
+import {
+  whiteboardControlResultSchema,
+  whiteboardRelativePath,
+  appSettingsSchema,
+} from "@zcode/shared";
+import {
+  commandAckSchema,
+  conversationSnapshotSchema,
+  conversationTopicWireFrameSchema,
+  V4_WIRE_PROTOCOL_VERSION,
+  type ConversationTopicWireCandidate,
+  type ConversationSnapshot,
+  type CommandEnvelope,
+} from "@zcode/shared/zcode-protocol-v4";
+
+const event = () => ({ dispose() {} });
+export function nativeWorkbenchFixture(
+  locale: "en-US" | "zh-CN",
+  tasks: ZCodeTaskMeta[] = [],
+  saveOutcome: "refused" | "completed" = "refused",
+  holdInitialFrame = false,
+) {
+  const frames = new Set<(frame: ConversationTopicWireCandidate) => void>();
+  const subscriptions = new Map<string, string>();
+  const initialFrames = new Map<string, () => void>();
+  const initialDelivered = new Set<string>();
+  const commands: CommandEnvelope[] = [];
+  const updates: WhiteboardControlInput[] = [];
+  let completedReceipt: Extract<WhiteboardControlResult, { status: "completed" }> | undefined;
+  const digest = async (text: string) =>
+    [...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text)))]
+      .map((byte) => byte.toString(16).padStart(2, "0"))
+      .join("");
+  let approved = false;
+  let resolveWrite: (() => void) | undefined;
+  let ordinal = 0;
+  const permissionSummary = "Authored native whiteboard approval";
+  const nativeSession = `native-${crypto.randomUUID()}`;
+  function snapshot(sessionId: string, approval: boolean, initial = false): ConversationSnapshot {
+    return conversationSnapshotSchema.parse({
+      protocolVersion: 1,
+      sessionId,
+      logEpoch: "authored",
+      seq: ++ordinal,
+      revision: ordinal,
+      control: {
+        phase: "completedSuccess",
+        sessionEnded: true,
+        canStop: false,
+        stopState: "idle",
+        stopTargetKind: "unknown",
+        steerable: false,
+        activeWorks: [],
+        lastError: null,
+        apiRetry: null,
+      },
+      availability: Object.fromEntries(
+        [
+          "fork",
+          "compact",
+          "switchModelConfig",
+          "setFollowupMode",
+          "queueEdit",
+          "sendQueuedNow",
+          "pauseGoal",
+          "resumeGoal",
+        ].map((key) => [key, { allowed: true }]),
+      ),
+      inputRouting: { mode: "startNow" },
+      config: {
+        provider: initial ? "" : "glm",
+        model: initial ? "" : "authored",
+        thought: "",
+        followupMode: "queue",
+      },
+      usage: {
+        contextWindow: null,
+        cumulative: { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 },
+      },
+      queue: { items: [], autoDrain: true },
+      pendingCommands: [],
+      backgroundWorks: [],
+      goal: null,
+      plan: null,
+      pendingInteractions: approval
+        ? [
+            {
+              interactionId: "authored-approval",
+              kind: "permission",
+              anchorRowId: null,
+              createdAt: 1,
+              payload: {
+                kind: "permission",
+                toolName: "UpdateWhiteboard",
+                toolCallId: "authored-save",
+                summary: permissionSummary,
+                detail: "Authored file write",
+                options: [
+                  { optionId: "allow", label: "Allow once", kind: "allowOnce" },
+                  { optionId: "deny", label: "Deny", kind: "deny" },
+                ],
+              },
+            },
+          ]
+        : [],
+      rows: { window: [], totalCount: 0, firstRowId: null },
+    });
+  }
+  function publish(sessionId: string, approval = false, initial = false) {
+    const subscriptionId = subscriptions.get(sessionId);
+    if (!subscriptionId) throw new Error(`Missing original subscription for ${sessionId}`);
+    const value = snapshot(sessionId, approval, initial);
+    const topic = `conversation/${sessionId}`;
+    const wire = conversationTopicWireFrameSchema.parse({
+      wireVersion: V4_WIRE_PROTOCOL_VERSION,
+      kind: "complete",
+      deliveryKind: initial ? "initial" : "online",
+      logicalFrameId: crypto.randomUUID(),
+      logicalFrameOrdinal: ordinal,
+      topic,
+      subscriptionId,
+      frame: {
+        topic,
+        subscriptionId,
+        fromSeq: 0,
+        toSeq: value.seq,
+        sentAt: 1,
+        payload: { kind: "snapshot", snapshot: value },
+      },
+    });
+    for (const listener of frames) listener(wire);
+    if (initial) initialDelivered.add(sessionId);
+  }
+  const supplied: Record<string, Record<string, unknown>> = {
+    settingService: {
+      get: async () => appSettingsSchema.parse({ locale }),
+      update: async () => {},
+    },
+    broadcastService: { send: async () => {}, onMessage: event },
+    modelSelectionService: {
+      getView: async () => ({ revision: 0, providers: [] }),
+      getPreferences: async () => ({ revision: "authored", favoriteModelSelections: [] }),
+      onDidChange: event,
+    },
+    clientConfigService: { getSnapshot: async () => ({ pluginStoreOrder: null }) },
+    clientScenesService: { list: async () => ({ code: 0, msg: "", data: [] }) },
+    fileService: { searchWorkspaceFiles: async () => [] },
+    pluginManagementService: {
+      getPluginReferenceCatalog: async () => ({ authority: "workspace", plugins: [] }),
+      listPlugins: async () => ({ plugins: [] }),
+    },
+    zcodeTaskService: {
+      list: async () => tasks,
+      listTasks: async () => tasks,
+      listArchivedTasks: async () => [],
+      listPinnedTasks: async () => [],
+      listPinnedTaskIds: async () => [],
+      listDeletedTaskIds: async () => [],
+      listGroupedTaskViewStructure: async () => ({ groups: [], members: [], topLevelOrders: [] }),
+    },
+    systemService: { info: async () => ({ platform: "darwin", arch: "arm64" }) },
+    subagentsService: { list: async () => [] },
+    offPeakTaskService: { list: async () => [] },
+    windowControllerService: { subscribeControllerV4: () => new Promise(() => {}) },
+    zcodeAgentService: {
+      helloConversationV4: async () => ({
+        kind: "hello",
+        protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+        connectionId: "authored",
+        clientMode: "desktop-continuous",
+        deliveryProfile: "continuous",
+        serverTime: Date.now(),
+        auth: {},
+        capabilities: {
+          nativeDialogs: false,
+          localTerminal: false,
+          binaryFrames: false,
+          compression: "none",
+          independentPlanState: true,
+        },
+      }),
+      initializeConversationV4: async () => {},
+      onDynamicConversationFrame:
+        () => (listener: (frame: ConversationTopicWireCandidate) => void) => {
+          frames.add(listener);
+          return {
+            dispose: () => {
+              frames.delete(listener);
+            },
+          };
+        },
+      onAgentRuntimeRestarted: event,
+      onAgentRuntimeLifecycle: event,
+      subscribeConversationV4: async ({ sessionId }: { sessionId: string }) => {
+        const subscriptionId = crypto.randomUUID();
+        subscriptions.set(sessionId, subscriptionId);
+        const initial = () => {
+          initialFrames.delete(sessionId);
+          publish(sessionId, false, true);
+        };
+        // The public response is ACK-only. The production-owned initial notification follows
+        // the response; only its original transport/store projection may unblock an actor.
+        if (holdInitialFrame) initialFrames.set(sessionId, initial);
+        else setTimeout(initial, 0);
+        return { ack: { subscriptionId, mode: "snapshot", logEpoch: "authored" } };
+      },
+      unsubscribeConversationV4: async () => {},
+      sendConversationCommandV4: async ({ envelope }: { envelope: CommandEnvelope }) => {
+        commands.push(envelope);
+        if (envelope.type === "stop") {
+          if (
+            envelope.sessionId !== nativeSession ||
+            !envelope.payload.expectedForegroundExecutionId?.startsWith("native-whiteboard:")
+          )
+            throw new Error("Stop targeted a different native Session/foreground identity");
+          // No actor has been dispatched while presentation waits for its initial frame.
+          return commandAckSchema.parse({
+            commandId: envelope.commandId,
+            status: "noop",
+            reasonCode: "guard.noForegroundWork",
+            revisionAtDecision: ordinal,
+          });
+        }
+        if (envelope.type === "resolveInteraction") {
+          if (
+            envelope.sessionId !== nativeSession ||
+            envelope.payload.interactionId !== "authored-approval" ||
+            envelope.payload.answer.optionId !== "allow"
+          )
+            throw new Error("Approval used a different original Session/interaction/option");
+          approved = true;
+          setTimeout(() => publish(nativeSession), 0);
+          return commandAckSchema.parse({
+            commandId: envelope.commandId,
+            status: "accepted",
+            revisionAtDecision: ordinal,
+          });
+        }
+        if (envelope.type !== "createSession")
+          throw new Error(`Unplanned command ${envelope.type}`);
+        if (envelope.payload.firstInput) throw new Error("Native Save started model inference");
+        return commandAckSchema.parse({
+          commandId: envelope.commandId,
+          status: "accepted",
+          revisionAtDecision: 0,
+          result: { type: "createSession", sessionId: nativeSession },
+        });
+      },
+      performWhiteboardControl: async ({
+        command,
+        sessionId,
+      }: {
+        command: WhiteboardControlInput;
+        sessionId: string;
+      }) => {
+        if (!initialDelivered.has(sessionId))
+          throw new Error("Native actor dispatched before its initial projection");
+        if (command.operation !== "update")
+          throw new Error("Unexpected authored read mutation path");
+        updates.push(structuredClone(command));
+        await new Promise<void>((resolve) => {
+          resolveWrite = resolve;
+        });
+        if (saveOutcome === "refused")
+          return { status: "failed", message: "Authored denial", effectStatus: "not_confirmed" };
+        if (!approved)
+          throw new Error("Completed receipt requires the original UI approval response");
+        // This authored ACK contains the exact admitted normalized drawing/mutation. It proves
+        // renderer settlement, not actual filesystem/SQLite publication (covered by Host tests).
+        const document = {
+          schemaVersion: 1 as const,
+          revision: 1,
+          mutationId: command.input.mutationId,
+          mutationDigest: await digest(JSON.stringify(command.input.document)),
+          board: structuredClone(command.input.document),
+        };
+        const bytes = JSON.stringify(document, null, 2) + "\n";
+        const receipt = whiteboardControlResultSchema.parse({
+          status: "completed",
+          document,
+          filePath: whiteboardRelativePath(document.board.id),
+          fileRevision: {
+            id: "authored-committed-revision",
+            hash: `sha256:${await digest(bytes)}`,
+            sizeBytes: new TextEncoder().encode(bytes).byteLength,
+          },
+        });
+        if (receipt.status !== "completed")
+          throw new Error("Authored completion validation failed");
+        completedReceipt = receipt;
+        return structuredClone(receipt);
+      },
+      readWhiteboardProjection: async ({
+        input,
+      }: {
+        input: { boardId?: string; list?: boolean };
+      }) => {
+        if (input.boardId && completedReceipt) return structuredClone(completedReceipt);
+        return { status: "listed", items: [], errors: [], truncated: false };
+      },
+      getSkillReferenceCatalog: async () => ({ authority: "workspace", skills: [] }),
+      listSessions: async () => [],
+    },
+  };
+  const cache = new Map<string, object>();
+  const services = new Proxy(
+    {},
+    {
+      get(_target, key: string | symbol) {
+        if (typeof key !== "string") return undefined;
+        if (!cache.has(key)) {
+          const methods = new Map<string, unknown>();
+          cache.set(
+            key,
+            new Proxy(supplied[key] ?? {}, {
+              get(target, method: string | symbol) {
+                if (typeof method !== "string") return Reflect.get(target, method);
+                if (method in target) return target[method];
+                if (!methods.has(method))
+                  methods.set(
+                    method,
+                    method.startsWith("onDynamic")
+                      ? () => event
+                      : method.startsWith("on")
+                        ? event
+                        : async () => {
+                            throw new Error(`Authored unavailable ${key}.${method}`);
+                          },
+                  );
+                return methods.get(method);
+              },
+            }),
+          );
+        }
+        return cache.get(key);
+      },
+    },
+  ) as IServiceAccessor;
+  let closeListener:
+    | Parameters<NonNullable<IPlatformService["onNativeWhiteboardCloseRequest"]>>[0]
+    | undefined;
+  const closeReplies: Array<
+    Parameters<NonNullable<IPlatformService["completeNativeWhiteboardClose"]>>[0]
+  > = [];
+  const platform = {
+    onWindowFullscreenChanged: () => () => {},
+    onRemoteConnectionLog: () => () => {},
+    getInstalledEditors: async () => [],
+    canOpenCommunity: async () => false,
+    onNativeWhiteboardCloseRequest(listener: NonNullable<typeof closeListener>) {
+      closeListener = listener;
+      return {
+        dispose() {
+          if (closeListener === listener) closeListener = undefined;
+        },
+      };
+    },
+    async completeNativeWhiteboardClose(reply: (typeof closeReplies)[number]) {
+      closeReplies.push(reply);
+    },
+    publishNativeWhiteboardDraftState() {},
+  } as unknown as IPlatformService;
+  return {
+    services,
+    platform,
+    commands,
+    updates,
+    nativeSession,
+    publish,
+    permissionSummary,
+    closeReplies,
+    requestWindowClose(requestId: string) {
+      if (!closeListener) throw new Error("Original window close listener was not installed");
+      closeListener({ requestId });
+    },
+    releaseInitialFrame(sessionId: string) {
+      const initial = initialFrames.get(sessionId);
+      if (!initial) throw new Error("No owned initial notification to release");
+      initial();
+    },
+    get completedReceipt() {
+      return completedReceipt;
+    },
+    releaseWrite: () => resolveWrite?.(),
+  };
+}
