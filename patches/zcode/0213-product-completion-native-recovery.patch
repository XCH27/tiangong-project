new file mode 100644
index 00000000..650ae208
--- /dev/null
+++ b/packages/desktop/src/main/nativeWhiteboardCloseIpc.ts
@@ -0,0 +1,30 @@
+import { BrowserWindow, ipcMain } from "electron";
+import { PlatformChannels, nativeWhiteboardDraftStateSchema, nativeWhiteboardCloseResponseSchema } from "@zcode/shared";
+import type { NativeWhiteboardCloseBroker } from "./nativeWhiteboardClose.js";
+
+/** IPC accepts facts only from the original application renderer, never a browser guest. */
+export function registerNativeWhiteboardCloseIpc(
+  broker: NativeWhiteboardCloseBroker, isApplicationRenderer: (webContentsId: number) => boolean,
+): void {
+  ipcMain.handle(PlatformChannels.NativeWhiteboardDraftState, (event, raw: unknown) => {
+    const input = nativeWhiteboardDraftStateSchema.parse(raw);
+    const win = BrowserWindow.fromWebContents(event.sender);
+    if (!win || !isApplicationRenderer(event.sender.id)) throw new Error("Native draft facts require the owning application renderer");
+    const contents = event.sender;
+    const first = !broker.hasRenderer(contents.id);
+    broker.register(contents.id, { alive: () => !win.isDestroyed() && !contents.isDestroyed(),
+      send: request => {
+        if (request.phase === "request" && input.dirty) {
+          if (win.isMinimized()) win.restore();
+          win.show(); win.focus();
+        }
+        contents.send(PlatformChannels.NativeWhiteboardCloseRequest, request);
+      } }, input.dirty);
+    if (first) contents.once("destroyed", () => broker.forget(contents.id));
+  });
+  ipcMain.handle(PlatformChannels.NativeWhiteboardCloseResponse, (event, raw: unknown) => {
+    const input = nativeWhiteboardCloseResponseSchema.parse(raw);
+    if (!isApplicationRenderer(event.sender.id)) throw new Error("Native close reply requires the owning application renderer");
+    broker.complete(event.sender.id, input.requestId, input.allowClose);
+  });
+}
