@@ -0,0 +1,50 @@
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import type { McpServerConfig } from "@zcode/contracts";
+import { createMcpAdapter } from "../../src/mcp/index.js";
+
+/** SDK-only fixture: no background Runtime startup competes for the connection under test. */
+export async function ownedMcpFixture() {
+  const dir = await mkdtemp(join(tmpdir(), "owned-mcp-async-"));
+  const mcp = createMcpAdapter({ env: {} });
+  const config = (name: string): McpServerConfig => ({
+    type: "stdio",
+    command: process.execPath,
+    args: [
+      resolve(
+        import.meta.dirname,
+        "../../../bootstrap/test/fixtures/plugin-view/native-control-server.mjs",
+      ),
+    ],
+    protocolVersion: "legacy",
+    env: { ZCODE_PLUGIN_DATA: join(dir, name) },
+  });
+  const original = config("counter");
+  const read = async (name: string, file: string) => {
+    try {
+      return await readFile(join(dir, name, file), "utf8");
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return "";
+      throw error;
+    }
+  };
+  return {
+    f: { dir },
+    mcp,
+    original,
+    config,
+    async effectCalls() {
+      const value = await read("counter", "effects.ndjson");
+      return value.trim() ? value.trim().split("\n").length : 0;
+    },
+    async count(name = "counter") {
+      const value = await read(name, "counter.json");
+      return value ? (JSON.parse(value).value as number) : 0;
+    },
+    async close() {
+      await mcp.close();
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
