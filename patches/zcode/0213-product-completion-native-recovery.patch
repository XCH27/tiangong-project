index 00000000..b86c367b
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/native-whiteboard-projection.ts
@@ -0,0 +1,123 @@
+import { isAbsolute } from "node:path";
+import { createRootTraceContext, type SessionId } from "@zcode/contracts";
+import { listWhiteboardFiles, readWhiteboardFile, type WhiteboardReadContext } from "@zcode/core";
+import {
+  parseRemoteWorkspaceIdentity,
+  whiteboardControlResultSchema,
+  whiteboardProjectionParamsSchema,
+  type WhiteboardControlResult,
+  type ZCodeWorkspaceRef,
+} from "@zcode/shared";
+import {
+  parseParams,
+  ProtocolRequestError,
+  type ZCodeProtocolAgentServerContext,
+} from "./server-types.js";
+import { buildWorkspaceRef } from "./workspace.js";
+
+function assertWorkspaceScope(stored: ZCodeWorkspaceRef, requested: ZCodeWorkspaceRef) {
+  if (
+    !isAbsolute(stored.workspacePath) ||
+    stored.workspaceKey !== (stored.workspaceIdentity ?? stored.workspacePath)
+  )
+    throw new ProtocolRequestError(-32602, "Native whiteboard Session workspace is invalid");
+  if (stored.workspaceIdentity?.startsWith("remote:")) {
+    const remote = parseRemoteWorkspaceIdentity(stored.workspaceIdentity);
+    if (!remote || remote.workspacePath !== stored.workspacePath)
+      throw new ProtocolRequestError(
+        -32602,
+        "Native whiteboard Session remote workspace is invalid",
+      );
+  }
+  if (
+    stored.workspacePath !== requested.workspacePath ||
+    stored.workspaceKey !== requested.workspaceKey ||
+    stored.workspaceIdentity !== requested.workspaceIdentity
+  )
+    throw new ProtocolRequestError(
+      -32602,
+      "Native whiteboard target does not belong to this Session workspace",
+    );
+}
+
+/** Inspect original files without activating a runtime or repairing/writing Session history. */
+export async function readNativeWhiteboardProjection(
+  context: ZCodeProtocolAgentServerContext,
+  raw: unknown,
+): Promise<WhiteboardControlResult> {
+  const params = parseParams(whiteboardProjectionParamsSchema, raw);
+  context.assertServing?.();
+  const active = context.sessions.get(params.sessionId);
+  const session = await context.deps.sessionStore?.getSession(params.sessionId as SessionId);
+  if ((!active && !session) || session?.time.archived !== undefined)
+    throw new ProtocolRequestError(-32602, "Native whiteboard Session is unavailable");
+  // An original deferred Session may be active before its first mutation persists it.
+  // Viewing must not persist that Session merely to establish a read scope.
+  const persisted = session
+    ? buildWorkspaceRef({
+        workspaceIdentity: session.workspaceID,
+        workspacePath: session.path ?? session.directory,
+      })
+    : active!.workspace;
+  if (
+    session &&
+    (!isAbsolute(session.directory) ||
+      (session.workspaceID?.startsWith("remote:") && session.directory !== persisted.workspacePath))
+  )
+    throw new ProtocolRequestError(-32602, "Native whiteboard stored Session workspace is invalid");
+  assertWorkspaceScope(persisted, params.workspace);
+  if (
+    !active &&
+    params.workspace.remoteSessionId &&
+    !persisted.workspaceIdentity?.startsWith("remote:")
+  )
+    throw new ProtocolRequestError(
+      -32602,
+      "Native whiteboard local Session has no remote attachment",
+    );
+  if (active) {
+    assertWorkspaceScope(active.workspace, params.workspace);
+    if (active.workspace.remoteSessionId !== params.workspace.remoteSessionId)
+      throw new ProtocolRequestError(-32602, "Native whiteboard target attachment changed");
+  }
+  // Cold attachments are authenticated by the existing outer Host service. SessionInfo has
+  // no attachment identity; a caller-provided remoteSessionId must never become a stored owner.
+  const port = active ? active.app.nativeWhiteboardReadPort : context.deps.nativeWhiteboardReadPort;
+  if (!port) return { status: "rejected", reason: "unavailable" };
+  context.assertServing?.();
+  const trace =
+    active?.traceContext ??
+    createRootTraceContext({
+      ...(session?.traceID ? { traceId: session.traceID } : {}),
+      sessionId: params.sessionId as SessionId,
+    });
+  const readContext: WhiteboardReadContext = {
+    workspaceRoot: persisted.workspacePath,
+    fileSystemPort: port,
+    traceId: trace.traceId,
+    spanId: trace.spanId,
+    sessionId: params.sessionId as SessionId,
+    abortSignal: new AbortController().signal,
+  };
+  try {
+    if ("list" in params.input) {
+      const listed = await listWhiteboardFiles(readContext);
+      context.assertServing?.();
+      return whiteboardControlResultSchema.parse({ status: "listed", ...listed });
+    }
+    const read = await readWhiteboardFile(params.input.boardId, readContext);
+    context.assertServing?.();
+    return whiteboardControlResultSchema.parse({
+      status: "completed",
+      document: read.document,
+      fileRevision: read.fileRevision,
+      filePath: read.relativePath,
+    });
+  } catch (error) {
+    return {
+      status: "failed",
+      effectStatus: "not_confirmed",
+      message: error instanceof Error ? error.message : String(error),
+    };
+  }
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/native-whiteboard.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/native-whiteboard.ts
new file mode 100644
