+import assert from "node:assert/strict";
+import test from "node:test";
+import { SESSION_ENTRY_MODEL_SELECTION } from "@zcode/contracts";
+import { appModelFixture, request } from "./helpers/app-model-completion-fixture.js";
+
+test("actual App Decide completes auxiliary selection before strict factory and preserves user model", async () => {
+  const f = await appModelFixture();
+  try {
+    const app = await f.create();
+    const offered = {
+      providerId: f.providerId,
+      modelId: "standard",
+      options: { reasoningLevel: "high" },
+    };
+    f.steps([
+      {
+        text: "",
+        finishReason: "tool-calls",
+        toolCalls: [{ id: "decision-call", name: "Decide", input: request }],
+      },
+      { text: "done", finishReason: "stop" },
+    ]);
+    await app.runtime.executeTurn("Authored decision request", [], {
+      intent: { modelSelection: offered },
+    });
+    assert.equal(f.permissions, 1);
+    const decision = f.calls.filter((call) => call.modelId === "decision");
+    assert.equal(decision.length, 1);
+    assert.equal(decision[0].options.reasoningLevel, "off");
+    assert.deepEqual(app.runtime.getSessionModelSelection(), offered);
+    const store = (app.runtime as any).sessionStore;
+    const messages = await store.messages({ sessionID: app.sessionId });
+    const part = messages
+      .flatMap((message: any) => message.parts)
+      .find((part: any) => part.type === "tool" && part.callID === "decision-call");
+    assert.equal(part.state.status, "completed");
+    assert.match(part.state.output, /completed/);
+    const entry = (
+      await store.sessionEntries({
+        sessionID: app.sessionId,
+        type: SESSION_ENTRY_MODEL_SELECTION,
+      })
+    ).at(-1);
+    assert.deepEqual(entry.data, offered);
+    assert.equal(f.httpCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
