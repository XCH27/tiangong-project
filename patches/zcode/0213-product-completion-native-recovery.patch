+test("public projection retains original prototype order, function ABI, descriptors and sole instance fields", () => {
+  assert.deepEqual(Object.keys(projectionModule), ["ProductProjection"]);
+  const prototype = ProductProjection.prototype;
+  assert.deepEqual(
+    Object.getOwnPropertyNames(prototype),
+    originalMethods.map(([name]) => name),
+  );
+  for (const [name, length] of originalMethods) {
+    const descriptor = Object.getOwnPropertyDescriptor(prototype, name)!;
+    assert.equal(descriptor.value.name, name === "constructor" ? "ProductProjection" : name);
+    assert.equal(descriptor.value.length, length);
+    assert.equal(descriptor.enumerable, false);
+    assert.equal(descriptor.writable, true);
+    assert.equal(descriptor.configurable, true);
+    assert.equal(descriptor.get, undefined);
+    assert.equal(descriptor.set, undefined);
+  }
+  const projection = new ProductProjection("owner-session", "owner-epoch");
+  assert.deepEqual(Object.getOwnPropertyNames(projection), originalFields);
+  assert.equal(Object.getPrototypeOf(projection), prototype);
+  assert.equal(projection.constructor, ProductProjection);
+  assert.ok(projection instanceof ProductProjection);
+});
+test("atomic rejection preserves original owner and snapshot; original clone shares its class prototype", () => {
+  const projection = new ProductProjection("owner-session", "owner-epoch");
+  const initial = projection.getSnapshot();
+  const started = event(SessionEventType.TurnStarted, { input: "authored local request" });
+  const rejected = projection.applyEventAtomically(started, () => false);
+  assert.equal(projection.getSnapshot(), initial);
+  assert.equal(rejected, null);
+  projection.applyEventAtomically(started, () => true);
+  assert.notEqual(projection.getSnapshot(), initial);
+  assert.ok(projection.getSnapshot().rows.window.some((row) => row.kind === "userInput"));
+  const clone = (
+    projection as unknown as { cloneProjection(): InstanceType<typeof ProductProjection> }
+  ).cloneProjection();
+  assert.equal(Object.getPrototypeOf(clone), ProductProjection.prototype);
+  assert.ok(clone instanceof ProductProjection);
+  assert.equal(clone.getSnapshot(), projection.getSnapshot());
+});
+test("extracted reducers retain virtual dispatch and the original candidate receiver", () => {
+  const prototype = ProductProjection.prototype;
+  const descriptor = Object.getOwnPropertyDescriptor(prototype, "onSessionTitleUpdated")!;
+  const receivers: unknown[] = [];
+  try {
+    Object.defineProperty(prototype, "onSessionTitleUpdated", {
+      ...descriptor,
+      value: function onSessionTitleUpdated(this: unknown, received: SessionEvent) {
+        receivers.push(this);
+        return descriptor.value.call(this, received);
+      },
+    });
+    const projection = new ProductProjection("owner-session", "owner-epoch");
+    projection.applyEventAtomically(
+      event(SessionEventType.SessionTitleUpdated, { title: "original owner" }),
+      () => true,
+    );
+    assert.equal(receivers.length, 1);
+    assert.equal(Object.getPrototypeOf(receivers[0]), prototype);
+    assert.notEqual(receivers[0], projection);
+    assert.equal(projection.getSnapshot().meta.title, "original owner");
+  } finally {
+    Object.defineProperty(prototype, "onSessionTitleUpdated", descriptor);
+  }
+});
