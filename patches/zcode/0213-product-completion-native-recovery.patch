@@ -0,0 +1,86 @@
+// Same adapter owner; extracted pi-subscription-result responsibility.
+import { type SubscriptionReplayScope } from "./pi-transcript.js";
+import type { AssistantMessage, Usage } from "@earendil-works/pi-ai";
+import { type ModelTextResult, type ModelUsage } from "@zcode/contracts";
+
+/** The public plan route requires explicit history and namespaced, client-executed tools. */
+export function chatgptPlanPayload(value: Record<string, unknown>): Record<string, unknown> {
+  const payload: Record<string, unknown> = { ...value, store: false, stream: true };
+  for (const key of [
+    "background",
+    "conversation",
+    "max_output_tokens",
+    "max_tool_calls",
+    "metadata",
+    "moderation",
+    "multi_agent",
+    "prompt",
+    "prompt_cache_retention",
+    "prompt_cache_options",
+    "safety_identifier",
+    "temperature",
+    "top_logprobs",
+    "top_p",
+    "truncation",
+    "user",
+    "previous_response_id",
+  ])
+    delete (payload as Record<string, unknown>)[key];
+  if (Array.isArray(payload.input))
+    payload.input = payload.input.map((item) => {
+      if (item.role === "system") return { ...item, role: "developer" };
+      if (item.type === "function_call" || item.type === "custom_tool_call")
+        return { ...item, namespace: "fleet" };
+      return item;
+    });
+  if (Array.isArray(payload.tools) && payload.tools.length) {
+    if (payload.tools.some((entry) => !["function", "custom"].includes(entry.type)))
+      throw new Error("This tool is unavailable through ChatGPT token sharing");
+    payload.tools = [
+      { type: "namespace", name: "fleet", description: "Fleet local tools", tools: payload.tools },
+    ];
+  }
+  return payload;
+}
+
+export function finishReason(message: AssistantMessage) {
+  return message.stopReason === "toolUse" ? "tool-calls" : message.stopReason;
+}
+
+export function toUsage(usage: Usage): ModelUsage {
+  // Pi reports uncached input separately; Fleet's context ring expects total input exactly once.
+  const inputTokens = usage.input + usage.cacheRead + usage.cacheWrite;
+  return {
+    inputTokens,
+    outputTokens: usage.output,
+    totalTokens: inputTokens + usage.output,
+    cacheReadTokens: usage.cacheRead,
+    cacheWriteTokens: usage.cacheWrite,
+  };
+}
+
+export function toResult(
+  message: AssistantMessage,
+  scope: SubscriptionReplayScope,
+): ModelTextResult {
+  return {
+    text: message.content
+      .filter((block) => block.type === "text")
+      .map((block) => block.text)
+      .join(""),
+    finishReason: finishReason(message),
+    usage: toUsage(message.usage),
+    reasoning: message.content
+      .filter((block) => block.type === "thinking")
+      .map((block) => ({
+        type: "reasoning",
+        text: block.thinking,
+        providerOptions: {
+          pi: { signature: block.thinkingSignature, redacted: block.redacted, scope },
+        },
+      })),
+    toolCalls: message.content
+      .filter((block) => block.type === "toolCall")
+      .map((block) => ({ id: block.id, name: block.name, input: block.arguments })),
+  };
+}
