+    await f.service.setPluginEnabled({
+      workspacePath: f.workspace,
+      pluginId: id,
+      enabled: true,
+      scope: "workspace",
+    });
+    await f.service.configurePlugin({
+      workspacePath: f.workspace,
+      pluginId: id,
+      options: { tone: "project" },
+      scope: "workspace",
+    });
+    plugin = (await app.listPlugins()).plugins.find((entry) => entry.id === id)!;
+    assert.equal(plugin.enabled, true);
+    assert.equal(plugin.configuredOptions?.tone, "project");
+    // A CLI user-layer write must leave the existing Project override and both saved options intact.
+    await app.setPluginEnabled(id, false);
+    assert.equal((await app.listPlugins()).plugins.find((entry) => entry.id === id)?.enabled, true);
+    await f.service.resetPluginConfig({
+      workspacePath: f.workspace,
+      pluginId: id,
+      scope: "workspace",
