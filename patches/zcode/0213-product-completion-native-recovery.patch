diff --git a/packages/desktop/scripts/production-build-isolation.test.mjs b/packages/desktop/scripts/production-build-isolation.test.mjs
new file mode 100644
index 00000000..cd8abe5c
--- /dev/null
+++ b/packages/desktop/scripts/production-build-isolation.test.mjs
@@ -0,0 +1,46 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, readFile, rm, writeFile, copyFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { cleanDesktopProductionOutput } from "./run-production-build.mjs";
+
+test("production rebuild removes stale scheduler source and ready marker while retaining compiler state", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-desktop-clean-"));
+  try {
+    await mkdir(join(root, "out/scheduler"), { recursive: true });
+    await mkdir(join(root, ".typecheck"));
+    await writeFile(join(root, "out/scheduler/old-readable-source.js"), "OLD");
+    await writeFile(join(root, "out/.scheduler-build-ready"), "OLD");
+    await writeFile(join(root, ".typecheck/preload.tsbuildinfo"), "owned compiler state");
+    await cleanDesktopProductionOutput({ cwd: root });
+    await assert.rejects(readFile(join(root, "out/scheduler/old-readable-source.js")), { code: "ENOENT" });
+    await assert.rejects(readFile(join(root, "out/.scheduler-build-ready")), { code: "ENOENT" });
+    assert.equal(await readFile(join(root, ".typecheck/preload.tsbuildinfo"), "utf8"), "owned compiler state");
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("malformed persisted build metadata cannot become the About or packaged identity", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-desktop-metadata-"));
+  try {
+    const scripts = join(root, "packages/desktop/scripts");
+    await mkdir(scripts, { recursive: true });
+    await mkdir(join(root, "packages/desktop/out/metadata"), { recursive: true });
+    await writeFile(join(root, "package.json"), JSON.stringify({ name: "fixture", version: "3.14.3" }));
+    await writeFile(join(root, "packages/desktop/package.json"), JSON.stringify({
+      name: "@zcode/desktop", devDependencies: { "electron-builder": "26.8.1" },
+    }));
+    const path = join(root, "packages/desktop/out/metadata/build-meta.json");
+    await copyFile(new URL("./build-metadata.mjs", import.meta.url), join(scripts, "build-metadata.mjs"));
+    const producer = await import(pathToFileURL(join(scripts, "build-metadata.mjs")).href);
+    for (const invalid of [null, { appVersion: 42 }, { appVersion: "OLD", buildTime: "stale" }]) {
+      await writeFile(path, JSON.stringify(invalid));
+      assert.equal(producer.readBuildMetadata(), null);
+      assert.equal(producer.getBuildMetadata().appVersion, "3.14.3");
+    }
+    const actual = producer.writeBuildMetadata();
+    assert.deepEqual(producer.readBuildMetadata(), actual);
+    assert.equal(actual.appVersion, "3.14.3");
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
