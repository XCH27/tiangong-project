+import { resolvePluginViewTarget } from "../../src/zcode-protocol/plugin-views.js";
+import type { ZCodeProtocolAgentServerContext } from "../../src/zcode-protocol/server-types.js";
+
+/** TEST ONLY: retain original SDK/pool ownership races independently of the admitted Host wire. */
+export async function callOwnedPluginToolForAdapterTest(
+  context: ZCodeProtocolAgentServerContext,
+  params: {
+    workspace: { workspacePath: string; workspaceKey?: string; workspaceIdentity?: string };
+    pluginId: string;
+    viewId: string;
+    tool: string;
+    arguments?: Record<string, unknown>;
+  },
+) {
+  const target = resolvePluginViewTarget(context, params.workspace, params.pluginId, params.viewId);
+  const port = context.deps.mcpPort;
+  if (!port) throw new Error("The authored adapter fixture requires its original MCP port");
+  const status = await port.connectServer(target.serverName, target.config, {
+    workingDirectory: params.workspace.workspacePath,
+  });
+  if (status.status !== "connected")
+    throw new Error(status.error ?? "Authored adapter connection failed");
+  return port.callTool(
+    {
+      serverName: target.serverName,
+      toolName: params.tool,
+      arguments: params.arguments ?? {},
+      workspacePath: params.workspace.workspacePath,
+      ...(params.workspace.workspaceIdentity
+        ? { workspaceIdentity: params.workspace.workspaceIdentity }
+        : {}),
+    },
+    { expectedServerConfig: target.config },
+  );
+}
