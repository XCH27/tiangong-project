+
+test("native boundary refuses outside destinations before creating directories", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-boundary-"));
+  try {
+    const workspace = join(root, "workspace");
+    await mkdir(workspace);
+    const path = join(root, "outside", "nested", "board.json");
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path,
+        boundaryRoot: workspace,
+        content: "authored",
+        createParents: true,
+        expectedAbsent: true,
+      }),
+      (error: { code?: string }) => error.code === "permission_denied",
+    );
+    assert.deepEqual(await readdir(root), ["workspace"]);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("native create-only never overwrites an already committed document", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-create-"));
+  try {
+    const path = join(root, "board.json");
+    await writeFile(path, "committed");
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path,
+        boundaryRoot: root,
+        content: "replacement",
+        expectedAbsent: true,
+      }),
+      (error: { code?: string }) => error.code === "stale_write",
+    );
+    assert.equal(await readFile(path, "utf8"), "committed");
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
