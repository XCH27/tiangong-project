index 00000000..1f3d7748
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/stream-attempt-owner.test.ts
@@ -0,0 +1,319 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { AiSdkModelAdapter } from "../src/model/index.js";
+import { runWithModelInvocationContext } from "@zcode/contracts";
+import type { ModelEvent, ModelRequestAdmission, ModelStatusSink } from "@zcode/contracts";
+import {
+  createRegistryModelConfig,
+  createRegistryProviderConfig,
+  ModelConfig,
+  parseProviderConfig,
+} from "@zcode/provider";
+
+function gate<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+function fixture(streamText: (input: { abortSignal?: AbortSignal }) => unknown) {
+  let active = 0,
+    peak = 0,
+    releases = 0,
+    acquires = 0;
+  const statuses: Array<Parameters<ModelStatusSink["publish"]>[0]> = [];
+  const admission: ModelRequestAdmission = {
+    tryAcquire() {
+      assert.equal(active, 0, "a successor must not overlap the original admission lease");
+      active++;
+      acquires++;
+      peak = Math.max(peak, active);
+      return {
+        publish() {},
+        release() {
+          active--;
+          releases++;
+        },
+      };
+    },
+    async acquire() {
+      throw new Error("unexpected queued admission");
+    },
+  };
+  const provider = createRegistryProviderConfig(
+    parseProviderConfig({
+      group: "standard-personal",
+      access: { type: "api-key", apiKey: "owned-synthetic-key" },
+      api: { type: "openai-chat-completions", baseUrl: "https://never-dispatched.invalid/v1" },
+    }),
+  );
+  const config = createRegistryModelConfig(
+    ModelConfig.fromData({
+      enabled: true,
+      properties: {
+        requiresMfjsToolSchema: false,
+        contextWindow: 8192,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: false,
+          supportsVideo: false,
+          supportsAudio: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: false,
+      },
+      optionSpecs: {
+        reasoningLevel: { values: ["auto"], map: "{}" },
+        maxOutputTokens: { max: 4096, map: '{"max_tokens": maxOutputTokens}' },
+      },
+    }),
+  );
+  assert.ok(provider.ok);
+  assert.ok(config.ok, JSON.stringify(config));
+  const adapter = new AiSdkModelAdapter({
+    env: {},
+    retry: { maxAttempts: 2, baseDelayMs: 0, jitter: false },
+    transport: async () => {
+      throw new Error("network forbidden in owned fixture");
+    },
+    statusSink: {
+      publish(event) {
+        statuses.push(event);
+      },
+    },
+    runtime: {
+      generateText: async () => {
+        throw new Error("no model generation");
+      },
+      streamText: streamText as never,
+    },
+  });
+  const model = adapter.createModel({
+    providerId: "owned",
+    modelId: "owned",
+    providerConfig: provider.config,
+    modelConfig: config.config,
+  });
+  return {
+    statuses,
+    counts: () => ({ active, peak, releases, acquires }),
+    run: <T>(work: () => Promise<T>) =>
+      runWithModelInvocationContext(
+        { modelRequestAdmission: admission, preserveProviderStreamBoundaries: true },
+        work,
+      ),
+    stream: (signal?: AbortSignal) =>
+      model
+        .streamText({
+          messages: [{ role: "user", content: "owned fixture" }],
+          options: { reasoningLevel: "auto", maxOutputTokens: 32 },
+          abortSignal: signal,
+        })
+        [Symbol.asyncIterator](),
+  };
+}
+
+async function nextText(iterator: AsyncIterator<ModelEvent>) {
+  for (let count = 0; count < 8; count++) {
+    const next = await iterator.next();
+    if (next.done || next.value.type === "text_delta") return next;
+  }
+  throw new Error("text was not reached within the owned fixture");
+}
+
+test(
+  "public Model consumer return aborts the original physical stream and releases one lease",
+  { timeout: 3000 },
+  async () => {
+    let physicalSignal: AbortSignal | undefined;
+    let closes = 0;
+    const f = fixture((input) => {
+      physicalSignal = input.abortSignal;
+      let step = 0;
+      const iterator = {
+        async next() {
+          return {
+            done: false,
+            value:
+              step++ === 0
+                ? { type: "text-start", id: "one" }
+                : { type: "text-delta", id: "one", text: "owned" },
+          };
+        },
+        async return() {
+          closes++;
+          return { done: true, value: undefined };
+        },
+      };
+      return { stream: { [Symbol.asyncIterator]: () => iterator } };
+    });
+    await f.run(async () => {
+      const iterator = f.stream();
+      assert.equal((await nextText(iterator)).done, false);
+      await iterator.return?.();
+      await new Promise((resolve) => setImmediate(resolve));
+      assert.equal(physicalSignal?.aborted, true);
+      assert.equal(closes, 1);
+      assert.deepEqual(f.counts(), { active: 0, peak: 1, releases: 1, acquires: 1 });
+      assert.equal(
+        f.statuses.findLast((event) => event.type === "model_request_failed")?.errorCode,
+        "model_request_cancelled",
+      );
+      assert.equal(
+        f.statuses.some((event) => event.type === "model_request_completed"),
+        false,
+      );
+    });
+  },
+);
+
+test(
+  "public Model consumer throw aborts the original physical stream and releases one lease",
+  { timeout: 3000 },
+  async () => {
+    let physicalSignal: AbortSignal | undefined;
+    let closes = 0;
+    const f = fixture((input) => {
+      physicalSignal = input.abortSignal;
+      let step = 0;
+      const iterator = {
+        async next() {
+          return {
+            done: false,
+            value:
+              step++ === 0
+                ? { type: "text-start", id: "one" }
+                : { type: "text-delta", id: "one", text: "owned" },
+          };
+        },
+        async return() {
+          closes++;
+          return { done: true, value: undefined };
+        },
+      };
+      return { stream: { [Symbol.asyncIterator]: () => iterator } };
+    });
+    await f.run(async () => {
+      const iterator = f.stream();
+      assert.equal((await nextText(iterator)).done, false);
+      const reason = new Error("owned consumer failure");
+      await assert.rejects(iterator.throw!(reason), (error) => error === reason);
+      await new Promise((resolve) => setImmediate(resolve));
+      assert.equal(physicalSignal?.aborted, true);
+      assert.equal(closes, 1);
+      assert.deepEqual(f.counts(), { active: 0, peak: 1, releases: 1, acquires: 1 });
+      assert.equal(
+        f.statuses.findLast((event) => event.type === "model_request_failed")?.errorCode,
+        "model_request_cancelled",
+      );
+      assert.equal(
+        f.statuses.some((event) => event.type === "model_request_completed"),
+        false,
+      );
+    });
+  },
+);
+
+test(
+  "public Model retry awaits the original iterator cleanup before creating its successor",
+  { timeout: 3000 },
+  async () => {
+    const closing = gate<void>(),
+      closed = gate<void>();
+    let calls = 0;
+    const signals: Array<AbortSignal | undefined> = [];
+    const f = fixture((input) => {
+      signals.push(input.abortSignal);
+      const attempt = ++calls;
+      let step = 0;
+      const iterator = {
+        async next() {
+          if (attempt === 1)
+            throw Object.assign(new Error("Service unavailable"), { statusCode: 503 });
+          return {
+            done: false,
+            value:
+              step++ === 0
+                ? { type: "text-start", id: "two" }
+                : { type: "text-delta", id: "two", text: "recovered" },
+          };
+        },
+        async return() {
+          if (attempt === 1) {
+            closing.resolve();
+            await closed.promise;
+          }
+          return { done: true, value: undefined };
+        },
+      };
+      return { stream: { [Symbol.asyncIterator]: () => iterator } };
+    });
+    await f.run(async () => {
+      const iterator = f.stream(),
+        pending = nextText(iterator);
+      await closing.promise;
+      assert.equal(calls, 1);
+      assert.equal(signals[0]?.aborted, true);
+      assert.equal(f.counts().active, 0);
+      closed.resolve();
+      assert.equal((await pending).done, false);
+      assert.equal(calls, 2);
+      await iterator.return?.();
+      await new Promise((resolve) => setImmediate(resolve));
+      assert.deepEqual(f.counts(), { active: 0, peak: 1, releases: 2, acquires: 2 });
+      assert.equal(f.statuses.filter((event) => event.type === "model_retry_scheduled").length, 1);
+    });
+  },
+);
+
+test(
+  "public Model Stop discards a late provider event without retry or an extra release",
+  { timeout: 3000 },
+  async () => {
+    const reading = gate<void>(),
+      late = gate<{ done: false; value: unknown }>();
+    let closes = 0;
+    const f = fixture(() => ({
+      stream: {
+        [Symbol.asyncIterator]: () => ({
+          next() {
+            reading.resolve();
+            return late.promise;
+          },
+          async return() {
+            closes++;
+            return { done: true, value: undefined };
+          },
+        }),
+      },
+    }));
+    await f.run(async () => {
+      const controller = new AbortController(),
+        iterator = f.stream(controller.signal),
+        pending = iterator.next();
+      await reading.promise;
+      controller.abort(new Error("owned Stop"));
+      await assert.rejects(pending);
+      late.resolve({
+        done: false,
+        value: { type: "text-delta", id: "late", text: "must not appear" },
+      });
+      await new Promise((resolve) => setImmediate(resolve));
+      assert.equal(closes, 1);
+      assert.deepEqual(f.counts(), { active: 0, peak: 1, releases: 1, acquires: 1 });
+      assert.equal(
+        f.statuses.some(
+          (event) =>
+            event.type === "model_retry_scheduled" || event.type === "model_request_completed",
+        ),
+        false,
+      );
+    });
+  },
+);
diff --git a/apps/zcode-cli/packages/adapters/test/workspace-hook-trust-file.test.ts b/apps/zcode-cli/packages/adapters/test/workspace-hook-trust-file.test.ts
new file mode 100644
index 00000000..3070eab4
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/workspace-hook-trust-file.test.ts
@@ -0,0 +1,71 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rename, rm, utimes, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { FileWorkspaceHookTrustStore } from "../src/storage/workspace-hook-trust-store.js";
+import type { WorkspaceHookTrustRecord } from "@zcode/contracts";
+
+const record = (digest: string): WorkspaceHookTrustRecord => ({
+  workspaceIdentity: "authored-workspace",
+  hookDeclarationDigest: digest.repeat(64),
+  digestAlgorithm: "sha256",
+  decision: "trusted",
+  grantedAt: "2026-10-12T00:00:00.000Z",
+  eventAtGrant: "PreToolUse",
+  displayCommandAtGrant: "node authored-hook.mjs",
+  sourcePathAtGrant: "/authored/hooks.json",
+});
+
+test("native trust publication retries transient rename and a failed successor preserves the prior grant on reopen", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-trust-publication-"));
+  const filePath = join(root, "security", "trust.json");
+  let attempts = 0;
+  try {
+    const writer = new FileWorkspaceHookTrustStore({
+      filePath,
+      renameRetryDelaysMs: [1],
+      renameFile: async (source, target) => {
+        if (++attempts === 1)
+          throw Object.assign(new Error("authored transient lock"), { code: "EPERM" });
+        return rename(source, target);
+      },
+    });
+    await writer.grant([record("a")]);
+    const failing = new FileWorkspaceHookTrustStore({
+      filePath,
+      beforeRename: () => {
+        throw new Error("authored interrupted publication");
+      },
+    });
+    await assert.rejects(failing.grant([record("b")]), /authored interrupted publication/);
+    const reopened = await new FileWorkspaceHookTrustStore({ filePath }).load();
+    assert.equal(reopened.status, "ok");
+    assert.deepEqual(reopened.records, [record("a")]);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("unknown process-instance identity never steals an old live-owner trust lock", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-trust-owner-"));
+  const filePath = join(root, "security", "trust.json");
+  try {
+    await new FileWorkspaceHookTrustStore({ filePath }).grant([record("a")]);
+    await writeFile(
+      `${filePath}.lock`,
+      JSON.stringify({ pid: process.pid, token: "authored-foreign-owner", startTime: 1 }),
+    );
+    const past = new Date(Date.now() - 60_000);
+    await utimes(`${filePath}.lock`, past, past);
+    const contender = new FileWorkspaceHookTrustStore({
+      filePath,
+      lockTimeoutMs: 5,
+      staleLockMs: 5,
+      probeProcessStartTime: async () => null,
+    });
+    await assert.rejects(contender.grant([record("b")]), /lock/i);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/api-media-generate-image.ts b/apps/zcode-cli/packages/bootstrap/src/app/api-media-generate-image.ts
