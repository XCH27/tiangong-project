index 00000000..7525e4ee
--- /dev/null
+++ b/packages/ui/test/nativeWhiteboardDraftControl.test.ts
@@ -0,0 +1,466 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IZCodeAgentService } from "@zcode/services";
+import type { WhiteboardControlResult, WhiteboardControlInput } from "@zcode/shared";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+import { useConfirmDialogStore as dialogs } from "../src/store/confirmDialogStore.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import { requestNativeWhiteboardDraftClose } from "../src/lib/nativeWhiteboardClose.js";
+import { dirtyWhiteboardTargets } from "../src/lib/nativeWhiteboardClose.js";
+import {
+  nativeWhiteboardServices,
+  currentNativeWhiteboardWorkspace,
+} from "../src/lib/nativeWhiteboardServices.js";
+import { useRemoteWorkspaceSessionStore } from "../src/store/remoteWorkspaceSessionStore.js";
+import { installNativeWhiteboardCloseBridge } from "../src/lib/nativeWhiteboardCloseBridge.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import { isWhiteboardDirty } from "../src/store/whiteboardNativeProjection.js";
+
+// Drive the existing registry's keep-warm expiry through its actual cleanup owner.
+test.beforeEach((t) => t.mock.timers.enable({ apis: ["setTimeout"] }));
+test.afterEach((t) => t.mock.timers.tick(30_001));
+
+const revision = { id: "authored-revision", hash: `sha256:${"a".repeat(64)}` };
+const format = (id: string) => id;
+const tick = async () => {
+  for (let i = 0; i < 24; i++) await Promise.resolve();
+};
+function fresh() {
+  store.setState({ ...store.getInitialState() }, true);
+  dialogs.getState().settleChoice("dismiss");
+  const scope = { workspacePath: `/whiteboard-control-${crypto.randomUUID()}` };
+  const board = store.getState().createBoard({ ...scope, defaultNamePrefix: "Authored" });
+  return { scope, board, target: { ...scope, boardId: board.id } };
+}
+function service(handle: (command: WhiteboardControlInput) => Promise<WhiteboardControlResult>) {
+  return {
+    ...nativePresentationAgent().agent,
+    async sendConversationCommandV4() {
+      assert.fail("Native draft must reuse its existing Session without a creation/model command");
+    },
+    performWhiteboardControl: async (input: { command: WhiteboardControlInput }) =>
+      handle(input.command),
+  } as unknown as IZCodeAgentService;
+}
+function receipt(
+  command: WhiteboardControlInput,
+): Extract<WhiteboardControlResult, { status: "completed" }> {
+  assert.equal(command.operation, "update");
+  if (command.operation !== "update") throw new Error("Unexpected read");
+  return {
+    status: "completed",
+    filePath: "/authored/whiteboard.json",
+    fileRevision: revision,
+    document: {
+      schemaVersion: 1,
+      revision: 1,
+      mutationId: command.input.mutationId,
+      mutationDigest: "b".repeat(64),
+      board: command.input.document,
+    },
+  };
+}
+
+test("real draft owner waits for control receipt and keeps drawing made during save", async () => {
+  const f = fresh(),
+    gate = Promise.withResolvers<void>();
+  let command: WhiteboardControlInput | undefined;
+  const agent = service(async (input) => {
+    command = structuredClone(input);
+    await gate.promise;
+    return receipt(input);
+  });
+  const save = saveNativeWhiteboardDraft({
+    ...f,
+    agent,
+    sessionId: "original-session",
+    showSession: (_, id) => assert.equal(id, "original-session"),
+  });
+  await tick();
+  assert.ok(store.getState().workspaces[f.scope.workspacePath]?.nativeById?.[f.board.id]?.pending);
+  assert.equal(command?.operation, "update");
+  store.getState().renameBoard({ ...f.target, name: "Drawing after save" });
+  gate.resolve();
+  assert.equal(await save, true);
+  const workspace = store.getState().workspaces[f.scope.workspacePath]!;
+  assert.equal(workspace.boardsById[f.board.id]?.name, "Drawing after save");
+  assert.equal(workspace.nativeById?.[f.board.id]?.committed?.document.board.name, f.board.name);
+  assert.equal(
+    isWhiteboardDirty(workspace.boardsById[f.board.id], workspace.nativeById?.[f.board.id]),
+    true,
+  );
+});
+
+test("uncertain control failure retains original mutation identity for one later reconciliation", async () => {
+  const f = fresh();
+  const mutations: string[] = [];
+  let effects = 0;
+  const agent = service(async (command) => {
+    assert.equal(command.operation, "update");
+    if (command.operation !== "update") throw new Error("Unexpected read");
+    mutations.push(command.input.mutationId);
+    if (mutations.length === 1) {
+      effects++;
+      return {
+        status: "failed",
+        message: "Receipt publication interrupted",
+        effectStatus: "not_confirmed",
+      };
+    }
+    return { ...receipt(command), observed: true };
+  });
+  const options = { target: f.target, agent, sessionId: "original-session", showSession: () => {} };
+  assert.equal(await saveNativeWhiteboardDraft(options), false);
+  assert.equal(store.getState().getBoard(f.target), f.board);
+  assert.equal(await saveNativeWhiteboardDraft(options), true);
+  assert.equal(mutations[0], mutations[1]);
+  assert.equal(effects, 1);
+});
+
+test("all-workspace close uses original dialog choices and never discards a later draft", async () => {
+  const f = fresh();
+  const closing = requestNativeWhiteboardDraftClose({ save: async () => false, format });
+  await tick();
+  assert.equal(dialogs.getState().pendingRequest?.dismissLabel, "common.cancel");
+  store.getState().renameBoard({ ...f.target, name: "Edited while confirming" });
+  dialogs.getState().settleChoice("cancel");
+  await tick();
+  assert.equal(store.getState().getBoard(f.target)?.name, "Edited while confirming");
+  assert.ok(dialogs.getState().pendingRequest);
+  dialogs.getState().settleChoice("dismiss");
+  assert.equal(await closing, false);
+  const discard = requestNativeWhiteboardDraftClose({ save: async () => false, format });
+  await tick();
+  dialogs.getState().settleChoice("cancel");
+  assert.equal(await discard, true);
+  assert.equal(store.getState().getBoard(f.target), null);
+});
+
+test("Main close listener registers before clean publish and freezes until exact cancellation", async () => {
+  fresh();
+  store.setState({ workspaces: {} });
+  let listener:
+    | ((input: { requestId: string; phase?: "request" | "cancelled" }) => void)
+    | undefined;
+  const replies: Array<{ requestId: string; allowClose: boolean }> = [];
+  const remove = installNativeWhiteboardCloseBridge(
+    {
+      onNativeWhiteboardCloseRequest: (callback) => {
+        listener = callback;
+        return {
+          dispose() {
+            listener = undefined;
+          },
+        };
+      },
+      completeNativeWhiteboardClose: async (result) => {
+        replies.push(result);
+      },
+      publishNativeWhiteboardDraftState: ({ dirty }) => {
+        assert.ok(listener);
+        assert.equal(dirty, false);
+      },
+    },
+    { save: async () => false, format },
+  );
+  const id = crypto.randomUUID();
+  listener!({ requestId: id });
+  await tick();
+  assert.deepEqual(replies, [{ requestId: id, allowClose: true }]);
+  assert.equal(store.getState().nativeCloseFrozen, true);
+  listener!({ requestId: crypto.randomUUID(), phase: "cancelled" });
+  assert.equal(store.getState().nativeCloseFrozen, true);
+  listener!({ requestId: id, phase: "cancelled" });
+  assert.equal(store.getState().nativeCloseFrozen, false);
+  remove();
+});
+
+test("late receipt after service generation changed cannot mark the draft accepted", async () => {
+  const f = fresh(),
+    gate = Promise.withResolvers<void>();
+  let current = true;
+  const agent = service(async (command) => {
+    await gate.promise;
+    return receipt(command);
+  });
+  const save = saveNativeWhiteboardDraft({
+    target: f.target,
+    agent,
+    sessionId: "original-session",
+    showSession: () => {},
+    isCurrent: () => current,
+  });
+  await tick();
+  current = false;
+  gate.resolve();
+  assert.equal(await save, false);
+  const native = store.getState().workspaces[f.scope.workspacePath]?.nativeById?.[f.board.id];
+  assert.equal(native?.committed, undefined);
+  assert.ok(native?.retry);
+  assert.equal(store.getState().getBoard(f.target), f.board);
+});
+
+test("observed receipt for different file content never consumes the requested draft", async () => {
+  const f = fresh();
+  const agent = service(async (command) => {
+    const value = receipt(command);
+    return {
+      ...value,
+      observed: true,
+      document: { ...value.document, board: { ...value.document.board, name: "Later file edit" } },
+    };
+  });
+  assert.equal(
+    await saveNativeWhiteboardDraft({
+      target: f.target,
+      agent,
+      sessionId: "original-session",
+      showSession: () => {},
+    }),
+    false,
+  );
+  const projection = store.getState().workspaces[f.scope.workspacePath]!.nativeById![f.board.id]!;
+  assert.equal(store.getState().getBoard(f.target), f.board);
+  assert.equal(projection.committed, undefined);
+  assert.equal(projection.incoming?.document.board.name, "Later file edit");
+  assert.equal(projection.error, "whiteboard.conflict");
+});
+
+test("uncertain close response keeps edits frozen until Main's matching cancellation", async () => {
+  fresh();
+  store.setState({ workspaces: {} });
+  let listener:
+    | ((input: { requestId: string; phase?: "request" | "cancelled" }) => void)
+    | undefined;
+  const remove = installNativeWhiteboardCloseBridge(
+    {
+      onNativeWhiteboardCloseRequest: (callback) => {
+        listener = callback;
+        return { dispose() {} };
+      },
+      completeNativeWhiteboardClose: async () => {
+        throw new Error("Authored IPC receipt lost");
+      },
+      publishNativeWhiteboardDraftState: () => {},
+    },
+    { save: async () => false, format },
+  );
+  const id = crypto.randomUUID();
+  listener!({ requestId: id });
+  await tick();
+  assert.equal(store.getState().nativeCloseFrozen, true);
+  listener!({ requestId: id, phase: "cancelled" });
+  assert.equal(store.getState().nativeCloseFrozen, false);
+  remove();
+});
+
+test("never-mounted and unindexed boards remain dirty without a native projection or Session", () => {
+  const f = fresh();
+  store.setState((state) => ({
+    workspaces: {
+      ...state.workspaces,
+      [f.scope.workspacePath]: {
+        ...state.workspaces[f.scope.workspacePath]!,
+        boardIds: [],
+      },
+    },
+  }));
+  assert.deepEqual(
+    dirtyWhiteboardTargets().map((target) => target.boardId),
+    [f.board.id],
+  );
+  assert.equal(dirtyWhiteboardTargets()[0]!.workspacePath, f.scope.workspacePath);
+});
+
+test("hidden remote draft resolves renewed original registry endpoint without local fallback", () => {
+  const registry = useRemoteWorkspaceSessionStore;
+  registry.setState({ ...registry.getInitialState() }, true);
+  const base = { zcodeAgentService: { owner: "local" } },
+    renewed = { zcodeAgentService: { owner: "renewed" } };
+  registry.getState().registerBaseServices(base as never);
+  registry.getState().registerSession({ sessionId: "new-attachment", services: renewed as never });
+  registry.getState().bindWorkspaceIdentity("remote-workspace", "new-attachment");
+  const oldScope = {
+    workspacePath: "/authored/remote",
