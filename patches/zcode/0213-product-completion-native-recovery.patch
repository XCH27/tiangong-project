diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-operation.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-operation.ts
new file mode 100644
index 00000000..fe3969c3
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-operation.ts
@@ -0,0 +1,88 @@
+import { createHash } from "node:crypto";
+import type { SessionEntryInfo, ToolCall, TraceContext } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+
+const ENTRY_TYPE = "runtime/native_plugin_view_operation";
+const SOURCE = "native_plugin_view";
+const nonEmpty = (value: unknown): value is string => typeof value === "string" && !!value.trim();
+
+/** Session-entry IDs are global SQLite keys; length-delimited Session/operation identity is required. */
+export function nativePluginOperationEntryId(sessionId: string, operationId: string): string {
+  return `native-plugin-operation:${createHash("sha256")
+    .update(JSON.stringify([sessionId, operationId]))
+    .digest("hex")}`;
+}
+
+/** One immutable admission fact in the ORIGINAL Session store, unrelated to transcript lifetime. */
+export function createNativePluginOperationEntry(
+  runtime: AgentRuntimeInternal,
+  call: ToolCall,
+  trace: TraceContext,
+  inputRef: string,
+  operationId: string,
+): SessionEntryInfo {
+  if (![operationId, call.id, call.name, trace.traceId, trace.turnId, inputRef].every(nonEmpty))
+    throw new Error("Native plugin admission requires complete original execution identities");
+  const now = Date.now();
+  return {
+    id: nativePluginOperationEntryId(runtime.sessionId, operationId),
+    sessionID: runtime.sessionId,
+    type: ENTRY_TYPE,
+    touchSession: false,
+    time: { created: now, updated: now },
+    data: {
+      version: 1,
+      source: SOURCE,
+      operationId,
+      toolCallId: call.id,
+      toolName: call.name,
+      traceId: trace.traceId,
+      turnId: trace.turnId,
+      inputRef,
+    },
+  };
+}
+
+/** Missing/malformed admission evidence never licenses replay of an external effect. */
+export async function assertNativePluginOperationNotRecorded(
+  runtime: AgentRuntimeInternal,
+  operationId: string,
+): Promise<void> {
+  const store = runtime.sessionStore;
+  if (
+    !store?.sessionEntries ||
+    !("saveSessionEntryOnce" in store) ||
+    typeof store.saveSessionEntryOnce !== "function"
+  )
+    throw Object.assign(
+      new Error("Native plugin control needs durable original Session admission"),
+      { code: "native_operation_admission_unavailable" },
+    );
+  const id = nativePluginOperationEntryId(runtime.sessionId, operationId);
+  for (const entry of await store.sessionEntries({ sessionID: runtime.sessionId })) {
+    const data =
+      entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
+        ? (entry.data as Record<string, unknown>)
+        : undefined;
+    if (entry.id !== id && !(data?.source === SOURCE && data.operationId === operationId)) continue;
+    const valid =
+      entry.id === id &&
+      entry.sessionID === runtime.sessionId &&
+      entry.type === ENTRY_TYPE &&
+      data?.version === 1 &&
+      data.source === SOURCE &&
+      data.operationId === operationId &&
+      [data.toolCallId, data.toolName, data.traceId, data.turnId, data.inputRef].every(nonEmpty) &&
+      Number.isFinite(entry.time.created) &&
+      Number.isFinite(entry.time.updated);
+    if (!valid)
+      throw Object.assign(
+        new Error("Native plugin admission evidence is malformed; external replay refused"),
+        { code: "native_operation_admission_corrupt" },
+      );
+    throw Object.assign(
+      new Error("Native plugin operation was already accepted; inspect the original receipt"),
+      { code: "native_operation_already_recorded" },
+    );
+  }
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view-tools.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view-tools.ts
new file mode 100644
index 00000000..7f8923b3
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view-tools.ts
@@ -0,0 +1,74 @@
+import { registerMcpTools } from "../deps.js";
+import type { McpServerConfig, TraceContext } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { computeOfficialCuaServerNames } from "./mcp.js";
+import { toRegisteredMcpToolName, officialCuaProviderSpellingAliases } from "../../mcp/index.js";
+
+/** Refresh one original selected-server lease/registry projection, retaining every sibling owner. */
+export async function refreshPluginViewTools(
+  runtime: AgentRuntimeInternal,
+  serverName: string,
+  config: McpServerConfig,
+  signal: AbortSignal,
+  trace: TraceContext,
+  assertAvailable: (signal: AbortSignal) => Promise<void>,
+): Promise<void> {
+  const port = runtime.mcpPort;
+  if (!port || runtime.config.mcp?.enabled === false)
+    throw new Error("The original MCP runtime is unavailable");
+  await assertAvailable(signal);
+  signal.throwIfAborted();
+  const status = await port.connectServer(serverName, config, {
+    workingDirectory: runtime.workspaceRoot,
+    workspaceIdentity: runtime.config.workspaceIdentity?.toString(),
+    trace,
+    oauthAuthorizationTimeoutMs: 15_000,
+  });
+  signal.throwIfAborted();
+  if (status.status !== "connected")
+    throw new Error(status.error ?? "The selected plugin server did not connect");
+  await assertAvailable(signal);
+  const tools = (await port.listTools()).filter((tool) => tool.serverName === serverName);
+  await assertAvailable(signal);
+  signal.throwIfAborted();
+  const toolNames = new Set<string>();
+  for (const tool of tools) {
+    if (toolNames.has(tool.toolName))
+      throw new Error("The selected plugin server returned duplicate tool identities");
+    toolNames.add(tool.toolName);
+  }
+  const registry = runtime.registry;
+  const officialNames = computeOfficialCuaServerNames(
+    { [serverName]: config },
+    new Set(runtime.config.mcp?.trustedOfficialCuaServerNames ?? []),
+  );
+  const plannedNames = new Set<string>();
+  for (const tool of tools) {
+    const official = officialNames.has(serverName);
+    const name = toRegisteredMcpToolName(tool, official);
+    for (const projected of [
+      name,
+      ...(officialCuaProviderSpellingAliases(name, tool, official) ?? []),
+    ]) {
+      if (plannedNames.has(projected))
+        throw new Error("The selected plugin tool projection has conflicting identities");
+      plannedNames.add(projected);
+      const existing = registry.get(projected);
+      if (existing && existing.metadata.mcpPresentation?.serverName !== serverName)
+        throw new Error("The selected plugin tool name conflicts with an existing tool identity");
+    }
+  }
+  for (const name of registry.list()) {
+    if (registry.getMetadata(name)?.mcpPresentation?.serverName === serverName)
+      registry.unregister(name);
+  }
+  try {
+    registerMcpTools(registry, port, tools, {
+      allowedTools: runtime.config.toolAllowlist,
+      disallowedTools: runtime.config.toolDisallowlist,
+      officialCuaServerNames: officialNames,
+    });
+  } finally {
+    runtime.invalidateToolCache();
+  }
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view.ts
new file mode 100644
index 00000000..d48c3a36
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-plugin-view.ts
@@ -0,0 +1,129 @@
+import { randomUUID } from "node:crypto";
+import { refreshPluginViewTools } from "./native-plugin-view-tools.js";
+import { assertNativePluginOperationNotRecorded } from "./native-plugin-operation.js";
+import type { McpServerConfig, TraceContext } from "../deps.js";
+import type { McpToolCallResult } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { performNativeToolControl, type NativeToolControlResult } from "./native-tool-control.js";
+
+export interface NativePluginViewRequest {
+  serverName: string;
+  toolName: string;
+  arguments?: Record<string, unknown>;
+}
+
+/** These options are Host-derived execution evidence, never plugin/model request arguments. */
+export interface NativePluginViewOptions {
+  operationId: string;
+  expectedServerConfig: McpServerConfig;
+  assertAvailable(signal: AbortSignal): Promise<void>;
+  traceContext?: TraceContext;
+  abortSignal?: AbortSignal;
+}
+
+export type NativePluginViewControlResult = NativeToolControlResult & {
+  rawResult?: McpToolCallResult;
+};
+
+function recordedOperation(
+  messages: Awaited<ReturnType<NonNullable<AgentRuntimeInternal["sessionStore"]>["messages"]>>,
+  operationId: string,
+): boolean {
+  return messages.some((message) => {
+    const action = message.info.metadata?.nativeAction as { operationId?: unknown } | undefined;
+    return (
+      (message.info.semantics?.source === "native_plugin_view" &&
+        action?.operationId === operationId) ||
+      (message.info.semantics?.source === "native_plugin_view" &&
+        message.parts.some(
+          (part) =>
+            part.type === "tool" &&
+            part.metadata?.nativeAction === true &&
+            part.metadata.operationId === operationId,
+        ))
+    );
+  });
+}
+
+/** One original registered MCP entry, one admitted SDK call, no inference or writable-tool replay. */
+export async function performPluginViewControl(
+  this: AgentRuntimeInternal,
+  request: NativePluginViewRequest,
+  options: NativePluginViewOptions,
+): Promise<NativePluginViewControlResult> {
+  if (!options.operationId.trim() || !request.serverName.trim() || !request.toolName.trim())
+    throw new Error("Native plugin control requires original operation/server/tool identities");
+  const expectedServerConfig = structuredClone(options.expectedServerConfig);
+  const args = structuredClone(request.arguments ?? {});
+  let rawResult: McpToolCallResult | undefined;
+  const outcome = await performNativeToolControl(this, {
+    operationId: options.operationId,
+    foregroundPrefix: "native-plugin-view",
+    presentation: { source: "native_plugin_view", agent: "native-plugin-view" },
+    traceContext: options.traceContext,
+    abortSignal: options.abortSignal,
+    prepare: async (signal, trace) => {
+      await assertNativePluginOperationNotRecorded(this, options.operationId);
+      // 原 Session 的已接受动作即使 pending/error/unknown 也不得重放外部写工具。
+      const messages = await this.sessionStore!.messages({ sessionID: this.sessionId });
+      if (recordedOperation(messages, options.operationId))
+        throw Object.assign(
+          new Error("Native plugin operation was already accepted; inspect the original receipt"),
+          { code: "native_operation_already_recorded" },
+        );
+      await options.assertAvailable(signal);
+      await this.initializeMcp(trace);
+      await refreshPluginViewTools(
+        this,
+        request.serverName,
+        expectedServerConfig,
+        signal,
+        trace,
+        options.assertAvailable,
+      );
+      signal.throwIfAborted();
+      const entries = this.registry.list().flatMap((name) => {
+        const entry = this.registry.get(name);
+        const identity = entry?.metadata.mcpPresentation;
+        return entry &&
+          identity?.serverName === request.serverName &&
+          identity.toolName === request.toolName
+          ? [entry]
+          : [];
+      });
+      if (entries.length !== 1) return undefined;
+      const entry = entries[0]!,
+        handler = entry.handler;
+      const assertAvailable = async (activeSignal: AbortSignal) => {
+        activeSignal.throwIfAborted();
+        await options.assertAvailable(activeSignal);
+        const current = this.registry.get(entry.metadata.name);
+        if (
+          current !== entry ||
+          current.handler !== handler ||
+          current.metadata.mcpPresentation?.serverName !== request.serverName ||
+          current.metadata.mcpPresentation.toolName !== request.toolName
+        )
+          throw new Error("The original plugin MCP entry changed before dispatch");
+        activeSignal.throwIfAborted();
+      };
+      return {
+        call: { id: `native-plugin-${randomUUID()}`, name: entry.metadata.name, input: args },
+        summary: `Use plugin tool: ${request.serverName}/${request.toolName}`,
+        executeOptions: {
+          nativeMcpView: {
+            serverName: request.serverName,
+            toolName: request.toolName,
+            expectedServerConfig,
+            assertAvailable,
+            capture(result) {
+              rawResult = structuredClone(result);
+            },
+          },
+        },
+      };
+    },
+  });
+  // Cancellation/normalization/persistence failure stays visible; captured raw does not rewrite that outcome.
+  return outcome.accepted && rawResult ? { ...outcome, rawResult } : outcome;
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-control.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-control.ts
new file mode 100644
index 00000000..f2fba6f8
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-control.ts
@@ -0,0 +1,171 @@
+import { randomUUID } from "node:crypto";
+import {
+  SessionEventType,
+  createChildTraceContext,
+  createTurnId,
+  type ToolCall,
+  type ToolExecutionResult,
+  type TraceContext,
+} from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { ExecuteToolsOptions } from "../types.js";
+import {
+  beginOwnedForegroundExecution,
+  finishForegroundExecution,
+} from "./runtime-command-foreground.js";
+import {
+  persistNativeToolStart,
+  persistNativeToolResult,
+  type NativeToolPresentation,
+} from "./native-tool-persistence.js";
+import { trackLateToolSettlement } from "./late-tool-settlement.js";
+import { recordToolUsageFromResult } from "./turn-tool-usage.js";
+
+export type NativeToolControlResult =
+  | { accepted: false; reason: "busy" | "unavailable" | "shutting_down" }
+  | { accepted: true; result: ToolExecutionResult };
+
+interface PreparedNativeTool {
+  call: ToolCall;
+  summary: string;
+  executeOptions?: Pick<ExecuteToolsOptions, "nativeMcpView">;
+}
+interface NativeToolControlOptions {
+  operationId?: string;
+  foregroundPrefix: "native-whiteboard" | "native-plugin-view";
+  presentation: NativeToolPresentation;
+  traceContext?: TraceContext;
+  abortSignal?: AbortSignal;
+  prepare(signal: AbortSignal, trace: TraceContext): Promise<PreparedNativeTool | undefined>;
+  recover?(): Promise<void>;
+}
+
+/** Private domain adapter: callers select one original registered entry; it grants no permission. */
+export function performNativeToolControl(
+  runtime: AgentRuntimeInternal,
+  options: NativeToolControlOptions,
+): Promise<NativeToolControlResult> {
+  if (runtime.shuttingDown) return Promise.resolve({ accepted: false, reason: "shutting_down" });
+  if (!runtime.sessionStore || !runtime.artifactStore)
+    return Promise.resolve({ accepted: false, reason: "unavailable" });
+  if (runtime.hasActiveOrQueuedTurnWork())
+    return Promise.resolve({ accepted: false, reason: "busy" });
+  const leaseId = `${options.foregroundPrefix}:${options.operationId ?? randomUUID()}`;
+  const lease = runtime.acquireForegroundPromotionLease({
+    leaseId,
+    mode: "idle-only",
+    promotedInputId: leaseId,
+  });
+  if (lease.kind !== "acquired") return Promise.resolve({ accepted: false, reason: "busy" });
+  const foreground = beginOwnedForegroundExecution.call(runtime, leaseId, options.abortSignal);
+  const work = executeNativeControl(runtime, options, foreground.controller.signal).finally(() => {
+    finishForegroundExecution.call(runtime, foreground);
+    runtime.releaseForegroundPromotionLease(leaseId);
+  });
+  return runtime.trackResidencyBlockingWork(work);
+}
+
+async function executeNativeControl(
+  runtime: AgentRuntimeInternal,
+  options: NativeToolControlOptions,
+  signal: AbortSignal,
+): Promise<NativeToolControlResult> {
+  const trace = createChildTraceContext(options.traceContext ?? runtime.rootTraceContext, {
+    turnId: createTurnId(),
+  });
+  signal.throwIfAborted();
+  const prepared = await options.prepare(signal, trace);
+  if (!prepared) return { accepted: false, reason: "unavailable" };
+  const { call, summary } = prepared;
+  signal.throwIfAborted();
+  await options.recover?.();
+  signal.throwIfAborted();
+  await runtime.ensureSessionPersistedForExternalActivity(summary, { traceContext: trace });
+  signal.throwIfAborted();
+  // Existing trust/feature policy activates before the first human tool, without a model/SessionStart hook.
+  await runtime.workspaceHookAdmission?.activate("startup", signal);
+  signal.throwIfAborted();
+  const anchor = await persistNativeToolStart(
+    runtime,
+    call,
+    summary,
+    trace,
+    options.presentation,
+    options.operationId,
+  );
+  // The original scheduled, permission and final facts must share this real receipt anchor.
+  const toolTrace = createChildTraceContext(trace, {
+    attributes: { assistantMessageId: String(anchor.receiptId) },
+  });
+  runtime.currentTurnFileChanges = new Map();
+  await runtime.appendEvent(
+    runtime.createEvent(
+      SessionEventType.TurnStarted,
+      {
+        turnNumber: runtime.turnNumber++,
+        input: summary,
+        messageId: anchor.userId,
+        executionKind: "controlOnly",
+        foregroundExecutionId: runtime.activeForegroundExecution?.foregroundExecutionId,
+      },
+      trace,
+    ),
+    trace,
+  );
+  let result: ToolExecutionResult | undefined;
+  let settled = false;
+  try {
+    const schedule = await runtime.scheduleTools([call]);
+    await runtime.emitToolScheduledEvents(
+      [{ ...call, input: anchor.pending.state.input }],
+      schedule,
+      anchor.receiptId,
+      toolTrace,
+    );
+    const executed = await runtime.executeTools([call], schedule, {
+      ...prepared.executeOptions,
+      signal,
+      traceContext: toolTrace,
+      allowedToolNames: [call.name],
+    });
+    result = executed.results[0];
+    if (!result) throw new Error("Native executor returned no receipt");
+    const part = await persistNativeToolResult(runtime, anchor.pending, result, toolTrace);
+    await recordToolUsageFromResult(runtime, result, toolTrace);
+    if (result.completionEventAfterPersist) {
+      await runtime.appendEvent(result.completionEventAfterPersist, toolTrace);
+      delete result.completionEventAfterPersist;
+    }
+    if (result.lateSettlement) trackLateToolSettlement(runtime, part, result, toolTrace);
+    await runtime.emitFileMutationCheckpoint({
+      events: [],
+      messageId: anchor.userId,
+      toolMessageId: anchor.receiptId,
+      result,
+      traceContext: toolTrace,
+      propagateFailure: true,
+    });
+    settled = true;
+    return { accepted: true, result };
+  } finally {
+    await runtime.appendEvent(
+      runtime.createEvent(
+        SessionEventType.TurnComplete,
+        {
+          response: "",
+          tokenCount: 0,
+          toolCallCount: 1,
+          duration: Date.now() - anchor.started,
+          resultType:
+            settled && result?.success
+              ? "success"
+              : signal.aborted
+                ? "cancelled"
+                : "error_during_execution",
+        },
+        trace,
+      ),
+      trace,
+    );
+  }
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-persistence.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-tool-persistence.ts
