index 00000000..2a5fbef3
--- /dev/null
+++ b/packages/ui/test/nativeWorkbench.browser.test.tsx
@@ -0,0 +1,384 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { createSessionTraceId } from "@zcode/shared";
+import { ConfirmDialogHost } from "../src/ConfirmDialog.js";
+import { useConfirmDialogStore as dialogs } from "../src/store/confirmDialogStore.js";
+import { App } from "../src/App.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { StoreProvider } from "../src/store/StoreProvider.js";
+import { TabStoreProvider, useTabStoreApi, useTabStore } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { useZCodeSessionStore as sessions } from "../src/store/zcodeSessionStore.js";
+import { useWhiteboardStore as boards } from "../src/store/whiteboardStore.js";
+import { isWhiteboardDirty } from "../src/store/whiteboardNativeProjection.js";
+import enUS from "../src/i18n/locales/en-US.js";
+import zhCN from "../src/i18n/locales/zh-CN.js";
+import { nativeWorkbenchFixture } from "./nativeWorkbenchFixture.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+  await new Promise((resolve) => setTimeout(resolve, 30));
+};
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    for (const scenario of [
+      "ordinary",
+      "refused",
+      "completed",
+      "stopped-before-initial",
+      "close-save-stop-before-initial",
+    ] as const) {
+      const native = scenario !== "ordinary";
+      const closeSave = scenario === "close-save-stop-before-initial";
+      const closeRequestId = crypto.randomUUID();
+      dialogs.setState({ ...dialogs.getInitialState() }, true);
+      sessions.setState({ ...sessions.getInitialState() }, true);
+      boards.setState({ ...boards.getInitialState() }, true);
+      const workspace = `/authored-full-workbench-${crypto.randomUUID()}`;
+      const taskId = `ordinary-${crypto.randomUUID()}`;
+      const ordinaryTask = {
+        taskId,
+        traceId: createSessionTraceId(),
+        title: "Authored ordinary uncached Session",
+        workspacePath: workspace,
+        createdAt: Date.now(),
+        updatedAt: Date.now(),
+        mode: "build",
+        provider: "codex",
+      } as const;
+      const fixture = nativeWorkbenchFixture(
+        locale,
+        native ? [] : [ordinaryTask],
+        scenario === "completed" ? "completed" : "refused",
+        native,
+      );
+      const { services, platform } = fixture;
+      const errors: string[] = [];
+      const node = document.createElement("div");
+      node.style.cssText = "width:1280px;height:800px";
+      document.body.append(node);
+      const root = createRoot(node, {
+        onUncaughtError: (error, info) => errors.push(String(error) + info.componentStack),
+        onCaughtError: (error, info) => errors.push(String(error) + info.componentStack),
+      });
+      let tabs!: ReturnType<typeof useTabStoreApi>;
+      function OriginalApp() {
+        tabs = useTabStoreApi();
+        const path = useTabStore((state) => state.activeWorkspacePath) ?? workspace;
+        return (
+          <App
+            services={services}
+            baseFeedbackService={services.feedbackService}
+            workspaceAbsPath={path}
+            isDesktop
+            isMacDesktop
+            supportsEmbeddedBrowser={false}
+            reconnectingRemoteWorkspaceKeys={[]}
+            remoteWorkspaceErrorByWorkspaceKey={{}}
+            onConnectRemote={async () => ""}
+            onSelectRemoteProject={async () => {}}
+            onCancelRemoteProject={async () => {}}
+            onReconnectRemoteWorkspace={async () => {}}
+            onCreateTask={() => {}}
+            onOpenWorkspace={() => {}}
+            onOpenFolderFromWorkspaceMenu={() => {}}
+            onCreateScratchWorkspace={async () => null}
+          />
+        );
+      }
+      const click = async (selector: string) => {
+        const button =
+          node.querySelector<HTMLElement>(selector) ??
+          document.querySelector<HTMLElement>(selector);
+        check(
+          button,
+          `Missing original control ${selector}; body=${node.textContent?.slice(-800)}`,
+        );
+        await act(async () => {
+          if (selector === "[data-side-pane-add-trigger]")
+            button.dispatchEvent(
+              new PointerEvent("pointerdown", {
+                bubbles: true,
+                cancelable: true,
+                button: 0,
+                pointerType: "mouse",
+              }),
+            );
+          button.click();
+          await tick();
+        });
+      };
+      const pointer = async (type: string, offset: number) => {
+        const canvas = node.querySelector<HTMLCanvasElement>("canvas");
+        check(canvas, "Original canvas missing");
+        canvas.setPointerCapture = () => {};
+        canvas.hasPointerCapture = () => false;
+        const box = canvas.getBoundingClientRect();
+        check(box.width > 100 && box.height > 100, "Styled original canvas lacks bounds");
+        await act(async () =>
+          canvas.dispatchEvent(
+            new PointerEvent(type, {
+              bubbles: true,
+              button: 0,
+              pointerId: 1,
+              clientX: box.left + offset,
+              clientY: box.top + offset,
+            }),
+          ),
+        );
+      };
+      const name = `${locale}: original full Workbench ${native ? `first native pen Save (${scenario})` : "ordinary uncached task selection"}`;
+      try {
+        await act(async () => {
+          root.render(
+            <ServiceProvider services={services}>
+              <PlatformProvider platform={platform}>
+                <StoreProvider broadcastService={services.broadcastService}>
+                  <TabStoreProvider>
+                    <ZCodeIntlProvider initialLocale={locale} disablePersistence>
+                      <TooltipProvider>
+                        <OriginalApp />
+                        <ConfirmDialogHost />
+                      </TooltipProvider>
+                    </ZCodeIntlProvider>
+                  </TabStoreProvider>
+                </StoreProvider>
+              </PlatformProvider>
+            </ServiceProvider>,
+          );
+          await tick();
+        });
+        await act(async () => {
+          tabs.getState().addTab(workspace);
+          await tick();
+        });
+        if (!native) {
+          await click(`[data-task-item-key*="${taskId}"]`);
+          check(
+            sessions.getState().getWorkspaceState(workspace).activeTaskId === taskId,
+            "Ordinary original task selection failed",
+          );
+          check(
+            fixture.commands.length === 0,
+            "Ordinary selection created another Session/model input",
+          );
+          check(
+            !sessions.getState().getWorkspaceState(workspace).taskConfigOptionsByTaskId[taskId],
+            "Ordinary control accidentally used a cached Session configuration",
+          );
+          await act(async () => {
+            fixture.publish(taskId);
+            await tick();
+          });
+        } else {
+          await click('[data-testid="side-pane-toggle"]');
+          await click('[data-side-pane-open-tab-item="review"]');
+          await click("[data-side-pane-add-trigger]");
+          await click('[data-side-pane-add-item="whiteboard"]');
+          const board = Object.values(boards.getState().workspaces[workspace]?.boardsById ?? {})[0];
+          check(board, "Original New whiteboard control did not create a draft");
+          await pointer("pointerdown", 10);
+          await pointer("pointermove", 35);
+          check(
+            boards.getState().getBoard({ workspacePath: workspace, boardId: board.id })?.strokes
+              .length === 0,
+            "Active pen gesture committed early",
+          );
+          if (closeSave) {
+            await act(async () => {
+              fixture.requestWindowClose(closeRequestId);
+              await tick();
+            });
+            await click(
+              `[data-testid="whiteboard-close-${closeRequestId}"] [data-testid="confirm-dialog-confirm"]`,
+            );
+          } else await click('[data-testid="whiteboard-save"]');
+          check(
+            fixture.commands.length === 1 && fixture.commands[0]?.type === "createSession",
+            "First Save did not use one ordinary empty Session",
+          );
+          check(
+            fixture.updates.length === 0,
+            "ACK-only subscription dispatched Save before its initial projection",
+          );
+          if (scenario === "stopped-before-initial" || closeSave) {
+            await click('[data-testid="whiteboard-stop"]');
+            const settledBeforeInitial =
+              !boards.getState().workspaces[workspace]?.nativeById?.[board.id]?.pending;
+            await act(async () => {
+              fixture.releaseInitialFrame(fixture.nativeSession);
+              await tick();
+            });
+            check(
+              fixture.updates.length === 0,
+              "Late initial frame dispatched a native write after preinitial Stop",
+            );
+            check(
+              settledBeforeInitial &&
+                !boards.getState().workspaces[workspace]?.nativeById?.[board.id]?.pending,
+              "Preinitial Stop did not settle the original pending Save",
+            );
+            check(
+              boards.getState().getBoard({ workspacePath: workspace, boardId: board.id })?.strokes
+                .length === 1,
+              "Preinitial Stop erased the original drawing",
+            );
+            check(
+              node.querySelector('[data-testid="whiteboard-save-status"]')?.textContent ===
+                (locale === "en-US" ? enUS : zhCN)["whiteboard.unsaved"],
+              "Preinitial Stop did not show retained Unsaved state",
+            );
+            if (closeSave) {
+              check(
+                fixture.closeReplies.length === 1 &&
+                  fixture.closeReplies[0]?.requestId === closeRequestId &&
+                  fixture.closeReplies[0].allowClose === false,
+                "Stopped original close Save did not refuse its owning window close",
+              );
+              check(
+                !boards.getState().nativeCloseFrozen &&
+                  boards.getState().nativeCloseRequestId === null,
+                "Stopped original close Save left its renderer frozen",
+              );
+              check(
+                node.querySelector('[data-testid="whiteboard-save"]'),
+                "Stopped original close Save removed the original pane",
+              );
+            }
+            check(errors.length === 0, errors.join("\n"));
+            results.push({ name });
+            continue;
+          }
+          await act(async () => {
+            fixture.releaseInitialFrame(fixture.nativeSession);
+            await tick();
+          });
+          check(
+            fixture.updates.length === 1 &&
+              fixture.updates[0]?.operation === "update" &&
+              fixture.updates[0].input.document.strokes.length === 1,
