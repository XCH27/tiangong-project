+            ZCODE_E2E_RUNTIME_LOG_DIR: join(dir, "logs"),
+          },
+          stdio: ["ignore", "pipe", "pipe"],
+          timeout: 12000,
+        });
+        let output = "";
+        child.stdout.on("data", (data) => {
+          output += data;
+        });
+        child.stderr.on("data", (data) => {
+          output += data;
+        });
+        child.on("error", reject);
+        child.on("exit", (code, signal) => resolve({ code, signal, output }));
+      });
+      assert.equal(result.code, 0, result.output);
+      assert.match(result.output, /PASS actual isolated DOM/);
+    } finally {
+      await rm(dir, { recursive: true, force: true });
+    }
+  },
+);
diff --git a/packages/desktop/test/browser-consumer-lifecycle.test.mjs b/packages/desktop/test/browser-consumer-lifecycle.test.mjs
new file mode 100644
index 00000000..88842f30
--- /dev/null
+++ b/packages/desktop/test/browser-consumer-lifecycle.test.mjs
@@ -0,0 +1,201 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { EventEmitter } from "node:events";
+import { registerHooks } from "node:module";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+
+const logs = await mkdtemp(join(tmpdir(), "browser-consumer-logs-"));
+process.env.ZCODE_ENV = "test";
+process.env.ZCODE_E2E_RUNTIME_LOG_DIR = logs;
+const guests = new Map();
+globalThis.__browserConsumerGuests = guests;
+const hooks = registerHooks({
+  resolve(specifier, context, next) {
+    return specifier === "electron"
+      ? { url: "test:browser-consumer-electron", shortCircuit: true }
+      : next(specifier, context);
+  },
+  load(url, context, next) {
+    return url === "test:browser-consumer-electron"
+      ? {
+          format: "module",
+          shortCircuit: true,
+          source:
+            "export const webContents = { fromId(id) { return globalThis.__browserConsumerGuests.get(id); } };",
+        }
+      : next(url, context);
+  },
+});
+const { BrowserGuestManager } = await import("../src/main/browserView/browserGuestManager.ts");
+
+async function fixture() {
+  const bus = new EventEmitter();
+  let attached = false,
+    destroyed = false,
+    hold = false;
+  const entered = Promise.withResolvers(),
+    viewport = Promise.withResolvers();
+  const id = guests.size + 100;
+  const guest = Object.assign(bus, {
+    id,
+    mainFrame: {},
+    session: new EventEmitter(),
+    getType: () => "webview",
+    getZoomFactor: () => 1,
+    setZoomFactor() {},
+    isDestroyed: () => destroyed,
+    getURL: () => "https://authored.invalid",
+    getTitle: () => "Authored",
+    stop() {},
+    reload() {},
+    loadURL: async () => {},
+    navigationHistory: {
+      getAllEntries: () => [],
+      getActiveIndex: () => 0,
+      canGoBack: () => false,
+      canGoForward: () => false,
+    },
+    async executeJavaScript(script) {
+      if (hold && script.includes("window.innerWidth")) {
+        entered.resolve();
+        return viewport.promise;
+      }
+      return { width: 800, height: 600 };
+    },
+    close() {
+      destroyed = true;
+      bus.emit("destroyed");
+    },
+    debugger: Object.assign(new EventEmitter(), {
+      isAttached: () => attached,
+      attach() {
+        attached = true;
+      },
+      detach() {
+        attached = false;
+      },
+      sendCommand: async () => ({}),
+    }),
+  });
+  guests.set(id, guest);
+  const context = {
+    requestId: `new-${id}`,
+    browserId: `iab-${id}`,
+    browserGeneration: 1,
+    windowId: id,
+    workspaceKey: `/authored-${id}`,
+    sessionId: `session-${id}`,
+    clientMode: "desktop-continuous",
+  };
+  let tabId;
+  const manager = new BrowserGuestManager(undefined, 100, undefined, (key) => {
+    tabId = key;
+    assert.equal(
+      manager.attachGuest(key, id, {
+        active: true,
+        windowId: id,
+        workspaceKey: context.workspaceKey,
+        sessionId: context.sessionId,
+      }).ok,
+      true,
+    );
+  });
+  const created = await manager.execute(context, { method: "newTab" });
+  assert.equal(created.ok, true);
+  await manager.updateViewportFromRenderer(tabId, null, id);
+  return {
+    manager,
+    context,
+    tabId,
+    guest,
+    entered: entered.promise,
+    hold() {
+      hold = true;
+    },
+    release() {
+      viewport.resolve({ width: 800, height: 600 });
+    },
+    closeTab: () =>
+      manager.closeTabFromRenderer({
+        tabId,
+        windowId: id,
+        workspaceKey: context.workspaceKey,
+        sessionId: context.sessionId,
+      }),
+    close() {
+      manager.closeWindow(id);
+      guests.delete(id);
+    },
+  };
+}
+
+test("original manager omits a tab closed while its public list viewport read is in flight", async () => {
+  const f = await fixture();
+  try {
+    f.hold();
+    const pending = f.manager.execute({ ...f.context, requestId: "list-held" }, { method: "list" });
+    await f.entered;
+    await f.closeTab();
+    f.release();
+    const result = await pending;
+    assert.equal(result.ok, true);
+    assert.deepEqual(result.tabs, []);
+    assert.deepEqual(result.meta.openTabIds, []);
+    assert.deepEqual(f.manager.listGuestWebContentsIds(), []);
+  } finally {
+    f.close();
+  }
+});
+
+test("original activation never acknowledges a disappeared tab and preserves tab correlation", async () => {
+  const f = await fixture();
+  try {
+    f.hold();
+    const pending = f.manager.execute(
+      { ...f.context, requestId: "activate-held" },
+      { method: "activateTab", tabId: f.tabId },
+    );
+    await f.entered;
+    await f.closeTab();
+    f.release();
+    const result = await pending;
+    assert.equal(result.ok, false);
+    assert.equal(result.error.code, "backend_unavailable");
+    assert.equal(result.tab, undefined);
+    assert.equal(result.meta.tabId, f.tabId);
+    assert.equal(result.meta.lifecycle, "closed");
+    const fresh = await f.manager.execute(
+      { ...f.context, requestId: "list-after-close" },
+      { method: "list" },
+    );
+    assert.deepEqual(fresh.tabs, []);
+  } finally {
+    f.close();
+  }
+});
+
+test("renderer scope cannot close a browser tab owned by another window", async () => {
+  const f = await fixture();
+  try {
+    await assert.rejects(
+      f.manager.closeTabFromRenderer({
+        tabId: f.tabId,
+        windowId: f.context.windowId + 1,
+        workspaceKey: f.context.workspaceKey,
+        sessionId: f.context.sessionId,
+      }),
+      /unavailable for renderer scope/,
+    );
+    assert.equal(f.manager.listGuestWebContentsIds().length, 1);
+  } finally {
+    f.close();
+  }
+});
+
+test.after(async () => {
+  hooks.deregister();
+  delete globalThis.__browserConsumerGuests;
+  await rm(logs, { recursive: true, force: true });
+});
