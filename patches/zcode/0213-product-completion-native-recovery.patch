+  ["clearSession", 1, "clearSession", null, null],
+];
+for (const [Owner, expected] of [
+  [CommandInbox, CommandInboxOriginal],
+  [WorkspaceHookReviewController, WorkspaceHookReviewControllerOriginal],
+  [ConversationTopicPublisher, ConversationTopicPublisherOriginal],
+  [ConversationV4Gateway, ConversationV4GatewayOriginal],
+  [ConversationTelemetryFactNormalizer, ConversationTelemetryFactNormalizerOriginal],
+] as const) {
+  test(`${Owner.name} retains the original prototype ABI including getters and method order`, () => {
+    assert.deepEqual(
+      Object.getOwnPropertyNames(Owner.prototype),
+      expected.map(([name]) => name),
+    );
+    for (const [name, length, functionName, getterName, getterLength] of expected) {
+      const d = Object.getOwnPropertyDescriptor(Owner.prototype, name)!;
+      assert.equal(d.value?.length ?? null, length);
+      assert.equal(d.value?.name ?? null, functionName);
+      assert.equal(d.get?.name ?? null, getterName);
+      assert.equal(d.get?.length ?? null, getterLength);
+      assert.equal(d.enumerable, false);
+      assert.equal(d.configurable, true);
+      assert.equal(d.writable ?? null, getterName ? null : true);
+      assert.equal(d.set, undefined);
+    }
+  });
+}
+test("original Inbox owns duplicate final ACK, independent keys and one Session admission gate", async () => {
+  const inbox = new CommandInbox({
+    getRevision: () => 0,
+    getLogEpoch: () => "owner-epoch",
+    now: () => 1000,
+  });
+  const command = (commandId: string) => ({
+    commandId,
+    clientId: "owner-client",
+    sessionId: null,
+    type: "createSession",
+    payload: { workspaceId: "authored-workspace" },
+    issuedAt: 1000,
+  });
+  const first = await inbox.handle(command("original-id"));
+  assert.equal(first.kind, "execute");
+  if (first.kind !== "execute") throw new Error("Expected original admission");
+  let duplicateDone = false,
+    nextDone = false;
+  const duplicate = inbox.handle(command("original-id")).then((result) => {
+    duplicateDone = true;
+    return result;
+  });
+  const next = inbox.handle(command("next-id")).then((result) => {
+    nextDone = true;
+    return result;
+  });
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(duplicateDone, false);
+  assert.equal(nextDone, false);
+  first.settle({ status: "accepted", result: { sessionId: "original-created-session" } });
+  first.settle({ status: "failed", reasonCode: "must-not-replace-final" });
+  const repeated = await duplicate;
+  assert.equal(repeated.kind, "ack");
+  if (repeated.kind !== "ack") throw new Error("Expected final duplicate");
+  assert.equal(repeated.ack.status, "duplicate");
+  assert.deepEqual(repeated.ack.result, { sessionId: "original-created-session" });
+  const second = await next;
+  assert.equal(second.kind, "execute");
+  if (second.kind !== "execute") throw new Error("Expected next independent admission");
+  assert.equal(second.admissionSeq, first.admissionSeq + 1);
+  second.settle({ status: "failed", reasonCode: "actual-local-failure" });
+  const replay = await inbox.handle(command("next-id"));
+  assert.equal(replay.kind, "ack");
+  if (replay.kind === "ack") assert.equal(replay.ack.status, "failed");
+});
