new file mode 100644
index 00000000..702578d1
--- /dev/null
+++ b/packages/ui/test/helpers/whiteboardProjectionHookFixture.ts
@@ -0,0 +1,119 @@
+import { readFileSync } from "node:fs";
+import { runInNewContext } from "node:vm";
+import ts from "typescript";
+import * as controls from "../../src/lib/nativeWhiteboardControl.js";
+import * as draft from "../../src/lib/nativeWhiteboardDraft.js";
+import * as gesture from "../../src/lib/whiteboardGesture.js";
+import { buildWhiteboardWorkspaceKey } from "../../src/lib/whiteboard.js";
+import { useWhiteboardStore } from "../../src/store/whiteboardStore.js";
+import type { useNativeWhiteboardControls } from "../../src/hooks/useNativeWhiteboardControls.js";
+
+/** Exact production hook body with authored lifecycle/clock; this is not a React renderer. */
+export function whiteboardProjectionHookFixture() {
+  type Slot = { value?: unknown; deps?: readonly unknown[]; cleanup?: () => void };
+  const slots: Slot[] = [],
+    intervals = new Map<number, () => void>();
+  let cursor = 0,
+    nextTimer = 0;
+  let effects: Array<() => void> = [];
+  // Every hook advances one slot even when that slot already exists.
+  const slot = () => {
+    const index = cursor++;
+    return slots[index] ?? (slots[index] = {});
+  };
+  const changed = (before: readonly unknown[] | undefined, after: readonly unknown[]) =>
+    !before ||
+    before.length !== after.length ||
+    before.some((value, i) => !Object.is(value, after[i]));
+  const memo = <T>(factory: () => T, deps: readonly unknown[]): T => {
+    const item = slot();
+    if (changed(item.deps, deps)) {
+      item.value = factory();
+      item.deps = deps;
+    }
+    return item.value as T;
+  };
+  const react = {
+    useMemo: memo,
+    useCallback: <T>(callback: T, deps: readonly unknown[]) => memo(() => callback, deps),
+    useRef: <T>(current: T) => {
+      const item = slot();
+      return (item.value ??= { current }) as { current: T };
+    },
+    useState: <T>(initial: T) => {
+      const item = slot();
+      if (!("value" in item)) item.value = initial;
+      return [
+        item.value as T,
+        (value: T) => {
+          item.value = value;
+        },
+      ];
+    },
+    useEffect: (effect: () => (() => void) | void, deps: readonly unknown[]) => {
+      const item = slot();
+      if (changed(item.deps, deps)) {
+        effects.push(() => {
+          item.cleanup?.();
+          item.cleanup = effect() ?? undefined;
+        });
+        item.deps = deps;
+      }
+    },
+  };
+  const imports: Record<string, unknown> = {
+    react,
+    "../store/whiteboardStore.js": {
+      useWhiteboardStore: Object.assign(
+        (select: (state: ReturnType<typeof useWhiteboardStore.getState>) => unknown) =>
+          select(useWhiteboardStore.getState()),
+        { getState: useWhiteboardStore.getState },
+      ),
+    },
+    "../lib/whiteboard.js": { buildWhiteboardWorkspaceKey },
+    "../lib/nativeWhiteboardControl.js": controls,
+    "../lib/nativeWhiteboardDraft.js": draft,
+    "../lib/whiteboardGesture.js": gesture,
+  };
+  const path = new URL("../../src/hooks/useNativeWhiteboardControls.ts", import.meta.url);
+  const output = ts.transpileModule(readFileSync(path, "utf8"), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+  }).outputText;
+  const module = {
+    exports: {} as { useNativeWhiteboardControls: typeof useNativeWhiteboardControls },
+  };
+  runInNewContext(
+    output,
+    {
+      module,
+      exports: module.exports,
+      require: (id: string) => {
+        if (!(id in imports)) throw new Error(`Unexpected hook import: ${id}`);
+        return imports[id];
+      },
+      setInterval: (callback: () => void, ms: number) => {
+        if (ms !== 5000) throw new Error("Unexpected whiteboard poll interval");
+        intervals.set(++nextTimer, callback);
+        return nextTimer;
+      },
+      clearInterval: (id: number) => intervals.delete(id),
+    },
+    { filename: path.pathname },
+  );
+  return {
+    render(input: Parameters<typeof useNativeWhiteboardControls>[0]) {
+      cursor = 0;
+      effects = [];
+      const result = module.exports.useNativeWhiteboardControls(input);
+      for (const effect of effects) effect();
+      return result;
+    },
+    tick() {
+      for (const callback of intervals.values()) callback();
+    },
+    close() {
+      for (const item of slots) item.cleanup?.();
+      intervals.clear();
+    },
+  };
+}
diff --git a/packages/ui/test/nativePluginViewControl.test.ts b/packages/ui/test/nativePluginViewControl.test.ts
