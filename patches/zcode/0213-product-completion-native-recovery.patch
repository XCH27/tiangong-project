+      );
+      const second = await app.startSavedWorkflow({ name: "version-cap", scope: "project" });
+      assert.ok(second.ok, JSON.stringify(second));
+      assert.equal((await waitForRun(app, second.runId)).status, "completed");
+      const report = (await app.listDynamicWorkflowRunArtifacts?.({ runId: second.runId }))?.find(
+        (item) => item.id === "report",
