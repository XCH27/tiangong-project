@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+
+let sequence = 0;
+function event(type: SessionEvent["type"], turnId: string, payload: unknown): SessionEvent {
+  return {
+    id: `native-event-${++sequence}`,
+    sessionId: "owned",
+    traceId: "owned-trace",
+    turnId,
+    timestamp: new Date(sequence * 10),
+    sequenceNumber: sequence,
+    type,
+    payload,
+  } as SessionEvent;
+}
+const start = (id?: string) => ({
+  input: "Native action",
+  executionKind: "controlOnly",
+  steerable: true,
+  ...(id ? { foregroundExecutionId: id } : {}),
+});
+const done = (resultType: string) => ({
+  response: "",
+  tokenCount: 0,
+  toolCallCount: 1,
+  duration: 777,
+  resultType,
+});
+
+for (const prefix of ["native-whiteboard:", "native-plugin-view:"]) {
+  for (const outcome of ["success", "cancelled", "error_during_execution", "TurnError"]) {
+    test(`${prefix} ${outcome} exposes only original stoppable foreground and releases it on exact terminal`, () => {
+      const projection = new ProductProjection("owned", "epoch"),
+        id = prefix + "original-operation";
+      projection.applyEvent(event(SessionEventType.TurnStarted, "current", start(id)));
+      const control = projection.getSnapshot().control;
+      assert.equal(control.canStop, true);
+      assert.equal(control.stopTargetKind, "tool");
+      assert.equal(control.steerable, false);
+      assert.equal(control.activeWorks.length, 1);
+      assert.equal(control.activeWorks[0]?.kind, "primaryTurn");
+      assert.equal(control.activeWorks[0]?.foregroundExecutionId, id);
+      projection.applyEvent(
+        event(
+          outcome === "TurnError" ? SessionEventType.TurnError : SessionEventType.TurnComplete,
+          "current",
+          outcome === "TurnError"
+            ? {
+                error: { code: "owned", type: "owned", message: "Authored failure" },
+                turnPhase: "tool",
+              }
+            : done(outcome),
+        ),
+      );
+      const final = projection.getSnapshot();
+      assert.equal(final.control.canStop, false);
+      assert.deepEqual(final.control.activeWorks, []);
+      const header = final.rows.window.find((row) => row.kind === "turnHeader");
+      assert.ok(header?.kind === "turnHeader");
+      assert.equal(header.executionKind, "controlOnly");
+      assert.equal(header.activeMs, undefined);
+      assert.equal(final.usage.cumulative.inputTokens, 0);
+    });
+  }
+}
+
+for (const foregroundExecutionId of [
+  undefined,
+  "goal-control:owned",
+  "native-whiteboard:",
+  "foreign:native-whiteboard:owned",
+]) {
+  test(`legacy /goal control-only without original native identity stays excluded (${foregroundExecutionId ?? "missing"})`, () => {
+    const projection = new ProductProjection("owned", "epoch");
+    projection.applyEvent(
+      event(SessionEventType.TurnStarted, "goal-query", {
+        ...start(foregroundExecutionId),
+        input: "/goal authored",
+      }),
+    );
+    assert.equal(projection.getSnapshot().control.canStop, false);
+    assert.deepEqual(projection.getSnapshot().control.activeWorks, []);
+    projection.applyEvent(event(SessionEventType.TurnComplete, "goal-query", done("success")));
+    assert.deepEqual(projection.getSnapshot().control.activeWorks, []);
+  });
+}
+
+for (const terminal of [SessionEventType.TurnComplete, SessionEventType.TurnError]) {
+  test(`late ${terminal} from historic control cannot clear new original native work`, () => {
+    const projection = new ProductProjection("owned", "epoch");
+    projection.applyEvent(
+      event(SessionEventType.TurnStarted, "old", start("native-whiteboard:old")),
+    );
+    projection.applyEvent(event(SessionEventType.TurnComplete, "old", done("success")));
+    projection.applyEvent(
+      event(SessionEventType.TurnStarted, "new", start("native-whiteboard:new")),
+    );
+    const before = projection.getSnapshot().control;
+    projection.applyEvent(
+      event(
+        terminal,
+        "old",
+        terminal === SessionEventType.TurnComplete
+          ? done("cancelled")
+          : {
+              error: { code: "owned", type: "owned", message: "Late owned failure" },
+              turnPhase: "tool",
+            },
+      ),
+    );
+    assert.deepEqual(projection.getSnapshot().control, before);
+    projection.applyEvent(event(SessionEventType.TurnComplete, "new", done("success")));
+    assert.deepEqual(projection.getSnapshot().control.activeWorks, []);
+  });
+
+  test(`late ${terminal} preserves newer actual stream continuation and empty-work current identity`, () => {
+    const projection = new ProductProjection("owned", "epoch");
+    projection.applyEvent(
+      event(SessionEventType.TurnStarted, "old", start("native-whiteboard:old")),
+    );
+    projection.applyEvent(event(SessionEventType.TurnComplete, "old", done("success")));
+    projection.applyEvent(
+      event(SessionEventType.TurnStarted, "new-model", {
+        input: "Authored model-only trigger",
+        inputVisibility: "model-only",
+        foregroundExecutionId: "agent:new",
+      }),
+    );
+    projection.applyEvent(
+      event(SessionEventType.ModelStreaming, "new-model", {
+        kind: "text_delta",
+        delta: "Original streamed text",
+        done: false,
+      }),
+    );
+    projection.applyEvent(
+      event(SessionEventType.ModelStreaming, "new-model", {
+        kind: "text_end",
+        delta: "",
+        done: true,
+      }),
+    );
+    projection.applyEvent(
+      event(SessionEventType.ModelComplete, "new-model", {
+        content: "Original streamed text",
+        stopReason: "length",
+        toolCallCount: 0,
+        usage: {},
+      }),
+    );
+    const pointer = Reflect.get(projection, "outputContinuationTextRowId");
+    assert.ok(typeof pointer === "number");
+    assert.equal(Reflect.get(projection, "currentTurnStartedModelOnly"), true);
+    const snapshot = projection.getSnapshot();
+    projection.applyEvent(
+      event(
+        terminal,
+        "old",
+        terminal === SessionEventType.TurnComplete
+          ? done("cancelled")
+          : { error: { code: "owned", type: "owned", message: "Late failure" }, turnPhase: "tool" },
+      ),
+    );
+    assert.equal(Reflect.get(projection, "outputContinuationTextRowId"), pointer);
+    assert.equal(Reflect.get(projection, "currentTurnId"), "new-model");
+    assert.equal(Reflect.get(projection, "currentTurnStartedModelOnly"), true);
+    assert.deepEqual(projection.getSnapshot().control, snapshot.control);
+    assert.deepEqual(
+      projection.getSnapshot().rows.window.filter((row) => row.turnId === "new-model"),
+      snapshot.rows.window.filter((row) => row.turnId === "new-model"),
+    );
+    // A newer legacy control query can own current identity without any active work.
+    projection.applyEvent(event(SessionEventType.TurnStarted, "new-empty", start()));
+    const current = Reflect.get(projection, "currentTurnId");
+    projection.applyEvent(
+      event(
+        terminal,
+        "old",
+        terminal === SessionEventType.TurnComplete
+          ? done("success")
+          : { error: { code: "owned", type: "owned", message: "Late failure" }, turnPhase: "tool" },
+      ),
+    );
+    assert.equal(Reflect.get(projection, "currentTurnId"), current);
+  });
+}
