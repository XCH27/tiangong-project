+import { AgentRuntime } from "@zcode/core";
+
+import { type TraceContext } from "@zcode/contracts";
+
+import type { PrepareUserExecutionBoundary, ZCodeApp } from "./types.js";
+
+export function createAppReturnGetSkillCatalog(factoryBindings: {
+  readonly prepareUserExecutionBoundary: PrepareUserExecutionBoundary;
+  readonly traceContext: TraceContext;
+  readonly getRuntime: () => AgentRuntime;
+}): ZCodeApp["getSkillCatalog"] {
+  return (
+    {
+      getSkillCatalog: async () => {
+        // Skill 目录属于 context 初始化结果。冷恢复必须先恢复 Session 边界，再读取
+        // 新 runtime 的快照，不能绕开 resume 后用旧工作目录独立扫描。
+        await factoryBindings.prepareUserExecutionBoundary({
+          traceContext: factoryBindings.traceContext,
+        });
+        return await factoryBindings.getRuntime().getSkillCatalog(factoryBindings.traceContext);
+      },
+    } satisfies Pick<ZCodeApp, "getSkillCatalog">
+  ).getSkillCatalog;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-return-read-prompt-attachment.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-return-read-prompt-attachment.ts
new file mode 100644
index 00000000..87bb6992
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-return-read-prompt-attachment.ts
@@ -0,0 +1,79 @@
+import type { ToolArtifactStorePort, FileSystemPort } from "@zcode/contracts";
+
+import { type TraceContext } from "@zcode/contracts";
+
+import type { ZCodeApp } from "./types.js";
+
+import { decodePromptAttachmentDataUrl } from "./create-app-values.js";
+
+export function createAppReturnReadPromptAttachment(factoryBindings: {
+  readonly resolvePromptAttachment: (input: {
+    ref: string;
+    mime: string;
+    messageId?: string;
+    toolCallId?: string;
+    attachmentIndex?: number;
+  }) => Promise<{ ref: string; mediaType: string; artifactUri?: string }>;
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly traceContext: TraceContext;
+  readonly fileSystemPort: FileSystemPort;
+}): ZCodeApp["readPromptAttachment"] {
+  return (
+    {
+      readPromptAttachment: async (input) => {
+        const { ref, mediaType } = await factoryBindings.resolvePromptAttachment(input);
+        // 读取必须留在 session runtime 内：artifact 走 session store，路径走当前
+        // FileSystemPort，SSH/WSL/Docker 才会命中正确的远端文件系统。
+        if (
+          ref.startsWith("zcode-artifact://") &&
+          (input.toolCallId !== undefined ||
+            factoryBindings.artifactStore.readToolResultBinaryArtifact)
+        ) {
+          if (!factoryBindings.artifactStore.readToolResultBinaryArtifact)
+            throw new Error("fault.attachment.readUnsupported");
+          const artifact = await factoryBindings.artifactStore.readToolResultBinaryArtifact({
+            uri: ref,
+            trace: factoryBindings.traceContext,
+          });
+          // Retained attachments use text data URLs; generated outputs use native bytes.
+          // Both explicit tool previews and already authorized Markdown images share this reader.
+          if (
+            artifact.contentType === "text/plain" &&
+            Buffer.from(artifact.bytes.subarray(0, 5)).toString() === "data:"
+          ) {
+            return decodePromptAttachmentDataUrl(
+              Buffer.from(artifact.bytes).toString("utf8"),
+              mediaType,
+              input.maxBytes,
+            );
+          }
+          if (artifact.bytes.byteLength > input.maxBytes)
+            throw new Error("fault.attachment.previewTooLarge");
+          if (mediaType === "image/*" && !artifact.contentType.startsWith("image/")) {
+            throw new Error("fault.attachment.previewNotMedia");
+          }
+          return {
+            bytes: artifact.bytes,
+            mediaType:
+              mediaType === "image/*" && artifact.contentType.startsWith("image/")
+                ? artifact.contentType
+                : mediaType,
+          };
+        }
+        if (ref.startsWith("zcode-artifact://")) {
+          const artifact = await factoryBindings.artifactStore.readToolResultArtifact({
+            uri: ref,
+            trace: factoryBindings.traceContext,
+          });
+          return decodePromptAttachmentDataUrl(artifact.content, mediaType, input.maxBytes);
+        }
+        const read = await factoryBindings.fileSystemPort.readBinaryFile({
+          path: ref,
+          maxBytes: input.maxBytes,
+          trace: factoryBindings.traceContext,
+        });
+        return { bytes: read.content, mediaType };
+      },
+    } satisfies Pick<ZCodeApp, "readPromptAttachment">
+  ).readPromptAttachment;
+}
