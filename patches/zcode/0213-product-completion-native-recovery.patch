+            await act(async () => {
+              tabs.getState().addTab(nextWorkspace);
+              await tick();
+            });
+            await act(async () => {
+              fixture.releaseWrite();
+              await tick();
+            });
+            check(
+              sessions.getState().getWorkspaceState(nextWorkspace).activeTaskId === null,
+              "Old native reply selected a Session in the new workspace",
+            );
+            check(
+              !node.querySelector('[data-testid="whiteboard-save"]'),
+              "Old native reply reopened the old workspace pane",
+            );
+            check(
+              boards.getState().getBoard({ workspacePath: workspace, boardId: board.id })?.strokes
