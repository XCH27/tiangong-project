@@ -0,0 +1,121 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { MessageChannel } from "node:worker_threads";
+import { loadMainConsumer } from "./helpers/main-consumer-fixture.mjs";
+
+const logger = { warn() {} };
+function ipcFixture() {
+  const handlers = new Map();
+  return { handlers, ipcMain: { handle: (channel, handler) => handlers.set(channel, handler) } };
+}
+
+test("PDF handler copies exact bytes from pooled and shared-backed buffers", async (t) => {
+  const fixture = ipcFixture();
+  const { registerDesktopPrintToPdfIpcHandler } = await loadMainConsumer(
+    t,
+    "desktopPrintToPdf.ts",
+    { electron: fixture },
+  );
+  registerDesktopPrintToPdfIpcHandler(logger);
+  const handler = [...fixture.handlers.values()][0];
+  for (const buffer of [
+    Buffer.from([9, 1, 2, 8]).subarray(1, 3),
+    Buffer.from(new SharedArrayBuffer(4), 1, 2),
+  ]) {
+    buffer[0] = 1;
+    buffer[1] = 2;
+    const result = await handler({ sender: { id: 1, printToPDF: async () => buffer } });
+    assert.equal(result.success, true);
+    assert.ok(result.data instanceof ArrayBuffer);
+    assert.deepEqual([...new Uint8Array(result.data)], [1, 2]);
+    buffer[0] = 4;
+    assert.equal(new Uint8Array(result.data)[0], 1);
+  }
+});
+
+test("PDF failure releases same sender and duplicate request does not enter print", async (t) => {
+  const fixture = ipcFixture();
+  const { registerDesktopPrintToPdfIpcHandler } = await loadMainConsumer(
+    t,
+    "desktopPrintToPdf.ts",
+    { electron: fixture },
+  );
+  registerDesktopPrintToPdfIpcHandler(logger);
+  const handler = [...fixture.handlers.values()][0];
+  let reject;
+  const sender = {
+    id: 2,
+    printToPDF: () =>
+      new Promise((_resolve, fail) => {
+        reject = fail;
+      }),
+  };
+  const pending = handler({ sender });
+  assert.deepEqual(await handler({ sender }), { success: false, error: "print_in_progress" });
+  reject(new Error("controlled failure"));
+  assert.deepEqual(await pending, { success: false, error: "print_failed" });
+  sender.printToPDF = async () => Buffer.from([3]);
+  assert.equal((await handler({ sender })).success, true);
+});
+
+test("real Node port feeds save handler: invalid, cancelled, exact authored file bytes", async (t) => {
+  const fixture = ipcFixture();
+  let output;
+  let cancelled = false;
+  fixture.BrowserWindow = { fromWebContents: () => undefined };
+  fixture.dialog = { showSaveDialog: async () => ({ canceled: cancelled, filePath: output }) };
+  const module = await loadMainConsumer(t, "desktopSaveFile.ts", { electron: fixture });
+  const { mkdtemp, rm } = await import("node:fs/promises");
+  const { tmpdir } = await import("node:os");
+  const directory = await mkdtemp(join(tmpdir(), "save-file-owned-"));
+  output = join(directory, "out.bin");
+  t.after(() => rm(directory, { recursive: true, force: true }));
+  module.registerDesktopSaveFileIpcHandler(logger);
+  const handler = [...fixture.handlers.values()][0];
+  const { port1, port2 } = new MessageChannel();
+  t.after(() => {
+    port1.close();
+    port2.close();
+  });
+  port1.on("message", async (payload) => port1.postMessage(await handler({ sender: {} }, payload)));
+  const request = (payload) =>
+    new Promise((resolve) => {
+      port2.once("message", resolve);
+      port2.postMessage(payload);
+    });
+  assert.deepEqual(await request({ suggestedName: "x", data: new ArrayBuffer(0) }), {
+    success: false,
+    error: "invalid_file_payload",
+  });
+  cancelled = true;
+  assert.deepEqual(await request({ suggestedName: "x", data: Uint8Array.from([1]).buffer }), {
+    success: false,
+    canceled: true,
+  });
+  await assert.rejects(readFile(output), { code: "ENOENT" });
+  cancelled = false;
+  assert.equal(
+    (await request({ suggestedName: "../x", data: Uint8Array.from([0, 255, 3]).buffer })).success,
+    true,
+  );
+  assert.deepEqual([...(await readFile(output))], [0, 255, 3]);
+  assert.equal(
+    (await request({ suggestedName: "x", sourceUrl: "http://localhost/no-network" })).error,
+    "remote_address_not_allowed",
+  );
+});
+
+test("actual DNS all-address result stays an array and blocks literal local addresses before fetch", async (t) => {
+  const { resolvePublicRemoteUrl } = await loadMainConsumer(t, "desktopSaveFile.ts", {
+    exports: ["resolvePublicRemoteUrl"],
+  });
+  for (const host of ["localhost", "127.0.0.1", "[::1]"]) {
+    await assert.rejects(resolvePublicRemoteUrl(new URL(`http://${host}/owned`)), {
+      code: "remote_address_not_allowed",
+    });
+  }
+  const addresses = await resolvePublicRemoteUrl(new URL("https://8.8.8.8/owned"));
+  assert.deepEqual(addresses, [{ address: "8.8.8.8", family: 4 }]);
+});
diff --git a/packages/desktop/test/main-boundary-consumers.test.mjs b/packages/desktop/test/main-boundary-consumers.test.mjs
new file mode 100644
index 00000000..23ffb54d
--- /dev/null
+++ b/packages/desktop/test/main-boundary-consumers.test.mjs
@@ -0,0 +1,145 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn } from "node:child_process";
+import { mkdtemp, writeFile, readFile, readdir, utimes, mkdir, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { loadMainConsumer } from "./helpers/main-consumer-fixture.mjs";
+
+const logger = { info() {}, warn() {} };
+async function ownedDirectory(t) {
+  const directory = await mkdtemp(join(tmpdir(), "main-boundary-owned-"));
+  t.after(() => rm(directory, { recursive: true, force: true }));
+  return directory;
+}
+
+test("icon fallback finishes sparse worker admission and preserves case-insensitive valid bundle paths", async (t) => {
+  const { buildApplicationPathIndex } = await loadMainConsumer(t, "applicationIcons.ts", {
+    exports: ["buildApplicationPathIndex"],
+  });
+  const reads = [];
+  const index = await buildApplicationPathIndex({
+    homeDirectory: "/owned",
+    now: () => 0,
+    listDirectory: async (root) =>
+      root === "/Applications" ? ["One.app", "Bad.app", "plain.txt"] : [],
+    execute: async (_command, args) => {
+      reads.push(args[2]);
+      if (args[2].includes("Bad.app")) throw new Error("controlled corrupt plist");
+      return "Com.Example.One";
+    },
+  });
+  assert.deepEqual([...index], [["com.example.one", "/Applications/One.app"]]);
+  assert.equal(reads.length, 2);
+});
+
+test("crash retention deletes only oldest authored archives and keeps latest even above byte limit", async (t) => {
+  const { pruneCrashDumpArchive } = await loadMainConsumer(t, "desktopCrashCapture.ts", {
+    exports: ["pruneCrashDumpArchive"],
+  });
+  const directory = await ownedDirectory(t);
+  const archive = join(directory, "archive"),
+    live = join(directory, "live");
+  await mkdir(archive);
+  await mkdir(live);
+  await writeFile(join(live, "live.dmp"), "untouched");
+  for (const [id, seconds] of [
+    ["old", 1],
+    ["latest", 3],
+    ["middle", 2],
+  ]) {
+    await writeFile(join(archive, id + ".dmp"), "1234");
+    await writeFile(join(archive, id + ".dmp.json"), "{}");
+    await utimes(join(archive, id + ".dmp"), seconds, seconds);
+  }
+  const result = pruneCrashDumpArchive(archive, { maxFiles: 2, maxTotalBytes: 0 });
+  assert.equal(result.failedFiles.length, 0);
+  assert.deepEqual((await readdir(archive)).sort(), ["latest.dmp", "latest.dmp.json"]);
+  assert.equal(await readFile(join(live, "live.dmp"), "utf8"), "untouched");
+  assert.equal(
+    pruneCrashDumpArchive(archive, { maxFiles: 1, maxTotalBytes: 0 }).deletedFiles.length,
+    0,
+  );
+});
+
+test("same stdio as Chrome helper accepts actual Node process stderr then settles shutdown and early exit", async (t) => {
+  const { waitForChromeDebuggerUrl, stopChromeHelper } = await loadMainConsumer(
+    t,
+    "chromeLocalStorageManager.ts",
+    { exports: ["waitForChromeDebuggerUrl", "stopChromeHelper"] },
+  );
+  const child = spawn(
+    process.execPath,
+    [
+      "-e",
+      'process.stderr.write("DevTools listening on ws://127.0.0.1:1234/owned\\n");setInterval(()=>{},1000);',
+    ],
+    { stdio: ["ignore", "pipe", "pipe"] },
+  );
+  t.after(() => child.kill("SIGKILL"));
+  assert.equal(child.stdin, null);
+  assert.equal(await waitForChromeDebuggerUrl(child), "ws://127.0.0.1:1234/owned");
+  await stopChromeHelper(child);
+  assert.equal(child.signalCode, "SIGTERM");
+  assert.equal(child.stderr.listenerCount("data"), 0);
+  const early = spawn(process.execPath, ["-e", "process.exit(1)"], {
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  t.after(() => early.kill("SIGKILL"));
+  await assert.rejects(waitForChromeDebuggerUrl(early), /chrome_helper_exited/);
+  assert.equal(early.stderr.listenerCount("data"), 0);
+});
+
+test("CUA logger preserves trace omission, values and warning fallbacks without invoking permissions", async (t) => {
+  const { toInstallerLogger } = await loadMainConsumer(t, "cuaAccessibilitySettings.ts", {
+    exports: ["toInstallerLogger"],
+    stubs: {
+      "@zcode/services/cua-permission-broker":
+        'export function resolveHelperPermissionSubjectIdentity(){throw new Error("no permission subject access");}',
+      "./desktopCuaHelperInstaller.js":
+        'export function createDesktopCuaHelperInstaller(){throw new Error("no helper install");}',
+    },
+  });
+  assert.equal(toInstallerLogger(undefined), undefined);
+  const received = [];
+  const adapted = toInstallerLogger({ warn: (...args) => received.push(args) });
+  const payload = { retained: true };
+  adapted.debug("trace", "silent");
+  adapted.info("trace", "info", payload);
+  adapted.warn(undefined, "warn");
+  adapted.error("trace", "error");
+  assert.deepEqual(received, [["info", payload], ["warn"], ["error"]]);
+});
+
+test("Windows helper verification uses existing expected version/commit and rejects mismatch before broker", async (t) => {
+  const { verifyHelper } = await loadMainConsumer(t, "windowsChromeAppBoundKey.ts", {
+    exports: ["verifyHelper"],
+  });
+  const directory = await ownedDirectory(t);
+  await mkdir(join(directory, "browser-import"));
+  const helperPath = join(directory, "browser-import", "zcode-browser-import-helper.exe");
+  await writeFile(helperPath, "authored executable-shaped bytes, never executed");
+  const calls = [];
+  const options = {
+    isPackaged: true,
+    trustedPowerShellPath: join(directory, "authored-powershell-never-executed"),
+    resourcesPath: directory,
+    processArch: "arm64",
+    expectedAppVersion: "owned-version",
+    expectedBuildCommit: "owned-commit",
+    logger,
+    verifySignature: async () => true,
+    runHelper: async (_exe, args) => {
+      calls.push(args);
+      return {
+        exitCode: 0,
+        stdout: "ZCODE_BROWSER_IMPORT_HELPER\t2\tarm64\towned-version\towned-commit",
+      };
+    },
+  };
+  assert.match(await verifyHelper(helperPath, options), /^[a-f0-9]{64}$/);
+  await assert.rejects(verifyHelper(helperPath, { ...options, expectedBuildCommit: "mismatch" }), {
+    code: "chrome_cookie_helper_verification_failed",
+  });
+  assert.equal(calls.length, 2);
+});
diff --git a/packages/desktop/test/main-lifecycle-consumers.test.mjs b/packages/desktop/test/main-lifecycle-consumers.test.mjs
