+      return "命中";
+    case "miss":
+      return "未命中";
+    case "unknown":
+      return "未知";
+  }
+}
+
+export function formatSegmentLabel(value?: string): string {
+  switch (value) {
+    case "system_prompt":
+      return "系统";
+    case "skills":
+      return "技能";
+    case "tools":
+      return "工具";
