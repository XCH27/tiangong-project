+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-resume-store-resume-from-store.ts
@@ -0,0 +1,40 @@
+import { AgentRuntime, type ResumeSessionResult } from "@zcode/core";
+import { type TraceContext } from "@zcode/contracts";
+
+import type { ResumeOptions, ZCodeAppOptions } from "./types.js";
+
+export function createAppResumeStoreResumeFromStore(factoryBindings: {
+  readonly getRuntime: () => AgentRuntime;
+  readonly traceContext: TraceContext;
+  readonly restorePersistedModelSelection: () => Promise<ResumeSessionResult["modelSelection"]>;
+  readonly initializeSessionShellEnvironment: () => Promise<void>;
+  readonly options: ZCodeAppOptions;
+  readonly markResumePrepared: () => void;
+}): (resumeOptions?: ResumeOptions) => Promise<ResumeSessionResult> {
+  const resumeFromStore = async (resumeOptions?: ResumeOptions): Promise<ResumeSessionResult> => {
+    const runtime = factoryBindings.getRuntime();
+    const unsubscribe = resumeOptions?.onEvent
+      ? runtime.subscribeEvents({ onSessionEvent: resumeOptions.onEvent })
+      : undefined;
+
+    try {
+      const resumeTraceContext = resumeOptions?.traceContext ?? factoryBindings.traceContext;
+      const modelSelection = await factoryBindings.restorePersistedModelSelection();
+      await factoryBindings.initializeSessionShellEnvironment();
+      const result = await runtime.resumeFromStore({
+        ...(resumeOptions?.abortSignal ? { abortSignal: resumeOptions.abortSignal } : {}),
+        // 只传调用方原始 mode；项目/全局默认值不能伪装成 invocation override，
+        // 否则交互式 resume 将无法恢复真正持久化的 session mode。
+        modeOverride: factoryBindings.options.runtimeConfig?.mode,
+        persistedMessages: resumeOptions?.persistedMessages,
+        traceContext: resumeTraceContext,
+      });
+      await runtime.activatePausedTargetAfterResume(resumeTraceContext);
+      factoryBindings.markResumePrepared();
+      return { ...result, modelSelection };
+    } finally {
+      unsubscribe?.();
+    }
+  };
+  return resumeFromStore;
+}
