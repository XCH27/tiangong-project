+import assert from "node:assert/strict";
+import test from "node:test";
+import fs from "node:fs/promises";
+import { mkdtemp, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { NodeFileSystemAdapter } from "../src/fs/index.js";
+
+test("create-only publication cannot replace a file created after the last revision check", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-exclusive-publication-"));
+  const path = join(root, "board.json");
+  const originalRename = fs.rename, originalLink = fs.link;
+  let injected = false;
+  const externalCreate = async (destination: unknown) => {
+    if (destination === path && !injected) {
+      injected = true;
+      await writeFile(path, "external committed bytes", { flag: "wx" });
+    }
+  };
+  try {
+    fs.rename = async (source, destination) => {
+      await externalCreate(destination);
+      return originalRename(source, destination);
+    };
+    fs.link = async (source, destination) => {
+      await externalCreate(destination);
+      return originalLink(source, destination);
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(new NodeFileSystemAdapter().writeTextFile({
+      path, boundaryRoot: root, content: "our complete staged bytes", atomic: true, expectedAbsent: true,
+    }), (error: { code?: string }) => error.code === "stale_write");
+    assert.equal(injected, true);
+    assert.equal(await readFile(path, "utf8"), "external committed bytes");
+    assert.deepEqual(await readdir(root), ["board.json"]);
+  } finally {
+    fs.rename = originalRename;
+    fs.link = originalLink;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("an unsupported exclusive publication fails without a replacement fallback or partial target", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-unsupported-publication-"));
+  const path = join(root, "board.json"), originalLink = fs.link;
+  try {
+    fs.link = async () => { throw Object.assign(new Error("Authored unsupported link"), { code: "EOPNOTSUPP" }); };
+    syncBuiltinESMExports();
+    await assert.rejects(new NodeFileSystemAdapter().writeTextFile({
+      path, boundaryRoot: root, content: "complete drawing", atomic: true, expectedAbsent: true,
+    }), (error: { code?: string; cause?: { code?: string } }) =>
+      error.code === "io_error" && error.cause?.code === "EOPNOTSUPP");
+    assert.deepEqual(await readdir(root), []);
+  } finally {
+    fs.link = originalLink;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("non-atomic create-only also refuses a concurrent creator at the write syscall", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-exclusive-direct-"));
+  const path = join(root, "board.json"), originalWrite = fs.writeFile;
+  let injected = false;
+  try {
+    fs.writeFile = async (destination, ...args) => {
+      if (destination === path && !injected) {
+        injected = true;
+        await originalWrite(path, "external committed bytes", { flag: "wx" });
+      }
+      return originalWrite(destination, ...args);
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(new NodeFileSystemAdapter().writeTextFile({
+      path, boundaryRoot: root, content: "replacement", atomic: false, expectedAbsent: true,
+    }), (error: { code?: string }) => error.code === "stale_write");
+    assert.equal(injected, true);
+    assert.equal(await readFile(path, "utf8"), "external committed bytes");
+    assert.deepEqual(await readdir(root), ["board.json"]);
+  } finally {
+    fs.writeFile = originalWrite;
+    syncBuiltinESMExports();
+    await rm(root, { recursive: true, force: true });
+  }
+});
