+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { zcodeProtocolMethods, whiteboardControlResultSchema } from "@zcode/shared";
+import { V4_METHODS } from "@zcode/shared/zcode-protocol-v4";
+import { projectionWireFixture, within } from "./helpers/native-projection-ndjson-fixture.js";
+import {
+  projectionBoard,
+  projectionHostFixture,
+} from "./helpers/native-whiteboard-projection-fixture.js";
+
+test("same production NDJSON wire admits human Save while a projection holds the original filesystem read", async () => {
+  const h = await projectionHostFixture(),
+    wire = h.openWire();
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  try {
+    const board = projectionBoard();
+    assert.equal(
+      (
+        await h.control({
+          operation: "update",
+          input: { document: board, mutationId: randomUUID(), expectedAbsent: true },
+        })
+      ).status,
+      "completed",
+    );
+    const read = h.files.readTextFile.bind(h.files);
+    let hold = true;
+    h.files.readTextFile = async (...args) => {
+      const value = await read(...args);
+      if (hold) {
+        hold = false;
+        entered.resolve();
+        await release.promise;
+      }
+      return value;
+    };
+    const projection = wire.request(zcodeProtocolMethods.sessionWhiteboardProjection, {
+      workspace: h.workspace,
+      sessionId: h.sessionId,
+      input: { boardId: board.id },
+    });
+    await entered.promise;
+    const save = wire.request(zcodeProtocolMethods.sessionWhiteboardControl, {
+      workspace: h.workspace,
+      sessionId: h.sessionId,
+      operationId: randomUUID(),
+      command: {
+        operation: "update",
+        input: { document: projectionBoard(), mutationId: randomUUID(), expectedAbsent: true },
+      },
+    });
+    const saved = await within(save, "Human Save behind observer");
+    assert.ok("result" in saved);
+    assert.equal(whiteboardControlResultSchema.parse(saved.result).status, "completed");
+    assert.equal(
+      wire.messages.length,
+      1,
+      "held projection has not replied or manufactured an actor turn",
+    );
+    assert.equal((await h.facts()).messages.length, 4, "exactly the two actual Saves are durable");
+    release.resolve();
+    const viewed = await projection;
+    assert.ok("result" in viewed);
+    assert.equal(whiteboardControlResultSchema.parse(viewed.result).status, "completed");
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    release.resolve();
+    await wire.close();
+    await h.close();
+  }
+});
+
+test("projection reads bypass a held actor while ordinary FIFO and exact Stop head admission stay unchanged", async () => {
+  const entered: string[] = [],
+    release = Promise.withResolvers<void>(),
+    head = Promise.withResolvers<void>();
+  const wire = projectionWireFixture(async (message) => {
+    if (!("id" in message) || !("method" in message)) return;
+    if (message.method === zcodeProtocolMethods.sessionWhiteboardControl) {
+      entered.push("actor");
+      head.resolve();
+      await release.promise;
+    } else if (message.method === zcodeProtocolMethods.sessionWhiteboardProjection)
+      entered.push("projection");
+    else if (message.method === V4_METHODS.command) {
+      entered.push("stop");
+      release.resolve();
+    } else entered.push(String(message.id));
+    return { id: message.id, result: {} };
+  });
+  try {
+    const actor = wire.request(zcodeProtocolMethods.sessionWhiteboardControl, {});
+    await head.promise;
+    const ordinaryA = wire.request(zcodeProtocolMethods.sessionRead, {});
+    const ordinaryB = wire.request(zcodeProtocolMethods.sessionRead, {});
+    await within(
+      wire.request(zcodeProtocolMethods.sessionWhiteboardProjection, {}),
+      "Projection behind actor",
+    );
+    assert.deepEqual(entered, ["actor", "projection"]);
+    await within(
+      wire.request(V4_METHODS.command, { type: "stop", sessionId: "owned" }),
+      "Stop behind queued ordinary calls",
+    );
+    await Promise.all([actor, ordinaryA, ordinaryB]);
+    assert.deepEqual(entered, ["actor", "projection", "stop", "2", "3"]);
+  } finally {
+    release.resolve();
+    await wire.close();
+  }
+});
+
+test("short projection reply survives original half-close drain", async () => {
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  const wire = projectionWireFixture(async (message) => {
+    if (!("id" in message)) return;
+    entered.resolve();
+    await release.promise;
+    return { id: message.id, result: {} };
+  });
+  try {
+    const pending = wire.request(zcodeProtocolMethods.sessionWhiteboardProjection, {});
+    await entered.promise;
+    const closed = wire.end();
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(wire.messages.length, 0);
+    release.resolve();
+    await closed;
+    assert.ok("result" in (await within(pending, "Short EOF projection reply")));
+  } finally {
+    release.resolve();
+    await wire.close();
+  }
+});
+
+test("long projection respects original finite EOF deadline and never sends a late reply", async () => {
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>(),
+    settled = Promise.withResolvers<void>();
+  const wire = projectionWireFixture(async (message) => {
+    if (!("id" in message)) return;
+    entered.resolve();
+    await release.promise;
+    settled.resolve();
+    return { id: message.id, result: {} };
+  });
+  try {
+    void wire.request(zcodeProtocolMethods.sessionWhiteboardProjection, {});
+    await entered.promise;
+    await within(wire.end(), "Finite EOF drain", 500);
+    assert.equal(wire.messages.length, 0);
+    release.resolve();
+    await settled.promise;
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(wire.messages.length, 0);
+  } finally {
+    release.resolve();
+    await wire.close();
+  }
+});
+
+test("projection handler rejection is consumed through the original transport terminal error", async () => {
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  const wire = projectionWireFixture(async () => {
+    entered.resolve();
+    await release.promise;
+    throw new Error("Owned projection failure");
+  });
+  const closed = wire.connection.waitForClose();
+  try {
+    void wire.request(zcodeProtocolMethods.sessionWhiteboardProjection, {});
+    await entered.promise;
+    release.resolve();
+    await assert.rejects(closed, /Owned projection failure/);
+    assert.equal(wire.messages.length, 0);
+  } finally {
+    release.resolve();
+    await wire.close().catch(() => undefined);
+  }
+});
