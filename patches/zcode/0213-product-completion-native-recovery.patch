diff --git a/apps/zcode-cli/packages/telemetry/test/runtime-owner-parity.test.ts b/apps/zcode-cli/packages/telemetry/test/runtime-owner-parity.test.ts
new file mode 100644
index 00000000..8a34b3dd
--- /dev/null
+++ b/apps/zcode-cli/packages/telemetry/test/runtime-owner-parity.test.ts
@@ -0,0 +1,181 @@
+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { context } from "@opentelemetry/api";
+import {
+  BasicTracerProvider,
+  type ReadableSpan,
+  type SpanProcessor,
+} from "@opentelemetry/sdk-trace-base";
+import { AsyncLocalStorageContextManager } from "@opentelemetry/context-async-hooks";
+import { AgentExecutionTelemetryRuntime, ModelApiTelemetryStatusSink } from "@zcode/telemetry";
+
+const manager = new AsyncLocalStorageContextManager().enable();
+context.setGlobalContextManager(manager);
+const providers: BasicTracerProvider[] = [];
+after(async () => {
+  await Promise.all(providers.map((provider) => provider.shutdown()));
+  context.disable();
+  manager.disable();
+});
+
+function fixture(maxActiveWriters = 100) {
+  const started: ReadableSpan[] = [];
+  const ends = new Map<string, number>();
+  const warnings: string[] = [];
+  const processor: SpanProcessor = {
+    onStart(span) {
+      started.push(span);
+    },
+    onEnd(span) {
+      const id = span.spanContext().spanId;
+      ends.set(id, (ends.get(id) ?? 0) + 1);
+    },
+    forceFlush: async () => {},
+    shutdown: async () => {},
+  };
+  const provider = new BasicTracerProvider({ spanProcessors: [processor] });
+  providers.push(provider);
+  const tracer = provider.getTracer("fixture-parity");
+  const runtime = new AgentExecutionTelemetryRuntime({
+    tracer,
+    maxActiveWriters,
+    onWarning: (message) => warnings.push(message),
+  });
+  const execution = {
+    sessionId: "fixture-session",
+    actorKind: "main" as const,
+    launchSurface: "desktop" as const,
+  };
+  return {
+    get spans() {
+      return started.map((span) => ({
+        name: span.name,
+        attributes: span.attributes,
+        ended: ends.get(span.spanContext().spanId) ?? 0,
+      }));
+    },
+    warnings,
+    runtime,
+    execution,
+  };
+}
+
+test("nested turn step tool command writers retain their context and finish once", () => {
+  const f = fixture();
+  f.runtime.updateIdentity({ identityState: "authenticated", userSubjectId: "fixture-subject" });
+  const turn = f.runtime.startTurn({ context: f.execution, inputSource: "user", turnNumber: 1 });
+  turn.run(() => {
+    const step = f.runtime.startStep({ stepId: "fixture-step", stepIndex: 1 });
+    step.run(() => {
+      const tool = f.runtime.startTool({
+        registeredToolName: "fixture",
+        toolCallId: "fixture-tool",
+      });
+      tool.run(() => {
+        tool.markPermissionRequested();
+        tool.setPermissionDecision("granted");
+        const command = tool.startCommand({
+          category: "test",
+          commandCount: 1,
+          safeName: "fixture",
+          sandboxed: true,
+        });
+        command.run(() => command.finishCompleted());
+        tool.finishCompleted();
+      });
+      step.finishCompleted();
+    });
+    turn.finishCompleted("response");
+  });
+  assert.deepEqual(
+    f.spans.map((span) => span.name),
+    ["agent_turn", "agent_step", "tool_execution", "command_execution"],
+  );
+  assert.ok(f.spans.every((span) => span.ended === 1));
+  assert.equal(f.spans[0]!.attributes["zcode.execution.user_subject_id"], "fixture-subject");
+  assert.equal(f.spans[2]!.attributes["zcode.tool_execution.permission_decision"], "granted");
+  assert.equal(f.spans[3]!.attributes["zcode.execution.tool_call_id"], "fixture-tool");
+  assert.equal((f.runtime as unknown as { activeWriters: Set<unknown> }).activeWriters.size, 0);
+  assert.deepEqual(f.warnings, []);
+});
+
+test("capacity fallback and session abandonment share the original runtime writer set", () => {
+  const f = fixture(1);
+  const turn = f.runtime.startTurn({ context: f.execution, inputSource: "user", turnNumber: 1 });
+  const fallback = f.runtime.startTurn({
+    context: { ...f.execution, sessionId: "other" },
+    inputSource: "user",
+    turnNumber: 2,
+  });
+  fallback.run(() => fallback.finishCompleted("response"));
+  assert.equal(f.spans.length, 1);
+  assert.equal(f.warnings.length, 1);
+  f.runtime.abandonSession("fixture-session");
+  assert.equal(f.spans[0]!.attributes["zcode.agent_turn.abandon_reason"], "session_shutdown");
+  assert.equal(f.spans[0]!.ended, 1);
+  turn.finishCompleted("response");
+  const next = f.runtime.startTurn({ context: f.execution, inputSource: "user", turnNumber: 3 });
+  next.finishCompleted("response");
+  assert.equal(f.spans.length, 2);
+  assert.ok(f.spans.every((span) => span.ended === 1));
+});
+
+test("model status retries retain the original call attempt ownership and terminal accounting", () => {
+  const f = fixture();
+  const sink = new ModelApiTelemetryStatusSink({ modelExecution: f.runtime });
+  const base = {
+    providerId: "fixture-provider",
+    providerKind: "fixture",
+    modelId: "fixture-model",
+    baseURL: "https://fixture.invalid/v1/responses",
+    sessionId: "fixture-session",
+    transport: "http" as const,
+    maxAttempts: 2,
+    modelCall: { logicalCallId: "fixture-call", operation: "agent_step" },
+  };
+  sink.publish({ ...base, type: "model_request_started", attempt: 1, requestId: "first" } as never);
+  sink.publish({
+    ...base,
+    type: "model_request_failed",
+    attempt: 1,
+    requestId: "first",
+    reason: "network_error",
+    retryable: true,
+    message: "fixture failure",
+  } as never);
+  assert.equal(sink.activeCallCount, 1);
+  sink.publish({
+    ...base,
+    type: "model_retry_scheduled",
+    attempt: 1,
+    requestId: "first",
+    delayMs: 25,
+  } as never);
+  sink.publish({
+    ...base,
+    type: "model_request_started",
+    attempt: 2,
+    requestId: "second",
+  } as never);
+  sink.publish({
+    ...base,
+    type: "model_request_completed",
+    attempt: 2,
+    requestId: "second",
+    durationMs: 10,
+    usage: { inputTokens: 100, outputTokens: 5 },
+    finishReason: "stop",
+  } as never);
+  assert.equal(sink.activeCallCount, 0);
+  assert.deepEqual(
+    f.spans.map((span) => span.name),
+    ["model_call", "model_attempt", "model_attempt"],
+  );
+  assert.ok(f.spans.every((span) => span.ended === 1));
+  assert.equal(f.spans[2]!.attributes["zcode.model_attempt.previous_request_id"], "first");
+  assert.equal(f.spans[2]!.attributes["zcode.model_attempt.retry_delay_ms"], 25);
+  assert.equal(f.spans[2]!.attributes["zcode.model_attempt.input_tokens"], 100);
+  sink.shutdown();
+  assert.ok(f.spans.every((span) => span.ended === 1));
+  assert.deepEqual(f.warnings, []);
+});
