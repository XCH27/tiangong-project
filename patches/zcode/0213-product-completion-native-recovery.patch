+import { normalize } from "./conversation-telemetry-facts-normalize.js";
+import { clearTurn, clearSession } from "./conversation-telemetry-facts-clear-turn.js";
+import type { ConversationTelemetryFactNormalizerOwner } from "./conversation-telemetry-facts-owner.js";
+
+export function installConversationTelemetryFactNormalizerMethods(
+  prototype: ConversationTelemetryFactNormalizerOwner,
+): void {
+  const methods = {
+    normalize,
+    clearTurn,
+    clearSession,
+  };
+  Object.defineProperties(
+    prototype,
+    Object.fromEntries(
+      Object.entries(methods).map(([name, value]) => [
+        name,
+        { value, writable: true, configurable: true, enumerable: false },
+      ]),
+    ),
+  );
+}
