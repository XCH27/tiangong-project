+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { whiteboardRelativePath } from "@zcode/shared";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { nativePluginFixture } from "./helpers/native-plugin-fixture.js";
+
+const board = () => ({
+  id: `whiteboard:${randomUUID()}`,
+  name: "Native accounting fixture",
+  width: 1280 as const,
+  height: 800 as const,
+  strokes: [],
+  undoneStrokes: [],
+  createdAt: 1,
+  updatedAt: 1,
+});
+const native = () =>
+  fixture(undefined, false, {
+    config: {
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      titleGeneration: { enabled: false },
+    },
+    deps: { fileSystemPort: new NodeFileSystemAdapter() },
+  });
+
+for (const decision of ["allow", "deny", "broker-failure"] as const) {
+  test(`native ${decision} settles one original SQLite usage receipt across cold reopen`, async () => {
+    const f = await native();
+    try {
+      if (decision === "deny") f.deny();
+      if (decision === "broker-failure")
+        f.permissionWith(async () => {
+          throw new Error("Authored broker unavailable");
+        });
+      const document = board();
+      const result = await f.runtime.performWhiteboardControl({
+        operation: "update",
+        input: {
+          document,
+          mutationId: randomUUID(),
+          expectedAbsent: true,
+        },
+      });
+      assert.ok(result.accepted);
+      assert.equal(result.result.success, decision === "allow");
+      const expectedStatus = decision === "allow" ? "completed" : "error";
+      const facts = f.toolFacts();
+      assert.equal(facts.length, 1, JSON.stringify(facts));
+      assert.equal(facts[0]?.status, expectedStatus);
+      assert.equal(facts[0]?.approval_status, decision === "allow" ? "allowed" : "denied");
+      if (decision !== "allow")
+        await assert.rejects(readFile(join(f.dir, whiteboardRelativePath(document.id))), {
+          code: "ENOENT",
+        });
+      await f.reopen();
+      assert.deepEqual(f.toolFacts(), facts);
+      assert.equal(f.requests.length, 0);
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("native Stop during approval settles one cancelled original usage row without a file effect", async () => {
+  const f = await native();
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<{ decision: "allow_once" }>();
+  try {
+    f.permissionWith(async () => {
+      entered.resolve();
+      return release.promise;
+    });
+    const document = board();
+    const pending = f.runtime.performWhiteboardControl({
+      operation: "update",
+      input: {
+        document,
+        mutationId: randomUUID(),
+        expectedAbsent: true,
+      },
+    });
+    await entered.promise;
+    assert.equal(f.runtime.stopActiveForegroundExecution().kind, "stopped");
+    release.resolve({ decision: "allow_once" });
+    const result = await pending;
+    assert.ok(result.accepted && !result.result.success);
+    const facts = f.toolFacts();
+    assert.equal(facts.length, 1, JSON.stringify(facts));
+    assert.equal(facts[0]?.status, "cancelled");
+    assert.equal(facts[0]?.cancelled_by_user, 1);
+    await assert.rejects(readFile(join(f.dir, whiteboardRelativePath(document.id))), {
+      code: "ENOENT",
+    });
+    await f.reopen();
+    assert.deepEqual(f.toolFacts(), facts);
+    assert.equal(f.requests.length, 0);
+  } finally {
+    release.resolve({ decision: "allow_once" });
+    await f.close();
+  }
+});
+
+test("original SDK plugin action uses the same single completed usage receipt", async () => {
+  const x = await nativePluginFixture();
+  try {
+    const result = await x.run();
+    assert.ok(result.accepted && result.result.success);
+    const facts = x.f.toolFacts();
+    assert.equal(facts.length, 1, JSON.stringify(facts));
+    assert.equal(facts[0]?.status, "completed");
+    assert.equal(facts[0]?.approval_status, "allowed");
+    assert.equal(await x.count("counter"), 1);
+    assert.equal(x.f.requests.length, 0);
+  } finally {
+    await x.close();
+  }
+});
