-function normalizeGeneratedCommandName(name: string): string | null {
-  const normalized = name.trim().replace(/^\/+/, "").toLowerCase();
-  if (!/^[a-z0-9][a-z0-9_:-]{0,63}$/.test(normalized)) return null;
-  return normalized;
