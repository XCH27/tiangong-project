index 00000000..dd8e0f86
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-return-stat-prompt-attachment.ts
@@ -0,0 +1,60 @@
+import type { ToolArtifactStorePort, FileSystemPort } from "@zcode/contracts";
+
+import { type TraceContext } from "@zcode/contracts";
+
+import {
+  ZCODE_ATTACHMENT_FAULT_CODES,
+  ZCodeAttachmentFaultError,
+} from "@zcode/shared/zcode-protocol-v4";
+
+import type { ZCodeApp } from "./types.js";
+
+export function createAppReturnStatPromptAttachment(factoryBindings: {
+  readonly resolvePromptAttachment: (input: {
+    ref: string;
+    mime: string;
+    messageId?: string;
+    toolCallId?: string;
+    attachmentIndex?: number;
+  }) => Promise<{ ref: string; mediaType: string; artifactUri?: string }>;
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly traceContext: TraceContext;
+  readonly fileSystemPort: FileSystemPort;
+}): ZCodeApp["statPromptAttachment"] {
+  return (
+    {
+      statPromptAttachment: async (input) => {
+        const { ref, mediaType, artifactUri } =
+          await factoryBindings.resolvePromptAttachment(input);
+        if (artifactUri) {
+          if (!factoryBindings.artifactStore.statToolResultArtifact) {
+            throw new ZCodeAttachmentFaultError(ZCODE_ATTACHMENT_FAULT_CODES.statUnsupported);
+          }
+          const result = await factoryBindings.artifactStore.statToolResultArtifact({
+            uri: artifactUri,
+            trace: factoryBindings.traceContext,
+          });
+          return {
+            totalBytes: result.bytes,
+            mediaType: result.contentType || mediaType,
+            ...(result.mtimeMs === undefined ? {} : { mtimeMs: result.mtimeMs }),
+          };
+        }
+        const result = await factoryBindings.fileSystemPort.stat({
+          path: ref,
+          trace: factoryBindings.traceContext,
+        });
+        if (result.kind !== "file") {
+          // 目录/符号链接/已消失都意味着「这个附件不再是可分享的文件」，用稳定码上抛，
+          // 让 share 预检按确定分类处理，而不是靠错误文本猜。
+          throw new ZCodeAttachmentFaultError(ZCODE_ATTACHMENT_FAULT_CODES.statNotFile);
+        }
+        return {
+          totalBytes: result.sizeBytes,
+          mediaType,
+          ...(result.mtimeMs === undefined ? {} : { mtimeMs: result.mtimeMs }),
+        };
+      },
