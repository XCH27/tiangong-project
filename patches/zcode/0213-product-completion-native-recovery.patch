--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/native-control-ndjson.test.ts
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { PassThrough } from "node:stream";
+import { zcodeProtocolMethods } from "@zcode/shared";
+import { V4_METHODS } from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeProtocolNdjsonConnection } from "../src/zcode-protocol/transport.js";
+
+for (const control of ["stop", "resolveInteraction", "snoozeInteractionAutoResolution", "legacy-stop"]) {
+  test(`actual NDJSON ${control} interrupts the active head despite a later ordinary request`, async () => {
+    const input = new PassThrough(), output = new PassThrough();
+    const entered: string[] = [], received: string[] = [];
+    let resume!: () => void;
+    const held = new Promise<void>(resolve => { resume = resolve; });
+    let interrupt!: () => void;
+    const interrupted = new Promise<void>(resolve => { interrupt = resolve; });
+    output.on("data", data => { received.push(String(data)); });
+    const connection = new ZCodeProtocolNdjsonConnection({ input, output,
+      async handleMessage(message) {
+        if (!("method" in message)) return;
+        if (message.method === zcodeProtocolMethods.sessionWhiteboardControl) {
+          entered.push("native"); await held;
+        } else if (message.method === zcodeProtocolMethods.sessionRead) entered.push("ordinary");
+        else { entered.push(control); interrupt(); resume(); }
+        return { id: message.id, result: { ok: true } };
+      },
+    });
+    connection.start();
+    try {
+      input.write(JSON.stringify({ id: 1, method: zcodeProtocolMethods.sessionWhiteboardControl, params: {} }) + "\n");
+      input.write(JSON.stringify({ id: 2, method: zcodeProtocolMethods.sessionRead, params: {} }) + "\n");
+      input.write(JSON.stringify({ id: 3,
+        method: control === "legacy-stop" ? zcodeProtocolMethods.sessionStop : V4_METHODS.command,
+        params: { type: control, sessionId: "authored-session" } }) + "\n");
+      await Promise.race([interrupted, new Promise((_, reject) => setTimeout(() => reject(new Error("Control was queued behind the operation waiting for it")), 500))]);
+      await new Promise(resolve => setImmediate(resolve));
+      assert.deepEqual(entered, ["native", control, "ordinary"]);
+      assert.ok(received.join("").includes('"id":3'));
+    } finally { resume(); input.end(); await connection.waitForClose(); output.destroy(); }
+  });
+}
diff --git a/apps/zcode-cli/packages/bootstrap/test/native-foreground-host.test.ts b/apps/zcode-cli/packages/bootstrap/test/native-foreground-host.test.ts
