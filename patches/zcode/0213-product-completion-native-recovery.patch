@@ -0,0 +1,80 @@
+import { isDeepStrictEqual } from "node:util";
+import {
+  zcodePluginViewCallToolResultSchema,
+  type ZCodePluginViewCallToolParams,
+  type ZCodePluginViewCallToolResult,
+} from "@zcode/shared";
+import { activateSessionForResume } from "./server-operations.js";
+import {
+  requireSession,
+  ProtocolRequestError,
+  type ZCodeProtocolAgentServerContext,
+} from "./server-types.js";
+import { resolvePluginViewTarget } from "./plugin-views.js";
+
+/** Required wire identities are issued by the original Host/Session bridge, never plugin input. */
+export async function performPluginViewToolControl(
+  context: ZCodeProtocolAgentServerContext,
+  params: ZCodePluginViewCallToolParams,
+): Promise<ZCodePluginViewCallToolResult> {
+  if (!context.sessions.has(params.sessionId))
+    await activateSessionForResume(context, { sessionId: params.sessionId });
+  const record = requireSession(context, params.sessionId, { operation: "native-plugin-view" });
+  if (
+    record.workspace.workspaceKey !== params.workspace.workspaceKey ||
+    record.workspace.workspacePath !== params.workspace.workspacePath ||
+    record.workspace.workspaceIdentity !== params.workspace.workspaceIdentity ||
+    record.workspace.remoteSessionId !== params.workspace.remoteSessionId
+  )
+    throw new ProtocolRequestError(
+      -32602,
+      "Plugin view target does not belong to this Session workspace",
+    );
+  if (record.restoreWarning) throw new ProtocolRequestError(-32009, record.restoreWarning.message);
+  const target = resolvePluginViewTarget(context, record.workspace, params.pluginId, params.viewId);
+  const config = structuredClone(target.config);
+  const assertAvailable = async (signal: AbortSignal) => {
+    signal.throwIfAborted();
+    if (context.sessions.get(params.sessionId) !== record)
+      throw new Error("The owning plugin Session changed before dispatch");
+    const current = resolvePluginViewTarget(
+      context,
+      record.workspace,
+      params.pluginId,
+      params.viewId,
+    );
+    if (
+      current.serverName !== target.serverName ||
+      current.resource !== target.resource ||
+      !isDeepStrictEqual(current.owner, target.owner) ||
+      !isDeepStrictEqual(current.config, config)
+    )
+      throw new Error("The owning plugin view configuration changed before dispatch");
+    signal.throwIfAborted();
+  };
+  const outcome = await record.app.runtime.performPluginViewControl(
+    { serverName: target.serverName, toolName: params.tool, arguments: params.arguments ?? {} },
+    {
+      operationId: params.operationId,
+      expectedServerConfig: config,
+      assertAvailable,
+      traceContext: record.traceContext,
+    },
+  );
+  if (!outcome.accepted)
+    throw new ProtocolRequestError(-32009, `Plugin tool rejected: ${outcome.reason}`);
+  if (!outcome.result.success || !outcome.rawResult)
+    throw new ProtocolRequestError(
+      -32009,
+      outcome.result.error?.message ??
+        "Plugin tool effect/reply could not be confirmed; inspect the original Session receipt before retrying",
+    );
+  // Original MCP normalization/artifacts/receipt remain durable. Only this admitted reply is returned.
+  return zcodePluginViewCallToolResultSchema.parse({
+    content: outcome.rawResult.content,
+    ...(outcome.rawResult.structuredContent !== undefined
+      ? { structuredContent: outcome.rawResult.structuredContent }
+      : {}),
+    ...(outcome.rawResult.isError !== undefined ? { isError: outcome.rawResult.isError } : {}),
+  });
+}
