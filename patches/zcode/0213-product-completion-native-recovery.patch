-        "messages[].role/chars/tokens/contentHash/sectionRefs",
-      ],
-    });
-  }
-
-  if (!hasExactCache) {
-    requests.push({
-      title: "产出逐文本 prompt cache report",
-      eventName: "prompt_cache_report",
-      reason: "Provider usage 只有缓存 token，没有说明哪些文本片段命中缓存。",
-      schema: [
-        "traceId/sessionId/turnId/modelRequestId",
