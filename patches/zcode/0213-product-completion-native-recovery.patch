index 00000000..4724f635
--- /dev/null
+++ b/packages/ui/test/helpers/nativePresentationHost.ts
@@ -0,0 +1,244 @@
+import assert from "node:assert/strict";
+import { PassThrough } from "node:stream";
+import { join } from "node:path";
+import type { TestContext } from "node:test";
+import type { IZCodeAgentService, IPluginManagementService } from "@zcode/services";
+import { zcodeProtocolMethods as M, type ZCodeProtocolMessage } from "@zcode/shared";
+import {
+  V4_METHODS as V,
+  V4_WIRE_PROTOCOL_VERSION,
+  clientHelloSchema,
+  type ConversationTopicWireCandidate,
+} from "@zcode/shared/zcode-protocol-v4";
+import { SqliteSessionStore } from "../../../../apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.js";
+import { ZCodeProtocolAgentServer } from "../../../../apps/zcode-cli/packages/bootstrap/src/zcode-protocol/server.js";
+import { ZCodeProtocolNdjsonConnection } from "../../../../apps/zcode-cli/packages/bootstrap/src/zcode-protocol/transport.js";
+import { appModelFixture } from "../../../../apps/zcode-cli/packages/bootstrap/test/helpers/app-model-completion-fixture.js";
+import { nativePluginViewFixture } from "../../../../apps/zcode-cli/packages/bootstrap/test/helpers/native-plugin-view-fixture.js";
+import { resolveZCodePlugins } from "../../../../apps/zcode-cli/packages/bootstrap/src/plugins.js";
+import { acquireWorkspaceConnection } from "../../src/v4/workspaceConnectionRegistry.js";
+
+export const waitFor = async (condition: () => boolean, label: string) => {
+  for (let i = 0; i < 1000; i++) {
+    if (condition()) return;
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+  throw new Error(`Timed out: ${label}`);
+};
+export async function nativePresentationHost(kind: "whiteboard" | "plugin") {
+  const plugin = kind === "plugin" ? await nativePluginViewFixture() : undefined;
+  const f = plugin?.f ?? (await appModelFixture());
+  const workspace = {
+    workspacePath: join(f.root, "workspace"),
+    workspaceKey: join(f.root, "workspace"),
+  };
+  const store = new SqliteSessionStore({ dbPath: join(f.root, "presentation.sqlite") });
+  const server = new ZCodeProtocolAgentServer({
+    env: plugin?.env ?? {},
+    cwd: workspace.workspacePath,
+    sessionStore: store,
+    ...(plugin ? { mcpPort: plugin.mcp } : {}),
+    createZCodeApp: (options) =>
+      f.create({
+        ...options,
+        sessionStore: store,
+        ...(plugin ? { mcpPort: plugin.mcp } : {}),
+        runtimeConfig: {
+          ...options?.runtimeConfig,
+          workingDirectory: workspace.workspacePath,
+          mcp: {
+            enabled: !!plugin,
+            servers: plugin ? resolveZCodePlugins(plugin.paths).mcpServers : {},
+          },
+          memory: { enabled: false },
+          ...(plugin
+            ? { toolAllowlist: undefined }
+            : { toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"] }),
+        },
+      }),
+  });
+  const incoming = new PassThrough(),
+    outgoing = new PassThrough();
+  const pending = new Map<
+    number,
+    { resolve(value: unknown): void; reject(error: Error): void; creation: boolean }
+  >();
+  const frames = new Set<(frame: ConversationTopicWireCandidate) => void>();
+  const methods: string[] = [];
+  let holdFrames = false;
+  const delayedFrames: ConversationTopicWireCandidate[] = [];
+  let holdCreation = false;
+  const delayedCreationReplies: Array<() => void> = [];
+  let id = 0,
+    buffer = "",
+    permission: ZCodeProtocolMessage | undefined;
+  const send = (message: unknown) => incoming.write(JSON.stringify(message) + "\n");
+  const request = (method: string, params: unknown): Promise<any> => {
+    const requestId = ++id;
+    const creation =
+      method === V.command && (params as { type?: unknown })?.type === "createSession";
+    const promise = new Promise((resolve, reject) =>
+      pending.set(requestId, { resolve, reject, creation }),
+    );
+    send({ id: requestId, method, params });
+    return promise;
+  };
+  const connection = new ZCodeProtocolNdjsonConnection({
+    input: incoming,
+    output: outgoing,
+    handleMessage: async (message) => {
+      if ("method" in message) methods.push(message.method);
+      return server.handleMessage(message);
+    },
+    takePostResponseBatch: (requestId) => server.takePostResponseBatch(requestId),
+    clearPostResponseMessages: () => server.clearPostResponseMessages(),
+  });
+  outgoing.on("data", (chunk) => {
+    buffer += String(chunk);
+    let end: number;
+    while ((end = buffer.indexOf("\n")) >= 0) {
+      const message = JSON.parse(buffer.slice(0, end));
+      buffer = buffer.slice(end + 1);
+      if (message.method === M.sessionRequestRuntimePreferences)
+        send({
+          id: message.id,
+          result: { nativeSearchEnhancementsEnabled: true, memoryEnabled: false },
+        });
+      else if (message.method === M.interactionRequestPermission) permission = message;
+      else if (message.method === "v4/conversation/frame") {
+        if (holdFrames) delayedFrames.push(message.params);
+        else for (const listener of frames) listener(message.params);
+      } else if (pending.has(message.id)) {
+        const result = pending.get(message.id)!;
+        pending.delete(message.id);
+        const settle = () => {
+          if (message.error) result.reject(new Error(JSON.stringify(message.error)));
+          else result.resolve(message.result);
+        };
+        if (holdCreation && result.creation) delayedCreationReplies.push(settle);
+        else settle();
+      }
+    }
+  });
+  server.setNotificationSink((message) => connection.send(message));
+  connection.start();
+  // Authored service boundary only forwards production RPC bytes and notifications.
+  // No projected snapshot/permission frames are fabricated here; the real Host owns them.
+  const agent = {
+    helloConversationV4: async () => ({
+      kind: "hello",
+      protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+      connectionId: "owned",
+      clientMode: "desktop-continuous",
+      deliveryProfile: "continuous",
+      serverTime: Date.now(),
+      capabilities: {
+        nativeDialogs: true,
+        localTerminal: true,
+        binaryFrames: false,
+        compression: "none",
+        workflowRunDeltas: true,
+      },
+      auth: {},
+    }),
+    initializeConversationV4: async (hello: unknown) => {
+      clientHelloSchema.parse(hello);
+    },
+    subscribeConversationV4: (params: {
+      sessionId: string;
+      base?: { logEpoch: string; seq: number };
+    }) =>
+      request(V.conversationSubscribe, {
+        topic: `conversation/${params.sessionId}`,
+        connectionId: "owned",
+        clientMode: "desktop-continuous",
+        workspace,
+        workflowRunDeltas: true,
+        ...(params.base ? { base: params.base } : {}),
+      }),
+    unsubscribeConversationV4: (params: { subscriptionId: string }) =>
+      request(V.conversationUnsubscribe, { subscriptionId: params.subscriptionId }),
+    sendConversationCommandV4: (params: { envelope: unknown }) =>
+      request(V.command, params.envelope),
+    onDynamicConversationFrame:
+      () => (listener: (frame: ConversationTopicWireCandidate) => void) => {
+        frames.add(listener);
+        return { dispose: () => frames.delete(listener) };
+      },
+    onAgentRuntimeRestarted: () => ({ dispose() {} }),
+    performWhiteboardControl: (
+      params: Parameters<IZCodeAgentService["performWhiteboardControl"]>[0],
+    ) =>
+      request(M.sessionWhiteboardControl, {
+        sessionId: params.sessionId,
+        operationId: params.operationId,
+        command: params.command,
+        workspace,
+      }),
+  } as unknown as IZCodeAgentService;
+  const plugins = {
+    callPluginViewTool: (params: Parameters<IPluginManagementService["callPluginViewTool"]>[0]) =>
+      request(M.pluginsViewCallTool, {
+        sessionId: params.sessionId,
+        operationId: params.operationId,
+        pluginId: params.pluginId,
+        viewId: params.viewId,
+        tool: params.tool,
+        arguments: params.arguments,
+        workspace,
+      }),
+  } as unknown as IPluginManagementService;
+  // This observer holds the SAME original registry entry as the public consumer/pane.
+  const observer = acquireWorkspaceConnection(workspace, agent);
+  return {
+    f,
+    plugin,
+    store,
+    workspace,
+    agent,
+    plugins,
+    observer,
+    methods,
+    request,
+    holdCreation() {
+      holdCreation = true;
+    },
+    get heldCreations() {
+      return delayedCreationReplies.length;
+    },
+    releaseCreation() {
+      holdCreation = false;
+      for (const settle of delayedCreationReplies.splice(0)) settle();
+    },
+    holdFrames() {
+      holdFrames = true;
+    },
+    releaseFrames() {
+      holdFrames = false;
+      for (const frame of delayedFrames.splice(0)) for (const listener of frames) listener(frame);
+    },
+    get permission() {
+      return permission;
+    },
+    answer(decision: "allow" | "deny") {
+      assert.ok(permission && "id" in permission);
+      send({ id: permission.id, result: { decision } });
+    },
+    async close(t: TestContext) {
+      incoming.end();
+      await connection.waitForClose();
+      await server.shutdown();
+      server.disposeProjections();
+      store.close();
+      if (plugin) await plugin.close();
+      else await f.close();
+      outgoing.destroy();
+      // Dispose the real layer before fake clocks replace clearTimeout: existing real
+      // keep-warm timers must be cleared by their original owner on the real clock.
+      observer.layer.dispose();
+      t.mock.timers.enable({ apis: ["setTimeout"] });
+      observer.release();
+      t.mock.timers.tick(30_001);
+    },
+  };
+}
diff --git a/packages/ui/test/helpers/nativePresentationResume.ts b/packages/ui/test/helpers/nativePresentationResume.ts
