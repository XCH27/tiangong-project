@@ -0,0 +1,131 @@
+import { classifyModelFailure } from "./failure-classifier.js";
+
+import { unwrapRetryError } from "./failure-inspection.js";
+
+import { createGenerateTextOptions } from "./runner-options.js";
+
+import { recordGenerateTextDebug } from "./runner-debug.js";
+
+import { toAdapterError } from "./runner-retry.js";
+import { createStatusContext, publishModelStatus } from "./runner-status.js";
+
+import type { AiSdkModelTextRequest, ResolvedAiSdkModel } from "./runner-runtime.js";
+
+import { modelFailureStatusFields } from "./runner-telemetry.js";
+
+import { type AttemptAdmission } from "./request-admission.js";
+
+import { statusPublishOptions } from "./generate-attempt-status.js";
+
+import type { runGenerateText } from "./runner-generate.js";
+type GenerateInput = Parameters<typeof runGenerateText>[0];
+
+export async function publishGenerateAdmissionFailure(
+  input: GenerateInput,
+  admitError: unknown,
+  statusContext: ReturnType<typeof createStatusContext>,
+  attempt: number,
+  requestHeaderCount: number,
+  requestHeaders: Record<string, string>,
+): Promise<never> {
+  const admitFailure = classifyModelFailure(admitError, input.request.abortSignal);
+  await publishModelStatus(
+    {
+      ...statusContext,
+      attempt,
+      message: admitFailure.message,
+      reason: admitFailure.reason,
+      requestHeaderCount,
+      requestHeaders,
+      retryable: false,
+      statusCode: admitFailure.statusCode,
+      ...modelFailureStatusFields(admitError, admitFailure, "connect"),
+      timestamp: new Date().toISOString(),
+      type: "model_request_failed",
+    },
+    {
+      ...statusPublishOptions(input),
+      failureError: unwrapRetryError(admitError),
+    },
+  );
+  throw toAdapterError(admitError, admitFailure, statusContext, attempt, {
+    errorPhase: "connect",
+  });
+}
+export async function publishGenerateAttemptFailure(context: {
+  input: GenerateInput;
+  attempt: number;
+  error: unknown;
+  isDev: boolean;
+  options: ReturnType<typeof createGenerateTextOptions> | undefined;
+  recordModelIO: boolean;
+  attemptRequest: AiSdkModelTextRequest;
+  statusContext: ReturnType<typeof createStatusContext>;
+  resolved: ResolvedAiSdkModel;
+  startedAt: number;
+  completedAt: number;
+  failure: ReturnType<typeof classifyModelFailure>;
+  requestHeaderCount: number;
+  requestHeaders: Record<string, string>;
+  responseHeaders: Record<string, string>;
+  canRetry: boolean;
+  admission: AttemptAdmission;
+}): Promise<void> {
+  const {
+    input,
+    attempt,
+    error,
+    isDev,
+    options,
+    recordModelIO,
+    attemptRequest,
+    statusContext,
+    resolved,
+    startedAt,
+    completedAt,
+    failure,
+    requestHeaderCount,
+    requestHeaders,
+    responseHeaders,
+    canRetry,
+    admission,
+  } = context;
+  if (options) {
+    recordGenerateTextDebug({
+      modelIoFullRetentionEnabled: input.modelIoFullRetentionEnabled,
+      attempt,
+      debugDir: input.debugDir,
+      error,
+      isDev,
+      normalizedToolCalls: undefined,
+      options,
+      recordModelIO,
+      request: attemptRequest,
+      requestId: statusContext.requestId,
+      resolved,
+      startedAt,
+    });
+  }
+  await publishModelStatus(
+    {
+      ...statusContext,
+      attempt,
+      durationMs: completedAt - startedAt,
+      message: failure.message,
+      reason: failure.reason,
+      requestHeaderCount,
+      requestHeaders,
+      responseHeaderCount: Object.keys(responseHeaders).length,
+      responseHeaders,
+      retryable: canRetry,
+      statusCode: failure.statusCode,
+      ...modelFailureStatusFields(error, failure, options ? "response" : "prepare"),
+      timestamp: new Date(completedAt).toISOString(),
+      type: "model_request_failed",
+    },
+    {
+      ...statusPublishOptions(input, admission),
+      failureError: unwrapRetryError(error),
+    },
+  );
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/generate-result-preparation.ts b/apps/zcode-cli/packages/adapters/src/model/generate-result-preparation.ts
