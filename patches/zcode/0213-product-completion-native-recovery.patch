+import type { ConversationV4GatewayOwner } from "./v4-gateway-owner.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import {
+  backgroundBashOutputResultSchema,
+  v4BackgroundBashOutputParamsSchema,
