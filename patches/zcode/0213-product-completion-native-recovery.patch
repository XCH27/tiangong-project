+
+test("the real SDK's determinate pre-send NotConnected still reconnects once and sends one effect", async () => {
+  const x = await ownedMcpFixture();
+  try {
+    await x.mcp.connectServer("counter", x.original, { workingDirectory: x.f.dir });
