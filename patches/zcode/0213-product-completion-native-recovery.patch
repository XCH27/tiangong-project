+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import * as model from "@zcode/contracts/model";
+import * as workflow from "@zcode/contracts/workflow";
+import * as modelSchemas from "../dist/model/model-json-schema.js";
+import * as modelUsage from "../dist/model/model-usage.js";
+import { EventReducer, SessionEventType } from "@zcode/contracts";
+
+const baseline = JSON.parse(await readFile(new URL("./fixtures/public-surface.json", import.meta.url), "utf8"));
+const hash = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+
+test("the existing public entrypoints expose the same runtime symbols", async () => {
+  // Recorded from the current-source 8c347cb build, before extracting declarations.
+  for (const [path, fingerprint] of Object.entries(baseline.exports)) {
+    const surface = await import(new URL(`../dist/${path}`, import.meta.url).href);
+    assert.equal(hash(Object.keys(surface).sort()), fingerprint, path);
+  }
+});
+
+test("model schemas retain exact content and the original entrypoints forward one identity", () => {
+  for (const [name, fingerprint] of Object.entries(baseline.schemas)) {
+    const key = name as keyof typeof modelSchemas;
+    assert.equal(hash(model[key]), fingerprint, name);
+    assert.equal(model[key], modelSchemas[key], name);
+  }
+  assert.equal(model.getModelUsageContextTokens, modelUsage.getModelUsageContextTokens);
+  assert.equal(model.getModelUsageContextTokens({ inputTokens: 100, cacheReadTokens: 50, outputTokens: 10 }), 110);
+  assert.equal(model.getModelUsageContextTokens({ totalTokens: 200, outputTokens: 10 }), 200);
+});
+
+test("workflow schema and scheduler still accept the same empty graph", () => {
+  const graph = workflow.WorkflowGraphSchema.parse({ nodes: [], edges: [], collections: [] });
+  assert.deepEqual(workflow.deriveWorkflowSchedulerState(graph), baseline.emptyScheduler);
+});
+
+test("reducer instances retain separate handlers and the same unknown-event fallback", () => {
+  const first = new EventReducer();
+  const second = new EventReducer();
+  const event = { type: SessionEventType.SessionCreated, sessionId: "fixture", timestamp: 10,
+    payload: { mode: "default", contextWindow: 100 } } as never;
+  const projection = first.reduce([event]);
+  assert.deepEqual(projection, second.reduce([event]));
+  assert.deepEqual(first.apply(projection, { type: "fixture/unknown", timestamp: 20 } as never), { ...projection, updatedAt: 20 });
+  const firstHandlers = (first as unknown as { handlers: Record<string, unknown> }).handlers;
+  const secondHandlers = (second as unknown as { handlers: Record<string, unknown> }).handlers;
+  assert.deepEqual(Object.keys(firstHandlers), Object.keys(secondHandlers));
+  for (const key of Object.keys(firstHandlers)) assert.notEqual(firstHandlers[key], secondHandlers[key]);
+});
