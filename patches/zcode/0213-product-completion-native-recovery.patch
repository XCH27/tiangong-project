+    tryBatchHydration,
+    projectionLimitForEvent,
+    subscribe,
+    subscribeReserved,
+    unsubscribe,
+    hasSubscription,
+    hasSubscribers,
+    connectionIdForSubscription,
+    reserveFlush,
+    flush,
+    resyncReserved,
+    resyncRollback,
+    resync,
+    reserveFrame,
+    subscribeResult,
+    ackFor,
+    frameShell,
+  };
+  Object.defineProperties(
+    prototype,
+    Object.fromEntries(
+      Object.entries(methods).map(([name, value]) => [
+        name,
+        value === undefined
+          ? accessors[name]
+          : { value, writable: true, configurable: true, enumerable: false },
+      ]),
+    ),
+  );
+}
