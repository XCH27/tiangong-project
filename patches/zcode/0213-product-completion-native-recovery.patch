+  test("actual same-ID versions and distinct pending IDs retain their original capacity limits", async () => {
+    const h = await productionHandoffFixture();
+    try {
+      const app = await h.createSession();
+      const distinct = Array.from(
+        { length: ARTIFACT_CAPS.maxArtifactsPerRun + 1 },
