-function eventCorrelationId(
-  payload: Record<string, unknown> | undefined,
-  names: string[],
-): string | undefined {
-  for (const name of names) {
-    const value = stringValue(payload?.[name]);
-    if (value) return value;
-  }
-  return undefined;
