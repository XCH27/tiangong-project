@@ -0,0 +1,53 @@
+import {
+  WHITEBOARD_DOCUMENT_MAX_BYTES, whiteboardReadInputSchema, whiteboardUpdateInputSchema,
+  whiteboardReadInputJsonSchema, whiteboardUpdateInputJsonSchema,
+} from "@zcode/shared";
+import type { JsonSchema } from "@zcode/contracts";
+import type { ToolEntry } from "../types.js";
+import { listWhiteboardFiles, readWhiteboardFile, updateWhiteboardFile } from "./whiteboard-files.js";
+
+function entry(write: boolean): ToolEntry {
+  const name = write ? "WhiteboardUpdate" : "ReadWhiteboard";
+  const schema = write ? whiteboardUpdateInputSchema : whiteboardReadInputSchema;
+  return {
+    capability: write ? "Save the native workspace drawing with an exact revision" : "Read a complete native workspace drawing and its revision",
+    metadata: { name,
+      description: write
+        ? "Save the existing 1280×800 native stroke document in this Session workspace. ReadWhiteboard first and use its exact fileRevision, or explicitly expect absence for a new UUID. Keep mutationId stable when retrying the same document after an uncertain receipt. Conflict requires reconciling both versions; never silently replace another edit. Clear/replace requires the same approval. No caller-supplied path or alternate workspace."
+        : "Discover saved whiteboards with list:true, or read one by boardId (whiteboard:UUID) from this Session workspace. Returns the versioned document and exact file revision for WhiteboardUpdate. Unknown versions, symlinks or corrupt files are visible errors; never overwrite them. The native file is the editable authority.",
+      readOnly: !write, destructive: write, concurrentSafe: !write,
+      sideEffectScope: write ? "workspace" : "none", riskLevel: write ? "high" : "low", needsApproval: write },
+    validateInput(input) {
+      if (!schema.safeParse(input).success || Buffer.byteLength(JSON.stringify(input), "utf8") > WHITEBOARD_DOCUMENT_MAX_BYTES)
+        return { result: false, errorCode: 32, message: "Invalid or oversized native whiteboard input; keep the draft" };
+      return { result: true };
+    },
+    handler: async (input, context) => {
+      context.abortSignal.throwIfAborted();
+      if (write) return updateWhiteboardFile(whiteboardUpdateInputSchema.parse(input), context);
+      const read = whiteboardReadInputSchema.parse(input);
+      if ("list" in read) return listWhiteboardFiles(context);
+      const result = await readWhiteboardFile(read.boardId, context);
+      return { document: result.document, fileRevision: result.fileRevision, filePath: result.relativePath };
+    },
+    inputSchema: (write ? whiteboardUpdateInputJsonSchema : whiteboardReadInputJsonSchema) as JsonSchema,
+    outputSchema: { type: "object", properties: {}, additionalProperties: true },
+    runtimeInputSchema: schema,
+    formatModelContent(output) {
+      if (!write) return JSON.stringify(output);
+      const value = output as { document?: { revision?: number; board?: { id?: string } }; observed?: boolean };
+      return `Native whiteboard ${value.document?.board?.id} saved at revision ${value.document?.revision}${value.observed ? " (observed existing mutation)" : ""}. ReadWhiteboard to inspect it.`;
+    },
+    permission: { permission: write ? "edit" : "read", reason: write ? "Save or replace this native project whiteboard" : "Read this native project whiteboard",
+      riskLevel: write ? "high" : "low", sideEffectScope: write ? "workspace" : "none", needsApproval: write,
+      ...(write ? { alwaysAsk: true, askOptions: { allowAlways: false as const } } : {}),
+      patternSources: ["toolName"], alwaysAllowPatternSources: [], denyPriority: "beforeAsk" },
+    resultBudget: { maxInlineBytes: WHITEBOARD_DOCUMENT_MAX_BYTES * 3, maxModelBytes: write ? 4096 : 100000,
+      strategy: "truncate", preview: { maxBytes: 100000, direction: "head" } },
+    timeout: { kind: "timed", defaultMs: 30000, maxMs: 30000, allowCallOverride: false },
+    cancellation: { supported: true, cleanup: "bestEffort", userVisibleMessage: "Whiteboard operation cancelled; retain the draft and read the file to reconcile" },
+    trace: { required: true, propagateToAdapters: true, recordInput: "summary", recordOutput: "summary" },
+  };
+}
+export const readWhiteboardToolEntry = entry(false);
+export const updateWhiteboardToolEntry = entry(true);
