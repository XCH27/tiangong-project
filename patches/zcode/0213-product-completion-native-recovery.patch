--- /dev/null
+++ b/packages/ui/src/lib/nativeWhiteboardServices.ts
@@ -0,0 +1,37 @@
+import type { IServiceAccessor } from "@zcode/services";
+import {
+  getRegisteredBaseWorkspaceServices,
+  getRemoteWorkspaceServicesForIdentity,
+  getRemoteWorkspaceSession,
+  useRemoteWorkspaceSessionStore,
+} from "../store/remoteWorkspaceSessionStore.js";
+import type { NativeWhiteboardWorkspace } from "./nativeWhiteboardControl.js";
+
+/** Resolve the original Host. A disconnected remote never falls back to the local attachment. */
+export function nativeWhiteboardServices(
+  scope: NativeWhiteboardWorkspace,
+  local?: IServiceAccessor,
+): IServiceAccessor {
+  const remote = scope.workspaceIdentity
+    ? getRemoteWorkspaceServicesForIdentity(scope.workspaceIdentity)
+    : scope.remoteSessionId
+      ? getRemoteWorkspaceSession(scope.remoteSessionId)?.services
+      : null;
+  if (scope.workspaceIdentity || scope.remoteSessionId) {
+    if (!remote) throw new Error("whiteboard.hostUnavailable");
+    return remote;
+  }
+  const services = getRegisteredBaseWorkspaceServices() ?? local;
+  if (!services) throw new Error("whiteboard.hostUnavailable");
+  return services;
+}
+
+/** Endpoint generations are read from the original registry; hidden drafts retain stable workspace identity. */
+export function currentNativeWhiteboardWorkspace(
+  scope: NativeWhiteboardWorkspace,
+): NativeWhiteboardWorkspace {
+  if (!scope.workspaceIdentity) return scope;
+  const id =
+    useRemoteWorkspaceSessionStore.getState().sessionIdByWorkspaceIdentity[scope.workspaceIdentity];
+  return id ? { ...scope, remoteSessionId: id } : scope;
+}
diff --git a/packages/ui/src/lib/pluginViewBridge.ts b/packages/ui/src/lib/pluginViewBridge.ts
new file mode 100644
index 00000000..8c3e6e0d
--- /dev/null
+++ b/packages/ui/src/lib/pluginViewBridge.ts
@@ -0,0 +1,215 @@
+import type { IZCodeAgentService, IPluginManagementService } from "@zcode/services";
+import type { ZCodePluginViewReadResult } from "@zcode/shared";
+import { logger } from "../logger.js";
+import {
+  callNativePluginViewTool,
+  type NativePluginViewTarget,
+} from "./nativePluginViewControl.js";
+
+const PROTOCOL_VERSION = "2026-01-26";
+const DOMAIN_PATTERN = /^https?:\/\/[A-Za-z0-9.*:-]+$/;
+
+// MCP Apps standardized theme variables ← Fleet design tokens (DESIGN.md plugin UI contract).
+const THEME_VARIABLES: Record<string, string> = {
+  "--color-background-primary": "--color-background",
+  "--color-background-secondary": "--color-panel",
+  "--color-background-tertiary": "--color-card",
+  "--color-background-ghost": "--color-hover",
+  "--color-background-danger": "--color-destructive",
+  "--color-text-primary": "--color-foreground",
+  "--color-text-secondary": "--color-foreground-subtle",
+  "--color-text-tertiary": "--color-foreground-subtlest",
+  "--color-text-inverse": "--color-foreground-inverse",
+  "--color-text-danger": "--color-destructive",
+  "--color-border-primary": "--color-border",
+  "--color-border-secondary": "--color-border-hover",
+};
+
+function domainList(values: readonly string[] | undefined): string {
+  return (values ?? []).filter((value) => DOMAIN_PATTERN.test(value)).join(" ");
+}
+
+/** The view's CSP: the MCP Apps restrictive default plus only the domains the resource declared. */
+export function buildPluginViewDocument(view: ZCodePluginViewReadResult): string {
+  const resources = domainList(view.csp?.resourceDomains);
+  const connect = domainList(view.csp?.connectDomains);
+  const policy = [
+    "default-src 'none'",
+    `script-src 'unsafe-inline' ${resources}`.trim(),
+    `style-src 'unsafe-inline' ${resources}`.trim(),
+    `img-src data: blob: ${resources}`.trim(),
+    `font-src data: ${resources}`.trim(),
+    `media-src data: blob: ${resources}`.trim(),
+    `connect-src ${connect || "'none'"}`,
+    "frame-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "form-action 'none'",
+  ].join("; ");
+  const meta = `<meta http-equiv="Content-Security-Policy" content="${policy}">`;
+  return /<head[^>]*>/i.test(view.html)
+    ? view.html.replace(/<head[^>]*>/i, (head) => `${head}${meta}`)
+    : `${meta}${view.html}`;
+}
+
+function themeVariables(): Record<string, string> {
+  const style = getComputedStyle(document.documentElement);
+  const variables: Record<string, string> = {};
+  for (const [appVariable, fleetVariable] of Object.entries(THEME_VARIABLES)) {
+    const value = style.getPropertyValue(fleetVariable).trim();
+    if (value) variables[appVariable] = value;
+  }
+  const font = getComputedStyle(document.body).fontFamily;
+  if (font) variables["--font-sans"] = font;
+  return variables;
+}
+
+function currentTheme(): "light" | "dark" {
+  return document.documentElement.classList.contains("dark") ? "dark" : "light";
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+export type PluginViewFrameState = {
+  documentEpoch: number;
+  pending: boolean;
+  initialized: boolean;
+  loaded: boolean;
+};
+
+/** A load after the initial document retires old receipts while preserving original admission. */
+export function pluginViewFrameLoaded(state: PluginViewFrameState): void {
+  if (state.loaded) {
+    state.documentEpoch++;
+    state.initialized = false;
+  }
+  state.loaded = true;
+}
+
+/** Replies belong to the captured opaque iframe, never to a later ref or connection. */
+export function installPluginViewBridge(input: {
+  frame: Window;
+  state: PluginViewFrameState;
+  target: NativePluginViewTarget;
+  agent: IZCodeAgentService;
+  plugins: IPluginManagementService;
+  locale: () => string;
+  sessionId: () => string | null | undefined;
+  isCurrent: () => boolean;
+  onOpenBrowserUrl: (url: string) => void;
+}): () => void {
+  let disposed = false;
+  const current = () => !disposed && input.isCurrent();
+  const post = (message: Record<string, unknown>, epoch = input.state.documentEpoch) => {
+    if (current() && epoch === input.state.documentEpoch)
+      input.frame.postMessage({ jsonrpc: "2.0", ...message }, "*");
+  };
+  const respond = (id: string | number, result: unknown, epoch = input.state.documentEpoch) =>
+    post({ id, result }, epoch);
+  const fail = (
+    id: string | number,
+    message: string,
+    code = -32603,
+    epoch = input.state.documentEpoch,
+  ) => post({ id, error: { code, message } }, epoch);
+  const handle = async (data: Record<string, unknown>) => {
+    const { id, method } = data;
+    if (id === undefined) {
+      if (method === "notifications/message")
+        logger.info("[plugin-view]", { ...input.target, params: data.params });
+      return;
+    }
+    if (typeof id !== "string" && (typeof id !== "number" || !Number.isFinite(id))) return;
+    if (typeof method !== "string") return fail(id, "Invalid JSON-RPC method", -32600);
+    if (data.params !== undefined && !record(data.params))
+      return fail(id, "Invalid JSON-RPC params", -32602);
+    const params = data.params ?? {};
+    switch (method) {
+      case "ui/initialize":
+        // A reinitialization is another connection boundary even before the iframe's load event.
+        if (input.state.initialized) input.state.documentEpoch++;
+        input.state.initialized = true;
+        return respond(id, {
+          protocolVersion:
+            typeof params.protocolVersion === "string" ? params.protocolVersion : PROTOCOL_VERSION,
+          hostInfo: { name: "Fleet", version: "1" },
+          hostCapabilities: { openLinks: {}, serverTools: {}, logging: {} },
+          hostContext: {
+            theme: currentTheme(),
+            styles: { variables: themeVariables() },
+            displayMode: "inline",
+            availableDisplayModes: ["inline"],
+            locale: input.locale(),
+            timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
+            platform: "desktop",
+          },
+        });
+      case "ping":
+        return respond(id, {});
+      case "tools/call": {
+        if (typeof params.name !== "string" || !params.name.trim())
+          return fail(id, "tools/call needs a tool name", -32602);
+        if (params.arguments !== undefined && !record(params.arguments))
+          return fail(id, "tools/call arguments must be an object", -32602);
+        if (input.state.pending)
+          return fail(
+            id,
+            "A plugin tool is already pending; wait for its original receipt",
+            -32000,
+          );
+        input.state.pending = true;
+        const epoch = input.state.documentEpoch;
+        try {
+          const result = await callNativePluginViewTool({
+            target: input.target,
+            agent: input.agent,
+            plugins: input.plugins,
+            sessionId: input.sessionId(),
+            tool: params.name,
+            arguments: params.arguments,
+            isCurrent: () => current() && epoch === input.state.documentEpoch,
+          });
+          respond(id, result, epoch);
+        } catch (reason) {
+          fail(id, reason instanceof Error ? reason.message : String(reason), -32603, epoch);
+        } finally {
+          input.state.pending = false;
+        }
+        return;
+      }
+      case "ui/open-link": {
+        const url = typeof params.url === "string" ? params.url : "";
+        if (!/^https?:\/\//.test(url)) return fail(id, "Only http(s) links can be opened", -32602);
+        input.onOpenBrowserUrl(url);
+        return respond(id, {});
+      }
+      default:
+        return fail(id, `${method} is not supported by Fleet yet`, -32601);
+    }
+  };
+  const listener = (event: MessageEvent) => {
+    if (
+      !current() ||
+      event.source !== input.frame ||
+      !record(event.data) ||
+      event.data.jsonrpc !== "2.0"
+    )
+      return;
+    void handle(event.data);
+  };
+  window.addEventListener("message", listener);
+  const observer = new MutationObserver(() =>
+    post({
+      method: "ui/notifications/host-context-changed",
+      params: { theme: currentTheme(), styles: { variables: themeVariables() } },
+    }),
+  );
+  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
+  return () => {
+    disposed = true;
+    window.removeEventListener("message", listener);
+    observer.disconnect();
+  };
+}
