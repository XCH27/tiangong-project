@@ -0,0 +1,47 @@
+import { buildWhiteboardWorkspaceKey } from "./whiteboard.js";
+import type { WhiteboardTarget } from "../store/whiteboardNativeProjection.js";
+
+const FLUSH = "zcode:flush-whiteboard-gesture";
+const QUERY = "zcode:query-whiteboard-gesture";
+
+/** Synchronous projection signal; the mounted canvas keeps ownership of its pointer stroke. */
+export function flushWhiteboardGestures(target?: WhiteboardTarget): void {
+  if (typeof window !== "undefined")
+    window.dispatchEvent(new CustomEvent(FLUSH, { detail: target }));
+}
+
+export function hasWhiteboardGesture(target: WhiteboardTarget): boolean {
+  const detail = { target, active: false };
+  if (typeof window !== "undefined") window.dispatchEvent(new CustomEvent(QUERY, { detail }));
+  return detail.active;
+}
+
+export function onWhiteboardGestureFlush(
+  target: WhiteboardTarget,
+  flush: () => void,
+  hasGesture: () => boolean,
+): () => void {
+  const listener = (event: Event) => {
+    const requested = (event as CustomEvent<WhiteboardTarget | undefined>).detail;
+    if (
+      !requested ||
+      (requested.boardId === target.boardId &&
+        buildWhiteboardWorkspaceKey(requested) === buildWhiteboardWorkspaceKey(target))
+    )
+      flush();
+  };
+  const query = (event: Event) => {
+    const detail = (event as CustomEvent<{ target: WhiteboardTarget; active: boolean }>).detail;
+    if (
+      detail.target.boardId === target.boardId &&
+      buildWhiteboardWorkspaceKey(detail.target) === buildWhiteboardWorkspaceKey(target)
+    )
+      detail.active ||= hasGesture();
+  };
+  window.addEventListener(FLUSH, listener);
+  window.addEventListener(QUERY, query);
+  return () => {
+    window.removeEventListener(FLUSH, listener);
+    window.removeEventListener(QUERY, query);
+  };
+}
