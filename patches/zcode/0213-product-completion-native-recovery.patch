--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-gateway-host-on-target-completed.ts
@@ -0,0 +1,34 @@
+import type { V4GatewayHost } from "../zcode-protocol-v4/v4-gateway.js";
+
+import type {
+  ZCodeProtocolAgentServerContext,
+  ZCodeProtocolSessionRecord,
+} from "./server-types.js";
+
+export function createV4GatewayHostOnTargetCompleted(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+  readonly autoDrainV4QueueIfReady: (record: ZCodeProtocolSessionRecord) => Promise<void>;
+}): V4GatewayHost["onTargetCompleted"] {
+  return (
+    {
+      onTargetCompleted: (sessionId) => {
+        const record = factoryBindings.context.sessions.get(sessionId);
+        if (!record) return;
+        // background task-notification 的 goal verifier 不经过 v4 prompt 的
+        // finally/afterLegacyStateMutation；TargetChanged(complete) 虽已提交，future queue
+        // 因而没有下一次 mutation 来重评。这里只 detached 触发既有 gate，不能阻塞投影。
+        void Promise.resolve()
+          .then(() => factoryBindings.autoDrainV4QueueIfReady(record))
+          .catch((error: unknown) => {
+            factoryBindings.context.logger?.warn(
+              "v4 auto-drain reevaluation after target completion failed",
+              {
+                error: error instanceof Error ? error.message : String(error),
+                sessionId,
+              },
+            );
+          });
+      },
+    } satisfies Pick<V4GatewayHost, "onTargetCompleted">
+  ).onTargetCompleted;
+}
