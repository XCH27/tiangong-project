-        ? await this.ensureColdReadyPublisher(
-            sessionId,
-            params.resumeThoughtLevel,
-            params.workspace,
-          )
-        : await this.hydratePublisher(sessionId);
-    const cliSessionRestoreMs = !isLiveConversation
-      ? Math.max(0, Math.round(performance.now() - restoreStartedAt))
-      : undefined;
