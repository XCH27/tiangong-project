+import type { V4GatewayHost } from "../zcode-protocol-v4/v4-gateway.js";
+
+import { lookupGlobalCreateSessionCommand } from "../zcode-protocol-v4/create-session-command-fact.js";
+
+import { PersistentCommandIndex } from "../zcode-protocol-v4/persistent-command-index.js";
+
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function createV4GatewayHostLookupTranscriptCommand(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+  readonly persistentCommands: PersistentCommandIndex;
+}): V4GatewayHost["lookupTranscriptCommand"] {
+  return (
+    {
+      lookupTranscriptCommand: (key) =>
+        key.sessionId === null
+          ? lookupGlobalCreateSessionCommand(
+              factoryBindings.context.deps.sessionStore,
+              key.commandId,
+            )
+          : factoryBindings.persistentCommands.lookup("transcript", key),
