+import assert from "node:assert/strict";
+import { join } from "node:path";
+import { zcodeProtocolMethods } from "@zcode/shared";
+import { SqliteSessionStore } from "../../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { resolveZCodePlugins } from "../../src/plugins.js";
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { nativePluginViewFixture } from "./native-plugin-view-fixture.js";
+
+export async function nativePluginHostFixture() {
+  const x = await nativePluginViewFixture();
+  const dbPath = join(x.f.root, "plugin-host.sqlite");
+  let store = new SqliteSessionStore({ dbPath }),
+    server: ZCodeProtocolAgentServer;
+  let id = 0,
+    permissions = 0;
+  let onApproval: (() => void | Promise<void>) | undefined;
+  let decision: "allow" | "deny" = "allow";
+  const create = () => {
+    server = new ZCodeProtocolAgentServer({
+      env: x.env,
+      cwd: x.workspace,
+      sessionStore: store,
+      mcpPort: x.mcp,
+      createZCodeApp: (options) =>
+        x.f.create({
+          ...options,
+          sessionStore: store,
+          mcpPort: x.mcp,
+          runtimeConfig: {
+            ...options.runtimeConfig,
+            workingDirectory: x.workspace,
+            mcp: { enabled: true, servers: resolveZCodePlugins(x.paths).mcpServers },
+            toolAllowlist: undefined,
+            memory: { enabled: false },
+          },
+        }),
+    });
+    server.setNotificationSink((message) => {
+      if (!("method" in message) || !("id" in message)) return;
+      if (message.method === zcodeProtocolMethods.sessionRequestRuntimePreferences)
+        void server.handleMessage({
+          id: message.id,
+          result: { nativeSearchEnhancementsEnabled: true, memoryEnabled: false },
+        });
+      if (message.method === zcodeProtocolMethods.interactionRequestPermission) {
+        permissions++;
+        void Promise.resolve(onApproval?.()).then(() =>
+          server.handleMessage({ id: message.id, result: { decision } }),
+        );
+      }
+    });
+  };
+  create();
+  return {
+    ...x,
+    get store() {
+      return store;
+    },
+    get permissions() {
+      return permissions;
+    },
+    approveWith(fn: () => void | Promise<void>) {
+      onApproval = fn;
+    },
+    deny() {
+      decision = "deny";
+    },
+    async request(method: string, params: unknown) {
+      const response = await server.handleMessage({ id: ++id, method, params } as never);
+      assert.ok(response && "result" in response, JSON.stringify(response));
+      return response.result as any;
+    },
+    raw(method: string, params: unknown) {
+      return server.handleMessage({ id: ++id, method, params } as never);
+    },
+    async restart() {
+      await server.shutdown();
+      server.disposeProjections();
+      store.close();
+      store = new SqliteSessionStore({ dbPath });
+      create();
+    },
+    async close() {
+      await server.shutdown();
+      server.disposeProjections();
+      await x.close();
+      store.close();
+    },
+  };
+}
