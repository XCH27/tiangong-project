+import type { McpConnectMethods } from "./adapter-connect-methods.js";
+import type { McpCallMethods } from "./adapter-call-methods.js";
+import type { McpAuthorizationMethods } from "./adapter-authorization-methods.js";
+import type { McpOpeningMethods } from "./adapter-opening-methods.js";
+import type { McpOauthMethods } from "./adapter-oauth-methods.js";
+import type { McpTransportMethods } from "./adapter-transport-methods.js";
+import type { McpRecordsMethods } from "./adapter-records-methods.js";
+export type McpAdapterMethods = McpConnectMethods &
+  McpCallMethods &
+  McpAuthorizationMethods &
+  McpOpeningMethods &
+  McpOauthMethods &
+  McpTransportMethods &
+  McpRecordsMethods;
+export interface McpAdapterPublicMethods extends Pick<
+  McpAdapterMethods,
+  | "connectConfiguredServers"
+  | "connectServer"
+  | "disconnectServer"
+  | "status"
+  | "pingServer"
+  | "listTools"
+  | "callTool"
+  | "readResource"
+  | "close"
+> {}
+declare module "./adapter-owner.js" {
+  interface NodeMcpAdapter extends McpAdapterPublicMethods {}
+}
