--- /dev/null
+++ b/packages/ui/test/savedWorkflowConsistency.browser.test.tsx
@@ -0,0 +1,160 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { SavedWorkflowProjectGroup } from "../src/settings/saved-workflows/SavedWorkflowProjectGroup.js";
+import { SavedWorkflowGlobalGroup } from "../src/settings/saved-workflows/SavedWorkflowGlobalGroup.js";
+import { useSavedWorkflowStore } from "../src/store/savedWorkflowStore.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const noop = () => {};
+
+async function scenario(locale: "en-US" | "zh-CN") {
+  useSavedWorkflowStore.setState(useSavedWorkflowStore.getInitialState(), true);
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  let rootMounted = true;
+  let unavailable = true;
+  const project = {
+    workspacePath: `/authored/workflow-render-${locale}`,
+    label: "Authored Project",
+  };
+  const changes: Array<{ loaded: boolean; empty: boolean }> = [];
+  const services = {
+    zcodeAgentService: {
+      listSavedWorkflows: async () => {
+        if (unavailable) throw new Error("Authored workflow source unavailable");
+        return {
+          workflows: [
+            {
+              name: "recovered",
+              description: "Restored file authority",
+              scope: "project",
+              path: "/authored/recovered.ts",
+            },
+          ],
+          invalid: [],
+          dir: "/authored/.zcode/workflows",
+        };
+      },
+      listSavedWorkflowRuns: async () => ({ runs: [] }),
+    },
+    fileWatcherService: {
+      watch: async () => {
+        throw new Error("Authored watch unavailable");
+      },
+    },
+  };
+  const report = (_key: string, value: { loaded: boolean; empty: boolean }) => changes.push(value);
+  const render = async (refreshSeq: number) => {
+    await act(async () =>
+      root.render(
+        <ServiceProvider services={services as never}>
+          <TabStoreProvider>
+            <ZCodeIntlProvider locale={locale}>
+              <TooltipProvider>
+                <SavedWorkflowProjectGroup
+                  project={project}
+                  isCurrent
+                  refreshSeq={refreshSeq}
+                  mode={{ kind: "list" }}
+                  onStateChange={report}
+                  onOpenDetail={noop}
+                  onBack={noop}
+                />
+                <SavedWorkflowGlobalGroup
+                  localProjects={[project]}
+                  activeProjectKey={project.workspacePath}
+                  refreshSeq={refreshSeq}
+                  mode={{ kind: "list" }}
+                  onStateChange={report}
+                  onOpenDetail={noop}
+                  onBack={noop}
+                  onMoved={noop}
+                />
+              </TooltipProvider>
+            </ZCodeIntlProvider>
+          </TabStoreProvider>
+        </ServiceProvider>,
+      ),
+    );
+  };
+  try {
+    await render(0);
+    check(
+      node.textContent?.includes("Authored Project"),
+      "failed project group must remain visible",
+    );
+    check(
+      node.textContent?.includes("Authored workflow source unavailable"),
+      "current failure must be readable",
+    );
+    check(
+      changes.filter((state) => state.loaded).every((state) => !state.empty),
+      "failure is not successful empty state",
+    );
+    unavailable = false;
+    await render(1);
+    check(
+      node.textContent?.includes("Restored file authority"),
+      "refresh must render authoritative recovered workflow",
+    );
+    check(
+      !node.textContent?.includes("Authored workflow source unavailable"),
+      "successful refresh must clear current error",
+    );
+    await act(async () => root.unmount());
+    rootMounted = false;
+    useSavedWorkflowStore.setState(useSavedWorkflowStore.getInitialState(), true);
+    const reopened = createRoot(node);
+    await act(async () =>
+      reopened.render(
+        <ServiceProvider services={services as never}>
+          <TabStoreProvider>
+            <ZCodeIntlProvider locale={locale}>
+              <TooltipProvider>
+                <SavedWorkflowProjectGroup
+                  project={project}
+                  isCurrent
+                  refreshSeq={0}
+                  mode={{ kind: "list" }}
+                  onStateChange={report}
+                  onOpenDetail={noop}
+                  onBack={noop}
+                />
+              </TooltipProvider>
+            </ZCodeIntlProvider>
+          </TabStoreProvider>
+        </ServiceProvider>,
+      ),
+    );
+    check(
+      node.textContent?.includes("Restored file authority"),
+      "reopen must refetch the existing source",
+    );
+    await act(async () => reopened.unmount());
+  } finally {
+    if (rootMounted) await act(async () => root.unmount());
+    node.remove();
+  }
+}
+
+window.__savedWorkflowConsistencyTests = (async () => {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    const name = `${locale}: real workflow groups expose failure, recover on refresh, and refetch after reopen`;
+    try {
+      await scenario(locale);
+      results.push({ name });
+    } catch (error) {
+      results.push({ name, error: error instanceof Error ? error.message : String(error) });
+    }
+  }
+  return results;
+})();
