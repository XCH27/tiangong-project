+import assert from "node:assert/strict";
+import test from "node:test";
+import { setTimeout as delay } from "node:timers/promises";
+import { z } from "zod";
+import { zcodeProtocolMethods } from "@zcode/shared";
+import { ZCodeProtocolAgentServer } from "../src/zcode-protocol/server.js";
+
+for (const outcome of ["allow", "deny", "disconnect"] as const) {
+  test(`actual Host synchronous client ${outcome} cannot resurrect a settled reverse request`, async () => {
+    const server = new ZCodeProtocolAgentServer({ env: {} });
+    let announcements = 0;
+    server.setNotificationSink((message) => {
+      if (!("id" in message) || !("method" in message)) return;
+      announcements++;
+      // Keep any erroneous reannouncement pending so the real shutdown can clean it.
+      // No forced exit, timer cancellation, fake clock, or unref hides the owner's bug.
+      if (announcements !== 1) return;
+      if (outcome === "disconnect") server.disconnectClient(new Error("Authored disconnect"));
+      else if (outcome === "deny")
+        void server.handleMessage({
+          id: message.id,
+          error: { code: -32000, message: "Authored denial" },
+        });
+      else void server.handleMessage({ id: message.id, result: { decision: "allow" } });
+    });
+    try {
+      const pending = server.officialMcpAuthRequestContext.requestClient(
+        zcodeProtocolMethods.interactionRequestPermission,
+        { purpose: "Authored native control" },
+        z.object({ decision: z.literal("allow") }),
+        { reannounceIntervalMs: 2 },
+      );
+      if (outcome === "allow") assert.deepEqual(await pending, { decision: "allow" });
+      else
+        await assert.rejects(
+          pending,
+          outcome === "deny" ? /Authored denial/ : /Authored disconnect/,
+        );
+      await delay(12);
+      assert.equal(announcements, 1, "settled client requests must never reannounce");
+    } finally {
+      await server.shutdown();
+      server.disposeProjections();
+    }
+  });
+}
+
+test("an asynchronously reannounced request accepts its original ID and ignores later duplicate IDs", async () => {
+  const server = new ZCodeProtocolAgentServer({ env: {} });
+  const ids: Array<string | number> = [];
+  let observed!: () => void;
+  const second = new Promise<void>((resolve) => {
+    observed = resolve;
+  });
+  server.setNotificationSink((message) => {
+    if (!("id" in message) || !("method" in message)) return;
+    ids.push(message.id);
+    if (ids.length === 2) observed();
+  });
+  try {
+    const pending = server.officialMcpAuthRequestContext.requestClient(
+      zcodeProtocolMethods.interactionRequestPermission,
+      {},
+      z.object({ decision: z.literal("allow") }),
+      { reannounceIntervalMs: 2 },
+    );
+    await second;
+    await server.handleMessage({ id: ids[0]!, result: { decision: "allow" } });
+    assert.deepEqual(await pending, { decision: "allow" });
+    await server.handleMessage({ id: ids[1]!, error: { code: -32000, message: "Late duplicate" } });
+    const count = ids.length;
+    await delay(12);
+    assert.equal(ids.length, count);
+  } finally {
+    await server.shutdown();
+    server.disposeProjections();
+  }
+});
+
+test("a synchronous answer during reannouncement stops the next reannouncement", async () => {
+  const server = new ZCodeProtocolAgentServer({ env: {} });
+  let announcements = 0;
+  server.setNotificationSink((message) => {
+    if (!("id" in message) || !("method" in message)) return;
+    if (++announcements === 2)
+      void server.handleMessage({ id: message.id, result: { decision: "allow" } });
+  });
+  try {
+    const result = await server.officialMcpAuthRequestContext.requestClient(
+      zcodeProtocolMethods.interactionRequestPermission,
+      {},
+      z.object({ decision: z.literal("allow") }),
+      { reannounceIntervalMs: 2 },
+    );
+    assert.deepEqual(result, { decision: "allow" });
+    await delay(12);
+    assert.equal(announcements, 2);
+  } finally {
+    await server.shutdown();
+    server.disposeProjections();
+  }
+});
+
+test("reconnect retains a fresh client request while old disconnected IDs cannot settle it", async () => {
+  const server = new ZCodeProtocolAgentServer({ env: {} });
+  const ids: Array<string | number> = [];
+  const sink: Parameters<typeof server.setNotificationSink>[0] = (message) => {
+    if ("id" in message && "method" in message) ids.push(message.id);
+  };
+  server.setNotificationSink(sink);
+  try {
+    const request = () =>
+      server.officialMcpAuthRequestContext.requestClient(
+        zcodeProtocolMethods.interactionRequestPermission,
+        {},
+        z.object({ decision: z.literal("allow") }),
+        { reannounceIntervalMs: 2 },
+      );
+    const old = request();
+    server.disconnectClient(new Error("Authored old connection"));
+    await assert.rejects(old, /Authored old connection/);
+    server.setNotificationSink(sink);
+    let settled = false;
+    const fresh = request().then((value) => {
+      settled = true;
+      return value;
+    });
+    await server.handleMessage({ id: ids[0]!, result: { decision: "allow" } });
+    await new Promise((resolve) => setImmediate(resolve));
+    assert.equal(settled, false);
+    await server.handleMessage({ id: ids[1]!, result: { decision: "allow" } });
+    assert.deepEqual(await fresh, { decision: "allow" });
+    await delay(12);
+    assert.equal(ids.length, 2);
+  } finally {
+    await server.shutdown();
+    server.disposeProjections();
+  }
+});
