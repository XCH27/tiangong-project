index 00000000..e3dc4b8f
--- /dev/null
+++ b/packages/ui/test/helpers/nativePresentationResume.ts
@@ -0,0 +1,57 @@
+import type { ConversationSnapshot, ConversationTopicFrame } from "@zcode/shared/zcode-protocol-v4";
+import { ConversationProjectionStore } from "../../src/v4/conversationProjectionStore.js";
+import type { ConversationTransport } from "../../src/v4/transport.js";
+
+/** Scheduling port only: carry an unchanged real Host snapshot, then hold aligned resume initial. */
+export function nativePresentationResume(snapshot: ConversationSnapshot) {
+  const topic = `conversation/${snapshot.sessionId}`;
+  const listeners = new Set<(frame: ConversationTopicFrame) => void>();
+  let subscriptions = 0;
+  const transport = {
+    async subscribe() {
+      subscriptions++;
+      return {
+        ack: {
+          subscriptionId: `captured-${subscriptions}`,
+          mode: subscriptions === 1 ? "snapshot" : "resume",
+          logEpoch: snapshot.logEpoch,
+        },
+      };
+    },
+    activate(subscriptionId: string) {
+      if (subscriptions !== 1) return;
+      const frame: ConversationTopicFrame = {
+        topic,
+        subscriptionId,
+        sentAt: Date.now(),
+        fromSeq: 0,
+        toSeq: snapshot.seq,
+        payload: { kind: "snapshot", snapshot },
+      };
+      for (const listener of listeners) listener(frame);
+    },
+    onFrame(listener: (frame: ConversationTopicFrame) => void) {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    onAssemblyFault() {
+      return () => {};
+    },
+    onRuntimeRestart() {
+      return () => {};
+    },
+    async unsubscribe() {},
+  } as unknown as ConversationTransport;
+  const store = new ConversationProjectionStore(topic, transport);
+  const off = transport.onFrame((frame) => store.handleFrame(frame, { deliveryKind: "initial" }));
+  return {
+    store,
+    transport,
+    async close() {
+      off();
+      await store.close();
+    },
+  };
+}
