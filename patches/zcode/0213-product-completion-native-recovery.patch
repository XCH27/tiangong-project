diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-input-facade-options-options.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-input-facade-options-options.ts
new file mode 100644
index 00000000..c05d5d88
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-input-facade-options-options.ts
@@ -0,0 +1,66 @@
+import { AgentRuntime } from "@zcode/core";
+
+import { type TraceContext } from "@zcode/contracts";
+
+import type { PrepareUserExecutionBoundary, ZCodeAppOptions } from "./types.js";
+
+import { createInputFacade } from "./input-facade.js";
+
+import { resolveZCodeCustomCommandPrompt } from "../custom-command-prompt.js";
+import { resolveZCodeBuiltinPromptCommand } from "../builtin-prompt-command.js";
+
+import type {
+  ToolArtifactStorePort,
+  ExecutionPort,
+  SessionId,
+  InputHistoryStorePort,
+} from "@zcode/contracts";
+import type { AgentRuntimeConfig, Logger } from "@zcode/core";
+
+export function createAppInputFacadeOptionsOptions(factoryBindings: {
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly runtimeConfig: AgentRuntimeConfig;
+  readonly workingDirectory: string;
+  readonly options: ZCodeAppOptions;
+  readonly executionPort: ExecutionPort;
+  readonly logger: Logger;
+  readonly sessionId: SessionId;
+  readonly traceContext: TraceContext;
+  readonly inputHistoryStore: InputHistoryStorePort | undefined;
+  readonly prepareUserExecutionBoundary: PrepareUserExecutionBoundary;
+  readonly runtime: AgentRuntime;
+}): Parameters<typeof createInputFacade>[0] {
+  return {
+    artifactStore: factoryBindings.artifactStore,
+    customCommandPromptResolver: async (text, resolverOptions) => {
+      const builtinPrompt = resolveZCodeBuiltinPromptCommand(text, {
+        // 动态工作流关闭时内置 `/workflow` 不得展开。目录侧已经把它从 `/` 面板
+        // 剔除，但用户仍可手打命令名，两条路径必须给出同一个结论。TUI 缺席时不设门禁；
+        // headless 按 --enable-workflow 显式取值，见 runtimeConfig 字段注释。
+        dynamicWorkflowEnabled: factoryBindings.runtimeConfig.dynamicWorkflowEnabled,
+        workingDirectory: factoryBindings.workingDirectory,
+      });
+      if (builtinPrompt !== undefined) {
+        return builtinPrompt;
+      }
+      return await resolveZCodeCustomCommandPrompt(text, {
+        env: factoryBindings.options.env,
+        executionPort: factoryBindings.executionPort,
+        logger: factoryBindings.logger,
+        projectConfigPath: factoryBindings.options.projectConfigPath,
+        sessionId: factoryBindings.sessionId,
+        signal: resolverOptions?.abortSignal,
+        skipUserConfig: factoryBindings.options.skipUserConfig,
+        traceContext: resolverOptions?.traceContext ?? factoryBindings.traceContext,
+        userConfigPath: factoryBindings.options.userConfigPath,
+        workingDirectory: factoryBindings.workingDirectory,
+      });
+    },
+    inputHistoryStore: factoryBindings.inputHistoryStore,
+    logger: factoryBindings.logger,
+    prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+    runtime: factoryBindings.runtime,
+    sessionId: factoryBindings.sessionId,
+    traceContext: factoryBindings.traceContext,
+  };
+}
