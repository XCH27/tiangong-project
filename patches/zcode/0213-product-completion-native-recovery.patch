new file mode 100644
index 00000000..4487b9dd
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-gateway-host-admit-command-input.ts
@@ -0,0 +1,53 @@
+import type { V4GatewayHost } from "../zcode-protocol-v4/v4-gateway.js";
+
+import type { V4CommandCoreHost } from "../zcode-protocol-v4/commands/types.js";
+
+import type { SessionId } from "@zcode/contracts";
+
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+import { isConversationInputAdmissionCommand } from "./v4-bridge-values.js";
+
+export function createV4GatewayHostAdmitCommandInput(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+  readonly coreHost: V4CommandCoreHost;
+}): V4GatewayHost["admitCommandInput"] {
+  return (
+    {
+      admitCommandInput: async (envelope, admission) => {
+        // 仅隐藏 composer 不能阻止旧 child 标签页续聊。类型准入必须早于
+        // ledger/输入历史写入；detached child 没有 record 时只查元数据，不激活第二个 runtime。
+        if (
+          envelope.sessionId &&
+          (isConversationInputAdmissionCommand(envelope.type) ||
+            envelope.type === "resumeGoal" ||
+            envelope.type === "sendQueuedNow" ||
+            envelope.type === "forkAssistant" ||
+            envelope.type === "createSelectionSideSession")
+        ) {
+          const taskType =
+            factoryBindings.context.sessions.get(envelope.sessionId)?.taskType ??
+            (
+              await factoryBindings.context.deps.sessionStore?.getSession(
+                envelope.sessionId as SessionId,
+              )
+            )?.taskType;
+          if (taskType === "subagent_child") {
+            throw Object.assign(new Error("Subagent sessions are read-only"), {
+              reasonCode: "guard.subagentReadOnly",
+            });
+          }
+        }
+        if (!isConversationInputAdmissionCommand(envelope.type)) return null;
+        if (!envelope.sessionId) return null;
+        return (
+          (await factoryBindings.coreHost.admitInputCommand?.(
+            envelope,
+            envelope.sessionId,
+            admission,
+          )) ?? null
+        );
+      },
+    } satisfies Pick<V4GatewayHost, "admitCommandInput">
+  ).admitCommandInput;
+}
