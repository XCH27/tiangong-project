+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { SESSION_ENTRY_WORKSPACE_CHECKPOINT } from "@zcode/contracts";
+import { whiteboardRelativePath } from "@zcode/shared";
+import { effectiveWhiteboardFixture } from "./helpers/native-whiteboard-effective-fixture.js";
+
+for (const modify of ["hook", "permission"] as const) {
+  test(`human ${modify} changes effective ink; lost checkpoint repairs cold with original request retained and no repeated write`, async () => {
+    const x = await effectiveWhiteboardFixture({ modify, publicationFailure: "checkpoint" });
+    try {
+      x.failPublication();
+      await assert.rejects(x.save(), /lost checkpoint publication/);
+      assert.equal(JSON.parse(await x.bytes()).board.name, x.effective.document.name);
+      const bytes = await x.bytes(),
+        writes = x.writes;
+      await x.f.reopen();
+      assert.equal(
+        (
+          await x.f.store.sessionEntries({
+            sessionID: x.f.runtime.getSessionId(),
+            type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+          })
+        ).length,
+        1,
+      );
+      assert.equal(await x.bytes(), bytes);
+      assert.equal(x.writes, writes);
+      assert.equal(x.f.requests.length, 0);
+      const part = (await x.f.store.messages({ sessionID: x.f.runtime.getSessionId() }))
+        .flatMap((message) => message.parts)
+        .find((part) => part.type === "tool" && part.state.status === "completed");
+      assert.ok(part?.type === "tool" && typeof part.state.input.inputRef === "string");
+      const requested = JSON.parse(
+        (await x.artifacts().readToolResultArtifact({ uri: part.state.input.inputRef })).content,
+      );
+      assert.equal(requested.document.name, x.request.document.name);
+    } finally {
+      await x.f.close();
+    }
+  });
+}
+
+for (const modify of ["hook", "permission"] as const) {
+  test(`ordinary Agent ${modify} input follows the same effective evidence and cold checkpoint repair`, async () => {
+    const x = await effectiveWhiteboardFixture({ modify, publicationFailure: "checkpoint" });
+    try {
+      x.failPublication();
+      await assert.rejects(x.agentSave(), /Turn execution failed/); // Authored in-process reply only; no provider/HTTP transport.
+      assert.equal(JSON.parse(await x.bytes()).board.name, x.effective.document.name);
+      const before = await x.bytes(),
+        writes = x.writes;
+      await x.f.reopen();
+      assert.equal(
+        (
+          await x.f.store.sessionEntries({
+            sessionID: x.f.runtime.getSessionId(),
+            type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+          })
+        ).length,
+        1,
+      );
+      assert.equal(await x.bytes(), before);
+      assert.equal(x.writes, writes);
+      assert.equal(x.f.requests.length, 1);
+    } finally {
+      await x.f.close();
+    }
+  });
+  test(`accepted ${modify} board/mutation identity changes bind only the exact effective action`, async () => {
+    const x = await effectiveWhiteboardFixture({
+      modify,
+      identityChange: true,
+      publicationFailure: "checkpoint",
+    });
+    try {
+      x.failPublication();
+      await assert.rejects(x.save(), /lost checkpoint publication/);
+      await assert.rejects(readFile(join(x.f.dir, whiteboardRelativePath(x.board.id))), {
+        code: "ENOENT",
+      });
+      const before = await x.bytes(),
+        writes = x.writes;
+      await x.f.reopen();
+      assert.equal(await x.bytes(), before);
+      assert.equal(x.writes, writes);
+      assert.equal(x.f.requests.length, 0);
+      const checkpoint = (
+        await x.f.store.sessionEntries({
+          sessionID: x.f.runtime.getSessionId(),
+          type: SESSION_ENTRY_WORKSPACE_CHECKPOINT,
+        })
+      )[0];
+      assert.ok(checkpoint);
+    } finally {
+      await x.f.close();
+    }
+  });
+  test(`prepared original preimage plus successful ${modify} retry keeps unique publishing anchors cold`, async () => {
+    const x = await effectiveWhiteboardFixture({
+      modify,
+      firstWriteFails: true,
+      publicationFailure: "commit",
+    });
+    try {
+      const failed = await x.save();
+      assert.ok(failed.accepted && !failed.result.success);
+      x.failPublication();
+      await assert.rejects(x.save(), /lost checkpoint publication/);
+      const journals = await x.f.store.sessionEntries({
+        sessionID: x.f.runtime.getSessionId(),
+        type: "native/whiteboard_checkpoint",
+      });
+      const originalCallId = (journals[0]!.data as { toolCallId: string }).toolCallId;
+      assert.equal((journals[0]!.data as { status: string }).status, "prepared");
+      const completed = (await x.f.store.messages({ sessionID: x.f.runtime.getSessionId() })).find(
+        (message) =>
+          message.parts.some((part) => part.type === "tool" && part.state.status === "completed"),
+      );
+      assert.ok(completed && completed.info.role === "assistant");
+      const before = await x.bytes(),
+        writes = x.writes;
+      await x.f.reopen();
