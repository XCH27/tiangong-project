diff --git a/packages/desktop/src/main/nativeWhiteboardClose.ts b/packages/desktop/src/main/nativeWhiteboardClose.ts
new file mode 100644
index 00000000..23b00d91
--- /dev/null
+++ b/packages/desktop/src/main/nativeWhiteboardClose.ts
@@ -0,0 +1,103 @@
+import { randomUUID } from "node:crypto";
+
+export interface NativeWhiteboardCloseRequest { requestId: string; phase?: "request" | "cancelled" }
+interface RendererOwner {
+  alive(): boolean;
+  send(request: NativeWhiteboardCloseRequest): void;
+  dirty: boolean;
+}
+interface PendingClose {
+  windowId: number;
+  requestId: string;
+  promise: Promise<boolean>;
+  resolve(allowed: boolean): void;
+  timer: ReturnType<typeof setTimeout>;
+}
+
+/** Main owns close admission/correlation only. Drafts and Save/Discard/Cancel stay in the renderer. */
+export class NativeWhiteboardCloseBroker {
+  private readonly owners = new Map<number, RendererOwner>();
+  private readonly pending = new Map<number, PendingClose>();
+  private readonly approvals = new Map<number, string>();
+  private allInFlight?: Promise<boolean>;
+
+  constructor(private readonly timeoutMs = 180_000) {}
+
+  register(windowId: number, owner: Omit<RendererOwner, "dirty">, dirty: boolean): void {
+    this.owners.set(windowId, { ...owner, dirty });
+  }
+
+  forget(windowId: number): void {
+    this.finish(windowId, false);
+    this.owners.delete(windowId);
+    this.approvals.delete(windowId);
+  }
+
+  hasRenderer(windowId: number): boolean { return this.owners.has(windowId); }
+
+  complete(windowId: number, requestId: string, allowClose: boolean): boolean {
+    const request = this.pending.get(windowId);
+    if (!request || request.requestId !== requestId) return false;
+    if (allowClose) this.approvals.set(windowId, requestId);
+    this.finish(windowId, allowClose);
+    return true;
+  }
+
+  prepareWindow(windowId: number): Promise<boolean> {
+    const current = this.pending.get(windowId);
+    if (current) return current.promise;
+    const owner = this.owners.get(windowId);
+    if (!owner || !owner.alive()) return Promise.resolve(true);
+    const requestId = randomUUID();
+    let resolve!: (allowed: boolean) => void;
+    const promise = new Promise<boolean>(settle => { resolve = settle; });
+    const timer = setTimeout(() => {
+      this.finish(windowId, false);
+      this.sendCancellation(windowId, requestId);
+    }, this.timeoutMs);
+    this.pending.set(windowId, { windowId, requestId, promise, resolve, timer });
+    try { owner.send({ requestId, phase: "request" }); }
+    catch { this.finish(windowId, false); }
+    return promise;
+  }
+
+  prepareAll(): Promise<boolean> {
+    if (this.allInFlight) return this.allInFlight;
+    const windowIds = [...this.owners.keys()].filter(id => this.owners.get(id)!.alive());
+    const work = (async () => {
+      // Serial presentation avoids competing close dialogs and permits immediate cancellation.
+      for (const id of windowIds) {
+        if (!(await this.prepareWindow(id))) { this.cancelApprovals(); return false; }
+      }
+      return true;
+    })().finally(() => { if (this.allInFlight === work) this.allInFlight = undefined; });
+    this.allInFlight = work;
+    return work;
+  }
+
+  cancelApprovals(): void {
+    for (const [id, requestId] of this.approvals) this.sendCancellation(id, requestId);
+    this.approvals.clear();
+    for (const [id, request] of this.pending) {
+      this.sendCancellation(id, request.requestId);
+      this.finish(id, false);
+    }
+  }
+
+  private sendCancellation(id: number, requestId: string): void {
+    try { const owner = this.owners.get(id); if (owner?.alive()) owner.send({ requestId, phase: "cancelled" }); }
+    catch { /* The renderer disappeared; no draft discard or Host shutdown is inferred. */ }
+  }
+
+  private finish(id: number, allowClose: boolean): void {
+    const request = this.pending.get(id);
+    if (!request) return;
+    clearTimeout(request.timer);
+    this.pending.delete(id);
+    request.resolve(allowClose);
+  }
+}
+
+export class NativeWhiteboardCloseCancelledError extends Error {
+  constructor() { super("Native whiteboard close cancelled; drafts and Host remain available"); this.name = "NativeWhiteboardCloseCancelledError"; }
+}
