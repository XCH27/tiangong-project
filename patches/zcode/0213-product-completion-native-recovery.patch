+import type { IZCodeAgentService } from "@zcode/services";
+import {
+  conversationSnapshotSchema,
+  conversationTopicWireFrameSchema,
+  V4_WIRE_PROTOCOL_VERSION,
+  type ConversationTopicWireCandidate,
+} from "@zcode/shared/zcode-protocol-v4";
+
+/** Authored projection ports for consumer settlement tests; Host wire tests use real frames. */
+export function nativePresentationAgent() {
+  const frames = new Set<(frame: ConversationTopicWireCandidate) => void>();
+  const lifecycle = new Set<(event: { state: "available" | "unavailable" }) => void>();
+  let gate: Promise<void> | undefined;
+  let fail: Error | undefined;
+  let subscriptions = 0;
+  let omitFrame = false;
+  const agent = {
+    helloConversationV4: async () => ({
+      kind: "hello",
+      protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+      connectionId: "owned",
+      clientMode: "desktop-continuous",
+      deliveryProfile: "continuous",
+      serverTime: Date.now(),
+      capabilities: {
+        nativeDialogs: false,
+        localTerminal: false,
+        binaryFrames: false,
+        compression: "none",
+      },
+      auth: {},
+    }),
+    initializeConversationV4: async () => {},
+    onDynamicConversationFrame:
+      () => (listener: (frame: ConversationTopicWireCandidate) => void) => {
+        frames.add(listener);
+        return { dispose: () => frames.delete(listener) };
+      },
+    onAgentRuntimeRestarted: () => ({ dispose() {} }),
+    onAgentRuntimeLifecycle: (
+      listener: (event: { state: "available" | "unavailable" }) => void,
+    ) => {
+      lifecycle.add(listener);
+      return { dispose: () => lifecycle.delete(listener) };
+    },
+    unsubscribeConversationV4: async () => {},
+    async subscribeConversationV4({ sessionId }: { sessionId: string }) {
+      subscriptions++;
+      await gate;
+      if (fail) throw fail;
+      const subscriptionId = crypto.randomUUID(),
+        topic = `conversation/${sessionId}`;
+      const snapshot = conversationSnapshotSchema.parse({
+        protocolVersion: 1,
+        sessionId,
+        logEpoch: "owned",
+        seq: 0,
+        revision: 0,
+        control: {
+          phase: "completedSuccess",
+          sessionEnded: true,
+          canStop: false,
+          stopState: "idle",
+          stopTargetKind: "unknown",
+          steerable: false,
+          activeWorks: [],
+          lastError: null,
+          apiRetry: null,
+        },
+        availability: Object.fromEntries(
+          [
+            "fork",
+            "compact",
+            "switchModelConfig",
+            "queueEdit",
+            "sendQueuedNow",
+            "setFollowupMode",
+            "pauseGoal",
+            "resumeGoal",
+          ].map((key) => [key, { allowed: true }]),
+        ),
+        inputRouting: { mode: "startNow" },
+        config: { provider: "", model: "", thought: "", followupMode: "queue" },
+        usage: {
+          contextWindow: null,
+          cumulative: { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 },
+        },
+        queue: { items: [], autoDrain: true },
+        pendingInteractions: [],
+        pendingCommands: [],
+        backgroundWorks: [],
+        goal: null,
+        plan: null,
+        rows: { window: [], totalCount: 0, firstRowId: null },
+      });
+      const frame = conversationTopicWireFrameSchema.parse({
+        wireVersion: V4_WIRE_PROTOCOL_VERSION,
+        kind: "complete",
+        deliveryKind: "initial",
+        logicalFrameId: crypto.randomUUID(),
+        logicalFrameOrdinal: 1,
+        topic,
+        subscriptionId,
+        frame: {
+          topic,
+          subscriptionId,
+          fromSeq: 0,
+          toSeq: 0,
+          sentAt: Date.now(),
+          payload: { kind: "snapshot", snapshot },
+        },
+      });
+      if (!omitFrame) for (const listener of frames) listener(frame);
+      return { ack: { subscriptionId, mode: "snapshot", logEpoch: "owned" } };
+    },
+  } as unknown as IZCodeAgentService;
+  return {
+    agent,
+    get subscriptions() {
+      return subscriptions;
+    },
+    omitInitialFrame() {
+      omitFrame = true;
+    },
+    hold(promise: Promise<void>) {
+      gate = promise;
+    },
+    fail(error: Error) {
+      fail = error;
+    },
+    disconnect(workspaceKey: string) {
+      for (const listener of lifecycle) listener({ state: "unavailable", workspaceKey } as never);
+    },
+  };
+}
diff --git a/packages/ui/test/helpers/nativePresentationHost.ts b/packages/ui/test/helpers/nativePresentationHost.ts
