index 00000000..5cac9584
--- /dev/null
+++ b/packages/desktop/test/main-lifecycle-consumers.test.mjs
@@ -0,0 +1,103 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { EventEmitter } from "node:events";
+import { loadMainConsumer } from "./helpers/main-consumer-fixture.mjs";
+
+test("actual window lifecycle admits only latest pending DOM generation with pre-provider init input", async (t) => {
+  const win = new EventEmitter();
+  const wc = new EventEmitter();
+  Object.assign(wc, { id: 10, isDestroyed: () => false });
+  Object.assign(win, { id: 20, webContents: wc, isDestroyed: () => false });
+  globalThis.__ownedLifecycleWindow = win;
+  t.after(() => {
+    delete globalThis.__ownedLifecycleWindow;
+  });
+  const { createWindow } = await loadMainConsumer(t, "desktopWindowLifecycle.ts", {
+    stubs: {
+      "./databaseStartupTelemetry.js": "export function reportDatabaseStartupState(){}",
+      "./desktopWindowChrome.js":
+        "export function createBrowserWindow(){return globalThis.__ownedLifecycleWindow;}",
+      "./resourceManagerWindow.js":
+        "export function registerMainApplicationWindow(){} export function unregisterMainApplicationWindow(){}",
+      "./armsBrowserPerfLoadNudge.js": "export function scheduleArmsBrowserPerfLoadNudge(){}",
+    },
+  });
+  let admit;
+  const gate = new Promise((resolve) => {
+    admit = resolve;
+  });
+  const spawns = [],
+    disposals = [];
+  const hosts = new Map();
+  const child = { pid: 123 };
+  createWindow({
+    iconPath: "/owned/icon",
+    preloadPath: "/owned/preload",
+    logger: { info() {}, warn() {} },
+    forceQuitRef: { current: false },
+    windowHostProcessMap: hosts,
+    spawnHostProcess: (_win, _label, input) => {
+      spawns.push(input);
+      return child;
+    },
+    disposeHostProcess: (...args) => disposals.push(args),
+    syncAutoUpdaterStateToWindow() {},
+    syncReadyUpdateToWindow() {},
+    syncPostUpdateReleaseNotesToWindow() {},
+    disposeRemoteWorkspaceSessionsForWindow() {},
+    reattachRemoteWorkspaceSessionsForWindow() {},
+    agentSpawnFallbackCwd: "/owned/fallback",
+    deviceMid: "owned-device",
+    runtimeProcessEnvFallbackPatch: { OWNED: "fallback" },
+    awaitFirstHostSpawnDecision: () => gate,
+    agentWarmupTargets: [
+      { workspacePath: "/owned/workspace", workspaceIdentity: "owned-identity" },
+    ],
+  });
+  const domReady = wc.listeners("dom-ready")[0];
+  const first = domReady(),
+    second = domReady();
+  assert.equal(spawns.length, 0);
+  admit();
+  await Promise.all([first, second]);
+  assert.equal(spawns.length, 1);
+  assert.equal(spawns[0].type, "init-local");
+  assert.equal(spawns[0].workspacePath, "/owned/workspace");
+  assert.deepEqual(spawns[0].runtimeProcessEnvPatch, { OWNED: "fallback" });
+  assert.equal("zcodeBuiltinProviderConfigFilePath" in spawns[0], false);
+  assert.equal(hosts.get(10), child);
+  win.emit("closed");
+  assert.equal(hosts.size, 0);
+  assert.equal(disposals.length, 1);
+});
+
+test("separate SSH/WSL/Docker target comparisons and telemetry retain original normalizations", async (t) => {
+  const { isSameRemoteTarget, buildRemoteTargetTelemetryKey } = await loadMainConsumer(
+    t,
+    "desktopRemoteSessions.ts",
+    { exports: ["isSameRemoteTarget", "buildRemoteTargetTelemetryKey"] },
+  );
+  const pairs = [
+    [
+      { kind: "ssh", host: " HOST ", username: " user " },
+      { kind: "ssh", host: "host", username: "user", port: 22 },
+    ],
+    [
+      { kind: "wsl", distro: " " },
+      { kind: "wsl", distro: "default", user: "" },
+    ],
+    [
+      { kind: "docker", container: "owned" },
+      { kind: "docker", container: "owned" },
+    ],
+  ];
+  for (const [left, right] of pairs) {
+    assert.equal(isSameRemoteTarget(left, right), true);
+    assert.equal(buildRemoteTargetTelemetryKey(left), buildRemoteTargetTelemetryKey(right));
+  }
+  assert.equal(isSameRemoteTarget(pairs[0][0], pairs[1][0]), false);
+  assert.equal(
+    isSameRemoteTarget(pairs[0][0], { ...pairs[0][1], privateKeyPath: "/owned/key" }),
+    false,
+  );
+});
diff --git a/packages/desktop/test/manifest-update-consumer.test.mjs b/packages/desktop/test/manifest-update-consumer.test.mjs
