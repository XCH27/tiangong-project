-function compareIsoAsc(left?: string, right?: string): number {
-  if (!left && !right) return 0;
-  if (!left) return 1;
-  if (!right) return -1;
-  return left.localeCompare(right);
-}
-
-function compareIsoDesc(left?: string, right?: string): number {
-  return compareIsoAsc(right, left);
-}
