@@ -0,0 +1,151 @@
+import type { createModelTelemetry } from "@zcode/telemetry";
+import type { createDynamicWorkflowRunService } from "./dynamic-workflow-run-service.js";
+import type {
+  ToolArtifactStorePort,
+  ExecutionPort,
+  SessionId,
+  InputHistoryStorePort,
+  ImageProcessorPort,
+  PdfDocumentPort,
+  McpPort,
+  SessionStorePort,
+  McpServerConfig,
+  LocalSettingStorePort,
+  ProjectId,
+} from "@zcode/contracts";
+import type { AgentRuntimeConfig, Logger, PermissionService, LoggerFactory } from "@zcode/core";
+import type { ConfigResult } from "@zcode/adapters/config";
+import type { RuntimeModelFactory } from "./provider-registry-model-runtime.js";
+
+import { createAppSessionFacadeOptionsOptions } from "./app-session-facade-options-options.js";
+import { createAppWorkflowFacadeOptionsOptions } from "./app-workflow-facade-options-options.js";
+import { createAppInputFacadeOptionsOptions } from "./app-input-facade-options-options.js";
+
+import { AgentRuntime } from "@zcode/core";
+import { type TraceContext } from "@zcode/contracts";
+
+import type { PrepareUserExecutionBoundary, ZCodeAppOptions } from "./types.js";
+
+import { createWorkflowFacade } from "./workflow-facade.js";
+
+import { createInputFacade } from "./input-facade.js";
+
+import { createSessionFacade } from "./session-facade.js";
+
+import { type NodeReplBrowserBroker } from "./node-repl-browser-broker.js";
+
+export function createAppFacades(factoryBindings: {
+  readonly artifactStore: ToolArtifactStorePort;
+  readonly runtimeConfig: AgentRuntimeConfig;
+  readonly workingDirectory: string;
+  readonly options: ZCodeAppOptions;
+  readonly executionPort: ExecutionPort;
+  readonly logger: Logger;
+  readonly sessionId: SessionId;
+  readonly traceContext: TraceContext;
+  readonly inputHistoryStore: InputHistoryStorePort | undefined;
+  readonly prepareUserExecutionBoundary: PrepareUserExecutionBoundary;
+  readonly runtime: AgentRuntime;
+  readonly modelTelemetry: ReturnType<typeof createModelTelemetry>;
+  readonly appVersion: string;
+  readonly cliStorageRoot: string;
+  readonly configResult: ConfigResult;
+  readonly imageProcessorPort: ImageProcessorPort;
+  readonly pdfDocumentPort: PdfDocumentPort;
+  readonly mcpPort: McpPort | undefined;
+  readonly modelFactory: RuntimeModelFactory;
+  readonly permissionService: PermissionService;
+  readonly sessionStore: SessionStorePort;
+  readonly storageRoot: string;
+  readonly dynamicWorkflowRunPort: ReturnType<typeof createDynamicWorkflowRunService> | undefined;
+  readonly configuredMcpServers: Record<string, McpServerConfig>;
+  readonly localSettingStore: LocalSettingStorePort | undefined;
+  readonly loggerFactory: LoggerFactory;
+  readonly ownsExecutionPort: boolean;
+  readonly ownsMcpPort: boolean;
+  readonly ownedNodeReplBrowserBroker: NodeReplBrowserBroker | undefined;
+  readonly ownsSessionStore: boolean;
+  readonly prepareResume: (
+    submitTraceContext?: TraceContext,
+    abortSignal?: AbortSignal,
+  ) => Promise<void>;
+  readonly projectID: ProjectId;
+  readonly untrustedProjectMcpServers: Set<string>;
+}) {
+  const inputFacade = createInputFacade(
+    createAppInputFacadeOptionsOptions({
+      artifactStore: factoryBindings.artifactStore,
+      runtimeConfig: factoryBindings.runtimeConfig,
+      workingDirectory: factoryBindings.workingDirectory,
+      options: factoryBindings.options,
+      executionPort: factoryBindings.executionPort,
+      logger: factoryBindings.logger,
+      sessionId: factoryBindings.sessionId,
+      traceContext: factoryBindings.traceContext,
+      inputHistoryStore: factoryBindings.inputHistoryStore,
+      prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+      get runtime() {
+        return factoryBindings.runtime;
+      },
+    }),
+  );
+  const workflowFacade = createWorkflowFacade(
+    createAppWorkflowFacadeOptionsOptions({
+      modelTelemetry: factoryBindings.modelTelemetry,
+      options: factoryBindings.options,
+      appVersion: factoryBindings.appVersion,
+      artifactStore: factoryBindings.artifactStore,
+      cliStorageRoot: factoryBindings.cliStorageRoot,
+      configResult: factoryBindings.configResult,
+      imageProcessorPort: factoryBindings.imageProcessorPort,
+      pdfDocumentPort: factoryBindings.pdfDocumentPort,
+      logger: factoryBindings.logger,
+      mcpPort: factoryBindings.mcpPort,
+      modelFactory: factoryBindings.modelFactory,
+      permissionService: factoryBindings.permissionService,
+      prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+      get runtime() {
+        return factoryBindings.runtime;
+      },
+      runtimeConfig: factoryBindings.runtimeConfig,
+      sessionId: factoryBindings.sessionId,
+      sessionStore: factoryBindings.sessionStore,
+      storageRoot: factoryBindings.storageRoot,
+      traceContext: factoryBindings.traceContext,
+      workingDirectory: factoryBindings.workingDirectory,
+    }),
+  );
+  const sessionFacade = createSessionFacade(
+    createAppSessionFacadeOptionsOptions({
+      dynamicWorkflowRunPort: factoryBindings.dynamicWorkflowRunPort,
+      configResult: factoryBindings.configResult,
+      configuredMcpServers: factoryBindings.configuredMcpServers,
+      options: factoryBindings.options,
+      executionPort: factoryBindings.executionPort,
+      localSettingStore: factoryBindings.localSettingStore,
+      logger: factoryBindings.logger,
+      loggerFactory: factoryBindings.loggerFactory,
+      mcpPort: factoryBindings.mcpPort,
+      ownsExecutionPort: factoryBindings.ownsExecutionPort,
+      ownsMcpPort: factoryBindings.ownsMcpPort,
+      get ownedNodeReplBrowserBroker() {
+        return factoryBindings.ownedNodeReplBrowserBroker;
+      },
+      ownsSessionStore: factoryBindings.ownsSessionStore,
+      prepareUserExecutionBoundary: factoryBindings.prepareUserExecutionBoundary,
+      prepareResume: factoryBindings.prepareResume,
+      projectID: factoryBindings.projectID,
+      get runtime() {
+        return factoryBindings.runtime;
+      },
+      sessionId: factoryBindings.sessionId,
+      sessionStore: factoryBindings.sessionStore,
+      traceContext: factoryBindings.traceContext,
+      untrustedProjectMcpServers: factoryBindings.untrustedProjectMcpServers,
+      workingDirectory: factoryBindings.workingDirectory,
+    }),
+  );
+
+  const closeSession = sessionFacade.close;
+  return { inputFacade, workflowFacade, sessionFacade, closeSession };
+}
