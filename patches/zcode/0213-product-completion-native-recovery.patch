diff --git a/apps/zcode-cli/packages/bootstrap/src/app/app-execution-resources.ts b/apps/zcode-cli/packages/bootstrap/src/app/app-execution-resources.ts
new file mode 100644
index 00000000..3da47ef6
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/app-execution-resources.ts
@@ -0,0 +1,168 @@
+import type { ConfigResult } from "@zcode/adapters";
+import type { SessionStorePort, PluginLoadOutcome, McpServerConfig } from "@zcode/contracts";
+import type { AgentRuntimeConfig, Logger } from "@zcode/core";
+import type { ResidentPluginAvailability } from "./plugin-availability.js";
+
+import { createAppHttpOptionsOptions } from "./app-http-options-options.js";
+import { createAppExecutionOptionsOptions } from "./app-execution-options-options.js";
+import { createAppMcpOptionsOptions } from "./app-mcp-options-options.js";
+
+import { join } from "node:path";
+import { createNodeToolArtifactStore } from "@zcode/adapters/storage";
+
+import { resolvePath } from "@zcode/adapters/config";
+import { createNodeExecutionAdapter } from "@zcode/adapters/exec";
+import { createNodeFileSystemAdapter } from "@zcode/adapters/fs";
+import { createNodeWebFetchHttpClientAdapter } from "@zcode/adapters/http";
+import { createJimpImageProcessorAdapter } from "@zcode/adapters/image";
+import { createPopplerPdfDocumentAdapter } from "@zcode/adapters/pdf";
+import { createNodeSessionMailboxAdapter } from "@zcode/adapters/mailbox";
+import { createMcpAdapter } from "@zcode/adapters/mcp";
+import { AgentRuntime, PermissionService } from "@zcode/core";
+
+import { StartupTimer } from "../startup-logging.js";
+
+import type { ZCodeAppOptions } from "./types.js";
+import { isMessageEnabled } from "./app-config-options.js";
+
+import { asInputHistoryStore } from "./session-store.js";
+
+import { withResidentPluginMcp } from "./resident-plugin-ports.js";
+
+import {
+  debugRuntimeConfigResolved,
+  markMcpAdapterInitialized,
+  markStorageAdaptersInitialized,
+} from "./startup-marks.js";
+export function createAppExecutionResources(factoryBindings: {
+  readonly configResult: ConfigResult;
+  readonly options: ZCodeAppOptions;
+  readonly sessionStore: SessionStorePort;
+  readonly storageRoot: string;
+  readonly cliStorageRoot: string;
+  readonly startupTimer: StartupTimer;
+  readonly runtimeConfig: AgentRuntimeConfig;
+  readonly workingDirectory: string;
+  readonly appVersion: string;
+  readonly logger: Logger;
+  readonly pluginOutcome: PluginLoadOutcome;
+  readonly pluginAvailability: ResidentPluginAvailability;
+  readonly configuredMcpServers: Record<string, McpServerConfig>;
+  readonly runtime: AgentRuntime | undefined;
+}) {
+  const permissionService = new PermissionService({
+    allowedTools: new Set(factoryBindings.configResult.config.permission.allowedTools),
+    autoApproveHighRisk: factoryBindings.configResult.config.permission.autoApproveHighRisk,
+    disallowedTools: new Set(factoryBindings.configResult.config.permission.disallowedTools),
+    allowMediumRiskInAutoMode: factoryBindings.configResult.config.permission.allowMediumRiskInAuto,
+  });
+  const inputHistoryStore =
+    factoryBindings.options.inputHistoryStore ?? asInputHistoryStore(factoryBindings.sessionStore);
+  const artifactStore =
+    factoryBindings.options.artifactStore ??
+    createNodeToolArtifactStore({
+      imageCacheRootDir: join(factoryBindings.storageRoot, "cli", "image-cache"),
+      pdfCacheRootDir: join(factoryBindings.storageRoot, "cli", "pdf-cache"),
+      rootDir: join(factoryBindings.storageRoot, "cli", "artifacts"),
+      videoCacheRootDir: join(factoryBindings.storageRoot, "cli", "video-cache"),
+    });
+  const imageProcessorPort =
+    factoryBindings.options.imageProcessorPort ?? createJimpImageProcessorAdapter();
+  const messageEnabled = isMessageEnabled(factoryBindings.options.env ?? process.env);
+  const sessionMailboxPort =
+    factoryBindings.options.sessionMailboxPort ??
+    (messageEnabled
+      ? createNodeSessionMailboxAdapter({
+          rootDir: resolvePath(
+            (factoryBindings.options.env ?? process.env).ZCODE_MAILBOX_ROOT ?? "~/.zcode/mailbox",
+          ),
+        })
+      : undefined);
+  markStorageAdaptersInitialized({
+    cliStorageRoot: factoryBindings.cliStorageRoot,
+    hasInjectedArtifactStore: factoryBindings.options.artifactStore !== undefined,
+    hasInjectedSessionStore: factoryBindings.options.sessionStore !== undefined,
+    startupTimer: factoryBindings.startupTimer,
+    storageRoot: factoryBindings.storageRoot,
+  });
+  const rawMcpPort =
+    factoryBindings.options.mcpPort ??
+    (factoryBindings.runtimeConfig.mcp?.enabled === false
+      ? undefined
+      : (factoryBindings.options.mcpPortFactory?.({
+          workingDirectory: factoryBindings.workingDirectory,
+        }) ??
+        createMcpAdapter(
+          createAppMcpOptionsOptions({
+            appVersion: factoryBindings.appVersion,
+            options: factoryBindings.options,
+            logger: factoryBindings.logger,
+            configResult: factoryBindings.configResult,
+            workingDirectory: factoryBindings.workingDirectory,
+          }),
+        )));
+  const mcpPort = rawMcpPort
+    ? withResidentPluginMcp(
+        rawMcpPort,
+        factoryBindings.pluginOutcome,
+        factoryBindings.pluginAvailability,
+        factoryBindings.workingDirectory,
+      )
+    : undefined;
+  const ownsMcpPort = factoryBindings.options.mcpPort === undefined && mcpPort !== undefined;
+  const executionPort =
+    factoryBindings.options.executionPort ??
+    createNodeExecutionAdapter(
+      createAppExecutionOptionsOptions({
+        options: factoryBindings.options,
+        configResult: factoryBindings.configResult,
+        storageRoot: factoryBindings.storageRoot,
+      }),
+    );
+  const ownsExecutionPort = factoryBindings.options.executionPort === undefined;
+  const pdfDocumentPort =
+    factoryBindings.options.pdfDocumentPort ?? createPopplerPdfDocumentAdapter({ executionPort });
+  // browser-use 控制端口：仅当宿主（desktop）注入时可用，无本地 fallback（纯 CLI 无浏览器底座）。
+  const fileSystemPort = factoryBindings.options.fileSystemPort ?? createNodeFileSystemAdapter();
+  const httpClientPort =
+    factoryBindings.options.httpClientPort ??
+    createNodeWebFetchHttpClientAdapter(
+      createAppHttpOptionsOptions({
+        options: factoryBindings.options,
+        configResult: factoryBindings.configResult,
+      }),
+    );
+  markMcpAdapterInitialized({
+    configuredMcpServers: factoryBindings.configuredMcpServers,
+    hasInjectedMcpPort: factoryBindings.options.mcpPort !== undefined,
+    mcpEnabled: factoryBindings.runtimeConfig.mcp?.enabled !== false,
+    startupTimer: factoryBindings.startupTimer,
+    trustedMcpServerCount: Object.keys(factoryBindings.runtimeConfig.mcp?.servers ?? {}).length,
+  });
+  debugRuntimeConfigResolved({
+    configResult: factoryBindings.configResult,
+    logger: factoryBindings.logger,
+    runtimeConfig: factoryBindings.runtimeConfig,
+  });
+  const getRuntime = (): AgentRuntime => {
+    if (!factoryBindings.runtime) throw new Error("ZCode runtime is not initialized yet.");
+    return factoryBindings.runtime;
+  };
+  return {
+    permissionService,
+    inputHistoryStore,
+    artifactStore,
+    imageProcessorPort,
+    messageEnabled,
+    sessionMailboxPort,
+    rawMcpPort,
+    mcpPort,
+    ownsMcpPort,
+    executionPort,
+    ownsExecutionPort,
+    pdfDocumentPort,
+    fileSystemPort,
+    httpClientPort,
+    getRuntime,
+  };
+}
