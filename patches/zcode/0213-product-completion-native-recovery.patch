+import { join } from "node:path";
+
+import { createConfig } from "@zcode/adapters/config";
+
+import type { ZCodeAppOptions } from "./types.js";
+import { createConfigCliOverrides, resolveEffectiveConfigResult } from "./app-config-options.js";
+
+import { createPluginAvailability } from "./plugin-availability.js";
+
+import { discoverAppPlugins } from "./startup-marks.js";
+import type { PluginLoadOutcome } from "@zcode/contracts";
+import type { Logger } from "@zcode/core";
+import type { ConfigResult } from "@zcode/adapters";
+
+export function createAppPluginAvailabilityOptions(factoryBindings: {
+  readonly pluginOutcome: PluginLoadOutcome;
+  readonly options: ZCodeAppOptions;
+  readonly workingDirectory: string;
+  readonly logger: Logger;
+  readonly pluginStorageRoot: string;
+  readonly configResult: ConfigResult;
+}): Parameters<typeof createPluginAvailability>[0] {
+  return {
+    initialOutcome: factoryBindings.pluginOutcome,
+    discover: () =>
+      discoverAppPlugins({
+        configResult: resolveEffectiveConfigResult(
+          createConfig({
+            env: factoryBindings.options.env,
+            projectConfigPath: factoryBindings.options.projectConfigPath,
+            workingDirectory: factoryBindings.workingDirectory,
+            workspaceIdentity: factoryBindings.options.runtimeConfig?.memory?.workspaceIdentity,
+            skipUserConfig: factoryBindings.options.skipUserConfig,
+            userConfigPath: factoryBindings.options.userConfigPath,
+            cliOverrides: createConfigCliOverrides(factoryBindings.options),
+          }),
+          factoryBindings.options,
+        ),
+        env: factoryBindings.options.env,
+        logger: factoryBindings.logger,
+        options: factoryBindings.options,
+        pluginStorageRoot: factoryBindings.pluginStorageRoot,
+        workingDirectory: factoryBindings.workingDirectory,
+      }),
+    logger: factoryBindings.logger,
+    pluginStorageRoot: factoryBindings.pluginStorageRoot,
+    // Workspace-scope plugin writes land in `<workspace>/.zcode/config.json`, which may not exist yet.
+    watchedConfigPaths: [
+      factoryBindings.configResult.sources.user.path,
+      ...factoryBindings.configResult.sources.project.paths,
+      join(factoryBindings.workingDirectory, ".zcode", "config.json"),
+    ],
+  };
+}
