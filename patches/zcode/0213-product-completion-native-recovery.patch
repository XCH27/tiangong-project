+import assert from "node:assert/strict";
+import test from "node:test";
+import { SqliteSessionStore } from "../src/storage/session-store/sqlite-session-store.js";
+
+// Public surface captured from the accepted 8c347cb class, including private prototype methods.
+const acceptedMethods: Array<[string, number, boolean]> = [
+  ["getDatabasePath", 0, false],
+  ["close", 0, false],
+  ["throwBeforeWrite", 0, false],
+  ["maybeThrowForkCommitFault", 1, false],
+  ["createSession", 1, true],
+  ["createForkedSessionWithMetadata", 2, true],
+  ["commitForkBundle", 1, true],
+  ["commitSharedContextImportBundle", 1, true],
+  ["transitionSharedContextImport", 1, true],
+  ["updateSession", 1, true],
+  ["getSession", 1, true],
+  ["listSessions", 0, true],
+  ["claimLegacySessionWorkspace", 1, true],
+  ["repairLegacyRemoteSessionWorkspace", 1, true],
+  ["repairRemoteSessionPaths", 1, true],
+  ["saveMessage", 2, true],
+  ["removeMessage", 1, true],
+  ["savePart", 2, true],
+  ["removePart", 1, true],
+  ["messageWithParts", 1, true],
+  ["messages", 1, true],
+  ["saveSessionEntry", 1, true],
+  ["sessionEntries", 1, true],
+  ["saveSessionInput", 1, true],
+  ["commitPermissionFullAccess", 1, true],
+  ["updateSessionInputs", 1, true],
+  ["promoteSessionInput", 1, true],
+  ["markSessionInputPromoted", 1, true],
+  ["settleSessionInput", 1, true],
+  ["listSessionInputs", 1, true],
+  ["getSessionInputById", 1, true],
+  ["readTodos", 1, true],
+  ["updateTodos", 1, true],
+  ["readTarget", 1, true],
+  ["setTarget", 1, true],
+  ["cloneTargetForFork", 1, true],
+  ["createTarget", 1, true],
+  ["updateTargetStatus", 1, true],
+  ["startTargetRun", 1, true],
+  ["heartbeatTargetRun", 1, true],
+  ["finishTargetRun", 1, true],
+  ["recoverInterruptedTargetRun", 1, true],
+  ["accountTargetUsage", 1, true],
+  ["updateTargetSummaryTitle", 1, true],
+  ["clearTarget", 1, true],
+  ["recordModelUsage", 1, true],
+  ["upsertTurnUsage", 1, true],
+  ["upsertToolUsage", 1, true],
+  ["pruneUsage", 1, true],
+  ["queryAppUsage", 1, true],
+  ["queryTaskUsage", 1, true],
+  ["recordInputHistory", 1, true],
+  ["recallPreviousInputHistory", 1, true],
+  ["getProjectPermission", 1, true],
+  ["saveProjectPermission", 1, true],
+  ["getProjectPermissionMode", 1, false],
+  ["saveProjectPermissionMode", 1, false],
+  ["setRevert", 1, true],
+  ["clearRevert", 1, true],
+  ["upsertScriptWorkflowDefinition", 1, true],
+  ["createScriptWorkflowRun", 1, true],
+  ["updateScriptWorkflowRun", 1, true],
+  ["getScriptWorkflowRun", 1, true],
+  ["listScriptWorkflowRuns", 1, true],
+  ["createScriptWorkflowActivity", 1, true],
+  ["updateScriptWorkflowActivity", 1, true],
+  ["findCachedScriptWorkflowActivity", 1, true],
+  ["listScriptWorkflowActivities", 1, true],
+  ["appendScriptWorkflowEvent", 1, true],
+  ["listScriptWorkflowEvents", 1, true],
+  ["createSessionTaskLink", 1, true],
+  ["workflowJournalStore", 0, false],
+  ["debugMigrationIds", 0, false],
+  ["debugCounts", 1, false],
+];
+
+test("SQLite extraction retains the accepted own prototype descriptors and sole instance identity", () => {
+  const store = new SqliteSessionStore({ dbPath: ":memory:" });
+  try {
+    assert.equal(SqliteSessionStore.name, "SqliteSessionStore");
+    assert.equal(SqliteSessionStore.length, 0);
+    assert.equal(Object.getPrototypeOf(store), SqliteSessionStore.prototype);
+    assert.equal(Object.getPrototypeOf(SqliteSessionStore.prototype), Object.prototype);
+    // D59 adds one atomic native admission API; all original descriptors/order remain exact.
+    assert.deepEqual(Object.getOwnPropertyNames(SqliteSessionStore.prototype).filter(name => name !== "saveSessionEntryOnce"), [
+      "constructor",
+      ...acceptedMethods.map(([name]) => name),
+    ]);
+    assert.equal(SqliteSessionStore.prototype.constructor, SqliteSessionStore);
+    for (const [name, length, isAsync] of acceptedMethods) {
+      const descriptor = Object.getOwnPropertyDescriptor(SqliteSessionStore.prototype, name)!;
+      assert.equal(descriptor.enumerable, false, name);
+      assert.equal(descriptor.configurable, true, name);
+      assert.equal(descriptor.writable, true, name);
+      assert.equal(descriptor.value.name, name);
+      assert.equal(descriptor.value.length, length, name);
+      assert.equal(descriptor.value.constructor.name, isAsync ? "AsyncFunction" : "Function", name);
+    }
+    assert.equal(store.workflowJournalStore(), store.workflowJournalStore());
+    assert.equal(store.getDatabasePath(), ":memory:");
+  } finally {
+    store.close();
+  }
+});
diff --git a/apps/zcode-cli/packages/adapters/test/stream-attempt-owner.test.ts b/apps/zcode-cli/packages/adapters/test/stream-attempt-owner.test.ts
