--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-finally.ts
@@ -0,0 +1,68 @@
+import { ModelFailureReason as ModelFailureReasonValue } from "@zcode/contracts";
+
+import { publishModelStatus } from "./runner-status.js";
+
+import { closeStreamIteratorBestEffort } from "./stream-attempt-cleanup.js";
+import { statusPublishOptions } from "./stream-attempt-status.js";
+
+import type { StreamAttemptState } from "./stream-attempt-state.js";
+export async function cleanupStreamAttempt(state: StreamAttemptState): Promise<void> {
+  if (
+    !state.streamReachedNaturalEnd &&
+    (state.attemptFailed || state.input.request.preserveProviderStreamBoundaries === true)
+  ) {
+    // 普通 stream 的 429 retry 失败若不进入本清理分支，
+    // AI SDK stream tee 会持有旧 provider 请求，连续重试会让后续物理请求卡在发送前。
+    // 失败 attempt 必须无条件中止并释放；普通 consumer 主动提前结束仍保持原语义。
+    if (!state.attemptAbortController.signal.aborted) {
+      state.attemptAbortController.controller.abort(
+        new Error("Model stream attempt ended before natural EOF."),
+      );
+    }
+    if (!state.attemptFailed && !state.terminalStatusPublished && !state.emittedError) {
+      // consumer 侧的校验异常只会触发 AsyncIteratorClose，不会回到上面的 catch；
+      // 将已启动的物理请求收口为 cancelled，避免 fallback 前遗留悬空 started 状态。
+      const completedAt = Date.now();
+      await publishModelStatus(
+        {
+          ...state.statusContext,
+          attempt: state.attempt,
+          durationMs: completedAt - state.startedAt,
+          message: "Model stream consumer closed before natural EOF.",
+          reason: ModelFailureReasonValue.Cancelled,
+          requestHeaderCount: state.requestHeaderCount,
+          requestHeaders: state.requestHeaders,
+          retryable: false,
+          errorCode: "model_request_cancelled",
+          errorPhase: "stream",
+          exceptionType: "AbortError",
+          streamOutputCommitted: state.streamOutputCommitted,
+          timestamp: new Date(completedAt).toISOString(),
+          type: "model_request_failed",
+        },
+        statusPublishOptions(state.input, state.admission),
+      );
+    }
+    if (state.attemptFailed && state.awaitIteratorClose) {
+      await closeStreamIteratorBestEffort(state.streamIterator, {
+        attempt: state.attempt,
+        logger: state.input.logger,
+        result: state.result,
+      });
+    } else {
+      void closeStreamIteratorBestEffort(state.streamIterator, {
+        attempt: state.attempt,
+        logger: state.input.logger,
+      });
+    }
+  } else if (state.attemptAbortController.signal.aborted) {
+    // 普通 main 保留既有生命周期：只有 caller/idle 已经 abort 时才 best-effort 关闭 iterator。
+    void closeStreamIteratorBestEffort(state.streamIterator, {
+      attempt: state.attempt,
+      logger: state.input.logger,
+    });
+  }
+  state.attemptAbortController.cleanup();
+  // 兜底归还（成功 / 抛出 / 消费者提前 return 都到这里）；正常失败路径已在 sleep 前归还，幂等。
+  state.admission.release();
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/stream-attempt-reading.ts b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-reading.ts
new file mode 100644
index 00000000..a7402fde
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-reading.ts
@@ -0,0 +1,155 @@
+import type { ModelStreamEvent } from "@zcode/contracts";
+
+import { readNextWithStreamIdleTimeout } from "./stream-idle-timeout.js";
+import { isZeroOutputModelCompletion } from "./runner-diagnostics.js";
+import { canRetryEmptyCompletion } from "./empty-completion-retry.js";
+
+import { asRecord } from "./runner-record.js";
+
+import { publishModelStatus, publishModelTelemetryMilestone } from "./runner-status.js";
+
+import { statusPublishOptions, observeVisibleStreamEvent } from "./stream-attempt-status.js";
+import { compactDirectToolCallCommitEvent } from "./stream-boundary-events.js";
+import { handleStreamChunk } from "./stream-chunks.js";
+import type { StreamAttemptState } from "./stream-attempt-state.js";
+export async function* readStreamAttempt(
+  state: StreamAttemptState,
+): AsyncGenerator<ModelStreamEvent, void> {
+  while (true) {
+    const next = await readNextWithStreamIdleTimeout(state.streamIterator!, {
+      abortController: state.attemptAbortController.controller,
+      onTimeout: async (error) => {
+        state.streamStallCount += 1;
+        state.streamMaxIdleMs = Math.max(state.streamMaxIdleMs, error.idleMs);
+        await publishModelStatus(
+          {
+            ...state.statusContext,
+            attempt: state.attempt,
+            idleMs: error.idleMs,
+            message: error.message,
+            requestHeaderCount: state.requestHeaderCount,
+            requestHeaders: state.requestHeaders,
+            timeoutMs: error.timeoutMs,
+            timestamp: new Date().toISOString(),
+            type: "model_stream_stalled",
+          },
+          statusPublishOptions(state.input, state.admission),
+        );
+      },
+      timeoutMs: state.streamIdleTimeoutMs,
+    });
+    if (next.done) {
+      state.streamReachedNaturalEnd = true;
+      break;
+    }
+    if (state.timeToFirstProviderEventMs === undefined) {
+      state.timeToFirstProviderEventMs = Date.now() - state.startedAt;
+      await publishModelTelemetryMilestone(
+        {
+          ...state.statusContext,
+          attempt: state.attempt,
+          elapsedMs: state.timeToFirstProviderEventMs,
+          timestamp: new Date(state.startedAt + state.timeToFirstProviderEventMs).toISOString(),
+          type: "model_first_provider_event",
+        },
+        { logger: state.input.logger, statusSink: state.input.statusSink },
+      );
+    }
+    // SDK 7 只在 finish-step 提供供应商 metadata，最终 finish 不再带它。
+    // 仅在本次 attempt/step 内携带；新 step、错误和重试不能借用旧实报事实。
+    if (next.value.type === "start-step" || next.value.type === "error") {
+      state.completedStepMetadata = undefined;
+    } else if (next.value.type === "finish-step") {
+      state.completedStepMetadata = next.value.providerMetadata;
+    }
+    const chunk =
+      next.value.type === "finish" && state.completedStepMetadata !== undefined
+        ? {
+            ...next.value,
+            providerMetadata: asRecord(next.value).providerMetadata ?? state.completedStepMetadata,
+          }
+        : next.value;
+    let event: Awaited<ReturnType<typeof handleStreamChunk>>;
+    try {
+      event = await handleStreamChunk({
+        admission: state.admission,
+        attempt: state.attempt,
+        chunk,
+        diagnostics: state.diagnostics,
+        emittedRetryBoundaryEvent: state.emittedRetryBoundaryEvent,
+        input: state.input,
+        pendingRetrySafeEvents: state.pendingRetrySafeEvents,
+        requestHeaderCount: state.requestHeaderCount,
+        requestHeaders: state.requestHeaders,
+        repairThinkingSignatureRejection: state.repairThinkingSignatureRejection,
+        retryBudgetAttempt: state.retryBudgetAttempt,
+        startedAt: state.startedAt,
+        statusContext: state.statusContext,
+        toolCallAssembler: state.toolCallAssembler,
+      });
+    } catch (error) {
+      const directToolCommit = compactDirectToolCallCommitEvent(state.input.request, next.value);
+      if (directToolCommit) {
+        // 完整 direct tool-call 已是 provider 事件；name/input 校验即使抛错，
+        // 也不能让 adapter 当作首事件前失败再次 SSE 重放。
+        state.emittedRetryBoundaryEvent = true;
+        for (const pendingEvent of state.pendingRetrySafeEvents.splice(0)) {
+          state.emittedEvent = true;
+          yield pendingEvent;
+        }
+        // 无 raw message-block provenance 的 provider 可能直接给完整 tool-call。
+        // 先把 inferred block stop 交给隐藏 collector，再传播校验错误，避免 HTTP 重放。
+        state.emittedEvent = true;
+        yield directToolCommit;
+      }
+      throw error;
+    }
+    const shouldHoldEmptyCompletionEvents =
+      !event.emittedError &&
+      event.visibleEvents.some((visibleEvent) => visibleEvent.type === "finish") &&
+      state.input.request.preserveProviderStreamBoundaries !== true &&
+      isZeroOutputModelCompletion({
+        finishReason: state.diagnostics.finishReason,
+        reasoningLength: state.diagnostics.reasoningDeltaChars,
+        textLength: state.diagnostics.textDeltaChars,
+        toolCallCount: state.diagnostics.toolCallCount,
+        usage: state.diagnostics.usage,
+      }) &&
+      canRetryEmptyCompletion({
+        abortSignal: state.input.request.abortSignal,
+        attempt: state.attempt,
+        maxAttempts: state.input.retry.maxAttempts,
+        retryCount: state.runState.emptyCompletionRetryCount,
+      });
+    if (shouldHoldEmptyCompletionEvents) {
+      // finish 会把已缓存的 start 一并刷给 core；先暂存到自然 EOF，确认这是
+      // generic empty 后再重试，避免第一次 attempt 的 finish/start 泄漏到 UI。
+      event.visibleEvents.length = 0;
+    }
+    state.emittedError = state.emittedError || event.emittedError;
+    state.emittedEvent = state.emittedEvent || event.emittedEvent;
+    state.emittedRetryBoundaryEvent =
+      state.emittedRetryBoundaryEvent || event.emittedRetryBoundaryEvent;
+    if (event.retryScheduled) {
+      // SSE error chunk 的 retry 是正常控制流，不会进入 catch；
+      // 若不显式标记失败，finally 会跳过旧 attempt 的 iterator/tee 清理。
+      // 下一次物理请求必须等待本轮 abort 与有界清理后才能启动。
+      state.attemptFailed = true;
+      state.awaitIteratorClose = true;
+      state.retryScheduledFromStreamChunk = true;
+      state.offPeakQueueHoldFromStreamChunk = event.offPeakQueueHold;
+      break;
+    }
+    if (event.terminalError) {
+      throw event.terminalError;
+    }
+    if (event.visibleEvents.length > 0) {
+      for (const visibleEvent of event.visibleEvents) {
+        const observation = observeVisibleStreamEvent(visibleEvent, Date.now() - state.startedAt);
+        await state.publishVisibleMilestones(observation);
+        state.streamOutputCommitted = state.streamOutputCommitted || observation.outputCommitted;
+        yield visibleEvent;
+      }
+    }
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/stream-attempt-state.ts b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-state.ts
new file mode 100644
index 00000000..d04a7c0d
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-state.ts
@@ -0,0 +1,200 @@
+import type { TextStreamPart, ToolSet } from "ai";
+import type { ModelStreamEvent } from "@zcode/contracts";
+
+import {
+  createLinkedAbortController,
+  resolveModelStreamIdleTimeoutMs,
+} from "./stream-idle-timeout.js";
+import { createStreamDiagnostics } from "./runner-diagnostics.js";
+
+import { createStreamTextOptions } from "./runner-options.js";
+
+import { type AttemptAdmission } from "./request-admission.js";
+
+import {
+  createAttemptStatusContext,
+  createStatusContext,
+  publishModelTelemetryMilestone,
+} from "./runner-status.js";
+import { StreamingToolCallAssembler } from "./streaming-tool-call-assembler.js";
+
+import type {
+  AiSdkStreamTextResult,
+  AiSdkModelTextRequest,
+  ResolvedAiSdkModel,
+} from "./runner-runtime.js";
+
+import { repairReasoningHistoryAfterSignatureRejection } from "./reasoning-history-normalization.js";
+
+import type { runStreamText } from "./runner-stream.js";
+export type StreamRunnerInput = Parameters<typeof runStreamText>[0];
+export interface StreamRunState {
+  requestMessages: AiSdkModelTextRequest["messages"];
+  signatureRepairAttempted: boolean;
+  emptyCompletionRetryCount: number;
+}
+export interface StreamAttemptState {
+  input: StreamRunnerInput;
+  attempt: number;
+  runState: StreamRunState;
+  retryBudget: StreamRunnerInput["request"]["modelRetryBudget"];
+  statusMaxAttempts: (extraAttempts: number) => number;
+  baseStatusContext: ReturnType<typeof createStatusContext>;
+  recordModelIO: boolean;
+  isDev: boolean;
+  retryBudgetAttempt: number;
+  startedAt: number;
+  streamIdleTimeoutMs: number;
+  emittedEvent: boolean;
+  emittedRetryBoundaryEvent: boolean;
+  emittedError: boolean;
+  retryScheduledFromStreamChunk: boolean;
+  offPeakQueueHoldFromStreamChunk: boolean;
+  pendingRetrySafeEvents: ModelStreamEvent[];
+  diagnostics: ReturnType<typeof createStreamDiagnostics>;
+  attemptAbortController: ReturnType<typeof createLinkedAbortController>;
+  attemptRequest: AiSdkModelTextRequest;
+  statusContext: ReturnType<typeof createAttemptStatusContext>;
+  toolCallAssembler: StreamingToolCallAssembler;
+  streamIterator: AsyncIterator<TextStreamPart<ToolSet>> | undefined;
+  streamReachedNaturalEnd: boolean;
+  attemptFailed: boolean;
+  awaitIteratorClose: boolean;
+  terminalStatusPublished: boolean;
+  options: ReturnType<typeof createStreamTextOptions> | undefined;
+  result: AiSdkStreamTextResult | undefined;
+  requestHeaders: Record<string, string>;
+  requestHeaderCount: number;
+  resolved: ResolvedAiSdkModel;
+  timeToFirstProviderEventMs: number | undefined;
+  timeToFirstContentMs: number | undefined;
+  timeToFirstTextMs: number | undefined;
+  streamMaxIdleMs: number;
+  streamStallCount: number;
+  streamOutputCommitted: boolean;
+  completedStepMetadata: Extract<
+    TextStreamPart<ToolSet>,
+    { type: "finish-step" }
+  >["providerMetadata"];
+  repairThinkingSignatureRejection: (error: unknown) => boolean;
+  publishVisibleMilestones: (observation: { contentMs?: number; textMs?: number }) => Promise<void>;
+  admission: AttemptAdmission;
+}
+export function createStreamAttemptState(
+  initial: Pick<
+    StreamAttemptState,
+    | "input"
+    | "attempt"
+    | "runState"
+    | "retryBudget"
+    | "statusMaxAttempts"
+    | "baseStatusContext"
+    | "recordModelIO"
+    | "isDev"
+  >,
+): StreamAttemptState {
+  // One original attempt frame; helpers retain these live bindings.
+  const state = initial as StreamAttemptState;
+  state.retryBudgetAttempt = state.attempt - Number(state.runState.signatureRepairAttempted);
+  state.startedAt = Date.now();
+  state.streamIdleTimeoutMs = resolveModelStreamIdleTimeoutMs({
+    baseTimeoutMs: state.input.streamIdleTimeoutMs,
+    retryNumber:
+      (state.input.request.streamIdleTimeoutRetryNumber ?? 0) + state.retryBudgetAttempt - 1,
+  });
+  state.emittedEvent = false;
+  state.emittedRetryBoundaryEvent = false;
+  state.emittedError = false;
+  state.retryScheduledFromStreamChunk = false;
+  state.offPeakQueueHoldFromStreamChunk = false;
+  state.pendingRetrySafeEvents = [];
+  state.diagnostics = createStreamDiagnostics();
+  state.attemptAbortController = createLinkedAbortController(state.input.request.abortSignal);
+  state.attemptRequest = {
+    ...state.input.request,
+    abortSignal: state.attemptAbortController.signal,
+    messages: state.runState.requestMessages,
+  };
+  state.statusContext = createAttemptStatusContext(
+    {
+      ...state.baseStatusContext,
+      maxAttempts: state.statusMaxAttempts(Number(state.runState.signatureRepairAttempted)),
+    },
+    state.attempt,
+  );
+  state.toolCallAssembler = new StreamingToolCallAssembler({ logger: state.input.logger });
+  state.streamIterator = undefined;
+  state.streamReachedNaturalEnd = false;
+  state.attemptFailed = false;
+  state.awaitIteratorClose = false;
+  state.terminalStatusPublished = false;
+  state.options = undefined;
+  state.result = undefined;
+  state.requestHeaders = {};
+  state.requestHeaderCount = 0;
+  state.resolved = state.input.resolved;
+  state.timeToFirstProviderEventMs = undefined;
+  state.timeToFirstContentMs = undefined;
+  state.timeToFirstTextMs = undefined;
+  state.streamMaxIdleMs = 0;
+  state.streamStallCount = 0;
+  state.streamOutputCommitted = false;
+  state.completedStepMetadata = undefined;
+  state.repairThinkingSignatureRejection = (error: unknown): boolean => {
+    if (state.runState.signatureRepairAttempted || state.resolved.providerKind !== "anthropic") {
+      return false;
+    }
+    const repairedMessages = repairReasoningHistoryAfterSignatureRejection(
+      state.runState.requestMessages,
+      error,
+    );
+    if (!repairedMessages) return false;
+    // 签名只对生成它的 thinking block 有效。流尚未提交输出时，只替换
+    // 本次请求副本，并给一次不占普通 retry 预算且拥有新 requestId 的物理请求机会；
+    // 不能把清理结果写回 canonical history。
+    state.runState.signatureRepairAttempted = true;
+    state.runState.requestMessages = repairedMessages;
+    state.input.logger?.warn("Retrying model stream after thinking signature rejection", {
+      attempt: state.attempt,
+      event: "model.reasoning_signature_repair.retry",
+      maxAttempts: state.input.retry.maxAttempts + 1,
+      nextAttempt: state.attempt + 1,
+      requestId: state.statusContext.requestId,
+      status: "waiting",
+    });
+    return true;
+  };
+  state.publishVisibleMilestones = async (observation: {
+    contentMs?: number;
+    textMs?: number;
+  }): Promise<void> => {
+    if (state.timeToFirstContentMs === undefined && observation.contentMs !== undefined) {
+      state.timeToFirstContentMs = observation.contentMs;
+      await publishModelTelemetryMilestone(
+        {
+          ...state.statusContext,
+          attempt: state.attempt,
+          elapsedMs: observation.contentMs,
+          timestamp: new Date(state.startedAt + observation.contentMs).toISOString(),
+          type: "model_first_content",
+        },
+        { logger: state.input.logger, statusSink: state.input.statusSink },
+      );
+    }
+    if (state.timeToFirstTextMs === undefined && observation.textMs !== undefined) {
+      state.timeToFirstTextMs = observation.textMs;
+      await publishModelTelemetryMilestone(
+        {
+          ...state.statusContext,
+          attempt: state.attempt,
+          elapsedMs: observation.textMs,
+          timestamp: new Date(state.startedAt + observation.textMs).toISOString(),
+          type: "model_first_text",
+        },
+        { logger: state.input.logger, statusSink: state.input.statusSink },
+      );
+    }
+  };
+  state.admission = undefined as unknown as AttemptAdmission;
+  return state;
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/stream-attempt-status.ts b/apps/zcode-cli/packages/adapters/src/model/stream-attempt-status.ts
new file mode 100644
