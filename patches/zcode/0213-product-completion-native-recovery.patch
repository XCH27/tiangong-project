+        handle.sync = async () => {
+          await sync();
+          await writeFile(path, "external committed", { flag: "wx" });
+        };
+      }
+      return handle;
+    };
+    syncBuiltinESMExports();
+    await assert.rejects(
+      new NodeFileSystemAdapter().writeTextFile({
+        path,
+        boundaryRoot: root,
+        content: "our staged content",
