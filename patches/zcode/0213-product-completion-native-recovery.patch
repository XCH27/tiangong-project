-      } catch {
-        return { path, mtimeMs: 0 };
-      }
-    }),
-  );
-
-  withStats.sort((left, right) => {
-    const timeComparison = right.mtimeMs - left.mtimeMs;
-    return timeComparison === 0 ? left.path.localeCompare(right.path) : timeComparison;
