-        }
-        return this.host.putSessionAttachment(sessionId, input);
-      },
-    });
-    this.attachmentPruneTimer = setInterval(
-      () => this.attachmentUploads.pruneExpired(),
-      Math.min(30_000, PROTOCOL_V4_LIMITS.attachmentUploadTtlMs),
-    );
