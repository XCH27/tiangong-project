+import type { FileSystemPort } from "@zcode/contracts";
+
+/** A readonly view over the original adapter, with its receiver and injected behavior retained. */
+export function createNativeWhiteboardReadPort(fileSystemPort: FileSystemPort) {
+  const port: Pick<FileSystemPort, "readTextFile" | "listDirectory"> = {
+    readTextFile: (request, options) => fileSystemPort.readTextFile(request, options),
+    listDirectory: (request, options) => fileSystemPort.listDirectory(request, options),
+  };
+  return Object.freeze(port);
+}
