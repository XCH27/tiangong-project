+      writes++;
+      toolCallId = String(request.toolCallId);
+      receipt = await text({ ...request, idempotencyKey: undefined }, options);
+      if (extra === "ambiguous") {
+        writes++;
+        await text({ ...request, idempotencyKey: undefined }, options);
+      }
+      observed?.();
+      await gate;
+      return receipt;
+    };
+    h.artifacts.writeToolResultBinaryArtifact = async (request, options) => {
+      writes++;
+      toolCallId = String(request.toolCallId);
+      receipt = await binary({ ...request, idempotencyKey: undefined }, options);
+      observed?.();
+      await gate;
+      return receipt;
+    };
+    assert.ok(app.startSavedWorkflow && app.cancelBackgroundTask);
+    const started = await app.startSavedWorkflow({ name: "legacy-stop", scope: "project" });
+    assert.ok(started.ok, JSON.stringify(started));
+    await signal;
+    assert.ok(receipt?.path);
+    if (extra === "corrupt") await writeFile(receipt.path, "corrupt bytes");
+    if (extra === "bad-name") {
+      await writeFile(`${receipt.path}.bak`, content);
+      await unlink(receipt.path);
+    }
+    if (extra === "symlink") {
+      await unlink(receipt.path);
+      await symlink(join(h.f.root, "owned-foreign.txt"), receipt.path);
+      await writeFile(join(h.f.root, "owned-foreign.txt"), content);
+    }
+    const stop = app.cancelBackgroundTask(started.runId),
+      deadline = Date.now() + 2000;
+    while (h.store.workflowJournalStore().getRun(started.runId)?.status !== "stopped") {
+      assert.ok(Date.now() < deadline);
+      await new Promise((resolve) => setTimeout(resolve, 5));
+    }
+    assert.ok(release);
+    release();
+    await stop;
+    await h.restart();
+    const baselineWrites = writes;
+    return {
+      h,
+      app,
+      started,
+      receipt,
+      toolCallId,
+      baselineWrites,
+      get writes() {
+        return writes;
+      },
+      close: () => h.close(),
+    };
+  } catch (error) {
+    release?.();
+    await h.close();
+    throw error;
+  }
