index 00000000..c6e4b61b
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/helpers/native-whiteboard-effective-fixture.ts
@@ -0,0 +1,116 @@
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { NodeFileSystemAdapter } from "../../../adapters/src/fs/index.js";
+import { SESSION_ENTRY_WORKSPACE_CHECKPOINT } from "@zcode/contracts";
+import type { ToolArtifactStorePort } from "@zcode/contracts";
+import { whiteboardRelativePath, type WhiteboardUpdateInput } from "@zcode/shared";
+import { fixture, reply } from "./pi-runtime-fixture.js";
+
+export async function effectiveWhiteboardFixture(
+  options: {
+    modify?: "hook" | "permission";
+    identityChange?: boolean;
+    agent?: boolean;
+    firstWriteFails?: boolean;
+    publicationFailure?: "checkpoint" | "commit";
+  } = {},
+) {
+  const board = {
+    id: `whiteboard:${randomUUID()}`,
+    name: "Original requested ink",
+    width: 1280 as const,
+    height: 800 as const,
+    strokes: [],
+    undoneStrokes: [],
+    createdAt: 1,
+    updatedAt: 1,
+  };
+  const request: WhiteboardUpdateInput = {
+    document: board,
+    mutationId: randomUUID(),
+    expectedAbsent: true,
+  };
+  const effective: WhiteboardUpdateInput = {
+    ...request,
+    document: {
+      ...board,
+      name: options.modify ? "Accepted effective ink" : board.name,
+      ...(options.identityChange ? { id: `whiteboard:${randomUUID()}` } : {}),
+    },
+    ...(options.identityChange ? { mutationId: randomUUID() } : {}),
+  };
+  const files = new NodeFileSystemAdapter(),
+    write = files.writeTextFile.bind(files);
+  let writes = 0,
+    failWrite = options.firstWriteFails;
+  files.writeTextFile = async (...args) => {
+    writes++;
+    if (failWrite) {
+      failWrite = false;
+      throw new Error("Authored failed file attempt");
+    }
+    return write(...args);
+  };
+  const f = await fixture(undefined, false, {
+    config: {
+      toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+      titleGeneration: { enabled: false },
+    },
+    deps: {
+      fileSystemPort: files,
+      ...(options.modify === "hook"
+        ? {
+            hookRunner: {
+              async run(input) {
+                return input.hookEventName === "PreToolUse" && input.toolName === "WhiteboardUpdate"
+                  ? { additionalContexts: [], updatedInput: effective }
+                  : { additionalContexts: [] };
+              },
+            },
+          }
+        : {}),
+    },
+  });
+  if (options.modify === "permission")
+    f.permissionWith(async () => ({ decision: "modify", modifiedInput: effective }));
+  const save = () => f.runtime.performWhiteboardControl({ operation: "update", input: request });
+  const failPublication = () => {
+    const original = f.store.saveSessionEntry.bind(f.store);
+    f.store.saveSessionEntry = async (entry) => {
+      if (
+        (options.publicationFailure === "checkpoint" &&
+          entry.type === SESSION_ENTRY_WORKSPACE_CHECKPOINT) ||
+        (options.publicationFailure === "commit" &&
+          entry.type === "native/whiteboard_checkpoint" &&
+          (entry.data as { status?: string }).status === "committed")
+      )
+        throw new Error("Authored lost checkpoint publication");
+      return original(entry);
+    };
+  };
+  return {
+    f,
+    board,
+    request,
+    effective,
+    save,
+    failPublication,
+    get writes() {
+      return writes;
+    },
+    artifacts: () =>
+      (f.runtime as unknown as { artifactStore: ToolArtifactStorePort }).artifactStore,
+    bytes: () => readFile(join(f.dir, whiteboardRelativePath(effective.document.id)), "utf8"),
+    async agentSave() {
+      f.steps.push(
+        () =>
+          reply("", [
+            { id: `agent-effective-${randomUUID()}`, name: "WhiteboardUpdate", input: request },
+          ]),
+        () => reply("Authored local completion"),
+      );
+      return f.runtime.executeTurn("Authored request to save native ink");
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/core/test/helpers/native-whiteboard-fork-fixture.ts b/apps/zcode-cli/packages/core/test/helpers/native-whiteboard-fork-fixture.ts
