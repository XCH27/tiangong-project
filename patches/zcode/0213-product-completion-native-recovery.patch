@@ -0,0 +1,145 @@
+// Same adapter owner; extracted tool-artifact-publication responsibility.
+// Storage adapters - EventStore, ArtifactStore, MemoryStore implementations
+import type {
+  ToolArtifactStorePort,
+  ToolArtifactWriteRequest,
+  ToolArtifactWriteResult,
+} from "@zcode/contracts";
+import {
+  extensionForContentType,
+  sanitizePathSegment,
+  normalizeArtifactExtension,
+} from "./tool-artifact-values.js";
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, open, readFile, readdir, lstat, unlink, link } from "node:fs/promises";
+import { join } from "node:path";
+
+/** Sync complete bytes before exposing the immutable name. Existing files are never overwritten. */
+export async function publishImmutableArtifact(
+  path: string,
+  content: Buffer,
+  sessionDir: string,
+  validateExisting: (content: Buffer) => void,
+): Promise<boolean> {
+  const stagingDir = join(sessionDir, ".staging");
+  await mkdir(stagingDir, { recursive: true });
+  const stagingPath = join(stagingDir, randomUUID());
+  const file = await open(stagingPath, "wx", 0o600);
+  let created = true;
+  try {
+    try {
+      await file.writeFile(content);
+      await file.sync();
+    } finally {
+      await file.close();
+    }
+    try {
+      await link(stagingPath, path);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+      validateExisting(await readFile(path));
+      created = false;
+    }
+    if (process.platform !== "win32") {
+      const directory = await open(sessionDir, "r");
+      try {
+        await directory.sync();
+      } finally {
+        await directory.close();
+      }
+    }
+    return created;
+  } finally {
+    await unlink(stagingPath).catch(() => undefined);
+  }
+}
+
+/** Opted text retains its original MIME/extension while reusing the immutable binary publisher. */
+export function writeIdempotentTextArtifact(
+  writeBinary: NonNullable<ToolArtifactStorePort["writeToolResultBinaryArtifact"]>,
+  request: ToolArtifactWriteRequest,
+  options?: { signal?: AbortSignal },
+): Promise<ToolArtifactWriteResult> {
+  const contentType = request.contentType ?? "application/json";
+  return writeBinary(
+    {
+      ...request,
+      content: Buffer.from(request.content, "utf8"),
+      contentType,
+      extension: extensionForContentType(contentType),
+    },
+    options,
+  );
+}
+
+export function binaryArtifactIdentity(sessionId: string, idempotencyKey: string): string {
+  return `tool-result-${createHash("sha256")
+    .update(JSON.stringify([sessionId, idempotencyKey]))
+    .digest("hex")}`;
+}
+
+export function uniqueBinaryArtifactEntry(entries: string[], id: string): string | undefined {
+  const matches = entries.filter((entry) => entry.startsWith(`${id}.`));
+  if (!matches.length) return;
+  if (matches.length !== 1)
+    throw new Error(
+      "Saved media operation has conflicting artifacts; original files were preserved",
+    );
+  return matches[0];
+}
+
+const LEGACY_UUID_V4 = "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}";
+
+/** Only canonical accepted workflow identities have an injective, untruncated legacy prefix. */
+export function locateBinaryArtifactPublication(
+  entries: string[],
+  request: { sessionId: string; idempotencyKey: string; toolCallId?: string },
+): { id: string; entry: string } | undefined {
+  const id = binaryArtifactIdentity(request.sessionId, request.idempotencyKey);
+  const current = uniqueBinaryArtifactEntry(entries, id);
+  if (current) return { id, entry: current };
+  if (request.toolCallId === undefined) return;
+  const identity = new RegExp(
+    `^dwfrun-${LEGACY_UUID_V4}:artifact#([1-9][0-9]*)@([1-9][0-9]*)$`,
+  ).exec(request.toolCallId);
+  if (!identity || identity.slice(1).some((value) => !Number.isSafeInteger(Number(value)))) {
+    throw new Error("Legacy publication identity is not canonical; original files were preserved");
+  }
+  const prefix = sanitizePathSegment(request.toolCallId);
+  if (prefix.length !== request.toolCallId.length) {
+    throw new Error("Legacy publication identity was truncated; original files were preserved");
+  }
+  const stem = `${prefix}-tool-result-`;
+  const matches = entries.filter((entry) => entry.startsWith(stem));
+  if (!matches.length) return;
+  if (matches.length !== 1)
+    throw new Error("Legacy publication has ambiguous artifacts; original files were preserved");
+  const entry = matches[0]!;
+  const found = new RegExp(`^(${LEGACY_UUID_V4})(\\.[a-z0-9]+)$`).exec(entry.slice(stem.length));
+  if (!found || found[2] !== normalizeArtifactExtension(found[2]!)) {
+    throw new Error("Legacy publication filename is corrupt; original files were preserved");
+  }
+  return { id: `tool-result-${found[1]}`, entry };
+}
+
+export async function readBinaryArtifactEntries(
+  sessionDir: string,
+  request: { sessionId: string; idempotencyKey: string; toolCallId?: string },
+): Promise<string[]> {
+  try {
+    if (request.toolCallId !== undefined) {
+      const directory = await lstat(sessionDir);
+      if (!directory.isDirectory() || directory.isSymbolicLink()) {
+        throw new Error(
+          "Legacy publication Session directory is corrupt; original files were preserved",
+        );
+      }
+    }
+    return await readdir(sessionDir);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    // Even an empty directory cannot authorize a noncanonical legacy lookup to recopy.
+    locateBinaryArtifactPublication([], request);
+    return [];
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/storage/tool-artifact-read.ts b/apps/zcode-cli/packages/adapters/src/storage/tool-artifact-read.ts
