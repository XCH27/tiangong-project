+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { randomUUID, createHash } from "node:crypto";
+import { mkdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import vm from "node:vm";
+import ts from "typescript";
+import type { NodeToolArtifactStore } from "@zcode/adapters/storage";
+import type { ToolArtifactStorePort } from "@zcode/contracts";
+import {
+  sanitizePathSegment,
+  extensionForContentType,
+  extensionForBinaryContentType,
+  normalizeArtifactExtension,
+} from "../../../adapters/src/storage/tool-artifact-values.js";
+import { maybeThrowStorageFsFault } from "../../../adapters/src/storage/fs-fault-injection.js";
+
+export const LEGACY_WRITER_PIN = "3687caf0e6220ab801ad45419ba1fe75f30cc331";
+type Writer<K extends "writeToolResultArtifact" | "writeToolResultBinaryArtifact"> = NonNullable<
+  ToolArtifactStorePort[K]
+>;
+
+/** Executes only the pinned original product writer body, with actual Node filesystem functions. */
+export function pinnedLegacyWriter<
+  K extends "writeToolResultArtifact" | "writeToolResultBinaryArtifact",
+>(store: NodeToolArtifactStore, name: K): Writer<K> {
+  const methods = {
+    writeToolResultArtifact: {
+      filename: "legacy-writeToolResultArtifact.method.txt",
+      sha256: "152726cb120e3c7af05916cbebfb0ca816e4476a067c2c01d00e524746f2bedb",
+    },
+    writeToolResultBinaryArtifact: {
+      filename: "legacy-writeToolResultBinaryArtifact.method.txt",
+      sha256: "9f8e2a2c2e6cf2f7711dcad42a87330169aa77f8353d304ec28f76e05447e072",
+    },
+  };
+  const fixture = methods[name];
+  const bytes = readFileSync(new URL(`./fixtures/${fixture.filename}`, import.meta.url));
+  assert.equal(
+    createHash("sha256").update(bytes).digest("hex"),
+    fixture.sha256,
+    "pinned original method fixture changed",
+  );
+  const source = `class NodeToolArtifactStore {${bytes.toString("utf8")}}`;
+  const parsed = ts.createSourceFile("pinned-storage.ts", source, ts.ScriptTarget.Latest, true);
+  const owner = parsed.statements.find(
+    (node): node is ts.ClassDeclaration =>
+      ts.isClassDeclaration(node) && node.name?.text === "NodeToolArtifactStore",
+  );
+  assert.ok(owner);
+  const method = owner.members.find(
+    (node): node is ts.MethodDeclaration =>
+      ts.isMethodDeclaration(node) && node.name.getText(parsed) === name,
+  );
+  assert.ok(method);
+  const javascript = ts.transpileModule(
+    `class PinnedWriter {${method.getText(parsed)}}\nPinnedWriter.prototype.${name};`,
+    { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.None } },
+  ).outputText;
+  const value: unknown = vm.runInNewContext(javascript, {
+    Buffer,
+    Date,
+    crypto: { randomUUID },
+    createHash,
+    mkdir,
+    writeFile,
+    join,
+    sanitizePathSegment,
+    extensionForContentType,
+    extensionForBinaryContentType,
+    normalizeArtifactExtension,
+    maybeThrowStorageFsFault,
+  });
+  assert.ok(typeof value === "function");
+  return value.bind(store) as Writer<K>;
+}
