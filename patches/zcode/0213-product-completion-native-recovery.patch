+          );
+          check(
+            sessions.getState().getWorkspaceState(workspace).activeTaskId === fixture.nativeSession,
+            "Save failed to select original owning Session",
+          );
+          check(
+            node.querySelector('[data-testid="whiteboard-save"]'),
+            "Session selection discarded original whiteboard tab",
+          );
+          await act(async () => {
+            fixture.publish(fixture.nativeSession, true);
+            await tick();
+          });
+          check(
+            document.body.textContent?.includes(fixture.permissionSummary),
+            "Original V4 approval was not visible after first Save",
+          );
+          check(
+            boards.getState().getBoard({ workspacePath: workspace, boardId: board.id })?.strokes
+              .length === 1,
+            "Session/approval transition erased original draft",
+          );
+          if (scenario === "completed") {
+            await click('[data-permission-option-kind="allowOnce"]');
+            check(
+              fixture.commands.filter((command) => command.type === "resolveInteraction").length ===
+                1,
+              "Successful Save did not answer one original owning Session approval",
+            );
+            await act(async () => {
+              fixture.releaseWrite();
+              await tick();
+            });
+            const projection = boards.getState().workspaces[workspace]?.nativeById?.[board.id];
+            check(
