@@ -0,0 +1,35 @@
+import type { V4GatewayHost } from "../zcode-protocol-v4/v4-gateway.js";
+
+import { resolveSessionModelContextWindow } from "./workspace-model-runtime.js";
+import { readSessionContextUsage } from "./server-operations.js";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+import {
+  sessionUsageSeedFromRuntimeContextUsage,
+  readRetainedMainUsage,
+} from "./v4-bridge-values.js";
+
+export function createV4GatewayHostGetSessionUsageSeed(factoryBindings: {
+  readonly context: ZCodeProtocolAgentServerContext;
+}): V4GatewayHost["getSessionUsageSeed"] {
+  return (
+    {
+      getSessionUsageSeed: async (sessionId, persistedMessages) => {
+        const record = factoryBindings.context.sessions.get(sessionId);
+        if (!record) return null;
+        const [contextUsage, lastRequest] = await Promise.all([
+          readSessionContextUsage(factoryBindings.context, sessionId, persistedMessages),
+          readRetainedMainUsage(factoryBindings.context, sessionId),
+        ]);
+        // usage seed 会在 hydration 后再次覆盖首帧分母；必须与合成事件
+        // 使用同一份当前模型 registry 真值，不能把旧 runtime projection 的窗口写回来。
+        return sessionUsageSeedFromRuntimeContextUsage(
+          contextUsage,
+          resolveSessionModelContextWindow(factoryBindings.context, record),
+          lastRequest?.lastRequest,
+          lastRequest?.cumulativeMainUsage,
+        );
+      },
+    } satisfies Pick<V4GatewayHost, "getSessionUsageSeed">
+  ).getSessionUsageSeed;
+}
