+    const cp = await cold.listCheckpoints();
+    assert.equal(cp.length, 1);
+    assert.ok(cp[0]!.checkpointId.startsWith(`${fork.forkedSessionId}:native-whiteboard:`));
+    const childMessages = await store.messages({ sessionID: fork.forkedSessionId });
+    assert.ok(childMessages.some((message) => message.info.id === cp[0]!.messageId));
