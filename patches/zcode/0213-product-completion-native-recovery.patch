-    typeof manifest.homepage === "string" && manifest.homepage.trim().length > 0
-      ? manifest.homepage
-      : undefined;
-  const metadata: PluginManifestDisplayMetadata = {
-    ...(author?.name ? { author: author.name } : {}),
-    ...(author?.url ? { authorUrl: author.url } : {}),
