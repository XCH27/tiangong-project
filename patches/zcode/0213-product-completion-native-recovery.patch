@@ -0,0 +1,81 @@
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { randomUUID } from "node:crypto";
+import {
+  createMcpAdapter,
+  createMcpAdapterConnectionPool,
+} from "../../../adapters/src/mcp/index.js";
+import type { McpServerConfig } from "@zcode/contracts";
+import { fixture } from "./pi-runtime-fixture.js";
+
+export async function nativePluginFixture(siblings = false) {
+  const data = await mkdtemp(join(tmpdir(), "owned-native-plugin-"));
+  const pool = siblings ? createMcpAdapterConnectionPool({ env: {} }) : undefined;
+  const mcp =
+    pool?.acquireLease({ leaseId: "authored-native-session" }) ?? createMcpAdapter({ env: {} });
+  const config = (name: string, toolName = "increment"): McpServerConfig => ({
+    type: "stdio",
+    command: process.execPath,
+    args: [
+      resolve(
+        import.meta.dirname,
+        "../../../bootstrap/test/fixtures/plugin-view/native-control-server.mjs",
+      ),
+    ],
+    protocolVersion: "legacy",
+    env: { ZCODE_PLUGIN_DATA: join(data, name), ZCODE_PLUGIN_WRITE_TOOL: toolName },
+  });
+  const original = config("counter"),
+    sibling = config("sibling");
+  const f = await fixture(undefined, false, {
+    config: {
+      toolAllowlist: undefined,
+      mcp: { enabled: true, servers: { counter: original, ...(siblings ? { sibling } : {}) } },
+    },
+    deps: { mcpPort: mcp },
+  });
+  return {
+    f,
+    mcp,
+    config,
+    original,
+    sibling,
+    run(
+      toolName = "increment",
+      expectedServerConfig = original,
+      assertAvailable: (signal: AbortSignal) => Promise<void> = async (signal) =>
+        signal.throwIfAborted(),
+      operationId = randomUUID(),
+      abortSignal?: AbortSignal,
+    ) {
+      return f.runtime.performPluginViewControl(
+        { serverName: "counter", toolName, arguments: {} },
+        { operationId, expectedServerConfig, assertAvailable, abortSignal },
+      );
+    },
+    async count(name = "counter") {
+      try {
+        return JSON.parse(await readFile(join(data, name, "counter.json"), "utf8")).value as number;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ENOENT") return 0;
+        throw error;
+      }
+    },
+    async effectCalls() {
+      try {
+        return (await readFile(join(data, "counter", "effects.ndjson"), "utf8")).trim().split("\n")
+          .length;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ENOENT") return 0;
+        throw error;
+      }
+    },
+    async close() {
+      await mcp.close();
+      await pool?.close();
+      await f.close();
+      await rm(data, { recursive: true, force: true });
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/core/test/helpers/native-whiteboard-effective-fixture.ts b/apps/zcode-cli/packages/core/test/helpers/native-whiteboard-effective-fixture.ts
