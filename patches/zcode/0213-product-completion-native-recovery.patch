@@ -0,0 +1,53 @@
+import type { createModelTelemetry } from "@zcode/telemetry";
+import type { ConfigResult } from "@zcode/adapters/config";
+import type { Logger } from "@zcode/core";
+
+import { createAppModelAdapterOptionsOptions } from "./app-model-adapter-options-options.js";
+
+import { createModelAdapter } from "../model-factory.js";
+
+import type { ZCodeAppOptions } from "./types.js";
+
+import { getWorkflowConcurrencyGovernor } from "./workflow-concurrency-governor.js";
+
+import { createRuntimeAiSdkModelExecutionConfig } from "../model-config.js";
+
+export function createAppModelResources(factoryBindings: {
+  readonly options: ZCodeAppOptions;
+  readonly appVersion: string;
+  readonly configResult: ConfigResult;
+  readonly modelLogger: Logger;
+  readonly modelIoDir: string;
+  readonly modelTelemetry: ReturnType<typeof createModelTelemetry>;
+}): {
+  modelExecutionConfig: ReturnType<typeof createRuntimeAiSdkModelExecutionConfig>;
+  modelAdapter: ReturnType<typeof createModelAdapter>;
+  workflowConcurrencyGovernor: ReturnType<typeof getWorkflowConcurrencyGovernor>;
+} {
+  const modelExecutionConfig = createRuntimeAiSdkModelExecutionConfig(factoryBindings.options.env, {
+    appVersion: factoryBindings.appVersion,
+    network: factoryBindings.configResult.config.network,
+    sourceTitle: factoryBindings.options.sourceTitle,
+  });
+  const modelAdapter =
+    factoryBindings.options.modelAdapter ??
+    createModelAdapter(
+      createAppModelAdapterOptionsOptions({
+        options: factoryBindings.options,
+        modelLogger: factoryBindings.modelLogger,
+        modelIoDir: factoryBindings.modelIoDir,
+        modelExecutionConfig,
+        modelTelemetry: factoryBindings.modelTelemetry,
+        configResult: factoryBindings.configResult,
+      }),
+    );
+  if (factoryBindings.options.modelAdapter && factoryBindings.modelTelemetry.statusSink) {
+    modelAdapter.addStatusSink(factoryBindings.modelTelemetry.statusSink);
+  }
+  // 进程级并发治理器：run service 拿它的窄端口给
+  // driver（每个 actor runtime 一个请求级准入端口）；主 runtime 挂它的 observer（下面 deps）——
+  // 不排队、不看冷却，但计入在飞并喂信号。进程级单例——配额本就在账号上，不按会话分。
+  // 不再经 adapter 级 addStatusSink 喂信号：同一事件只能沿 ticket 喂一次。
+  const workflowConcurrencyGovernor = getWorkflowConcurrencyGovernor();
+  return { modelExecutionConfig, modelAdapter, workflowConcurrencyGovernor };
+}
