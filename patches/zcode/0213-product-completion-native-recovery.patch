diff --git a/packages/ui/test/nativeSessionPresentation.test.ts b/packages/ui/test/nativeSessionPresentation.test.ts
new file mode 100644
index 00000000..b55ff136
--- /dev/null
+++ b/packages/ui/test/nativeSessionPresentation.test.ts
@@ -0,0 +1,132 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { withNativeSessionPresentation } from "../src/lib/nativeSessionPresentation.js";
+import { acquireWorkspaceConnection } from "../src/v4/workspaceConnectionRegistry.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+const tick = async () => {
+  for (let i = 0; i < 24; i++) await Promise.resolve();
+};
+test.beforeEach((t) => t.mock.timers.enable({ apis: ["setTimeout", "setInterval"] }));
+test.afterEach((t) => t.mock.timers.tick(30_001));
+function fixture() {
+  const f = nativePresentationAgent();
+  const workspace = { workspacePath: `/native-presentation-${crypto.randomUUID()}` };
+  let calls = 0;
+  const input = {
+    agent: f.agent,
+    workspace,
+    sessionId: "owned-session",
+    isCurrent: () => true,
+    present() {},
+    dispatch: async () => {
+      calls++;
+      return "settled";
+    },
+  };
+  return {
+    ...f,
+    input,
+    get calls() {
+      return calls;
+    },
+  };
+}
+test("held original subscription prevents native dispatch until real projection hydration", async () => {
+  const f = fixture(),
+    ready = Promise.withResolvers<void>();
+  f.hold(ready.promise);
+  const pending = withNativeSessionPresentation(f.input);
+  await tick();
+  assert.equal(f.calls, 0);
+  ready.resolve();
+  assert.equal(await pending, "settled");
+  assert.equal(f.calls, 1);
+});
+test("caught subscription failure refuses before native dispatch", async () => {
+  const f = fixture();
+  f.fail(new Error("Owned subscribe failed"));
+  await assert.rejects(withNativeSessionPresentation(f.input), /Owned subscribe failed/);
+  assert.equal(f.calls, 0);
+});
+for (const refusal of ["timeout", "scope", "disconnect"]) {
+  test(`${refusal} during subscription refuses before dispatch`, async (t) => {
+    const f = fixture(),
+      ready = Promise.withResolvers<void>();
+    let current = true;
+    f.hold(ready.promise);
+    const pending = withNativeSessionPresentation({ ...f.input, isCurrent: () => current });
+    const refused = assert.rejects(
+      pending,
+      new RegExp(
+        refusal === "scope"
+          ? "context changed"
+          : refusal === "timeout"
+            ? "timed out"
+            : "disconnected",
+      ),
+    );
+    await tick();
+    if (refusal === "timeout") t.mock.timers.tick(30_001);
+    if (refusal === "scope") {
+      current = false;
+      t.mock.timers.tick(101);
+    }
+    if (refusal === "disconnect") f.disconnect(f.input.workspace.workspacePath);
+    await refused;
+    assert.equal(f.calls, 0);
+    ready.resolve();
+    await tick();
+  });
+}
+test("an existing pane and actor share one subscription and keep it leased through settlement", async (t) => {
+  const f = fixture(),
+    connection = acquireWorkspaceConnection(f.input.workspace, f.input.agent);
+  const pane = connection.layer.acquire(f.input.sessionId);
+  await tick();
+  const original = pane.store.getState().subscriptionId;
+  const settled = Promise.withResolvers<string>();
+  const pending = withNativeSessionPresentation({ ...f.input, dispatch: () => settled.promise });
+  await tick();
+  pane.release();
+  connection.release();
+  t.mock.timers.tick(30_001);
+  assert.equal(pane.store.getState().subscriptionId, original);
+  assert.equal(pane.store.getState().status, "live");
+  settled.resolve("completed");
+  assert.equal(await pending, "completed");
+  t.mock.timers.tick(30_001);
+  assert.equal(pane.store.getState().status, "closed");
+});
+
+test("ACK without the initial snapshot never dispatches a cold native action", async (t) => {
+  const f = fixture();
+  f.omitInitialFrame();
+  const pending = withNativeSessionPresentation(f.input);
+  const refused = assert.rejects(pending, /timed out/);
+  await tick();
+  assert.equal(f.calls, 0);
+  t.mock.timers.tick(30_001);
+  await refused;
+});
+test("a reconnect ACK cannot treat the retained previous snapshot as hydrated", async (t) => {
+  const f = fixture(),
+    connection = acquireWorkspaceConnection(f.input.workspace, f.input.agent);
+  const pane = connection.layer.acquire(f.input.sessionId);
+  await tick();
+  const old = pane.store.getState().snapshot;
+  const gate = Promise.withResolvers<void>();
+  f.hold(gate.promise);
+  f.omitInitialFrame();
+  const retrying = pane.store.retry();
+  const pending = withNativeSessionPresentation(f.input),
+    refused = assert.rejects(pending, /timed out/);
+  gate.resolve();
+  await retrying;
+  await tick();
+  assert.equal(pane.store.getState().snapshot, old);
+  assert.equal(f.calls, 0);
+  t.mock.timers.tick(30_001);
+  await refused;
+  pane.release();
+  connection.release();
+});
diff --git a/packages/ui/test/nativeSessionPresentationHost.test.ts b/packages/ui/test/nativeSessionPresentationHost.test.ts
new file mode 100644
index 00000000..5619a890
--- /dev/null
+++ b/packages/ui/test/nativeSessionPresentationHost.test.ts
@@ -0,0 +1,177 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { whiteboardRelativePath, zcodeProtocolMethods as M } from "@zcode/shared";
+import { V4_METHODS as V } from "@zcode/shared/zcode-protocol-v4";
+import { nativePresentationHost, waitFor } from "./helpers/nativePresentationHost.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import { callNativePluginViewTool } from "../src/lib/nativePluginViewControl.js";
+import {
+  NATIVE_WHITEBOARD_SESSION_NAVIGATION,
+  type NativeSurfaceNavigation,
+} from "../src/lib/nativeWhiteboardNavigation.js";
+import { useWhiteboardStore } from "../src/store/whiteboardStore.js";
+
+for (const decision of ["allow", "deny"] as const) {
+  test(`first public native Save admits real same-channel projection before approval (${decision})`, async (t) => {
+    const h = await nativePresentationHost("whiteboard");
+    useWhiteboardStore.setState({ ...useWhiteboardStore.getInitialState() }, true);
+    const board = useWhiteboardStore
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned drawing" });
+    const target = { ...h.workspace, boardId: board.id };
+    let sessionId: string | undefined;
+    const saving = saveNativeWhiteboardDraft({
+      target,
+      agent: h.agent,
+      showSession: (_, id) => {
+        sessionId = id;
+      },
+    });
+    try {
+      await waitFor(() => !!h.permission, "real reverse approval request");
+      assert.ok(sessionId);
+      const detail = h.observer.layer.acquire(sessionId);
+      try {
+        await waitFor(
+          () => !!detail.store.getState().snapshot?.pendingInteractions.length,
+          "real approval in original projection",
+        );
+        assert.equal(detail.store.getState().status, "live");
+        assert.ok(detail.store.getState().snapshot!.rows.window.length >= 2);
+        assert.ok(
+          h.methods.indexOf(V.conversationSubscribe) <
+            h.methods.indexOf(M.sessionWhiteboardControl),
+        );
+        h.answer(decision);
+        assert.equal(await saving, decision === "allow");
+        assert.equal(h.f.calls.length, 0);
+        assert.equal(h.f.httpCalls, 0);
+        const native =
+          useWhiteboardStore.getState().workspaces[h.workspace.workspacePath]!.nativeById![
+            board.id
+          ]!;
+        if (decision === "allow") {
+          const file = JSON.parse(
+            await readFile(
+              join(h.workspace.workspacePath, whiteboardRelativePath(board.id)),
+              "utf8",
+            ),
+          );
+          assert.deepEqual(file.board, board);
+          assert.ok(native.committed);
+        } else {
+          await assert.rejects(
+            readFile(join(h.workspace.workspacePath, whiteboardRelativePath(board.id))),
+            { code: "ENOENT" },
+          );
+          assert.equal(native.committed, undefined);
+          assert.equal(native.error, "whiteboard.saveUnapproved");
+          assert.equal(useWhiteboardStore.getState().getBoard(target), board);
+        }
+      } finally {
+        detail.release();
+      }
+    } finally {
+      if (h.permission) h.answer("deny");
+      await saving;
+      await h.close(t);
+    }
+  });
+}
+
+test("first public plugin app tool admits real same-channel projection before one SDK effect", async (t) => {
+  const h = await nativePresentationHost("plugin");
+  const previous = Object.getOwnPropertyDescriptor(globalThis, "window"),
+    events = new EventTarget();
+  Object.defineProperty(globalThis, "window", { configurable: true, value: events });
+  let sessionId: string | undefined;
+  events.addEventListener(NATIVE_WHITEBOARD_SESSION_NAVIGATION, (event) => {
+    const detail = (event as CustomEvent<NativeSurfaceNavigation>).detail;
+    sessionId = detail.sessionId;
+    detail.handled = true;
+  });
+  const target = { ...h.workspace, pluginId: h.plugin!.info().id, viewId: "main" };
+  const calling = callNativePluginViewTool({
+    target,
+    agent: h.agent,
+    plugins: h.plugins,
+    tool: "increment",
+    arguments: {},
+    isCurrent: () => true,
+  });
+  try {
+    await waitFor(() => !!h.permission, "plugin reverse approval");
+    assert.ok(sessionId);
+    const detail = h.observer.layer.acquire(sessionId);
+    try {
+      await waitFor(
+        () => !!detail.store.getState().snapshot?.pendingInteractions.length,
+        "plugin approval in real projection",
+      );
+      assert.equal(await h.plugin!.count(), 0);
+      assert.ok(
+        h.methods.indexOf(V.conversationSubscribe) < h.methods.indexOf(M.pluginsViewCallTool),
+      );
+      h.answer("allow");
+      const result = await calling;
+      assert.deepEqual(result.structuredContent, { value: 1 });
+      assert.equal(await h.plugin!.count(), 1);
+      assert.equal(h.f.calls.length, 0);
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      detail.release();
+    }
+  } finally {
+    if (h.permission) h.answer("deny");
+    await calling.catch(() => {});
+    if (previous) Object.defineProperty(globalThis, "window", previous);
+    else Reflect.deleteProperty(globalThis, "window");
+    await h.close(t);
+  }
+});
+
+for (const mode of ["snapshot", "resume"] as const) {
+  test(`real ${mode} reconnect ACK reads current base only after original connect unwinds`, async (t) => {
+    const h = await nativePresentationHost("whiteboard");
+    const created = await h.request(M.sessionCreate, {
+      workspace: h.workspace,
+      persistence: "deferred",
+    });
+    const sessionId = created.session.sessionId;
+    const pane = h.observer.layer.acquire(sessionId);
+    try {
+      await waitFor(
+        () => pane.store.hasCurrentSubscriptionProjection(),
+        "original hydrated projection",
+      );
+      const oldSnapshot = pane.store.getState().snapshot,
+        oldSubscription = pane.store.getState().subscriptionId;
+      h.holdFrames();
+      const duringAck: boolean[] = [];
+      const off = pane.store.subscribe(() => {
+        const state = pane.store.getState();
+        if (state.status === "live" && state.subscriptionId !== oldSubscription)
+          duringAck.push(pane.store.hasCurrentSubscriptionProjection());
+      });
+      // Only the fixture asks the ORIGINAL store to reconnect; production helper never does.
+      await pane.store.connect({ forceSnapshot: mode === "snapshot" });
+      off();
+      assert.deepEqual(duringAck, [false]);
+      assert.equal(pane.store.getState().snapshot, oldSnapshot);
+      assert.equal(pane.store.hasCurrentSubscriptionProjection(), mode === "resume");
+      h.releaseFrames();
+      await waitFor(
+        () => pane.store.hasCurrentSubscriptionProjection(),
+        "delayed actual initial frame",
+      );
+      assert.equal(h.f.calls.length, 0);
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      h.releaseFrames();
+      pane.release();
+      await h.close(t);
+    }
+  });
+}
diff --git a/packages/ui/test/nativeWhiteboardCloseStop.test.ts b/packages/ui/test/nativeWhiteboardCloseStop.test.ts
new file mode 100644
index 00000000..dc307e7d
--- /dev/null
+++ b/packages/ui/test/nativeWhiteboardCloseStop.test.ts
@@ -0,0 +1,263 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { zcodeProtocolMethods as M, whiteboardRelativePath } from "@zcode/shared";
+import { V4_METHODS as V } from "@zcode/shared/zcode-protocol-v4";
+import { nativePresentationHost, waitFor } from "./helpers/nativePresentationHost.js";
+import { saveNativeWhiteboardDraft } from "../src/lib/nativeWhiteboardDraft.js";
+import { useWhiteboardStore as store } from "../src/store/whiteboardStore.js";
+
+for (const window of ["creation", "initial", "queued", "permission"] as const) {
+  test(`original pending owns Stop for close-shaped Save during ${window}`, async (t) => {
+    const h = await nativePresentationHost("whiteboard");
+    store.setState({ ...store.getInitialState() }, true);
+    const board = store
+        .getState()
+        .createBoard({ ...h.workspace, defaultNamePrefix: "Owned close Stop" }),
+      target = { ...h.workspace, boardId: board.id };
+    let sessionId: string | undefined,
+      forwarded = 0,
+      settled = false;
+    let ordinary: Promise<unknown> | undefined, release: (() => void) | undefined;
+    let pane: ReturnType<typeof h.observer.layer.acquire> | undefined;
+    const control = h.agent.performWhiteboardControl.bind(h.agent);
+    h.agent.performWhiteboardControl = (input) => {
+      forwarded++;
+      return control(input);
+    };
+    if (window === "creation") h.holdCreation();
+    if (window === "initial") h.holdFrames();
+    if (window === "queued") {
+      const created = await h.request(M.sessionCreate, {
+        workspace: h.workspace,
+        persistence: "deferred",
+      });
+      sessionId = created.session.sessionId;
+      pane = h.observer.layer.acquire(sessionId!);
+      await waitFor(
+        () => pane!.store.hasCurrentSubscriptionProjection(),
+        "real close Session base",
+      );
+      const get = h.store.getSession.bind(h.store),
+        entered = Promise.withResolvers<void>(),
+        gate = Promise.withResolvers<void>();
+      let hold = true;
+      release = gate.resolve;
+      h.store.getSession = async (id) => {
+        if (hold) {
+          hold = false;
+          entered.resolve();
+          await gate.promise;
+        }
+        return get(id);
+      };
+      ordinary = h.request(M.sessionRead, { sessionId });
+      await entered.promise;
+    }
+    // Exact window/pane-close shape: no hook onStarted/controller/external signal.
+    const saving = saveNativeWhiteboardDraft({
+      target,
+      agent: h.agent,
+      sessionId,
+      showSession: (_, id) => {
+        sessionId = id;
+      },
+      isCurrent: () => true,
+    }).then((result) => {
+      settled = true;
+      return result;
+    });
+    try {
+      await waitFor(
+        () =>
+          window === "creation"
+            ? h.heldCreations === 1
+            : window === "initial"
+              ? !!sessionId && h.methods.includes(V.conversationSubscribe)
+              : window === "queued"
+                ? forwarded === 1
+                : !!h.permission,
+        "original close preparation/dispatch",
+      );
+      const pending =
+        store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+      assert.equal(typeof pending.cancel, "function");
+      pending.cancel!();
+      if (window === "creation" || window === "initial") {
+        await waitFor(() => settled, "close Save settles before late receipt");
+        assert.equal(await saving, false);
+        assert.equal(h.methods.includes(M.sessionWhiteboardControl), false);
+      } else {
+        assert.equal(
+          store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending,
+          pending,
+        );
+      }
+      release?.();
+      await ordinary;
+      h.releaseCreation();
+      h.releaseFrames();
+      await waitFor(() => settled, "original close actor cancellation receipt");
+      assert.equal(await saving, false);
+      await new Promise((resolve) => setTimeout(resolve, 30));
+      const native = store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!;
+      assert.equal(native.pending, undefined);
+      assert.equal(native.committed, undefined);
+      assert.equal(
+        "cancel" in native.retry!,
+        false,
+        "Execution callback cannot enter durable retry",
+      );
+      assert.equal(store.getState().getBoard(target), board);
+      if (window === "creation" || window === "initial") assert.equal(h.permission, undefined);
+      await assert.rejects(readFile(join(target.workspacePath, whiteboardRelativePath(board.id))), {
+        code: "ENOENT",
+      });
+      assert.equal(h.f.calls.length, 0);
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      release?.();
+      await ordinary;
+      h.releaseCreation();
+      h.releaseFrames();
+      if (!settled) {
+        await waitFor(() => settled || !!h.permission, "owned fixture rescue");
+        if (h.permission) h.answer("deny");
+      }
+      await saving;
+      pane?.release();
+      await h.close(t);
+    }
+  });
+}
+
+test("close Save Stop delivery failure stays visible until the actual allowed receipt", async (t) => {
+  const h = await nativePresentationHost("whiteboard");
+  store.setState({ ...store.getInitialState() }, true);
+  const board = store
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned close uncertainty" }),
+    target = { ...h.workspace, boardId: board.id };
+  const send = h.agent.sendConversationCommandV4.bind(h.agent);
+  h.agent.sendConversationCommandV4 = async (input) => {
+    if (input.envelope.type === "stop") throw new Error("Owned close Stop delivery failed");
+    return send(input);
+  };
+  let settled = false;
+  const saving = saveNativeWhiteboardDraft({
+    target,
+    agent: h.agent,
+    showSession() {},
+    isCurrent: () => true,
+  }).then((result) => {
+    settled = true;
+    return result;
+  });
+  try {
+    await waitFor(() => !!h.permission, "actual close approval");
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+    pending.cancel!();
+    await waitFor(
+      () => !!store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.error,
+      "visible original pending error",
+    );
+    const uncertain = store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!;
+    assert.equal(uncertain.pending, pending);
+    assert.equal(uncertain.committed, undefined);
+    assert.equal(settled, false);
+    assert.match(uncertain.error!, /Owned close Stop delivery failed/);
+    h.answer("allow");
+    assert.equal(await saving, true);
+    const saved = store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!;
+    assert.equal(saved.error, undefined);
+    assert.equal(saved.pending, undefined);
+    assert.ok(saved.committed);
+    store.getState().reportNativeSaveError({
+      ...target,
+      requestId: pending.requestId,
+      error: "Late old failure",
+    });
+    assert.equal(store.getState().workspaces[target.workspacePath]!.nativeById![board.id], saved);
+    const file = JSON.parse(
+      await readFile(join(target.workspacePath, whiteboardRelativePath(board.id)), "utf8"),
+    );
+    assert.deepEqual(file.board, board);
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    if (!settled && h.permission) h.answer("deny");
+    await saving;
+    await h.close(t);
+  }
+});
+
+test("original window-close handshake returns false after pending-owned Stop and preserves the draft", async (t) => {
+  const { installNativeWhiteboardCloseBridge } =
+    await import("../src/lib/nativeWhiteboardCloseBridge.js");
+  const { useConfirmDialogStore } = await import("../src/store/confirmDialogStore.js");
+  const h = await nativePresentationHost("whiteboard");
+  store.setState({ ...store.getInitialState() }, true);
+  const board = store
+      .getState()
+      .createBoard({ ...h.workspace, defaultNamePrefix: "Owned CmdQ Stop" }),
+    target = { ...h.workspace, boardId: board.id };
+  h.holdFrames();
+  let listener:
+    | ((request: { requestId: string; phase?: "request" | "cancelled" }) => void)
+    | undefined;
+  const replies: Array<{ requestId: string; allowClose: boolean }> = [];
+  const requestId = crypto.randomUUID();
+  const remove = installNativeWhiteboardCloseBridge(
+    {
+      onNativeWhiteboardCloseRequest: (callback) => {
+        listener = callback;
+        return {
+          dispose() {
+            listener = undefined;
+          },
+        };
+      },
+      completeNativeWhiteboardClose: async (result) => {
+        replies.push(result);
+        listener?.({ requestId: result.requestId, phase: "cancelled" });
+      },
+      publishNativeWhiteboardDraftState() {},
+    },
+    {
+      format: (id) => id,
+      save: (input) =>
+        saveNativeWhiteboardDraft({
+          target: input,
+          agent: h.agent,
+          showSession() {},
+          isCurrent: () => true,
+        }),
+    },
+  );
+  try {
+    listener!({ requestId });
+    await waitFor(() => !!useConfirmDialogStore.getState().pendingRequest, "original close choice");
+    useConfirmDialogStore.getState().settleChoice("confirm");
+    await waitFor(() => h.methods.includes(V.conversationSubscribe), "held close initial");
+    const pending =
+      store.getState().workspaces[target.workspacePath]!.nativeById![board.id]!.pending!;
+    pending.cancel!();
+    await waitFor(() => replies.length === 1, "original close acknowledgement");
+    assert.deepEqual(replies, [{ requestId, allowClose: false }]);
+    assert.equal(store.getState().nativeCloseFrozen, false);
+    assert.equal(store.getState().getBoard(target), board);
+    h.releaseFrames();
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    assert.equal(h.methods.includes(M.sessionWhiteboardControl), false);
+    assert.equal(h.permission, undefined);
+    assert.equal(h.f.calls.length, 0);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    remove();
+    useConfirmDialogStore.getState().settleChoice("dismiss");
+    h.releaseFrames();
+    await h.close(t);
+  }
+});
diff --git a/packages/ui/test/nativeWhiteboardConnection.test.ts b/packages/ui/test/nativeWhiteboardConnection.test.ts
