index 00000000..8b0602b3
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/workflow-artifact-recovery.ts
@@ -0,0 +1,89 @@
+import type { SessionId, ToolArtifactStorePort, ToolArtifactWriteResult } from "@zcode/contracts";
+import { ARTIFACT_CAPS, WorkflowError, type ArtifactPublishRequest } from "@zcode/dynamic-workflow";
+import { resolveWithinWorkspace, toWorkspaceRelative } from "./workflow-world-read.js";
+
+export type ArtifactPayload =
+  | {
+      readonly kind: "binary";
+      readonly bytes: Uint8Array;
+      readonly contentType: string;
+      readonly extension?: string;
+      readonly sourcePath: string;
+    }
+  | { readonly kind: "text"; readonly text: string; readonly contentType: "text/markdown" };
+
+/** Original producer identity; versions and accepted input hashes remain the Engine's journal facts. */
+export function artifactPublicationKey(
+  sessionId: SessionId,
+  request: ArtifactPublishRequest,
+): string {
+  return JSON.stringify([
+    "workflow-artifact-v1",
+    sessionId,
+    request.runId,
+    request.siteId,
+    request.ordinal,
+  ]);
+}
+
+export async function observeArtifactPublication(input: {
+  store: ToolArtifactStorePort;
+  sessionId: SessionId;
+  idempotencyKey: string;
+  request: ArtifactPublishRequest;
+  cwd: string;
+  contentType?: string;
+  markdown?: Extract<ArtifactPayload, { kind: "text" }>;
+  extensionForPath: (path: string) => string | undefined;
+  contentTypeForExtension: (extension: string | undefined) => string;
+}): Promise<{ written: ToolArtifactWriteResult; payload: ArtifactPayload } | undefined> {
+  const written = await input.store.findToolResultBinaryArtifactOnce?.({
+    sessionId: input.sessionId,
+    idempotencyKey: input.idempotencyKey,
+    toolCallId: `${input.request.runId}:${input.request.siteId}@${input.request.ordinal}`,
+  });
+  if (!written) return;
+  const read = input.store.readToolResultBinaryArtifact;
+  if (!read)
+    throw new WorkflowError(
+      "ArtifactStoreUnavailable",
+      "Committed artifact bytes cannot be observed by this store.",
+    );
+  if (written.bytes > ARTIFACT_CAPS.maxFileBytes)
+    throw new WorkflowError(
+      "ArtifactTooLarge",
+      "Committed artifact exceeds the original publication byte limit.",
+    );
+  const committed = await read.call(input.store, { uri: written.uri });
+  if (input.request.op === "markdown") {
+    const markdown = input.markdown;
+    if (!markdown || !Buffer.from(committed.bytes).equals(Buffer.from(markdown.text, "utf8"))) {
+      throw new WorkflowError(
+        "DriverError",
+        "Committed artifact differs from this publication; original bytes were preserved.",
+      );
+    }
+    return { written, payload: markdown };
+  }
+  const given = input.request.path;
+  const resolved =
+    typeof given === "string" && given ? resolveWithinWorkspace(input.cwd, given) : undefined;
+  if (!resolved)
+    throw new WorkflowError(
+      "ArtifactPathOutsideWorkspace",
+      "Committed artifact source identity is outside the original workspace.",
+    );
+  if (!written.path)
+    throw new WorkflowError("DriverError", "Committed artifact has no native extension identity.");
+  const extension = input.extensionForPath(written.path);
+  return {
+    written,
+    payload: {
+      kind: "binary",
+      bytes: committed.bytes,
+      contentType: input.contentType ?? input.contentTypeForExtension(extension),
+      ...(extension === undefined ? {} : { extension }),
+      sourcePath: toWorkspaceRelative(input.cwd, resolved),
+    },
+  };
+}
