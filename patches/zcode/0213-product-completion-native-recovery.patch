index 00000000..f6c2d8b8
--- /dev/null
+++ b/packages/ui/test/nativeWhiteboardConnection.test.ts
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IZCodeAgentService } from "@zcode/services";
+import { V4_WIRE_PROTOCOL_VERSION } from "@zcode/shared/zcode-protocol-v4";
+import { acquireWorkspaceConnection } from "../src/v4/workspaceConnectionRegistry.js";
+import { createCommandEnvelope } from "../src/v4/commandFactory.js";
+import {
+  ensureNativeWhiteboardSession,
+  stopNativeWhiteboardControl,
+} from "../src/lib/nativeWhiteboardControl.js";
+
+test("native action activates the newest original remote lease before create or exact Stop", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const sent: Array<{ owner: string; envelope: any }> = [];
+  const service = (owner: string) =>
+    ({
+      helloConversationV4: async () => ({
+        kind: "hello",
+        protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+        connectionId: owner,
+        clientMode: "web-remote-replayable",
+        deliveryProfile: "replayable",
+        serverTime: Date.now(),
+        capabilities: {
+          nativeDialogs: false,
+          localTerminal: false,
+          binaryFrames: false,
+          compression: "none",
+          independentPlanState: true,
+        },
+        auth: {},
+      }),
+      initializeConversationV4: async () => {},
+      onDynamicConversationFrame: () => () => ({ dispose() {} }),
+      onAgentRuntimeRestarted: () => ({ dispose() {} }),
+      sendConversationCommandV4: async ({ envelope }: { envelope: any }) => {
+        sent.push({ owner, envelope });
+        return {
+          status: "accepted",
+          result: { type: "createSession", sessionId: `session-${owner}` },
+        };
+      },
+    }) as unknown as IZCodeAgentService;
+  const scope = {
+    workspacePath: `/native-lease-${crypto.randomUUID()}`,
+    workspaceIdentity: `remote-${crypto.randomUUID()}`,
+    remoteSessionId: `attachment-${crypto.randomUUID()}`,
+  };
+  const original = service("original"),
+    renewed = service("renewed");
+  const lease = acquireWorkspaceConnection(scope, original);
+  try {
+    assert.equal(await ensureNativeWhiteboardSession(renewed, scope, "existing-session"), "existing-session");
+    assert.equal(sent.length, 0, "Reusing an ordinary Session must not create another one");
+    await lease.transport.sendCommand(createCommandEnvelope({
+      type: "stop", sessionId: "existing-session",
+      payload: { expectedForegroundExecutionId: "authored-observation" },
+    }));
+    assert.equal(sent[0]!.owner, "renewed", "Provided Sessions also activate the action-time connection");
+    sent.length = 0;
+    assert.equal(await ensureNativeWhiteboardSession(renewed, scope), "session-renewed");
+    const operationId = crypto.randomUUID();
+    await stopNativeWhiteboardControl(renewed, scope, "session-renewed", operationId);
+    assert.deepEqual(
+      sent.map((item) => item.owner),
+      ["renewed", "renewed"],
+    );
+    assert.equal(sent[0]!.envelope.type, "createSession");
+    assert.equal(sent[0]!.envelope.payload.firstInput, undefined);
+    assert.equal(sent[1]!.envelope.sessionId, "session-renewed");
+    assert.equal(
+      sent[1]!.envelope.payload.expectedForegroundExecutionId,
+      `native-whiteboard:${operationId}`,
+    );
+  } finally {
+    lease.release();
+    t.mock.timers.tick(30_001);
+  }
+});
diff --git a/packages/ui/test/nativeWhiteboardDraftControl.test.ts b/packages/ui/test/nativeWhiteboardDraftControl.test.ts
