+    ...(input.isOfficial !== undefined ? { isOfficial: input.isOfficial } : {}),
+    ...(input.featured ? { featured: input.featured } : {}),
+    ...(input.refreshFailure ? { refreshFailure: input.refreshFailure } : {}),
+  };
