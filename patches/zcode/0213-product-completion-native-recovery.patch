@@ -0,0 +1,46 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { verifyDelivery } from "./verify-delivery.mjs";
+
+test("delivery uses current builds, types, runtime checks and strict CLI lint", () => {
+  const calls = [];
+  verifyDelivery((command, args) => calls.push([command, ...args].join(" ")));
+  const find = (value) => calls.findIndex((call) => call.includes(value));
+  for (const required of [
+    "desktop-vite-config.test.mjs",
+    "typecheck",
+    "--if-present run typecheck",
+    "verify:pre-push",
+    "build:no-runtime-assets",
+    "test:page-assistant-ui",
+    "test:plugin-market-ui",
+    "test:product-completion-ui",
+    "lint:cli",
+  ])
+    assert.ok(find(required) >= 0, `Missing ${required}`);
+  assert.ok(find("build-desktop-agent-cli.mjs") < find("typecheck"));
+  assert.ok(find("build:no-runtime-assets") < find("test:staged-agent-recovery"));
+  assert.ok(find("test:staged-agent-recovery") < find("lint:cli"));
+});
+
+test("a failed check aborts the delivery gate before later actions", () => {
+  const calls = [];
+  assert.throws(
+    () =>
+      verifyDelivery((_command, args) => {
+        calls.push(args.join(" "));
+        if (args.includes("typecheck")) throw new Error("Authored type failure");
+      }),
+    /Authored type failure/,
+  );
+  assert.ok(!calls.some((call) => call.includes("verify:pre-push")));
+  assert.ok(!calls.some((call) => call.includes("build:no-runtime-assets")));
+});
+
+test("release validates before initialization independently of configured Git hooks", async () => {
+  const { default: configuration } = await import("../.release-it.mjs");
+  assert.equal(configuration.hooks["before:init"], "pnpm verify:delivery");
+  const hooks = await readFile(new URL("../.husky/pre-push", import.meta.url), "utf8");
+  assert.match(hooks, /pnpm verify:delivery/);
+});
