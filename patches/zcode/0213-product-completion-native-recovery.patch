+// Same adapter owner; extracted adapter-owner responsibility.
+import type { Logger, McpServerStatus } from "@zcode/contracts";
+import { type OfficialMcpAuthFailureKind } from "@zcode/shared";
+import { type NetworkEgressEnvPolicy } from "./network.js";
+import { type McpConnectionContext } from "./pool.js";
+import { type McpOAuthRuntimeOptions } from "./oauth.js";
+import { type SharedZCodeCredentialStore } from "../auth/shared-credentials.js";
+import type { McpTelemetryTracker } from "./telemetry.js";
+import { type CreateMcpAdapterOptions, type McpServerRecord } from "./adapter-types.js";
+import type { NodeMcpAdapter } from "./adapter-owner.js";
+import type { McpAdapterMethods } from "./adapter-method-surface.js";
+// Structural access to the sole original connection owner.
+export type McpAdapterInternal = Omit<NodeMcpAdapter, never> &
+  McpAdapterMethods & {
+    readonly adapterInstanceId: `${string}-${string}-${string}-${string}-${string}`;
+    clientName: string;
+    clientVersion: string;
+    connectionContext?: McpConnectionContext;
+    env?: NodeJS.ProcessEnv;
+    logger?: Logger;
+    mcpOAuth?: McpOAuthRuntimeOptions;
+    network?: NetworkEgressEnvPolicy;
+    officialMcpAuth?: CreateMcpAdapterOptions["officialMcpAuth"];
+    telemetry?: McpTelemetryTracker;
+    connectionGenerations: Map<string, number>;
+    credentialStore?: SharedZCodeCredentialStore;
+    lastOfficialAuthKind: Map<string, OfficialMcpAuthFailureKind>;
+    serverRequestIdBySpan: Map<string, string>;
+    connectionDiagnosticByServer: Map<
+      string,
+      Pick<McpServerStatus, "failureKind" | "serverRequestId">
+    >;
+    records: Map<string, McpServerRecord>;
+    workingDirectory?: string;
+  };
