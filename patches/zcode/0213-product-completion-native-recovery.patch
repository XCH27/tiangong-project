+// 原 Debug 数据/组件按职责拆分；IO、React state 和回调逻辑仍由原入口拥有。
+import { AlertTriangle, BarChart3, Clock3 } from "lucide-react";
+import type { CacheReport, TimelineItem, TraceDetailResponse } from "./shared";
+import { PanelTitle, EmptyLine, MetaLine, Metric } from "./debug-panel-primitives.js";
+import { formatTime, formatCacheStatus, formatSegmentLabel } from "./debug-display.js";
+import { stringifyPayload } from "./debug-request-values.js";
+
+export function TimelinePanel({ items }: { items: TimelineItem[] }) {
+  return (
+    <section className="panel timeline-panel">
+      <PanelTitle icon={<Clock3 size={17} />} title="时间线" />
+      <div className="timeline">
+        {items.length === 0 ? <EmptyLine text="选择 Trace 后查看事件" /> : null}
+        {items.map((item) => (
+          <article className={`timeline-item severity-${item.severity ?? "info"}`} key={item.id}>
+            <time>{formatTime(item.at)}</time>
+            <div>
+              <div className="timeline-heading">
+                <strong>{item.label}</strong>
+                <span>{item.source}</span>
+              </div>
+              <p className="timeline-summary">{item.summary}</p>
+              {item.payload !== undefined ? <TimelinePayload payload={item.payload} /> : null}
+              <MetaLine
+                values={[
+                  item.sessionId ? `会话 ${item.sessionId}` : "",
+                  item.turnId ? `轮次 ${item.turnId}` : "",
+                  item.toolCallId ? `工具 ${item.toolCallId}` : "",
+                ]}
+              />
+            </div>
+          </article>
+        ))}
+      </div>
+    </section>
+  );
+}
+
+export function TimelinePayload({ payload }: { payload: unknown }) {
+  return (
+    <details className="timeline-payload">
+      <summary>原始 Payload</summary>
+      <pre>{stringifyPayload(payload)}</pre>
+    </details>
+  );
+}
+
+export function CachePanel({ reports }: { reports: CacheReport[] }) {
+  const report = reports.at(-1);
+  const segments = report?.segments.filter(isRenderableCacheSegment) ?? [];
+
+  return (
+    <section className="panel cache-panel">
+      <PanelTitle icon={<BarChart3 size={17} />} title="缓存" />
+      {!report ? <EmptyLine text="未观察到缓存使用" /> : null}
+      {report ? (
+        <>
+          <div className="metric-row">
+            <Metric label="读取" value={report.cacheReadTokens.toLocaleString()} />
+            <Metric label="写入" value={report.cacheWriteTokens.toLocaleString()} />
+            <Metric
+              label="命中"
+              value={report.hitRate === null ? "未知" : `${Math.round(report.hitRate * 100)}%`}
+            />
+          </div>
+          {segments.length > 0 ? (
+            <div className="cache-segments">
+              {segments.map((segment) => (
+                <article className={`cache-segment ${segment.status}`} key={segment.id}>
+                  <strong>{formatCacheStatus(segment.status)}</strong>
+                  <span>{formatSegmentLabel(segment.role ?? segment.source)}</span>
+                  <p>{segment.preview}</p>
+                  {segment.reason ? <small>{segment.reason}</small> : null}
+                </article>
+              ))}
+            </div>
+          ) : null}
+          {report.limitations.map((limitation) => (
+            <p className="soft-warning" key={limitation}>
+              {limitation}
+            </p>
+          ))}
+        </>
+      ) : null}
+    </section>
+  );
+}
+
+function isRenderableCacheSegment(segment: CacheReport["segments"][number]): boolean {
+  return segment.preview !== "SQLite 的 step-finish token usage 不包含 provider 可见文本。";
+}
+
+export function GapsPanel({ requests }: { requests: TraceDetailResponse["developerRequests"] }) {
+  return (
+    <section className="panel gaps-panel">
+      <PanelTitle icon={<AlertTriangle size={17} />} title="观测缺口" />
+      {requests.length === 0 ? <EmptyLine text="当前 trace 没有观测缺口" /> : null}
+      {requests.map((request) => (
+        <article className="request-row" key={request.eventName}>
+          <strong>{request.title}</strong>
+          <p>{request.reason}</p>
+          <code>{request.eventName}</code>
+        </article>
+      ))}
+    </section>
+  );
+}
diff --git a/apps/zcode-cli/packages/debug/test/analyzer-partition-parity.test.ts b/apps/zcode-cli/packages/debug/test/analyzer-partition-parity.test.ts
new file mode 100644
index 00000000..b83e1eb4
--- /dev/null
+++ b/apps/zcode-cli/packages/debug/test/analyzer-partition-parity.test.ts
@@ -0,0 +1,149 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import test from "node:test";
+import { inspectTrace, listTraces } from "../server/analyzer.js";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "zcode-debug-parity-"));
+  const logDir = join(root, "logs");
+  const eventPath = join(root, "events.jsonl");
+  const dbPath = join(root, "session.sqlite");
+  await mkdir(logDir);
+  const db = new DatabaseSync(dbPath);
+  db.exec(`
+    create table session (id text, project_id text, title text, directory text, time_created integer, time_updated integer);
+    create table message (id text, session_id text, time_created integer, time_updated integer, data text);
+    create table part (id text, message_id text, session_id text, time_created integer, time_updated integer, data text);
+  `);
+  db.prepare("insert into session values (?, ?, ?, ?, ?, ?)").run(
+    "fixture-session",
+    "fixture-project",
+    "Fixture",
+    "/fixture/project",
+    1000,
+    2000,
+  );
+  db.prepare("insert into message values (?, ?, ?, ?, ?)").run(
+    "fixture-message",
+    "fixture-session",
+    1100,
+    1100,
+    JSON.stringify({ role: "user", traceId: "fixture-trace" }),
+  );
+  db.prepare("insert into part values (?, ?, ?, ?, ?, ?)").run(
+    "fixture-part",
+    "fixture-message",
+    "fixture-session",
+    1100,
+    1100,
+    JSON.stringify({ type: "text", text: "authored fixture brief" }),
+  );
+  db.close();
+  await writeFile(
+    join(logDir, "fixture.jsonl"),
+    JSON.stringify({
+      timestamp: "2026-01-01T00:00:00.000Z",
+      traceId: "fixture-trace",
+      sessionId: "fixture-session",
+      message: "authored fixture log",
+    }) + "\n",
+  );
+  const events = [
+    ["turn-start", "turn_started", {}],
+    [
+      "permission",
+      "permission_requested",
+      { permissionId: "fixture-permission", toolCallId: "fixture-tool", toolName: "fixture" },
+    ],
+    [
+      "permission-done",
+      "permission_resolved",
+      { permissionId: "fixture-permission", toolCallId: "fixture-tool", decision: "granted" },
+    ],
+    ["tool-start", "tool_call_started", { toolCallId: "fixture-tool", toolName: "fixture" }],
+    [
+      "model-start",
+      "model_request",
+      {
+        queryId: "fixture-query",
+        modelId: "fixture-model",
+        messages: [
+          { role: "system", content: "# System\nOnly authored fixture input." },
+          { role: "user", content: "fixture brief" },
+        ],
+      },
+    ],
+    [
+      "model-end",
+      "model_complete",
+      { queryId: "fixture-query", usage: { inputTokens: 20, outputTokens: 5, cacheReadTokens: 3 } },
+    ],
+    ["tool-end", "tool_call_result", { toolCallId: "fixture-tool", content: "fixture output" }],
+    ["turn-end", "turn_complete", { resultType: "response" }],
+  ].map(([id, type, payload], index) => ({
+    id,
+    type,
+    payload,
+    traceId: "fixture-trace",
+    sessionId: "fixture-session",
+    turnId: "fixture-turn",
+    timestamp: new Date(Date.UTC(2026, 0, 1, 0, 0, 0, index * 10)).toISOString(),
+  }));
+  await writeFile(eventPath, events.map((event) => JSON.stringify(event)).join("\n") + "\n");
+  return {
+    root,
+    options: { logDir, eventPath, dbPath },
+    events,
+    close: () => rm(root, { recursive: true, force: true }),
+  };
+}
+
+test("public debug list and inspection read authored SQLite/events without changing source bytes", async () => {
+  const f = await fixture();
+  try {
+    const fingerprint = async () =>
+      createHash("sha256")
+        .update(await readFile(f.options.dbPath))
+        .digest("hex");
+    const before = await fingerprint();
+    const list = await listTraces(f.options);
+    assert.deepEqual(
+      list.traces.map((trace) => trace.traceId),
+      ["fixture-trace"],
+    );
+    assert.equal(list.projects[0]?.projectId, "fixture-project");
+    assert.ok(list.sources.every((source) => source.available));
+    const detail = await inspectTrace("fixture-trace", f.options);
+    assert.deepEqual(detail.sessions, ["fixture-session"]);
+    assert.deepEqual([...new Set(detail.spans.map((span) => span.lane))].sort(), [
+      "model",
+      "permission",
+      "tool",
+      "turn",
+    ]);
+    assert.ok(detail.spans.every((span) => span.status === "ok"));
+    assert.equal(detail.contextSnapshots[0]?.observationLevel, "full");
+    assert.ok(detail.timeline.some((item) => item.source === "eventlog"));
+    assert.equal(await fingerprint(), before);
+  } finally {
+    await f.close();
+  }
+});
+
+test("an unreadable observation source does not hide the remaining local records", async () => {
+  const f = await fixture();
+  try {
+    await writeFile(f.options.eventPath, "invalid fixture JSON\n");
+    const result = await listTraces(f.options);
+    assert.ok(result.sources.find((source) => source.kind === "eventlog")?.warning);
+    assert.equal(result.sources.find((source) => source.kind === "sqlite")?.available, true);
+    assert.equal(result.traces[0]?.traceId, "fixture-trace");
+    assert.equal(result.projects[0]?.projectId, "fixture-project");
+  } finally {
+    await f.close();
+  }
+});
