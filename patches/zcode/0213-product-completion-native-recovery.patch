index 00000000..cada4c8e
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection-row-indexes.ts
@@ -0,0 +1,165 @@
+import type { ProductProjectionOwner } from "./product-projection-owner.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import type { SessionEvent } from "@zcode/contracts";
+import type {
+  ConversationDelta,
+  ConversationRow,
+  SubagentRow,
+  ToolCallRow,
+} from "@zcode/shared/zcode-protocol-v4";
+
+export function rowBase(
+  this: ProductProjectionOwner,
+  event: SessionEvent,
+  turnId: string,
+  entityId = String(event.id),
+) {
+  const rowId = this.nextRowId++;
+  this.entityIdByRowId.set(rowId, entityId);
+  return {
+    rowId,
+    turnId,
+    entityId,
+    productTurnId: turnId,
+    visibility: "visible" as const,
+    createdAt: this.ms(event),
+    createdAtSeq: event.sequenceNumber,
+  };
+}
+
+export function turnIdOf(this: ProductProjectionOwner, event: SessionEvent): string {
+  const runtimeTurnId = String(event.turnId ?? this.currentTurnId ?? "turn-unknown");
+  // queue drain 切轮后，同一 runtimeTurn 的后续事件行归入最新 productTurn。
+  return this.productTurnIdByRuntimeTurnId.get(runtimeTurnId) ?? runtimeTurnId;
+}
+
+export function ms(this: ProductProjectionOwner, event: SessionEvent): number {
+  return event.timestamp.getTime();
+}
+
+export function findRow(this: ProductProjectionOwner, rowId: number): ConversationRow | undefined {
+  const index = this.rowIndexById.get(rowId);
+  return index === undefined ? undefined : this.snapshot.rows.window[index];
+}
+
+export function updateRowIndexAfterImmutableApply(
+  this: ProductProjectionOwner,
+  previousRowsLength: number,
+  deltas: readonly ConversationDelta[],
+): void {
+  if (deltas.some((delta) => delta.op === "row.removed")) {
+    this.rowIndexById = new Map(this.snapshot.rows.window.map((row, index) => [row.rowId, index]));
+    return;
+  }
+  let nextIndex = previousRowsLength;
+  for (const delta of deltas) {
+    if (delta.op !== "row.appended") continue;
+    this.rowIndexById.set(delta.row.rowId, nextIndex);
+    nextIndex += 1;
+  }
+}
+
+export function indexToolRow(this: ProductProjectionOwner, row: ToolCallRow): void {
+  const rowIds = this.toolRowIdsByCallId.get(row.toolCallId) ?? [];
+  if (!rowIds.includes(row.rowId)) rowIds.push(row.rowId);
+  this.toolRowIdsByCallId.set(row.toolCallId, rowIds);
+}
+
+export function findToolRow(
+  this: ProductProjectionOwner,
+  toolCallId: string,
+  event?: SessionEvent,
+  assistantResponseId?: string,
+): ToolCallRow | undefined {
+  const payload = event?.payload as
+    | { assistantMessageId?: string; assistantResponseId?: string }
+    | undefined;
+  const assistant =
+    assistantResponseId ?? payload?.assistantMessageId ?? payload?.assistantResponseId;
+  const turnId = event?.turnId ? this.turnIdOf(event) : undefined;
+  const candidates = (this.toolRowIdsByCallId.get(toolCallId) ?? [])
+    .map((rowId) => this.findRow(rowId))
+    .filter(
+      (row): row is ToolCallRow =>
+        row?.kind === "toolCall" &&
+        (!turnId || row.turnId === turnId) &&
+        (!assistant || !row.assistantResponseId || row.assistantResponseId === assistant),
+    );
+  // Legacy events without an assistant identity must not silently update another request.
+  // A missing streamed identity can be filled by the unique scheduled call, never guessed.
+  if (assistant) {
+    const exact = candidates.filter((row) => row.assistantResponseId === assistant);
+    if (exact.length === 1) return exact[0];
+  }
+  return candidates.length === 1 ? candidates[0] : undefined;
+}
+
+export function findSubagentRow(
+  this: ProductProjectionOwner,
+  agentId: string,
+): SubagentRow | undefined {
+  const rowId = this.subagentRowIdByAgentId.get(agentId);
+  if (rowId === undefined) return undefined;
+  const row = this.findRow(rowId);
+  return row?.kind === "subagent" ? row : undefined;
+}
+
+export function findSubagentLifecycleRow(
+  this: ProductProjectionOwner,
+  agentId: string,
+  payload: Record<string, unknown>,
+  event: SessionEvent,
+): SubagentRow | undefined {
+  const exact = this.findSubagentRow(agentId);
+  if (exact) return exact;
+
+  const parentToolCallId = this.stringPayload(payload, "parentToolCallId");
+  if (!parentToolCallId) return undefined;
+  const turnId = this.turnIdOf(event);
+  // 晚订阅 hydration 无法从后台 Agent 的文本 tool output 恢复真实 agentId，
+  // 会先用 toolCallId 合成一条 SubagentRow。后到的 live lifecycle 携带真实 agentId，
+  // 旧逻辑因此追加第二行，UI 又会让无 childSessionId 的合成行抢占配对。父 tool call
+  // 在同一 turn 内是稳定唯一身份，这里将真实事件归并回合成行并补齐 childSessionId。
+  return this.snapshot.rows.window.find(
+    (row): row is SubagentRow =>
+      row.kind === "subagent" && row.turnId === turnId && row.parentToolCallId === parentToolCallId,
+  );
+}
+
+export function subagentAgentId(
+  this: ProductProjectionOwner,
+  payload: Record<string, unknown>,
+  event: SessionEvent,
+): string {
+  return (
+    this.stringPayload(payload, "agentId") ??
+    this.stringPayload(payload, "childSessionId") ??
+    this.stringPayload(payload, "parentToolCallId") ??
+    `subagent-${event.sequenceNumber}`
+  );
+}
+
+export function stringPayload(
+  this: ProductProjectionOwner,
+  payload: Record<string, unknown>,
+  key: string,
+): string | undefined {
+  const value = payload[key];
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+export function mapSubagentStatus(
+  this: ProductProjectionOwner,
+  status: string | undefined,
+): SubagentRow["status"] {
+  switch (status) {
+    case "completed":
+    case "success":
+      return "success";
+    case "cancelled":
+    case "stopped":
+      return "cancelled";
+    default:
+      return "failed";
+  }
+}
