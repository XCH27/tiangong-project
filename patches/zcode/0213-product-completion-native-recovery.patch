+import assert from "node:assert/strict";
+import test from "node:test";
+import { createMcpAdapter } from "../src/mcp/index.js";
+// Own prototype surface captured from accepted 8c347cb, including private methods.
+const accepted: Array<[string, number, boolean]> = [
+  ["connectConfiguredServers", 1, true],
+  ["connectServer", 2, true],
+  ["disconnectServer", 1, true],
+  ["status", 0, true],
+  ["pingServer", 1, true],
+  ["listTools", 0, true],
+  ["callTool", 1, true],
+  ["readResource", 2, true],
+  ["assertExpectedConfiguration", 2, false],
+  ["rememberServerResponse", 2, false],
+  ["takeServerRequestId", 1, false],
+  ["resolveOfficialStdioAuthMeta", 3, true],
+  ["callToolOnClient", 5, true],
+  ["reconnectForCall", 2, true],
+  ["recoverToolCallAuthorization", 1, true],
+  ["ensureToolCallAuthorizationRecovery", 1, false],
+  ["runToolCallAuthorizationRecovery", 1, true],
+  ["close", 0, true],
+  ["waitForSharedConnection", 3, false],
+  ["openServerConnection", 1, true],
+  ["runInteractiveOAuthAuthorization", 1, true],
+  ["failConnection", 1, true],
+  ["createTransport", 6, true],
+  ["createOfficialAuthFetch", 3, false],
+  ["createOAuthClientProvider", 2, false],
+  ["resolveCredentialStore", 0, false],
+  ["createAuthorizationCodeOAuthOptions", 4, false],
+  ["attachStdioLogging", 2, false],
+  ["closeRecord", 1, true],
+  ["closeClientAndTransport", 3, true],
+  ["terminateStdioProcessTree", 2, true],
+  ["nextConnectionGeneration", 1, false],
+  ["isCurrentConnection", 2, false],
+  ["updateCurrentRecord", 3, false],
+  ["updateCurrentRecordStatus", 3, false],
+  ["createStatus", 2, false],
+];
+test("MCP factory preserves the original sole class and all method descriptors", async () => {
+  const adapter = createMcpAdapter({ env: {} });
+  try {
+    const prototype = Object.getPrototypeOf(adapter);
+    assert.equal(prototype.constructor.name, "NodeMcpAdapter");
+    assert.equal(prototype.constructor.length, 1);
+    assert.equal(Object.getPrototypeOf(prototype), Object.prototype);
+    assert.deepEqual(Object.getOwnPropertyNames(prototype), [
+      "constructor",
+      ...accepted.map(([name]) => name),
+    ]);
+    for (const [name, length, isAsync] of accepted) {
+      const descriptor = Object.getOwnPropertyDescriptor(prototype, name)!;
+      assert.equal(descriptor.enumerable, false, name);
+      assert.equal(descriptor.configurable, true, name);
+      assert.equal(descriptor.writable, true, name);
+      assert.equal(descriptor.value.name, name);
+      assert.equal(descriptor.value.length, length, name);
+      assert.equal(descriptor.value.constructor.name, isAsync ? "AsyncFunction" : "Function", name);
+      assert.throws(() => Reflect.construct(descriptor.value, []), TypeError, name);
+    }
+    assert.deepEqual(await adapter.status(), {});
+    assert.equal(Object.hasOwn(adapter, "connectServer"), false);
+  } finally {
+    await adapter.close();
+  }
+});
