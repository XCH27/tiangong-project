+        const referenceBytes = images?.reduce((sum, image) => sum + image.bytes.byteLength, 0) ?? 0;
+        if (referenceBytes > MAX_REFERENCE_BYTES)
+          throw new Error("Combined image references exceed 24 MiB");
+        const binding = createHash("sha256")
+          .update(
+            JSON.stringify([
+              selected.binding,
+              images?.map((image) => createHash("sha256").update(image.bytes).digest("hex")),
+            ]),
+          )
+          .digest("hex");
+        const retainedBytes = () =>
+          [...factoryBindings.imageBindings.values()].reduce(
+            (sum, value) =>
+              sum +
+              (value.images?.reduce((bytes, image) => bytes + image.bytes.byteLength, 0) ?? 0),
+            0,
+          );
+        while (
+          factoryBindings.imageBindings.size >= 64 ||
+          retainedBytes() + referenceBytes > MAX_RETAINED_REFERENCE_BYTES
+        )
+          factoryBindings.imageBindings.delete(factoryBindings.imageBindings.keys().next().value!);
+        factoryBindings.imageBindings.set(binding, {
+          ...selected,
+          images: images?.map((image) => ({
+            mediaType: image.mediaType,
+            bytes: new Uint8Array(image.bytes),
+          })),
+        });
+        return binding;
+      },
+    } satisfies Pick<MediaGenerationPort, "prepareImage">
+  ).prepareImage;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/api-media-prepare-video.ts b/apps/zcode-cli/packages/bootstrap/src/app/api-media-prepare-video.ts
new file mode 100644
index 00000000..f380e438
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-prepare-video.ts
@@ -0,0 +1,127 @@
+import { type MediaGenerationModel, type MediaGenerationPort } from "@zcode/contracts";
+import { createHash } from "node:crypto";
+import { MAX_IMAGE_BYTES, MAX_RETAINED_REFERENCE_BYTES } from "./api-media-generation-values.js";
+
+export function createApiMediaPrepareVideo(factoryBindings: {
+  readonly available: () => MediaGenerationModel[];
+  readonly credential: (
+    providerId: string,
+    reference?: string,
+  ) => { key: string; reference: string };
+  readonly jsonRequest: (
+    providerId: string,
+    path: string,
+    key: string,
+    body?: Record<string, unknown>,
+    signal?: AbortSignal,
+  ) => Promise<{
+    id?: unknown;
+    aliases?: unknown;
+    output_modalities?: unknown;
+    request_id?: unknown;
+    status?: unknown;
+    model?: unknown;
+    video?: { url?: string; duration?: unknown };
+    usage?: { cost_in_usd_ticks?: unknown };
+  }>;
+  readonly targetScope: (
+    providerId: string,
+    modelId: string,
+  ) => (
+    | {
+        properties?: {
+          outputFormat?: {
+            supportsText?: boolean | null;
+            supportsImage?: boolean | null;
+            supportsVideo?: boolean | null;
+          } | null;
+        } | null;
+      }
+    | { baseUrl?: string | null; headers?: Readonly<Record<string, string>> | null }
+    | null
+    | undefined
+  )[];
+  readonly videoBindings: Map<
+    string,
+    { key: string; body: Record<string, unknown>; reference: string; referenceBytes: number }
+  >;
+}): MediaGenerationPort["prepareVideo"] {
+  return (
+    {
+      async prepareVideo(request) {
+        if (
+          request.image &&
+          (!["image/png", "image/jpeg", "image/webp"].includes(request.image.mediaType) ||
+            request.image.bytes.length === 0 ||
+            request.image.bytes.length > MAX_IMAGE_BYTES)
+        )
+          throw new Error("Unsupported video image reference");
+        if (
+          request.duration !== undefined &&
+          (!Number.isInteger(request.duration) || request.duration < 1 || request.duration > 15)
+        )
+          throw new Error("Video duration must be between 1 and 15 seconds");
+        if (
+          !factoryBindings
+            .available()
+            .some(
+              (model) =>
+                model.kind === "video" &&
+                model.providerId === request.providerId &&
+                model.modelId === request.modelId,
+            )
+        )
+          throw new Error("Video model is unavailable");
+        const selected = factoryBindings.credential(request.providerId);
+        const detail = await factoryBindings.jsonRequest(
+          request.providerId,
+          `video-generation-models/${encodeURIComponent(request.modelId)}`,
+          selected.key,
+        );
+        if (
+          (detail.id !== request.modelId &&
+            !(Array.isArray(detail.aliases) && detail.aliases.includes(request.modelId))) ||
+          (Array.isArray(detail.output_modalities) && !detail.output_modalities.includes("video"))
+        )
+          throw new Error("Provider did not confirm this video model");
+        const body = {
+          model: request.modelId,
+          prompt: request.prompt,
+          duration: request.duration ?? 6,
+          ...(request.image
+            ? {
+                image: {
+                  url: `data:${request.image.mediaType};base64,${Buffer.from(request.image.bytes).toString("base64")}`,
+                },
+              }
+            : {}),
+        };
+        const binding = createHash("sha256")
+          .update(
+            JSON.stringify([
+              factoryBindings.targetScope(request.providerId, request.modelId),
+              request.providerId,
+              body,
+              selected.key,
+            ]),
+          )
+          .digest("hex");
+        const referenceBytes = request.image
+          ? Math.ceil(request.image.bytes.byteLength / 3) * 4 + 40
+          : 0;
+        const retainedBytes = () =>
+          [...factoryBindings.videoBindings.values()].reduce(
+            (sum, value) => sum + value.referenceBytes,
+            0,
+          );
+        while (
+          factoryBindings.videoBindings.size >= 64 ||
+          retainedBytes() + referenceBytes > MAX_RETAINED_REFERENCE_BYTES
+        )
+          factoryBindings.videoBindings.delete(factoryBindings.videoBindings.keys().next().value!);
+        factoryBindings.videoBindings.set(binding, { ...selected, body, referenceBytes });
+        return { binding, credentialReference: selected.reference };
+      },
+    } satisfies Pick<MediaGenerationPort, "prepareVideo">
+  ).prepareVideo;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/api-media-read-video.ts b/apps/zcode-cli/packages/bootstrap/src/app/api-media-read-video.ts
new file mode 100644
index 00000000..2338c3a4
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-read-video.ts
@@ -0,0 +1,96 @@
+import type { MediaRegistrySource } from "./api-media-generation-values.js";
+
+import { type HttpClientPort, type MediaGenerationPort } from "@zcode/contracts";
+
+export function createApiMediaReadVideo(factoryBindings: {
+  readonly credential: (
+    providerId: string,
+    reference?: string,
+  ) => { key: string; reference: string };
+  readonly jsonRequest: (
+    providerId: string,
+    path: string,
+    key: string,
+    body?: Record<string, unknown>,
+    signal?: AbortSignal,
+  ) => Promise<{
+    id?: unknown;
+    aliases?: unknown;
+    output_modalities?: unknown;
+    request_id?: unknown;
+    status?: unknown;
+    model?: unknown;
+    video?: { url?: string; duration?: unknown };
+    usage?: { cost_in_usd_ticks?: unknown };
+  }>;
+  readonly input: { registry: MediaRegistrySource; http: Pick<HttpClientPort, "request"> };
+}): MediaGenerationPort["readVideo"] {
+  return (
+    {
+      async readVideo(request) {
+        const selected = factoryBindings.credential(
+          request.providerId,
+          request.credentialReference,
+        );
+        const payload = await factoryBindings.jsonRequest(
+          request.providerId,
+          `videos/${encodeURIComponent(request.requestId)}`,
+          selected.key,
+          undefined,
+          request.signal,
+        );
+        if (payload.status === "pending" || payload.status === "processing")
+          return { status: "pending" };
+        if (payload.status === "failed" || payload.status === "expired")
+          return { status: payload.status };
+        if (payload.status !== "done")
+          throw new Error("Unknown video status; the original request was retained");
+        if (typeof payload.video?.url !== "string")
+          throw new Error("Video result has no download URL; the original request was retained");
+        const url = new URL(payload.video.url);
+        if (
+          url.protocol !== "https:" ||
+          url.hostname !== "vidgen.x.ai" ||
+          url.username ||
+          url.password ||
+          (url.port && url.port !== "443")
+        )
+          throw new Error("Untrusted video download URL");
+        const download = await factoryBindings.input.http.request(
+          {
+            url: url.toString(),
+            method: "GET",
+            headers: {},
+            redirect: "manual",
+            timeoutMs: 60_000,
+            maxResponseBytes: 128 * 1024 * 1024,
+          },
+          { signal: request.signal },
+        );
+        const bytes = Buffer.from(download.body);
+        if (
+          download.status !== 200 ||
+          bytes.length < 12 ||
+          bytes.toString("ascii", 4, 8) !== "ftyp"
+        )
+          throw new Error(
+            "Provider did not return a valid MP4; keep the original request for retrieval",
+          );
+        const ticks = payload.usage?.cost_in_usd_ticks;
+        return {
+          status: "done",
+          ...(payload.usage ? { providerUsage: payload.usage } : {}),
+          bytes,
+          mimeType: "video/mp4",
+          ...(typeof payload.model === "string" ? { reportedModelId: payload.model } : {}),
+          ...(typeof payload.video?.duration === "number"
+            ? { duration: payload.video.duration }
+            : {}),
+          ...(typeof ticks === "number" && Number.isFinite(ticks) && ticks >= 0
+            ? { reportedCostUsd: ticks / 10_000_000_000 }
+            : {}),
+        };
+      },
+    } satisfies Pick<MediaGenerationPort, "readVideo">
+  ).readVideo;
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/app/api-media-submit-video.ts b/apps/zcode-cli/packages/bootstrap/src/app/api-media-submit-video.ts
new file mode 100644
index 00000000..08fea966
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-submit-video.ts
@@ -0,0 +1,119 @@
+import {
+  MediaSubmissionNotStartedError,
+  type MediaGenerationModel,
+  type MediaGenerationPort,
+} from "@zcode/contracts";
+import { createHash } from "node:crypto";
+
+export function createApiMediaSubmitVideo(factoryBindings: {
+  readonly videoBindings: Map<
+    string,
+    { key: string; body: Record<string, unknown>; reference: string; referenceBytes: number }
+  >;
+  readonly available: () => MediaGenerationModel[];
+  readonly credential: (
+    providerId: string,
+    reference?: string,
+  ) => { key: string; reference: string };
+  readonly targetScope: (
+    providerId: string,
+    modelId: string,
+  ) => (
+    | {
+        properties?: {
+          outputFormat?: {
+            supportsText?: boolean | null;
+            supportsImage?: boolean | null;
+            supportsVideo?: boolean | null;
+          } | null;
+        } | null;
+      }
+    | { baseUrl?: string | null; headers?: Readonly<Record<string, string>> | null }
+    | null
+    | undefined
+  )[];
+  readonly jsonRequest: (
+    providerId: string,
+    path: string,
+    key: string,
+    body?: Record<string, unknown>,
+    signal?: AbortSignal,
+  ) => Promise<{
+    id?: unknown;
+    aliases?: unknown;
+    output_modalities?: unknown;
+    request_id?: unknown;
+    status?: unknown;
+    model?: unknown;
+    video?: { url?: string; duration?: unknown };
+    usage?: { cost_in_usd_ticks?: unknown };
+  }>;
+}): MediaGenerationPort["submitVideo"] {
+  return (
+    {
+      async submitVideo(request) {
+        const prepared = factoryBindings.videoBindings.get(request.binding);
+        if (
+          !prepared ||
+          !factoryBindings
+            .available()
+            .some(
+              (model) =>
+                model.kind === "video" &&
+                model.providerId === request.providerId &&
+                model.modelId === request.modelId,
+            )
+        )
+          throw new MediaSubmissionNotStartedError(
+            "Video model or confirmation is no longer available; no request was submitted",
+          );
+        let current: ReturnType<typeof factoryBindings.credential>;
+        try {
+          current = factoryBindings.credential(request.providerId, prepared.reference);
+        } catch {
+          throw new MediaSubmissionNotStartedError(
+            "The original video credential is unavailable; no request was submitted",
+          );
+        }
+        const expected = createHash("sha256")
+          .update(
+            JSON.stringify([
+              factoryBindings.targetScope(request.providerId, request.modelId),
+              request.providerId,
+              prepared.body,
+              current.key,
+            ]),
+          )
+          .digest("hex");
+        if (
+          expected !== request.binding ||
+          prepared.body.model !== request.modelId ||
+          prepared.body.prompt !== request.prompt ||
+          prepared.body.duration !== (request.duration ?? 6)
+        )
+          throw new MediaSubmissionNotStartedError(
+            "Video request changed after confirmation; no request was submitted",
+          );
+        if (request.signal.aborted)
+          throw new MediaSubmissionNotStartedError(
+            "Video submission was cancelled before dispatch",
+          );
+        factoryBindings.videoBindings.delete(request.binding);
+        const payload = await factoryBindings.jsonRequest(
+          request.providerId,
+          "videos/generations",
+          current.key,
+          prepared.body,
+          request.signal,
+        );
+        if (
+          typeof payload.request_id !== "string" ||
+          !payload.request_id ||
+          payload.request_id.length > 200
+        )
+          throw new Error("Video submission was not confirmed; do not submit again automatically");
+        return { requestId: payload.request_id };
+      },
+    } satisfies Pick<MediaGenerationPort, "submitVideo">
+  ).submitVideo;
+}
