+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import type {
+  IServiceAccessor,
+  IZCodeAgentService,
+  IPluginManagementService,
+} from "@zcode/services";
+import { V4_WIRE_PROTOCOL_VERSION } from "@zcode/shared/zcode-protocol-v4";
+import { PluginViewPane } from "../src/app-shell/PluginViewPane.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import {
+  NATIVE_WHITEBOARD_SESSION_NAVIGATION,
+  type NativeSurfaceNavigation,
+} from "../src/lib/nativeWhiteboardNavigation.js";
+import { useRemoteWorkspaceSessionStore as remote } from "../src/store/remoteWorkspaceSessionStore.js";
+
+import { check, tick, pause, until, html } from "./pluginViewNativeFixture.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    remote.setState({ ...remote.getInitialState() }, true);
+    const container = document.createElement("div");
+    container.style.cssText = "width:640px;height:480px";
+    document.body.append(container);
+    const root = createRoot(container);
+    const pathA = `/plugin-a-${crypto.randomUUID()}`,
+      pathB = `/plugin-b-${crypto.randomUUID()}`;
+    let workspacePath = pathA,
+      identity: string | undefined,
+      endpoint: string | undefined;
+    let sessionId: string | undefined = "original-current";
+    let holdRead:
+      | { promise: Promise<{ html: string }>; resolve: (value: { html: string }) => void }
+      | undefined;
+    let holdCreate: Promise<void> | undefined, holdCall: Promise<void> | undefined;
+    let rejectRead = false,
+      rejectCall = false;
+    const reads: string[] = [],
+      commands: string[] = [],
+      order: string[] = [];
+    const calls: Array<Parameters<IPluginManagementService["callPluginViewTool"]>[0]> = [];
+    const replies: Array<{ source: MessageEventSource | null; data: Record<string, unknown> }> = [];
+    const documentEvents: string[] = [];
+    const ready = new Set<MessageEventSource | null>(),
+      opened: string[] = [];
+    const agent = {
+      ...nativePresentationAgent().agent,
+      helloConversationV4: async () => ({
+        kind: "hello",
+        protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+        connectionId: "authored",
+        clientMode: "web-remote-replayable",
+        deliveryProfile: "replayable",
+        serverTime: Date.now(),
+        auth: {},
+        capabilities: {
+          nativeDialogs: false,
+          localTerminal: false,
+          binaryFrames: false,
+          compression: "none",
+          independentPlanState: true,
+        },
+      }),
+      initializeConversationV4: async () => {},
+      async sendConversationCommandV4({
+        envelope,
+      }: Parameters<IZCodeAgentService["sendConversationCommandV4"]>[0]) {
+        commands.push(envelope.type);
+        await holdCreate;
+        return {
+          status: "accepted",
+          result: { type: "createSession", sessionId: "original-empty" },
+        };
+      },
+    } as unknown as IZCodeAgentService;
+    const plugins = {
+      async readPluginView(target: Parameters<IPluginManagementService["readPluginView"]>[0]) {
+        reads.push(target.workspacePath);
+        const held = holdRead;
+        holdRead = undefined;
+        if (held) return held.promise;
+        if (rejectRead) throw new Error("Authored resource unavailable");
+        return { html: html(target.workspacePath) };
+      },
+      async callPluginViewTool(
+        input: Parameters<IPluginManagementService["callPluginViewTool"]>[0],
+      ) {
+        calls.push(input);
+        order.push("call");
+        await holdCall;
+        if (rejectCall) throw new Error("Authored permission denied; no effect");
+        return {
+          content: [{ type: "text", text: "single SDK reply" }],
+          structuredContent: { exact: 1 },
+          isError: true,
+        };
+      },
+    } as unknown as IPluginManagementService;
+    const services = {
+      zcodeAgentService: agent,
+      pluginManagementService: plugins,
+    } as unknown as IServiceAccessor;
+    let browser = (url: string) => {
+      opened.push(url);
+    };
+    const render = async () =>
+      act(async () => {
+        root.render(
+          <ServiceProvider services={services}>
+            <TabStoreProvider>
+              <ZCodeIntlProvider initialLocale={locale} disablePersistence>
+                <PluginViewPane
+                  workspacePath={workspacePath}
+                  workspaceIdentity={identity}
+                  remoteSessionId={endpoint}
+                  sessionId={sessionId}
+                  pluginId="authored@market"
+                  viewId="own-view"
+                  title="Authored plugin"
+                  onOpenBrowserUrl={browser}
+                />
+              </ZCodeIntlProvider>
+            </TabStoreProvider>
+          </ServiceProvider>,
+        );
+        await tick();
+      });
+    const receive = (event: MessageEvent) => {
+      if (event.data?.jsonrpc === "2.0" && event.data.id === "automatic")
+        documentEvents.push("initialize");
+      if (event.data?.fixtureReady) ready.add(event.source);
+      if (event.data?.fixtureReply)
+        replies.push({ source: event.source, data: event.data.fixtureReply });
+    };
+    const navigate = (event: Event) => {
+      const detail = (event as CustomEvent<NativeSurfaceNavigation>).detail;
+      check(
+        "pluginId" in detail.target && !("boardId" in detail.target),
+        "Navigation invented a board target",
+      );
+      order.push("navigate");
+      detail.handled = true;
+    };
+    window.addEventListener("message", receive);
+    window.addEventListener(NATIVE_WHITEBOARD_SESSION_NAVIGATION, navigate);
