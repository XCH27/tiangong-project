+import { installConversationTelemetryFactNormalizerMethods } from "./conversation-telemetry-facts-install.js";
+import type { ConversationTelemetryFactNormalizerMethods } from "./conversation-telemetry-facts-method-signatures.js";
+import type { ConversationTelemetryFactNormalizerOwner } from "./conversation-telemetry-facts-owner.js";
+// 原 bootstrap 入口/锁/配置 owner 不变；只按职责移动原声明和函数体。
+import { BoundedKeySet, BoundedValueMap } from "./conversation-telemetry-facts-support-1.js";
+import { type CompletedModelRequestIdentity } from "./conversation-telemetry-facts-support-2.js";
+import { type clearTurn } from "./conversation-telemetry-facts-clear-turn.js";
+
+/**
+ * 把本进程 live SessionEvent 中的轮次起止归一成 `turn.started` / `turn.terminal` 事实，
+ * 供 App/服务端统计运行中的会话数。事实不带正文，只带 admission 给出的 inputId 与终态摘要。
+ * 该类不读取 transcript/snapshot，因而无法在 hydration/recovery 时补造事件。
+ */
+export class ConversationTelemetryFactNormalizer implements ConversationTelemetryFactNormalizerMethods {
+  private readonly firstStreamChunks = new BoundedKeySet();
+  private readonly sourceCommandByTurn = new BoundedValueMap<string>();
+  private readonly toolNameByCall = new BoundedValueMap<string>();
+  private readonly modelBySession = new BoundedValueMap<{
+    modelName: string;
+    modelProvider: string;
+  }>();
+  private readonly completedModelRequests = new BoundedValueMap<CompletedModelRequestIdentity[]>();
+
+  declare private clearTurn: OmitThisParameter<typeof clearTurn>;
+}
+
+installConversationTelemetryFactNormalizerMethods(
+  ConversationTelemetryFactNormalizer.prototype as unknown as ConversationTelemetryFactNormalizerOwner,
+);
