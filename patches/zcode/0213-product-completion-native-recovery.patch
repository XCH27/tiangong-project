+test("native read and write reject descendant directory and final-file symlinks", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-native-symlink-"));
+  try {
+    const workspace = join(root, "workspace"),
+      outside = join(root, "outside");
+    await mkdir(workspace);
+    await mkdir(outside);
+    await writeFile(join(outside, "board.json"), "external original");
+    await symlink(outside, join(workspace, "linked"), "dir");
+    await symlink(join(outside, "board.json"), join(workspace, "board.json"), "file");
+    const adapter = new NodeFileSystemAdapter();
+    for (const path of [join(workspace, "linked", "board.json"), join(workspace, "board.json")]) {
+      await assert.rejects(
+        adapter.readTextFile({ path, boundaryRoot: workspace }),
