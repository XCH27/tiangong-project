+++ b/apps/zcode-cli/packages/adapters/src/model/generate-result-preparation.ts
@@ -0,0 +1,177 @@
+import { isZeroOutputModelCompletion } from "./runner-diagnostics.js";
+import { canRetryEmptyCompletion } from "./empty-completion-retry.js";
+import { publishModelStatus } from "./runner-status.js";
+import { providerRequestIdFromHeaders } from "./runner-telemetry.js";
+import { createGenerateTextOptions } from "./runner-options.js";
+import { detectProviderBusinessFinishError } from "./provider-finish-business-error.js";
+import {
+  normalizeReasoning,
+  normalizeSources,
+  normalizeToolCalls,
+  normalizeToolResults,
+  normalizeUsage,
+} from "./runner-normalization.js";
+import { recordGenerateTextDebug } from "./runner-debug.js";
+import { getGenerateTextResultMetadata, logGenerateTextDiagnostics } from "./runner-diagnostics.js";
+import { sanitizeModelNetworkHeaders } from "./runner-network-headers.js";
+
+import { createStatusContext } from "./runner-status.js";
+
+import type {
+  AiSdkModelRuntime,
+  AiSdkModelTextRequest,
+  ResolvedAiSdkModel,
+} from "./runner-runtime.js";
+
+import { serializeStructuredOutput } from "./generate-attempt-status.js";
+
+import type { runGenerateText } from "./runner-generate.js";
+type GenerateInput = Parameters<typeof runGenerateText>[0];
+type GenerateResult = Awaited<ReturnType<AiSdkModelRuntime["generateText"]>>;
+
+export function normalizeGenerateAttemptResult(
+  input: GenerateInput,
+  resolved: ResolvedAiSdkModel,
+  result: GenerateResult,
+) {
+  const responseHeaders = sanitizeModelNetworkHeaders(
+    getGenerateTextResultMetadata(result)?.response?.headers,
+  );
+  const providerBusinessFinishError = detectProviderBusinessFinishError({
+    providerId: String(resolved.providerId),
+    providerKind: resolved.providerKind,
+    source: {
+      finishReason: result.finishReason,
+      providerMetadata: result.providerMetadata,
+      rawFinishReason: (result.providerMetadata as Record<string, unknown> | undefined)
+        ?.rawFinishReason,
+      response: (result as unknown as { response?: unknown }).response,
+    },
+  });
+  if (providerBusinessFinishError) {
+    throw providerBusinessFinishError;
+  }
+  const usage = normalizeUsage(result.totalUsage ?? result.usage);
+  const toolCalls = normalizeToolCalls(result, input.logger);
+  const toolResults = normalizeToolResults(result, toolCalls);
+  const sources = normalizeSources(result);
+  const text = input.request.responseJsonSchema ? serializeStructuredOutput(result) : result.text;
+  const reasoning = normalizeReasoning(result.reasoning);
+  const reasoningLength = (reasoning ?? []).reduce((total, block) => total + block.text.length, 0);
+
+  return {
+    responseHeaders,
+    usage,
+    toolCalls,
+    toolResults,
+    sources,
+    text,
+    reasoning,
+    reasoningLength,
+  };
+}
+export function prepareGenerateCompletion(context: {
+  input: GenerateInput;
+  attempt: number;
+  attemptRequest: AiSdkModelTextRequest;
+  resolved: ResolvedAiSdkModel;
+  result: GenerateResult;
+  startedAt: number;
+  statusContext: ReturnType<typeof createStatusContext>;
+  toolCalls: ReturnType<typeof normalizeToolCalls>;
+  usage: ReturnType<typeof normalizeUsage>;
+  options: ReturnType<typeof createGenerateTextOptions>;
+  isDev: boolean;
+  recordModelIO: boolean;
+  requestHeaderCount: number;
+  requestHeaders: Record<string, string>;
+  responseHeaders: Record<string, string>;
+}): Parameters<typeof publishModelStatus>[0] {
+  const {
+    input,
+    attempt,
+    attemptRequest,
+    resolved,
+    result,
+    startedAt,
+    statusContext,
+    toolCalls,
+    usage,
+    options,
+    isDev,
+    recordModelIO,
+    requestHeaderCount,
+    requestHeaders,
+    responseHeaders,
+  } = context;
+  const completedAt = Date.now();
+
+  recordGenerateTextDebug({
+    modelIoFullRetentionEnabled: input.modelIoFullRetentionEnabled,
+    attempt,
+    debugDir: input.debugDir,
+    isDev,
+    normalizedToolCalls: toolCalls,
+    options,
+    recordModelIO,
+    request: attemptRequest,
+    requestId: statusContext.requestId,
+    resolved,
+    result,
+    startedAt,
+  });
+  logGenerateTextDiagnostics({
+    attempt,
+    completedAt,
+    logger: input.logger,
+    result,
+    statusContext,
+    startedAt,
+    toolCallCount: toolCalls?.length ?? 0,
+    usage,
+  });
+
+  return {
+    ...statusContext,
+    attempt,
+    durationMs: completedAt - startedAt,
+    finishReason: result.finishReason,
+    requestHeaderCount,
+    requestHeaders,
+    responseHeaderCount: Object.keys(responseHeaders).length,
+    responseHeaders,
+    providerRequestId: providerRequestIdFromHeaders(responseHeaders),
+    timestamp: new Date(completedAt).toISOString(),
+    type: "model_request_completed",
+    usage,
+  };
+}
+
+export function shouldRetryEmptyGenerateCompletion(
+  input: GenerateInput,
+  isSingle: boolean,
+  result: GenerateResult,
+  normalized: ReturnType<typeof normalizeGenerateAttemptResult>,
+  attempt: number,
+  maxAttempts: number,
+  emptyCompletionRetryCount: number,
+): boolean {
+  const { reasoningLength, text, toolCalls, usage } = normalized;
+  return (
+    !isSingle &&
+    input.request.preserveProviderStreamBoundaries !== true &&
+    isZeroOutputModelCompletion({
+      finishReason: result.finishReason,
+      reasoningLength,
+      textLength: text.length,
+      toolCallCount: toolCalls?.length ?? 0,
+      usage,
+    }) &&
+    canRetryEmptyCompletion({
+      abortSignal: input.request.abortSignal,
+      attempt,
+      maxAttempts: maxAttempts,
+      retryCount: emptyCompletionRetryCount,
+    })
+  );
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/pi-subscription-events.ts b/apps/zcode-cli/packages/adapters/src/model/pi-subscription-events.ts
new file mode 100644
index 00000000..9bffd05a
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/pi-subscription-events.ts
@@ -0,0 +1,83 @@
+import type { AssistantMessageEvent } from "@earendil-works/pi-ai";
+import type { ModelStreamEvent } from "@zcode/contracts";
+import type { SubscriptionReplayScope } from "./pi-transcript.js";
+import { finishReason, toUsage } from "./pi-subscription-result.js";
+
+// One event projection; request/admission/account identity remains owned by the original model.
+export function* projectPiSubscriptionEvent(
+  event: AssistantMessageEvent & { replayScope: SubscriptionReplayScope },
+  accounting: (scope: SubscriptionReplayScope) => Record<string, unknown>,
+): Generator<ModelStreamEvent> {
+  const id = "contentIndex" in event ? `pi-${event.contentIndex}` : "";
+  switch (event.type) {
+    case "start":
+      yield { type: "start" };
+      break;
+    case "text_start":
+      yield { type: "text_start", id };
+      break;
+    case "text_delta":
+      yield { type: "text_delta", id, text: event.delta };
+      break;
+    case "text_end":
+      yield { type: "text_end", id };
+      break;
+    case "thinking_start":
+      yield { type: "reasoning_start", id };
+      break;
+    case "thinking_delta":
+      yield { type: "reasoning_delta", id, text: event.delta };
+      break;
+    case "thinking_end": {
+      const block = event.partial.content[event.contentIndex];
+      yield {
+        type: "reasoning_end",
+        id,
+        providerMetadata:
+          block?.type === "thinking"
+            ? {
+                pi: {
+                  signature: block.thinkingSignature,
+                  redacted: block.redacted,
+                  scope: event.replayScope,
+                },
+              }
+            : undefined,
+      };
+      break;
+    }
+    case "toolcall_start": {
+      const block = event.partial.content[event.contentIndex];
+      if (block?.type === "toolCall")
+        yield { type: "tool_input_start", id: block.id, toolName: block.name };
+      break;
+    }
+    case "toolcall_delta": {
+      const block = event.partial.content[event.contentIndex];
+      if (block?.type === "toolCall")
+        yield { type: "tool_input_delta", id: block.id, delta: event.delta };
+      break;
+    }
+    case "toolcall_end":
+      yield { type: "tool_input_end", id: event.toolCall.id };
+      yield {
+        type: "tool_call",
+        toolCall: {
+          id: event.toolCall.id,
+          name: event.toolCall.name,
+          input: event.toolCall.arguments,
+        },
+      };
+      break;
+    case "done":
+      yield {
+        type: "finish",
+        providerMetadata: { fleetAccounting: accounting(event.replayScope) },
+        finishReason: finishReason(event.message),
+        usage: toUsage(event.message.usage),
+      };
+      break;
+    case "error":
+      throw new Error(event.error.errorMessage ?? event.reason);
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/pi-subscription-result.ts b/apps/zcode-cli/packages/adapters/src/model/pi-subscription-result.ts
