diff --git a/packages/ui/test/modelToolCapabilityDraft.test.ts b/packages/ui/test/modelToolCapabilityDraft.test.ts
new file mode 100644
index 0000000..7d7a4ec
--- /dev/null
+++ b/packages/ui/test/modelToolCapabilityDraft.test.ts
@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ProviderSettingsFormModel } from "../src/lib/providerSettingsFormTypes.js";
+import {
+  createProviderModelDraftValues,
+  resolveProviderModelDraftCommit,
+} from "../src/settings/model-provider-section/ProviderModelMetadata.js";
+import {
+  restoreModelDraft,
+  updateModelDraft,
+} from "../src/settings/model-provider-section/ProviderModelDraftState.js";
+
+function model(toolEvidence?: boolean): ProviderSettingsFormModel {
+  const inheritedConfig = {
+    enabled: true,
+    properties: {
+      contextWindow: 128_000,
+      inputFormat: {
+        supportsText: true,
+        supportsImage: false,
+        supportsVideo: false,
+        supportsAudio: false,
+        supportsPdf: false,
+      },
+      outputFormat: { supportsText: true },
+      supportsToolCall: true,
+    },
+    optionSpecs: {
+      maxOutputTokens: { max: 8_192, map: "{}" },
+      reasoningLevel: { values: ["off"], map: "{}" },
+    },
+  };
+  return {
+    kind: "saved",
+    modelId: "text-model",
+    config: inheritedConfig,
+    inheritedConfig,
+    evidenceConfig: {
+      properties: toolEvidence === undefined ? {} : { supportsToolCall: toolEvidence },
+      optionSpecs: { reasoningLevel: inheritedConfig.optionSpecs.reasoningLevel },
+    },
+    personalConfig: {},
+    useRecommendedConfig: true,
+    hasPersonalConfig: false,
+  } as unknown as ProviderSettingsFormModel;
+}
+
+test("unknown tool support stays unknown until an explicit correction, then saves through the existing model overlay", () => {
+  const current = model();
+  const draft = createProviderModelDraftValues(current);
+  assert.equal((draft as { supportsToolCallValue?: boolean }).supportsToolCallValue, undefined);
+
+  const corrected = updateModelDraft(
+    draft,
+    { supportsToolCallValue: false } as Partial<typeof draft>,
+    current,
+  );
+  const result = resolveProviderModelDraftCommit({ currentModel: current, draft: corrected });
+  assert.equal(result.status, "commit");
+  if (result.status !== "commit") return;
+  assert.equal(result.model.config.properties?.supportsToolCall, false);
+  assert.equal(result.model.personalConfig.properties?.supportsToolCall, false);
+  assert.equal(result.model.config.properties?.inputFormat?.supportsImage, false);
+});
+
+test("recommended model tool evidence is restored without retaining the manual correction", () => {
+  const current = model(true);
+  const edited = updateModelDraft(
+    createProviderModelDraftValues(current),
+    { supportsToolCallValue: false } as Partial<ReturnType<typeof createProviderModelDraftValues>>,
+    current,
+  );
+  const restored = restoreModelDraft(edited, current);
+  const result = resolveProviderModelDraftCommit({ currentModel: current, draft: restored });
+  assert.equal(result.status, "commit");
+  if (result.status !== "commit") return;
+  assert.equal(result.model.config.properties?.supportsToolCall, true);
+  assert.equal(result.model.personalConfig.properties?.supportsToolCall, undefined);
+});
+
+test("reopening a saved correction does not replace it with unknown catalog evidence", () => {
+  const current = {
+    ...model(),
+    config: {
+      ...model().config,
+      properties: { ...model().config.properties, supportsToolCall: false },
+    },
+    personalConfig: { properties: { supportsToolCall: false } },
+    hasPersonalConfig: true,
+  } as ProviderSettingsFormModel;
+  const draft = createProviderModelDraftValues(current);
+  assert.equal((draft as { supportsToolCallValue?: boolean }).supportsToolCallValue, false);
+  assert.equal(draft.overriddenFieldsValue?.includes("supportsToolCallValue"), true);
+});
