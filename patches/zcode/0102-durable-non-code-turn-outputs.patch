+export function toolResultAttachmentRefs(
+  content: ModelMessageContent | undefined,
+  sessionId: string,
+): ToolResultAttachment[] | undefined {
+  if (!Array.isArray(content)) return undefined;
+  const attachments: ToolResultAttachment[] = [];
+  let attachmentIndex = 0;
+  for (const block of content) {
+    if (block.type === "text") continue;
+    const isMedia =
+      ((block.type === "image" || block.type === "video") && block.dataUrl.startsWith("data:")) ||
+      (block.type === "file" &&
+        (block.dataUrl?.startsWith("data:") ||
+          (block.uri === block.source?.uri && typeof block.text === "string")));
+    // Keep indexing identical to persistedToolMediaProjection; unsupported mixtures have no attachments.
+    if (!isMedia) return undefined;
+    const ref = block.source?.uri;
+    if (
+      ref?.startsWith(`zcode-artifact://${encodeURIComponent(sessionId)}/`) &&
+      attachments.length < 32
+    ) {
+      attachments.push({
+        attachmentIndex,
+        ref,
+        fileName:
+          (block.type === "file" ? block.name : undefined) ?? block.source?.placeholder ?? "",
+        mime: block.mediaType,
+        ...(block.source?.sizeBytes === undefined ? {} : { bytes: block.source.sizeBytes }),
+      });
+    }
+    attachmentIndex++;
+  }
+  return attachments.length ? attachments : undefined;
+}
