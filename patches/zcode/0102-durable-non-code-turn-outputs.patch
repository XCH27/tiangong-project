+test("pending, failed and unknown receipts have no output preview and retrieval never starts generation", async () => {
+  const eventStore = createInMemorySessionEventStore();
+  let providerCalls = 0;
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: ["ResumeMediaJob"] },
+    deps: {
+      eventStore,
+      mediaGenerationPort: {
+        listModels: () => [],
+        prepareImage: async () => "unused",
+        generateImage: async () => {
+          providerCalls++;
+          throw new Error("must not generate");
+        },
+        submitVideo: async () => {
+          providerCalls++;
+          throw new Error("must not submit");
+        },
+        readVideo: async () => {
+          providerCalls++;
+          throw new Error("no original provider ID");
+        },
+      },
+    },
+  });
+  const artifacts = new NodeToolArtifactStore({ rootDir: join(f.dir, "artifacts") });
+  try {
+    const calls = [];
+    for (const status of ["pending", "failed", "unknown"] as const) {
+      const saved = await artifacts.writeToolResultArtifactOnce({
+        sessionId,
+        toolCallId: status,
+        toolName: "MediaJobReceipt",
+        idempotencyKey: `fixture-${status}:intent`,
+        contentType: "application/json",
+        retention: "session",
+        trace: createRootTraceContext({ sessionId }),
+        content: JSON.stringify({
+          version: 1,
+          jobId: `fixture-${status}`,
+          kind: "video",
+          providerId: "fixture",
+          modelId: "video",
+          startedAt: Date.now(),
+          updatedAt: Date.now(),
+          status,
+        }),
+      });
+      calls.push({
+        id: status,
+        name: "ResumeMediaJob",
+        input: { receiptUri: saved.uri, waitSeconds: 0 },
+      });
+    }
+    f.steps.push(
+      () => reply("check saved jobs", calls),
+      () => reply("nothing completed"),
+    );
+    await f.runtime.executeTurn("Inspect these existing requests");
+    const live = rows(await eventStore.getEvents(sessionId)).filter(
+      (row): row is ToolCallRow => row.kind === "toolCall",
+    );
+    assert.equal(live.length, 3);
+    assert.ok(live.every((row) => !row.output?.attachments?.length));
+    assert.ok(live.every((row) => !row.output?.text.includes("Generated media saved")));
+    await f.reopen();
+    const cold = rows(
+      synthesizeEventsFromMessages(await f.store.messages({ sessionID: sessionId }), { sessionId }),
+    ).filter((row): row is ToolCallRow => row.kind === "toolCall");
+    assert.equal(cold.length, 3);
+    assert.ok(cold.every((row) => !row.output?.attachments?.length));
+    assert.equal(providerCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("late background updates retain their original task row when a later turn reuses the call ID", () => {
+  const projection = new ProductProjection(sessionId, "background-epoch");
+  let sequence = 0;
+  const send = (type: SessionEvent["type"], turnId: string, payload: unknown) => {
+    sequence++;
+    projection.applyEventAtomically(
+      {
+        id: `event-${sequence}`,
+        sessionId,
+        turnId,
+        traceId: "trace",
+        sequenceNumber: sequence,
+        timestamp: new Date(sequence * 1000),
+        type,
+        payload,
+      } as SessionEvent,
+      () => true,
+    );
+  };
+  send(SessionEventType.TurnStarted, "background-launch", { input: "Run a background check" });
+  send(SessionEventType.ToolCallScheduled, "background-launch", {
+    toolCallId: "background-call",
+    assistantMessageId: "launch-message",
+    toolName: "Agent",
+    input: { run_in_background: true },
+    schedule: { parallelGroups: [["background-call"]], executionOrder: ["background-call"] },
+  });
+  send(SessionEventType.BackgroundTaskStarted, "background-launch", {
+    taskId: "background-job",
+    toolCallId: "background-call",
+    assistantMessageId: "launch-message",
+    taskKind: "subagent",
+    status: "running",
+  });
+  send(SessionEventType.ToolCallResult, "background-launch", {
+    toolCallId: "background-call",
+    assistantMessageId: "launch-message",
+    duration: 1,
+    result: { success: true, content: "launched" },
+  });
+  send(SessionEventType.TurnComplete, "background-launch", { resultType: "success" });
+  send(SessionEventType.TurnStarted, "human-next", { input: "Another request" });
+  send(SessionEventType.ToolCallScheduled, "human-next", {
+    toolCallId: "background-call",
+    assistantMessageId: "later-message",
+    toolName: "Probe",
+    input: {},
+    schedule: { parallelGroups: [["background-call"]], executionOrder: ["background-call"] },
+  });
+  send(SessionEventType.ToolCallResult, "human-next", {
+    toolCallId: "background-call",
+    assistantMessageId: "later-message",
+    duration: 1,
+    result: { success: true, content: "later tool completed" },
+  });
+  send(SessionEventType.TurnComplete, "human-next", { resultType: "success" });
+  send(SessionEventType.TurnStarted, "background-notification", {
+    input:
+      "<task-notification><tool-use-id>background-call</tool-use-id><task-id>background-job</task-id><status>failed</status><error>original task failed</error></task-notification>",
+    inputKind: "background_task",
+  });
+  const result = projection
+    .getSnapshot()
+    .rows.window.find(
+      (row): row is ToolCallRow =>
+        row.kind === "toolCall" && row.assistantResponseId === "launch-message",
+    );
+  assert.equal(result?.turnId, "background-launch");
+  assert.equal(result?.status, "error");
+  assert.equal(result?.output?.text, "original task failed");
+  const later = projection
+    .getSnapshot()
+    .rows.window.find(
+      (row): row is ToolCallRow =>
+        row.kind === "toolCall" && row.assistantResponseId === "later-message",
+    );
+  assert.equal(later?.status, "success");
+  assert.equal(later?.output?.text, "later tool completed");
+});
