@@ -0,0 +1,245 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ConversationOutputCards } from "../src/v4/ConversationOutputCards.js";
+import { ConversationStatusPanel } from "../src/v4/ConversationStatusPanel.js";
+import { ConversationFileSummaryPanel } from "../src/v4/ConversationFileSummaryPanel.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import type { ConversationOutput } from "../src/v4/conversationOutputs.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: { name: string; error?: string }[] = [];
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const png = Uint8Array.from(
+  atob(
+    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aC9sAAAAASUVORK5CYII=",
+  ),
+  (c) => c.charCodeAt(0),
+);
+const output = (video = false): ConversationOutput => ({
+  rowId: video ? 12 : 11,
+  entityId: video ? "video-row" : "image-row",
+  attachment: {
+    attachmentIndex: video ? 4 : 2,
+    ref: `zcode-artifact://fixture/outputs/${video ? "video" : "image"}`,
+    fileName: video ? "预览视频.mp4" : "生成图片.png",
+    mime: video ? "video/mp4" : "image/png",
+  },
+});
+
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+async function mounted(locale: "zh-CN" | "en-US", children: React.ReactNode) {
+  const node = document.createElement("div");
+  node.style.width = "320px";
+  document.body.append(node);
+  const root = createRoot(node);
+  const render = async (value: React.ReactNode) => {
+    await act(async () => {
+      root.render(
+        <PlatformProvider
+          platform={
+            { isDesktop: true, openExternal: async () => {}, openPath: async () => {} } as never
+          }
+        >
+          <ZCodeIntlProvider initialLocale={locale}>
+            <TooltipProvider>{value}</TooltipProvider>
+          </ZCodeIntlProvider>
+        </PlatformProvider>,
+      );
+      await new Promise((resolve) => setTimeout(resolve, 20));
+    });
+  };
+  await render(children);
+  return {
+    node,
+    render,
+    close: async () => {
+      await act(async () => root.unmount());
+      node.remove();
+    },
+  };
+}
+
+(window as unknown as Record<string, unknown>).__conversationOutputTests = (async () => {
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const dark of [false, true]) {
+      document.documentElement.classList.toggle("dark", dark);
+      await test(`${locale}/${dark ? "dark" : "light"}: media-only status and preview do not require Git`, async () => {
+        const calls: any[] = [];
+        const read = async (params: any) => {
+          calls.push(params);
+          return { bytes: [...png], mediaType: "image/png" };
+        };
+        const context = { sessionId: "fixture", readAttachment: read } as any;
+        const outputs = [output(), output(true)];
+        const f = await mounted(
+          locale,
+          <ConversationStatusPanel
+            workspacePath="/fixture"
+            outputs={outputs}
+            outputContext={context}
+            summaryPanelVariantOverride="panel"
+          />,
+        );
+        try {
+          check(
+            f.node.textContent?.includes(locale === "zh-CN" ? "本轮成果" : "Turn outputs"),
+            "Media-only status entry is missing",
+          );
+          check(
+            !f.node.textContent?.includes("+0") && !f.node.textContent?.includes("-0"),
+            "Media got fake code statistics",
+          );
+          check(
+            f.node.textContent?.includes("生成图片.png") &&
+              f.node.textContent?.includes("预览视频.mp4"),
+            "Outputs not listed",
+          );
+          check(
+            calls.length === 1 &&
+              calls[0].target?.entityId === "image-row" &&
+              calls[0].attachmentIndex === 2,
+            "Image did not use its exact persisted tool target",
+          );
+          check(!calls.some((call) => call.ref.includes("video")), "Video was eagerly transferred");
+          check(f.node.scrollWidth <= 320, "Result card overflows narrow window");
+          const before = calls.length;
+          await f.render(
+            <ConversationStatusPanel
+              workspacePath="/fixture"
+              outputs={outputs.map((r) => ({ ...r, attachment: { ...r.attachment } }))}
+              outputContext={context}
+              summaryPanelVariantOverride="panel"
+            />,
+          );
+          check(calls.length === before, "Equivalent status update reread output bytes");
+          const image = f.node.querySelector<HTMLElement>("img");
+          check(image, "Image thumbnail not available");
+          await act(async () => image!.closest<HTMLElement>('[role="button"],button')!.click());
+          check(document.querySelector('[role="dialog"]'), "Shared image preview did not open");
+          await f.render(
+            <ConversationStatusPanel
+              workspacePath="/fixture"
+              outputs={[...outputs]}
+              outputContext={context}
+              summaryPanelVariantOverride="panel"
+            />,
+          );
+          check(
+            document.querySelector('[role="dialog"]'),
+            "Status update lost the opened result preview",
+          );
+        } finally {
+          await f.close();
+        }
+      });
+    }
+  await test("missing result remains an explicit unavailable file without generation or stale image", async () => {
+    let calls = 0;
+    const context = {
+      sessionId: "fixture",
+      readAttachment: async () => {
+        calls++;
+        throw new Error("Missing fixture bytes");
+      },
+    } as any;
+    const f = await mounted(
+      "zh-CN",
+      <ConversationOutputCards outputs={[output()]} context={context} />,
+    );
+    try {
+      check(f.node.textContent?.includes("生成图片.png"), "Missing-file identity disappeared");
+      check(
+        f.node.querySelector('[title="图片暂时无法预览"]') ||
+          f.node.querySelector('[title*="无法"]'),
+        "Missing bytes have no explicit unavailable state",
+      );
+      check(!f.node.querySelector("img"), "Missing bytes became a stale image");
+      check(calls === 1, "Missing preview silently retried");
+    } finally {
+      await f.close();
+    }
+  });
+  await test("collapsed automatic result panel delays image I/O until it is actually shown", async () => {
+    let calls = 0;
+    const outputs = [output()];
+    const context = { sessionId: "fixture", readAttachment: async () => { calls++; return { bytes: [...png], mediaType: "image/png" }; } } as any;
+    const f = await mounted("zh-CN", <ConversationStatusPanel workspacePath="/fixture" outputs={outputs} outputContext={context} />);
+    try {
+      check(calls === 0, "CSS-hidden result panel fetched image bytes");
+      await f.render(<ConversationStatusPanel workspacePath="/fixture" outputs={outputs} outputContext={context} summaryPanelVariantOverride="panel" />);
+      check(calls === 1, "Showing result panel did not read its image");
+    } finally { await f.close(); }
+  });
+  for (const path of ["/fixture/报告.md", "/fixture/table.xlsx", "/fixture/source.ts"]) {
+    await test(`${path}: document opens native preview; source preserves code review`, async () => {
+      const opens: any[] = [];
+      const header = {
+        kind: "turnHeader",
+        rowId: 1,
+        entityId: "turn-A",
+        turnId: "A",
+        state: "complete",
+        fileChanges: { files: 1, additions: 1, deletions: 0, state: "active" },
+      } as any;
+      const context = {
+        workspacePath: "/fixture",
+        workspaceIdentity: "remote-fixture",
+        workspaceRemoteSessionId: "remote-session",
+        onOpenCodeViewer: (source: any) => opens.push(source),
+        fetchFileChanges: async () => ({
+          state: "active",
+          items: [
+            {
+              path,
+              additions: 1,
+              deletions: 0,
+              patches: [
+                { oldStart: 1, oldLines: 1, newStart: 1, newLines: 1, lines: ["-old", "+new"] },
+              ],
+            },
+          ],
+        }),
+      } as any;
+      const f = await mounted(
+        "zh-CN",
+        <ConversationFileSummaryPanel header={header} context={context} />,
+      );
+      try {
+        await act(async () => {
+          f.node.querySelector<HTMLButtonElement>("button")!.click();
+          await new Promise((resolve) => setTimeout(resolve, 20));
+        });
+        const file = f.node.querySelector<HTMLElement>(`[role="button"][title="${path}"]`);
+        check(file, "File detail not available");
+        await act(async () =>
+          file!.dispatchEvent(
+            new KeyboardEvent("keydown", { key: "Enter", bubbles: true, cancelable: true }),
+          ),
+        );
+        check(
+          opens[0]?.type === (path.endsWith(".ts") ? "patch" : "file"),
+          "Wrong default inspection mode",
+        );
+        check(
+          opens[0]?.workspaceIdentity === "remote-fixture" &&
+            opens[0]?.workspaceRemoteSessionId === "remote-session",
+          "Preview escaped its remote target",
+        );
+      } finally {
+        await f.close();
+      }
+    });
+  }
+  return results;
+})();
