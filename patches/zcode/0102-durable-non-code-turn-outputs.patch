diff --git a/apps/zcode-cli/packages/bootstrap/src/app/tool-output-attachment.ts b/apps/zcode-cli/packages/bootstrap/src/app/tool-output-attachment.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6cba71cba45c1f9939ffd84c09e8dd5802f3d85f
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/tool-output-attachment.ts
@@ -0,0 +1,38 @@
+import type { MessageId, SessionId, SessionStorePort } from "@zcode/contracts";
+
+/** Resolve output through the original persisted tool; never fall back to a caller's path. */
+export async function resolvePersistedToolAttachment(
+  store: SessionStorePort,
+  sessionId: SessionId,
+  input: { ref: string; messageId?: string; toolCallId?: string; attachmentIndex?: number },
+): Promise<{ ref: string; mediaType: string; artifactUri: string }> {
+  const denied = () => new Error("fault.attachment.previewRefNotAuthorized");
+  if (
+    !input.messageId ||
+    !input.toolCallId ||
+    input.attachmentIndex === undefined ||
+    !Number.isInteger(input.attachmentIndex) ||
+    input.attachmentIndex < 0 ||
+    !input.ref.startsWith(`zcode-artifact://${encodeURIComponent(sessionId)}/`)
+  )
+    throw denied();
+  const message = await store.messageWithParts({
+    sessionID: sessionId,
+    messageID: input.messageId as MessageId,
+  });
+  if (!message || message.info.role !== "assistant" || message.info.sessionID !== sessionId)
+    throw denied();
+  const matches = message.parts.filter(
+    (part) => part.type === "tool" && part.callID === input.toolCallId,
+  );
+  if (matches.length !== 1) throw denied();
+  const tool = matches[0];
+  if (tool?.type !== "tool" || tool.state.status !== "completed") throw denied();
+  const attachment = tool.state.attachments?.[input.attachmentIndex];
+  if (!attachment || attachment.sessionID !== sessionId || attachment.messageID !== input.messageId)
+    throw denied();
+  const ref = attachment.metadata?.artifactUri ?? attachment.url;
+  if (ref !== input.ref || !ref.startsWith(`zcode-artifact://${encodeURIComponent(sessionId)}/`))
+    throw denied();
+  return { ref, artifactUri: ref, mediaType: attachment.mime };
+}
