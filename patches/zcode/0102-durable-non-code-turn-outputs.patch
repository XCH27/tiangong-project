+// Scripted local fixture only: character counts, not tokens, vendor wire size or savings.
+import { fixture, reply } from "../apps/zcode-cli/packages/core/test/helpers/pi-runtime-fixture.ts";
+const rows = [];
+for (const [name, toolAllowlist] of [
+  ["available-default-with-probe", undefined],
+  ["available-default-without-probe", undefined],
+  ["read-only-local", ["Read", "Glob", "Grep"]],
+]) {
+  const f = await fixture(undefined, false, { config: { toolAllowlist } });
+  if (name !== "available-default-with-probe") {
+    f.runtime.getToolRegistry().unregister("Probe");
+    f.runtime.invalidateToolCache();
+  }
+  try {
+    f.steps.push((r: any) => {
+      const projected = r.tools.map((t: any) => ({
+        name: t.name,
+        description: t.description ?? "",
+        inputSchema: t.inputSchema,
+      }));
+      const systems = r.messages.filter((m: any) => m.role === "system");
+      const text = (x: any) => (typeof x === "string" ? x : JSON.stringify(x));
+      rows.push({
+        profile: name,
+        toolNames: projected.map((t: any) => t.name),
+        toolCount: projected.length,
+        systemContentChars: systems.reduce((s: number, m: any) => s + text(m.content).length, 0),
+        messageJsonChars: JSON.stringify(r.messages).length,
+        modelFacingToolArrayJsonChars: JSON.stringify(projected).length,
+        modelFacingToolIndividualSumChars: projected.reduce(
+          (s: number, t: any) => s + JSON.stringify(t).length,
+          0,
+        ),
+        modelFacingEnvelopeJsonChars: JSON.stringify({ messages: r.messages, tools: projected })
+          .length,
+        allHostToolContractArrayJsonChars: JSON.stringify(r.tools).length,
+        note: "scripted inference; Host projected messages/name-description-input-schema; includes synthetic Probe only in available-default-with-probe; not tokenizer or final provider wire",
+      });
+      return reply("complete");
+    });
+    await f.runtime.executeTurn("Complete the assigned task.");
+  } finally {
+    await f.close();
+  }
+}
+console.log(JSON.stringify(rows, null, 2));
