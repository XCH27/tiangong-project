+      },
+    });
+    let successEvents = 0;
+    const publicationFailures: unknown[] = [];
+    const unsubscribe = f.runtime.subscribeEvents({
+      async onSessionEvent(event) {
+        if (event.type !== SessionEventType.ToolCallResult) return;
+        const payload = event.payload as any;
+        if (!payload.result.success || !payload.result.attachments?.length) return;
+        successEvents++;
+        const attachment = payload.result.attachments[0];
+        try {
+          await resolvePersistedToolAttachment(f.store, sessionId, {
+            ref: attachment.ref,
+            messageId: payload.assistantMessageId,
+            toolCallId: payload.toolCallId,
+            attachmentIndex: attachment.attachmentIndex,
+          });
+        } catch (error) {
+          publicationFailures.push(error);
+        }
+      },
+    });
+    try {
+      f.steps.push(
+        () => reply("creating", [imageCall()]),
+        () => reply("done"),
+      );
+      await f.runtime.executeTurn("Create a visible result");
+      assert.equal(
+        successEvents,
+        1,
+        "publish one success after commit, never a second patch event",
+      );
+      assert.deepEqual(
+        publicationFailures,
+        [],
+        "the UI must be able to read at the event boundary",
+      );
+      assert.equal(generations, 1);
+    } finally {
+      unsubscribe();
+      await f.close();
+    }
+  }
+});
