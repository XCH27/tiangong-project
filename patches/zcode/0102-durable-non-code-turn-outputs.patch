diff --git a/packages/ui/src/v4/conversationOutputs.ts b/packages/ui/src/v4/conversationOutputs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..27e27ddfddbf00f1d0e7f15fc3aa85b7566762dd
--- /dev/null
+++ b/packages/ui/src/v4/conversationOutputs.ts
@@ -0,0 +1,37 @@
+import type { ConversationRow, ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+
+export interface ConversationOutput {
+  rowId: number;
+  entityId: string;
+  attachment: NonNullable<NonNullable<ToolCallRow["output"]>["attachments"]>[number];
+}
+
+const GENERATION_TOOLS = new Set(["GenerateImage", "GenerateVideo", "ResumeMediaJob"]);
+
+/** Only committed generation results are deliverables; Read/screenshot/user inputs are observations. */
+export function collectConversationOutputs(rows: readonly ConversationRow[]): ConversationOutput[] {
+  const byRef = new Map<string, ConversationOutput>();
+  for (const row of rows) {
+    if (
+      row.kind !== "toolCall" ||
+      !row.entityId ||
+      !GENERATION_TOOLS.has(row.toolName) ||
+      row.status !== "success"
+    )
+      continue;
+    for (const attachment of row.output?.attachments ?? []) {
+      if (!attachment.mime.startsWith("image/") && !attachment.mime.startsWith("video/")) continue;
+      // Resume can publish the same durable result again. Its filename is not its identity.
+      byRef.set(attachment.ref, { rowId: row.rowId, entityId: row.entityId, attachment });
+    }
+  }
+  return [...byRef.values()];
+}
+
+/** The compact status panel describes the current turn, not a total over a paginated history. */
+export function currentTurnOutputs(rows: readonly ConversationRow[]): ConversationOutput[] {
+  const current = [...rows].reverse().find((row) => row.kind === "turnHeader");
+  return current
+    ? collectConversationOutputs(rows.filter((row) => row.turnId === current.turnId))
+    : [];
+}
