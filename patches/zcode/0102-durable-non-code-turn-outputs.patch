@@ -0,0 +1,73 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ConversationRow, ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import { collectConversationOutputs, currentTurnOutputs } from "../src/v4/conversationOutputs.js";
+import { buildConversationStatusPanelModel } from "../src/v4/conversationStatusPanelModel.js";
+
+function tool(rowId: number, ref: string, extra: Partial<ToolCallRow> = {}): ToolCallRow {
+  return {
+    kind: "toolCall",
+    rowId,
+    entityId: `tool:${rowId}`,
+    turnId: "turn-A",
+    toolCallId: "reused-id",
+    assistantResponseId: `assistant:${rowId}`,
+    toolName: "GenerateImage",
+    status: "success",
+    inputText: "",
+    output: {
+      text: "Created",
+      attachments: [{ ref, fileName: "image.png", mime: "image/png", attachmentIndex: 3 }],
+    },
+    ...extra,
+  } as ToolCallRow;
+}
+
+test("turn outputs use generation receipts, not user images, Read results or unfinished work", () => {
+  const ref = "zcode-artifact://fixture/outputs/image";
+  const rows = [
+    tool(1, ref),
+    tool(2, "read-ref", { toolName: "Read" }),
+    tool(3, "pending", { status: "running" }),
+    tool(4, "failed", { status: "error" }),
+    { kind: "userInput", attachments: [{ ref: "input" }] },
+  ] as ConversationRow[];
+  assert.deepEqual(
+    collectConversationOutputs(rows).map((item) => item.attachment.ref),
+    [ref],
+  );
+  assert.equal(collectConversationOutputs(rows)[0]!.attachment.attachmentIndex, 3);
+});
+
+test("resume deduplicates the same durable file but same filenames and reused call IDs retain distinct outputs", () => {
+  const rows = [tool(1, "A"), tool(2, "B"), tool(3, "A", { toolName: "ResumeMediaJob" })];
+  const results = collectConversationOutputs(rows);
+  assert.equal(results.length, 2);
+  assert.equal(results.find((r) => r.attachment.ref === "A")!.rowId, 3);
+  assert.equal(results.find((r) => r.attachment.ref === "B")!.rowId, 2);
+});
+
+test("current-turn output preview never claims previous paginated turns are current results", () => {
+  const rows = [
+    { kind: "turnHeader", turnId: "turn-A" },
+    tool(1, "A"),
+    { kind: "turnHeader", turnId: "turn-B" },
+    tool(2, "B", { turnId: "turn-B" }),
+  ] as ConversationRow[];
+  assert.deepEqual(
+    currentTurnOutputs(rows).map((item) => item.attachment.ref),
+    ["B"],
+  );
+  assert.equal(currentTurnOutputs(rows.slice(1, 2)).length, 0);
+});
+
+test("media-only turn keeps a status entry in office and coding modes without a Git repository", () => {
+  const outputs = collectConversationOutputs([tool(1, "A")]);
+  for (const isOfficeMode of [false, true]) {
+    const model = buildConversationStatusPanelModel({ isOfficeMode, outputs });
+    assert.equal(model.git, null);
+    assert.equal(model.hasContent, true);
+    assert.equal(model.outputs.length, 1);
+  }
+  assert.equal(buildConversationStatusPanelModel({}).hasContent, false);
+});
