new file mode 100644
index 0000000000000000000000000000000000000000..d925a24fbf9ac2e073cf67640698ff356524e4bf
--- /dev/null
+++ b/packages/ui/src/v4/ConversationOutputCards.tsx
@@ -0,0 +1,109 @@
+import { useLayoutEffect, useMemo, useRef, useState } from "react";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { ConversationAttachmentList } from "./ConversationAttachmentList.js";
+import type { ConversationRowRenderContext } from "./conversationRowContext.js";
+import type { ConversationOutput } from "./conversationOutputs.js";
+
+type OutputContext = Pick<
+  ConversationRowRenderContext,
+  "sessionId" | "readAttachment" | "readAttachmentRange"
+>;
+
+function OutputCard({
+  output: { rowId, entityId, attachment },
+  context,
+}: {
+  output: ConversationOutput;
+  context: OutputContext;
+}) {
+  const { intl } = useZCodeIntl();
+  const { ref, fileName, mime, bytes, attachmentIndex } = attachment;
+  const cardRef = useRef<HTMLDivElement>(null);
+  const [hasBeenVisible, setHasBeenVisible] = useState(false);
+  useLayoutEffect(() => {
+    // CSS-hidden status bodies must not fetch outputs before being shown. Once shown,
+    // preserve their preview URLs even if resizing hides the card behind an open dialog.
+    const element = cardRef.current;
+    if (!element) return;
+    const reveal = () => {
+      if (element.getClientRects().length) setHasBeenVisible(true);
+    };
+    reveal();
+    const observer = new ResizeObserver(reveal);
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, []);
+  // Status/stream updates must not revoke a visible preview or reread the same bytes.
+  const attachments = useMemo(() => [{ ref, fileName, mime, bytes }], [ref, fileName, mime, bytes]);
+  const indices = useMemo(() => [attachmentIndex], [attachmentIndex]);
+  return (
+    <div
+      ref={cardRef}
+      className="flex min-w-0 items-center gap-3 rounded-xl border border-border bg-card p-2"
+    >
+      <ConversationAttachmentList
+        attachments={attachments}
+        attachmentIndices={indices}
+        rowId={rowId}
+        entityId={entityId}
+        sessionId={context.sessionId ?? undefined}
+        attachmentKind="media"
+        readAttachment={context.readAttachment}
+        readAttachmentRange={context.readAttachmentRange}
+        prefetchVideo={false}
+        prefetchImages={hasBeenVisible}
+      />
+      <div className="min-w-0 flex-1">
+        <p className="truncate text-ui-base" title={fileName}>
+          {fileName}
+        </p>
+        <p className="text-ui-sm text-foreground-subtle">
+          {intl.formatMessage({
+            id: mime.startsWith("video/") ? "chat.results.video" : "chat.results.image",
+          })}
+        </p>
+      </div>
+    </div>
+  );
+}
+
+/** A view of native Session files; this component neither creates a catalog nor owns their bytes. */
+export function ConversationOutputCards({
+  outputs,
+  context,
+  compact = false,
+}: {
+  outputs: readonly ConversationOutput[];
+  context: OutputContext;
+  compact?: boolean;
+}) {
+  const { intl } = useZCodeIntl();
+  const [expanded, setExpanded] = useState(false);
+  const limit = compact ? 3 : 6;
+  if (!outputs.length) return null;
+  const visible = expanded ? outputs : outputs.slice(0, limit);
+  return (
+    <section aria-label={intl.formatMessage({ id: "chat.results.title" })} className="space-y-2">
+      {!compact ? (
+        <p className="text-ui-base font-medium">
+          {intl.formatMessage({ id: "chat.results.title" })}
+        </p>
+      ) : null}
+      <div className={compact ? "flex flex-col gap-2" : "grid grid-cols-1 gap-2 @lg:grid-cols-2"}>
+        {visible.map((output) => (
+          <OutputCard
+            key={`${context.sessionId}:${output.rowId}:${output.entityId}:${output.attachment.ref}`}
+            output={output}
+            context={context}
+          />
+        ))}
+      </div>
+      {outputs.length > limit ? (
+        <Button variant="ghost" size="sm" onClick={() => setExpanded(!expanded)}>
+          {intl.formatMessage({ id: expanded ? "chat.results.less" : "chat.results.more" })}
+        </Button>
+      ) : null}
+    </section>
+  );
+}
