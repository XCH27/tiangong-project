+        sessionId,
+        target: { rowId: recovered.rowId, entityId: recovered.entityId! },
+        attachmentIndex: 0,
+        ref: saved.artifactUri,
+        offset: 0,
+        limit: 512,
+      });
+      assert.deepEqual(Buffer.from(data.dataBase64, "base64"), png);
