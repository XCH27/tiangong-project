 import { createRequire } from "node:module";
 import { spawn } from "node:child_process";
+import { spawnSync } from "node:child_process";
 
 const require = createRequire(import.meta.url);
 const { build } = createRequire(new URL("../apps/zcode-cli/package.json", import.meta.url))(
   "esbuild",
 );
 const root = resolve(import.meta.dirname, "..");
+// Reuse the development review records: a self-check must not start another Electron
+// beside the visible candidate. This optional guard does not make standalone builds depend on Fleet.
+const reviews = resolve(root, "../../.fleet/reviews");
+for (const name of ["project-audit/desktop", "native-executor", "attachment-preview", "model-settings"]) {
+  let saved;
+  try { saved = JSON.parse(await readFile(join(reviews, name, "review.json"), "utf8")); }
+  catch { continue; }
+  if (!Number.isSafeInteger(saved.pid) || saved.pid <= 0 || saved.executable !== require("electron")) continue;
+  try { process.kill(saved.pid, 0); } catch (error) { if (error.code === "ESRCH") continue; throw error; }
+  if (process.platform !== "win32" && !/Fleet|Electron/i.test(spawnSync("ps", ["-p", String(saved.pid), "-o", "comm="], { encoding: "utf8" }).stdout)) continue;
+  throw new Error("Close the existing Fleet review before renderer self-checks; no second Electron was started.");
+}
