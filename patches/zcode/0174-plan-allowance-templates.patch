+
+test("Z.ai / BigModel Coding Plan reads plan windows only for Coding Plan connections", async () => {
+  assert.equal(apiKeyPlanRoute({ templateId: "zai-api", baseUrl: "https://api.z.ai/api/anthropic" }), "zai-coding-plan");
+  assert.equal(apiKeyPlanRoute({ templateId: "bigmodel-api", baseUrl: "https://open.bigmodel.cn/api/anthropic" }), "zai-coding-plan");
+  // Same hosts, pay-as-you-go API: no plan allowance.
+  assert.equal(apiKeyPlanRoute({ templateId: "zai-standard-api", baseUrl: "https://api.z.ai/api/paas/v4" }), undefined);
+  assert.equal(apiKeyPlanRoute({ baseUrl: "https://open.bigmodel.cn/api/paas/v4" }), undefined);
+
+  const now = Date.UTC(2026, 9, 6, 12);
+  const parsed = parseZaiCodingPlanUsage(
+    {
+      code: 200,
+      data: {
+        planName: "GLM Coding Pro",
+        limits: [
+          // Counts override the rounded percentage: 1500 of 2000 used.
+          { type: "TOKENS_LIMIT", unit: 3, number: 5, percentage: 74, usage: 2000, currentValue: 1500, nextResetTime: now + 3_600_000 },
+          { type: "TOKENS_LIMIT", unit: 6, number: 1, percentage: 12, nextResetTime: now + 86_400_000 },
+          // A one-minute TIME_LIMIT marks the monthly MCP quota.
+          { type: "TIME_LIMIT", unit: 5, number: 1, percentage: 40 },
+          { type: "FUTURE_LIMIT", unit: 1, number: 1, percentage: 1 },
+        ],
+      },
+    },
+    now,
+  );
+  assert.equal(parsed.status, "available");
+  if (parsed.status !== "available") return;
+  assert.equal(parsed.plan, "GLM Coding Pro");
+  assert.deepEqual(
+    parsed.windows.map((w) => [w.id, w.windowMinutes, Math.round(w.usedPercent ?? -1), w.resetAt !== undefined]),
+    [
+      ["default:five_hour", 300, 75, true],
+      ["default:weekly", 10_080, 12, true],
+      ["MCP:monthly", 43_200, 40, false],
+    ],
+  );
+  // A five-hour reset ten hours away is dropped, never timezone-corrected.
+  const skewed = parseZaiCodingPlanUsage(
+    { data: { limits: [{ type: "TOKENS_LIMIT", unit: 3, number: 5, percentage: 10, nextResetTime: now + 10 * 3_600_000 }] } },
+    now,
+  );
+  assert.equal(skewed.status === "available" && skewed.windows[0]?.resetAt, undefined);
+  // Malformed known entries make the reading unavailable rather than 0 %.
+  assert.equal(
+    parseZaiCodingPlanUsage({ data: { limits: [{ type: "TOKENS_LIMIT", unit: "hour", number: 5, percentage: 1 }] } }, now).status,
+    "unavailable",
+  );
+  assert.equal(parseZaiCodingPlanUsage({ data: { limits: [] } }, now).status, "unavailable");
+
+  const seen: string[] = [];
+  const result = await readApiKeyPlanUsage(
+    "zai-coding-plan",
+    "synthetic-zai-key",
+    "https://open.bigmodel.cn/api/anthropic",
+    (async (url: string, init: RequestInit) => {
+      seen.push(`${url} ${(init.headers as Record<string, string>).Authorization}`);
+      return new Response(JSON.stringify({ data: { limits: [{ type: "TOKENS_LIMIT", unit: 3, number: 5, percentage: 5 }] } }), { status: 200 });
+    }) as typeof fetch,
+    () => now,
+  );
+  assert.deepEqual(seen, ["https://open.bigmodel.cn/api/monitor/usage/quota/limit Bearer synthetic-zai-key"]);
+  assert.equal(result.status, "available");
+});
