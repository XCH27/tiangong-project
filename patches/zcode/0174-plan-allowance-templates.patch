diff --git a/packages/services/src/model-provider/apiKeyPlanUsage.ts b/packages/services/src/model-provider/apiKeyPlanUsage.ts
index 6a28fa6..d92a035 100644
--- a/packages/services/src/model-provider/apiKeyPlanUsage.ts
+++ b/packages/services/src/model-provider/apiKeyPlanUsage.ts
@@ -178,6 +178,67 @@ export function parseKimiCodeUsage(payload: unknown, observedAt: number): Subscr
     : { status: "unavailable", unavailableReason: "no-provider-data" };
 }
 
+const ZAI_UNIT_MINUTES: Readonly<Record<number, number>> = { 1: 1440, 3: 60, 5: 1, 6: 10_080 };
+
+function zaiWindowName(minutes: number): string {
+  return minutes === 300 ? "five_hour" : minutes === 10_080 ? "weekly" : minutes === 43_200 ? "monthly" : `${minutes}m`;
+}
+
+/**
+ * Z.ai / BigModel Coding Plan `GET /api/monitor/usage/quota/limit`: data.limits[] of TOKENS_LIMIT /
+ * CREDIT_LIMIT (plan windows) and TIME_LIMIT (MCP). Field semantics follow CodexBar
+ * `Plugins/zai.js`: integer unit/number/percentage, unit 1=day 3=hour 5=minute 6=week, counts
+ * override the rounded percentage, `TIME_LIMIT` 1 minute marks the monthly MCP quota, and a
+ * five-hour reset further than five hours away is dropped rather than guessed.
+ */
+export function parseZaiCodingPlanUsage(payload: unknown, observedAt: number): SubscriptionUsageResult {
+  const data = record(record(payload)?.data);
+  const limits = Array.isArray(data?.limits) ? data.limits : [];
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const raw of limits) {
+    const row = record(raw);
+    const type = row?.type;
+    if (type !== "TOKENS_LIMIT" && type !== "CREDIT_LIMIT" && type !== "TIME_LIMIT") continue;
+    const unit = row?.unit;
+    const number = row?.number;
+    const percentage = row?.percentage;
+    if (!Number.isInteger(unit) || !Number.isInteger(number) || !Number.isInteger(percentage))
+      return { status: "unavailable", unavailableReason: "no-provider-data" };
+    const usage = Number.isInteger(row?.usage) ? (row!.usage as number) : undefined;
+    const current = Number.isInteger(row?.currentValue) ? (row!.currentValue as number) : undefined;
+    const remaining = Number.isInteger(row?.remaining) ? (row!.remaining as number) : undefined;
+    let percent = percentage as number;
+    if (usage !== undefined && usage > 0) {
+      const used =
+        remaining !== undefined ? Math.max(usage - remaining, current ?? usage - remaining) : current;
+      if (used !== undefined) percent = (Math.max(0, Math.min(usage, used)) / usage) * 100;
+    }
+    const mcpMonthly = type === "TIME_LIMIT" && unit === 5 && number === 1;
+    const multiplier = ZAI_UNIT_MINUTES[unit as number];
+    const windowMinutes = mcpMonthly
+      ? 43_200
+      : (number as number) > 0 && multiplier
+        ? (number as number) * multiplier
+        : undefined;
+    if (windowMinutes === undefined) continue;
+    const reset = Number.isInteger(row?.nextResetTime) ? (row!.nextResetTime as number) : undefined;
+    const plausibleReset =
+      reset !== undefined && !(type !== "TIME_LIMIT" && windowMinutes === 300 && reset > observedAt + 301 * 60_000);
+    windows.push({
+      id: type === "TIME_LIMIT" ? `MCP:${zaiWindowName(windowMinutes)}` : `default:${zaiWindowName(windowMinutes)}`,
+      usedPercent: clampPercent(percent),
+      windowMinutes,
+      ...(plausibleReset ? { resetAt: reset } : {}),
+    });
+  }
+  const plan = [data?.planName, data?.plan, data?.plan_type, data?.packageName, data?.level].find(
+    (value): value is string => typeof value === "string" && value.trim().length > 0 && value.length <= 128,
+  );
+  return windows.length
+    ? { status: "available", source: "Z.ai Coding Plan", observedAt, windows, ...(plan ? { plan } : {}) }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
