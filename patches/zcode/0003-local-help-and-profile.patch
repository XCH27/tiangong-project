+test("partial model import retries preserve existing manual configuration and completed additions", async () => {
+  const { addDiscoveredModels } =
+    await import("../../ui/src/settings/model-provider-section/modelDiscoveryActions.js");
+  const records = new Map<string, object>([
+    ["existing", { enabled: false, properties: { contextWindow: 12345 } }],
+  ]);
+  const writes: string[] = [];
+  const selected = new Set(["existing", "first", "second"]);
+  let failSecond = true;
+  const service = {
+    async getView() {
+      return {
+        providers: [{ providerId: "one", models: [...records].map(([modelId]) => ({ modelId })) }],
+      } as any;
+    },
+    async addPersonalModel(_providerId: string, id: string, config: object) {
+      if (id === "second" && failSecond) throw new Error("disk unavailable");
+      assert.equal(records.has(id), false);
+      records.set(id, config);
+      writes.push(id);
+      return this.getView();
+    },
+  };
+  const input = {
+    providerId: "one",
+    service,
+    selected,
+    isCurrent: () => true,
+    catalog: {
+      source: "provider" as const,
+      models: [...selected].map((id) => ({ id, name: id, config: {} })),
+    },
+    onAdded: (id: string) => {
+      selected.delete(id);
+    },
+  };
+  await assert.rejects(addDiscoveredModels(input), /disk unavailable/);
+  assert.deepEqual([...selected], ["second"]);
+  failSecond = false;
+  await addDiscoveredModels(input);
+  assert.deepEqual(writes, ["first", "second"]);
+  assert.deepEqual(records.get("existing"), {
+    enabled: false,
+    properties: { contextWindow: 12345 },
+  });
+});
+
+test("closing discovery before the snapshot returns admits no import mutation", async () => {
