diff --git a/packages/ui/src/settings/model-provider-section/modelDiscoveryActions.ts b/packages/ui/src/settings/model-provider-section/modelDiscoveryActions.ts
new file mode 100644
index 0000000..db1a80e
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/modelDiscoveryActions.ts
@@ -0,0 +1,42 @@
+import type { IProviderSettingsService } from "@zcode/services";
+
+export type DiscoveredCatalog = Awaited<ReturnType<IProviderSettingsService["discoverModels"]>>;
+
+export async function fetchSavedModelCatalog(input: {
+  providerId: string;
+  service: Pick<IProviderSettingsService, "discoverModels">;
+  saveDraft?: () => Promise<void>;
+  isCurrent: () => boolean;
+}): Promise<DiscoveredCatalog | undefined> {
+  await input.saveDraft?.();
+  if (!input.isCurrent()) return;
+  const catalog = await input.service.discoverModels(input.providerId);
+  return input.isCurrent() ? catalog : undefined;
+}
+
+// Durable writes stay with ProviderSettingsService. Re-read before each addition so a retry
+// cannot overwrite a completed addition or a model edited in another window.
+export async function addDiscoveredModels(input: {
+  providerId: string;
+  catalog: DiscoveredCatalog;
+  selected: ReadonlySet<string>;
+  service: Pick<IProviderSettingsService, "getView" | "addPersonalModel">;
+  isCurrent: () => boolean;
+  onAdded: (id: string) => void;
+}) {
+  for (const model of input.catalog.models) {
+    if (!input.selected.has(model.id)) continue;
+    if (!input.isCurrent()) return;
+    const view = await input.service.getView();
+    if (!input.isCurrent()) return;
+    const provider = view.providers.find((item) => item.providerId === input.providerId);
+    if (!provider) throw new Error("Connection no longer exists");
+    if (!provider.models.some((item) => item.modelId === model.id)) {
+      await input.service.addPersonalModel(input.providerId, model.id, {
+        ...model.config,
+        enabled: true,
+      });
+    }
+    if (input.isCurrent()) input.onAdded(model.id);
+  }
+}
