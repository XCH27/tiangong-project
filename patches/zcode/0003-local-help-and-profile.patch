+  const pending = addDiscoveredModels({
+    providerId: "one",
+    selected: new Set(["model"]),
+    catalog: { source: "provider", models: [{ id: "model", name: "Model", config: {} }] },
+    isCurrent: () => current,
+    onAdded: () => assert.fail("stale completion"),
+    service: {
+      getView: () => read.promise,
+      addPersonalModel: async () => {
+        throw new Error("must not write");
+      },
+    },
+  });
+  current = false;
+  read.resolve({ providers: [{ providerId: "one", models: [] }] });
+  await pending;
+});
