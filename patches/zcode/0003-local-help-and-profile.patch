+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu.js";
+import { Input } from "@/components/ui/input.js";
+import { useSettings } from "@/hooks/useSettingService.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { prepareLocalProfileAvatar } from "@/lib/localProfileAvatar.js";
+
+/** Cherry's avatar/name editor, backed by the existing local Host settings owner. */
+export function LocalProfileControl() {
+  const { intl } = useZCodeIntl();
+  const { settings, error: readError, refresh, update } = useSettings();
+  const [open, setOpen] = useState(false);
+  const [draftName, setDraftName] = useState<string>();
+  const [error, setError] = useState<string>();
+  const imageRequest = useRef(0);
+  const nameRequest = useRef(0);
+  const fileInput = useRef<HTMLInputElement>(null);
+  useEffect(
+    () => () => {
+      imageRequest.current++;
+      nameRequest.current++;
+    },
+    [],
+  );
+  const name = settings?.localProfileName || intl.formatMessage({ id: "profile.defaultName" });
+  const avatar = settings?.localProfileAvatar;
+  const changeOpen = (value: boolean) => {
+    imageRequest.current++;
+    setOpen(value);
+    if (value) {
+      setDraftName(undefined);
+      setError(undefined);
+      void refresh();
+    }
+  };
+  const saveName = async (value: string) => {
+    const request = ++nameRequest.current;
+    setDraftName(value);
+    setError(undefined);
+    try {
+      await update({ localProfileName: value.trim() });
+    } catch {
+      if (request === nameRequest.current) setError("profile.saveError");
+    }
+  };
+  const saveAvatar = async (file?: File) => {
+    const request = ++imageRequest.current;
+    setError(undefined);
+    let data = "";
+    try {
+      if (file) data = await prepareLocalProfileAvatar(file);
+    } catch {
+      if (request === imageRequest.current) setError("profile.imageError");
+      return;
+    }
+    // 关闭、重选或恢复默认后，旧图片的异步解码不得覆盖新的选择。
+    if (request !== imageRequest.current) return;
+    try {
+      await update({ localProfileAvatar: data });
+    } catch {
+      if (request === imageRequest.current) setError("profile.saveError");
+    }
+  };
+  const image = (large = false) => (
+    <Avatar size="default" className={large ? "size-20" : undefined}>
+      {avatar ? <AvatarImage src={avatar} alt="" /> : null}
+      <AvatarFallback>
+        <img src={defaultProfileAvatar} alt="" className="size-full rounded-full" />
+      </AvatarFallback>
+    </Avatar>
+  );
+  return (
+    <>
+      <Button
+        type="button"
+        variant="ghost"
+        size="lg"
+        className="min-w-0 flex-1 justify-start gap-2 overflow-hidden rounded-tl-2xl rounded-bl-2xl border-0 pl-0"
+        aria-label={intl.formatMessage({ id: "profile.edit" })}
+        onClick={() => changeOpen(true)}
+      >
+        {image()}
+        <div className="min-w-0 flex-1 overflow-hidden text-left">
+          <div className="flex min-w-0 items-center gap-1.5">
+            <span className="min-w-0 truncate text-ui-base font-semibold text-foreground">
+              {name}
+            </span>
+          </div>
+        </div>
+      </Button>
+      <Dialog open={open} onOpenChange={changeOpen}>
+        <DialogContent className="max-w-xs gap-5 p-5" aria-describedby={undefined}>
+          <DialogTitle className="sr-only">
+            {intl.formatMessage({ id: "profile.edit" })}
+          </DialogTitle>
+          <div className="flex justify-center pt-3">
+            <DropdownMenu>
+              <DropdownMenuTrigger asChild>
+                <Button
+                  variant="ghost"
+                  className="size-20 rounded-full p-0"
+                  disabled={!settings}
+                  aria-label={intl.formatMessage({ id: "profile.avatar" })}
+                >
+                  {image(true)}
+                </Button>
+              </DropdownMenuTrigger>
+              <DropdownMenuContent align="center">
+                <DropdownMenuItem onSelect={() => fileInput.current?.click()}>
+                  {intl.formatMessage({ id: "profile.upload" })}
+                </DropdownMenuItem>
+                <DropdownMenuItem onSelect={() => void saveAvatar()}>
+                  {intl.formatMessage({ id: "profile.resetAvatar" })}
+                </DropdownMenuItem>
+              </DropdownMenuContent>
+            </DropdownMenu>
+          </div>
+          <input
+            ref={fileInput}
+            type="file"
+            accept="image/png,image/jpeg,image/webp"
+            className="hidden"
+            onChange={(event) => {
+              const file = event.target.files?.[0];
+              event.target.value = "";
+              if (file) void saveAvatar(file);
+            }}
+          />
+          <Input
+            className="text-center"
+            maxLength={30}
+            disabled={!settings}
+            aria-label={intl.formatMessage({ id: "profile.name" })}
+            placeholder={intl.formatMessage({ id: "profile.namePlaceholder" })}
+            value={draftName ?? settings?.localProfileName ?? ""}
+            onChange={(event) => void saveName(event.target.value)}
+          />
+          {error || readError ? (
+            <div role="alert" className="text-ui-base text-destructive">
+              {intl.formatMessage({ id: error ?? "profile.readError" })}
+              {readError ? (
+                <Button variant="ghost" onClick={() => void refresh()}>
+                  {intl.formatMessage({ id: "common.retry" })}
+                </Button>
+              ) : null}
+            </div>
+          ) : null}
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
