new file mode 100644
index 0000000..9df1871
--- /dev/null
+++ b/packages/ui/src/lib/localProfileAvatar.ts
@@ -0,0 +1,33 @@
+/** Cherry UserPopup's local image normalization, using the browser codec and no upload. */
+export async function prepareLocalProfileAvatar(file: File): Promise<string> {
+  if (
+    !["image/png", "image/jpeg", "image/webp"].includes(file.type) ||
+    file.size > 10 * 1024 * 1024
+  ) {
+    throw new Error("INVALID_AVATAR");
+  }
+  const bitmap = await createImageBitmap(file);
+  try {
+    const canvas = document.createElement("canvas");
+    canvas.width = canvas.height = 128;
+    const context = canvas.getContext("2d");
+    if (!context) throw new Error("INVALID_AVATAR");
+    const side = Math.min(bitmap.width, bitmap.height);
+    context.drawImage(
+      bitmap,
+      (bitmap.width - side) / 2,
+      (bitmap.height - side) / 2,
+      side,
+      side,
+      0,
+      0,
+      128,
+      128,
+    );
+    const result = canvas.toDataURL("image/png");
+    if (result.length > 100_000) throw new Error("INVALID_AVATAR");
+    return result;
+  } finally {
+    bitmap.close();
+  }
+}
