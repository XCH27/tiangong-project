+    return;
+  }
+  void stopping.then(async (stopped) => {
+    if (!stopped) {
+      unknown();
+      return;
+    }
+    try {
+      await Promise.all(state.pendingWorldReceipts);
+    } catch {
+      unknown();
+      return;
+    }
+    finalize();
+  }, unknown);
