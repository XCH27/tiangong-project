@@ -0,0 +1,44 @@
+import type { WorldReadOp } from "@zcode/dynamic-workflow";
+import { executeWorldRead, type WorldReadDeps } from "./workflow-world-read.js";
+
+/** Match the Host's bounded late-effect grace; timeout is uncertainty, never cancellation proof. */
+export const WORLD_EFFECT_STOP_GRACE_MS = 1_500;
+
+/** One driver's transient process scope; outcomes still belong to the engine's original journal. */
+export function createWorkflowWorldLifecycle(deps: WorldReadDeps) {
+  const controller = new AbortController();
+  const pending = new Set<Promise<unknown>>();
+  let stopping: Promise<boolean> | undefined;
+  return {
+    execute(op: WorldReadOp, args: unknown[]): Promise<unknown> {
+      const work = executeWorldRead({ ...deps, signal: controller.signal }, op, args);
+      if (op === "run") {
+        pending.add(work);
+        void work.then(
+          () => pending.delete(work),
+          () => pending.delete(work),
+        );
+      }
+      return work;
+    },
+    stop(): Promise<boolean> {
+      // abort 在任何等待之前发生，而且只属于本 run。并发 Stop 共用同一次清理。
+      controller.abort();
+      stopping ??= (async () => {
+        if (pending.size === 0) return true;
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        try {
+          return await Promise.race([
+            Promise.allSettled(pending).then(() => true),
+            new Promise<boolean>((resolve) => {
+              timer = setTimeout(() => resolve(false), WORLD_EFFECT_STOP_GRACE_MS);
+            }),
+          ]);
+        } finally {
+          if (timer !== undefined) clearTimeout(timer);
+        }
+      })();
+      return stopping;
+    },
+  };
+}
