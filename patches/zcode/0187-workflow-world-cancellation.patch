+function finishRun(
+  state: EngineState,
+  status: RunStatus,
+  settlement: RunSettlementRecord,
+  result: RunSettlement,
+): void {
+  const unknown = () => {
+    const error = new WorkflowError(
+      "Interrupted",
+      "Workflow stopped waiting for its world commands: termination or durable outcome is unknown. Inspect their effects before starting new work.",
+    );
+    commitSettlement(
+      state,
+      "stopped",
+      { stopReason: "interrupted", failure: error.toJSON() },
+      { status: "stopped", reason: "interrupted", error },
+    );
+  };
+  const finalize = () => {
+    // DSL 允许未 await 的 world.run；脚本 return 不证明遗留命令成功或副作用回滚。
+    try {
+      if (
+        status === "completed" &&
+        state.journal
+          .listNodes(state.runId)
+          .some((node) => node.kind === "world-run" && node.status === "running")
+      ) {
+        unknown();
+        return;
+      }
+    } catch {
+      unknown();
+      return;
+    }
+    commitSettlement(state, status, settlement, result);
+  };
+  // 核心不读时钟：driver 负责有界终止；确认进程结束后，等待同一节点的收据提交再发布终态。
+  let stopping: Promise<boolean> | undefined;
