@@ -0,0 +1,82 @@
+import type { AuthInteraction, AuthPrompt } from "@earendil-works/pi-ai";
+import type {
+  SubscriptionKind,
+  SubscriptionLogin,
+  SubscriptionLoginMethod,
+} from "./subscriptionConnectionTypes.js";
+
+// Pi owns PKCE, callback listener, polling and token exchange. This bridges its prompts to
+// the existing settings RPC without exposing token material or starting another auth store.
+export function subscriptionLoginInteraction(options: {
+  kind: SubscriptionKind;
+  method: SubscriptionLoginMethod;
+  flowId: string;
+  signal: AbortSignal;
+  notify(login: SubscriptionLogin): void;
+}) {
+  let state: string | undefined;
+  let reply: ((value: string) => void) | undefined;
+  const interaction: AuthInteraction & { signal: AbortSignal } = {
+    signal: options.signal,
+    async prompt(prompt: AuthPrompt) {
+      if (options.kind === "openai-codex" && prompt.type === "select") return options.method;
+      if (options.kind === "github-copilot" && prompt.type === "text") return "";
+      if (prompt.type !== "manual_code") throw new Error("Unsupported authorization step");
+      const signal = prompt.signal
+        ? AbortSignal.any([prompt.signal, options.signal])
+        : options.signal;
+      signal.throwIfAborted();
+      return new Promise<string>((resolve, reject) => {
+        const abort = () => {
+          reply = undefined;
+          reject(new Error("Subscription login cancelled"));
+        };
+        signal.addEventListener("abort", abort, { once: true });
+        reply = (value) => {
+          reply = undefined;
+          signal.removeEventListener("abort", abort);
+          resolve(value);
+        };
+      });
+    },
+    notify(event) {
+      if (event.type === "auth_url") {
+        const url = new URL(event.url);
+        if (url.protocol !== "https:" || url.hostname !== "auth.openai.com")
+          throw new Error("Unexpected authorization address");
+        state = url.searchParams.get("state") ?? undefined;
+        options.notify({ flowId: options.flowId, method: "browser", verificationUrl: event.url });
+      } else if (event.type === "device_code") {
+        const url = new URL(event.verificationUri);
+        if (url.protocol !== "https:") throw new Error("Unexpected authorization address");
+        options.notify({
+          flowId: options.flowId,
+          method: "device_code",
+          verificationUrl: event.verificationUri,
+          userCode: event.userCode,
+        });
+      }
+    },
+  };
+  return {
+    interaction,
+    submit(value: string) {
+      options.signal.throwIfAborted();
+      if (!reply || !state) throw new Error("Subscription login expired or cancelled");
+      let url: URL;
+      try {
+        url = new URL(value.trim());
+      } catch {
+        throw new Error("Paste the complete localhost callback URL");
+      }
+      if (
+        url.origin !== "http://localhost:1455" ||
+        url.pathname !== "/auth/callback" ||
+        url.searchParams.get("state") !== state ||
+        !url.searchParams.get("code")
+      )
+        throw new Error("This callback does not belong to the current login");
+      reply(url.href);
+    },
+  };
+}
