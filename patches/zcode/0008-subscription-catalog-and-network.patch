+    Authorization: `Bearer ${credential.access}`,
+    Accept: "application/json",
+    "X-XAI-Token-Auth": "xai-grok-cli",
+    "x-grok-client-version": "1.0.3",
+    ...(typeof credential.accountId === "string" ? { "x-userid": credential.accountId } : {}),
+  };
+}
+export async function readSubscriptionJson(
+  url: string,
+  headers: Record<string, string>,
+  fetcher: typeof fetch,
+): Promise<unknown> {
+  const response = await fetcher(url, {
+    headers,
+    redirect: "error",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) {
+    await response.body?.cancel();
+    // Never echo a vendor response body: it can contain credentials or account data.
+    throw new Error(`Subscription request failed (HTTP ${response.status})`);
+  }
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("Subscription response is empty");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const part = await reader.read();
+      if (part.done) break;
+      size += part.value.byteLength;
+      if (size > 2 * 1024 * 1024) {
+        await reader.cancel();
+        throw new Error("Subscription response is too large");
+      }
+      chunks.push(part.value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+}
+function record(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+function text(value: unknown): string | undefined {
+  return typeof value === "string" &&
+    value.length > 0 &&
+    value.length <= 512 &&
+    !/[\r\n]/.test(value)
+    ? value
+    : undefined;
+}
+function positive(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : undefined;
+}
+export async function identifyGrokSubscription(
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+): Promise<OAuthCredential> {
+  const user = record(
+    await readSubscriptionJson(
+      `${GROK_SUBSCRIPTION_BASE_URL}/user?include=subscription`,
+      grokSubscriptionHeaders(credential),
+      fetcher,
+    ),
+  );
+  const accountId = text(user.userId);
+  if (!accountId) throw new Error("Grok did not return an account identity");
+  return { ...credential, accountId, email: text(user.email) };
+}
+// Account catalogs expose native IDs/capabilities. Do not substitute a baked-in catalog when
+// the request fails: that would look like the selected account had been checked.
+export async function readNativeSubscriptionCatalog(
+  kind: "openai-codex" | "xai",
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+): Promise<ModelDiscoveryResult> {
+  if (typeof credential.accountId !== "string")
+    throw new Error("Sign in to this subscription again");
+  const payload = await readSubscriptionJson(
+    kind === "xai"
+      ? `${GROK_SUBSCRIPTION_BASE_URL}/models`
+      : "https://chatgpt.com/backend-api/codex/models?client_version=0.155.0",
+    kind === "xai"
+      ? grokSubscriptionHeaders(credential)
+      : {
+          Accept: "application/json",
+          Authorization: `Bearer ${credential.access}`,
+          "ChatGPT-Account-Id": credential.accountId,
+        },
+    fetcher,
+  );
+  return parseNativeSubscriptionCatalog(kind, payload);
+}
+export function parseNativeSubscriptionCatalog(
+  kind: "openai-codex" | "xai",
+  payload: unknown,
+): ModelDiscoveryResult {
+  const body = record(payload);
+  const list = kind === "xai" ? body.data : body.models;
+  if (!Array.isArray(list)) throw new Error("Unsupported subscription model catalog");
+  const models = new Map<string, ModelDiscoveryResult["models"][number]>();
+  for (const value of list.slice(0, 2000)) {
+    const item = record(value);
+    const meta = record(item._meta);
+    if (item.hidden === true || meta.hidden === true || item.visibility === "hide") continue;
+    // Grok's native catalog can also advertise Messages/Chat routes. This adapter is Responses.
+    if (kind === "xai" && (item.api_backend ?? item.apiBackend) !== "responses") continue;
+    const id = text(
+      kind === "xai"
+        ? (item.model ?? item.modelId ?? item.id ?? meta.model ?? meta.modelId)
+        : item.slug,
+    );
+    if (!id) continue;
+    const context = positive(item.context_window ?? item.contextWindow ?? meta.totalContextTokens);
+    const output = positive(
+      item.max_output_tokens ?? item.max_completion_tokens ?? item.maxCompletionTokens,
+    );
+    const rawEfforts =
+      kind === "xai"
+        ? (item.reasoning_efforts ?? item.reasoningEfforts ?? meta.reasoningEfforts)
+        : item.supported_reasoning_levels;
+    const levels = Array.isArray(rawEfforts)
+      ? rawEfforts.map((value) =>
+          typeof value === "string"
+            ? value
+            : (record(value).reasoning_effort ?? record(value).value),
+        )
+      : [];
+    const allowed = ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
+    const efforts = allowed.filter((level) => levels.includes(level));
+    const modalities = Array.isArray(item.input_modalities) ? item.input_modalities : undefined;
+    const config: ModelConfigObject = {
+      ...(context || modalities
+        ? {
+            properties: {
+              ...(context ? { contextWindow: context } : {}),
+              ...(modalities
+                ? {
+                    inputFormat: {
+                      supportsText: modalities.includes("text"),
+                      supportsImage: modalities.includes("image"),
+                      supportsAudio: false,
+                      supportsVideo: false,
+                      supportsPdf: false,
+                    },
+                  }
+                : {}),
+            },
+          }
+        : {}),
+      optionSpecs: {
+        ...(output ? { maxOutputTokens: { max: output, map: "{}" } } : {}),
+        ...(Array.isArray(rawEfforts)
+          ? { reasoningLevel: { values: efforts.length ? efforts : ["off"], map: "{}" } }
+          : {}),
+      },
+    };
+    models.set(id, { id, name: text(item.display_name ?? item.name) ?? id, config });
+  }
+  return { source: "provider", models: [...models.values()] };
+}
+
+export function readAdapterSubscriptionCatalog(
+  provider: Provider,
+  credential: OAuthCredential,
+): ModelDiscoveryResult {
+  const models = provider.filterModels
+    ? provider.filterModels(provider.getModels(), credential)
+    : provider.getModels();
+  return {
+    source: "catalog",
+    models: models.map((model) => ({
+      id: model.id,
+      name: model.name,
+      config: {
+        properties: {
+          contextWindow: model.contextWindow,
+          requiresMfjsToolSchema: false,
+          inputFormat: {
+            supportsText: true,
+            supportsImage: model.input.includes("image"),
+            supportsPdf: false,
+            supportsAudio: false,
+            supportsVideo: false,
+          },
+          outputFormat: { supportsText: true },
+          supportsToolCall: true,
+          supportsJsonSchemaOutput: false,
+          supportsNativeWebSearch: false,
+          supportsMidConversationSystem:
+            (model.compat && "supportsMidConvoSystemMessages" in model.compat
+              ? model.compat.supportsMidConvoSystemMessages
+              : false) ?? false,
+        },
+        optionSpecs: {
+          maxOutputTokens: { max: model.maxTokens, map: "{}" },
+          reasoningLevel: { values: getSupportedThinkingLevels(model), map: "{}" },
+        },
+      },
+    })),
+  };
+}
