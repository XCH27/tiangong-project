+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  identifyGrokSubscription,
+  parseNativeSubscriptionCatalog,
+  readNativeSubscriptionCatalog,
+} from "../src/model-provider/subscriptionCatalog.js";
+
+test("Codex account catalog preserves current IDs and only server-declared metadata", () => {
+  const result = parseNativeSubscriptionCatalog("openai-codex", {
+    models: [
+      {
+        slug: "new-model",
+        display_name: "New",
+        context_window: 300000,
+        supported_reasoning_levels: [{ reasoning_effort: "high" }, { reasoning_effort: "low" }],
+      },
+      { slug: "hidden", visibility: "hide" },
+      { slug: "unknown" },
+    ],
+  });
+  assert.equal(result.source, "provider");
+  assert.deepEqual(
+    result.models.map((m) => m.id),
+    ["new-model", "unknown"],
+  );
+  assert.equal(result.models[0]?.config.properties?.contextWindow, 300000);
+  assert.deepEqual(result.models[0]?.config.optionSpecs?.reasoningLevel?.values, ["low", "high"]);
+  assert.equal(result.models[1]?.config.properties, undefined);
+});
+test("Grok catalog excludes unsupported protocols and does not infer capabilities from names", () => {
+  const result = parseNativeSubscriptionCatalog("xai", {
+    data: [
+      { model: "grok-new", api_backend: "responses", context_window: 200000 },
+      { model: "grok-messages", api_backend: "messages" },
+      { model: "grok-chat", api_backend: "chat_completions" },
+      { model: "grok-image", hidden: true, api_backend: "responses" },
+    ],
+  });
+  assert.deepEqual(
+    result.models.map((m) => m.id),
+    ["grok-new"],
+  );
+  assert.equal(result.models[0]?.config.properties?.inputFormat, undefined);
+});
+test("Grok identity/catalog requests stay on the official subscription proxy and fail closed", async () => {
+  const requests: Request[] = [];
+  const fetcher: typeof fetch = async (url, init) => {
+    const request = new Request(url, init);
+    requests.push(request);
+    return Response.json(
+      request.url.includes("/user?") ? { userId: "one", email: "one@example.com" } : { data: [] },
+    );
+  };
+  const credential = await identifyGrokSubscription(
+    { type: "oauth", access: "secret", refresh: "refresh", expires: 999 },
+    fetcher,
+  );
+  await readNativeSubscriptionCatalog("xai", credential, fetcher);
+  assert.equal(requests[0]?.url, "https://cli-chat-proxy.grok.com/v1/user?include=subscription");
+  assert.equal(requests[1]?.headers.get("x-userid"), "one");
+  assert.equal(requests[1]?.redirect, "error");
+  await assert.rejects(
+    readNativeSubscriptionCatalog(
+      "xai",
+      credential,
+      async () => new Response("secret should not leak", { status: 403 }),
+    ),
+    /HTTP 403/,
+  );
+});
