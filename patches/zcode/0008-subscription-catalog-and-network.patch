--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionRecords.ts
@@ -0,0 +1,58 @@
+import type { ModelAuth } from "@earendil-works/pi-ai";
+import type {
+  SavedConnection,
+  SubscriptionKind,
+  SubscriptionAccountsView,
+  SubscriptionRequestAuth,
+} from "./subscriptionConnectionTypes.js";
+import { subscriptionAccountLabel } from "./subscriptionAccountLabel.js";
+
+export function parseSavedConnection(raw: string, kind: SubscriptionKind): SavedConnection {
+  const saved = JSON.parse(raw) as SavedConnection;
+  if (saved.kind !== kind) throw new Error("Subscription connection changed; sign in again");
+  // Legacy single-account records are read in place; the next explicit edit upgrades this entry.
+  saved.accounts ??= saved.credential ? [{ id: "legacy", credential: saved.credential }] : [];
+  saved.activeAccountId ??= saved.accounts[0]?.id;
+  saved.revision ??= "legacy";
+  if (
+    saved.accounts.length > 10 ||
+    new Set(saved.accounts.map((a) => a.id)).size !== saved.accounts.length
+  )
+    throw new Error("Subscription account list is invalid");
+  for (const { credential } of saved.accounts) {
+    if (
+      credential.type !== "oauth" ||
+      !credential.access ||
+      !credential.refresh ||
+      !Number.isFinite(credential.expires)
+    )
+      throw new Error("Subscription credentials are invalid; sign in again");
+  }
+  delete saved.credential;
+  return saved;
+}
+
+export function accountsView(saved?: SavedConnection): SubscriptionAccountsView {
+  return {
+    accounts: (saved?.accounts ?? []).map((a) => ({
+      id: a.id,
+      label: a.label ?? subscriptionAccountLabel(a.credential),
+      active: a.id === saved?.activeAccountId,
+    })),
+    autoSwitch: saved?.autoSwitch === true && (saved.accounts?.length ?? 0) > 1,
+    revision: saved?.revision ?? "empty",
+  };
+}
+
+export function requestAuth(auth: ModelAuth): SubscriptionRequestAuth {
+  if (!auth.apiKey) throw new Error("Subscription token is unavailable; sign in again");
+  return {
+    apiKey: auth.apiKey,
+    headers: Object.fromEntries(
+      Object.entries(auth.headers ?? {}).filter(
+        (pair): pair is [string, string] => typeof pair[1] === "string",
+      ),
+    ),
+    ...(auth.baseUrl ? { baseUrl: auth.baseUrl } : {}),
+  };
+}
