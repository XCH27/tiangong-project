+
+test("a default login that becomes a Fleet-home account keeps that stable home", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-adopt-home-"));
+  const { runtime, setIdentity, homes } = fixture(directory);
+  try {
+    await runtime.start();
+    const service = runtime.providerSettings;
+    const { providerId } = await service.createPersonalProvider({ templateId: "fleet-chatgpt-native" });
+    await service.connectNativeCli(providerId);
+    await signIn(service, providerId);
+    await service.updateSubscriptionAccounts(providerId, { select: "default@example.invalid" });
+    setIdentity("", "second@example.invalid");
+    await service.discoverModels(providerId);
+    const access = (await service.getView()).providers.find((p) => p.providerId === providerId)!
+      .effectiveConfig.access as { accountId?: string; configDir?: string; accounts?: { id: string; configDir?: string }[] };
+    assert.equal(access.accountId, "second@example.invalid");
+    assert.equal(access.configDir, homes[0], "the Fleet home, which other tools cannot rewrite, stays in use");
+    assert.deepEqual(access.accounts?.map((a) => a.id), ["second@example.invalid"]);
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test("an unrelated settings write during a slow CLI check does not fail the reconnect", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-fence-"));
+  const { runtime, setInspectDelay } = fixture(directory);
+  try {
+    await runtime.start();
+    const service = runtime.providerSettings;
+    const { providerId } = await service.createPersonalProvider({ templateId: "fleet-chatgpt-native" });
+    setInspectDelay(150);
+    const connecting = service.connectNativeCli(providerId);
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    await service.createPersonalProvider({ templateId: "fleet-claude-native" });
+    await connecting;
+    const access = (await service.getView()).providers.find((p) => p.providerId === providerId)!
+      .effectiveConfig.access as { connected?: boolean };
+    assert.equal(access.connected, true);
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test("ACP failures keep their cause: only explicit authentication refusals mean signed out", async () => {
+  const { acpFailure } = await import("../../../apps/zcode-cli/packages/adapters/src/native-agent/acp-session.js");
+  assert.match(acpFailure("codebuddy", Object.assign(new Error("Authentication required"), { data: { category: "auth" } })).message, /Sign in to the official CodeBuddy CLI/);
+  assert.match(acpFailure("kimi", new Error("401 Unauthorized")).message, /Sign in to the official/);
+  const network = acpFailure("kimi", new Error("oauth token refresh failed: ECONNRESET"));
+  assert.doesNotMatch(network.message, /Sign in/);
+  assert.match(network.message, /network/);
+  assert.doesNotMatch(acpFailure("opencode", new Error("Author field missing")).message, /Sign in/);
+});
