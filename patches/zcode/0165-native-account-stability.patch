diff --git a/packages/ui/test/providerDetailFeedback.browser.test.tsx b/packages/ui/test/providerDetailFeedback.browser.test.tsx
new file mode 100644
index 0000000..c3e0623
--- /dev/null
+++ b/packages/ui/test/providerDetailFeedback.browser.test.tsx
@@ -0,0 +1,94 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { ModelProviderSectionLayout } from "../src/settings/model-provider-section/SectionLayout.js";
+import { useProviderDetailFeedback } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+
+let show: ((message: string) => void) | undefined;
+function Detail() {
+  const { showFeedback } = useProviderDetailFeedback();
+  show = (message) => showFeedback({ key: "probe", state: "failure", message, dismissible: true });
+  return (
+    <div>
+      {Array.from({ length: 60 }, (_, index) => (
+        <div key={index} className="h-12 border-b border-border text-ui-base">
+          model-{index}
+        </div>
+      ))}
+    </div>
+  );
+}
+
+async function run() {
+  for (const scroll of ["top", "bottom"] as const)
+    await test(`page feedback stays at the bottom of the visible detail pane (scrolled ${scroll})`, async () => {
+      document.documentElement.className = "theme-zai-dark";
+      const node = document.createElement("div");
+      node.style.width = "1100px";
+      document.body.append(node);
+      const root = createRoot(node);
+      try {
+        await act(async () =>
+          root.render(
+            <ZCodeIntlProvider initialLocale="zh-CN">
+              <TooltipProvider>
+                <ModelProviderSectionLayout
+                  description="d"
+                  refreshLabel="r"
+                  loadingLabel="l"
+                  presetLoading={false}
+                  customLoading={false}
+                  onRefresh={() => {}}
+                  addProviderLabel="a"
+                  onAddProvider={() => {}}
+                  navigationGroups={[]}
+                  selectedNodeKey="probe"
+                  onSelectNavItem={() => {}}
+                >
+                  <Detail />
+                </ModelProviderSectionLayout>
+              </TooltipProvider>
+            </ZCodeIntlProvider>,
+          ),
+        );
+        const scroller = node.querySelector<HTMLElement>('[data-model-provider-detail-scroll="true"]');
+        const pane = node.querySelector<HTMLElement>('[data-model-provider-detail-pane="true"]');
+        check(scroller && pane, "Missing detail pane");
+        check(scroller.scrollHeight > scroller.clientHeight + 100, "Detail column does not scroll internally");
+        if (scroll === "bottom") scroller.scrollTop = scroller.scrollHeight;
+        await act(async () => show!("连接失败"));
+        await act(async () => new Promise((resolve) => setTimeout(resolve, 50)));
+        const toast = node.querySelector<HTMLElement>('[data-testid="provider-detail-feedback-viewport"] [role="alert"]');
+        check(toast, "Feedback not shown");
+        const box = toast.getBoundingClientRect();
+        const visible = pane.getBoundingClientRect();
+        check(
+          box.top >= visible.top && box.bottom <= visible.bottom,
+          `Feedback outside the visible pane: ${Math.round(box.top)}–${Math.round(box.bottom)} vs ${Math.round(visible.top)}–${Math.round(visible.bottom)}`,
+        );
+        check(
+          visible.bottom - box.bottom <= 40,
+          `Feedback is not at the pane bottom: ${Math.round(visible.bottom - box.bottom)}px above it`,
+        );
+      } finally {
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    });
+}
+(window as any).__providerFeedbackTests = run().then(() => results);
