+test("restoring recommendations retains catalog facts through failed refresh and reopen while deletion clears them", async () => {
+  const f = await fixture();
+  try {
+    const { providerId } = await f.service.createPersonalProvider({
+      templateId: "openrouter",
+      initialConfig: {
+        api: { type: "openai-chat-completions", baseUrl: "https://openrouter.ai/api/v1" },
+        access: { type: "api-key", apiKey: "synthetic" },
+      },
+    });
+    const targetId = "fixture/catalog-restore";
+    const otherId = "fixture/other-correction";
+    const manualId = "fixture/manual-private";
+    f.setFetch(async () =>
+      Response.json({
+        data: [targetId, otherId].map((id) => ({
+          id,
+          context_length: 65_536,
+          top_provider: { max_completion_tokens: 4096 },
+          architecture: { input_modalities: ["text", "image"], output_modalities: ["text"] },
+          supported_parameters: ["tools", "structured_outputs", "reasoning"],
+          reasoning: { mandatory: true, supported_efforts: ["high", "low"], default_effort: "low" },
+        })),
+      }),
+    );
+    await f.service.discoverModels(providerId);
+    await f.service.addPersonalModel(providerId, manualId, {
+      properties: { contextWindow: 98_304 },
+    });
+    await f.service.savePersonalModelDraft({
+      providerId,
+      originalModelId: otherId,
+      nextModelId: otherId,
+      personalConfig: { enabled: false, properties: { contextWindow: 131_072 } },
+      useRecommendedConfig: true,
+      basedOnRevision: (await f.service.getView()).revision,
+    });
+    await f.service.reorderPersonalModels(providerId, [manualId, otherId, targetId]);
+    const models = async () =>
+      (await f.service.getView()).providers.find((p) => p.providerId === providerId)!.models;
+    const unaffected = (await models()).filter((m) => m.modelId !== targetId);
+    const observed = (await models()).find((m) => m.modelId === targetId)!.evidenceConfig;
+    await f.service.savePersonalModelDraft({
+      providerId,
+      originalModelId: targetId,
+      nextModelId: targetId,
+      personalConfig: { properties: { contextWindow: 32_768 } },
+      useRecommendedConfig: true,
+      basedOnRevision: (await f.service.getView()).revision,
+    });
+    assert.equal(
+      (await models()).find((m) => m.modelId === targetId)!.effectiveConfig.properties
+        ?.contextWindow,
+      32_768,
+    );
+    await f.service.savePersonalModelDraft({
+      providerId,
+      originalModelId: targetId,
+      nextModelId: targetId,
+      personalConfig: {},
+      useRecommendedConfig: true,
+      basedOnRevision: (await f.service.getView()).revision,
+    });
+    const assertRestored = async () => {
+      const current = await models();
+      const restored = current.find((m) => m.modelId === targetId)!;
+      assert.equal(restored.personalExactConfig, undefined);
+      assert.equal(restored.contextEvidenceSource, "provider");
+      assert.deepEqual(restored.evidenceConfig, observed);
+      assert.equal(restored.effectiveConfig.properties?.contextWindow, 65_536);
+      assert.equal(restored.effectiveConfig.optionSpecs?.maxOutputTokens?.max, 4096);
+      assert.deepEqual(restored.effectiveConfig.optionSpecs?.reasoningLevel?.values, [
+        "auto",
+        "high",
+        "low",
+      ]);
+      const admitted = f.runtime.registryService.getModel(providerId, targetId)!;
+      assert.equal(admitted.config.properties.contextWindow, 65_536);
+      assert.equal(admitted.config.optionSpecs.maxOutputTokens.max, 4096);
+      assert.deepEqual(admitted.evidenceConfig?.toJSON(), observed);
+      assert.deepEqual(
+        current.filter((m) => m.modelId !== targetId),
+        unaffected,
+      );
+      assert.deepEqual(
+        current.map((m) => m.modelId),
+        [manualId, otherId, targetId],
+      );
+    };
+    await assertRestored();
+    const restoredDisk = await f.disk();
+    f.setFetch(async () => new Response(null, { status: 503 }));
+    await assert.rejects(f.service.discoverModels(providerId), /503/);
+    assert.equal(await f.disk(), restoredDisk);
+    await f.restart();
+    await assertRestored();
+    await f.service.deletePersonalModel(providerId, targetId);
+    assert.equal(
+      (await models()).some((m) => m.modelId === targetId),
+      false,
+    );
+    assert.equal(f.runtime.registryService.getModel(providerId, targetId), undefined);
+    const rules = JSON.parse(await f.disk()).config.modelConfigRules;
+    for (const key of [
+      "providerModelRules",
+      "manualProviderModelRules",
+      "discoveredProviderModelRules",
+    ])
+      assert.equal(
+        (rules[key] ?? []).some((rule: { modelId: string }) => rule.modelId === targetId),
+        false,
+      );
+    await f.restart();
+    assert.deepEqual(await models(), unaffected);
+    assert.equal(f.runtime.registryService.getModel(providerId, targetId), undefined);
+  } finally {
+    await f.dispose();
+  }
+});
