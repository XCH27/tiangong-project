+test("explicit Skill exclusion holds for Pi stream/non-stream and a scripted native port", async () => {
+  const s = await skills();
+  try {
+    for (const route of ["pi", "pi-stream", "native-scripted"] as const) {
+      const receipts: any[] = [];
+      const f = await fixture(undefined, route !== "pi", {
+        config: { toolAllowlist: ["Skill"] },
+        ...(route === "native-scripted" ? { nativeExecutor: { kind: "claude" as const } } : {}),
+        deps: {
+          skillPort: s.port,
+          ...(route === "native-scripted"
+            ? {
+                nativeAgentPort: {
+                  createTurn(request: any) {
+                    return {
+                      model: request.model,
+                      admitNextStep() {},
+                      retainToolReceipts(values: any[]) {
+                        receipts.push(...values);
+                      },
+                      async close() {},
+                    };
+                  },
+                },
+              }
+            : {}),
+        },
+      });
+      try {
+        f.steps.push(
+          (request) => {
+            assert.ok(!request.tools.some((tool: any) => tool.name === "Skill"));
+            assert.ok(!JSON.stringify(request.messages).includes("Instructions for automatic"));
+            return reply("invented call", [
+              { id: "denied", name: "Skill", input: { skill: "manual" } },
+            ]);
+          },
+          (request) => {
+            const lastTool = request.messages
+              .filter((message: any) => message.role === "tool")
+              .at(-1);
+            assert.equal(lastTool?.isError, true);
+            assert.ok(!JSON.stringify(lastTool).includes("BODY_manual"));
+            return reply("excluded");
+          },
+        );
+        assert.equal(
+          (
+            await f.runtime.executeTurn("/manual requested", undefined, {
+              toolDisallowlist: ["Skill"],
+            })
+          ).response,
+          "excluded",
+        );
+        assert.equal(
+          f.permissionCalls,
+          0,
+          "exclusion precedes ordinary permission/hook/handler work",
+        );
+        assert.equal(f.effects, 0);
+        assert.equal(
+          f.requests.length,
+          2,
+          "the refused tool does not cause an extra physical request",
+        );
+        if (route === "native-scripted") {
+          assert.equal(receipts[0]?.isError, true);
+          assert.ok(!JSON.stringify(receipts).includes("BODY_manual"));
+        }
+      } finally {
+        await f.close();
+      }
+    }
+  } finally {
+    await s.close();
+  }
+});
