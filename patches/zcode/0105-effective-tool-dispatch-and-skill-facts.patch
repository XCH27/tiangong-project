+test("model tool admission resolves valid aliases and rechecks the registry at each step", async () => {
+  const f = await fixture();
+  const registry = f.runtime.getToolRegistry();
+  const original = registry.get("Probe")!;
+  let lateEffects = 0;
+  try {
+    registry.register(
+      {
+        ...original,
+        aliases: ["LegacyProbe"],
+        resolveModelContract: () => ({ description: "Request-specific projected contract" }),
+      },
+      { silentDuplicateWarning: true },
+    );
+    f.runtime.invalidateToolCache();
+    f.steps.push(
+      () => reply("alias", [{ id: "alias", name: "LegacyProbe", input: { value: "allowed" } }]),
+      (request) => {
+        assert.equal(
+          request.messages.filter((message: any) => message.role === "tool").at(-1)?.isError,
+          false,
+        );
+        registry.register({
+          ...original,
+          metadata: { ...original.metadata, name: "mcp__fixture__inspect" },
+          aliases: ["LegacyInspect"],
+          async handler() {
+            lateEffects++;
+            return "inspected";
+          },
+        });
+        f.runtime.invalidateToolCache();
+        return reply("early", [
+          { id: "not-yet-declared", name: "LegacyInspect", input: { value: "safe" } },
+        ]);
+      },
+      (request) => {
+        assert.equal(
+          lateEffects,
+          0,
+          "a newly registered tool cannot enter an already sent request",
+        );
+        assert.equal(
+          request.messages.filter((message: any) => message.role === "tool").at(-1)?.isError,
+          true,
+        );
+        assert.ok(request.tools.some((tool: any) => tool.name === "mcp__fixture__inspect"));
+        return reply("now available", [
+          { id: "new-step", name: "LegacyInspect", input: { value: "safe" } },
+        ]);
+      },
+      (request) => {
+        assert.equal(lateEffects, 1);
+        assert.equal(
+          request.messages.filter((message: any) => message.role === "tool").at(-1)?.isError,
+          false,
+        );
+        registry.unregister("mcp__fixture__inspect");
+        f.runtime.invalidateToolCache();
+        return reply("revoked", [
+          { id: "revoked", name: "mcp__fixture__inspect", input: { value: "must-not-run" } },
+        ]);
+      },
+      (request) => {
+        assert.equal(lateEffects, 1, "captured names never grant a revoked registry entry");
+        assert.equal(
+          request.messages.filter((message: any) => message.role === "tool").at(-1)?.isError,
+          true,
+        );
+        return reply("complete");
+      },
+    );
+    await f.runtime.executeTurn("Use only available tools");
+    assert.equal(f.effects, 1);
+    assert.equal(lateEffects, 1);
+    assert.equal(f.permissionCalls, 2);
+    const domainResult = await f.runtime
+      .getToolExecutor()
+      .execute({ id: "domain" as never, name: "LegacyProbe", input: { value: "domain action" } });
+    assert.equal(
+      domainResult.success,
+      true,
+      "a non-model caller does not inherit an earlier request's list",
+    );
+    assert.equal(f.effects, 2);
+  } finally {
+    await f.close();
+  }
+});
