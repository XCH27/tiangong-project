+test(
+  "permission approval cannot revive revoked, replaced or policy-excluded tools",
+  { timeout: 10000 },
+  async () => {
+    for (const streaming of [false, true]) {
+      for (const change of [
+        "unregister",
+        "replace",
+        "mutate-handler",
+        "policy",
+        "policy-callback",
+      ] as const) {
+        const f = await fixture(undefined, streaming);
+        const entered = Promise.withResolvers<void>();
+        const approve = Promise.withResolvers<any>();
+        let replacementEffects = 0;
+        let permitted = true;
+        let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+        try {
+          (f.runtime.getToolExecutor() as any).deps.isToolAllowed = () => permitted;
+          f.permissionWith(async () => {
+            entered.resolve();
+            return approve.promise;
+          });
+          const registry = f.runtime.getToolRegistry();
+          const original = registry.get("Probe")!;
+          registry.register(
+            { ...original, aliases: ["LegacyProbe"] },
+            { silentDuplicateWarning: true },
+          );
+          f.runtime.invalidateToolCache();
+          f.steps.push(
+            () =>
+              reply("request approval", [
+                { id: "pending", name: "LegacyProbe", input: { value: "must-not-run" } },
+              ]),
+            (request) => {
+              const last = request.messages
+                .filter((message: any) => message.role === "tool")
+                .at(-1);
+              assert.equal(last?.isError, true, `${streaming}/${change}`);
+              return reply("Tool became unavailable");
+            },
+          );
+          running = f.runtime.executeTurn("Use the approved tool");
+          await entered.promise;
+          if (change === "unregister") registry.unregister("Probe");
+          if (change === "replace")
+            registry.register(
+              {
+                ...original,
+                aliases: ["LegacyProbe"],
+                async handler() {
+                  replacementEffects++;
+                  return "replacement";
+                },
+              },
+              { silentDuplicateWarning: true },
+            );
+          if (change === "policy") permitted = false;
+          if (change === "policy-callback")
+            (f.runtime.getToolExecutor() as any).deps.isToolAllowed = () => false;
+          if (change === "mutate-handler")
+            registry.get("Probe")!.handler = async () => {
+              replacementEffects++;
+              return "mutated";
+            };
+          f.runtime.invalidateToolCache();
+          approve.resolve({ decision: "allow" });
+          await running;
+          assert.equal(f.effects, 0, "the formerly approved handler executed after revocation");
+          assert.equal(replacementEffects, 0, "an old approval authorized a new implementation");
+          assert.equal(f.permissionCalls, 1);
+        } finally {
+          approve.resolve({ decision: "deny" });
+          await running?.catch(() => {});
+          await f.close();
+        }
+      }
+    }
+  },
+);
