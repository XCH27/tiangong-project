diff --git a/apps/zcode-cli/packages/core/test/mimo-thinking-replay.test.ts b/apps/zcode-cli/packages/core/test/mimo-thinking-replay.test.ts
new file mode 100644
index 0000000..cd3a5cc
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/mimo-thinking-replay.test.ts
@@ -0,0 +1,364 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { DatabaseSync } from "node:sqlite";
+import { join } from "node:path";
+import { AiSdkModelAdapter } from "../../adapters/src/model/runner.js";
+import { createAnthropicCompatFetch } from "../../adapters/src/model/anthropic-stream-compat.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+
+const baseURL = "https://api.xiaomimimo.com/anthropic";
+const endpoint = `${baseURL}/v1/messages`;
+const thought = "original unsigned MiMo thinking\nwith exact bytes";
+const call = { type: "tool_use", id: "original-call", name: "Probe", input: { value: "once" } };
+const usage = { input_tokens: 11, output_tokens: 3, cache_read_input_tokens: 4 };
+
+function model(transport: typeof fetch) {
+  return new AiSdkModelAdapter({ env: {}, transport, retry: { maxAttempts: 1 } }).createModel({
+    providerId: "fixture",
+    modelId: "model-a",
+    providerConfig: {
+      access: { type: "api-key", apiKey: "synthetic-key" },
+      api: { type: "anthropic-messages", baseUrl: baseURL },
+    } as never,
+    modelConfig: {
+      properties: {
+        contextWindow: 65536,
+        requiresMfjsToolSchema: false,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: false,
+          supportsAudio: false,
+          supportsVideo: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: true,
+      },
+      optionSpecs: {
+        reasoningLevel: { values: ["off"], default: "off", map: "{}" },
+        maxOutputTokens: { max: 256, default: 256, map: "{'max_tokens': maxOutputTokens}" },
+      },
+    } as never,
+    options: { reasoningLevel: "off", maxOutputTokens: 256 },
+  });
+}
+
+function reply(first: boolean) {
+  return {
+    id: "original-response",
+    type: "message",
+    role: "assistant",
+    model: "model-a",
+    content: first
+      ? [{ type: "thinking", thinking: thought }, call]
+      : [{ type: "text", text: "finished" }],
+    stop_reason: first ? "tool_use" : "end_turn",
+    stop_sequence: null,
+    usage,
+  };
+}
+
+function streamReply(first: boolean) {
+  const events: unknown[] = [
+    {
+      type: "message_start",
+      message: {
+        ...reply(first),
+        content: [],
+        stop_reason: null,
+        usage: { ...usage, output_tokens: 0 },
+      },
+    },
+  ];
+  if (first)
+    events.push(
+      { type: "content_block_start", index: 0, content_block: { type: "thinking", thinking: "" } },
+      {
+        type: "content_block_delta",
+        index: 0,
+        delta: { type: "thinking_delta", thinking: thought },
+      },
+      { type: "content_block_stop", index: 0 },
+      { type: "content_block_start", index: 1, content_block: { ...call, input: {} } },
+      {
+        type: "content_block_delta",
+        index: 1,
+        delta: { type: "input_json_delta", partial_json: JSON.stringify(call.input) },
+      },
+      { type: "content_block_stop", index: 1 },
+    );
+  else
+    events.push(
+      { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } },
+      { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "finished" } },
+      { type: "content_block_stop", index: 0 },
+    );
+  events.push(
+    {
+      type: "message_delta",
+      delta: { stop_reason: first ? "tool_use" : "end_turn", stop_sequence: null },
+      usage: { output_tokens: 3 },
+    },
+    { type: "message_stop" },
+  );
+  return new Response(
+    events.map((event: any) => `event: ${event.type}\ndata: ${JSON.stringify(event)}\n\n`).join(""),
+    { headers: { "content-type": "text/event-stream" } },
+  );
+}
+
+test("MiMo JSON and streaming preserve unsigned thinking through Host tools and cold SQLite replay", async () => {
+  const replayBlocks: unknown[] = [];
+  for (const streaming of [false, true]) {
+    const f = await fixture(undefined, streaming);
+    const bodies: any[] = [];
+    const candidate = model(async (raw, init) => {
+      const request = new Request(raw, init);
+      assert.equal(request.url, endpoint);
+      assert.equal(request.headers.get("authorization"), "Bearer synthetic-key");
+      const body = (await request.json()) as any;
+      bodies.push(body);
+      if (bodies.length > 1) {
+        const assistant = body.messages.find((message: any) => message.role === "assistant");
+        const thinking = assistant.content.filter((part: any) => part.type === "thinking");
+        assert.deepEqual(
+          thinking,
+          [{ type: "thinking", thinking: thought, signature: "" }],
+          "Unsigned replay must use the existing empty marker, never an invented signature",
+        );
+        assert.ok(
+          assistant.content.some((part: any) => part.type === "tool_use" && part.id === call.id),
+        );
+        assert.ok(
+          body.messages.some((message: any) =>
+            message.content?.some?.(
+              (part: any) => part.type === "tool_result" && part.tool_use_id === call.id,
+            ),
+          ),
+        );
+        if (bodies.length === 2) replayBlocks.push(thinking);
+      }
+      return body.stream
+        ? streamReply(bodies.length === 1)
+        : Response.json(reply(bodies.length === 1));
+    });
+    try {
+      (f.runtime as any).modelFactory = () => candidate;
+      await f.runtime.executeTurn("One local fixture effect");
+      assert.equal(f.effects, 1);
+      assert.equal(f.permissionCalls, 1);
+      assert.equal(bodies.length, 2);
+      await f.reopen();
+      const stored = await f.store.messages({ sessionID: "session" as never });
+      assert.ok(JSON.stringify(stored).includes(JSON.stringify(thought).slice(1, -1)));
+      const reasoning = stored
+        .flatMap((entry) => entry.parts)
+        .filter((part) => part.type === "reasoning");
+      assert.ok(reasoning.length);
+      for (const part of reasoning) {
+        if (part.type === "reasoning") {
+          const signature = (part.metadata?.anthropic as any)?.signature;
+          assert.ok(signature === undefined || signature === "");
+        }
+      }
+      (f.runtime as any).modelFactory = () =>
+        model(async (raw, init) => {
+          // Reuse the same transport assertions after the execution object itself is recreated.
+          const request = new Request(raw, init);
+          const body = (await request.json()) as any;
+          bodies.push(body);
+          const assistant = body.messages.find((message: any) => message.role === "assistant");
+          assert.deepEqual(
+            assistant.content.filter((part: any) => part.type === "thinking"),
+            [{ type: "thinking", thinking: thought, signature: "" }],
+          );
+          return body.stream ? streamReply(false) : Response.json(reply(false));
+        });
+      await f.runtime.executeTurn("Continue from cold history");
+      assert.equal(bodies.length, 3);
+      assert.equal(f.effects, 1);
+      assert.equal(f.permissionCalls, 1);
+      const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+      try {
+        const rows = db
+          .prepare(
+            "select status,input_tokens,output_tokens,cache_read_input_tokens from model_usage",
+          )
+          .all();
+        assert.equal(rows.length, 3);
+        for (const row of rows) {
+          assert.equal(row.status, "completed");
+          assert.equal(row.input_tokens, 15);
+          assert.equal(row.output_tokens, 3);
+          assert.equal(row.cache_read_input_tokens, 4);
+        }
+      } finally {
+        db.close();
+      }
+    } finally {
+      await f.close();
+    }
+  }
+  assert.equal(replayBlocks.length, 2);
+  assert.deepEqual(replayBlocks[0], replayBlocks[1]);
+});
+
+test("MiMo normalization preserves signed/redacted blocks, completion and usage", async () => {
+  const payload = {
+    ...reply(true),
+    content: [
+      { type: "thinking", thinking: thought },
+      { type: "thinking", thinking: "signed bytes", signature: "original-signature" },
+      { type: "redacted_thinking", data: "original-encrypted" },
+      call,
+    ],
+  };
+  const fetch = createAnthropicCompatFetch(async () =>
+    Response.json(payload, { headers: { "x-request-id": "original" } }),
+  );
+  const response = await fetch(new Request(endpoint));
+  assert.equal(response.status, 200);
+  assert.equal(response.headers.get("x-request-id"), "original");
+  assert.deepEqual(await response.json(), {
+    ...payload,
+    content: [{ ...payload.content[0], signature: "" }, ...payload.content.slice(1)],
+  });
+});
+
+for (const route of [
+  "https://proxy.example/anthropic/v1/messages",
+  "https://sub.api.xiaomimimo.com/anthropic/v1/messages",
+  "http://api.xiaomimimo.com/anthropic/v1/messages",
+  "https://api.xiaomimimo.com:8443/anthropic/v1/messages",
+  `${endpoint}/`,
+  `${endpoint}?custom=1`,
+  `${endpoint}#custom`,
+  "https://user@api.xiaomimimo.com/anthropic/v1/messages",
+  "https://token-plan-cn.xiaomimimo.com/anthropic/v1/messages",
+]) {
+  test(`unsigned JSON sanitization remains unchanged at ${route}`, async () => {
+    const payload = reply(true);
+    const response = await createAnthropicCompatFetch(async () => Response.json(payload))(route);
+    assert.deepEqual(await response.json(), { ...payload, content: [call] });
+  });
+}
+
+for (const failure of ["signature", "thinking", "completion", "provider-error"] as const) {
+  test(`MiMo ${failure} failure cannot admit a Host effect or manufacture completion`, async () => {
+    const f = await fixture();
+    let requests = 0;
+    let observed: unknown;
+    const candidate = model(async () => {
+      requests++;
+      if (failure === "provider-error")
+        return Response.json(
+          {
+            type: "error",
+            error: {
+              type: "invalid_request_error",
+              message: "original MiMo denial",
+            },
+          },
+          { status: 400 },
+        );
+      const payload: any = reply(true);
+      if (failure === "signature") payload.content[0].signature = 42;
+      if (failure === "thinking") payload.content[0].thinking = 42;
+      if (failure === "completion") delete payload.stop_reason;
+      return Response.json(payload);
+    });
+    try {
+      (f.runtime as any).modelFactory = () => candidate;
+      await f.runtime.executeTurn("Reject malformed provider content").catch((error) => {
+        observed = error;
+      });
+      assert.ok(observed);
+      assert.equal(requests, 1);
+      assert.equal(f.effects, 0);
+      assert.equal(f.permissionCalls, 0);
+      if (failure === "provider-error")
+        assert.ok(JSON.stringify(observed).includes("original MiMo denial"));
+      const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+      try {
+        assert.notEqual(
+          db.prepare("select status from model_usage limit 1").get()!.status,
+          "completed",
+        );
+      } finally {
+        db.close();
+      }
+      await f.reopen();
+      assert.equal(f.effects, 0);
+      assert.equal(requests, 1);
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("Stop still aborts the unfinished MiMo SSE without a tool effect or completed usage", async () => {
+  const f = await fixture(undefined, true);
+  const started = Promise.withResolvers<void>();
+  let requests = 0;
+  let aborted = false;
+  const candidate = model(async (raw, init) => {
+    requests++;
+    const request = new Request(raw, init);
+    const body = new ReadableStream<Uint8Array>({
+      start(controller) {
+        const encoder = new TextEncoder();
+        controller.enqueue(
+          encoder.encode(
+            `event: message_start\ndata: ${JSON.stringify({
+              type: "message_start",
+              message: {
+                ...reply(true),
+                content: [],
+                stop_reason: null,
+                usage: { ...usage, output_tokens: 0 },
+              },
+            })}\n\n`,
+          ),
+        );
+        request.signal.addEventListener(
+          "abort",
+          () => {
+            aborted = true;
+            controller.error(new DOMException("Stopped", "AbortError"));
+          },
+          { once: true },
+        );
+        started.resolve();
+      },
+    });
+    return new Response(body, { headers: { "content-type": "text/event-stream" } });
+  });
+  let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+  try {
+    (f.runtime as any).modelFactory = () => candidate;
+    running = f.runtime.executeTurn("Stop unfinished MiMo generation");
+    await started.promise;
+    f.runtime.stopActiveForegroundExecution();
+    await running.catch(() => {});
+    assert.equal(aborted, true);
+    assert.equal(requests, 1);
+    assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 0);
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try {
+      assert.notEqual(
+        db.prepare("select status from model_usage limit 1").get()!.status,
+        "completed",
+      );
+    } finally {
+      db.close();
+    }
+  } finally {
+    f.runtime.stopActiveForegroundExecution();
+    await running?.catch(() => {});
+    await f.close();
+  }
+});
