+test("SiliconFlow keeps all IDs and classifies from authenticated query membership before atomic publication", async () => {
+  const f = await fixture();
+  try {
+    const { providerId } = await f.service.createPersonalProvider({
+      templateId: "fleet-siliconflow",
+      initialConfig: { access: { type: "api-key", apiKey: "synthetic" } },
+    });
+    const groups = new Map([
+      ["", ["chat", "chat-looking-embedding", "speech", "image", "video", "hybrid"]],
+      ["?sub_type=chat", ["chat", "hybrid"]],
+      ["?type=image", ["image", "hybrid"]],
+      ["?type=video", ["video"]],
+    ]);
+    const visited: string[] = [];
+    f.setFetch(async (input, init) => {
+      const url = new URL(String(input));
+      assert.equal(url.origin, "https://api.siliconflow.cn");
+      assert.equal(url.pathname, "/v1/models");
+      assert.equal(new Headers(init?.headers).get("authorization"), "Bearer synthetic");
+      visited.push(url.search);
+      assert.ok(groups.has(url.search));
+      return Response.json({ data: groups.get(url.search)!.map((id) => ({ id })) });
+    });
+    await f.service.discoverModels(providerId);
+    assert.deepEqual(visited, [...groups.keys()]);
+    await f.restart();
+    const view = (await f.service.getView()).providers.find((p) => p.providerId === providerId)!;
+    assert.equal(view.models.length, 6);
+    assert.deepEqual(view.models.filter((m) => m.selectable).map((m) => m.modelId), ["chat", "hybrid"]);
+    assert.equal(view.models.find((m) => m.modelId === "image")?.evidenceConfig.properties?.outputFormat?.supportsImage, true);
+    assert.equal(view.models.find((m) => m.modelId === "video")?.evidenceConfig.properties?.outputFormat?.supportsVideo, true);
+    const before = await f.disk();
+    f.setFetch(async (input) => {
+      const url = new URL(String(input));
+      if (url.search === "?type=video") return new Response("unavailable", { status: 503 });
+      return Response.json({ data: groups.get(url.search)!.map((id) => ({ id })) });
+    });
+    await assert.rejects(f.service.discoverModels(providerId), /503/);
+    assert.equal(await f.disk(), before, "A failed class directory published partial data");
+    f.setFetch(async (input) => {
+      const url = new URL(String(input));
+      const ids = url.search === "?type=video" ? ["not-in-full-directory"] : groups.get(url.search)!;
+      return Response.json({ data: ids.map((id) => ({ id })) });
+    });
+    await assert.rejects(f.service.discoverModels(providerId), /conflicting/);
+    assert.equal(await f.disk(), before);
+  } finally {
+    await f.dispose();
+  }
+});
