+/** SiliconFlow's ID-only directory needs authenticated class queries; names are not capability evidence. */
+export async function discoverSiliconFlowModels(
+  origin: string,
+  headers: Headers,
+  fetch: typeof globalThis.fetch,
+): Promise<ModelDiscoveryResult> {
+  const deadline = AbortSignal.timeout(20_000);
+  const groups: Map<string, DiscoveredModel>[] = [];
+  for (const query of ["", "sub_type=chat", "type=image", "type=video"]) {
+    const url = new URL(`${origin}/v1/models`);
+    url.search = query;
+    const response = await fetch(url, { headers, signal: deadline, redirect: "error" });
+    if (!response.ok) {
+      await response.body?.cancel();
+      throw new Error(`Model list request failed (${response.status})`);
+    }
+    const body = (await readModelListPage(response)) as { data?: unknown; has_more?: unknown };
+    if (!body || !Array.isArray(body.data) || body.has_more)
+      throw new Error("SiliconFlow returned an incomplete or unsupported model directory");
+    const models = new Map<string, DiscoveredModel>();
+    for (const item of body.data) {
+      if (!item || typeof item !== "object" || typeof item.id !== "string" ||
+          !item.id.trim() || item.id !== item.id.trim() || models.has(item.id))
+        throw new Error("SiliconFlow returned duplicate or invalid model IDs");
+      models.set(item.id, {
+        id: item.id,
+        name: typeof item.name === "string" ? item.name : item.id,
+        config: readDiscoveredModelMetadata(item),
+      });
+      if (models.size > MAX_MODEL_LIST_ENTRIES)
+        throw new Error("SiliconFlow model directory exceeds its entry limit");
+    }
+    groups.push(models);
+  }
+  const [all, chat, image, video] = groups;
+  for (const group of groups.slice(1)) {
+    for (const id of group.keys()) {
+      if (!all!.has(id)) throw new Error("SiliconFlow returned conflicting model directories");
+    }
+  }
+  return {
+    source: "provider",
+    models: [...all!.values()].map((model) => ({
+      ...model,
+      config: {
+        ...model.config,
+        properties: {
+          ...model.config.properties,
+          outputFormat: {
+            supportsText: chat!.has(model.id),
+            supportsImage: image!.has(model.id),
+            supportsVideo: video!.has(model.id),
+          },
+        },
+      },
+    })),
+  };
+}
