+
+test("Laya auto keeps its classifier protocol and does not borrow a same-name chat model's catalog facts", async () => {
+  const f = await fixture();
+  try {
+    const result = await f.facade().saveDecisionSource(await f.input());
+    const model = result
+      .view!.providers.find((provider) => provider.providerId === result.providerId)!
+      .models.find((entry) => entry.modelId === "auto")!;
+    assert.equal(model.evidenceConfig?.properties?.contextWindow, undefined);
+    assert.notEqual(model.evidenceConfig?.properties?.inputFormat?.supportsImage, true);
+    assert.notEqual(model.evidenceConfig?.properties?.outputFormat?.supportsText, true);
+    assert.equal(model.effectiveConfig.properties?.inputFormat?.supportsImage, false);
+    assert.equal(model.effectiveConfig.properties?.outputFormat?.supportsText, false);
+    assert.equal(model.effectiveConfig.properties?.outputFormat?.supportsClassification, true);
+    assert.notEqual(model.effectiveConfig.properties?.outputFormat?.supportsImage, true);
+    assert.equal(model.executable, false);
+  } finally {
+    await f.close();
+  }
+});
