+test("a format-only save persists immediately without replacing credentials, headers or other settings", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-format-save-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  const runtime = createProviderConfigRuntime(options);
+  const reopened = createProviderConfigRuntime(options);
+  try {
+    await runtime.start();
+    const config = {
+      api: {
+        type: "anthropic-messages" as const,
+        baseUrl: "https://fixture.example",
+        headers: { "X-Route": "preserve" },
+      },
+      access: {
+        type: "api-key" as const,
+        apiKey: "stored-fixture-key",
+        additionalApiKeys: ["backup-fixture-key"],
+        autoSwitchCredentials: true,
+      },
+    };
+    const { providerId } = await runtime.configService.createPersonalProvider({
+      providerName: "Fixture",
+      initialConfig: parseProviderConfig(config),
+    });
+    const provider: ProviderSettingsFormProvider = {
+      providerId,
+      providerName: "Fixture",
+      templateId: null,
+      enabled: true,
+      executable: false,
+      hasPersonalConfig: true,
+      personalConfig: config,
+      config,
+      models: [],
+    };
+    const original = JSON.stringify(provider);
+    const next = resolveProviderProtocolSave({
+      provider,
+      apiFormat: "openai-chat-completions",
+      baseUrlValue: config.api.baseUrl,
+    })!;
+    await runtime.configService.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig(next.personalConfig),
+    );
+    await reopened.start();
+    const saved = (await reopened.configService.read()).personalProviders.get(providerId)!.toJSON();
+    assert.equal(saved.api?.type, "openai-chat-completions");
+    assert.equal(saved.api?.baseUrl, config.api.baseUrl);
+    assert.deepEqual(saved.api?.headers, config.api.headers);
+    assert.deepEqual(saved.access, config.access);
+    assert.equal(next.providerNameUpdate, undefined);
+    assert.equal(JSON.stringify(provider), original, "accepted form data remains immutable");
+    assert.equal(
+      resolveProviderProtocolSave({
+        provider: next,
+        apiFormat: "openai-chat-completions",
+        baseUrlValue: config.api.baseUrl,
+      }),
+      null,
+    );
+    for (const baseUrlValue of [
+      "",
+      "https://",
+      "file:///tmp/model",
+      "https://user:pass@example.com",
+    ]) {
+      assert.throws(
+        () =>
+          resolveProviderProtocolSave({
+            provider,
+            apiFormat: "openai-chat-completions",
+            baseUrlValue,
+          }),
+        /API address/,
+      );
+    }
+  } finally {
+    runtime.dispose();
+    reopened.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
