+/** 格式点击只保存协议和地址，不能夹带未完成的密钥、名称或开关草稿。 */
+export function resolveProviderProtocolSave({
+  provider,
+  apiFormat,
+  baseUrlValue,
+}: {
+  provider: ProviderSettingsFormProvider;
+  apiFormat: ProviderApiType;
+  baseUrlValue: string;
+}): ProviderSettingsFormProvider | null {
+  const route = selectProviderProtocolRoute(apiFormat, baseUrlValue, provider.templateApiRoutes);
+  if (!isValidProviderBaseUrl(route.baseUrl)) throw new Error("Invalid API address");
+  return resolvePendingProviderDraftSave({
+    provider,
+    draft: {
+      nameValue: getProviderFormLabel(provider),
+      apiFormat: route.type,
+      baseUrlValue: route.baseUrl,
+      apiKeyValue: isApiKeyAccess(provider.config.access)
+        ? (provider.config.access.apiKey ?? "")
+        : "",
+    },
+    now: Date.now,
+  });
+}
