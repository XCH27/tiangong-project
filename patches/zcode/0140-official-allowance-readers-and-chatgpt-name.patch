@@ -0,0 +1,91 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  claudeKeychainService,
+  oauthUsageToControlResponse,
+  parseClaudeCredentialToken,
+  readClaudeOAuthToken,
+  readClaudeOAuthUsage,
+} from "../../../apps/zcode-cli/packages/adapters/src/native-agent/claude-oauth-usage.js";
+import { parseClaudeNativeUsage } from "../src/model-provider/nativeCliUsage.js";
+
+test("keychain service matches Claude Code's default and config-dir scoped names", () => {
+  assert.equal(claudeKeychainService(), "Claude Code-credentials");
+  assert.match(claudeKeychainService("/tmp/claude-profile"), /^Claude Code-credentials-[0-9a-f]{8}$/);
+  assert.notEqual(claudeKeychainService("/a"), claudeKeychainService("/b"));
+});
+
+test("credential parsing accepts a live token and leaves expired tokens to the official CLI", () => {
+  const live = JSON.stringify({ claudeAiOauth: { accessToken: "fixture-live", expiresAt: Date.now() + 60_000 } });
+  const expired = JSON.stringify({ claudeAiOauth: { accessToken: "fixture-old", expiresAt: Date.now() - 1 } });
+  assert.equal(parseClaudeCredentialToken(live), "fixture-live");
+  assert.equal(parseClaudeCredentialToken(expired), undefined);
+  assert.equal(parseClaudeCredentialToken("not json"), undefined);
+  assert.equal(parseClaudeCredentialToken(JSON.stringify({ claudeAiOauth: {} })), undefined);
+});
+
+test("token lookup prefers the scoped keychain on macOS and falls back to the config-dir file elsewhere", async () => {
+  const seen: string[] = [];
+  const fromKeychain = await readClaudeOAuthToken("/tmp/p", "darwin", {
+    keychain: async (service) => {
+      seen.push(service);
+      return JSON.stringify({ claudeAiOauth: { accessToken: "fixture-keychain" } });
+    },
+    read: async () => {
+      throw new Error("file must not be read when the keychain answers");
+    },
+  });
+  assert.equal(fromKeychain, "fixture-keychain");
+  assert.deepEqual(seen, [claudeKeychainService("/tmp/p")]);
+  const fromFile = await readClaudeOAuthToken("/tmp/p", "linux", {
+    keychain: async () => {
+      throw new Error("keychain is macOS only");
+    },
+    read: async (path) => {
+      assert.equal(path, "/tmp/p/.credentials.json");
+      return JSON.stringify({ claudeAiOauth: { accessToken: "fixture-file" } });
+    },
+  });
+  assert.equal(fromFile, "fixture-file");
+});
+
+test("oauth/usage maps into the existing SDK usage contract, including model-scoped weekly limits", async () => {
+  let request: { url: string; headers: Headers } | undefined;
+  const response = await readClaudeOAuthUsage({
+    token: "fixture-token",
+    fetch: async (url, init) => {
+      request = { url: String(url), headers: new Headers(init?.headers) };
+      return Response.json({
+        five_hour: { utilization: 12, resets_at: "2026-10-05T23:00:00Z" },
+        seven_day: { utilization: 40, resets_at: "2026-10-09T00:00:00Z" },
+        limits: [
+          { kind: "weekly_scoped", percent: 7, resets_at: "2026-10-09T00:00:00Z", scope: { model: { display_name: "Opus" } } },
+          { kind: "other", percent: 99 },
+        ],
+      });
+    },
+  });
