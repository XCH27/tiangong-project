diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/claude-oauth-usage.ts b/apps/zcode-cli/packages/adapters/src/native-agent/claude-oauth-usage.ts
new file mode 100644
index 0000000..da3528a
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/claude-oauth-usage.ts
@@ -0,0 +1,120 @@
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { SDKControlGetUsageResponse } from "@anthropic-ai/claude-agent-sdk";
+
+const OAUTH_USAGE_URL = "https://api.anthropic.com/api/oauth/usage";
+const KEYCHAIN_SERVICE = "Claude Code-credentials";
+
+/**
+ * 修复：SDK 的 get_usage 是实验接口，订阅账号经常返回空额度，界面只能显示"未返回额度数据"。
+ * 参考 Orca rate-limits/claude-oauth-credentials.ts 与 Paseo claude-usage-source：
+ * 读取官方 Claude CLI 自己保存的登录（同一 CLAUDE_CONFIG_DIR），调用官方 oauth/usage 只读接口。
+ * 令牌只在内存中使用一次，不复制、不持久化、不刷新；刷新仍由官方 CLI 负责。
+ */
+export function claudeKeychainService(configDir?: string): string {
+  if (!configDir) return KEYCHAIN_SERVICE;
+  // Claude Code 对自定义配置目录使用 sha256(NFC(dir)) 前 8 位作为钥匙串后缀。
+  const suffix = createHash("sha256").update(configDir.normalize("NFC")).digest("hex").slice(0, 8);
+  return `${KEYCHAIN_SERVICE}-${suffix}`;
+}
+
+export function parseClaudeCredentialToken(raw: string): string | undefined {
+  try {
+    const oauth = (JSON.parse(raw) as { claudeAiOauth?: { accessToken?: unknown; expiresAt?: unknown } })
+      ?.claudeAiOauth;
+    if (typeof oauth?.accessToken !== "string" || !oauth.accessToken.trim()) return undefined;
+    // 已过期的令牌交给官方 CLI 刷新，这里不发请求。
+    if (typeof oauth.expiresAt === "number" && oauth.expiresAt <= Date.now()) return undefined;
+    return oauth.accessToken;
+  } catch {
+    return undefined;
+  }
+}
+
+function readKeychain(service: string): Promise<string | undefined> {
+  return new Promise((resolve) => {
+    execFile(
+      "security",
+      ["find-generic-password", "-s", service, "-w"],
+      { timeout: 5000 },
+      (error, stdout) => resolve(error ? undefined : stdout.trim() || undefined),
+    );
+  });
+}
+
+export async function readClaudeOAuthToken(
+  configDir?: string,
+  platform = process.platform,
+  deps: { keychain?: typeof readKeychain; read?: (path: string) => Promise<string> } = {},
+): Promise<string | undefined> {
+  if (platform === "darwin") {
+    const fromKeychain = await (deps.keychain ?? readKeychain)(claudeKeychainService(configDir));
+    const token = fromKeychain ? parseClaudeCredentialToken(fromKeychain) : undefined;
+    if (token) return token;
+  }
+  const file = join(configDir ?? join(homedir(), ".claude"), ".credentials.json");
+  const raw = await (deps.read ?? ((path) => readFile(path, "utf8")))(file).catch(() => undefined);
+  return raw ? parseClaudeCredentialToken(raw) : undefined;
+}
+
+type UsageRow = { utilization?: unknown; resets_at?: unknown };
+interface OAuthUsageResponse {
+  five_hour?: UsageRow;
+  seven_day?: UsageRow;
+  seven_day_opus?: UsageRow;
+  seven_day_sonnet?: UsageRow;
+  seven_day_oauth_apps?: UsageRow;
+  limits?: { kind?: unknown; percent?: unknown; resets_at?: unknown; scope?: { model?: { display_name?: unknown } | null } | null }[] | null;
+}
+
+/** 把 oauth/usage 响应转换成与 SDK get_usage 相同的形态，复用既有解析与展示。 */
+export function oauthUsageToControlResponse(data: OAuthUsageResponse): SDKControlGetUsageResponse | undefined {
+  const scoped = Array.isArray(data.limits)
+    ? data.limits
+        .filter((limit) => limit?.kind === "weekly_scoped" && typeof limit.scope?.model?.display_name === "string")
+        .map((limit) => ({
+          display_name: limit.scope!.model!.display_name as string,
+          utilization: limit.percent,
+          resets_at: limit.resets_at,
+        }))
+    : [];
+  const rateLimits = {
+    five_hour: data.five_hour,
+    seven_day: data.seven_day,
+    seven_day_opus: data.seven_day_opus,
+    seven_day_sonnet: data.seven_day_sonnet,
+    seven_day_oauth_apps: data.seven_day_oauth_apps,
+    ...(scoped.length ? { model_scoped: scoped } : {}),
+  };
+  if (!Object.values(rateLimits).some((value) => value !== undefined && value !== null)) return undefined;
+  return { rate_limits_available: true, rate_limits: rateLimits } as unknown as SDKControlGetUsageResponse;
+}
+
+/** fetch 由宿主注入（沿用宿主的代理/证书网络所有者），本模块不自带网络栈。 */
+export async function readClaudeOAuthUsage(options: {
+  configDir?: string;
+  fetch: typeof fetch;
+  token?: string;
+}): Promise<SDKControlGetUsageResponse | undefined> {
+  const token = options.token ?? (await readClaudeOAuthToken(options.configDir));
+  if (!token) return undefined;
+  const response = await options.fetch(OAUTH_USAGE_URL, {
+    method: "GET",
+    redirect: "error",
+    signal: AbortSignal.timeout(10_000),
+    headers: {
+      Accept: "application/json",
+      Authorization: `Bearer ${token}`,
+      "anthropic-beta": "oauth-2025-04-20",
+    },
+  }).catch(() => undefined);
+  if (!response?.ok) {
+    await response?.body?.cancel();
+    return undefined;
+  }
+  const data = (await response.json().catch(() => undefined)) as OAuthUsageResponse | undefined;
+  return data && typeof data === "object" ? oauthUsageToControlResponse(data) : undefined;
+}
