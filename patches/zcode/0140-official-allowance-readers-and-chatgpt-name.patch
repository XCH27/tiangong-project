+  assert.equal(request?.headers.get("authorization"), "Bearer fixture-token");
+  assert.equal(request?.headers.get("anthropic-beta"), "oauth-2025-04-20");
+  const parsed = parseClaudeNativeUsage(response, 1);
+  assert.equal(parsed.status, "available");
+  if (parsed.status === "available")
+    assert.deepEqual(
+      parsed.windows.map((window) => [window.id, window.usedPercent]),
+      [
+        ["default:five_hour", 12],
+        ["default:seven_day", 40],
+        ["Opus:seven_day", 7],
+      ],
+    );
+});
+
