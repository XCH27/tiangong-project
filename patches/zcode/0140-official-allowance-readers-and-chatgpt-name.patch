+test("Grok legacy billing falls back to monthly limit/used as Grok Build billing.rs prescribes", () => {
+  const legacy = parseSubscriptionUsage(
+    "xai",
+    {
+      config: {
+        creditUsagePercent: null,
+        monthlyLimit: { val: 2000 },
+        used: { val: "500" },
+        billingPeriodStart: "2026-10-01T00:00:00Z",
+        billingPeriodEnd: "2026-10-31T00:00:00Z",
+      },
+    },
+    99,
+  );
+  assert.equal(legacy.status, "available");
+  if (legacy.status === "available")
+    assert.deepEqual(legacy.windows, [
+      {
+        id: "credits",
+        usedPercent: 25,
+        resetAt: Date.parse("2026-10-31T00:00:00Z"),
+        windowMinutes: 30 * 24 * 60,
+      },
+    ]);
+  // 平铺响应（无 config 包裹）与包裹形态同样解析。
+  const flat = parseSubscriptionUsage("xai", { creditUsagePercent: 12 }, 99);
+  assert.equal(flat.status, "available");
+  if (flat.status === "available") assert.equal(flat.windows[0]?.usedPercent, 12);
+  // proto3 省略零值：已确认的本周周期且无显式 0 金额时为 0%。
+  const week = {
+    currentPeriod: { type: "USAGE_PERIOD_TYPE_WEEKLY", start: "2026-10-05T00:00:00Z", end: "2026-10-12T00:00:00Z" },
+    billingPeriodStart: "2026-10-05T00:00:00Z",
+    billingPeriodEnd: "2026-10-12T00:00:00Z",
+  };
+  const unused = parseSubscriptionUsage("xai", { config: week }, 99);
+  assert.equal(unused.status, "available");
+  if (unused.status === "available") assert.equal(unused.windows[0]?.usedPercent, 0);
+  assert.deepEqual(
+    parseSubscriptionUsage("xai", { config: { ...week, billingPeriodEnd: "2026-10-13T00:00:00Z" } }, 99),
+    { status: "unavailable" },
+  );
+  assert.deepEqual(
+    parseSubscriptionUsage("xai", { config: { ...week, prepaidBalance: { val: 0 } } }, 99),
+    { status: "unavailable" },
+  );
+  // 实测统一计费账号形态：onDemandCap/onDemandUsed/prepaidBalance 显式为 0，百分比被省略 → 0%。
+  const unified = parseSubscriptionUsage(
+    "xai",
+    {
+      config: {
+        ...week,
+        isUnifiedBillingUser: true,
+        onDemandCap: { val: "0" },
+        onDemandUsed: { val: "0" },
+        prepaidBalance: { val: "0" },
+      },
+    },
+    99,
+  );
+  assert.equal(unified.status, "available");
+  if (unified.status === "available") assert.equal(unified.windows[0]?.usedPercent, 0);
+  // 按需已产生用量但百分比缺失：不能显示为 0%。
+  assert.deepEqual(
+    parseSubscriptionUsage(
+      "xai",
+      { config: { ...week, onDemandCap: { val: "0" }, onDemandUsed: { val: "150" } } },
+      99,
+    ),
+    { status: "unavailable" },
+  );
+  // 零额度或缺失分母不能伪造 0% 或 NaN。
+  for (const config of [
+    { monthlyLimit: { val: 0 }, used: { val: 1 } },
+    { monthlyLimit: { val: 100 } },
+    { used: { val: 3 } },
+  ])
+    assert.deepEqual(parseSubscriptionUsage("xai", { config }, 99), { status: "unavailable" });
+});
