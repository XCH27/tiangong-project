new file mode 100644
index 0000000..7c2a1cb
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/decision-operation.ts
@@ -0,0 +1,166 @@
+import type { DecisionInput } from "@zcode/shared";
+import type {
+  SessionId,
+  TurnId,
+  TraceId,
+  DecisionModelPort,
+  DecisionModelResult,
+  ModelSelection,
+  ModelUsageRecord,
+  ModelRequestAdmission,
+  SessionStorePort,
+  ToolArtifactStorePort,
+  UsageStorePort,
+  TraceContext,
+  Logger,
+} from "@zcode/contracts";
+import { retainPendingModelUsage } from "./methods/usage-recovery.js";
+
+/** One prepared Host operation; callers retain their distinct approval and outcome policies. */
+export async function executeDecisionOperation(input: {
+  port: DecisionModelPort;
+  request: DecisionInput;
+  prepared: Awaited<ReturnType<DecisionModelPort["prepare"]>>;
+  id: string;
+  sessionId: SessionId;
+  toolCallId: string;
+  turnId?: TurnId;
+  traceId?: TraceId;
+  trace?: TraceContext;
+  signal: AbortSignal;
+  workspacePath?: string;
+  offered?: ModelSelection;
+  artifactStore?: ToolArtifactStorePort;
+  sessionStore?: SessionStorePort;
+  admission?: ModelRequestAdmission;
+  logger?: Logger;
+}): Promise<{
+  result: DecisionModelResult;
+  receiptUri: string;
+  usageRecorded: boolean;
+  usageRecoveryPending: boolean;
+}> {
+  const { port, prepared, id, signal } = input;
+  const artifacts = input.artifactStore;
+  const usage = input.sessionStore as Partial<UsageStorePort> | undefined;
+  if (
+    !artifacts?.writeToolResultArtifactOnce ||
+    !usage?.recordModelUsage ||
+    !input.sessionStore?.saveSessionEntry
+  )
+    throw new Error(
+      "Decision receipt/accounting recovery storage is unavailable; no inference was made",
+    );
+  const startedAt = Date.now();
+  const artifact = (suffix: string, content: unknown) =>
+    artifacts.writeToolResultArtifactOnce!({
+      sessionId: input.sessionId,
+      toolCallId: input.toolCallId,
+      toolName: "DecisionReceipt",
+      idempotencyKey: `${id}:${suffix}`,
+      content: JSON.stringify(content),
+      contentType: "application/json",
+      retention: "session",
+      trace: input.trace,
+    });
+  const claim = await artifact("intent", {
+    version: 1,
+    status: "unknown",
+    id,
+    model: prepared.model,
+    ...(input.offered ? { offered: input.offered } : {}),
+    inputDigest: prepared.inputDigest,
+    startedAt,
+  });
+  if (!claim.created)
+    throw new Error(
+      `Decision inference may already exist. Receipt ${claim.uri}; do not repeat it automatically`,
+    );
+  let result: DecisionModelResult;
+  try {
+    result = await port.classify({
+      ...input.request,
+      binding: prepared.binding,
+      signal,
+      admission: input.admission,
+      trace: input.trace,
+    });
+  } catch {
+    result = {
+      status: signal.aborted ? "cancelled" : "error",
+      requestedModel: prepared.model,
+      inputDigest: prepared.inputDigest,
+      answers: {},
+      message: "Decision binding is unavailable; no replacement model was used",
+    };
+  }
+  const completedAt = Date.now();
+  const record: ModelUsageRecord = {
+    id,
+    logicalRequestId: id,
+    sessionID: input.sessionId,
+    turnID: input.turnId,
+    traceID: input.traceId,
+    querySource: "decision_classification",
+    providerId: result.requestedModel.providerId,
+    modelId: result.requestedModel.modelId,
+    startedAt,
+    completedAt,
+    status:
+      result.status === "completed"
+        ? "completed"
+        : result.status === "cancelled"
+          ? "cancelled"
+          : "error",
+    inputTokens: result.usage?.inputTokens,
+    outputTokens: result.usage?.outputTokens,
+    reasoningTokens: result.usage?.reasoningTokens,
+    cacheCreationInputTokens: result.usage?.cacheWriteTokens,
+    cacheReadInputTokens: result.usage?.cacheReadTokens,
+    providerTotalTokens: result.usage?.totalTokens,
+    rawUsage: result.usage,
+    errorMessage: result.message,
+    providerMetadata: {
+      operation: "classifier",
+      reportedModelId: result.reportedModelId,
+      inputDigest: result.inputDigest,
+      fleetAccounting: {
+        billingProvider: result.billingProvider,
+        workspacePath: input.workspacePath,
+        reportedRequestUsd: result.reportedCostUsd,
+      },
+    },
+  };
+  let usageRecorded = true;
+  let usageRecoveryPending = false;
+  try {
+    await usage.recordModelUsage!(record);
+  } catch {
+    usageRecorded = false;
+    // 复用已有 Session 恢复指令；已提交但回执丢失也按原始 ID 对账，绝不重发推理。
+    try {
+      await retainPendingModelUsage(
+        { sessionId: input.sessionId, sessionStore: input.sessionStore },
+        record,
+      );
+      usageRecoveryPending = true;
+    } catch (error) {
+      input.logger?.warn("Decision usage recovery instruction unavailable", {
+        event: "usage.model.recovery.failed",
+        module: "core.runtime",
+        receiptId: id,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  const receipt = await artifact("result", {
+    version: 1,
+    id,
+    startedAt,
+    completedAt,
+    ...result,
+    usageRecorded,
+    usageRecoveryPending,
+  });
+  return { result, receiptUri: receipt.uri, usageRecorded, usageRecoveryPending };
+}
