+    const runtime = f.runtime as any;
+    const trace = runtime.rootTraceContext;
+    const context = {
+      sessionId: "session",
+      toolCallId: "frozen-decision",
+      turnId: "turn",
+      traceId: trace.traceId,
+      traceContext: trace,
+      abortSignal: new AbortController().signal,
+      artifactStore: runtime.artifactStore,
+      sessionStore: f.store,
+      workspaceRoot: f.dir,
+    } as any;
+    const write = f.store.recordModelUsage.bind(f.store);
+    const journal = f.store.saveSessionEntry.bind(f.store);
+    let frozen: any;
+    f.store.recordModelUsage = async (record) => {
+      if (record.querySource !== "decision_classification") return write(record);
+      frozen ??= structuredClone(record);
+      if (failure === "committed-ack") await write(record);
+      throw new Error("Synthetic ledger failure");
+    };
+    if (failure === "journal-unavailable")
+      f.store.saveSessionEntry = async (entry) => {
+        if (entry.type === "runtime/pending_model_usage")
+          throw new Error("Synthetic journal unavailable");
+        return journal(entry);
+      };
+    const rows = () => {
+      const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+      try {
+        return db
+          .prepare("select * from model_usage where query_source='decision_classification'")
+          .all();
+      } finally {
+        db.close();
+      }
+    };
+    try {
+      f.steps.push(() => reply("Synthetic Session ready"));
+      await f.runtime.executeTurn("Create synthetic Session");
+      const prepared = (
+        (await tool.resolveInput!(evidence, { abortSignal: context.abortSignal } as never)) as any
+      ).input;
+      const result = (await tool.handler(prepared, context)) as any;
+      assert.deepEqual(result.usage, usage);
+      assert.equal(result.usageRecorded, false);
+      assert.equal(result.usageRecoveryPending, failure !== "journal-unavailable");
+      const pending = await f.store.sessionEntries({
+        sessionID: "session" as never,
+        type: "runtime/pending_model_usage",
+      });
+      assert.equal(pending.length, failure === "journal-unavailable" ? 0 : 1);
+      if (pending.length)
+        assert.deepEqual(pending[0]!.data, { record: JSON.parse(JSON.stringify(frozen)) });
+      await f.reopen();
+      context.sessionStore = f.store;
+      assert.equal(rows().length, failure === "journal-unavailable" ? 0 : 1);
+      if (failure !== "journal-unavailable") {
+        const row = rows()[0]!;
+        assert.equal(row.id, frozen.id);
+        assert.equal(row.started_at, frozen.startedAt);
+        assert.equal(row.completed_at, frozen.completedAt);
+        assert.deepEqual(JSON.parse(String(row.raw_usage_json)), usage);
+      }
+      await assert.rejects(tool.handler(prepared, context), /already exist/);
+      assert.equal(p.calls, 1);
+      await f.reopen();
+      assert.equal(rows().length, failure === "journal-unavailable" ? 0 : 1);
+    } finally {
+      await f.close();
+    }
+  });
+}
