+});
+
+test("official TypeSafe models envelope maps exact names, keeps version pins and survives reopen", async () => {
+  const f = await fixture();
+  try {
+    const { providerId } = await f.service.createPersonalProvider({ templateId: "fleet-typesafe-system-one", initialConfig: { access: { type: "api-key", apiKey: "synthetic-typesafe" } } });
+    const requests: string[] = [];
+    f.setFetch(async (input, init) => {
+      requests.push(String(input));
+      assert.equal(init?.method ?? "GET", "GET");
+      assert.equal(new Headers(init?.headers).get("Authorization"), "Bearer synthetic-typesafe");
+      return Response.json({ models: [{ name: "jev-latest", release_date: "2026-01-01", description: "Fixture alias" }] });
+    });
+    await f.service.discoverModels(providerId);
+    assert.deepEqual(requests, ["https://api.typesafe.ai/v1/models"]);
+    await f.restart();
+    const provider = (await f.service.getView()).providers.find((entry) => entry.providerId === providerId)!;
+    assert.ok(provider.models.some((model) => model.modelId === "jev-1.13.0"), "The accepted version pin was retired by the alias directory");
+    const alias = provider.models.find((model) => model.modelId === "jev-latest")!;
+    assert.equal(alias.effectiveConfig.properties?.outputFormat?.supportsClassification, true);
+    assert.equal(alias.executable, false);
+    assert.equal(alias.evidenceConfig?.properties?.contextWindow, undefined);
+    const before = await f.disk();
+    for (const body of [{ models: [{ name: " " }] }, { models: [{ name: "jev-latest" }, { name: "jev-latest" }] }, { data: [{ id: "wrong-envelope" }] }]) {
+      f.setFetch(async () => Response.json(body));
+      await assert.rejects(f.service.discoverModels(providerId), /invalid model name|duplicate model IDs|unsupported model list/);
+      assert.equal(await f.disk(), before);
+    }
+  } finally { await f.dispose(); }
+});
