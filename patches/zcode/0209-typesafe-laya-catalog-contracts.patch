+  for (const apiKey of ["", "synthetic-key"]) {
+    const blocked = modelDiscoveryBlockReason({ api: { type: "typesafe-system-one", baseUrl: "http://127.0.0.1:8000/v1" }, access: { type: "api-key", apiKey } }, false, "fleet-laya-local");
