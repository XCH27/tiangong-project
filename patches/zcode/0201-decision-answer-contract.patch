+    if (value !== undefined) usage[key] = value;
+  }
+  const serverToolUse = Object.fromEntries(
+    ["webSearchRequests", "webFetchRequests"].flatMap((key) => {
+      const value = observedTokenCount(
+        response.usage?.serverToolUse?.[key as "webSearchRequests" | "webFetchRequests"],
+      );
+      return value === undefined ? [] : [[key, value]];
+    }),
+  );
+  if (Object.keys(serverToolUse).length) usage.serverToolUse = serverToolUse;
+  return {
+    ...reportedFacts({
+      model: response.providerMetadata?.nativeModelId,
+      usage: { cost: asRecord(response.providerMetadata?.fleetAccounting).reportedRequestUsd },
+    }),
+    ...(Object.keys(usage).length ? { usage } : {}),
+  };
+}
