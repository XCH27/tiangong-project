+import type { Model, ModelUsage } from "./index.js";
+
+/** Failed model decoding can still report consumption; this never supplies a completed response. */
+export function readModelErrorUsage(
+  error: unknown,
+  model: Model,
+):
+  | {
+      usage: ModelUsage;
+      providerMetadata?: Record<string, unknown>;
+    }
+  | undefined {
+  const seen = new Set<unknown>();
+  for (
+    let current = record(error), depth = 0;
+    current && depth < 12 && !seen.has(current);
+    depth++
+  ) {
+    seen.add(current);
+    const observed = record(record(current.context)?.fleetUsageObservation);
+    const usage = record(observed?.usage);
+    if (
+      observed?.providerId === String(model.providerId) &&
+      observed.modelId === String(model.modelId) &&
+      usage
+    ) {
+      const known: ModelUsage = {};
+      for (const key of [
+        "inputTokens",
+        "outputTokens",
+        "totalTokens",
+        "cacheReadTokens",
+        "cacheWriteTokens",
+        "reasoningTokens",
+      ] as const) {
+        const value = usage[key];
+        if (typeof value === "number" && Number.isSafeInteger(value) && value >= 0)
+          known[key] = value;
+      }
+      const serverToolUse = record(usage.serverToolUse);
+      const server: NonNullable<ModelUsage["serverToolUse"]> = {};
+      for (const key of ["webSearchRequests", "webFetchRequests"] as const) {
