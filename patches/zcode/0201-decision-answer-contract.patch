+import assert from "node:assert/strict";
+import test from "node:test";
+import { ModelRetryBudget } from "@zcode/contracts";
+import { runGenerateText } from "../src/model/runner-generate.js";
+import { ProviderBusinessError } from "../src/model/model-execution.js";
+
+for (const branch of ["signature", "off-peak"] as const) {
+  test(`Single suppresses the ${branch} recovery branch while Default retains it`, async () => {
+    for (const budget of [ModelRetryBudget.Single, ModelRetryBudget.Default]) {
+      let calls = 0;
+      const statuses: Array<{ type: string; maxAttempts?: number; retryable?: boolean }> = [];
+      const resolved = {
+        providerId: "synthetic",
+        modelId: "synthetic-model",
+        providerKind: branch === "signature" ? "anthropic" : "openai-compatible",
+        model: {
+          specificationVersion: "v4",
+          provider: "synthetic",
+          modelId: "synthetic-model",
+          supportedUrls: {},
+        },
+        properties: {
+          requiresMfjsToolSchema: false,
+          supportsNativeWebSearch: false,
+          inputFormat: { supportsText: true },
+        },
+        ...(branch === "off-peak" ? { accountAccess: { mode: "off-peak" } } : {}),
+      } as never;
+      const run = runGenerateText({
+        env: {},
+        resolved,
+        resolveModel: () => resolved,
+        request: {
+          modelRetryBudget: budget,
+          abortSignal: AbortSignal.timeout(1000),
+          messages: [
+            {
+              role: "assistant",
+              content: [
+                {
+                  type: "reasoning",
+                  text: "Synthetic reasoning",
+                  providerOptions: { anthropic: { signature: "synthetic-signature" } },
+                },
+              ],
+            },
+            { role: "user", content: "Synthetic request" },
+          ],
+        },
+        retry: { maxAttempts: 2, baseDelayMs: 0, backoffFactor: 1, maxDelayMs: 0, jitter: false },
+        modelIoFullRetentionEnabled: false,
+        statusSink: {
+          publish: async (event) => {
+            statuses.push(event);
+          },
+        },
+        runtime: {
+          generateText: async () => {
+            calls++;
+            if (calls === 1) {
+              if (branch === "signature")
+                throw Object.assign(new Error("Invalid signature in thinking block"), {
+                  statusCode: 400,
+                });
+              throw new ProviderBusinessError({
+                providerId: "synthetic",
+                providerKind: "openai-compatible",
+                providerCode: "3105",
+                providerMessage: "Synthetic queue",
+                statusCode: 429,
+                responseHeaders: { "retry-after": "0" },
+              });
+            }
+            return {
+              text: "Synthetic answer",
+              finishReason: "stop",
+              usage: { inputTokens: 2, outputTokens: 1, totalTokens: 3 },
+              reasoning: [],
+              toolCalls: [],
+              toolResults: [],
+              sources: [],
+            } as never;
+          },
+          streamText: () => {
+            throw new Error("No stream used by this focused fixture");
+          },
+        },
+      });
+      if (budget === ModelRetryBudget.Single) {
+        await assert.rejects(run);
+        assert.equal(calls, 1);
+        assert.equal(
+          statuses.some((event) => event.type === "model_retry_scheduled"),
+          false,
+        );
+        const failure = statuses.findLast((event) => event.type === "model_request_failed")!;
+        assert.equal(failure.maxAttempts, 1);
+        assert.equal(failure.retryable, false);
+      } else {
+        assert.equal((await run).text, "Synthetic answer");
+        assert.equal(calls, 2);
+        assert.equal(
+          statuses.some((event) => event.type === "model_retry_scheduled"),
+          true,
+        );
+      }
+    }
+  });
+}
