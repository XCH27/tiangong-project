+
+/** Keep only actually observed declared fields; no account/auth identity is derived here. */
+export function reportedChatFacts(response: Pick<ModelTextResult, "usage" | "providerMetadata">) {
+  const usage: ModelUsage = {};
+  for (const key of [
+    "inputTokens",
+    "outputTokens",
+    "totalTokens",
+    "cacheReadTokens",
+    "cacheWriteTokens",
+    "reasoningTokens",
+  ] as const) {
