@@ -0,0 +1,92 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  apiKeyPlanRoute,
+  parseMiniMaxTokenPlanUsage,
+  parseOpenCodeGoUsage,
+  readApiKeyPlanUsage,
+} from "../src/model-provider/apiKeyPlanUsage.js";
+
+test("only OpenCode Go and MiniMax Token Plan templates route to plan allowance", () => {
+  assert.equal(apiKeyPlanRoute({ baseUrl: "https://opencode.ai/zen/go/v1" }), "opencode-go");
+  assert.equal(apiKeyPlanRoute({ baseUrl: "https://opencode.ai/zen/v1" }), undefined);
+  assert.equal(
+    apiKeyPlanRoute({ templateId: "fleet-minimax-token-plan-cn", baseUrl: "https://api.minimaxi.com/anthropic" }),
+    "minimax-token-plan",
+  );
+  // 同域名的普通按量 MiniMax API 不读取套餐额度。
+  assert.equal(apiKeyPlanRoute({ templateId: "minimax", baseUrl: "https://api.minimaxi.com/v1" }), undefined);
+  assert.equal(apiKeyPlanRoute({ baseUrl: "not a url" }), undefined);
+});
+
+test("OpenCode Go maps rolling/weekly/monthly windows and keeps invalid rows unknown", () => {
+  const parsed = parseOpenCodeGoUsage(
+    {
+      usage: {
+        rolling: { status: "ok", percent: 12.5, resetsAt: "2026-10-05T20:00:00Z" },
+        weekly: { status: "ok", percent: 40, resetsAt: "2026-10-12T00:00:00Z" },
+        monthly: { status: "rate-limited", percent: 101, resetsAt: "2026-11-01T00:00:00Z" },
+      },
+    },
+    7,
+  );
+  assert.equal(parsed.status, "available");
+  if (parsed.status === "available")
+    assert.deepEqual(parsed.windows, [
+      { id: "default:rolling", usedPercent: 12.5, windowMinutes: 300, resetAt: Date.parse("2026-10-05T20:00:00Z") },
+      { id: "default:weekly", usedPercent: 40, windowMinutes: 10_080, resetAt: Date.parse("2026-10-12T00:00:00Z") },
+    ]);
+  assert.deepEqual(parseOpenCodeGoUsage({}, 7), { status: "unavailable", unavailableReason: "no-provider-data" });
+});
+
+test("MiniMax Token Plan prefers remaining percent, falls back to counts, and treats missing plan as unsupported", () => {
+  const parsed = parseMiniMaxTokenPlanUsage(
+    {
+      base_resp: { status_code: 0 },
+      model_remains: [
+        {
+          model_name: "MiniMax-M2",
+          current_interval_remaining_percent: 75,
+          end_time: 1_790_000_000_000,
+          current_weekly_total_count: "200",
+          current_weekly_usage_count: "50",
+          weekly_end_time: 1_790_500_000_000,
+        },
+      ],
+    },
+    7,
+  );
+  assert.equal(parsed.status, "available");
+  if (parsed.status === "available")
+    assert.deepEqual(parsed.windows, [
+      { id: "MiniMax-M2:interval", usedPercent: 25, windowMinutes: 300, resetAt: 1_790_000_000_000 },
+      { id: "MiniMax-M2:weekly", usedPercent: 25, windowMinutes: 10_080, resetAt: 1_790_500_000_000 },
+    ]);
+  assert.deepEqual(parseMiniMaxTokenPlanUsage({ base_resp: { status_code: 1004 }, model_remains: null }, 7), {
+    status: "unsupported",
+  });
+});
+
+test("plan reads use the saved key, fixed endpoints and distinct failure states", async () => {
+  const seen: { url: string; auth: string | null }[] = [];
+  const fetcher: typeof fetch = async (url, init) => {
+    seen.push({ url: String(url), auth: new Headers(init?.headers).get("authorization") });
+    return String(url).includes("opencode")
+      ? Response.json({ usage: { weekly: { percent: 1, resetsAt: "2026-10-12T00:00:00Z" } } })
+      : new Response(null, { status: 401 });
+  };
+  const go = await readApiKeyPlanUsage("opencode-go", "fixture-go", "https://opencode.ai/zen/go/v1", fetcher, () => 1);
+  assert.equal(go.status, "available");
+  const mm = await readApiKeyPlanUsage(
+    "minimax-token-plan",
+    "fixture-mm",
+    "https://api.minimaxi.com/anthropic",
+    fetcher,
+    () => 1,
+  );
+  assert.equal(mm.status, "auth-required");
+  assert.deepEqual(seen, [
+    { url: "https://opencode.ai/zen/go/v1/usage", auth: "Bearer fixture-go" },
+    { url: "https://api.minimaxi.com/v1/token_plan/remains", auth: "Bearer fixture-mm" },
+  ]);
+});
