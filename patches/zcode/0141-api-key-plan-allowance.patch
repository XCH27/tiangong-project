diff --git a/packages/ui/src/settings/model-provider-section/ApiKeyPlanAllowance.tsx b/packages/ui/src/settings/model-provider-section/ApiKeyPlanAllowance.tsx
new file mode 100644
index 0000000..149f468
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ApiKeyPlanAllowance.tsx
@@ -0,0 +1,34 @@
+import { useServices } from "@/hooks/useServices.js";
+import { useSubscriptionAccountList } from "./useSubscriptionAccountList.js";
+import { SubscriptionUsageSection } from "./SubscriptionUsageSection.js";
+import type { ApiKeyPlanRoute } from "@zcode/shared";
+
+/** API Key 套餐的额度沿用订阅账号的同一额度卡片与刷新逻辑；密钥本身只在宿主服务内使用。 */
+export function ApiKeyPlanAllowance({
+  providerId,
+  route,
+  onError,
+}: {
+  providerId: string;
+  route: ApiKeyPlanRoute;
+  onError(error: unknown): void;
+}) {
+  const { providerSettingsService } = useServices();
+  const { accounts, reload } = useSubscriptionAccountList(
+    providerSettingsService,
+    providerId,
+    () => {},
+    onError,
+  );
+  const account = accounts?.accounts.find((entry) => entry.active);
+  return account && accounts ? (
+    <SubscriptionUsageSection
+      providerId={providerId}
+      kind={route}
+      accountId={account.id}
+      revision={accounts.revision}
+      showReset={false}
+      onScopeChanged={() => void reload()}
+    />
+  ) : null;
+}
