diff --git a/packages/services/src/model-provider/apiKeyPlanUsage.ts b/packages/services/src/model-provider/apiKeyPlanUsage.ts
new file mode 100644
index 0000000..a1694dc
--- /dev/null
+++ b/packages/services/src/model-provider/apiKeyPlanUsage.ts
@@ -0,0 +1,218 @@
+import { createHash } from "node:crypto";
+import { getEnabledApiKeys, type ProviderSettingsFacade } from "@zcode/provider";
+import { apiKeyPlanRoute, type ApiKeyPlanRoute } from "@zcode/shared";
+import type { SubscriptionAccountsView } from "./subscriptionConnectionTypes.js";
+import type { SubscriptionUsageResult, SubscriptionUsageWindow } from "./subscriptionUsage.js";
+
+/**
+ * 用 API Key 购买的套餐（OpenCode Go、MiniMax Token Plan）此前没有额度读取，设置页只能看到密钥。
+ * 读取方式与 Paseo plugins/{opencode-go,minimax}-usage-source、Orca rate-limits/opencode-go-*
+ * 一致：用连接里已保存的同一把密钥，请求厂商的只读额度接口。不另存密钥、不推断套餐档位。
+ */
+export { apiKeyPlanRoute, type ApiKeyPlanRoute };
+
+const READ_TIMEOUT_MS = 15_000;
+const CACHE_MS = 60_000;
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+function finite(value: unknown): number | undefined {
+  const parsed = typeof value === "string" && value.trim() ? Number(value) : value;
+  return typeof parsed === "number" && Number.isFinite(parsed) ? parsed : undefined;
+}
+function clampPercent(value: number): number {
+  return Math.min(100, Math.max(0, value));
+}
+
+const OPENCODE_GO_WINDOWS = [
+  ["rolling", 300],
+  ["weekly", 10_080],
+  ["monthly", 43_200],
+] as const;
+
+/** OpenCode Go `/zen/go/v1/usage`：usage.{rolling,weekly,monthly}.{percent,resetsAt}。 */
+export function parseOpenCodeGoUsage(payload: unknown, observedAt: number): SubscriptionUsageResult {
+  const usage = record(record(payload)?.usage);
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const [key, windowMinutes] of OPENCODE_GO_WINDOWS) {
+    const row = record(usage?.[key]);
+    const percent = finite(row?.percent);
+    if (percent === undefined || percent < 0 || percent > 100) continue;
+    const reset = typeof row?.resetsAt === "string" ? Date.parse(row.resetsAt) : NaN;
+    windows.push({
+      id: `default:${key}`,
+      usedPercent: percent,
+      windowMinutes,
+      ...(Number.isFinite(reset) ? { resetAt: reset } : {}),
+    });
+  }
+  return windows.length
+    ? { status: "available", source: "OpenCode Go", observedAt, windows, plan: "Go" }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+/** MiniMax `/v1/token_plan/remains`：每个模型的 5 小时与每周窗口，优先使用剩余百分比。 */
+export function parseMiniMaxTokenPlanUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const body = record(payload);
+  const status = finite(record(body?.base_resp)?.status_code);
+  // 非 0 表示该密钥没有有效 Token Plan；这是"不支持"，不是额度为 0。
+  if (status !== undefined && status !== 0) return { status: "unsupported" };
+  const rows = Array.isArray(body?.model_remains) ? body.model_remains.slice(0, 32) : [];
+  const windows: SubscriptionUsageWindow[] = [];
+  const used = (remainingPercent: unknown, total: unknown, usedCount: unknown) => {
+    const remaining = finite(remainingPercent);
+    if (remaining !== undefined) return clampPercent(100 - remaining);
+    const all = finite(total);
+    const spent = finite(usedCount);
+    return all !== undefined && all > 0 && spent !== undefined ? clampPercent((spent / all) * 100) : undefined;
+  };
+  for (const raw of rows) {
+    const row = record(raw);
+    if (!row) continue;
+    const name = typeof row.model_name === "string" && row.model_name.trim() ? row.model_name.trim().slice(0, 64) : "Token Plan";
+    const interval = used(
+      row.current_interval_remaining_percent,
+      row.current_interval_total_count,
+      row.current_interval_usage_count,
+    );
+    const intervalEnd = finite(row.end_time);
+    if (interval !== undefined)
+      windows.push({
+        id: `${name}:interval`,
+        usedPercent: interval,
+        windowMinutes: 300,
+        ...(intervalEnd && intervalEnd > 0 ? { resetAt: intervalEnd } : {}),
+      });
+    const weekly = used(
+      row.current_weekly_remaining_percent,
+      row.current_weekly_total_count,
+      row.current_weekly_usage_count,
+    );
+    const weeklyEnd = finite(row.weekly_end_time);
+    if (weekly !== undefined)
+      windows.push({
+        id: `${name}:weekly`,
+        usedPercent: weekly,
+        windowMinutes: 10_080,
+        ...(weeklyEnd && weeklyEnd > 0 ? { resetAt: weeklyEnd } : {}),
+      });
+  }
+  return windows.length
+    ? { status: "available", source: "MiniMax Token Plan", observedAt, windows }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+export async function readApiKeyPlanUsage(
+  route: ApiKeyPlanRoute,
+  apiKey: string,
+  baseUrl: string,
+  fetcher: typeof fetch,
+  now = Date.now,
+): Promise<SubscriptionUsageResult> {
+  const url =
+    route === "opencode-go"
+      ? "https://opencode.ai/zen/go/v1/usage"
+      : `${new URL(baseUrl).origin}/v1/token_plan/remains`;
+  try {
+    const response = await fetcher(url, {
+      method: "GET",
+      redirect: "error",
+      signal: AbortSignal.timeout(READ_TIMEOUT_MS),
+      headers: { Accept: "application/json", Authorization: `Bearer ${apiKey}` },
+    });
+    if (!response.ok) {
+      await response.body?.cancel();
+      return {
+        status:
+          response.status === 401
+            ? "auth-required"
+            : response.status === 403
+              ? "access-denied"
+              : response.status === 429
+                ? "rate-limited"
+                : "unavailable",
+      };
+    }
+    const payload: unknown = await response.json();
+    return route === "opencode-go"
+      ? parseOpenCodeGoUsage(payload, now())
+      : parseMiniMaxTokenPlanUsage(payload, now());
+  } catch {
+    return { status: "unavailable" };
+  }
+}
+
+/** 同一连接共享读数；密钥只以哈希参与缓存身份，修改或删除密钥会让旧读数失效。 */
+export function createApiKeyPlanUsageReader(
+  facade: ProviderSettingsFacade,
+  fetcher: typeof fetch,
+  now = Date.now,
+) {
+  const cache = new Map<
+    string,
+    { revision: string; value?: SubscriptionUsageResult; pending?: Promise<SubscriptionUsageResult> }
+  >();
+  const scope = (id: string) => {
+    const provider = facade.getView().providers.find((entry) => entry.providerId === id);
+    const config = provider?.effectiveConfig;
+    if (config?.access?.type !== "api-key") return undefined;
+    const route = apiKeyPlanRoute({ templateId: provider?.templateId, baseUrl: config.api?.baseUrl });
+    const apiKey = getEnabledApiKeys(config.access)[0];
+    if (!route || !apiKey || !config.api?.baseUrl) return undefined;
+    const fingerprint = createHash("sha256").update(apiKey).digest("hex").slice(0, 16);
+    return {
+      route,
+      apiKey,
+      baseUrl: config.api.baseUrl,
+      revision: JSON.stringify([route, config.api.baseUrl, fingerprint]),
+    };
+  };
+  return {
+    accounts(id: string): SubscriptionAccountsView | undefined {
+      const current = scope(id);
+      return current
+        ? { accounts: [{ id: "api-key", label: "API Key", active: true }], autoSwitch: false, revision: current.revision }
+        : undefined;
+    },
+    async read(id: string, refresh = false): Promise<SubscriptionUsageResult> {
+      const current = scope(id);
+      if (!current) {
+        cache.delete(id);
+        return { status: "unsupported" };
+      }
+      const scoped = { accountId: "api-key", connectionRevision: current.revision };
+      let entry = cache.get(id);
+      if (entry?.revision !== current.revision) {
+        entry = { revision: current.revision };
+        cache.set(id, entry);
+      }
+      if (entry.pending) return entry.pending;
+      if (!refresh && entry.value && (entry.value.refreshAfter ?? 0) > now()) return entry.value;
+      const active = entry;
+      const request = (async () => {
+        const value = await readApiKeyPlanUsage(current.route, current.apiKey, current.baseUrl, fetcher, now);
+        // 读取期间密钥被修改：迟到的结果不能发布到新密钥上。
+        if (scope(id)?.revision !== active.revision || cache.get(id) !== active)
+          return { status: "unavailable" as const, ...scoped };
+        const result: SubscriptionUsageResult =
+          value.status === "unavailable" && active.value?.status === "available"
+            ? { ...active.value, refreshError: "unavailable", refreshAfter: now() + CACHE_MS }
+            : { ...value, ...scoped, refreshAfter: now() + CACHE_MS };
+        active.value = result;
+        return result;
+      })();
+      active.pending = request;
+      try {
+        return await request;
+      } finally {
+        if (active.pending === request) active.pending = undefined;
+      }
+    },
+  };
+}
