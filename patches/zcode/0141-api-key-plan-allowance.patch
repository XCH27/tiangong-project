diff --git a/packages/shared/src/api-key-plan-usage.ts b/packages/shared/src/api-key-plan-usage.ts
new file mode 100644
index 0000000..3fa330a
--- /dev/null
+++ b/packages/shared/src/api-key-plan-usage.ts
@@ -0,0 +1,26 @@
+/**
+ * API Key 套餐的额度读取路由（OpenCode Go、MiniMax Token Plan）。
+ * 设置页与宿主服务共用同一判定，避免界面显示额度区块而服务不支持，或反之。
+ */
+export type ApiKeyPlanRoute = "opencode-go" | "minimax-token-plan";
+
+const MINIMAX_TOKEN_PLAN_TEMPLATES = new Set(["fleet-minimax-token-plan", "fleet-minimax-token-plan-cn"]);
+
+export function apiKeyPlanRoute(provider: {
+  templateId?: string | null;
+  baseUrl?: string | null;
+}): ApiKeyPlanRoute | undefined {
+  let url: URL | undefined;
+  try {
+    url = provider.baseUrl ? new URL(provider.baseUrl) : undefined;
+  } catch {
+    url = undefined;
+  }
+  if (url?.hostname === "opencode.ai" && url.pathname.startsWith("/zen/go")) return "opencode-go";
+  // 普通 MiniMax 按量 API 与 Token Plan 共用域名；只对 Token Plan 模板读取，避免把余额当成套餐额度。
+  if (provider.templateId && MINIMAX_TOKEN_PLAN_TEMPLATES.has(provider.templateId)) {
+    if (url?.hostname === "api.minimax.io" || url?.hostname === "api.minimaxi.com")
+      return "minimax-token-plan";
+  }
+  return undefined;
+}
