diff --git a/packages/shared/src/usage-accounting.ts b/packages/shared/src/usage-accounting.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4ecf4d3dd99648b85a94a04f6adfc21694c35aa7
--- /dev/null
+++ b/packages/shared/src/usage-accounting.ts
@@ -0,0 +1,118 @@
+import { z } from "zod";
+
+export const subscriptionPaymentSchema = z
+  .object({
+    id: z.string().min(1),
+    providerId: z.string().min(1),
+    accountId: z.string().min(1),
+    accountLabel: z.string().max(256),
+    start: z.number().int().nonnegative(),
+    end: z.number().int().positive(),
+    amount: z.number().finite().nonnegative(),
+    currency: z.enum(["USD", "CNY", "EUR", "GBP", "JPY"]),
+  })
+  .refine((value) => value.end > value.start, "End must follow start");
+export const subscriptionPaymentsSchema = z
+  .record(z.string(), subscriptionPaymentSchema.nullable())
+  .superRefine((records, ctx) => {
+    const values = Object.entries(records).filter(
+      (entry): entry is [string, SubscriptionPayment] => entry[1] !== null,
+    );
+    for (let i = 0; i < values.length; i++) {
+      const [key, payment] = values[i]!;
+      if (key !== payment.id)
+        ctx.addIssue({ code: "custom", path: [key], message: "Payment identity mismatch" });
+      for (const [, other] of values.slice(i + 1))
+        if (
+          payment.providerId === other.providerId &&
+          payment.accountId === other.accountId &&
+          payment.start < other.end &&
+          other.start < payment.end
+        )
+          ctx.addIssue({
+            code: "custom",
+            path: [key],
+            message: "Billing periods for the same account must not overlap",
+          });
+    }
+  });
+export type SubscriptionPayment = z.infer<typeof subscriptionPaymentSchema>;
+export const usageAccountingRowSchema = z.object({
+  providerId: z.string(),
+  accountId: z.string().nullable(),
+  modelId: z.string(),
+  speedMode: z.string().nullable(),
+  requestCount: z.number(),
+  reportedCount: z.number(),
+  inputTokens: z.number(),
+  outputTokens: z.number(),
+  cacheReadTokens: z.number(),
+  cacheInputTokens: z.number(),
+  cacheReportedCount: z.number(),
+  estimatedUsd: z.number(),
+  pricedCount: z.number(),
+  estimatedCredits: z.number(),
+  creditCount: z.number(),
+  firstAt: z.number(),
+  lastAt: z.number(),
+  priceVersions: z.string().nullable(),
+});
+export type UsageAccountingRow = z.infer<typeof usageAccountingRowSchema>;
+
+/** Allocate one account-period payment; unrelated accounts and currencies never share a denominator. */
+export function allocateSubscriptionPayment(
+  payment: SubscriptionPayment,
+  rows: readonly UsageAccountingRow[],
+) {
+  if (rows.some((row) => row.firstAt < payment.start || row.lastAt >= payment.end))
+    return { basis: "unavailable" as const, models: [], unallocated: payment.amount };
+  const eligible = rows.filter(
+    (row) =>
+      row.providerId === payment.providerId &&
+      (payment.accountId === "connection"
+        ? row.accountId === null
+        : row.accountId === payment.accountId),
+  );
+  // 已知同服务存在无账号归属的记录时，不能声称当前账号账期完整。
+  if (
+    payment.accountId !== "connection" &&
+    rows.some((row) => row.providerId === payment.providerId && row.accountId === null)
+  )
+    return { basis: "unavailable" as const, models: [], unallocated: payment.amount };
+  const requests = eligible.reduce((sum, row) => sum + row.requestCount, 0);
+  const native = requests > 0 && eligible.every((row) => row.creditCount === row.requestCount);
+  const api = requests > 0 && eligible.every((row) => row.pricedCount === row.requestCount);
+  const basis = native ? "credits" : api ? "api-value" : "unavailable";
+  const weight = (row: UsageAccountingRow) => (native ? row.estimatedCredits : row.estimatedUsd);
+  const total = eligible.reduce((sum, row) => sum + weight(row), 0);
+  if (basis === "unavailable" || total <= 0)
+    return { basis: "unavailable" as const, models: [], unallocated: payment.amount };
+  const grouped = new Map<
+    string,
+    { modelId: string; weight: number; tokens: number; requests: number }
+  >();
+  for (const row of eligible) {
+    const value = grouped.get(row.modelId) ?? {
+      modelId: row.modelId,
+      weight: 0,
+      tokens: 0,
+      requests: 0,
+    };
+    value.weight += weight(row);
+    value.tokens += row.inputTokens + row.outputTokens;
+    value.requests += row.requestCount;
+    grouped.set(row.modelId, value);
+  }
+  return {
+    basis,
+    unallocated: 0,
+    models: [...grouped.values()].map((row) => {
+      const amount = (payment.amount * row.weight) / total;
+      return {
+        ...row,
+        amount,
+        perMillionTokens: row.tokens > 0 ? (amount * 1_000_000) / row.tokens : null,
+      };
+    }),
+  };
+}
diff --git a/packages/shared/src/usage-price.ts b/packages/shared/src/usage-price.ts
new file mode 100644
index 0000000000000000000000000000000000000000..730ff532492b186b5058a3045c61779348ab4fc2
--- /dev/null
+++ b/packages/shared/src/usage-price.ts
@@ -0,0 +1,257 @@
+/**
+ * Pure current-rate estimates over a single normalized request, never a provider bill.
+ * Rates were checked on 2026-09-27; request time selects DeepSeek's time band only.
+ * No account allowance, taxes, regional premiums, tool fees or historical rate lookup.
+ */
+export interface UsagePriceInput {
+  billingProvider: "openai" | "deepseek" | "anthropic" | undefined;
+  modelId: string;
+  /** Unix milliseconds. */
+  startedAt: number;
+  /** Total input, including the disjoint cache-read and cache-write subsets. */
+  inputTokens?: number;
+  outputTokens?: number;
+  cacheReadTokens?: number;
+  cacheWriteTokens?: number;
+  /** Must be recorded for this request; absence is not Standard. */
+  speedMode?: "standard" | "fast";
+  subscription?: boolean;
+}
+
+export interface UsagePriceEstimate {
+  estimatedUsd?: number;
+  /** Native credit-rate estimate; not included subscription allowance or a USD conversion. */
+  estimatedCredits?: number;
+  priceVersion: string;
+  sourceUrl?: string;
+  /** A stable reason for missing/partial estimates, not a provider error message. */
+  reason?: string;
+}
+
+const PRICE_VERSION = "official-2026-09-27";
+const OPENAI_PRICE_URL = "https://developers.openai.com/api/docs/pricing";
+const CHATGPT_PRICE_URL = "https://learn.chatgpt.com/docs/pricing";
+const DEEPSEEK_PRICE_URL = "https://api-docs.deepseek.com/quick_start/pricing";
+const MILLION = 1_000_000;
+const LONG_INPUT_THRESHOLD = 272_000;
+
+type Rates = readonly [input: number, cacheRead: number, cacheWrite: number, output: number];
+interface OpenAIPrice {
+  short: Rates;
+  long: Rates;
+  separateCacheWrite: boolean;
+  apiFastMultiplier: number;
+  longFast: boolean;
+  credits: readonly [input: number, cacheRead: number, output: number];
+}
+
+// Exact official model IDs only. Do not strip suffixes or infer a model family.
+// Every model's /api/docs/models/<id> page verifies >272K input as the long tier.
+// Fast API values come from the API table; credit Fast = 2.5x is independently
+// documented at https://learn.chatgpt.com/docs/agent-configuration/speed.
+const OPENAI_PRICES = new Map<string, OpenAIPrice>([
+  [
+    "gpt-6-astra",
+    {
+      short: [10, 1, 12.5, 50],
+      long: [20, 2, 25, 75],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [250, 25, 1250],
+    },
+  ],
+  [
+    "gpt-6-sol",
+    {
+      short: [2, 0.2, 2.5, 10],
+      long: [4, 0.4, 5, 15],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [50, 5, 250],
+    },
+  ],
+  [
+    "gpt-6-luna",
+    {
+      short: [0.1, 0.01, 0.125, 0.5],
+      long: [0.2, 0.02, 0.25, 0.75],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [2.5, 0.25, 12.5],
+    },
+  ],
+  [
+    "gpt-5.6-sol",
+    {
+      short: [4, 0.4, 5, 20],
+      long: [8, 0.8, 10, 30],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [100, 10, 500],
+    },
+  ],
+  [
+    "gpt-5.6-terra",
+    {
+      short: [2, 0.2, 2.5, 12],
+      long: [4, 0.4, 5, 18],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [50, 5, 300],
+    },
+  ],
+  [
+    "gpt-5.6-luna",
+    {
+      short: [0.2, 0.02, 0.25, 1.2],
+      long: [0.4, 0.04, 0.5, 1.8],
+      separateCacheWrite: true,
+      apiFastMultiplier: 2,
+      longFast: true,
+      credits: [5, 0.5, 30],
+    },
+  ],
+  // No separately billed writes; any reported write tokens keep the ordinary input rate.
+  [
+    "gpt-5.5",
+    {
+      short: [5, 0.5, 5, 30],
+      long: [10, 1, 10, 45],
+      separateCacheWrite: false,
+      apiFastMultiplier: 2.5,
+      longFast: false,
+      credits: [125, 12.5, 750],
+    },
+  ],
+]);
+
+// Peak USD per million; the official table defines off-peak as exactly half.
+// Cache misses include writes, with no separately priced write category.
+const DEEPSEEK_PRICES = new Map<string, Rates>([
+  ["deepseek-flash", [0.3, 0.006, 0.3, 1.2]],
+  ["deepseek-v4-pro", [1.32, 0.044, 1.32, 3.96]],
+]);
+
+// State Council 2026 holiday schedule (including the announced days off):
+// https://en.bjhd.gov.cn/workinginhaidian/supportingservices/publicholidays/202512/t20251211_4797062.shtml
+// These dates are only consulted during potential peak hours (09:00–18:00 China
+// time), where the UTC and China calendar date are identical. DeepSeek explicitly
+// keeps ALL weekends off-peak, including adjusted weekend workdays.
+const CHINA_HOLIDAYS_2026: ReadonlyArray<readonly [from: string, through: string]> = [
+  ["01-01", "01-03"],
+  ["02-15", "02-23"],
+  ["04-04", "04-06"],
+  ["05-01", "05-05"],
+  ["06-19", "06-21"],
+  ["09-25", "09-27"],
+  ["10-01", "10-07"],
+];
+
+function deepseekPeak(startedAt: number): boolean | undefined {
+  const date = new Date(startedAt);
+  const weekday = date.getUTCDay();
+  const hour = date.getUTCHours();
+  if (weekday === 0 || weekday === 6 || !((hour >= 1 && hour < 4) || (hour >= 6 && hour < 10)))
+    return false;
+  if (date.getUTCFullYear() !== 2026) return undefined;
+  const monthDay = date.toISOString().slice(5, 10);
+  return !CHINA_HOLIDAYS_2026.some(([from, through]) => monthDay >= from && monthDay <= through);
+}
+
+function unknown(reason: string, sourceUrl?: string): UsagePriceEstimate {
+  return { priceVersion: PRICE_VERSION, ...(sourceUrl ? { sourceUrl } : {}), reason };
+}
+
+function validCounter(value: number | undefined): boolean {
+  return value === undefined || (Number.isSafeInteger(value) && value >= 0);
+}
+
+/**
+ * API USD and subscription credits are independent estimates. Missing API writes
+ * can leave USD unknown while credits remain known: native credits explicitly do
+ * not separately bill writes. The listed credit rate has no API context multiplier.
+ */
+export function estimateUsagePrice(input: UsagePriceInput): UsagePriceEstimate {
+  const { billingProvider, inputTokens, outputTokens, cacheReadTokens, cacheWriteTokens } = input;
+  const sourceUrl =
+    billingProvider === "openai"
+      ? OPENAI_PRICE_URL
+      : billingProvider === "deepseek"
+        ? DEEPSEEK_PRICE_URL
+        : undefined;
+  if (!billingProvider) return unknown("billing-provider-missing");
+  if (billingProvider !== "openai" && billingProvider !== "deepseek")
+    return unknown("provider-price-unavailable");
+  if (
+    !Number.isSafeInteger(input.startedAt) ||
+    input.startedAt < 0 ||
+    !Number.isFinite(new Date(input.startedAt).getTime())
+  )
+    return unknown("invalid-request-time", sourceUrl);
+  if (![inputTokens, outputTokens, cacheReadTokens, cacheWriteTokens].every(validCounter))
+    return unknown("invalid-token-counter", sourceUrl);
+  if (inputTokens === undefined || outputTokens === undefined || cacheReadTokens === undefined)
+    return unknown("required-token-counters-missing", sourceUrl);
+  if (
+    cacheReadTokens > inputTokens ||
+    (cacheWriteTokens !== undefined && cacheWriteTokens > inputTokens - cacheReadTokens)
+  )
+    return unknown("cache-subsets-exceed-input", sourceUrl);
+  if (input.speedMode === undefined) return unknown("speed-mode-missing", sourceUrl);
+  if (input.speedMode !== "standard" && input.speedMode !== "fast")
+    return unknown("speed-mode-unavailable", sourceUrl);
+
+  if (billingProvider === "deepseek") {
+    const rates = DEEPSEEK_PRICES.get(input.modelId);
+    if (!rates) return unknown("model-price-unavailable", sourceUrl);
+    if (input.speedMode === "fast") return unknown("fast-price-unavailable", sourceUrl);
+    const peak = deepseekPeak(input.startedAt);
+    if (peak === undefined) return unknown("deepseek-holiday-calendar-unavailable", sourceUrl);
+    const estimatedUsd =
+      (((inputTokens - cacheReadTokens) * rates[0] +
+        cacheReadTokens * rates[1] +
+        outputTokens * rates[3]) /
+        MILLION) *
+      (peak ? 1 : 0.5);
+    return { estimatedUsd, priceVersion: PRICE_VERSION, sourceUrl };
+  }
+
+  const price = OPENAI_PRICES.get(input.modelId);
+  if (!price) return unknown("model-price-unavailable", sourceUrl);
+  const result: UsagePriceEstimate = { priceVersion: PRICE_VERSION, sourceUrl };
+  if (input.subscription === true) {
+    const [ordinaryInput, read, output] = price.credits;
+    result.estimatedCredits =
+      (((inputTokens - cacheReadTokens) * ordinaryInput +
+        cacheReadTokens * read +
+        outputTokens * output) /
+        MILLION) *
+      (input.speedMode === "fast" ? 2.5 : 1);
+  }
+
+  const long = inputTokens > LONG_INPUT_THRESHOLD;
+  if (long && input.speedMode === "fast" && !price.longFast)
+    result.reason = "long-context-fast-price-unavailable";
+  else if (price.separateCacheWrite && cacheWriteTokens === undefined)
+    result.reason = "api-cache-write-tokens-missing";
+  else {
+    const [ordinaryInput, read, write, output] = long ? price.long : price.short;
+    // 未报告不能当作零；这里只对官方无独立写入计价的模型合并到普通输入。
+    const writes = price.separateCacheWrite ? cacheWriteTokens! : 0;
+    result.estimatedUsd =
+      (((inputTokens - cacheReadTokens - writes) * ordinaryInput +
+        cacheReadTokens * read +
+        writes * write +
+        outputTokens * output) /
+        MILLION) *
+      (input.speedMode === "fast" ? price.apiFastMultiplier : 1);
+  }
+  if (result.estimatedUsd === undefined && result.estimatedCredits !== undefined)
+    result.sourceUrl = CHATGPT_PRICE_URL;
+  return result;
+}
