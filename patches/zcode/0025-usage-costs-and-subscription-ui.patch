+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuTrigger,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+} from "@/components/ui/dropdown-menu.js";
+import { isCoarseTouchDevice } from "@/lib/pickerFocus.js";
+import type { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+// Same radio-group menu primitives as the original model picker; both values remain composer-owned.
+export function ThoughtAndSpeedMenu({
+  open,
+  onOpenChange,
+  disabled,
+  title,
+  shortcut,
+  triggerRef,
+  triggerClassName,
+  label,
+  restoreFocusSelector,
+  value,
+  onValueChange,
+  speed,
+  entries,
+  intl,
+  children,
+}: {
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+  disabled?: boolean;
+  title: string;
+  shortcut?: string;
+  triggerRef: RefObject<HTMLSpanElement | null>;
+  triggerClassName: string;
+  label: string;
+  restoreFocusSelector?: string | null;
+  value: string;
+  onValueChange: (value: string) => void;
+  entries: { value: string; label: string }[];
+  children: ReactNode;
+  speed: {
+    value: "standard" | "fast";
+    note: string;
+    onChange: (value: "standard" | "fast") => void;
+  };
+  intl: ReturnType<typeof useZCodeIntl>["intl"];
+}) {
+  return (
+    <DropdownMenu open={open} onOpenChange={onOpenChange}>
+      <ControlHintTooltip title={title} shortcut={shortcut} triggerRef={triggerRef}>
+        <DropdownMenuTrigger asChild>
+          <Button
+            variant="ghost"
+            disabled={disabled}
+            className={triggerClassName}
+            aria-label={label}
+            data-testid={TID_CHAT_THOUGHT_LEVEL_SELECT_TRIGGER}
+          >
+            {children}
+            <ChevronDownIcon className="size-3.5 text-foreground-subtle" />
+          </Button>
+        </DropdownMenuTrigger>
+      </ControlHintTooltip>
+      <DropdownMenuContent
+        side="top"
+        align="start"
+        sideOffset={4}
+        onCloseAutoFocus={(event) => {
+          if (!restoreFocusSelector || isCoarseTouchDevice()) return;
+          event.preventDefault();
+          document.querySelector<HTMLElement>(restoreFocusSelector)?.focus();
+        }}
+      >
+        <DropdownMenuLabel>
+          {intl.formatMessage({ id: "chat.toolbar.options.thinking" })}
+        </DropdownMenuLabel>
+        <DropdownMenuRadioGroup
+          value={value}
+          onValueChange={(next) => {
+            if (entries.some((entry) => entry.value === next)) onValueChange(next);
+          }}
+        >
+          {entries.map((entry) => (
+            <DropdownMenuRadioItem key={entry.value} value={entry.value}>
+              {entry.label}
+            </DropdownMenuRadioItem>
+          ))}
+        </DropdownMenuRadioGroup>
+        <DropdownMenuSeparator />
+        <DropdownMenuLabel>
+          {intl.formatMessage({ id: "chat.toolbar.options.speed" })}
+        </DropdownMenuLabel>
+        <DropdownMenuRadioGroup
+          value={speed.value}
+          onValueChange={(next) => {
+            if (next === "standard" || next === "fast") speed.onChange(next);
+          }}
+        >
+          <DropdownMenuRadioItem value="standard">
+            {intl.formatMessage({ id: "chat.toolbar.speed.standard" })}
+          </DropdownMenuRadioItem>
+          <DropdownMenuRadioItem value="fast">
+            {intl.formatMessage({ id: "chat.toolbar.speed.label" })}
+          </DropdownMenuRadioItem>
+        </DropdownMenuRadioGroup>
+        <p className="max-w-64 px-2 py-1 text-ui-xs text-foreground-subtle">{speed.note}</p>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  );
+}
