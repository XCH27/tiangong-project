@@ -0,0 +1,45 @@
+import type { IProviderSettingsService } from "@zcode/services";
+import { readProviderSettings } from "@/lib/providerSettingsRead.js";
+
+export type PaymentAccount = { providerId: string; accountId: string; label: string };
+
+/** Read existing account identities; membership-key plans have one explicit connection total. */
+export async function readPaymentAccounts(
+  service: IProviderSettingsService,
+  connectionLabel: string,
+): Promise<PaymentAccount[]> {
+  const view = await readProviderSettings(() => service.getView());
+  const groups = await Promise.all(
+    view.providers.map(async (provider) => {
+      // 与模型设置的已添加服务保持同一范围，不能把原版隐藏套餐当成用户已绑定的会员。
+      if (provider.effectiveConfig.group !== "standard-personal") return [];
+      const label = provider.providerName ?? provider.providerId;
+      if (provider.effectiveConfig.access?.type === "subscription") {
+        const saved = await readProviderSettings(() =>
+          service.getSubscriptionAccounts(provider.providerId),
+        );
+        return saved.accounts.map((account) => ({
+          providerId: provider.providerId,
+          accountId: account.id,
+          label: `${label} · ${account.label ?? account.id}`,
+        }));
+      }
+      const template = view.providerTemplates.find(
+        (item) => item.templateId === provider.templateId,
+      );
+      if (
+        template?.category === "subscription-plan" ||
+        provider.effectiveConfig.access?.type === "zhipu-account"
+      )
+        return [
+          {
+            providerId: provider.providerId,
+            accountId: "connection",
+            label: `${label} · ${connectionLabel}`,
+          },
+        ];
+      return [];
+    }),
+  );
+  return groups.flat();
+}
