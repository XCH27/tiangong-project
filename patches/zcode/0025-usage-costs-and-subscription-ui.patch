+import { useEffect, useMemo, useState } from "react";
+import { Plus, Pencil, Trash2 } from "lucide-react";
+import {
+  allocateSubscriptionPayment,
+  subscriptionPaymentSchema,
+  type SubscriptionPayment,
+  type UsageAccountingRow,
+} from "@zcode/shared";
+import { readPaymentAccounts, type PaymentAccount } from "./subscriptionPaymentAccounts.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useSettings } from "@/hooks/useSettingService.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { Button } from "@/components/ui/button.js";
+import { Input } from "@/components/ui/input.js";
+import {
+  Dialog,
+  DialogContent,
+  DialogHeader,
+  DialogTitle,
+  DialogFooter,
+  DialogDescription,
+} from "@/components/ui/dialog.js";
+import {
+  Select,
+  SelectTrigger,
+  SelectContent,
+  SelectItem,
+  SelectValue,
+} from "@/components/ui/select.js";
+
+const dateText = (time: number) => {
+  const d = new Date(time);
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+};
+const nextDay = (text: string) => {
+  const d = new Date(`${text}T00:00:00`);
+  d.setDate(d.getDate() + 1);
+  return d.getTime();
+};
+
+export function SubscriptionPaymentsPanel() {
+  const { intl, locale } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.usage.payments.${key}` });
+  const { settings, update } = useSettings();
+  const { providerSettingsService, usageStatsService } = useServices();
+  const payments = useMemo(
+    () =>
+      Object.values(settings?.subscriptionPayments ?? {})
+        .filter((p): p is SubscriptionPayment => p !== null)
+        .sort((a, b) => b.start - a.start),
+    [settings?.subscriptionPayments],
+  );
+  const [open, setOpen] = useState(false);
+  const [accounts, setAccounts] = useState<PaymentAccount[]>();
+  const [accountKey, setAccountKey] = useState("");
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<SubscriptionPayment["currency"]>("CNY");
+  const [start, setStart] = useState(() =>
+    dateText(new Date(new Date().getFullYear(), new Date().getMonth(), 1).getTime()),
+  );
+  const [end, setEnd] = useState(() =>
+    dateText(new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getTime()),
+  );
+  const [editing, setEditing] = useState<SubscriptionPayment>();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+  const [selected, setSelected] = useState<string>();
+  const [readingSnapshot, setReadingSnapshot] = useState<{
+    scope: string;
+    rows: UsageAccountingRow[];
+  }>();
+  const [reading, setReading] = useState(false);
+  const payment = payments.find((p) => p.id === selected);
+  const scope = payment
+    ? JSON.stringify([
+        payment.id,
+        payment.providerId,
+        payment.accountId,
+        payment.start,
+        payment.end,
+      ])
+    : "";
+  const rows = readingSnapshot?.scope === scope ? readingSnapshot.rows : undefined;
+  useEffect(() => {
+    if (!open) return;
+    let active = true;
+    setError(undefined);
+    setAccounts(undefined);
+    void readPaymentAccounts(
+      providerSettingsService,
+      intl.formatMessage({ id: "settings.usage.payments.connection" }),
+    )
+      .then((result) => {
+        if (active) setAccounts(result);
+      })
+      .catch((reason) => {
+        if (active) {
+          setAccounts([]);
+          setError(String(reason));
+        }
+      });
+    return () => {
+      active = false;
+    };
+  }, [open, providerSettingsService, intl]);
+  useEffect(() => {
+    setReadingSnapshot(undefined);
+    if (!payment) return;
+    if (payment.start > Date.now()) {
+      setReadingSnapshot({ scope, rows: [] });
+      setReading(false);
+      return;
+    }
+    let active = true;
+    setReading(true);
+    setError(undefined);
+    void usageStatsService
+      .getAppUsageSnapshot({
+        range: "all",
+        timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
+        since: payment.start,
+        until: payment.end,
+      })
+      .then((snapshot) => {
+        if (active) setReadingSnapshot({ scope, rows: snapshot.accounting ?? [] });
+      })
+      .catch((reason) => {
+        if (active) setError(String(reason));
+      })
+      .finally(() => {
+        if (active) setReading(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, [payment, scope, usageStatsService]);
+  const allocation = payment && rows ? allocateSubscriptionPayment(payment, rows) : undefined;
+  const money = (value: number, unit: SubscriptionPayment["currency"]) =>
+    new Intl.NumberFormat(locale, {
+      style: "currency",
+      currency: unit,
+      maximumFractionDigits: 4,
+    }).format(value);
+  const edit = (item?: SubscriptionPayment) => {
+    setEditing(item);
+    setError(undefined);
+    setAmount(item ? String(item.amount) : "");
+    setCurrency(item?.currency ?? "CNY");
+    setAccountKey(item ? JSON.stringify([item.providerId, item.accountId]) : "");
+    if (item) {
+      setStart(dateText(item.start));
+      setEnd(dateText(item.end - 1));
+    }
+    setOpen(true);
+  };
+  const options = [...(accounts ?? [])];
+  if (
+    editing &&
+    !options.some((a) => a.providerId === editing.providerId && a.accountId === editing.accountId)
+  )
+    options.push({
+      providerId: editing.providerId,
+      accountId: editing.accountId,
+      label: editing.accountLabel,
+    });
+  const save = async () => {
+    const account = options.find((a) => JSON.stringify([a.providerId, a.accountId]) === accountKey);
+    if (!account || !amount.trim()) {
+      setError(t("required"));
+      return;
+    }
+    const parsed = subscriptionPaymentSchema.safeParse({
+      id: editing?.id ?? crypto.randomUUID(),
+      providerId: account.providerId,
+      accountId: account.accountId,
+      accountLabel: account.label,
+      // 只修改金额时保留原来的绝对账期边界，不能因设备时区改变悄悄改写旧账。
+      start:
+        editing && start === dateText(editing.start)
+          ? editing.start
+          : new Date(`${start}T00:00:00`).getTime(),
+      end: editing && end === dateText(editing.end - 1) ? editing.end : nextDay(end),
+      amount: Number(amount),
+      currency,
+    });
+    if (!parsed.success) {
+      setError(t("invalid"));
+      return;
+    }
+    if (
+      payments.some(
+        (p) =>
+          p.id !== parsed.data.id &&
+          p.providerId === parsed.data.providerId &&
+          p.accountId === parsed.data.accountId &&
+          p.start < parsed.data.end &&
+          parsed.data.start < p.end,
+      )
+    ) {
+      setError(t("overlap"));
+      return;
+    }
+    setBusy(true);
+    try {
+      await update({ subscriptionPayments: { [parsed.data.id]: parsed.data } });
+      setSelected(parsed.data.id);
+      setOpen(false);
+    } catch (reason) {
+      setError(String(reason));
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <section className="space-y-3 rounded-xl bg-surface p-4">
+      <div className="flex items-center justify-between gap-2">
+        <h3 className="text-ui-base font-medium">{t("title")}</h3>
+        <Button variant="outline" onClick={() => edit()}>
+          <Plus className="size-3.5" />
+          {t("add")}
+        </Button>
+      </div>
+      <p className="text-ui-sm text-foreground-subtle">{t("description")}</p>
+      {payments.map((item) => (
+        <div
+          key={item.id}
+          className="flex flex-wrap items-center gap-2 border-t border-border pt-3"
+        >
+          <Button
+            variant="ghost"
+            className="min-w-0 flex-1 justify-start text-left"
+            onClick={() => setSelected(item.id)}
+          >
+            <span className="truncate">{item.accountLabel}</span>
+          </Button>
+          <span className="text-ui-sm text-foreground-subtle">
+            {dateText(item.start)} — {dateText(item.end - 1)}
+          </span>
+          <span className="text-ui-sm font-medium tabular-nums">
+            {money(item.amount, item.currency)}
+          </span>
+          <Button variant="ghost" size="icon-sm" aria-label={t("edit")} onClick={() => edit(item)}>
+            <Pencil className="size-3.5" />
+          </Button>
+          <Button
+            variant="ghost"
+            size="icon-sm"
+            aria-label={t("remove")}
+            onClick={() =>
+              void update({ subscriptionPayments: { [item.id]: null } }).catch((reason) =>
+                setError(String(reason)),
+              )
+            }
+          >
+            <Trash2 className="size-3.5" />
+          </Button>
+        </div>
+      ))}
+      {reading ? <p className="text-ui-sm text-foreground-subtle">{t("loading")}</p> : null}
+      {payment && allocation ? (
+        <div className="space-y-2 border-t border-border pt-3">
+          <p className="text-ui-sm text-foreground-subtle">
+            {t(
+              allocation.basis === "credits"
+                ? "credits"
+                : allocation.basis === "api-value"
+                  ? "api"
+                  : "unavailable",
+            )}
+            {payment.end > Date.now() ? ` · ${t("provisional")}` : ""}
+          </p>
+          {allocation.models.map((model) => (
+            <div key={model.modelId} className="flex flex-wrap justify-between gap-2 text-ui-sm">
+              <span className="font-mono">{model.modelId}</span>
+              <span>
+                {money(model.amount, payment.currency)}
+                {model.perMillionTokens !== null
+                  ? ` · ${money(model.perMillionTokens, payment.currency)} / 1M Tokens`
+                  : ""}
+              </span>
+            </div>
+          ))}
+        </div>
+      ) : null}
+      {error && !open ? (
+        <p role="alert" className="text-ui-sm text-destructive">
+          {error}
+        </p>
+      ) : null}
+      <Dialog
+        open={open}
+        onOpenChange={(value) => {
+          if (!busy) setOpen(value);
+        }}
+      >
+        <DialogContent className="sm:max-w-[480px]">
+          <DialogHeader>
+            <DialogTitle>{t(editing ? "edit" : "add")}</DialogTitle>
+            <DialogDescription>{t("description")}</DialogDescription>
+          </DialogHeader>
+          <div className="space-y-3">
+            <label className="block space-y-1 text-ui-sm">
+              <span>{t("account")}</span>
+              <Select
+                value={accountKey}
+                onValueChange={setAccountKey}
+                disabled={accounts === undefined}
+              >
+                <SelectTrigger className="w-full">
+                  <SelectValue
+                    placeholder={
+                      accounts === undefined
+                        ? intl.formatMessage({ id: "common.loading" })
+                        : t("account")
+                    }
+                  />
+                </SelectTrigger>
+                <SelectContent>
+                  {options.map((a) => (
+                    <SelectItem
+                      key={JSON.stringify([a.providerId, a.accountId])}
+                      value={JSON.stringify([a.providerId, a.accountId])}
+                    >
+                      {a.label}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+              {accounts?.length === 0 && !editing && !error ? (
+                <span className="text-foreground-subtle">{t("noAccounts")}</span>
+              ) : null}
+            </label>
+            <div className="grid grid-cols-2 gap-3">
+              <label className="space-y-1 text-ui-sm">
+                {t("start")}
+                <Input
+                  className="[color-scheme:light] dark:[color-scheme:dark]"
+                  type="date"
+                  value={start}
+                  onChange={(e) => setStart(e.target.value)}
+                />
+              </label>
+              <label className="space-y-1 text-ui-sm">
+                {t("end")}
+                <Input
+                  className="[color-scheme:light] dark:[color-scheme:dark]"
+                  type="date"
+                  value={end}
+                  onChange={(e) => setEnd(e.target.value)}
+                />
+              </label>
+            </div>
+            <div className="flex items-end gap-3">
+              <label className="min-w-0 flex-1 space-y-1 text-ui-sm">
+                {t("amount")}
+                <Input
+                  type="number"
+                  min="0"
+                  step="0.01"
+                  value={amount}
+                  onChange={(e) => setAmount(e.target.value)}
+                />
+              </label>
+              <Select
+                value={currency}
+                onValueChange={(v) => setCurrency(v as SubscriptionPayment["currency"])}
+              >
+                <SelectTrigger className="w-24" aria-label={t("currency")}>
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  {["CNY", "USD", "EUR", "GBP", "JPY"].map((c) => (
+                    <SelectItem key={c} value={c}>
+                      {c}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            </div>
+            {error ? (
+              <p role="alert" className="text-ui-sm text-destructive">
+                {error}
+              </p>
+            ) : null}
+          </div>
+          <DialogFooter>
+            <Button variant="ghost" disabled={busy} onClick={() => setOpen(false)}>
+              {intl.formatMessage({ id: "common.cancel" })}
+            </Button>
+            <Button disabled={busy} onClick={() => void save()}>
+              {intl.formatMessage({ id: "common.save" })}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </section>
+  );
+}
