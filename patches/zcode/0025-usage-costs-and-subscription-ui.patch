+import { useMemo } from "react";
+import type { AppUsageSnapshot } from "@zcode/shared";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+export function UsageAccountingPanel({ snapshot }: { snapshot: AppUsageSnapshot }) {
+  const { intl, locale } = useZCodeIntl();
+  const platform = usePlatform();
+  const t = (key: string) => intl.formatMessage({ id: `settings.usage.accounting.${key}` });
+  const rows = useMemo(() => {
+    const groups = new Map<
+      string,
+      {
+        modelId: string;
+        requests: number;
+        reports: number;
+        input: number;
+        output: number;
+        cache: number;
+        cacheInput: number;
+        cacheReports: number;
+        usd: number;
+        priced: number;
+        fast: number;
+        speedReports: number;
+      }
+    >();
+    for (const row of snapshot.accounting ?? []) {
+      const item = groups.get(row.modelId) ?? {
+        modelId: row.modelId,
+        requests: 0,
+        reports: 0,
+        input: 0,
+        output: 0,
+        cache: 0,
+        cacheInput: 0,
+        cacheReports: 0,
+        usd: 0,
+        priced: 0,
+        fast: 0,
+        speedReports: 0,
+      };
+      item.requests += row.requestCount;
+      item.reports += row.reportedCount;
+      item.input += row.inputTokens;
+      item.output += row.outputTokens;
+      item.cache += row.cacheReadTokens;
+      item.cacheInput += row.cacheInputTokens;
+      item.cacheReports += row.cacheReportedCount;
+      item.usd += row.estimatedUsd;
+      item.priced += row.pricedCount;
+      if (row.speedMode === "fast") item.fast += row.requestCount;
+      if (row.speedMode) item.speedReports += row.requestCount;
+      groups.set(row.modelId, item);
+    }
+    return [...groups.values()];
+  }, [snapshot.accounting]);
+  const number = (value: number) =>
+    new Intl.NumberFormat(locale, { notation: "compact", maximumFractionDigits: 1 }).format(value);
+  const money = (value: number) =>
+    new Intl.NumberFormat(locale, {
+      style: "currency",
+      currency: "USD",
+      maximumFractionDigits: 4,
+    }).format(value);
+  return (
+    <section className="space-y-3 rounded-xl bg-surface p-4">
+      <h3 className="text-ui-base font-medium">{t("title")}</h3>
+      <div className="overflow-x-auto">
+        <table className="w-full text-left text-ui-sm">
+          <thead className="text-foreground-subtle">
+            <tr>
+              {["model", "input", "output", "cache", "fast", "estimate"].map((key) => (
+                <th key={key} className="whitespace-nowrap px-2 py-2 font-medium">
+                  {t(key)}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((row) => (
+              <tr key={row.modelId} className="border-t border-border">
+                <td className="px-2 py-3 font-mono">{row.modelId}</td>
+                <td className="px-2 py-3 tabular-nums">
+                  {row.reports > 0 ? number(row.input) : "—"}
+                </td>
+                <td className="px-2 py-3 tabular-nums">
+                  {row.reports > 0 ? number(row.output) : "—"}
+                </td>
+                <td className="px-2 py-3 tabular-nums">
+                  {row.cacheInput > 0
+                    ? new Intl.NumberFormat(locale, {
+                        style: "percent",
+                        maximumFractionDigits: 1,
+                      }).format(row.cache / row.cacheInput)
+                    : "—"}
+                  {row.cacheReports < row.requests ? (
+                    <div className="text-ui-xs text-foreground-subtle">
+                      {t("partial")}: {row.cacheReports}/{row.requests}
+                    </div>
+                  ) : null}
+                </td>
+                <td className="px-2 py-3 tabular-nums">
+                  {row.speedReports > 0 ? `${row.fast}/${row.speedReports}` : "—"}
+                </td>
+                <td className="px-2 py-3 tabular-nums">
+                  {row.priced > 0 ? money(row.usd) : "—"}
+                  {row.priced < row.requests ? (
+                    <div className="text-ui-xs text-foreground-subtle">
+                      {t("priced")}: {row.priced}/{row.requests}
+                    </div>
+                  ) : null}
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+      {!rows.length ? <p className="text-ui-sm text-foreground-subtle">{t("empty")}</p> : null}
+      <p className="text-ui-xs text-foreground-subtle">{t("note")}</p>
+      <div className="flex flex-wrap items-center gap-2 text-ui-xs text-foreground-subtle">
+        <span>{t("verified")}</span>
+        <Button
+          variant="link"
+          className="h-auto p-0 text-ui-xs"
+          onClick={() =>
+            void platform.openExternal("https://developers.openai.com/api/docs/pricing")
+          }
+        >
+          OpenAI
+        </Button>
+        <Button
+          variant="link"
+          className="h-auto p-0 text-ui-xs"
+          onClick={() => void platform.openExternal("https://learn.chatgpt.com/docs/pricing")}
+        >
+          ChatGPT
+        </Button>
+        <Button
+          variant="link"
+          className="h-auto p-0 text-ui-xs"
+          onClick={() =>
+            void platform.openExternal("https://api-docs.deepseek.com/quick_start/pricing")
+          }
+        >
+          DeepSeek
+        </Button>
+      </div>
+    </section>
+  );
+}
