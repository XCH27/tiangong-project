+
+async function fixture(){
+ const dir=await mkdtemp(join(tmpdir(),"fleet-cost-test-"));const path=join(dir,"session.sqlite");let store=new SqliteSessionStore({dbPath:path});
+ const sessionID="session" as SessionId;
+ await store.createSession({id:sessionID,projectID:"project" as ProjectId,slug:"fixture",directory:dir,title:"fixture",version:"fixture"});
+ const record=async(id:string,accountId:string|undefined,speed:"standard"|"fast"|undefined,patch:Partial<ModelUsageRecord>={})=>store.recordModelUsage({
+  id,logicalRequestId:id,sessionID,querySource:"main_turn",providerId:"chat",modelId:"gpt-6-sol",status:"completed",startedAt:Date.UTC(2026,7,1),
+  inputTokens:1000,outputTokens:100,cacheReadInputTokens:800,
+  rawUsage:{inputTokens:1000,outputTokens:100,cacheReadTokens:800,cacheWriteTokens:0},
+  providerMetadata:{fleetAccounting:{accountId,billingProvider:accountId?"openai":undefined,authKind:"subscription",requestedSpeedMode:speed}},...patch,
+ });
+ return {path,record,query:(since=0,until=Date.UTC(2026,9,1))=>store.queryAppUsage({since,until,tzOffsetMs:0}),reopen(){store.close();store=new SqliteSessionStore({dbPath:path});},async close(){store.close();await rm(dir,{recursive:true,force:true});}};
+}
+
+test("accounting survives reopen and retention; same logical request is not counted twice",async()=>{
+ const f=await fixture();try{
