@@ -0,0 +1,53 @@
+import type { DatabaseSync } from "node:sqlite";
+import type { ModelUsageRecord } from "@zcode/contracts";
+import type { UsageAccountingRow } from "@zcode/shared";
+import { estimateUsagePrice } from "@zcode/shared";
+
+const object = (value:unknown): Record<string,unknown> => value && typeof value === "object" && !Array.isArray(value) ? value as Record<string,unknown> : {};
+const count = (value:unknown) => typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+
+export function accountingSnapshot(input:ModelUsageRecord) {
+  const usage=object(input.rawUsage);
+  const metadata=object(input.providerMetadata);
+  const identity=object(metadata.fleetAccounting);
+  const speed=identity.servedSpeedMode ?? identity.requestedSpeedMode;
+  const price=estimateUsagePrice({
+    billingProvider: identity.billingProvider as "openai" | "anthropic" | "deepseek" | undefined,
+    modelId:String(input.modelId), startedAt:input.startedAt,
+    inputTokens:count(usage.inputTokens),outputTokens:count(usage.outputTokens),
+    cacheReadTokens:count(usage.cacheReadTokens),cacheWriteTokens:count(usage.cacheWriteTokens),
+    speedMode:speed === "fast" || speed === "standard" ? speed : undefined,
+    subscription:identity.authKind === "subscription",
+  });
+  return {
+    ...identity, ...price,
+    inputTokens:count(usage.inputTokens),outputTokens:count(usage.outputTokens),
+    cacheReadTokens:count(usage.cacheReadTokens),cacheWriteTokens:count(usage.cacheWriteTokens),
+  };
+}
+
+/** Existing ledger query: no inference from a provider's current account or model configuration. */
+export function queryAccounting(db:DatabaseSync,since:number,until:number):UsageAccountingRow[] {
+  return db.prepare(`with facts as (
+    select provider_id as providerId, model_id as modelId, started_at,
+      json_extract(accounting_json,'$.accountId') as accountId,
+      json_extract(accounting_json,'$.requestedSpeedMode') as speedMode,
+      json_extract(accounting_json,'$.inputTokens') as inputTokens,
+      json_extract(accounting_json,'$.outputTokens') as outputTokens,
+      json_extract(accounting_json,'$.cacheReadTokens') as cacheReadTokens,
+      json_extract(accounting_json,'$.estimatedUsd') as estimatedUsd,
+      json_extract(accounting_json,'$.estimatedCredits') as estimatedCredits,
+      json_extract(accounting_json,'$.priceVersion') as priceVersion
+    from model_usage where started_at >= ? and started_at < ?
+  ) select providerId,accountId,modelId,speedMode,count(*) as requestCount,
+    sum(case when inputTokens is not null and outputTokens is not null then 1 else 0 end) as reportedCount,
+    coalesce(sum(inputTokens),0) as inputTokens,coalesce(sum(outputTokens),0) as outputTokens,
+    coalesce(sum(case when cacheReadTokens between 0 and inputTokens then cacheReadTokens end),0) as cacheReadTokens,
+    coalesce(sum(case when cacheReadTokens between 0 and inputTokens then inputTokens end),0) as cacheInputTokens,
+    sum(case when cacheReadTokens between 0 and inputTokens then 1 else 0 end) as cacheReportedCount,
+    coalesce(sum(estimatedUsd),0) as estimatedUsd,count(estimatedUsd) as pricedCount,
+    coalesce(sum(estimatedCredits),0) as estimatedCredits,count(estimatedCredits) as creditCount,
+    min(started_at) as firstAt,max(started_at) as lastAt,group_concat(distinct priceVersion) as priceVersions
+    from facts group by providerId,accountId,modelId,speedMode order by inputTokens+outputTokens desc
+  `).all(since,until) as unknown as UsageAccountingRow[];
+}
