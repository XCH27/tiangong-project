--- /dev/null
+++ b/packages/services/test/subscription-payment-settings.test.ts
@@ -0,0 +1,20 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {mkdtemp,rm} from "node:fs/promises";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {createSettingService} from "../src/setting/settingService.js";
+
+test("payment records persist/reopen and concurrent per-key updates cannot erase another account",async()=>{
+ const dir=await mkdtemp(join(tmpdir(),"fleet-payments-"));const previous=process.env.ZCODE_DESKTOP_HOME_DIR;process.env.ZCODE_DESKTOP_HOME_DIR=dir;
+ try{
+  const service=createSettingService();const one={id:"one",providerId:"chat",accountId:"a",accountLabel:"A",start:1,end:20,amount:20,currency:"USD" as const};
+  const two={...one,id:"two",accountId:"b",currency:"CNY" as const,amount:100};
+  await Promise.all([service.update({subscriptionPayments:{one}}),service.update({subscriptionPayments:{two}})]);
+  assert.deepEqual((await createSettingService().get()).subscriptionPayments,{one,two});
