diff --git a/packages/services/test/usage-price.test.ts b/packages/services/test/usage-price.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48b9620942d42177f7bae4178f030131d47adca1
--- /dev/null
+++ b/packages/services/test/usage-price.test.ts
@@ -0,0 +1,192 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { estimateUsagePrice, type UsagePriceInput } from "../../shared/src/usage-price.js";
+
+const request: UsagePriceInput = {
+  billingProvider: "openai",
+  modelId: "gpt-6-astra",
+  startedAt: Date.parse("2026-09-28T02:00:00Z"),
+  inputTokens: 10_000,
+  outputTokens: 1_000,
+  cacheReadTokens: 6_000,
+  cacheWriteTokens: 2_000,
+  speedMode: "standard",
+};
+
+function close(actual: number | undefined, expected: number) {
+  assert.ok(actual !== undefined);
+  assert.ok(Math.abs(actual - expected) < 1e-10, `${actual} != ${expected}`);
+}
+
+test("API pricing subtracts inclusive cache subsets before applying their own rates", () => {
+  const price = estimateUsagePrice(request);
+  close(price.estimatedUsd, 0.101);
+  assert.equal(price.estimatedCredits, undefined);
+  assert.equal(price.priceVersion, "official-2026-09-27");
+  assert.equal(price.sourceUrl, "https://developers.openai.com/api/docs/pricing");
+  assert.equal(price.reason, undefined);
+});
+
+test("exact catalog supports the configured OpenAI models and their Fast API rates", () => {
+  for (const [modelId, standard, fast] of [
+    ["gpt-6-astra", 0.101, 0.202],
+    ["gpt-6-sol", 0.0202, 0.0404],
+    ["gpt-6-luna", 0.00101, 0.00202],
+    ["gpt-5.6-sol", 0.0404, 0.0808],
+    ["gpt-5.6-terra", 0.0222, 0.0444],
+    ["gpt-5.6-luna", 0.00222, 0.00444],
+    ["gpt-5.5", 0.053, 0.1325],
+  ] as const) {
+    close(estimateUsagePrice({ ...request, modelId }).estimatedUsd, standard);
+    close(estimateUsagePrice({ ...request, modelId, speedMode: "fast" }).estimatedUsd, fast);
+  }
+});
+
+test("OpenAI long tier starts strictly above 272K inclusive input, affecting the full request", () => {
+  const short = { ...request, inputTokens: 272_000 };
+  close(estimateUsagePrice(short).estimatedUsd, 2.721);
+  close(estimateUsagePrice({ ...short, inputTokens: 272_001 }).estimatedUsd, 5.41702);
+  close(
+    estimateUsagePrice({ ...short, inputTokens: 272_001, speedMode: "fast" }).estimatedUsd,
+    10.83404,
+  );
+  assert.equal(
+    estimateUsagePrice({ ...short, modelId: "gpt-5.5", inputTokens: 272_001, speedMode: "fast" })
+      .reason,
+    "long-context-fast-price-unavailable",
+  );
+});
+
+test("subscription credits have no write surcharge and use their own Fast multiplier", () => {
+  const standard = estimateUsagePrice({ ...request, subscription: true });
+  const fast = estimateUsagePrice({ ...request, subscription: true, speedMode: "fast" });
+  close(standard.estimatedUsd, 0.101);
+  close(standard.estimatedCredits, 2.4);
+  close(fast.estimatedUsd, 0.202);
+  close(fast.estimatedCredits, 6);
+  const missingWrites = estimateUsagePrice({
+    ...request,
+    subscription: true,
+    cacheWriteTokens: undefined,
+  });
+  close(missingWrites.estimatedCredits, 2.4);
+  assert.equal(missingWrites.estimatedUsd, undefined);
+  assert.equal(missingWrites.reason, "api-cache-write-tokens-missing");
+  close(
+    estimateUsagePrice({ ...request, subscription: true, cacheWriteTokens: 0 }).estimatedUsd,
+    0.096,
+  );
+});
+
+test("missing usage or speed is unknown, explicit zero remains a priced zero", () => {
+  for (const field of ["inputTokens", "outputTokens", "cacheReadTokens", "speedMode"] as const) {
+    const result = estimateUsagePrice({ ...request, [field]: undefined });
+    assert.equal(result.estimatedUsd, undefined);
+    assert.ok(result.reason?.includes("missing"));
+  }
+  assert.equal(
+    estimateUsagePrice({ ...request, cacheWriteTokens: undefined }).estimatedUsd,
+    undefined,
+  );
+  close(
+    estimateUsagePrice({ ...request, modelId: "gpt-5.5", cacheWriteTokens: undefined })
+      .estimatedUsd,
+    0.053,
+  );
+  const zero = estimateUsagePrice({
+    ...request,
+    inputTokens: 0,
+    outputTokens: 0,
+    cacheReadTokens: 0,
+    cacheWriteTokens: 0,
+    subscription: true,
+  });
+  assert.equal(zero.estimatedUsd, 0);
+  assert.equal(zero.estimatedCredits, 0);
+});
+
+test("invalid counters, overlapping subsets, identities and dates never produce a price", () => {
+  const badInputs: UsagePriceInput[] = [
+    ...[-1, NaN, Infinity, 0.5, Number.MAX_SAFE_INTEGER + 1].map((inputTokens) => ({
+      ...request,
+      inputTokens,
+    })),
+    { ...request, cacheReadTokens: 9_000 },
+    { ...request, cacheWriteTokens: 20_000 },
+    { ...request, outputTokens: -1 },
+    { ...request, cacheWriteTokens: -1 },
+    { ...request, startedAt: NaN },
+    { ...request, startedAt: Number.MAX_SAFE_INTEGER },
+    { ...request, billingProvider: undefined },
+    { ...request, billingProvider: "anthropic" },
+    { ...request, modelId: "gpt-6-astra-2026-09-01" },
+    { ...request, modelId: "vendor/gpt-6-astra" },
+    { ...request, modelId: "GPT-6-ASTRA" },
+    { ...request, modelId: "toString" },
+  ];
+  for (const input of badInputs) {
+    const result = estimateUsagePrice(input);
+    assert.equal(result.estimatedUsd, undefined);
+    assert.equal(result.estimatedCredits, undefined);
+    assert.ok(result.reason);
+  }
+});
+
+test("DeepSeek prices exact models with inclusive cache reads and no separate write charge", () => {
+  for (const [modelId, peak, offPeak] of [
+    ["deepseek-flash", 0.002436, 0.001218],
+    ["deepseek-v4-pro", 0.009504, 0.004752],
+  ] as const) {
+    const input = {
+      ...request,
+      modelId,
+      billingProvider: "deepseek" as const,
+      cacheWriteTokens: undefined,
+    };
+    close(estimateUsagePrice(input).estimatedUsd, peak);
+    close(
+      estimateUsagePrice({ ...input, startedAt: Date.parse("2026-09-28T12:00:00Z") }).estimatedUsd,
+      offPeak,
+    );
+    close(
+      estimateUsagePrice({ ...input, startedAt: Date.parse("2026-09-26T02:00:00Z") }).estimatedUsd,
+      offPeak,
+    );
+    close(
+      estimateUsagePrice({ ...input, startedAt: Date.parse("2026-09-25T02:00:00Z") }).estimatedUsd,
+      offPeak,
+    );
+    assert.equal(estimateUsagePrice({ ...input, speedMode: "fast" }).estimatedUsd, undefined);
+  }
+});
+
+test("DeepSeek peak boundaries, weekend workdays and unverified holiday years remain explicit", () => {
+  const input = { ...request, billingProvider: "deepseek" as const, modelId: "deepseek-flash" };
+  for (const [time, peak] of [
+    ["00:59:59.999", false],
+    ["01:00:00", true],
+    ["03:59:59.999", true],
+    ["04:00:00", false],
+    ["05:59:59.999", false],
+    ["06:00:00", true],
+    ["09:59:59.999", true],
+    ["10:00:00", false],
+  ] as const) {
+    close(
+      estimateUsagePrice({ ...input, startedAt: Date.parse(`2026-09-28T${time}Z`) }).estimatedUsd,
+      peak ? 0.002436 : 0.001218,
+    );
+  }
+  close(
+    estimateUsagePrice({ ...input, startedAt: Date.parse("2026-09-20T02:00:00Z") }).estimatedUsd,
+    0.001218,
+  );
+  assert.equal(
+    estimateUsagePrice({ ...input, startedAt: Date.parse("2027-09-27T02:00:00Z") }).reason,
+    "deepseek-holiday-calendar-unavailable",
+  );
+  close(
+    estimateUsagePrice({ ...input, startedAt: Date.parse("2027-09-27T12:00:00Z") }).estimatedUsd,
+    0.001218,
+  );
+});
