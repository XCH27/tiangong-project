diff --git a/packages/ui/test/subscriptionPaymentAccounts.test.ts b/packages/ui/test/subscriptionPaymentAccounts.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cb503c5730eef39186428b2fd266682861321c1
--- /dev/null
+++ b/packages/ui/test/subscriptionPaymentAccounts.test.ts
@@ -0,0 +1,50 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IProviderSettingsService, ProviderSettingsView } from "@zcode/services";
+import { readPaymentAccounts } from "../src/settings/usage-stats/subscriptionPaymentAccounts.js";
+
+test("payment choices share the added-service scope, retaining distinct saved accounts and paused plans", async () => {
+  const providers = [
+    {
+      providerId: "hidden",
+      effectiveConfig: { group: "zai-family", access: { type: "zhipu-account" } },
+    },
+    {
+      providerId: "chat",
+      providerName: "ChatGPT",
+      effectiveConfig: { group: "standard-personal", access: { type: "subscription" } },
+    },
+    {
+      providerId: "plan",
+      providerName: "Plan",
+      templateId: "plan-template",
+      enabled: false,
+      effectiveConfig: { group: "standard-personal", access: { type: "api-key" } },
+    },
+    {
+      providerId: "api",
+      effectiveConfig: { group: "standard-personal", access: { type: "api-key" } },
+    },
+  ];
+  const view = {
+    providers,
+    providerTemplates: [{ templateId: "plan-template", category: "subscription-plan" }],
+  } as unknown as ProviderSettingsView;
+  const service = {
+    getView: async () => view,
+    getSubscriptionAccounts: async (providerId: string) => {
+      assert.equal(providerId, "chat");
+      return {
+        accounts: [
+          { id: "a", label: "Account A" },
+          { id: "b", label: "Account B" },
+        ],
+      };
+    },
+  } as unknown as IProviderSettingsService;
+  assert.deepEqual(await readPaymentAccounts(service, "Entire connection"), [
+    { providerId: "chat", accountId: "a", label: "ChatGPT · Account A" },
+    { providerId: "chat", accountId: "b", label: "ChatGPT · Account B" },
+    { providerId: "plan", accountId: "connection", label: "Plan · Entire connection" },
+  ]);
+});
