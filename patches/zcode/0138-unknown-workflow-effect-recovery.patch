+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { WorkflowError } from "../src/engine/types.js";
+import { fixture } from "./helpers/world-run-recovery-fixture.js";
+import {
+  snapshotOf,
+  isResumableRecord,
+} from "../../bootstrap/src/app/dynamic-workflow-run-observation.js";
+import { replayRunProgress } from "../../bootstrap/src/app/dynamic-workflow-run-replay.js";
+
+test(
+  "an opaque command with an unknown outcome is not repeated after cold recovery",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const effected = Promise.withResolvers<void>();
+      // The actual child process has committed its effect, but the engine has no receipt.
+      const first = f.engine(() => {
+        effected.resolve();
+        return new Promise(() => {});
+      });
+      void first.worldRead("effect-site", "run", f.args);
+      await effected.promise;
+      assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+      const unresolved = f.store.workflowJournalStore().getNode("proof", "effect-site", 1);
+      assert.equal(unresolved?.status, "running");
+      f.reopen();
+
+      for (let attempt = 0; attempt < 2; attempt++) {
+        const resumed = f.engine();
+        await assert.rejects(resumed.worldRead("effect-site", "run", f.args), (error: unknown) => {
+          assert.ok(error instanceof WorkflowError);
+          assert.equal(error.code, "Interrupted");
+          assert.match(error.message, /outcome is unknown/);
+          assert.match(error.message, /effect-site@1/);
+          assert.match(error.message, /inspect.*effect/i);
+          return true;
+        });
+        const settlement = await resumed.settled;
+        assert.equal(settlement.status, "stopped");
+        assert.equal(settlement.status === "stopped" && settlement.reason, "interrupted");
+        const journal = f.store.workflowJournalStore();
+        assert.deepEqual(journal.getNode("proof", "effect-site", 1), unresolved);
+        const run = journal.getRun("proof")!;
+        assert.equal(run.status, "stopped");
+        assert.equal(run.stopReason, "interrupted");
+        assert.equal(run.failure?.code, "Interrupted");
+        assert.equal(isResumableRecord(run), true);
+        const snapshot = snapshotOf("proof", new Map(), journal)!;
+        assert.equal(snapshot.failure?.code, "Interrupted");
+        assert.match(snapshot.error!, /outcome is unknown/);
+        const row = journal.listRunsByParentSession("parent", 1)[0]!;
+        const terminal = replayRunProgress(row, journal, 1).at(-1)!;
+        assert.equal(terminal.eventType, "run-settled");
+        assert.equal(terminal.payload.resumable, true);
+        assert.deepEqual(terminal.payload.error, run.failure);
+        assert.equal(f.dispatches, 1);
+        assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+        f.reopen();
+      }
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "a changed recovery input refuses before an unknown command can dispatch",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const effected = Promise.withResolvers<void>();
+      const first = f.engine(() => {
+        effected.resolve();
+        return new Promise(() => {});
+      });
+      void first.worldRead("effect-site", "run", f.args);
+      await effected.promise;
+      f.reopen();
+      const resumed = f.engine();
+      await assert.rejects(resumed.worldRead("effect-site", "run", [process.execPath, []]), {
+        code: "InputHashMismatch",
+      });
+      assert.equal((await resumed.settled).status, "errored");
+      assert.equal(f.dispatches, 1);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "completed commands keep their durable cached result across cold recovery",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const first = f.engine();
+      const result = await first.worldRead("effect-site", "run", f.args);
+      f.reopen();
+      const resumed = f.engine();
+      assert.deepEqual(await resumed.worldRead("effect-site", "run", f.args), result);
+      assert.equal(f.dispatches, 1);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+      resumed.complete(result);
+      assert.equal((await resumed.settled).status, "completed");
+      assert.equal(
+        f.store.workflowJournalStore().getNode("proof", "effect-site", 1)?.status,
+        "completed",
+      );
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "a command with no admission record dispatches normally after cold recovery",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.engine();
+      f.reopen();
+      const resumed = f.engine();
+      const result = await resumed.worldRead("effect-site", "run", f.args);
+      resumed.complete(result);
+      assert.equal((await resumed.settled).status, "completed");
+      assert.equal(f.dispatches, 1);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test("an interrupted read retains its safe live replay behavior", { timeout: 10000 }, async () => {
+  const f = await fixture();
+  try {
+    await writeFile(join(f.root, "input.txt"), "old observation");
+    const observed = Promise.withResolvers<void>();
+    const first = f.engine(() => {
+      observed.resolve();
+      return new Promise(() => {});
+    });
+    void first.worldRead("read-site", "read", ["input.txt"]);
+    await observed.promise;
+    f.reopen();
+    await writeFile(join(f.root, "input.txt"), "current observation");
+    const resumed = f.engine();
+    const result = await resumed.worldRead("read-site", "read", ["input.txt"]);
+    assert.equal(result, "current observation");
+    assert.equal(f.dispatches, 2);
+    resumed.complete(result);
+  } finally {
+    await f.close();
+  }
+});
