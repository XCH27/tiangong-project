+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { WorkflowError } from "../src/engine/types.js";
+import { fixture } from "./helpers/world-run-recovery-fixture.js";
+import {
+  buildImportedCache,
+  rebuildImportedCacheForResume,
+} from "../../bootstrap/src/app/dynamic-workflow-import.js";
+
+test(
+  "an identical completed verifier runs against changed sources after cache closure",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const source = join(f.root, "source.txt");
+      await writeFile(source, "old source");
+      const checkArgs = [
+        process.execPath,
+        [
+          "-e",
+          "process.stdout.write(require('node:fs').readFileSync(process.argv[1], 'utf8'))",
+          source,
+        ],
+      ];
+      const original = f.engine();
+      const first = await original.worldRead("build-site", "run", checkArgs);
+      assert.deepEqual(first, { exitCode: 0, stdout: "old source", stderr: "" });
+      original.complete(first);
+      f.reopen();
+      const built = await buildImportedCache({ journal: f.store.workflowJournalStore() }, "proof");
+      assert.ok(built.ok);
+      const revision = f.engine(undefined, {
+        runId: "revision",
+        resumedFrom: "proof",
+        importedCache: built.cache,
+      });
+      const mutationArgs = [
+        process.execPath,
+        ["-e", "require('node:fs').writeFileSync(process.argv[1], 'new source')", source],
+      ];
+      await revision.worldRead("change-source", "run", mutationArgs);
+      assert.deepEqual(await revision.worldRead("build-site", "run", checkArgs), {
+        exitCode: 0,
+        stdout: "new source",
+        stderr: "",
+      });
+      assert.equal(f.dispatches, 3);
+      revision.complete("current verification complete");
+      f.reopen();
+      const intermediateCache = await buildImportedCache(
+        { journal: f.store.workflowJournalStore() },
+        "proof",
+      );
+      assert.ok(intermediateCache.ok);
+      const intermediate = f.engine(undefined, {
+        runId: "intermediate",
+        resumedFrom: "proof",
+        importedCache: intermediateCache.cache,
+      });
+      const laterMutation = [
+        process.execPath,
+        ["-e", "require('node:fs').writeFileSync(process.argv[1], 'middle source')", source],
+      ];
+      await intermediate.worldRead("change-source", "run", laterMutation);
+      intermediate.complete("changed source without checking");
+      f.reopen();
+      const descendantCache = await buildImportedCache(
+        { journal: f.store.workflowJournalStore() },
+        "intermediate",
+      );
+      assert.ok(descendantCache.ok);
+      const descendant = f.engine(undefined, {
+        runId: "descendant",
+        resumedFrom: "intermediate",
+        importedCache: descendantCache.cache,
+      });
+      // An unconsumed completed ancestor result is a position, not a current-world result.
+      assert.deepEqual(await descendant.worldRead("build-site", "run", checkArgs), {
+        exitCode: 0,
+        stdout: "middle source",
+        stderr: "",
+      });
+      assert.equal(f.dispatches, 5);
+      descendant.complete("current descendant verification complete");
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "amended cold replay retains the completed prefix and the next identical unknown occurrence",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const effected = Promise.withResolvers<void>();
+      let calls = 0;
+      const original = f.engine(async () => {
+        calls++;
+        if (calls === 1) return { exitCode: 0, stdout: "first receipt", stderr: "" };
+        effected.resolve();
+        return new Promise(() => {});
+      });
+      const receipt = await original.worldRead("effect-site", "run", f.args);
+      void original.worldRead("effect-site", "run", f.args);
+      await effected.promise;
+      f.reopen();
+      const built = await buildImportedCache({ journal: f.store.workflowJournalStore() }, "proof");
+      assert.ok(built.ok);
+      const revision = f.engine(undefined, {
+        runId: "revision",
+        resumedFrom: "proof",
+        importedCache: built.cache,
+      });
+      assert.deepEqual(await revision.worldRead("new-site", "run", f.args), receipt);
+      // Crash the successor after the first imported receipt, before reaching the unknown second call.
+      f.reopen();
+      const cache = await rebuildImportedCacheForResume(
+        { journal: f.store.workflowJournalStore() },
+        {
+          runId: "revision",
+          predecessorRunId: "proof",
+        },
+      );
+      const resumed = f.engine(undefined, { runId: "revision", importedCache: cache });
+      assert.deepEqual(await resumed.worldRead("new-site", "run", f.args), receipt);
+      await assert.rejects(resumed.worldRead("new-site", "run", f.args), { code: "Interrupted" });
+      assert.equal((await resumed.settled).status, "stopped");
+      assert.equal(f.dispatches, 2);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\neffect\n");
+      assert.equal(
+        f.store.workflowJournalStore().getNode("revision", "new-site", 2)?.status,
+        "running",
+      );
+      assert.equal(
+        f.store.workflowJournalStore().getNode("revision", "new-site", 2)?.error?.code,
+        "Interrupted",
+      );
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "changed work does not erase unconsumed ancestor uncertainty when it closes the cache",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const effected = Promise.withResolvers<void>();
+      const original = f.engine(() => {
+        effected.resolve();
+        return new Promise(() => {});
+      });
+      void original.worldRead("effect-site", "run", f.args);
+      await effected.promise;
+      f.reopen();
+      const built = await buildImportedCache({ journal: f.store.workflowJournalStore() }, "proof");
+      assert.ok(built.ok);
+      const changedArgs = [
+        process.execPath,
+        ["-e", "require('node:fs').appendFileSync(process.argv[1], 'new\\n')", f.effect],
+      ];
+      const intermediate = f.engine(undefined, {
+        runId: "intermediate",
+        resumedFrom: "proof",
+        importedCache: built.cache,
+      });
+      await intermediate.worldRead("changed-site", "run", changedArgs);
+      intermediate.complete("changed work complete");
+      assert.equal((await intermediate.settled).status, "completed");
+      f.reopen();
+      const nextCache = await buildImportedCache(
+        { journal: f.store.workflowJournalStore() },
+        "intermediate",
+      );
+      assert.ok(nextCache.ok);
+      const next = f.engine(undefined, {
+        runId: "next",
+        resumedFrom: "intermediate",
+        importedCache: nextCache.cache,
+      });
+      // A new different command closes the cache, but cannot authorize the old unknown command.
+      const laterArgs = [
+        process.execPath,
+        ["-e", "require('node:fs').appendFileSync(process.argv[1], 'later\\n')", f.effect],
+      ];
+      await next.worldRead("later-site", "run", laterArgs);
+      assert.deepEqual(await next.worldRead("changed-site", "run", changedArgs), {
+        exitCode: 0,
+        stdout: "",
+        stderr: "",
+      });
+      await assert.rejects(next.worldRead("effect-site", "run", f.args), { code: "Interrupted" });
+      assert.equal((await next.settled).status, "stopped");
+      assert.equal(f.dispatches, 4);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\nnew\nlater\nnew\n");
+      // A separate explicit fresh execution has no recovery lineage and is still allowed.
+      const fresh = f.engine(undefined, { runId: "fresh" });
+      await fresh.worldRead("effect-site", "run", f.args);
+      fresh.complete("new execution");
+      assert.equal(f.dispatches, 5);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\nnew\nlater\nnew\neffect\n");
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "missing or cyclic recovery ancestry fails closed without blocking an independent fresh execution",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    try {
+      const journal = f.store.workflowJournalStore();
+      f.engine().stop("interrupted", new WorkflowError("Interrupted", "fixture crash"));
+      const base = journal.getRun("proof")!;
+      journal.createRun({ ...base, runId: "revision", resumedFrom: "proof" });
+      const reader = {
+        listActors: (runId: string) => journal.listActors(runId),
+        listNodes: (runId: string) => journal.listNodes(runId),
+        getRun: (runId: string) => (runId === "proof" ? undefined : journal.getRun(runId)),
+      };
+      await assert.rejects(
+        rebuildImportedCacheForResume(
+          { journal: reader },
+          {
+            runId: "revision",
+            predecessorRunId: "proof",
+          },
+        ),
+        { code: "Interrupted" },
+      );
+      assert.deepEqual(journal.getRun("revision"), {
+        ...base,
+        runId: "revision",
+        resumedFrom: "proof",
+      });
+      await assert.rejects(buildImportedCache({ journal: reader }, "revision"), {
+        code: "Interrupted",
+      });
+      const cyclic = {
+        ...reader,
+        getRun: (runId: string) =>
+          runId === "proof" ? { ...base, resumedFrom: "revision" } : journal.getRun(runId),
+      };
+      await assert.rejects(buildImportedCache({ journal: cyclic }, "revision"), {
+        code: "Interrupted",
+      });
+      const fresh = f.engine(undefined, { runId: "unrelated" });
+      await fresh.worldRead("effect-site", "run", f.args);
+      fresh.complete("new work");
+      assert.equal(f.dispatches, 1);
+      assert.equal(await readFile(f.effect, "utf8"), "effect\n");
+    } finally {
+      await f.close();
+    }
+  },
+);
