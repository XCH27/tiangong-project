+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { WorkflowEngine, type EngineConfig } from "../../src/engine/engine.js";
+import type { WorkflowDriver } from "../../src/engine/types.js";
+import { SqliteSessionStore } from "../../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { createNodeExecutionAdapter } from "../../../adapters/src/exec/node-execution-adapter.js";
+import { NodeFileSystemAdapter } from "../../../adapters/src/fs/index.js";
+import { executeWorldRead } from "../../../bootstrap/src/app/workflow-world-read.js";
+import { reconcileOrphanRuns } from "../../../bootstrap/src/app/dynamic-workflow-run-reconcile.js";
+
+export async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-world-run-recovery-"));
+  const effect = join(root, "effect.txt");
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  const executionPort = createNodeExecutionAdapter();
+  const args = [
+    process.execPath,
+    ["-e", "require('node:fs').appendFileSync(process.argv[1], 'effect\\n')", effect],
+  ];
+  const events: unknown[] = [];
+  let dispatches = 0;
+  const engine = (afterExecute?: () => Promise<unknown>, options: Partial<EngineConfig> = {}) => {
+    const driver: WorkflowDriver = {
+      journal: store.workflowJournalStore(),
+      emit: (event) => events.push(event),
+      createActorSession: async () => {
+        throw new Error("No actor in this fixture");
+      },
+      startAsk: () => {
+        throw new Error("No ask in this fixture");
+      },
+      respondToSubmit: () => {},
+      cancelAsk: () => {},
+      executeWorldRead: async (op, input) => {
+        dispatches++;
+        const result = await executeWorldRead(
+          {
+            cwd: root,
+            executionPort,
+            fileSystemPort: new NodeFileSystemAdapter(),
+            declaredRunCommands: new Set([process.execPath]),
+          },
+          op,
+          input,
+        );
+        return afterExecute === undefined ? result : afterExecute();
+      },
+    };
+    return new WorkflowEngine({
+      runId: "proof",
+      parentSessionId: "parent",
+      cwd: root,
+      scriptText: "same immutable script",
+      scriptHash: "samehash",
+      askSpecs: new Map(),
+      caps: { maxConcurrency: 1 },
+      validate: () => true,
+      driver,
+      ...options,
+    });
+  };
+  return {
+    root,
+    effect,
+    args,
+    events,
+    engine,
+    get store() {
+      return store;
+    },
+    get dispatches() {
+      return dispatches;
+    },
+    reopen() {
+      store.close();
+      store = new SqliteSessionStore({ dbPath });
+      reconcileOrphanRuns({ journal: store.workflowJournalStore(), parentSessionId: "parent" });
+    },
+    async close() {
+      await executionPort.close?.();
+      store.close();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
