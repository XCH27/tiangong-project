@@ -50,6 +51,40 @@ export function ProviderTemplatePicker({
   const { dismissFeedback } = useProviderDetailFeedback();
   const customLabel = intl.formatMessage({ id: "settings.modelProvider.newProviderName" });
   const [category, setCategory] = useState<ProviderConnectionCategory>("subscription");
+  const { providerSettingsService } = useServices();
+  // Terminal access lists which CLIs this computer can run, the way CLI managers do; it only runs
+  // each CLI's `--version`, and is read once when the tab opens.
+  const [cliStates, setCliStates] = useState<
+    Record<string, { bundled: boolean; installed: boolean; version?: string }>
+  >();
+  useEffect(() => {
+    if (category !== "terminal" || cliStates) return;
+    let cancelled = false;
+    providerSettingsService
+      .detectNativeClis()
+      .then((states) => {
+        if (!cancelled) setCliStates(states);
+      })
+      .catch(() => {
+        if (!cancelled) setCliStates({});
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [category, cliStates, providerSettingsService]);
+  const cliMeta = (templates: readonly { config: { access?: unknown } }[]): string | undefined => {
+    if (category !== "terminal") return undefined;
+    const access = templates[0]?.config.access as { type?: string; provider?: string } | undefined;
+    if (access?.type !== "native-cli" || !access.provider) return undefined;
+    if (!cliStates) return intl.formatMessage({ id: "settings.modelProvider.terminal.checking" });
+    const state = cliStates[access.provider];
+    if (!state) return undefined;
+    if (state.bundled) return intl.formatMessage({ id: "settings.modelProvider.terminal.bundled" });
+    if (!state.installed) return intl.formatMessage({ id: "settings.modelProvider.terminal.missing" });
+    return state.version
+      ? intl.formatMessage({ id: "settings.modelProvider.terminal.installedVersion" }, { version: state.version })
+      : intl.formatMessage({ id: "settings.modelProvider.terminal.installed" });
+  };
   const [selectedId, setSelectedId] = useState<string>();
   const [busy, setBusy] = useState(false);
   const [routeError, setRouteError] = useState(false);
