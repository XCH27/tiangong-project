--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/native-detect.ts
@@ -0,0 +1,49 @@
+import { execFile } from "node:child_process";
+import { NATIVE_EXECUTOR_KINDS, type NativeExecutorKind } from "@zcode/shared";
+import { isAcpExecutorKind, resolveAcpExecutable } from "./acp-profiles.js";
+import { resolveAntigravityExecutable } from "./antigravity-inspect.js";
+import { resolveClaudeNativeExecutable } from "./claude-executable.js";
+import { resolveCodexNativeExecutable } from "./codex-executable.js";
+
+export interface NativeCliDetection {
+  /** Fleet ships this executor itself (Claude Code SDK binary, scoped Codex build). */
+  bundled: boolean;
+  installed: boolean;
+  version?: string;
+}
+
+const VERSION_TIMEOUT_MS = 6_000;
+
+function version(executable: string): Promise<string | undefined> {
+  return new Promise((resolve) => {
+    execFile(executable, ["--version"], { timeout: VERSION_TIMEOUT_MS, maxBuffer: 16_384, windowsHide: true }, (error, stdout) => {
+      if (error) return resolve(undefined);
+      const line = String(stdout).trim().split("\n")[0]?.trim();
+      resolve(line ? (line.match(/\d+\.\d+[\w.+-]*/)?.[0] ?? line.slice(0, 40)) : "");
+    });
+  });
+}
+
+/**
+ * Which terminal CLIs this computer can run, for the Terminal access list (OV-103). Runs each
+ * CLI's `--version` once; nothing signs in and nothing is installed.
+ */
+export async function detectNativeClis(): Promise<Record<NativeExecutorKind, NativeCliDetection>> {
+  const entries = await Promise.all(
+    NATIVE_EXECUTOR_KINDS.map(async (kind): Promise<[NativeExecutorKind, NativeCliDetection]> => {
+      if (kind === "claude" || kind === "codex") {
+        try {
+          const executable = kind === "claude" ? resolveClaudeNativeExecutable() : resolveCodexNativeExecutable();
+          const found = await version(executable);
+          return [kind, { bundled: true, installed: true, ...(found ? { version: found } : {}) }];
+        } catch {
+          return [kind, { bundled: true, installed: false }];
+        }
+      }
+      const executable = kind === "antigravity" ? resolveAntigravityExecutable() : isAcpExecutorKind(kind) ? resolveAcpExecutable(kind) : undefined;
+      const found = executable ? await version(executable) : undefined;
+      return [kind, { bundled: false, installed: found !== undefined, ...(found ? { version: found } : {}) }];
+    }),
+  );
+  return Object.fromEntries(entries) as Record<NativeExecutorKind, NativeCliDetection>;
+}
