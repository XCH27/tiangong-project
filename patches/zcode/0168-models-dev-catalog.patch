diff --git a/packages/services/src/model-provider/modelCatalogRefresh.ts b/packages/services/src/model-provider/modelCatalogRefresh.ts
new file mode 100644
index 0000000..b864815
--- /dev/null
+++ b/packages/services/src/model-provider/modelCatalogRefresh.ts
@@ -0,0 +1,46 @@
+import { buildModelKnowledge } from "@zcode/provider";
+import { loadModelCatalog, saveModelCatalog } from "@zcode/provider-node";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+export const MODELS_DEV_URL = "https://models.dev/api.json";
+
+/**
+ * Keeps model facts current between releases, like OpenCode's models.dev cache: a read-only GET of
+ * the public catalog (no account data), at most daily, through the Host network owner. Any failure
+ * keeps the catalog already in force; the shipped snapshot is always the floor.
+ */
+export function startModelCatalogRefresh(options: {
+  path: string;
+  fetch: typeof fetch;
+  /** Re-resolves provider models after a newer catalog is applied. */
+  onUpdated: () => Promise<unknown>;
+  onError?: (error: unknown) => void;
+  now?: () => number;
+}): () => void {
+  const now = options.now ?? Date.now;
+  let disposed = false;
+  let running: Promise<void> | undefined;
+  const run = () =>
+    (running ??= (async () => {
+      const saved = await loadModelCatalog(options.path);
+      if (saved && now() - saved.fetchedAt < DAY_MS) return;
+      const response = await options.fetch(MODELS_DEV_URL, { signal: AbortSignal.timeout(60_000) });
+      if (!response.ok) throw new Error(`models.dev catalog request failed (${response.status})`);
+      const data = buildModelKnowledge({ modelsDev: await response.json() });
+      if (!Object.keys(data.models).length) throw new Error("models.dev returned an empty catalog");
+      if (disposed) return;
+      await saveModelCatalog(options.path, { schema: 1, fetchedAt: now(), source: MODELS_DEV_URL, data });
+      await options.onUpdated();
+    })()
+      .catch((error: unknown) => options.onError?.(error))
+      .finally(() => {
+        running = undefined;
+      }));
+  void run();
+  const timer = setInterval(() => void run(), DAY_MS / 4);
+  timer.unref?.();
+  return () => {
+    disposed = true;
+    clearInterval(timer);
+  };
+}
