@@ -0,0 +1,45 @@
+import { readFile, rename, writeFile, mkdir } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { setModelKnowledgeOverlay, type ModelKnowledgeData } from "@zcode/provider";
+
+/**
+ * The refreshed model catalog lives beside the personal provider config so the Host (which fetches
+ * it) and every agent process (which only reads it) resolve the same model facts.
+ */
+export const MODEL_CATALOG_FILE = "model-catalog.json";
+export interface ModelCatalogFile {
+  readonly schema: 1;
+  readonly fetchedAt: number;
+  readonly source: string;
+  readonly data: ModelKnowledgeData;
+}
+
+export const modelCatalogPath = (personalFilePath: string) => join(dirname(personalFilePath), MODEL_CATALOG_FILE);
+
+function valid(value: unknown): value is ModelCatalogFile {
+  const file = value as Partial<ModelCatalogFile> | null;
+  return Boolean(
+    file && file.schema === 1 && typeof file.fetchedAt === "number" &&
+      file.data && typeof file.data.models === "object" && typeof file.data.hosts === "object",
+  );
+}
+
+/** Applies a saved catalog; a missing or damaged file leaves the shipped catalog in force. */
+export async function loadModelCatalog(path: string): Promise<ModelCatalogFile | undefined> {
+  try {
+    const parsed: unknown = JSON.parse(await readFile(path, "utf8"));
+    if (!valid(parsed)) return undefined;
+    setModelKnowledgeOverlay(parsed.data);
+    return parsed;
+  } catch {
+    return undefined;
+  }
+}
+
+export async function saveModelCatalog(path: string, file: ModelCatalogFile): Promise<void> {
+  await mkdir(dirname(path), { recursive: true });
+  const temporary = `${path}.${process.pid}.tmp`;
+  await writeFile(temporary, JSON.stringify(file));
+  await rename(temporary, path);
+  setModelKnowledgeOverlay(file.data);
+}
