+#!/usr/bin/env -S npx tsx
+// Regenerates packages/provider/src/model-knowledge.generated.ts from models.dev (MIT) and the
+// catalog the installed @earendil-works/pi-ai ships (MIT). Run: `npx tsx scripts/generate-model-knowledge.ts`
+// (pass a saved api.json path to build offline).
+import { readFile, realpath, writeFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { buildModelKnowledge } from "../packages/provider/src/model-knowledge-build.js";
+
+const root = resolve(import.meta.dirname, "..");
+const piRoot = await realpath(join(root, "node_modules/@earendil-works/pi-ai"));
+const piVersion = JSON.parse(await readFile(join(piRoot, "package.json"), "utf8")).version as string;
+const pi = await import(pathToFileURL(join(piRoot, "dist/models.generated.js")).href);
+const modelsDev = process.argv[2]
+  ? JSON.parse(await readFile(process.argv[2], "utf8"))
+  : await (await fetch("https://models.dev/api.json", { signal: AbortSignal.timeout(60_000) })).json();
+const data = buildModelKnowledge({ modelsDev, pi });
+const generatedAt = new Date().toISOString().slice(0, 10);
+const output = `// Generated by scripts/generate-model-knowledge.ts from models.dev (${generatedAt}) and
+// @earendil-works/pi-ai ${piVersion}; do not edit. Shape: see model-knowledge-build.ts.
+import type { ModelKnowledgeData } from "./model-knowledge-build.js";
+export const MODEL_KNOWLEDGE_SOURCE = "models.dev ${generatedAt} + @earendil-works/pi-ai ${piVersion}";
+export const MODEL_KNOWLEDGE_DATA: ModelKnowledgeData = JSON.parse(${JSON.stringify(JSON.stringify(data))});
+`;
+await writeFile(join(root, "packages/provider/src/model-knowledge.generated.ts"), output);
+console.log(`model knowledge: ${Object.keys(data.models).length} models, ${Object.keys(data.hosts).length} hosts, ${(output.length / 1024).toFixed(0)} KiB`);
