+
+test("a daily models.dev refresh is applied to lookups, saved for every process, and failures keep the catalog", async () => {
+  const { mkdtemp, rm, readFile: read } = await import("node:fs/promises");
+  const { tmpdir } = await import("node:os");
+  const { join } = await import("node:path");
+  const { startModelCatalogRefresh } = await import("../src/model-provider/modelCatalogRefresh.js");
+  const { setModelKnowledgeOverlay } = await import("../../provider/src/model-knowledge.js");
+  const directory = await mkdtemp(join(tmpdir(), "fleet-model-catalog-"));
+  const path = join(directory, "model-catalog.json");
+  let requests = 0;
+  let updates = 0;
+  const catalog = {
+    newhost: {
+      id: "newhost",
+      api: "https://api.newhost.example/v1",
+      models: {
+        "brand-new-model": {
+          id: "brand-new-model",
+          reasoning: true,
+          tool_call: true,
+          limit: { context: 777000, output: 64000 },
+          modalities: { input: ["text", "image"], output: ["text"] },
+          reasoning_options: [{ type: "effort", values: ["low", "high"] }],
+        },
+      },
+    },
+  };
+  const fetcher = (async () => {
+    requests++;
+    return Response.json(catalog);
+  }) as typeof fetch;
+  try {
+    assert.equal(lookupModelKnowledge({ modelId: "brand-new-model" }), undefined);
+    const stop = startModelCatalogRefresh({ path, fetch: fetcher, onUpdated: async () => void updates++ });
+    for (let i = 0; i < 50 && !updates; i++) await new Promise((resolve) => setTimeout(resolve, 10));
+    stop();
+    const known = lookupModelKnowledge({ modelId: "brand-new-model", baseUrl: "https://api.newhost.example/v1" });
+    assert.equal(known?.contextWindow, 777000);
+    assert.equal(known?.basis, "host");
+    assert.deepEqual(known?.reasoningLevels, ["low", "high"]);
+    assert.equal(JSON.parse(await read(path, "utf8")).schema, 1);
+    // A second start within a day reuses the saved catalog without a request.
+    const again = startModelCatalogRefresh({ path, fetch: fetcher, onUpdated: async () => void updates++ });
+    await new Promise((resolve) => setTimeout(resolve, 50));
+    again();
+    assert.equal(requests, 1);
+    // A failing source leaves the catalog in force.
+    let failures = 0;
+    const failing = startModelCatalogRefresh({
+      path: join(directory, "other.json"),
+      fetch: (async () => new Response("down", { status: 503 })) as typeof fetch,
+      onUpdated: async () => {},
+      onError: () => void failures++,
+    });
+    for (let i = 0; i < 50 && !failures; i++) await new Promise((resolve) => setTimeout(resolve, 10));
+    failing();
+    assert.equal(failures, 1);
+    assert.equal(lookupModelKnowledge({ modelId: "brand-new-model", baseUrl: "https://api.newhost.example/v1" })?.contextWindow, 777000);
+  } finally {
+    setModelKnowledgeOverlay(undefined);
+    await rm(directory, { recursive: true, force: true });
+  }
+});
