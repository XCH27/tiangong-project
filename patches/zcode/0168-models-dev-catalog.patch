diff --git a/packages/provider/src/model-knowledge-build.ts b/packages/provider/src/model-knowledge-build.ts
new file mode 100644
index 0000000..8d356b0
--- /dev/null
+++ b/packages/provider/src/model-knowledge-build.ts
@@ -0,0 +1,121 @@
+/**
+ * Builds the compact model catalog from its public sources. The build script and the runtime
+ * refresh share this one transform, so a refreshed catalog has exactly the shipped shape.
+ *
+ * - models.dev `api.json` (MIT; the catalog OpenCode uses): primary, 200+ hosts.
+ * - pi-ai's generated catalog (MIT; already a Fleet dependency): hosts and base URLs models.dev
+ *   lacks (ChatGPT plan, Kimi Coding, Qwen Token Plan; OpenAI/Anthropic/Google/xAI endpoints).
+ */
+export type ModelKnowledgeEntry = readonly [host: string, context: number, output: number, flags: number, levels: string];
+export interface ModelKnowledgeData {
+  readonly hosts: Readonly<Record<string, readonly string[]>>;
+  readonly models: Readonly<Record<string, readonly ModelKnowledgeEntry[]>>;
+}
+
+/** Entry flags. */
+export const KNOWLEDGE_FLAG = {
+  imageIn: 1,
+  reasoning: 2,
+  imageOut: 4,
+  textOut: 8,
+  videoOut: 16,
+  pdfIn: 32,
+  toolCall: 64,
+  noToolCall: 128,
+  structuredOutput: 256,
+  audioOut: 512,
+} as const;
+
+const LEVELS = ["minimal", "low", "medium", "high", "xhigh", "max"];
+
+/** Same normalisation as lookup: vendor path dropped, case and dot/hyphen spelling unified. */
+export const knowledgeKey = (id: string) =>
+  id.slice(id.lastIndexOf("/") + 1).trim().toLowerCase().replace(/\./g, "-");
+
+type Loose = Record<string, unknown>;
+const object = (value: unknown): Loose | undefined =>
+  value && typeof value === "object" && !Array.isArray(value) ? (value as Loose) : undefined;
+const strings = (value: unknown): string[] =>
+  Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : [];
+const positive = (value: unknown) => (typeof value === "number" && Number.isFinite(value) && value > 0 ? Math.round(value) : 0);
+
+function modelsDevEntries(source: unknown, add: (key: string, entry: ModelKnowledgeEntry, baseUrl?: string) => void) {
+  for (const [host, rawProvider] of Object.entries(object(source) ?? {})) {
+    const provider = object(rawProvider);
+    const api = typeof provider?.api === "string" ? provider.api : undefined;
+    for (const rawModel of Object.values(object(provider?.models) ?? {})) {
+      const model = object(rawModel);
+      if (!model || typeof model.id !== "string") continue;
+      const modalities = object(model.modalities);
+      const input = strings(modalities?.input);
+      const output = modalities ? strings(modalities.output) : ["text"];
+      const limit = object(model.limit);
+      const efforts = (Array.isArray(model.reasoning_options) ? model.reasoning_options : [])
+        .map(object)
+        .filter((option) => option?.type === "effort")
+        .flatMap((option) => strings(option!.values));
+      const flags =
+        (input.includes("image") || model.attachment === true ? KNOWLEDGE_FLAG.imageIn : 0) |
+        (model.reasoning === true ? KNOWLEDGE_FLAG.reasoning : 0) |
+        (output.includes("image") ? KNOWLEDGE_FLAG.imageOut : 0) |
+        (output.includes("text") ? KNOWLEDGE_FLAG.textOut : 0) |
+        (output.includes("video") ? KNOWLEDGE_FLAG.videoOut : 0) |
+        (output.includes("audio") ? KNOWLEDGE_FLAG.audioOut : 0) |
+        (input.includes("pdf") ? KNOWLEDGE_FLAG.pdfIn : 0) |
+        (model.tool_call === true ? KNOWLEDGE_FLAG.toolCall : model.tool_call === false ? KNOWLEDGE_FLAG.noToolCall : 0) |
+        (model.structured_output === true ? KNOWLEDGE_FLAG.structuredOutput : 0);
+      add(
+        knowledgeKey(model.id),
+        [host, positive(limit?.context), positive(limit?.output), flags, LEVELS.filter((level) => efforts.includes(level)).join(",")],
+        api,
+      );
+    }
+  }
+}
+
+function piEntries(
+  pi: { MODELS?: unknown; IMAGE_MODELS?: unknown },
+  add: (key: string, entry: ModelKnowledgeEntry, baseUrl?: string) => void,
+) {
+  for (const [catalog, kind] of [[pi.MODELS, "chat"], [pi.IMAGE_MODELS, "image"]] as const)
+    for (const rawProvider of Object.values(object(catalog) ?? {}))
+      for (const rawModel of Object.values(object(rawProvider) ?? {})) {
+        const model = object(rawModel);
+        if (!model || typeof model.id !== "string" || typeof model.provider !== "string") continue;
+        const input = strings(model.input).length ? strings(model.input) : ["text"];
+        const output = strings(model.output).length ? strings(model.output) : kind === "image" ? ["image"] : ["text"];
+        const map = object(model.thinkingLevelMap);
+        const flags =
+          (input.includes("image") ? KNOWLEDGE_FLAG.imageIn : 0) |
+          (model.reasoning === true ? KNOWLEDGE_FLAG.reasoning : 0) |
+          (output.includes("image") ? KNOWLEDGE_FLAG.imageOut : 0) |
+          (output.includes("text") ? KNOWLEDGE_FLAG.textOut : 0) |
+          (kind === "chat" ? KNOWLEDGE_FLAG.toolCall : 0);
+        add(
+          knowledgeKey(model.id),
+          [model.provider, positive(model.contextWindow), positive(model.maxTokens), flags, map ? LEVELS.filter((level) => map[level] != null).join(",") : ""],
+          typeof model.baseUrl === "string" ? model.baseUrl : undefined,
+        );
+      }
+}
+
+/** models.dev wins for a host it lists; pi-ai adds the hosts and endpoints models.dev lacks. */
+export function buildModelKnowledge(sources: { modelsDev?: unknown; pi?: { MODELS?: unknown; IMAGE_MODELS?: unknown } }): ModelKnowledgeData {
+  const hosts = new Map<string, Set<string>>();
+  const models = new Map<string, ModelKnowledgeEntry[]>();
+  const fromModelsDev = new Set<string>();
+  const add = (primary: boolean) => (key: string, entry: ModelKnowledgeEntry, baseUrl?: string) => {
+    const host = entry[0];
+    if (baseUrl && !baseUrl.includes("{")) (hosts.get(host) ?? hosts.set(host, new Set()).get(host)!).add(baseUrl.replace(/\/+$/u, ""));
+    if (primary) fromModelsDev.add(host);
+    else if (fromModelsDev.has(host)) return;
+    const list = models.get(key) ?? models.set(key, []).get(key)!;
+    if (!list.some((existing) => existing[0] === host)) list.push(entry);
+  };
+  if (sources.modelsDev) modelsDevEntries(sources.modelsDev, add(true));
+  if (sources.pi) piEntries(sources.pi, add(false));
+  return {
+    hosts: Object.fromEntries([...hosts].sort(([a], [b]) => a.localeCompare(b)).map(([host, urls]) => [host, [...urls].sort()])),
+    models: Object.fromEntries([...models].sort(([a], [b]) => a.localeCompare(b))),
+  };
+}
