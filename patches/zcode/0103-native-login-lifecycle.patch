+test("Provider teardown fences readiness waits and asynchronous native launches", async () => {
+  for (const phase of ["readiness", "launch"] as const) {
+    let dispose = () => {};
+    let launches = 0;
+    let cancelled = 0;
+    const ready = Promise.withResolvers<void>();
+    const launched = Promise.withResolvers<ReturnType<typeof startClaudeNativeLogin>>();
+    const facade = {
+      getView: () => ({
+        revision: 1,
+        providers: [
+          {
+            providerId: "A",
+            effectiveConfig: { access: { type: "native-cli", provider: "claude" } },
+          },
+        ],
+      }),
+    } as unknown as ProviderSettingsFacade;
+    const operations = createNativeCliConnectionOperations(
+      facade,
+      phase === "readiness" ? () => ready.promise : async () => {},
+      {
+        inspect: async () => {
+          throw new Error("Not reached");
+        },
+        login: () => {
+          launches++;
+          return launched.promise;
+        },
+      },
+      (cleanup) => {
+        dispose = cleanup;
+      },
+    );
+    const beginning = operations.beginNativeCliLogin("A");
+    void beginning.catch(() => {});
+    await Promise.resolve();
+    dispose();
+    if (phase === "readiness") ready.resolve();
+    else
+      launched.resolve({
+        completion: new Promise<void>(() => {}),
+        cancel: () => {
+          cancelled++;
+        },
+      });
+    await assert.rejects(beginning, /disposed|cancelled/);
+    assert.equal(launches, phase === "readiness" ? 0 : 1);
+    assert.equal(cancelled, phase === "launch" ? 1 : 0);
+    await assert.rejects(operations.beginNativeCliLogin("A"), /disposed/);
+  }
+});
