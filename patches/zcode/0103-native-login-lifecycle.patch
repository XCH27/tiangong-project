+test("disposing the Provider runtime cancels pending native login and prevents late account publication", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-dispose-"));
+  const personalFilePath = join(directory, "providers.json");
+  const completion = Promise.withResolvers<void>();
+  let cancellations = 0;
+  let inspections = 0;
+  const runtime = new ProviderRuntime({
+    configRuntime: createProviderConfigRuntime({
+      personalFilePath,
+      watch: false,
+      personalPollingIntervalMs: false,
+      zcodeBuiltinFilePath: fileURLToPath(
+        new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+      ),
+    }),
+    nativeCli: {
+      inspect: async () => {
+        inspections++;
+        throw new Error("Disposed login must not inspect or publish");
+      },
+      login: () => ({
+        completion: completion.promise,
+        cancel: () => {
+          cancellations++;
+        },
+      }),
+    },
+  });
+  try {
+    await runtime.start();
+    const { providerId } = await runtime.providerSettings.createPersonalProvider({
+      templateId: "fleet-claude-native",
+    });
+    const { flowId } = await runtime.providerSettings.beginNativeCliLogin(providerId);
+    runtime.dispose();
+    runtime.dispose();
+    assert.equal(cancellations, 1, "The existing owner must stop its login child exactly once");
+    completion.resolve();
+    await Promise.resolve();
+    await assert.rejects(
+      runtime.providerSettings.pollNativeCliLogin(providerId, flowId),
+      /disposed|expired|cancelled/,
+    );
+    assert.equal(inspections, 0);
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
