+import { UsageAccountingHelp } from "./UsageAccountingHelp.js";
+import { UsageChartLoadBoundary } from "./UsageChartLoadBoundary.js";
+
+const UsageCostComparison = lazy(() =>
+  import("./UsageCostComparison.js").then((module) => ({ default: module.UsageCostComparison })),
+);
+
+/** One billing scope owns the reference estimate and paid allocation shown together. */
+export function UsageCostAnalysis({ snapshot }: { snapshot: AppUsageSnapshot | null }) {
+  const { intl } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.usage.costAnalysis.${key}` });
+  const { settings, update } = useSettings();
+  const { usageStatsService } = useServices();
+  const payments = useMemo(
+    () =>
+      Object.values(settings?.subscriptionPayments ?? {})
+        .filter((item): item is SubscriptionPayment => item !== null)
+        .sort((a, b) => b.start - a.start),
+    [settings?.subscriptionPayments],
+  );
+  const [choice, setChoice] = useState<string>();
+  const [editor, setEditor] = useState<{ payment?: SubscriptionPayment }>();
+  const [error, setError] = useState<string>();
+  const selected = choice ?? (payments[0] ? `payment:${payments[0].id}` : "all");
+  const payment = payments.find((item) => `payment:${item.id}` === selected);
+  const start = payment?.start,
+    end = payment?.end;
+  const key = payment
+    ? JSON.stringify([payment.providerId, payment.accountId, start, end])
+    : selected;
+  const scope = useMemo(() => ({ service: usageStatsService, key }), [usageStatsService, key]);
+  const [reading, setReading] = useState<{
+    scope: typeof scope;
+    rows?: UsageAccountingRow[];
+    error?: string;
+  }>();
+  const refreshVersion = snapshot?.generatedAt;
+  useEffect(() => {
+    if (start === undefined || end === undefined) return;
+    let active = true;
+    setReading({ scope });
+    if (start > Date.now()) {
+      setReading({ scope, rows: [] });
+      return;
+    }
+    void usageStatsService
+      .getAppUsageSnapshot({
+        range: "all",
+        timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
+        since: start,
+        until: end,
+      })
+      .then((value) => {
+        if (active) setReading({ scope, rows: value.accounting ?? [] });
+      })
+      .catch((reason) => {
+        if (active) setReading({ scope, error: String(reason) });
+      });
+    return () => {
+      active = false;
+    };
+  }, [scope, start, end, usageStatsService, refreshVersion]);
+  const periodReading = reading?.scope === scope ? reading : undefined;
+  const rows =
+    selected === "all" ? (snapshot ? (snapshot.accounting ?? []) : undefined) : periodReading?.rows;
+  const report = useMemo(
+    () => (rows ? buildUsageCostReport(rows, { payment }) : undefined),
+    [rows, payment],
+  );
+  const remove = async () => {
+    if (!payment) return;
+    try {
+      await update({ subscriptionPayments: { [payment.id]: null } });
+      setChoice("all");
+      setError(undefined);
+    } catch (reason) {
+      setError(String(reason));
+    }
+  };
+  return (
+    <section className="space-y-3 rounded-xl bg-surface p-4">
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div className="flex items-center gap-1">
+          <h3 className="text-ui-base font-medium">{t("title")}</h3>
+          <UsageAccountingHelp metric="analysis" />
+        </div>
+        <Button variant="outline" size="sm" onClick={() => setEditor({})}>
+          <Plus className="size-3.5" />
+          {t("recordPayment")}
+        </Button>
+      </div>
+      <div className="flex items-center gap-2">
+        <Select
+          value={selected}
+          onValueChange={(value) => {
+            setChoice(value);
+            setError(undefined);
+          }}
+        >
+          <SelectTrigger className="min-w-0 flex-1" aria-label={t("scope")}>
+            <SelectValue />
+          </SelectTrigger>
+          <SelectContent>
+            <SelectItem value="all">
+              {t("allUsage")}
+              {snapshot
+                ? ` · ${intl.formatMessage({ id: `settings.usage.range.${snapshot.range}` })}`
+                : ""}
+            </SelectItem>
+            {payments.map((item) => (
+              <SelectItem key={item.id} value={`payment:${item.id}`}>
+                {item.accountLabel} · {paymentDateText(item.start)} —{" "}
+                {paymentDateText(item.end - 1)}
+              </SelectItem>
+            ))}
+          </SelectContent>
+        </Select>
+        {payment ? (
+          <DropdownMenu>
+            <DropdownMenuTrigger asChild>
+              <Button variant="ghost" size="icon-sm" aria-label={t("paymentActions")}>
+                <MoreHorizontal className="size-4" />
+              </Button>
+            </DropdownMenuTrigger>
+            <DropdownMenuContent align="end">
+              <DropdownMenuItem onSelect={() => setEditor({ payment })}>
+                {t("editPayment")}
+              </DropdownMenuItem>
+              <DropdownMenuItem variant="destructive" onSelect={() => void remove()}>
+                {t("removePayment")}
+              </DropdownMenuItem>
+            </DropdownMenuContent>
+          </DropdownMenu>
+        ) : null}
+      </div>
+      {error || periodReading?.error ? (
+        <p role="alert" className="text-ui-sm text-destructive">
+          {error ?? periodReading?.error}
+        </p>
+      ) : null}
+      {report ? (
+        <UsageChartLoadBoundary
+          scope="settings.usage.cost-analysis"
+          resetKeys={[scope, refreshVersion]}
+          loadingDescription={t("loading")}
+        >
+          <UsageCostComparison report={report} payment={payment} />
+        </UsageChartLoadBoundary>
+      ) : !periodReading?.error ? (
+        <p role="status" className="text-ui-sm text-foreground-subtle">
+          {t("loading")}
+        </p>
+      ) : null}
+      {editor ? (
+        <SubscriptionPaymentEditor
+          key={editor.payment?.id ?? "new"}
+          payment={editor.payment}
+          payments={payments}
+          onClose={() => setEditor(undefined)}
+          onSaved={(id) => setChoice(`payment:${id}`)}
+        />
+      ) : null}
+    </section>
+  );
+}
diff --git a/packages/ui/src/settings/usage-stats/UsageCostComparison.tsx b/packages/ui/src/settings/usage-stats/UsageCostComparison.tsx
new file mode 100644
index 0000000..edb9e03
--- /dev/null
+++ b/packages/ui/src/settings/usage-stats/UsageCostComparison.tsx
@@ -0,0 +1,200 @@
+import { Fragment, useState } from "react";
+import { ExternalLink } from "lucide-react";
+import type { SubscriptionPayment, UsageCostReport } from "@zcode/shared";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { Button } from "@/components/ui/button.js";
+import { Progress } from "@/components/ui/progress.js";
+import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs.js";
+import { Popover, PopoverTrigger, PopoverContent } from "@/components/ui/popover.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import {
+  formatCompactTokenUsage,
+  USAGE_STATS_TABS_LIST_CLASS,
+  USAGE_STATS_TABS_TRIGGER_CLASS,
+} from "./usageStatsUiParts.js";
+
+type View = "unit" | "models" | "projects";
+const API_COLOR = "var(--color-usage-chart-1)",
+  PAID_COLOR = "var(--color-usage-chart-2)";
+
+/** Original summary/legend/progress primitives, comparing the same account-period facts. */
+export function UsageCostComparison({
+  report,
+  payment,
+}: {
+  report: UsageCostReport;
+  payment?: SubscriptionPayment;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const platform = usePlatform();
+  const t = (key: string) => intl.formatMessage({ id: `settings.usage.costAnalysis.${key}` });
+  const [view, setView] = useState<View>("unit");
+  const currency = payment?.currency ?? "USD";
+  const money = (value: number | null, unit = "USD") =>
+    value === null
+      ? "—"
+      : new Intl.NumberFormat(locale, {
+          style: "currency",
+          currency: unit,
+          maximumFractionDigits: Math.abs(value) > 0 && Math.abs(value) < 0.0001 ? 8 : 4,
+        }).format(value);
+  const summary = report.summary;
+  const partial = summary.pricedCount < summary.requests || summary.unknownAccountRequests > 0;
+  const stats = [
+    ...(payment ? [{ label: t("paid"), value: money(payment.amount, currency) }] : []),
+    {
+      label: t("apiEquivalent"),
+      value: `${money(summary.apiUsd)}${partial && summary.apiUsd !== null ? " *" : ""}`,
+    },
+    {
+      label: payment ? t("actualUnit") : t("recordedTokens"),
+      value: payment
+        ? money(summary.actualPerMillion, currency)
+        : formatCompactTokenUsage(locale, summary.totalTokens),
+    },
+  ];
+  const data =
+    view === "projects"
+      ? report.projects.map((project) => ({
+          key: project.workspacePath ?? "unassigned",
+          label: project.workspacePath?.split(/[/\\]/).filter(Boolean).at(-1) ?? t("unassigned"),
+          fullLabel: project.workspacePath ?? t("unassigned"),
+          api: project.apiUsd,
+          actual: project.actualAmount,
+          sources: [] as string[],
+          tokens: project.totalTokens,
+          priced: project.pricedCount,
+          requests: project.requests,
+        }))
+      : report.models.map((model) => ({
+          key: model.modelId,
+          label: model.modelId,
+          fullLabel: model.modelId,
+          api: view === "unit" ? model.apiPerMillion : model.apiUsd,
+          actual: view === "unit" ? model.actualPerMillion : model.actualAmount,
+          sources: model.priceSources,
+          tokens: model.totalTokens,
+          priced: model.pricedCount,
+          requests: model.requests,
+        }));
+  // 没有汇率事实时不把不同币种画在同一比例尺上；API 参考数值仍保留在同一行。
+  const comparable = currency === "USD";
+  const max = Math.max(
+    0,
+    ...data.flatMap((row) => [...(comparable || !payment ? [row.api ?? 0] : []), row.actual ?? 0]),
+  );
+  const bar = (label: string, value: number | null, color: string, unit: string, draw: boolean) => (
+    <div className="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 text-ui-sm">
+      <span className="w-12 text-foreground-subtle">{label}</span>
+      {draw && value !== null && max > 0 ? (
+        <Progress
+          value={(value / max) * 100}
+          aria-label={`${label} ${money(value, unit)}`}
+          aria-valuenow={(value / max) * 100}
+          segments={[{ id: label, percent: 1, style: { backgroundColor: color } }]}
+        />
+      ) : (
+        <span />
+      )}
+      <span className="font-mono tabular-nums text-foreground">{money(value, unit)}</span>
+    </div>
+  );
+  return (
+    <div className="space-y-3">
+      <div className="flex flex-col overflow-hidden sm:flex-row sm:items-center">
+        {stats.map((stat, index) => (
+          <Fragment key={stat.label}>
+            {index ? (
+              <div aria-hidden="true" className="hidden h-7 w-px bg-border sm:block" />
+            ) : null}
+            <div className="min-w-0 flex-1 px-4 py-3 text-center">
+              <div className="truncate text-ui-lg font-medium text-foreground">{stat.value}</div>
+              <div className="mt-1 text-ui-sm text-foreground-subtle">{stat.label}</div>
+            </div>
+          </Fragment>
+        ))}
+      </div>
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <Tabs value={view} onValueChange={(value) => setView(value as View)}>
+          <TabsList className={USAGE_STATS_TABS_LIST_CLASS}>
+            {(["unit", "models", "projects"] as const).map((value) => (
+              <TabsTrigger key={value} value={value} className={USAGE_STATS_TABS_TRIGGER_CLASS}>
+                {t(value)}
+              </TabsTrigger>
+            ))}
+          </TabsList>
+        </Tabs>
+        {payment && summary.allocationBasis === "unavailable" ? (
+          <ControlHintTooltip
+            title={
+              summary.unknownAccountRequests
+                ? intl.formatMessage(
+                    { id: "settings.usage.costAnalysis.unknownAccounts" },
+                    { count: summary.unknownAccountRequests },
+                  )
+                : intl.formatMessage({ id: "settings.usage.payments.unavailable" })
+            }
+          >
+            <span tabIndex={0} className="text-ui-sm text-foreground-subtle">
+              {t("allocationPending")}
+            </span>
+          </ControlHintTooltip>
+        ) : payment && payment.end > Date.now() ? (
+          <span className="text-ui-sm text-foreground-subtle">{t("periodOpen")}</span>
+        ) : null}
+      </div>
+      <div className="max-h-80 overflow-y-auto px-3" role="list">
+        {data.map((row) => (
+          <div
+            key={row.key}
+            role="listitem"
+            className="space-y-2 border-b border-border/70 py-3 last:border-b-0"
+          >
+            <div className="flex items-center justify-between gap-2">
+              <ControlHintTooltip
+                title={`${row.fullLabel}\n${formatCompactTokenUsage(locale, row.tokens)} Tokens · ${row.priced}/${row.requests} ${t("priced")}`}
+              >
+                <span tabIndex={0} className="min-w-0 truncate font-mono text-ui-sm">
+                  {row.label}
+                </span>
+              </ControlHintTooltip>
+              {row.sources.length ? (
+                <Popover>
+                  <PopoverTrigger asChild>
+                    <Button
+                      variant="ghost"
+                      size="icon-sm"
+                      aria-label={`${row.label} · ${t("priceSources")}`}
+                    >
+                      <ExternalLink className="size-3.5" />
+                    </Button>
+                  </PopoverTrigger>
+                  <PopoverContent align="end" className="w-72 space-y-2 p-3">
+                    {row.sources
+                      .filter((url) => url.startsWith("https://"))
+                      .map((url) => (
+                        <Button
+                          key={url}
+                          variant="link"
+                          className="h-auto max-w-full justify-start p-0 text-ui-sm"
+                          onClick={() => void platform.openExternal(url)}
+                        >
+                          {new URL(url).hostname}
+                        </Button>
+                      ))}
+                  </PopoverContent>
+                </Popover>
+              ) : null}
+            </div>
+            {bar(t("api"), row.api, API_COLOR, "USD", comparable || !payment)}
+            {payment ? bar(t("actual"), row.actual, PAID_COLOR, currency, true) : null}
+          </div>
+        ))}
+        {!data.length ? (
+          <div className="py-6 text-center text-ui-base text-foreground-subtle">{t("empty")}</div>
+        ) : null}
+      </div>
+    </div>
+  );
+}
