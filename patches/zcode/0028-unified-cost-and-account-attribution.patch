+} from "@/components/ui/select.js";
+
+export const paymentDateText = (time: number) => {
+  const d = new Date(time);
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+};
+const dateText = paymentDateText;
+const nextDay = (value: string) => {
+  const date = new Date(`${value}T00:00:00`);
+  date.setDate(date.getDate() + 1);
+  return date.getTime();
+};
+
+export function SubscriptionPaymentEditor({
+  payment: editing,
+  payments,
+  onSaved,
+  onClose,
+}: {
+  payment?: SubscriptionPayment;
+  payments: readonly SubscriptionPayment[];
+  onSaved(id: string): void;
+  onClose(): void;
+}) {
+  const { intl } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.usage.payments.${key}` });
+  const { update } = useSettings();
+  const { providerSettingsService } = useServices();
+  const open = true;
+  const [accounts, setAccounts] = useState<PaymentAccount[]>();
+  const [accountKey, setAccountKey] = useState(
+    editing ? JSON.stringify([editing.providerId, editing.accountId]) : "",
+  );
+  const [amount, setAmount] = useState(editing ? String(editing.amount) : "");
+  const [currency, setCurrency] = useState<SubscriptionPayment["currency"]>(
+    editing?.currency ?? "CNY",
+  );
+  const [start, setStart] = useState(() =>
+    dateText(
+      editing?.start ?? new Date(new Date().getFullYear(), new Date().getMonth(), 1).getTime(),
+    ),
+  );
+  const [end, setEnd] = useState(() =>
+    dateText(
+      editing
+        ? editing.end - 1
+        : new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getTime(),
+    ),
+  );
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+  useEffect(() => {
+    if (!open) return;
+    let active = true;
+    setError(undefined);
+    setAccounts(undefined);
+    void readPaymentAccounts(
+      providerSettingsService,
+      intl.formatMessage({ id: "settings.usage.payments.connection" }),
+    )
+      .then((result) => {
+        if (active) setAccounts(result);
+      })
+      .catch((reason) => {
+        if (active) {
+          setAccounts([]);
+          setError(String(reason));
+        }
+      });
+    return () => {
+      active = false;
+    };
+  }, [open, providerSettingsService, intl]);
+  const options = [...(accounts ?? [])];
+  if (
+    editing &&
+    !options.some((a) => a.providerId === editing.providerId && a.accountId === editing.accountId)
+  )
+    options.push({
+      providerId: editing.providerId,
+      accountId: editing.accountId,
+      label: editing.accountLabel,
+    });
+  const save = async () => {
+    const account = options.find((a) => JSON.stringify([a.providerId, a.accountId]) === accountKey);
+    if (!account || !amount.trim()) {
+      setError(t("required"));
+      return;
+    }
+    const parsed = subscriptionPaymentSchema.safeParse({
+      id: editing?.id ?? crypto.randomUUID(),
+      providerId: account.providerId,
+      accountId: account.accountId,
+      accountLabel: account.label,
+      // 只修改金额时保留原来的绝对账期边界，不能因设备时区改变悄悄改写旧账。
+      start:
+        editing && start === dateText(editing.start)
+          ? editing.start
+          : new Date(`${start}T00:00:00`).getTime(),
+      end: editing && end === dateText(editing.end - 1) ? editing.end : nextDay(end),
+      amount: Number(amount),
+      currency,
+    });
+    if (!parsed.success) {
+      setError(t("invalid"));
+      return;
+    }
+    if (
+      payments.some(
+        (p) =>
+          p.id !== parsed.data.id &&
+          p.providerId === parsed.data.providerId &&
+          p.accountId === parsed.data.accountId &&
+          p.start < parsed.data.end &&
+          parsed.data.start < p.end,
+      )
+    ) {
+      setError(t("overlap"));
+      return;
+    }
+    setBusy(true);
+    try {
+      await update({ subscriptionPayments: { [parsed.data.id]: parsed.data } });
+      onSaved(parsed.data.id);
+      onClose();
+    } catch (reason) {
+      setError(String(reason));
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(value) => {
+        if (!busy && !value) onClose();
+      }}
+    >
+      <DialogContent className="sm:max-w-[480px]">
+        <DialogHeader>
+          <DialogTitle>{t(editing ? "edit" : "add")}</DialogTitle>
+          <DialogDescription>{t("formDescription")}</DialogDescription>
+        </DialogHeader>
+        <div className="space-y-3">
+          <label className="block space-y-1 text-ui-sm">
+            <span>{t("account")}</span>
+            <Select
+              value={accountKey}
+              onValueChange={setAccountKey}
+              disabled={accounts === undefined}
+            >
+              <SelectTrigger className="w-full">
+                <SelectValue
+                  placeholder={
+                    accounts === undefined
+                      ? intl.formatMessage({ id: "common.loading" })
+                      : t("account")
+                  }
+                />
+              </SelectTrigger>
+              <SelectContent>
+                {options.map((a) => (
+                  <SelectItem
+                    key={JSON.stringify([a.providerId, a.accountId])}
+                    value={JSON.stringify([a.providerId, a.accountId])}
+                  >
+                    {a.label}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+            {accounts?.length === 0 && !editing && !error ? (
+              <span className="text-foreground-subtle">{t("noAccounts")}</span>
+            ) : null}
+          </label>
+          <div className="grid grid-cols-2 gap-3">
+            <label className="space-y-1 text-ui-sm">
+              {t("start")}
+              <Input
+                className="[color-scheme:light] dark:[color-scheme:dark]"
+                type="date"
+                value={start}
+                onChange={(e) => setStart(e.target.value)}
+              />
+            </label>
+            <label className="space-y-1 text-ui-sm">
+              {t("end")}
+              <Input
+                className="[color-scheme:light] dark:[color-scheme:dark]"
+                type="date"
+                value={end}
+                onChange={(e) => setEnd(e.target.value)}
+              />
+            </label>
+          </div>
+          <div className="flex items-end gap-3">
+            <label className="min-w-0 flex-1 space-y-1 text-ui-sm">
+              {t("amount")}
+              <Input
+                type="number"
+                min="0"
+                step="0.01"
+                value={amount}
+                onChange={(e) => setAmount(e.target.value)}
+              />
+            </label>
+            <Select
+              value={currency}
+              onValueChange={(v) => setCurrency(v as SubscriptionPayment["currency"])}
+            >
+              <SelectTrigger className="w-24" aria-label={t("currency")}>
+                <SelectValue />
+              </SelectTrigger>
+              <SelectContent>
+                {["CNY", "USD", "EUR", "GBP", "JPY"].map((c) => (
+                  <SelectItem key={c} value={c}>
+                    {c}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          </div>
+          {error ? (
+            <p role="alert" className="text-ui-sm text-destructive">
+              {error}
+            </p>
+          ) : null}
+        </div>
+        <DialogFooter>
+          <Button variant="ghost" disabled={busy} onClick={onClose}>
+            {intl.formatMessage({ id: "common.cancel" })}
+          </Button>
+          <Button disabled={busy} onClick={() => void save()}>
+            {intl.formatMessage({ id: "common.save" })}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
