+
+/** Quota inspection is read-only; execution receipts take precedence over a configured default. */
+export function resolveQuotaInspectionAccount<T extends { id: string; active: boolean }>(
+  accounts: readonly T[],
+  inspectedId?: string,
+  servedId?: string,
+): T | undefined {
+  return (
+    accounts.find((account) => account.id === inspectedId) ??
+    accounts.find((account) => account.id === servedId) ??
+    accounts.find((account) => account.active) ??
+    accounts[0]
+  );
+}
