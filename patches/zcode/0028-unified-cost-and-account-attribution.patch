diff --git a/packages/shared/src/usage-cost-report.ts b/packages/shared/src/usage-cost-report.ts
new file mode 100644
index 0000000..6c34992
--- /dev/null
+++ b/packages/shared/src/usage-cost-report.ts
@@ -0,0 +1,214 @@
+import {
+  allocateSubscriptionPayment,
+  type SubscriptionPayment,
+  type UsageAccountingRow,
+} from "./usage-accounting.js";
+
+export interface UsageCostTotals {
+  requests: number;
+  reportedCount: number;
+  pricedCount: number;
+  totalTokens: number;
+  apiUsd: number | null;
+  actualAmount: number | null;
+  apiPerMillion: number | null;
+  actualPerMillion: number | null;
+}
+
+export interface UsageCostModel extends UsageCostTotals {
+  modelId: string;
+  priceSources: string[];
+  priceVersions: string[];
+}
+
+export interface UsageCostProject extends UsageCostTotals {
+  workspacePath: string | null;
+  models: UsageCostModel[];
+}
+
+export interface UsageCostReport {
+  summary: UsageCostTotals & {
+    unallocatedAmount: number | null;
+    unknownAccountRequests: number;
+    allocationBasis: "credits" | "api-value" | "unavailable" | null;
+    apiMinusActualUsd: number | null;
+  };
+  models: UsageCostModel[];
+  projects: UsageCostProject[];
+}
+
+export interface UsageCostReportOptions {
+  payment?: SubscriptionPayment;
+  workspacePath?: string | null;
+}
+
+const compareId = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+const workspace = (row: UsageAccountingRow) => row.workspacePath ?? null;
+type SumField =
+  | "requestCount"
+  | "reportedCount"
+  | "pricedCount"
+  | "inputTokens"
+  | "outputTokens"
+  | "estimatedUsd";
+const sum = (rows: readonly UsageAccountingRow[], field: SumField) =>
+  rows.reduce((total, row) => total + row[field], 0);
+const provenance = (rows: readonly UsageAccountingRow[], field: "priceSources" | "priceVersions") =>
+  [
+    ...new Set(
+      rows.flatMap((row) =>
+        (row[field] ?? "")
+          .split(",")
+          .map((value) => value.trim())
+          .filter(Boolean),
+      ),
+    ),
+  ].sort(compareId);
+
+function groupRows<K>(rows: readonly UsageAccountingRow[], key: (row: UsageAccountingRow) => K) {
+  const groups = new Map<K, UsageAccountingRow[]>();
+  for (const row of rows) {
+    const value = key(row);
+    const group = groups.get(value) ?? [];
+    group.push(row);
+    groups.set(value, group);
+  }
+  return groups;
+}
+
+function coverage(rows: readonly UsageAccountingRow[], field: "reportedCount" | "pricedCount") {
+  return rows.every((row) => row[field] === row.requestCount);
+}
+
+function totals(rows: readonly UsageAccountingRow[], actualAmount: number | null): UsageCostTotals {
+  const requests = sum(rows, "requestCount");
+  const reportedCount = sum(rows, "reportedCount");
+  const pricedCount = sum(rows, "pricedCount");
+  const totalTokens = sum(rows, "inputTokens") + sum(rows, "outputTokens");
+  const apiUsd = pricedCount > 0 ? sum(rows, "estimatedUsd") : null;
+  const unitsKnown = requests > 0 && totalTokens > 0 && coverage(rows, "reportedCount");
+  return {
+    requests,
+    reportedCount,
+    pricedCount,
+    totalTokens,
+    apiUsd,
+    actualAmount,
+    apiPerMillion:
+      unitsKnown && coverage(rows, "pricedCount") && apiUsd !== null
+        ? (apiUsd * 1_000_000) / totalTokens
+        : null,
+    actualPerMillion:
+      unitsKnown && actualAmount !== null ? (actualAmount * 1_000_000) / totalTokens : null,
+  };
+}
+
+/** Derive one cost view from the existing ledger; the payment allocator remains the sole authority. */
+export function buildUsageCostReport(
+  rows: readonly UsageAccountingRow[],
+  options: UsageCostReportOptions = {},
+): UsageCostReport {
+  const { payment } = options;
+  const matchesAccount = (row: UsageAccountingRow) =>
+    !payment ||
+    (row.providerId === payment.providerId &&
+      row.accountId === (payment.accountId === "connection" ? null : payment.accountId));
+  const overlapsPeriod = (row: UsageAccountingRow) =>
+    !payment || (row.firstAt < payment.end && row.lastAt >= payment.start);
+  const withinPeriod = (row: UsageAccountingRow) =>
+    !payment || (row.firstAt >= payment.start && row.lastAt < payment.end);
+  const allocationRows = payment
+    ? rows.filter(
+        (row) =>
+          row.providerId === payment.providerId &&
+          (matchesAccount(row) || row.accountId === null) &&
+          overlapsPeriod(row),
+      )
+    : [];
+  const eligible = rows.filter((row) => matchesAccount(row) && withinPeriod(row));
+  const unknownAccountRequests =
+    payment && payment.accountId !== "connection"
+      ? sum(
+          allocationRows.filter((row) => row.accountId === null),
+          "requestCount",
+        )
+      : 0;
+  const hasBoundaryOverlap = allocationRows.some((row) => !withinPeriod(row));
+  const allocation = payment ? allocateSubscriptionPayment(payment, allocationRows) : null;
+  const allocated = allocation !== null && allocation.basis !== "unavailable";
+  const modelAllocations = new Map(allocation?.models.map((model) => [model.modelId, model]));
+  const weight = (row: UsageAccountingRow) =>
+    allocation?.basis === "credits" ? row.estimatedCredits : row.estimatedUsd;
+
+  // 先让既有分摊器计算整个账号账期，再按项目取其份额，避免每个项目重复承担整张账单。
+  const modelAmount = (modelId: string, selectedRows: readonly UsageAccountingRow[]) => {
+    if (!allocated) return null;
+    const model = modelAllocations.get(modelId);
+    if (!model || model.weight === 0) return 0;
+    const selectedWeight = selectedRows.reduce((total, row) => total + weight(row), 0);
+    return model.amount * (selectedWeight / model.weight);
+  };
+  const modelRows = (selectedRows: readonly UsageAccountingRow[]): UsageCostModel[] =>
+    [...groupRows(selectedRows, (row) => row.modelId)]
+      .map(([modelId, modelUsage]) => ({
+        modelId,
+        priceSources: provenance(modelUsage, "priceSources"),
+        priceVersions: provenance(modelUsage, "priceVersions"),
+        ...totals(modelUsage, modelAmount(modelId, modelUsage)),
+      }))
+      .sort((a, b) => b.totalTokens - a.totalTokens || compareId(a.modelId, b.modelId));
+  const actualTotal = (models: readonly UsageCostModel[]) =>
+    allocated ? models.reduce((total, model) => total + model.actualAmount!, 0) : null;
+  const hasProjectFilter = options.workspacePath !== undefined;
+  const selected = hasProjectFilter
+    ? eligible.filter((row) => workspace(row) === options.workspacePath)
+    : eligible;
+  const models = modelRows(selected);
+  const actualAmount = payment ? (hasProjectFilter ? actualTotal(models) : payment.amount) : null;
+  const summary = totals(selected, actualAmount);
+  // 缺失归属或跨账期聚合不能被当前设置补齐，也不能算作完整的费用对比。
+  const comparable =
+    payment?.currency === "USD" &&
+    !hasBoundaryOverlap &&
+    unknownAccountRequests === 0 &&
+    summary.requests > 0 &&
+    actualAmount !== null &&
+    summary.apiUsd !== null &&
+    coverage(eligible, "reportedCount") &&
+    coverage(eligible, "pricedCount");
+  return {
+    summary: {
+      ...summary,
+      actualPerMillion: allocated ? summary.actualPerMillion : null,
+      unallocatedAmount: !payment
+        ? null
+        : hasProjectFilter
+          ? allocated
+            ? 0
+            : null
+          : allocation!.unallocated,
+      unknownAccountRequests,
+      allocationBasis: allocation?.basis ?? null,
+      apiMinusActualUsd: comparable ? summary.apiUsd! - actualAmount! : null,
+    },
+    models,
+    projects: [...groupRows(selected, workspace)]
+      .map(([workspacePath, projectRows]) => {
+        const projectModels = modelRows(projectRows);
+        return {
+          workspacePath,
+          ...totals(projectRows, actualTotal(projectModels)),
+          models: projectModels,
+        };
+      })
+      .sort(
+        (a, b) =>
+          b.totalTokens - a.totalTokens ||
+          (a.workspacePath === null
+            ? 1
+            : b.workspacePath === null
+              ? -1
+              : compareId(a.workspacePath, b.workspacePath)),
+      ),
+  };
+}
