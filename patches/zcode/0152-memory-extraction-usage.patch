+test("automatic memory extraction records its own physical model usage (K-03)", async () => {
+  const { NodeFileSystemAdapter } = await import("../../adapters/src/fs/index.js");
+  const f = await fixture("pi", false, { deps: { fileSystemPort: new NodeFileSystemAdapter() } } as never);
+  try {
+    const runtime = f.runtime as never as { config: Record<string, unknown>; drainMemoryExtractions(id: null): Promise<void> };
+    const memoryRoot = join(f.dir, "memory-owner");
+    runtime.config.memory = { enabled: true, use: true, cliStorageRoot: memoryRoot, storageRoot: memoryRoot };
+    f.steps.push(
+      () => reply("main reply"),
+      () => ({ ...reply("Nothing to save."), usage: { inputTokens: 701, outputTokens: 23, totalTokens: 724 } }),
+    );
+    await f.runtime.executeTurn("Remember this synthetic preference for later ordinary work");
+    await runtime.drainMemoryExtractions(null);
+    await f.reopen();
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    const rows = db
+      .prepare("select query_source, input_tokens, output_tokens from model_usage order by started_at")
+      .all()
+      .map((row) => ({ ...row }));
+    db.close();
+    assert.equal(f.requests.length, 2);
+    assert.equal(rows.length, 2);
+    assert.equal(rows[0]?.query_source, "main_turn");
+    assert.deepEqual({ input: rows[1]?.input_tokens, output: rows[1]?.output_tokens }, { input: 701, output: 23 });
+    assert.notEqual(rows[1]?.query_source, "main_turn");
+  } finally {
+    await f.close();
+  }
+});
