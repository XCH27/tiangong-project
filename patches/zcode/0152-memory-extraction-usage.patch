 import { createRuntimeModel, withModelInvocationContext } from "../methods/runtime-model.js";
+import { recordModelUsageFact } from "../methods/usage-observability.js";
+
+/**
+ * K-03：Memory 抽取是真实的模型请求，但不是 Turn 的一部分。每次物理调用以独立子 span
+ * 写入同一用量账本（querySource 为该 operation），失败与取消也保留已观察到的用量。
+ */
+function withMemoryUsageRecording(
+  runtime: AgentRuntimeInternal,
+  model: Model,
+  operation: ModelApiOperation,
+  traceContext: TraceContext,
+): Model {
+  return Object.freeze({
+    ...model,
+    bind: (options: Parameters<Model["bind"]>[0]) =>
+      withMemoryUsageRecording(runtime, model.bind(options), operation, traceContext),
+    async generateText(request: Parameters<Model["generateText"]>[0]) {
+      const callTrace = createChildTraceContext(traceContext, {
+        attributes: { model: `${model.providerId}/${model.modelId}`, querySource: operation },
+      });
+      const startedAt = Date.now();
+      const usage = { events: [], model, networkEventStartIndex: 0, querySource: operation, startedAt, traceContext: callTrace };
+      try {
+        const result = await model.generateText(request);
+        await recordModelUsageFact(runtime, {
+          ...usage,
+          result,
+          status: request.abortSignal?.aborted ? "cancelled" : "completed",
+          toolCallCount: result.toolCalls?.length ?? 0,
+        });
+        return result;
+      } catch (error) {
+        await recordModelUsageFact(runtime, {
+          ...usage,
+          error,
+          status: request.abortSignal?.aborted ? "cancelled" : "error",
+        });
+        throw error;
+      }
+    },
+  });
+}
 
