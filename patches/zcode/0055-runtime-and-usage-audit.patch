new file mode 100644
index 0000000..6cf21f7
--- /dev/null
+++ b/packages/ui/test/usageHooks.browser.tsx
@@ -0,0 +1,124 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { useCodingPlanUsageStats } from "../src/hooks/useUsageStats.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+async function fixture() {
+  const container = document.createElement("div");
+  document.body.append(container);
+  let root = createRoot(container);
+  let closed = false;
+  const requests: Array<ReturnType<typeof Promise.withResolvers<any>>> = [];
+  const services = {
+    usageStatsService: {
+      getCodingPlanUsageSnapshot() {
+        const request = Promise.withResolvers<any>();
+        requests.push(request);
+        return request.promise;
+      },
+    },
+  };
+  const renders: Array<{ provider: string; marker?: string }> = [];
+  let latest: ReturnType<typeof useCodingPlanUsageStats>;
+  function Probe({ provider, enabled }: { provider: string; enabled: boolean }) {
+    latest = useCodingPlanUsageStats("7d", {
+      enabled,
+      preferredProviderId: provider,
+      accountAccess: { type: "fixture", accountId: provider } as never,
+    });
+    renders.push({ provider, marker: (latest.snapshot as any)?.marker });
+    return null;
+  }
+  return {
+    requests,
+    renders,
+    get latest() {
+      return latest!;
+    },
+    async render(provider: string, enabled = true) {
+      if (closed) {
+        document.body.append(container);
+        root = createRoot(container);
+        closed = false;
+      }
+      await act(async () => {
+        root.render(
+          <ServiceProvider services={services as never}>
+            <Probe provider={provider} enabled={enabled} />
+          </ServiceProvider>,
+        );
+      });
+    },
+    async resolve(index: number, marker: string) {
+      await act(async () => {
+        requests[index]!.resolve({ marker });
+      });
+    },
+    async close() {
+      if (closed) return;
+      await act(async () => {
+        root.unmount();
+      });
+      container.remove();
+      closed = true;
+    },
+  };
+}
+
+async function run() {
+  const results: Array<{ name: string; error?: string }> = [];
+  const cases: Record<string, (f: Awaited<ReturnType<typeof fixture>>) => Promise<void>> = {
+    "cached account switch rejects the previous account's late result": async (f) => {
+      await f.render("B");
+      await f.resolve(0, "B");
+      await f.render("A");
+      await f.render("B");
+      check(f.requests.length === 2, "B should reuse its fresh cache");
+      await f.resolve(1, "A");
+      check((f.latest.snapshot as any)?.marker === "B", "late A overwrote cached B");
+    },
+    "disabling the reader rejects pending completions": async (f) => {
+      await f.render("A");
+      await f.render("A", false);
+      await f.resolve(0, "A");
+      check(f.latest.snapshot === null, "disabled reader published a late snapshot");
+    },
+    "the first render of a new account never shows the former account": async (f) => {
+      await f.render("A");
+      await f.resolve(0, "A");
+      await f.render("B");
+      check(!f.renders.some((r) => r.provider === "B" && r.marker === "A"), "cross-account render");
+      await f.resolve(1, "B");
+    },
+    "unmounted pending reads populate only their own reusable cache": async (f) => {
+      await f.render("A");
+      await f.close();
+      await f.resolve(0, "A");
+      // The closed reader must never publish a new state.
+      check(f.latest.snapshot === null, "unmounted reader published a snapshot");
+      await f.render("A");
+      check(f.requests.length === 1, "remount should reuse the settled same-account cache");
+      check((f.latest.snapshot as any)?.marker === "A", "remount lost its same-account snapshot");
+    },
+  };
+  for (const [name, execute] of Object.entries(cases)) {
+    const f = await fixture();
+    try {
+      await execute(f);
+      results.push({ name });
+    } catch (error) {
+      results.push({ name, error: String(error) });
+    } finally {
+      await f.close();
+    }
+  }
+  return results;
+}
+
+(globalThis as any).__usageHookTests = run();
diff --git a/scripts/test-usage-hooks.mjs b/scripts/test-usage-hooks.mjs
new file mode 100644
index 0000000..3195144
--- /dev/null
+++ b/scripts/test-usage-hooks.mjs
@@ -0,0 +1,55 @@
+// Exercise the actual React hooks in the installed desktop renderer, with no accounts or network.
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { createRequire } from "node:module";
+import { spawn } from "node:child_process";
+
+const require = createRequire(import.meta.url);
+const { build } = createRequire(new URL("../apps/zcode-cli/package.json", import.meta.url))(
+  "esbuild",
+);
+const root = resolve(import.meta.dirname, "..");
+const profile = await mkdtemp(join(tmpdir(), "fleet-usage-hooks-"));
+try {
+  await build({
+    entryPoints: [join(root, "packages/ui/test/usageHooks.browser.tsx")],
+    outfile: join(profile, "test.js"),
+    bundle: true,
+    platform: "browser",
+    format: "esm",
+    tsconfig: join(root, "packages/ui/tsconfig.json"),
+    define: { "process.env.NODE_ENV": '"development"' },
+  });
+  await writeFile(join(profile, "index.html"), '<script type="module" src="./test.js"></script>');
+  await writeFile(
+    join(profile, "main.cjs"),
+    `
+const { app, BrowserWindow, session } = require("electron");
+app.setPath("userData", ${JSON.stringify(join(profile, "data"))});
+app.whenReady().then(async () => {
+  session.defaultSession.webRequest.onBeforeRequest({urls:["http://*/*","https://*/*"]}, (_r, cb) => cb({cancel:true}));
+  const window = new BrowserWindow({show:false, webPreferences:{sandbox:true, contextIsolation:true}});
+  await window.loadFile(${JSON.stringify(join(profile, "index.html"))});
+  const results = await window.webContents.executeJavaScript("window.__usageHookTests");
+  if (!Array.isArray(results)) throw new Error("Renderer test bundle did not execute");
+  results.forEach(r => console.log((r.error ? "FAIL " : "PASS ") + r.name + (r.error ? ": " + r.error : "")));
+  app.exit(results.some(r => r.error) ? 1 : 0);
+}).catch(error => {console.error(error);app.exit(1)});
+setTimeout(() => {console.error("Usage hook tests timed out");app.exit(1)}, 20000);
+`,
+  );
+  const env = { ...process.env };
+  delete env.ELECTRON_RUN_AS_NODE;
+  const code = await new Promise((done, reject) => {
+    const child = spawn(require("electron"), [join(profile, "main.cjs")], {
+      env,
+      stdio: "inherit",
+    });
+    child.on("error", reject);
+    child.on("exit", (code) => done(code ?? 1));
+  });
+  process.exitCode = code;
+} finally {
+  await rm(profile, { recursive: true, force: true });
+}
