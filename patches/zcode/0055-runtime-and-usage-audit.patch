+test("adjacent usage ranges count every boundary once across costs, models, tools, skills and days", async () => {
+  const f = await fixture();
+  try {
+    for (const at of [100, 200, 300]) {
+      const turnID = `turn-${at}` as TurnId;
+      await f.record(`model-${at}`, "a", "standard", { startedAt: at, turnID });
+      await f.store.upsertTurnUsage({
+        sessionID: "session" as SessionId,
+        turnID,
+        status: "completed",
+        startedAt: at,
+        completedAt: at + 1,
+      });
+      await f.store.upsertToolUsage({
+        id: `skill-${at}`,
+        sessionID: "session" as SessionId,
+        turnID,
+        toolCallID: `skill-${at}`,
+        toolName: "Skill",
+        status: "completed",
+        startedAt: at,
+        skillMetadata: { qualifiedName: "design:review", source: "plugin" },
+      });
+    }
+    f.reopen();
+    for (const [since, until, count] of [
+      [100, 200, 1],
+      [200, 300, 1],
+      [100, 300, 2],
+    ]) {
+      const result = await f.query(since, until);
+      assert.equal(result.totals.modelRequestCount, count);
+      assert.equal(
+        result.accounting?.reduce((n, row) => n + row.requestCount, 0),
+        count,
+      );
+      assert.equal(result.models[0]?.requestCount, count);
+      assert.equal(result.turnTotals.totalTurns, count);
+      assert.equal(result.toolTotals.toolCallCount, count);
+      assert.equal(result.tools[0]?.callCount, count);
+      assert.equal(result.skills?.[0]?.callCount, count);
+      assert.equal(result.modelActivities?.[0]?.toolCallCount, count);
+      assert.equal(result.days[0]?.toolCallCount, count);
+      assert.equal(result.days[0]?.turnCount, count);
+      assert.equal(result.dayModels[0]?.totalTokens, count * 1100);
+    }
+  } finally {
+    await f.close();
+  }
+});
