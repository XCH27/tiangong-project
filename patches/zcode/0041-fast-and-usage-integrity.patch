+/** Match the effort control's evidence boundary: runtime fallback is not Fast availability. */
+export function modelSupportsFast(
+  view: ModelSelectionView | null,
+  providerId: string | undefined,
+  modelId: string | undefined,
+): boolean {
+  const model = view?.providers.find((provider) => provider.providerId === providerId)
+    ?.models.find((candidate) => candidate.modelId === modelId);
+  return Boolean(model?.evidenceConfig
+    ? model.evidenceConfig.optionSpecs?.speedMode
+    : model?.config.optionSpecs.speedMode);
+}
