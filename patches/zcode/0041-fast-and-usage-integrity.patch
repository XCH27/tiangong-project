+import assert from "node:assert/strict";
+import test from "node:test";
+import { subscriptionUiErrorKey } from "../src/settings/model-provider-section/subscriptionUiError.js";
+
+test("subscription account errors map to actionable local copy without exposing provider bodies", () => {
+  assert.equal(subscriptionUiErrorKey(new Error("Paste the complete localhost callback URL")),
+    "callbackIncomplete");
+  assert.equal(subscriptionUiErrorKey(new Error("This callback does not belong to the current login")),
+    "callbackMismatch");
+  assert.equal(subscriptionUiErrorKey(new Error("Remove an account before adding another")),
+    "accountLimit");
+  assert.equal(subscriptionUiErrorKey(new Error("Subscription account changed during refresh")),
+    "accountChanged");
+  assert.equal(subscriptionUiErrorKey(new TypeError("fetch failed")), "network");
+  assert.equal(subscriptionUiErrorKey(new Error("upstream included private token")), "generic");
+});
