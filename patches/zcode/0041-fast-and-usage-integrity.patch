diff --git a/packages/ui/src/settings/model-provider-section/subscriptionUiError.ts b/packages/ui/src/settings/model-provider-section/subscriptionUiError.ts
new file mode 100644
index 0000000..f66a416
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/subscriptionUiError.ts
@@ -0,0 +1,17 @@
+/** Never surface an SDK or OAuth exception body directly in the account card. */
+export function subscriptionUiErrorKey(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  if (message === "Paste the complete localhost callback URL") return "callbackIncomplete";
+  if (message === "This callback does not belong to the current login") return "callbackMismatch";
+  if (message === "Subscription login expired or cancelled" ||
+      message === "Subscription operation cancelled") return "expired";
+  if (message === "Remove an account before adding another") return "accountLimit";
+  if (message.includes("account changed") || message === "Account no longer exists")
+    return "accountChanged";
+  if (message === "Unsupported authorization step" ||
+      message === "Subscription authorization is unavailable") return "unsupported";
+  if (message === "Unexpected authorization address") return "address";
+  if (error instanceof TypeError || /\b(?:ETIMEDOUT|ECONNRESET|ENOTFOUND)\b/.test(message))
+    return "network";
+  return "generic";
+}
