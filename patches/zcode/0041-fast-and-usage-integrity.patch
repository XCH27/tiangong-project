+export function modelCatalogFailureKind(error: unknown):
+  "noCatalog" | "unauthorized" | "forbidden" | "failed" {
+  const message = error instanceof Error ? error.message : typeof error === "string" ? error : "";
+  const status = /Model list request failed \((\d{3})\)/.exec(message)?.[1];
+  if (status === "404" || status === "405") return "noCatalog";
+  if (status === "401") return "unauthorized";
+  // A bare 403 does not identify whether the key, model entitlement, region or endpoint denied access.
+  if (status === "403") return "forbidden";
+  return "failed";
+}
