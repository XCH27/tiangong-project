@@ -0,0 +1,159 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { CODING_PLAN_SYSTEM_BUSY, type ProviderFamilyDomain } from "@zcode/shared";
+import { useOptionalServices } from "@/hooks/useServices.js";
+import { isRemoteWorkspaceDisconnectedError } from "@/lib/remoteWorkspaceServiceError.js";
+import { logger } from "@/logger.js";
+import {
+  projectTeamSubscriptionProducts,
+  type TeamSubscriptionProduct,
+} from "@/settings/model-provider-section/teamSubscriptionProducts.js";
+
+interface TeamSubscriptionState {
+  scope: object;
+  snapshot: TeamSubscriptionSnapshot | null;
+  loading: boolean;
+  error: string | null;
+}
+
+interface TeamSubscriptionSnapshot {
+  productList: TeamSubscriptionProduct[];
+}
+
+/** The purchase-card hook is retired; this reader projects existing subscribed Team identities. */
+export function useTeamSubscriptionProducts({
+  enabled,
+  family = "bigmodel",
+  identity,
+}: {
+  enabled: boolean;
+  family?: ProviderFamilyDomain;
+  /** Existing account-provider revision/fingerprint; never displayed or logged. */
+  identity: string;
+}) {
+  const services = useOptionalServices();
+  const service = services?.codingPlanSubscriptionService;
+  const scope = useMemo(
+    () => ({ service, enabled, family, identity }),
+    [service, enabled, family, identity],
+  );
+  const currentScopeRef = useRef<object | null>(scope);
+  const requestVersionRef = useRef(0);
+  const [state, setState] = useState<TeamSubscriptionState>({
+    scope,
+    snapshot: null,
+    loading: enabled,
+    error: null,
+  });
+
+  const refresh = useCallback(async () => {
+    if (currentScopeRef.current !== scope) return;
+    const requestVersion = ++requestVersionRef.current;
+    if (!scope.enabled) {
+      setState({ scope, snapshot: null, loading: false, error: null });
+      return;
+    }
+    if (!scope.service) {
+      setState({ scope, snapshot: null, loading: false, error: "service_unavailable" });
+      return;
+    }
+
+    setState((current) => ({
+      scope,
+      snapshot: current.scope === scope ? current.snapshot : null,
+      loading: true,
+      error: null,
+    }));
+
+    try {
+      const pricing = await scope.service.getEnterprisePricing({
+        authenticated: true,
+        family: scope.family,
+      });
+      if (requestVersionRef.current !== requestVersion || currentScopeRef.current !== scope) return;
+      setState({
+        scope,
+        snapshot: {
+          productList: projectTeamSubscriptionProducts(pricing.productList, scope.family),
+        },
+        loading: false,
+        error: null,
+      });
+    } catch (error) {
+      if (requestVersionRef.current !== requestVersion || currentScopeRef.current !== scope) return;
+      const message = normalizeEnterprisePricingError(error);
+      // 远端 workspace 壳层会早于 attachment 绑定短暂渲染；此时断连代理报错是
+      // 可预期的初始化等待态，不应伪装成 pricing 故障。真实 RPC 错误仍保留 warn。
+      if (!isRemoteWorkspaceDisconnectedError(error)) {
+        logger.warn("[useTeamSubscriptionProducts] 读取企业 Coding Plan 套餐失败", {
+          error: message,
+        });
+      }
+      setState({
+        scope,
+        // Team sources are selectable account identities. Without a dated stale label,
+        // a failed refresh must not leave a former subscription looking active.
+        snapshot: null,
+        loading: false,
+        error: message,
+      });
+    }
+  }, [scope]);
+
+  useLayoutEffect(() => {
+    currentScopeRef.current = scope;
+    return () => {
+      currentScopeRef.current = null;
+      requestVersionRef.current += 1;
+    };
+  }, [scope]);
+
+  useEffect(() => {
+    void refresh();
+  }, [refresh]);
+
+  // 切换 family/账号的首帧也不能显示旧商品，不能只在 effect 完成时过滤。
+  return {
+    snapshot: scope.enabled && state.scope === scope ? state.snapshot : null,
+    loading: scope.enabled && state.scope === scope ? state.loading : scope.enabled,
+    error: scope.enabled && state.scope === scope ? state.error : null,
+    refresh,
+  };
+}
+
+/** Keep transport denial distinct from an explicit expired or invalid OAuth credential. */
+export function normalizeEnterprisePricingError(error: unknown): string {
+  const message =
+    error instanceof Error
+      ? error.message || error.name
+      : typeof error === "object" &&
+          error !== null &&
+          "message" in error &&
+          typeof error.message === "string" &&
+          error.message.trim()
+        ? error.message
+        : String(error);
+  const normalized = message.trim().toLowerCase();
+  if (
+    normalized.startsWith("<!doctype") ||
+    /<\s*(html|head|body|script|style|title|meta)\b/.test(normalized) ||
+    normalized.includes("errors.aliyun.com") ||
+    normalized.includes("request has been blocked") ||
+    normalized.includes("unexpected token '<'") ||
+    normalized.includes("unexpected end of json input") ||
+    normalized.includes("invalid json response")
+  )
+    return CODING_PLAN_SYSTEM_BUSY;
+  if (
+    normalized === "bigmodel_oauth_required" ||
+    normalized === "zai_oauth_required" ||
+    normalized.includes("oauth_required") ||
+    /\b401\b/.test(normalized) ||
+    normalized.includes("unauthorized") ||
+    normalized.includes("token expired") ||
+    normalized.includes("expired or incorrect") ||
+    normalized.includes("invalid token") ||
+    normalized.includes("access token")
+  )
+    return "coding_plan_oauth_required";
+  return message;
+}
