@@ -0,0 +1,60 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { EnterpriseCodingPlanPricingProduct, ZCodeProviderAccountAccess } from "@zcode/shared";
+import { projectTeamSubscriptionProducts } from "../src/settings/model-provider-section/teamSubscriptionProducts.js";
+import { buildCodingPlanUsageSources } from "../src/lib/codingPlanUsageSources.js";
+
+const subscribed: EnterpriseCodingPlanPricingProduct = {
+  productId: "team-pro",
+  tier: "PRO",
+  subscribeMode: "CONTINUOUS",
+  subscribePeriod: "MONTHLY",
+  subscribed: true,
+  payAmount: 999,
+  campaignDiscountDetails: [],
+  organizationId: "org-a",
+  organizationName: "Team A",
+  projectId: "project-a",
+  projectName: "Project A",
+  teamProjects: [
+    { organizationId: "org-a", organizationName: "Team A", projectId: "project-a" },
+    { organizationId: "org-a", organizationName: "Team A", projectId: "project-b" },
+  ],
+};
+
+test("Team usage reads only subscribed account/project identity, never purchase prices or SKUs", () => {
+  const products = projectTeamSubscriptionProducts(
+    [subscribed, { ...subscribed, productId: "public-sku", subscribed: false }],
+    "zai",
+  );
+  assert.deepEqual(products, [
+    {
+      family: "zai",
+      productId: "team-pro",
+      organizationId: "org-a",
+      organizationName: "Team A",
+      projectId: "project-a",
+      projectName: "Project A",
+      teamProjects: subscribed.teamProjects,
+    },
+  ]);
+  assert.equal("payAmount" in products[0]!, false);
+  assert.equal("campaignDiscountDetails" in products[0]!, false);
+
+  const sources = buildCodingPlanUsageSources({
+    subscribedTeamProducts: products,
+    accountAccesses: {
+      zai: {
+        type: "zhipu-account",
+        family: "zai",
+        mode: "team-coding-plan",
+        entitled: true,
+      } as ZCodeProviderAccountAccess,
+    },
+  });
+  assert.deepEqual(
+    sources.map((source) => source.accountAccess.projectId),
+    ["project-a", "project-b"],
+  );
+  assert.ok(sources.every((source) => source.providerId.includes("zai")));
+});
