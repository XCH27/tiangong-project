+++ b/packages/ui/test/usageErrorCopy.test.tsx
@@ -0,0 +1,70 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { UsageStatsErrorNotice } from "../src/settings/usage-stats/UsageStatsErrorNotice.js";
+import { normalizeEnterprisePricingError } from "../src/settings/model-provider-section/useTeamSubscriptionProducts.js";
+
+function render(error: string, locale: "en-US" | "zh-CN", provider?: string) {
+  const previous = Object.getOwnPropertyDescriptor(globalThis, "React");
+  Object.defineProperty(globalThis, "React", { configurable: true, value: React });
+  try {
+    return renderToStaticMarkup(
+      <ZCodeIntlProvider initialLocale={locale}>
+        <UsageStatsErrorNotice error={error} provider={provider} />
+      </ZCodeIntlProvider>,
+    );
+  } finally {
+    if (previous) Object.defineProperty(globalThis, "React", previous);
+    else Reflect.deleteProperty(globalThis, "React");
+  }
+}
+
+test("bare 403 is localized access denial without an account-login shortcut", () => {
+  const english = render("Provider HTTP 403 forbidden", "en-US");
+  assert.match(english, /provider denied usage access/i);
+  assert.doesNotMatch(english, /<button\b/);
+  const chinese = render("Provider HTTP 403 forbidden", "zh-CN");
+  assert.match(chinese, /服务商拒绝读取用量统计/);
+  assert.doesNotMatch(chinese, /<button\b/);
+});
+
+test("confirmed 401 still offers the existing account recovery action", () => {
+  const html = render("HTTP 401 unauthorized", "en-US");
+  assert.match(html, /Reconnect the Coding Plan account/);
+  assert.match(html, /Check account/);
+});
+
+test("Team source errors identify the provider and only confirmed auth failure offers reconnect", () => {
+  const denied = render("HTTP 403 forbidden", "zh-CN", "Z.ai");
+  assert.match(denied, /Z\.ai 拒绝读取订阅信息/);
+  assert.doesNotMatch(denied, /<button\b/);
+
+  const credential = render("coding_plan_oauth_required", "en-US", "BigModel");
+  assert.match(credential, /BigModel subscription details are unavailable/);
+  assert.match(credential, /Check account/);
+
+  const unknown = render("network timeout", "en-US", "Z.ai");
+  assert.match(unknown, /Could not read Z\.ai subscription details/);
+  assert.doesNotMatch(unknown, /network timeout/);
+});
+
+test("enterprise pricing retains explicit auth and busy errors without turning 403 into expiry", () => {
+  assert.equal(
+    normalizeEnterprisePricingError(new Error("HTTP 401")),
+    "coding_plan_oauth_required",
+  );
+  assert.equal(
+    normalizeEnterprisePricingError(new Error("HTTP 403 forbidden")),
+    "HTTP 403 forbidden",
+  );
+  assert.equal(
+    normalizeEnterprisePricingError(new Error("zai_oauth_required")),
+    "coding_plan_oauth_required",
+  );
+  assert.equal(
+    normalizeEnterprisePricingError(new Error("<!doctype html>")),
+    "coding_plan_system_busy",
+  );
+});
