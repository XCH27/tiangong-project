+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync, chmodSync, readFileSync, existsSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { AcpClient } from "../src/native-agent/acp-client.js";
+import { listAcpAuthMethods, startAcpLogin } from "../src/native-agent/acp-auth.js";
+import { createAcpNativeAgentPort } from "../src/native-agent/acp-turn.js";
+
+function stoppedAgent(pendingApproval = false) {
+  const dir = mkdtempSync(join(tmpdir(), "acp-stop-"));
+  const script = join(dir, "kimi");
+  const log = join(dir, "outcome");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs = require('node:fs');
+if(process.argv.includes('--version')) { console.log('9.9.9'); process.exit(0); }
+const send = m => console.log(JSON.stringify(m)); let buf='';
+const permission = () => send({id:100,method:'session/request_permission',params:{sessionId:'probe',toolCall:{toolCallId:'late',kind:'edit'},options:[{optionId:'yes',kind:'allow_once'},{optionId:'no',kind:'reject_once'}]}});
+process.stdin.on('data', c => { buf += c; let i; while((i=buf.indexOf('\\n'))>=0) {
+const m=JSON.parse(buf.slice(0,i)); buf=buf.slice(i+1); const reply=result=>send({id:m.id,result});
+if(m.method==='initialize') reply({protocolVersion:1,agentCapabilities:{}});
+else if(m.method==='session/new') reply({sessionId:'probe',configOptions:[{id:'model',category:'model',currentValue:'k3',options:[{value:'k3'}]}]});
+else if(m.method==='session/set_config_option') reply({});
+else if(m.method==='session/prompt') { send({method:'session/update',params:{sessionId:'probe',update:{sessionUpdate:'agent_message_chunk',content:{type:'text',text:'ready'}}}}); if (${pendingApproval}) permission(); }
