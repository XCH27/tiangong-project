+function lifecycleAgent(delaySetup: boolean | "stall") {
+  const dir = mkdtempSync(join(tmpdir(), "acp-lifecycle-"));
+  const script = join(dir, "kimi"),
+    pidPath = join(dir, "pid"),
+    promptPath = join(dir, "prompt");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs=require('node:fs');
+if(process.argv.includes('--version')) { console.log('9.9.9'); process.exit(0); }
+process.on('SIGTERM',()=>{}); process.stdin.on('end',()=>{});
+const send=m=>console.log(JSON.stringify(m)); let buf='';
+process.stdin.on('data',c=>{buf+=c;let i;while((i=buf.indexOf('\\n'))>=0){const m=JSON.parse(buf.slice(0,i));buf=buf.slice(i+1);const reply=result=>send({id:m.id,result});
+if(m.method==='initialize'){fs.writeFileSync(${JSON.stringify(pidPath)},String(process.pid));setTimeout(()=>reply({protocolVersion:1,agentCapabilities:{},authMethods:[{id:'vendor-login',name:'Vendor login'}]}),${delaySetup === "stall" ? 60000 : delaySetup ? 150 : 0});}
+else if(m.method==='session/new') reply({sessionId:'probe',configOptions:[{id:'model',category:'model',currentValue:'k3',options:[{value:'k3'}]}]});
+else if(m.method==='session/prompt'){fs.writeFileSync(${JSON.stringify(promptPath)},'started');reply({stopReason:'end_turn'});}
+else reply({});
+}});setInterval(()=>{},1000);
+`,
+  );
+  chmodSync(script, 0o755);
+  return { dir, script, pidPath, promptPath };
+}
