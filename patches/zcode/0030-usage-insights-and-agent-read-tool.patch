@@ -0,0 +1,115 @@
+import {
+  ReadUsageStatsInputSchema,
+  ReadUsageStatsOutputSchema,
+  ReadUsageStatsOutputJsonSchema,
+  ReadUsageStatsInputJsonSchema,
+  type UsageStorePort,
+} from "@zcode/contracts";
+import type { ToolEntry, ToolHandler } from "../types.js";
+
+const handler: ToolHandler = async (input, context) => {
+  const { range } = ReadUsageStatsInputSchema.parse(input);
+  const store = context.sessionStore as Partial<UsageStorePort> | undefined;
+  if (typeof store?.queryAppUsage !== "function")
+    return {
+      result: false,
+      errorCode: 32,
+      message: "usage_stats_unavailable: this runtime does not expose its local usage ledger",
+    };
+  const until = Date.now();
+  const since = until - (range === "7d" ? 7 : 30) * 86400000;
+  const result = await store.queryAppUsage({ since, until, tzOffsetMs: 0 });
+  const prices = new Map<
+    string,
+    {
+      modelId: string;
+      apiUsdEstimate: number;
+      pricedRequests: number;
+      recordedRequests: number;
+      priceSources: Set<string>;
+    }
+  >();
+  for (const row of result.accounting ?? []) {
+    const value = prices.get(row.modelId) ?? {
+      modelId: row.modelId,
+      apiUsdEstimate: 0,
+      pricedRequests: 0,
+      recordedRequests: 0,
+      priceSources: new Set<string>(),
+    };
+    value.apiUsdEstimate += row.estimatedUsd;
+    value.pricedRequests += row.pricedCount;
+    value.recordedRequests += row.requestCount;
+    (row.priceSources ?? "")
+      .split(",")
+      .filter(Boolean)
+      .forEach((source) => value.priceSources.add(source));
+    prices.set(row.modelId, value);
+  }
+  return ReadUsageStatsOutputSchema.parse({
+    scope: "local-host",
+    since,
+    until,
+    models: result.models,
+    tools: result.tools,
+    skills: result.skills ?? null,
+    unidentifiedSkillCalls: result.unidentifiedSkillCalls ?? null,
+    priceEstimates: [...prices.values()].map((p) => ({
+      ...p,
+      apiUsdEstimate: p.pricedRequests ? p.apiUsdEstimate : null,
+      priceSources: [...p.priceSources],
+    })),
+    attribution:
+      "API equivalents are not subscription payments. Tool/skill counts do not establish accepted outcomes or per-tool token cost. Missing historical identity and prices remain unknown.",
+  });
+};
+export const readUsageStatsToolEntry: ToolEntry = {
+  capability:
+    "Inspect recorded model costs and tool/skill outcomes before proposing resource or cost changes",
+  metadata: {
+    name: "ReadUsageStats",
+    description:
+      "Read this host's existing usage ledger for the last 7 or 30 days. Reports model usage and API-equivalent price coverage, tool call/error/duration counts, and identified Skill invocations. Use measured failures and costs as evidence, not frequency alone. No prompts, credentials, raw tool output or configuration writes are exposed; this cannot remove plugins or switch the user's model.",
+    readOnly: true,
+    destructive: false,
+    concurrentSafe: true,
+    timeoutMs: 10000,
+    maxOutputBytes: 48000,
+    sideEffectScope: "none",
+    riskLevel: "low",
+    needsApproval: false,
+  },
+  handler,
+  inputSchema: ReadUsageStatsInputJsonSchema,
+  outputSchema: ReadUsageStatsOutputJsonSchema,
+  runtimeOutputSchema: ReadUsageStatsOutputSchema,
+  runtimeInputSchema: ReadUsageStatsInputSchema,
+  permission: {
+    permission: "readUsageStats",
+    reason: "Read aggregated local usage facts",
+    riskLevel: "low",
+    sideEffectScope: "none",
+    needsApproval: false,
+    patternSources: ["toolName"],
+    alwaysAllowPatternSources: ["toolName"],
+    denyPriority: "beforeAsk",
+  },
+  resultBudget: {
+    maxInlineBytes: 48000,
+    maxModelBytes: 48000,
+    strategy: "truncate",
+    preview: { maxBytes: 48000, direction: "head" },
+  },
+  timeout: { kind: "timed", defaultMs: 10000, maxMs: 10000, allowCallOverride: false },
+  cancellation: {
+    supported: false,
+    cleanup: "none",
+    userVisibleMessage: "Reading the local usage ledger",
+  },
+  trace: {
+    required: true,
+    propagateToAdapters: false,
+    recordInput: "summary",
+    recordOutput: "summary",
+  },
+};
