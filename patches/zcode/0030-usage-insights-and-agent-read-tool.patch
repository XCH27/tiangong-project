+import type { DatabaseSync } from "node:sqlite";
+import type { AppUsageQueryResult } from "@zcode/contracts";
+
+/** The existing tool ledger is the only counter; missing old metadata is explicit coverage. */
+export function querySkillUsage(db: DatabaseSync, since: number, until: number): Pick<AppUsageQueryResult,"skills"|"unidentifiedSkillCalls"> {
+ const skills=db.prepare(`select
+   json_extract(skill_metadata_json,'$.qualifiedName') as skillId,
+   json_extract(skill_metadata_json,'$.pluginId') as pluginId,
+   json_extract(skill_metadata_json,'$.source') as source,
+   count(*) as callCount,
+   sum(case when status='error' then 1 else 0 end) as errorCount,
+   avg(duration_ms) as avgDurationMs
+   from tool_usage where tool_name='Skill' and started_at >= ? and started_at <= ?
+   and json_type(skill_metadata_json,'$.qualifiedName')='text'
+   and length(trim(json_extract(skill_metadata_json,'$.qualifiedName'))) > 0
+   group by skillId,pluginId,source order by callCount desc,skillId`).all(since,until) as unknown as NonNullable<AppUsageQueryResult['skills']>;
+ const total=db.prepare("select count(*) as total from tool_usage where tool_name='Skill' and started_at >= ? and started_at <= ?").get(since,until) as {total:number};
+ return {skills: skills.map((row) => ({...row})),unidentifiedSkillCalls:total.total-skills.reduce((n,s)=>n+s.callCount,0)};
+}
