+import { z } from "zod";
+import { toToolJsonSchema } from "./json-schema.js";
+
+export const ReadUsageStatsInputSchema = z
+  .object({ range: z.enum(["7d", "30d"]).default("7d") })
+  .strict();
+export const ReadUsageStatsInputJsonSchema = toToolJsonSchema(ReadUsageStatsInputSchema);
+
+const counters = z.object({
+  callCount: z.number(),
+  errorCount: z.number(),
+  avgDurationMs: z.number().nullable(),
+});
+export const ReadUsageStatsOutputSchema = z.object({
+  scope: z.literal("local-host"),
+  since: z.number(),
+  until: z.number(),
+  models: z.array(
+    z.object({
+      modelId: z.string().nullable(),
+      requestCount: z.number(),
+      totalTokens: z.number(),
+      inputTokens: z.number(),
+      outputTokens: z.number(),
+      cacheReadTokens: z.number().optional(),
+      cacheHitRate: z.number().nullable().optional(),
+      cacheReportedRequestCount: z.number().optional(),
+      fastRequestCount: z.number().optional(),
+      speedReportedRequestCount: z.number().optional(),
+    }),
+  ),
+  tools: z.array(counters.extend({ toolName: z.string() })),
+  skills: z
+    .array(
+      counters.extend({
+        skillId: z.string(),
+        pluginId: z.string().nullable(),
+        source: z.string().nullable(),
+      }),
+    )
+    .nullable(),
+  unidentifiedSkillCalls: z.number().nullable(),
+  priceEstimates: z.array(
+    z.object({
+      modelId: z.string(),
+      apiUsdEstimate: z.number().nullable(),
+      pricedRequests: z.number(),
+      recordedRequests: z.number(),
+      priceSources: z.array(z.string()),
+    }),
+  ),
+  attribution: z.string(),
+});
+export const ReadUsageStatsOutputJsonSchema = toToolJsonSchema(ReadUsageStatsOutputSchema);
