+import assert from "node:assert/strict";
+import test from "node:test";
+import { readUsageStatsToolEntry } from "../src/tool/handlers/read-usage-stats.js";
+
+test("Agent statistics reuse the injected ledger, redact account facts and retain pricing coverage", async () => {
+  let calls = 0;
+  const context = {
+    sessionStore: {
+      queryAppUsage: async (input: any) => {
+        calls++;
+        assert.equal(input.until - input.since, 7 * 86400000);
+        return {
+          models: [
+            { modelId: "m", requestCount: 2, totalTokens: 20, inputTokens: 18, outputTokens: 2 },
+          ],
+          tools: [{ toolName: "Read", callCount: 3, errorCount: 1, avgDurationMs: 3 }],
+          skills: [],
+          unidentifiedSkillCalls: 2,
+          accounting: [
+            {
+              accountId: "private-id",
+              modelId: "m",
+              estimatedUsd: 3,
+              pricedCount: 1,
+              requestCount: 2,
+              priceSources: "https://example.com/prices",
+            },
+          ],
+          privateKey: "do-not-return",
+        };
+      },
+    },
+  };
+  const output: any = await readUsageStatsToolEntry.handler({}, context as never);
+  assert.equal(calls, 1);
+  assert.equal(output.tools[0].callCount, 3);
+  assert.equal(output.priceEstimates[0].apiUsdEstimate, 3);
+  assert.equal(output.priceEstimates[0].pricedRequests, 1);
+  assert.equal(output.unidentifiedSkillCalls, 2);
+  assert.equal(JSON.stringify(output).includes("private-id"), false);
+  assert.equal(JSON.stringify(output).includes("do-not-return"), false);
+  assert.equal(readUsageStatsToolEntry.metadata.readOnly, true);
+});
+test("missing ledger and invalid ranges do not become empty successful statistics", async () => {
+  const output: any = await readUsageStatsToolEntry.handler({}, {} as never);
+  assert.equal(output.result, false);
+  await assert.rejects(readUsageStatsToolEntry.handler({ range: "all" }, {} as never));
+});
