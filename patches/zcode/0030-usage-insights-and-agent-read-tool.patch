new file mode 100644
index 0000000..6359426
--- /dev/null
+++ b/packages/ui/src/settings/usage-stats/UsageCostBarChart.tsx
@@ -0,0 +1,135 @@
+import { Bar, BarChart, CartesianGrid, LabelList, XAxis, YAxis } from "recharts";
+import {
+  ChartContainer,
+  ChartTooltip,
+  ChartTooltipContent,
+  type ChartConfig,
+} from "@/components/ui/chart.js";
+
+export interface CostChartRow {
+  key: string;
+  label: string;
+  fullLabel?: string;
+  api: number | null;
+  actual: number | null;
+}
+
+/** Horizontal grouped comparison: EvilCharts 500ecd44 pattern, hosted by ZCode chart primitives. */
+export function UsageCostBarChart({
+  rows,
+  series,
+  currency,
+  money,
+  title,
+}: {
+  rows: CostChartRow[];
+  series: { key: "api" | "actual"; label: string; color: string }[];
+  currency: string;
+  money(value: number | null, currency?: string): string;
+  title: string;
+}) {
+  const config = Object.fromEntries(
+    series.map((s) => [s.key, { label: s.label, color: s.color }]),
+  ) as ChartConfig;
+  return (
+    <div className="max-h-80 overflow-y-auto">
+      <ChartContainer
+        config={config}
+        className="aspect-auto w-full"
+        style={{ height: Math.max(164, rows.length * (series.length === 2 ? 64 : 44) + 28) }}
+      >
+        <BarChart
+          accessibilityLayer
+          layout="vertical"
+          data={rows}
+          margin={{ top: 8, right: 80, bottom: 0, left: 0 }}
+          barCategoryGap={10}
+          barGap={4}
+        >
+          <CartesianGrid horizontal={false} strokeDasharray="3 3" />
+          <YAxis
+            dataKey="key"
+            type="category"
+            width={130}
+            tickLine={false}
+            axisLine={false}
+            tickFormatter={(key: string) => {
+              const label = rows.find((row) => row.key === key)?.label ?? key;
+              return label.length > 20 ? label.slice(0, 19) + "…" : label;
+            }}
+          />
+          <XAxis
+            type="number"
+            tickLine={false}
+            axisLine={false}
+            tickFormatter={(value) => money(Number(value), currency)}
+            minTickGap={36}
+          />
+          <ChartTooltip
+            cursor={{ fill: "var(--color-surface)" }}
+            content={
+              <ChartTooltipContent
+                labelFormatter={(key) =>
+                  rows.find((row) => row.key === key)?.fullLabel ??
+                  rows.find((row) => row.key === key)?.label ??
+                  key
+                }
+                formatter={(value, name) => (
+                  <div className="flex min-w-40 items-center justify-between gap-4">
+                    <span className="text-foreground-subtle">
+                      {config[String(name)]?.label ?? name}
+                    </span>
+                    <span className="font-mono tabular-nums">
+                      {money(typeof value === "number" ? value : null, currency)}
+                    </span>
+                  </div>
+                )}
+              />
+            }
+          />
+          {series.map((s) => (
+            <Bar
+              key={s.key}
+              dataKey={s.key}
+              name={s.key}
+              fill={`var(--color-${s.key})`}
+              radius={[0, 4, 4, 0]}
+              maxBarSize={16}
+              isAnimationActive={false}
+            >
+              <LabelList
+                dataKey={s.key}
+                position="right"
+                className="fill-foreground text-ui-xs"
+                formatter={(value: unknown) =>
+                  typeof value === "number" ? money(value, currency) : "—"
+                }
+              />
+            </Bar>
+          ))}
+        </BarChart>
+      </ChartContainer>
+      <table className="sr-only">
+        <caption>{currency}</caption>
+        <thead>
+          <tr>
+            <th>{title}</th>
+            {series.map((s) => (
+              <th key={s.key}>{s.label}</th>
+            ))}
+          </tr>
+        </thead>
+        <tbody>
+          {rows.map((row) => (
+            <tr key={row.key}>
+              <th>{row.fullLabel ?? row.label}</th>
+              {series.map((s) => (
+                <td key={s.key}>{money(row[s.key], currency)}</td>
+              ))}
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
