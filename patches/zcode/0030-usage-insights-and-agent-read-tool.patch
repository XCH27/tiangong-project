diff --git a/packages/ui/src/settings/usage-stats/AppUsageActivity.tsx b/packages/ui/src/settings/usage-stats/AppUsageActivity.tsx
new file mode 100644
index 0000000..dca7002
--- /dev/null
+++ b/packages/ui/src/settings/usage-stats/AppUsageActivity.tsx
@@ -0,0 +1,107 @@
+import { useState } from "react";
+import type { AppUsageSnapshot } from "@zcode/shared";
+import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import {
+  USAGE_STATS_TABS_LIST_CLASS,
+  USAGE_STATS_TABS_TRIGGER_CLASS,
+} from "./usageStatsUiParts.js";
+
+/** Display original usage/stats facts; never count installed resources as executions. */
+export function AppUsageActivity({ snapshot }: { snapshot: AppUsageSnapshot }) {
+  const { intl, locale } = useZCodeIntl();
+  const t = (key: string, values?: Record<string, string | number>) =>
+    intl.formatMessage({ id: `settings.usage.activity.${key}` }, values);
+  const [view, setView] = useState<"tools" | "skills">("tools");
+  const counts = new Intl.NumberFormat(locale);
+  const percent = new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 1 });
+  const accounted = snapshot.accounting ?? [];
+  const speedKnown = accounted
+    .filter((r) => r.speedMode !== null)
+    .reduce((n, r) => n + r.requestCount, 0);
+  const fast = accounted
+    .filter((r) => r.speedMode === "fast" || r.speedMode === "priority")
+    .reduce((n, r) => n + r.requestCount, 0);
+  const summary = [
+    [t("conversations"), counts.format(snapshot.summary.totalSessions)],
+    [t("toolCalls"), counts.format(snapshot.summary.toolCallCount)],
+    [
+      t("toolErrors"),
+      snapshot.summary.toolCallCount ? percent.format(snapshot.summary.toolErrorRate) : "—",
+    ],
+    [t("fast"), speedKnown ? percent.format(fast / speedKnown) : "—"],
+  ];
+  const rows =
+    view === "tools"
+      ? snapshot.tools.map((r) => ({ ...r, key: r.toolName, label: r.toolName, source: undefined }))
+      : (snapshot.skills ?? []).map((r) => ({
+          ...r,
+          key: JSON.stringify([r.skillId, r.pluginId, r.source]),
+          label: r.skillId,
+          source: r.pluginId ?? r.source ?? undefined,
+        }));
+  return (
+    <section className="grid gap-6 rounded-xl bg-surface p-4 md:grid-cols-2">
+      <div className="space-y-3">
+        <h3 className="text-ui-base font-medium">{t("title")}</h3>
+        <dl className="space-y-3">
+          {summary.map(([label, value]) => (
+            <div key={label} className="flex items-center justify-between gap-3 text-ui-base">
+              <dt className="text-foreground-subtle">{label}</dt>
+              <dd className="font-mono tabular-nums">{value}</dd>
+            </div>
+          ))}
+        </dl>
+      </div>
+      <div className="min-w-0 space-y-3">
+        <Tabs value={view} onValueChange={(v) => setView(v as "tools" | "skills")}>
+          <TabsList className={USAGE_STATS_TABS_LIST_CLASS}>
+            {(["tools", "skills"] as const).map((v) => (
+              <TabsTrigger key={v} value={v} className={USAGE_STATS_TABS_TRIGGER_CLASS}>
+                {t(v)}
+              </TabsTrigger>
+            ))}
+          </TabsList>
+        </Tabs>
+        <ol className="max-h-48 space-y-2 overflow-y-auto">
+          {rows.map((row) => (
+            <li key={row.key}>
+              <ControlHintTooltip
+                title={[
+                  row.source,
+                  t("errors", { count: row.errorCount }),
+                  row.avgDurationMs === null
+                    ? null
+                    : t("duration", { ms: Math.round(row.avgDurationMs) }),
+                ]
+                  .filter(Boolean)
+                  .join(" · ")}
+              >
+                <div
+                  tabIndex={0}
+                  className="flex min-w-0 items-center justify-between gap-3 text-ui-base"
+                >
+                  <span className="truncate">{row.label}</span>
+                  <span className="shrink-0 font-mono tabular-nums text-foreground-subtle">
+                    {t("count", { count: row.callCount })}
+                  </span>
+                </div>
+              </ControlHintTooltip>
+            </li>
+          ))}
+        </ol>
+        {!rows.length ? (
+          <p className="text-ui-sm text-foreground-subtle">
+            {t(view === "skills" ? "noSkills" : "empty")}
+          </p>
+        ) : null}
+        {view === "skills" && snapshot.unidentifiedSkillCalls ? (
+          <p className="text-ui-sm text-foreground-subtle">
+            {t("unidentified", { count: snapshot.unidentifiedSkillCalls })}
+          </p>
+        ) : null}
+      </div>
+    </section>
+  );
+}
