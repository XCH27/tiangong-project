+++ b/packages/ui/test/composerAttachmentPreviews.browser.test.tsx
@@ -0,0 +1,512 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { parseDelimitedTextPreview } from "../src/lib/delimitedTextPreview.js";
+import { Attachment } from "../src/components/ai-elements/attachments.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { useOptionalBaseWorkspaceServices } from "../src/hooks/useWorkspaceServices.js";
+import { useRemoteWorkspaceSessionStore } from "../src/store/remoteWorkspaceSessionStore.js";
+import type { ChatComposerAttachment } from "../src/lib/chatAttachments.js";
+import {
+  COMPOSER_TEXT_PREVIEW_BYTES,
+  readComposerTextPreview,
+  useComposerAttachmentPreviews,
+  readComposerAttachmentPreview,
+  getComposerDocumentKind,
+  COMPOSER_BINARY_PREVIEW_BYTES,
+} from "../src/v4/composer/useComposerAttachmentPreviews.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const results: Array<{ name: string; error?: string }> = [];
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+const attachment = (
+  id: string,
+  extra: Partial<ChatComposerAttachment> = {},
+): ChatComposerAttachment => ({
+  id,
+  filename: "preview.md",
+  mimeType: "text/markdown",
+  sizeBytes: 0,
+  ...extra,
+});
+
+async function run() {
+  await test("dropped File preview is bounded and never reads the remote destination", async () => {
+    const file = new File(["# 中文\n", "x".repeat(100_000)], "preview.md");
+    let requested = false;
+    const value = await readComposerTextPreview(
+      attachment("drop", { file, localPath: "/local/preview.md" }),
+      {
+        async readTextFile() {
+          requested = true;
+          throw new Error("Must not use host path");
+        },
+      },
+    );
+    check(value.content.startsWith("# 中文\n") && value.truncated, "lost UTF-8 text or truncation");
+    check(
+      new TextEncoder().encode(value.content).length <= COMPOSER_TEXT_PREVIEW_BYTES,
+      "read the whole File",
+    );
+    check(
+      !requested && file.size > value.content.length,
+      "preview changed the source or requested the remote file",
+    );
+  });
+  await test("path-only picker preview uses the existing bounded file service", async () => {
+    let requested = false;
+    const value = await readComposerTextPreview(
+      attachment("picker", { localPath: "/local/preview.md" }),
+      {
+        async readTextFile(params) {
+          check(
+            params.path === "/local/preview.md" && params.length === COMPOSER_TEXT_PREVIEW_BYTES,
+            "wrong file/limit",
+          );
+          requested = true;
+          return {
+            path: params.path,
+            content: "# Local",
+            offset: 0,
+            bytesRead: 7,
+            totalBytes: 7,
+            truncated: false,
+            isBinary: false,
+          };
+        },
+      },
+    );
+    check(
+      requested && value.content === "# Local" && !value.truncated,
+      "picker content unavailable",
+    );
+  });
+  await test("empty text is a successful preview rather than a loading state", async () => {
+    const value = await readComposerTextPreview(
+      attachment("empty", { file: new File([], "empty.txt") }),
+    );
+    check(value.content === "" && !value.truncated, "empty file treated as unavailable");
+  });
+  await test("renamed binary data is not rendered as text", async () => {
+    const binary = new File([new Uint8Array([0, 1, 2])], "binary.md");
+    let rejected = false;
+    try {
+      await readComposerTextPreview(attachment("binary", { file: binary }));
+    } catch {
+      rejected = true;
+    }
+    check(rejected, "binary data rendered as text");
+  });
+  await test("binary service response does not become a preview", async () => {
+    let rejected = false;
+    try {
+      await readComposerTextPreview(attachment("binary-path", { localPath: "/local/binary.md" }), {
+        async readTextFile(params) {
+          return {
+            path: params.path,
+            content: "",
+            offset: 0,
+            bytesRead: 3,
+            totalBytes: 3,
+            truncated: false,
+            isBinary: true,
+          };
+        },
+      });
+    } catch {
+      rejected = true;
+    }
+    check(rejected, "binary service result accepted");
+  });
+
+  await test("progress updates reuse reads, and removed/scoped-out attachments reject late results", async () => {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    let previews!: ReturnType<typeof useComposerAttachmentPreviews>;
+    let calls = 0;
+    const pending = Promise.withResolvers<{
+      path: string;
+      content: string;
+      offset: number;
+      bytesRead: number;
+      totalBytes: number;
+      truncated: boolean;
+      isBinary: boolean;
+    }>();
+    const service = {
+      async readTextFile() {
+        calls++;
+        return pending.promise;
+      },
+    };
+    function Reader({ items }: { items: ChatComposerAttachment[] }) {
+      previews = useComposerAttachmentPreviews(items, service);
+      return <div>{previews.size}</div>;
+    }
+    const item = attachment("old", { localPath: "/old.md" });
+    try {
+      await act(async () => {
+        root.render(<Reader items={[item]} />);
+      });
+      await act(async () => {
+        root.render(<Reader items={[{ ...item }]} />);
+      });
+      check(calls === 1, "upload-progress rerender reread the file");
+      await act(async () => {
+        root.render(<Reader items={[]} />);
+      });
+      await act(async () => {
+        pending.resolve({
+          path: "/old.md",
+          content: "old content",
+          offset: 0,
+          bytesRead: 11,
+          totalBytes: 11,
+          truncated: false,
+          isBinary: false,
+        });
+      });
+      check(previews.size === 0, "late result restored a removed attachment");
+      const next = attachment("new", { file: new File(["new content"], "new.md") });
+      await act(async () => {
+        root.render(<Reader items={[next]} />);
+      });
+      // File.text() finishes on a browser I/O task, beyond act's React-only flush.
+      const deadline = performance.now() + 2000;
+      while (!previews.has("new") && performance.now() < deadline) {
+        await act(async () => {
+          await new Promise((resolve) => setTimeout(resolve, 5));
+        });
+      }
+      check(
+        !previews.has("old") &&
+          (previews.get("new")?.kind === "text"
+            ? (previews.get("new") as { content: string }).content
+            : undefined) === "new content",
+        "cross-scope content leak",
+      );
+      await act(async () => {
+        root.render(<Reader items={[attachment("missing", { localPath: "/missing.md" })]} />);
+      });
+      check(!previews.has("new"), "removed contents retained in preview state");
+    } finally {
+      await act(async () => root.unmount());
+      container.remove();
+    }
+  });
+  await test("read failure remains optional and does not reject composer rendering", async () => {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    let previews!: ReturnType<typeof useComposerAttachmentPreviews>;
+    function Reader() {
+      previews = useComposerAttachmentPreviews([attachment("unavailable")]);
+      return <div>{previews.has("unavailable") ? "settled" : "pending"}</div>;
+    }
+    try {
+      await act(async () => root.render(<Reader />));
+      check(
+        previews.has("unavailable") && previews.get("unavailable") === null,
+        "failure did not settle",
+      );
+    } finally {
+      await act(async () => root.unmount());
+      container.remove();
+    }
+  });
+  await test("attachment Enter opens preview while remove-button Enter keeps its own action", async () => {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    let opened = 0;
+    let removed = 0;
+    try {
+      await act(async () =>
+        root.render(
+          <Attachment
+            data={{
+              id: "keys",
+              type: "file",
+              filename: "keys.md",
+              mediaType: "text/markdown",
+              url: "",
+            }}
+            onOpen={() => {
+              opened++;
+            }}
+            openLabel="Preview keys.md"
+          >
+            <button
+              type="button"
+              onClick={(event) => {
+                event.stopPropagation();
+                removed++;
+              }}
+            >
+              Remove
+            </button>
+          </Attachment>,
+        ),
+      );
+      const card = container.querySelector('[role="button"]')!;
+      const remove = container.querySelector("button")!;
+      const enter = new KeyboardEvent("keydown", { key: "Enter", bubbles: true, cancelable: true });
+      await act(async () => {
+        card.dispatchEvent(enter);
+      });
+      check(opened === 1 && enter.defaultPrevented, "card did not open with Enter");
+      const removeEnter = new KeyboardEvent("keydown", {
+        key: "Enter",
+        bubbles: true,
+        cancelable: true,
+      });
+      await act(async () => {
+        remove.dispatchEvent(removeEnter);
+      });
+      check(
+        opened === 1 && !removeEnter.defaultPrevented,
+        "card hijacked the remove button's keyboard action",
+      );
+      await act(async () => {
+        remove.click();
+      });
+      check(removed === 1 && opened === 1, "remove action opened the preview");
+    } finally {
+      await act(async () => root.unmount());
+      container.remove();
+    }
+  });
+  await test("remote conversation previews local picker files through the base Host", async () => {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    const previous = useRemoteWorkspaceSessionStore.getState().baseServices;
+    const item = attachment("local-picker", { localPath: "/this-computer/preview.md" });
+    let localReads = 0;
+    let remoteReads = 0;
+    const base = {
+      fileService: {
+        async readTextFile(params: { path: string }) {
+          localReads++;
+          return {
+            path: params.path,
+            content: "local preview",
+            offset: 0,
+            bytesRead: 13,
+            totalBytes: 13,
+            truncated: false,
+            isBinary: false,
+          };
+        },
+      },
+    };
+    const remote = {
+      fileService: {
+        async readTextFile() {
+          remoteReads++;
+          throw new Error("Remote file owner");
+        },
+      },
+    };
+    function Reader() {
