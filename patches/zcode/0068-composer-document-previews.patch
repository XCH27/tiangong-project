new file mode 100644
index 0000000..9de36d3
--- /dev/null
+++ b/packages/ui/src/v4/composer/ComposerDocumentPreview.tsx
@@ -0,0 +1,213 @@
+import { lazy, Suspense, useMemo } from "react";
+import { MarkdownPreviewContent } from "@/previewPaneMarkdownContent.js";
+import { usePdfViewerLabels, usePptxViewerLabels } from "@/hooks/usePreviewViewerLabels.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { useZCodeStore } from "@/store/StoreProvider.js";
+import { resolveTheme } from "@/useTheme.js";
+import { parseDelimitedTextPreview } from "@/lib/delimitedTextPreview.js";
+import type { ComposerAttachmentPreview } from "./useComposerAttachmentPreviews.js";
+
+const PdfViewer = lazy(() =>
+  import("@/components/ui/pdf-viewer.js").then((m) => ({ default: m.PdfViewer })),
+);
+const OfficeContent = lazy(() =>
+  import("@/previewPaneOfficeContent.js").then((m) => ({ default: m.PreviewPaneOfficeContent })),
+);
+const PptxViewer = lazy(() =>
+  import("@/components/ui/pptx-preview-viewer.js").then((m) => ({ default: m.PptxPreviewViewer })),
+);
+
+function notebookCells(content: string): Array<{ cell_type: string; source: string }> | null {
+  try {
+    const parsed = JSON.parse(content) as {
+      cells?: Array<{ cell_type?: unknown; source?: unknown }>;
+    };
+    if (!Array.isArray(parsed.cells)) return null;
+    return parsed.cells.map((cell) => ({
+      cell_type: typeof cell.cell_type === "string" ? cell.cell_type : "code",
+      source:
+        typeof cell.source === "string"
+          ? cell.source
+          : Array.isArray(cell.source)
+            ? cell.source.filter((s) => typeof s === "string").join("")
+            : "",
+    }));
+  } catch {
+    return null;
+  }
+}
+
+export function ComposerDocumentPreview({
+  preview,
+  filename,
+  thumbnail = false,
+  source = false,
+}: {
+  preview: ComposerAttachmentPreview;
+  filename: string;
+  thumbnail?: boolean;
+  source?: boolean;
+}) {
+  const { intl } = useZCodeIntl();
+  const theme = useZCodeStore((state) => state.theme);
+  const pdfLabels = usePdfViewerLabels();
+  const pptxLabels = usePptxViewerLabels();
+  const table = useMemo(
+    () =>
+      preview.kind === "text" && /\.(csv|tsv)$/iu.test(filename)
+        ? parseDelimitedTextPreview(
+            preview.content,
+            /\.tsv$/iu.test(filename) ? "\t" : ",",
+            thumbnail ? 6 : 200,
+            thumbnail ? 5 : 20,
+          )
+        : null,
+    [filename, preview, thumbnail],
+  );
+  const cells = useMemo(
+    () =>
+      preview.kind === "text" && /\.ipynb$/iu.test(filename)
+        ? notebookCells(preview.content)
+        : null,
+    [filename, preview],
+  );
+  let content;
+  if (preview.kind === "media")
+    content = preview.mediaType.startsWith("video/") ? (
+      <video
+        src={preview.src}
+        controls={!thumbnail}
+        muted={thumbnail}
+        playsInline
+        className="h-full w-full object-contain"
+      />
+    ) : (
+      <img src={preview.src} alt={filename} className="h-full w-full object-contain" />
+    );
+  else if (preview.kind === "pdf")
+    content = (
+      <PdfViewer
+        source={preview.source}
+        labels={pdfLabels}
+        thumbnail={thumbnail}
+        className="h-full w-full"
+      />
+    );
+  else if (preview.kind === "office")
+    content = (
+      <OfficeContent
+        data={preview.buffer}
+        preview={null}
+        kind={preview.officeKind}
+        loading={false}
+        error={null}
+        resolvedTheme={resolveTheme(theme)}
+        sourcePath={filename}
+      />
+    );
+  else if (preview.kind === "pptx")
+    content = (
+      <PptxViewer
+        data={preview.buffer}
+        fileName={filename}
+        labels={pptxLabels}
+        thumbnail={thumbnail}
+        className="h-full"
+      />
+    );
+  else if (!source && /\.(md|markdown)$/iu.test(filename))
+    content = (
+      <div className="mx-auto max-w-3xl">
+        <MarkdownPreviewContent
+          content={thumbnail ? preview.content.slice(0, 2400) : preview.content}
+          theme={theme}
+          allowImageRequests={false}
+        />
+      </div>
+    );
+  else if (!source && table)
+    content = (
+      <div className="h-full overflow-auto p-2">
+        <table className="w-full border-collapse text-ui-sm">
+          <tbody>
+            {table.rows.map((row, index) => (
+              <tr key={index}>
+                {row.map((cell, column) => (
+                  <td
+                    key={column}
+                    className="max-w-72 border border-border px-2 py-1 align-top whitespace-pre-wrap break-words"
+                  >
+                    {cell}
+                  </td>
+                ))}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+        {!thumbnail && table.truncated ? (
+          <p className="mt-3 text-ui-sm text-muted-foreground">
+            {intl.formatMessage({ id: "chat.attachments.preview.tableTruncated" })}
+          </p>
+        ) : null}
+      </div>
+    );
+  else if (!source && cells)
+    content = (
+      <div className="mx-auto max-w-3xl p-4">
+        {(thumbnail ? cells.slice(0, 3) : cells).map((cell, index) => (
+          <section className="mb-4" key={index}>
+            {cell.cell_type === "markdown" ? (
+              <MarkdownPreviewContent
+                content={cell.source}
+                theme={theme}
+                allowImageRequests={false}
+              />
+            ) : (
+              <pre className="overflow-auto rounded-md bg-surface p-3 font-mono text-ui-sm whitespace-pre-wrap break-words">
+                {cell.source}
+              </pre>
+            )}
+          </section>
+        ))}
+      </div>
+    );
+  else
+    content = (
+      <pre className="whitespace-pre-wrap break-words p-4 font-mono text-ui-base text-foreground">
+        {thumbnail ? preview.content.slice(0, 1600) : preview.content}
+      </pre>
+    );
+  const scaled =
+    thumbnail && preview.kind !== "pdf" && preview.kind !== "pptx" && preview.kind !== "media";
+  return (
+    <div className="h-full w-full overflow-hidden" data-composer-document-preview={preview.kind}>
+      {!thumbnail && preview.kind === "text" && preview.truncated ? (
+        <p className="px-4 py-2 text-ui-sm text-muted-foreground">
+          {intl.formatMessage({ id: "chat.attachments.preview.textTruncated" })}
+        </p>
+      ) : null}
+      <Suspense
+        fallback={
+          thumbnail ? null : (
+            <p role="status" className="p-4 text-ui-base text-muted-foreground">
+              {intl.formatMessage({ id: "chat.attachments.preview.textLoading" })}
+            </p>
+          )
+        }
+      >
+        {scaled ? (
+          <div
+            inert
+            aria-hidden="true"
+            className="origin-top-left [&_button]:hidden"
+            style={{ width: 400, height: 290, transform: "scale(0.22)" }}
+          >
+            {content}
+          </div>
+        ) : (
+          content
+        )}
+      </Suspense>
+    </div>
+  );
+}
diff --git a/packages/ui/src/v4/composer/useComposerAttachmentPreviews.ts b/packages/ui/src/v4/composer/useComposerAttachmentPreviews.ts
new file mode 100644
index 0000000..74cd50a
--- /dev/null
+++ b/packages/ui/src/v4/composer/useComposerAttachmentPreviews.ts
@@ -0,0 +1,174 @@
+import { useEffect, useRef, useState } from "react";
+import type { IFileService } from "@zcode/services";
+import { readFileAsDataUrl, type ChatComposerAttachment } from "@/lib/chatAttachments.js";
+import {
+  decodeBase64ToArrayBuffer,
+  getOfficeFilePreviewKind,
+  type OfficeFilePreviewKind,
+} from "@/lib/officeFilePreview.js";
+import type { PdfViewerSource } from "@/components/ui/pdf-viewer.js";
+import { isTextLikeAttachment } from "@/lib/chatAttachmentMetadata.js";
+
+// Preview is ephemeral UI state. It neither changes the attachment sent to the Host
+// nor stores a second copy of its contents in the conversation/draft ledger.
+export const COMPOSER_TEXT_PREVIEW_BYTES = 64 * 1024;
+export interface ComposerTextPreview {
+  content: string;
+  truncated: boolean;
+}
+
+export async function readComposerTextPreview(
+  attachment: ChatComposerAttachment,
+  fileService?: Pick<IFileService, "readTextFile">,
+): Promise<ComposerTextPreview> {
+  if (!isTextLikeAttachment(attachment)) throw new Error("Not a text attachment");
+  // A dropped File belongs to this computer, even when its destination is remote.
+  // Path-only picker attachments use the existing local file service instead.
+  if (attachment.file) {
+    const content = await attachment.file.slice(0, COMPOSER_TEXT_PREVIEW_BYTES).text();
+    if (content.includes("\0")) throw new Error("Binary attachment");
+    return { content, truncated: attachment.file.size > COMPOSER_TEXT_PREVIEW_BYTES };
+  }
+  if (!attachment.localPath || !fileService) throw new Error("Attachment content unavailable");
+  const result = await fileService.readTextFile({
+    path: attachment.localPath,
+    length: COMPOSER_TEXT_PREVIEW_BYTES,
+  });
+  if (result.isBinary) throw new Error("Binary attachment");
+  return { content: result.content, truncated: result.truncated };
+}
+
+export type ComposerDocumentKind = "text" | "pdf" | "office" | "pptx" | "media";
+export type ComposerAttachmentPreview =
+  | (ComposerTextPreview & { kind: "text" })
+  | { kind: "pdf"; source: PdfViewerSource }
+  | { kind: "office"; buffer: ArrayBuffer; officeKind: OfficeFilePreviewKind }
+  | { kind: "pptx"; buffer: ArrayBuffer }
+  | { kind: "media"; src: string; mediaType: string };
+export const COMPOSER_BINARY_PREVIEW_BYTES = 25 * 1024 * 1024;
+
+export function getComposerDocumentKind(
+  attachment: Pick<ChatComposerAttachment, "filename" | "mimeType">,
+): ComposerDocumentKind | null {
+  if (attachment.mimeType.startsWith("image/") || attachment.mimeType.startsWith("video/"))
+    return "media";
+  if (attachment.mimeType.startsWith("audio/")) return null;
+  if (/\.pdf$/iu.test(attachment.filename) || attachment.mimeType === "application/pdf")
+    return "pdf";
+  if (/\.pptx$/iu.test(attachment.filename)) return "pptx";
+  if (getOfficeFilePreviewKind(attachment.filename)) return "office";
+  return isTextLikeAttachment(attachment) ? "text" : null;
+}
+
+export async function readComposerAttachmentPreview(
+  attachment: ChatComposerAttachment,
+  fileService?: Pick<IFileService, "readTextFile" | "readBinaryPreview"> &
+    Partial<Pick<IFileService, "stat" | "readFileRange">>,
+): Promise<ComposerAttachmentPreview> {
+  const kind = getComposerDocumentKind(attachment);
+  if (kind === "text") return { kind, ...(await readComposerTextPreview(attachment, fileService)) };
+  if (!kind) throw new Error("Unsupported document preview");
+  if (kind === "media") {
+    if (attachment.objectUrl)
+      return { kind, src: attachment.objectUrl, mediaType: attachment.mimeType };
+    if (attachment.file) {
+      if (attachment.file.size > COMPOSER_BINARY_PREVIEW_BYTES)
+        throw new Error("Preview too large");
+      return {
+        kind,
+        src: await readFileAsDataUrl(attachment.file),
+        mediaType: attachment.mimeType,
+      };
+    }
+    if (!attachment.localPath || !fileService) throw new Error("Attachment content unavailable");
+    // Unsent picker files are not Session-owned media grants. Reuse the existing
+    // file reader, never manufacture or loosen a media-protocol authorization.
+    const binary = await fileService.readBinaryPreview({
+      path: attachment.localPath,
+      maxBytes: COMPOSER_BINARY_PREVIEW_BYTES,
+    });
+    return {
+      kind,
+      src: `data:${attachment.mimeType};base64,${binary.dataBase64}`,
+      mediaType: attachment.mimeType,
+    };
+  }
+  // Browser PDFs can be paged from their existing Blob without another whole-file copy.
+  if (kind === "pdf" && attachment.objectUrl) return { kind, source: attachment.objectUrl };
+  if (kind === "pdf" && attachment.file) return { kind, source: attachment.file };
+  if (kind === "pdf" && attachment.localPath && fileService?.stat && fileService.readFileRange) {
+    const path = attachment.localPath;
+    const info = await fileService.stat({ path });
+    if (typeof info.size === "number") {
+      // Use the same range transport as PreviewPane. The media protocol is for
+      // Chromium image/video elements and is not a PDF.js fetch URL.
+      return {
+        kind,
+        source: {
+          totalBytes: info.size,
+          requestRange: (offset, length) => fileService.readFileRange!({ path, offset, length }),
+        },
+      };
+    }
+  }
+  let buffer: ArrayBuffer;
+  if (attachment.file) {
+    if (attachment.file.size > COMPOSER_BINARY_PREVIEW_BYTES) throw new Error("Preview too large");
+    buffer = await attachment.file.arrayBuffer();
+  } else {
+    if (!attachment.localPath || !fileService) throw new Error("Attachment content unavailable");
+    const binary = await fileService.readBinaryPreview({
+      path: attachment.localPath,
+      maxBytes: COMPOSER_BINARY_PREVIEW_BYTES,
+    });
+    buffer = decodeBase64ToArrayBuffer(binary.dataBase64);
+  }
+  if (kind === "pdf") return { kind, source: buffer };
+  if (kind === "pptx") return { kind, buffer };
+  return { kind, buffer, officeKind: getOfficeFilePreviewKind(attachment.filename)! };
+}
+
+export function useComposerAttachmentPreviews(
+  attachments: readonly ChatComposerAttachment[],
+  fileService?: Pick<IFileService, "readTextFile" | "readBinaryPreview"> &
+    Partial<Pick<IFileService, "stat" | "readFileRange">>,
+) {
+  const reads = useRef(new Map<string, Promise<ComposerAttachmentPreview | null>>());
+  const [previews, setPreviews] = useState<ReadonlyMap<string, ComposerAttachmentPreview | null>>(
+    () => new Map(),
+  );
+  useEffect(() => {
+    let current = true;
+    const documentAttachments = attachments.filter(
+      (attachment) => getComposerDocumentKind(attachment) !== null,
+    );
+    const ids = new Set(documentAttachments.map((attachment) => attachment.id));
+    for (const id of reads.current.keys()) if (!ids.has(id)) reads.current.delete(id);
+    setPreviews((previous) =>
+      [...previous.keys()].every((id) => ids.has(id))
+        ? previous
+        : new Map([...previous].filter(([id]) => ids.has(id))),
+    );
+    for (const attachment of documentAttachments) {
+      let read = reads.current.get(attachment.id);
+      if (!read) {
+        read = readComposerAttachmentPreview(attachment, fileService).catch(() => null);
+        reads.current.set(attachment.id, read);
+      }
+      void read.then((preview) => {
+        if (!current) return;
+        setPreviews((previous) =>
+          previous.has(attachment.id) && previous.get(attachment.id) === preview
+            ? previous
+            : new Map(previous).set(attachment.id, preview),
+        );
+      });
+    }
+    // Upload-progress rerenders reuse the bounded read. Removed/scoped-out cards
+    // cannot be brought back by a late file-service reply.
+    return () => {
+      current = false;
+    };
+  }, [attachments, fileService]);
+  return previews;
+}
diff --git a/packages/ui/test/composerAttachmentPreviews.browser.test.tsx b/packages/ui/test/composerAttachmentPreviews.browser.test.tsx
