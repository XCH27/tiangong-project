diff --git a/packages/ui/src/settings/model-provider-section/SubscriptionListPrice.tsx b/packages/ui/src/settings/model-provider-section/SubscriptionListPrice.tsx
new file mode 100644
index 0000000..34f986f
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/SubscriptionListPrice.tsx
@@ -0,0 +1,96 @@
+import { useState } from "react";
+import { Button } from "@/components/ui/button.js";
+import { Input } from "@/components/ui/input.js";
+import { useSettings } from "@/hooks/useSettingService.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import {
+  normalizeSubscriptionPlanKey,
+  officialSubscriptionPrices,
+} from "@/settings/usage-stats/officialSubscriptionPrices.js";
+import { accountMonthlyPrice } from "./subscriptionListPriceModel.js";
+
+/** List-price metadata belongs to the account; local API estimates belong to Usage. */
+export function SubscriptionListPrice({
+  providerId, accountId, kind, plan,
+}: {
+  providerId: string;
+  accountId: string;
+  kind: "openai-codex" | "github-copilot" | "xai";
+  plan?: string;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.listPrice.${key}` });
+  const { settings, update } = useSettings();
+  const platform = usePlatform();
+  const key = JSON.stringify([providerId, accountId]);
+  const planKey = normalizeSubscriptionPlanKey(plan);
+  const official = officialSubscriptionPrices(kind, plan);
+  const { correction, exact, perSeat } = accountMonthlyPrice(
+    official, settings?.subscriptionPriceOverrides?.[key], planKey,
+  );
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+  const money = (amount: number) => new Intl.NumberFormat(locale, {
+    style: "currency", currency: "USD", maximumFractionDigits: 2,
+  }).format(amount);
+  const amount = exact !== undefined ? money(exact)
+    : official.length > 1 ? t("multiple") : t("unknown");
+  const save = async () => {
+    const value = Number(draft);
+    if (!draft.trim() || !Number.isFinite(value) || value < 0 || value > 10_000_000) {
+      setError(t("invalid"));
+      return;
+    }
+    setBusy(true);
+    try {
+      await update({ subscriptionPriceOverrides: { [key]: {
+        providerId, accountId, planKey, amountUsd: value,
+      } } });
+      setEditing(false);
+      setError(undefined);
+    } catch {
+      setError(t("saveFailed"));
+    } finally {
+      setBusy(false);
+    }
+  };
+  const reset = async () => {
+    setBusy(true);
+    try {
+      await update({ subscriptionPriceOverrides: { [key]: null } });
+      setEditing(false);
+      setError(undefined);
+    } catch {
+      setError(t("saveFailed"));
+    } finally {
+      setBusy(false);
+    }
+  };
+  if (!planKey) return null;
+  return (
+    <div className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-border pt-3 text-ui-sm" data-testid="subscription-list-price">
+      <span className="text-foreground-subtle">{t("label")}</span>
+      <span className="font-mono tabular-nums">{amount}{exact !== undefined ? ` ${perSeat ? t("perSeat") : t("perMonth")}` : ""}</span>
+      {correction ? <span className="text-foreground-subtle">{t("corrected")}</span> : null}
+      <Button variant="link" className="h-auto p-0 text-ui-sm" onClick={() => {
+        setDraft(String(exact ?? "")); setEditing(true); setError(undefined);
+      }}>{t("correct")}</Button>
+      {official[0]?.sourceUrl ? (
+        <Button variant="link" className="h-auto p-0 text-ui-sm" onClick={() => void platform.openExternal(official[0]!.sourceUrl)}>{t("source")}</Button>
+      ) : null}
+      {editing ? (
+        <div className="flex w-full flex-wrap items-center gap-2 pt-2">
+          <label htmlFor={`subscription-price-${accountId}`}>{t(perSeat ? "seatMonthlyUsd" : "monthlyUsd")}</label>
+          <Input id={`subscription-price-${accountId}`} className="w-28" type="number" min="0" step="0.01" value={draft} onChange={(event) => setDraft(event.target.value)} />
+          <Button size="sm" disabled={busy} onClick={() => void save()}>{t("save")}</Button>
+          {correction ? <Button variant="ghost" size="sm" disabled={busy} onClick={() => void reset()}>{t("reset")}</Button> : null}
+          <Button variant="ghost" size="sm" disabled={busy} onClick={() => setEditing(false)}>{t("cancel")}</Button>
+          {error ? <span role="alert" className="text-destructive">{error}</span> : null}
+        </div>
+      ) : null}
+    </div>
+  );
+}
diff --git a/packages/ui/src/settings/model-provider-section/subscriptionListPriceModel.ts b/packages/ui/src/settings/model-provider-section/subscriptionListPriceModel.ts
new file mode 100644
index 0000000..2dcbdcf
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/subscriptionListPriceModel.ts
@@ -0,0 +1,19 @@
+import type { SubscriptionPriceOverride } from "@zcode/shared";
+import type { OfficialSubscriptionPrice } from "@/settings/usage-stats/officialSubscriptionPrices.js";
+
+export function accountMonthlyPrice(
+  prices: readonly OfficialSubscriptionPrice[],
+  override: SubscriptionPriceOverride | null | undefined,
+  planKey: string | null,
+) {
+  const correction = override?.planKey === planKey ? override : undefined;
+  const exactOfficial = prices.length === 1 && !prices[0]!.perSeat ? prices[0] : undefined;
+  const amounts = prices.map((item) => item.amount);
+  return {
+    correction,
+    exact: correction?.amountUsd ?? exactOfficial?.amount,
+    low: amounts.length ? Math.min(...amounts) : null,
+    high: amounts.length ? Math.max(...amounts) : null,
+    perSeat: prices.length > 0 && prices.every((item) => item.perSeat),
+  };
+}
