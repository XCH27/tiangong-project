+import assert from "node:assert/strict";
+import test from "node:test";
+import { officialSubscriptionPrices } from "../src/settings/usage-stats/officialSubscriptionPrices.js";
+import { accountMonthlyPrice } from "../src/settings/model-provider-section/subscriptionListPriceModel.js";
+
+test("a manual correction is account-and-plan scoped and ambiguous Team prices stay unresolved", () => {
+  const plus = officialSubscriptionPrices("openai-codex", "Plus");
+  const team = officialSubscriptionPrices("openai-codex", "Team");
+  assert.equal(accountMonthlyPrice(plus, undefined, "plus").exact, 20);
+  assert.deepEqual(
+    [accountMonthlyPrice(team, undefined, "team").low, accountMonthlyPrice(team, undefined, "team").high],
+    [20, 125],
+  );
+  assert.equal(accountMonthlyPrice(team, undefined, "team").exact, undefined);
+  assert.equal(accountMonthlyPrice(team, undefined, "team").perSeat, true);
+  const correction = { providerId: "chat", accountId: "a", planKey: "team", amountUsd: 35 };
+  assert.equal(accountMonthlyPrice(team, correction, "team").exact, 35);
+  assert.equal(accountMonthlyPrice(plus, correction, "plus").exact, 20);
+  assert.deepEqual(officialSubscriptionPrices("xai", "SuperGrok Heavy"), []);
+});
