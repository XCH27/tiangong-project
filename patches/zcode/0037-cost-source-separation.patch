+export interface OfficialSubscriptionPrice {
+  id: string;
+  label: string;
+  amount: number;
+  currency: "USD";
+  sourceUrl: string;
+  annualEquivalent?: boolean;
+  /** Team prices are per seat, not an account's actual payment. */
+  perSeat?: boolean;
+}
+
+const CHATGPT_BUSINESS = "https://help.openai.com/en/articles/8542115-chatgpt-business-general-faq";
+const CHATGPT_RELEASES = "https://help.openai.com/en/articles/6825453-chatgpt-release-notes";
+const COPILOT_PRICING = "https://docs.github.com/en/copilot/get-started/plans";
+const GROK_PRICING = "https://x.ai/pricing";
+
+export function normalizeSubscriptionPlanKey(plan: string | undefined): string | null {
+  return plan?.trim().toLowerCase().replace(/[\s_-]/g, "").replace(/\+/g, "plus") || null;
+}
+
+/** A checked public list price is a suggestion, never a paid invoice or a quota multiplier. */
+export function officialSubscriptionPrices(
+  kind: "openai-codex" | "github-copilot" | "xai",
+  reportedPlan: string | undefined,
+): OfficialSubscriptionPrice[] {
+  const plan = normalizeSubscriptionPlanKey(reportedPlan);
+  if (!plan) return [];
+  const price = (
+    id: string, label: string, amount: number, sourceUrl: string,
+    options: { perSeat?: boolean; annualEquivalent?: boolean } = {},
+  ) => ({ id, label, amount, currency: "USD" as const, sourceUrl, ...options });
+  if (kind === "openai-codex") {
+    if (["plus", "chatgptplusplan"].includes(plan))
+      return [price("chatgpt-plus", "Plus", 20, CHATGPT_RELEASES)];
+    if (["pro", "chatgptproplan"].includes(plan))
+      return [
+        price("chatgpt-pro-100", "Pro 100", 100, CHATGPT_RELEASES),
+        price("chatgpt-pro-200", "Pro 200", 200, CHATGPT_RELEASES),
+      ];
+    if (["team", "business", "chatgptteamplan"].includes(plan))
+      return [
+        price("chatgpt-business-standard-monthly", "Standard", 25, CHATGPT_BUSINESS, { perSeat: true }),
+        price("chatgpt-business-premium-monthly", "Premium", 125, CHATGPT_BUSINESS, { perSeat: true }),
+        price("chatgpt-business-standard-annual", "Standard", 20, CHATGPT_BUSINESS, { perSeat: true, annualEquivalent: true }),
+        price("chatgpt-business-premium-annual", "Premium", 100, CHATGPT_BUSINESS, { perSeat: true, annualEquivalent: true }),
+      ];
+    return [];
+  }
+  if (kind === "github-copilot") {
+    if (plan === "pro") return [price("copilot-pro", "Pro", 10, COPILOT_PRICING)];
+    if (plan === "proplus") return [price("copilot-pro-plus", "Pro+", 39, COPILOT_PRICING)];
+    if (plan === "max") return [price("copilot-max", "Max", 100, COPILOT_PRICING)];
+    if (plan === "business") return [price("copilot-business", "Business", 19, COPILOT_PRICING, { perSeat: true })];
+    if (plan === "enterprise") return [price("copilot-enterprise", "Enterprise", 39, COPILOT_PRICING, { perSeat: true })];
+    return [];
+  }
+  if (kind === "xai") {
+    if (plan === "supergrok") return [price("supergrok", "SuperGrok", 30, GROK_PRICING)];
+    if (plan === "supergrokplus") return [price("supergrok-plus", "SuperGrok Plus", 100, GROK_PRICING)];
+    return [];
+  }
+  return [];
+}
