diff --git a/packages/services/test/subscription-payment-settings.test.ts b/packages/services/test/subscription-payment-settings.test.ts
index b67d0e2..150e7ca 100644
--- a/packages/services/test/subscription-payment-settings.test.ts
+++ b/packages/services/test/subscription-payment-settings.test.ts
@@ -18,3 +18,22 @@ test("payment records persist/reopen and concurrent per-key updates cannot erase
   assert.deepEqual((await createSettingService().get()).subscriptionPayments,{one:null,two});
  }finally{if(previous===undefined)delete process.env.ZCODE_DESKTOP_HOME_DIR;else process.env.ZCODE_DESKTOP_HOME_DIR=previous;await rm(dir,{recursive:true,force:true});}
 });
+
+test("monthly price corrections persist per account without altering historical payments", async () => {
+ const dir=await mkdtemp(join(tmpdir(),"fleet-price-correction-"));const previous=process.env.ZCODE_DESKTOP_HOME_DIR;process.env.ZCODE_DESKTOP_HOME_DIR=dir;
+ try{
+  const service=createSettingService();
+  const a={providerId:"chat",accountId:"a",planKey:"team",amountUsd:25};
+  const b={providerId:"chat",accountId:"b",planKey:"team",amountUsd:40};
+  const keyA=JSON.stringify([a.providerId,a.accountId]);
+  const keyB=JSON.stringify([b.providerId,b.accountId]);
+  await Promise.all([
+   service.update({subscriptionPriceOverrides:{[keyA]:a}}),
+   service.update({subscriptionPriceOverrides:{[keyB]:b}}),
+  ]);
+  assert.deepEqual((await createSettingService().get()).subscriptionPriceOverrides,{[keyA]:a,[keyB]:b});
+  await assert.rejects(service.update({subscriptionPriceOverrides:{wrong:a}}),/identity mismatch/);
+  await service.update({subscriptionPriceOverrides:{[keyA]:null}});
+  assert.deepEqual((await createSettingService().get()).subscriptionPriceOverrides,{[keyA]:null,[keyB]:b});
+ }finally{if(previous===undefined)delete process.env.ZCODE_DESKTOP_HOME_DIR;else process.env.ZCODE_DESKTOP_HOME_DIR=previous;await rm(dir,{recursive:true,force:true});}
+});
