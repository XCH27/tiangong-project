diff --git a/packages/services/test/native-cli-login.test.ts b/packages/services/test/native-cli-login.test.ts
index ac9ab18..fd75df0 100644
--- a/packages/services/test/native-cli-login.test.ts
+++ b/packages/services/test/native-cli-login.test.ts
@@ -424,3 +424,71 @@ test(
     }
   },
 );
+
+for (const kind of ["codex", "claude"] as const) {
+  test(`manual ${kind} model is selectable without fabricated API maps/capabilities after refresh and reopen`, async () => {
+    const directory = await mkdtemp(join(tmpdir(), "fleet-native-manual-"));
+    const open = () =>
+      new ProviderRuntime({
+        configRuntime: createProviderConfigRuntime({
+          personalFilePath: join(directory, "provider.json"),
+          zcodeBuiltinFilePath: fileURLToPath(
+            new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+          ),
+          watch: false,
+          personalPollingIntervalMs: false,
+        }),
+        nativeCli: {
+          inspect: async () => ({
+            accountId: "same-account",
+            accountName: "Fixture",
+            planType: "pro",
+            catalog: { source: "provider", models: [] },
+          }),
+          login: async () => {
+            throw new Error("No new login in this fixture");
+          },
+        },
+      });
+    let runtime = open();
+    try {
+      await runtime.start();
+      const { providerId } = await runtime.providerSettings.createPersonalProvider({
+        templateId: kind === "codex" ? "fleet-chatgpt-native" : "fleet-claude-native",
+      });
+      await runtime.providerSettings.connectNativeCli(providerId);
+      await runtime.providerSettings.addPersonalModel(providerId, "future-native-model", {}, true);
+      const verify = async () => {
+        const model = (await runtime.providerSettings.getView()).providers.find(
+          (p) => p.providerId === providerId,
+        )!.models[0]!;
+        assert.equal(model.modelId, "future-native-model");
+        assert.equal(model.selectable, true);
+        assert.deepEqual(model.issues, []);
+        assert.deepEqual(model.effectiveConfig.optionSpecs?.reasoningLevel?.values, ["auto"]);
+        assert.equal(model.effectiveConfig.optionSpecs?.reasoningLevel?.defaultValue, "auto");
+        assert.equal(model.evidenceConfig.properties?.contextWindow, undefined);
+        assert.equal(model.evidenceConfig.properties?.inputFormat?.supportsImage, undefined);
+        assert.equal(model.effectiveConfig.optionSpecs?.speedMode, null);
+        const preview = await runtime.providerSettings.resolveModelConfig({
+          providerId,
+          originalModelId: model.modelId,
+          modelId: model.modelId,
+          personalConfig: {},
+        });
+        assert.deepEqual(preview.issues, []);
+        assert.equal(preview.effectiveConfig.optionSpecs?.maxOutputTokens?.map, "{}");
+      };
+      await verify();
+      await runtime.providerSettings.discoverModels(providerId);
+      await verify();
+      runtime.dispose();
+      runtime = open();
+      await runtime.start();
+      await verify();
+    } finally {
+      runtime.dispose();
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+}
