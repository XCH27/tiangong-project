+/** Native executors own their wire options; an undiscovered ID has no API parameter map. */
+export function resolveNativeModelRouteOptions(
+  config: ModelConfig,
+  evidence: ModelConfig,
+): ModelConfig {
+  return config.overlay(
+    ModelConfig.fromData({
+      optionSpecs: {
+        ...(config.optionSpecs?.maxOutputTokens?.map === undefined
+          ? { maxOutputTokens: { map: "{}" } }
+          : {}),
+        ...(!evidence.optionSpecs?.reasoningLevel?.values?.length
+          ? { reasoningLevel: { values: ["auto"], defaultValue: "auto", map: "{}" } }
+          : {}),
+        ...(evidence.optionSpecs?.speedMode === undefined ? { speedMode: null } : {}),
+      },
+    }),
+  );
+}
