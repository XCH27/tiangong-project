@@ -0,0 +1,62 @@
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { RegularTurnLoopState } from "./turn-loop-state.js";
+import { prepareRegularModelStep } from "./turn-step-prepare.js";
+import { runModelBackedTurnStep, type ExternalModelTools } from "./turn-model-step.js";
+import { executeToolCallsForModelStep } from "./turn-tools.js";
+import { modelContentForToolResult, throwIfTurnAborted } from "../helpers/index.js";
+
+/** Observe native continuation through the original Host writers; never run an outer inference loop. */
+export async function runNativeAgentTurn(
+  runtime: AgentRuntimeInternal,
+  state: RegularTurnLoopState,
+): Promise<void> {
+  const port = runtime.nativeAgentPort;
+  if (!port) throw new Error("This host has no native Agent executor");
+  let prepared = await prepareRegularModelStep(runtime, state, true);
+  const native = port.createTurn({
+    model: state.model,
+    messages: prepared.messages,
+    tools: prepared.tools,
+    sessionId: runtime.sessionId,
+    turnId: state.turnId,
+    workingDirectory: runtime.workingDirectory,
+    signal: state.turnAbortSignal,
+  });
+  try {
+    for (;;) {
+      throwIfTurnAborted(state.turnAbortSignal);
+      let batch: ExternalModelTools | undefined;
+      const outcome = await runModelBackedTurnStep.call(runtime, state, {
+        ...prepared,
+        requestModelText: async (options) => {
+          // runModelBackedTurnStep commits its request before reaching this observation handle.
+          native.admitNextStep();
+          return runtime.runModelTextRequest({ ...options, model: native.model });
+        },
+        externalToolExecution: (value) => {
+          batch = value;
+        },
+      });
+      if (batch) {
+        const step: ExternalModelTools = batch;
+        const toolsOutcome = await executeToolCallsForModelStep.call(runtime, state, {
+          ...step,
+          onResults: (results) =>
+            native.retainToolReceipts(
+              results.map((result) => ({
+                toolCallId: result.toolCallId,
+                toolName: result.toolName,
+                input: step.toolCalls.find((call) => call.id === result.toolCallId)?.input,
+                content: modelContentForToolResult(result),
+                isError: !result.success,
+              })),
+            ),
+        });
+        if (toolsOutcome === "break") return;
+      } else if (outcome === "break") return;
+      prepared = await prepareRegularModelStep(runtime, state, true);
+    }
+  } finally {
+    await native.close();
+  }
+}
