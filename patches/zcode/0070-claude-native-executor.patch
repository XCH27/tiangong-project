diff --git a/packages/ui/src/settings/model-provider-section/NativeCliConnectionSection.tsx b/packages/ui/src/settings/model-provider-section/NativeCliConnectionSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..24154bdf459cbbc30b5a354ecd686d3a2eaf76d2
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/NativeCliConnectionSection.tsx
@@ -0,0 +1,182 @@
+import { useEffect, useCallback, useRef, useState } from "react";
+import type { NativeCliAccessConfigObject } from "@zcode/provider";
+import { ExternalLinkIcon, LoaderCircleIcon } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Badge } from "@/components/ui/badge.js";
+import { useServices } from "@/hooks/useServices.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { PlanStatusCardSurface } from "./PlanStatusCardSurface.js";
+import { useProviderDetailFeedback } from "./ProviderDetailFeedback.js";
+
+/** Official CLI keeps login/refresh; this card binds its public identity through the existing writer. */
+export function NativeCliConnectionSection({
+  providerId,
+  access,
+  onConnectionChanged,
+  connectOnMount,
+  onConnectConsumed,
+}: {
+  providerId: string;
+  access: NativeCliAccessConfigObject;
+  onConnectionChanged?: (providerId: string) => void;
+  connectOnMount?: boolean;
+  onConnectConsumed?: () => void;
+}) {
+  const { providerSettingsService } = useServices();
+  const platform = usePlatform();
+  const { intl } = useZCodeIntl();
+  const { showFeedback } = useProviderDetailFeedback();
+  const t = (field: string) =>
+    intl.formatMessage({ id: `settings.modelProvider.nativeCli.${field}` });
+  const [busy, setBusy] = useState(false);
+  const [signingIn, setSigningIn] = useState(false);
+  const pending = useRef(false);
+  const loginFlow = useRef<string | undefined>(undefined);
+  const pollTimer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  const generation = useRef(0);
+  const currentId = useRef(providerId);
+  currentId.current = providerId;
+  useEffect(() => {
+    pending.current = false;
+    setBusy(false);
+    setSigningIn(false);
+    return () => {
+      generation.current++;
+      pending.current = false;
+      clearTimeout(pollTimer.current);
+      const flow = loginFlow.current;
+      loginFlow.current = undefined;
+      if (flow) void providerSettingsService.cancelNativeCliLogin(providerId, flow).catch(() => {});
+    };
+  }, [providerId, providerSettingsService]);
+  const report = (error: unknown) => {
+    const raw = error instanceof Error ? error.message : String(error);
+    const key = /ENOENT|not found|spawn.*failed/i.test(raw)
+      ? "missing"
+      : /account changed/i.test(raw)
+        ? "changed"
+        : /sign in/i.test(raw)
+          ? "login"
+          : "failed";
+    showFeedback({
+      key: `native:${providerId}`,
+      state: "failure",
+      message: t(key),
+      dismissLabel: intl.formatMessage({ id: "common.close" }),
+    });
+  };
+  const cancel = async () => {
+    generation.current++;
+    clearTimeout(pollTimer.current);
+    const flow = loginFlow.current;
+    loginFlow.current = undefined;
+    pending.current = false;
+    setBusy(false);
+    setSigningIn(false);
+    if (flow) await providerSettingsService.cancelNativeCliLogin(providerId, flow).catch(report);
+  };
+  const connect = useCallback(async () => {
+    if (pending.current) return;
+    pending.current = true;
+    setBusy(true);
+    const version = ++generation.current;
+    const isCurrent = () => version === generation.current && currentId.current === providerId;
+    const finish = () => {
+      if (!isCurrent()) return;
+      loginFlow.current = undefined;
+      pending.current = false;
+      setBusy(false);
+      setSigningIn(false);
+    };
+    try {
+      await providerSettingsService.connectNativeCli(providerId);
+      if (isCurrent()) onConnectionChanged?.(providerId);
+      finish();
+    } catch (error) {
+      if (!isCurrent()) return;
+      const raw = error instanceof Error ? error.message : String(error);
+      if (!/Sign in to the official Claude CLI/i.test(raw)) {
+        report(error);
+        finish();
+        return;
+      }
+      try {
+        const flow = await providerSettingsService.beginNativeCliLogin(providerId);
+        if (!isCurrent()) {
+          await providerSettingsService.cancelNativeCliLogin(providerId, flow.flowId);
+          return;
+        }
+        loginFlow.current = flow.flowId;
+        setSigningIn(true);
+        const poll = async () => {
+          if (!isCurrent()) return;
+          try {
+            const result = await providerSettingsService.pollNativeCliLogin(
+              providerId,
+              flow.flowId,
+            );
+            if (!isCurrent()) return;
+            if (result.status === "pending")
+              pollTimer.current = setTimeout(() => void poll(), 1000);
+            else {
+              onConnectionChanged?.(providerId);
+              finish();
+            }
+          } catch (failure) {
+            if (isCurrent()) {
+              report(failure);
+              finish();
+            }
+          }
+        };
+        void poll();
+      } catch (failure) {
+        if (isCurrent()) {
+          report(failure);
+          finish();
+        }
+      }
+    }
+  }, [providerId, providerSettingsService, onConnectionChanged, intl, showFeedback]);
+  useEffect(() => {
+    if (!connectOnMount) return;
+    onConnectConsumed?.();
+    void connect();
+  }, [connectOnMount, onConnectConsumed, connect]);
+  return (
+    <PlanStatusCardSurface
+      compact
+      planTitle={access.accountId ?? t("title")}
+      titleAccessory={<Badge variant="outline">CLI</Badge>}
+      statusMeta={
+        <p className="text-ui-base text-foreground-subtle">
+          {t(signingIn ? "waiting" : access.connected ? "connected" : "flow")}
+        </p>
+      }
+      trailingAction={
+        signingIn ? (
+          <Button type="button" variant="outline" onClick={() => void cancel()}>
+            {intl.formatMessage({ id: "common.cancel" })}
+          </Button>
+        ) : (
+          <Button type="button" disabled={busy} onClick={() => void connect()}>
+            {busy ? <LoaderCircleIcon className="size-4 animate-spin" /> : null}
+            {t(access.connected ? "reconnect" : "connect")}
+          </Button>
+        )
+      }
+      usageContent={
+        <Button
+          type="button"
