+import type { Model } from "../model/model.js";
+import type { ModelToolContract, ModelInputMessage, ModelMessageContent } from "../model/index.js";
+
+/** A vendor owns continuation; the Host owns admission, effects, canonical history and usage. */
+export interface NativeAgentTurnRequest {
+  model: Model;
+  messages: ModelInputMessage[];
+  tools: ModelToolContract[];
+  sessionId: string;
+  turnId: string;
+  workingDirectory: string;
+  signal: AbortSignal;
+}
+export interface NativeAgentToolReceipt {
+  toolCallId: string;
+  toolName: string;
+  input: unknown;
+  content: ModelMessageContent;
+  isError: boolean;
+}
+export interface NativeAgentTurn {
+  /** Observation-only model handle. It never starts a second model/tool loop. */
+  model: Model;
+  /** Publish Host receipts only after the next Host request boundary is durably admitted. */
+  admitNextStep(): void;
+  retainToolReceipts(receipts: readonly NativeAgentToolReceipt[]): void;
+  close(): Promise<void>;
+}
+export interface NativeAgentPort {
+  createTurn(request: NativeAgentTurnRequest): NativeAgentTurn;
+}
