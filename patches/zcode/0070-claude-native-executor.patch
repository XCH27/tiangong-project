diff --git a/packages/ui/test/nativeCliConnection.browser.test.tsx b/packages/ui/test/nativeCliConnection.browser.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1d182a8535ff596f03d9aa523b89d9b241ae1762
--- /dev/null
+++ b/packages/ui/test/nativeCliConnection.browser.test.tsx
@@ -0,0 +1,160 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { NativeCliConnectionSection } from "../src/settings/model-provider-section/NativeCliConnectionSection.js";
+import { ProviderDetailFeedbackBoundary } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+async function fixture() {
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  const cancellations: Array<[string, string]> = [];
+  const connections: string[] = [];
+  let changed = 0;
+  let connect = async (_id: string): Promise<any> => {
+    throw new Error("Sign in to the official Claude CLI with your Claude account first");
+  };
+  let begin = async (_id: string) => ({ flowId: "flow-A" });
+  const service = {
+    connectNativeCli: (id: string) => {
+      connections.push(id);
+      return connect(id);
+    },
+    beginNativeCliLogin: (id: string) => begin(id),
+    pollNativeCliLogin: async () => ({ status: "pending" }),
+    cancelNativeCliLogin: async (id: string, flow: string) => {
+      cancellations.push([id, flow]);
+    },
+  };
+  return {
+    node,
+    connections,
+    cancellations,
+    changed: () => changed,
+    setConnect(value: typeof connect) {
+      connect = value;
+    },
+    setBegin(value: typeof begin) {
+      begin = value;
+    },
+    async render(id = "A", locale: "en-US" | "zh-CN" = "zh-CN") {
+      await act(async () =>
+        root.render(
+          <ServiceProvider services={{ providerSettingsService: service } as never}>
+            <PlatformProvider platform={{ openExternal: async () => {} } as never}>
+              <ZCodeIntlProvider initialLocale={locale}>
+                <ProviderDetailFeedbackBoundary>
+                  <NativeCliConnectionSection
+                    providerId={id}
+                    access={{ type: "native-cli", provider: "claude", connected: false }}
+                    onConnectionChanged={() => {
+                      changed++;
+                    }}
+                  />
+                </ProviderDetailFeedbackBoundary>
+              </ZCodeIntlProvider>
+            </PlatformProvider>
+          </ServiceProvider>,
+        ),
+      );
+    },
+    async click(text: string) {
+      const button = [...node.querySelectorAll("button")].find(
+        (element) => element.textContent === text,
+      );
+      check(button, `Missing action ${text}`);
+      await act(async () => button.click());
+    },
+    async close() {
+      await act(async () => root.unmount());
+      node.remove();
+    },
+  };
+}
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+
+async function run() {
+  await test("sign-in has one browser-wait state and cancellation is scoped to its CLI flow", async () => {
+    const f = await fixture();
+    try {
+      await f.render();
+      await f.click("连接当前账号");
+      check(
+        f.node.textContent?.includes("请在浏览器中完成登录"),
+        "No actionable browser sign-in state",
+      );
+      check(!f.node.querySelector("input"), "Native sign-in invented an API-key form");
+      await f.click("取消");
+      check(f.cancellations[0]?.join(":") === "A:flow-A", "Cancelled the wrong native flow");
+      check(f.changed() === 0, "Cancelled login reported a connection");
+    } finally {
+      await f.close();
+    }
+  });
+  await test("a pending connection does not disable or overwrite the next provider", async () => {
+    const f = await fixture();
+    const late = Promise.withResolvers<any>();
+    f.setConnect((id) => (id === "A" ? late.promise : Promise.resolve({})));
+    try {
+      await f.render();
+      await f.click("连接当前账号");
+      await f.render("B");
+      await act(async () => late.resolve({}));
+      check(f.changed() === 0, "Late A result changed B");
+      await f.click("连接当前账号");
+      check(f.connections.join(",") === "A,B" && f.changed() === 1, "B inherited A's busy state");
+    } finally {
+      await f.close();
+    }
+  });
+  await test("late browser startup is cancelled after leaving its provider", async () => {
+    const f = await fixture();
+    const late = Promise.withResolvers<{ flowId: string }>();
+    f.setBegin(() => late.promise);
+    try {
+      await f.render();
+      await f.click("连接当前账号");
+      await f.render("B");
+      await act(async () => late.resolve({ flowId: "late-A" }));
+      check(
+        f.cancellations[0]?.join(":") === "A:late-A",
+        "Late process retained its abandoned login",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("missing CLI uses original page feedback with localized recovery copy", async () => {
+    const f = await fixture();
+    f.setConnect(async () => {
+      throw new Error("spawn claude ENOENT");
+    });
+    try {
+      await f.render();
+      await f.click("连接当前账号");
+      check(
+        f.node.textContent?.includes("未找到官方 Claude CLI"),
+        "Raw or unlocalized process error",
+      );
+      check(!f.node.querySelector('[role="dialog"]'), "Connection failure opened a model editor");
+    } finally {
+      await f.close();
+    }
+  });
+}
+(window as any).__nativeCliTests = run().then(() => results);
