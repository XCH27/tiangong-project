@@ -0,0 +1,44 @@
+import { spawn } from "node:child_process";
+import { claudeNativeEnvironment } from "./claude-environment.js";
+
+/** The official CLI opens its browser and owns credential exchange/storage. Fleet only supervises it. */
+export function startClaudeNativeLogin(options: {
+  executable?: string;
+  configDir?: string;
+  timeoutMs?: number;
+} = {}) {
+  const child = spawn(options.executable ?? "claude", ["auth", "login", "--claudeai"], {
+    env: claudeNativeEnvironment({}, options.configDir),
+    shell: false,
+    windowsHide: true,
+    stdio: ["pipe", "ignore", "ignore"],
+  });
+  let settled = false;
+  let terminateTimer: ReturnType<typeof setTimeout> | undefined;
+  const completion = Promise.withResolvers<void>();
+  const settle = (error?: Error) => {
+    if (settled) return;
+    settled = true;
+    clearTimeout(timer);
+    if (error) completion.reject(error);
+    else completion.resolve();
+  };
+  const cancel = (message = "Native CLI login cancelled") => {
+    if (settled) return;
+    child.stdin?.end();
+    child.kill("SIGTERM");
+    terminateTimer = setTimeout(() => child.kill("SIGKILL"), 1500);
+    terminateTimer.unref();
+    settle(new Error(message));
+  };
+  const timer = setTimeout(() => cancel("Native CLI login timed out"), options.timeoutMs ?? 180000);
+  timer.unref();
+  child.once("error", (error) => settle(error));
+  child.once("close", (code) => {
+    clearTimeout(terminateTimer);
+    settle(code === 0 ? undefined : new Error("Native CLI login failed; sign in using the official CLI"));
+  });
+  // A consumer may cancel before installing its own waiter; never create an unhandled rejection.
+  void completion.promise.catch(() => {});
+  return { completion: completion.promise, cancel };
+}
