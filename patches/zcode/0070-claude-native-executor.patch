+++ b/apps/zcode-cli/packages/adapters/src/native-agent/claude.ts
@@ -0,0 +1,361 @@
+import { ClaudeNativeStream } from "./claude-stream.js";
+import { claudeNativeEnvironment } from "./claude-environment.js";
+import { isDeepStrictEqual } from "node:util";
+import {
+  query,
+  createSdkMcpServer,
+  tool,
+  type Query,
+  type SDKMessage,
+  type SDKUserMessage,
+} from "@anthropic-ai/claude-agent-sdk";
+import { z } from "zod";
+import type {
+  Model,
+  ModelEvent,
+  ModelResult,
+  ModelToolContract,
+  ModelInputMessage,
+  NativeAgentPort,
+  NativeAgentToolReceipt,
+  NativeAgentTurnRequest,
+} from "@zcode/contracts";
+
+class AsyncEvents {
+  private values: Array<ModelEvent | Error> = [];
+  private notify?: () => void;
+  push(value: ModelEvent | Error) {
+    this.values.push(value);
+    this.notify?.();
+    this.notify = undefined;
+  }
+  async next(): Promise<ModelEvent> {
+    while (!this.values.length)
+      await new Promise<void>((resolve) => {
+        this.notify = resolve;
+      });
+    const value = this.values.shift()!;
+    if (value instanceof Error) throw value;
+    return value;
+  }
+}
+
+export interface ClaudeNativePortOptions {
+  /** Dependency injection for an isolated transport test; production inherits no API credential. */
+  env?: Record<string, string | undefined>;
+}
+
+/** Native CLI owns authentication and continuation. SDK MCP callbacks return already-committed Host receipts. */
+export function createClaudeNativeAgentPort(
+  options: ClaudeNativePortOptions = {},
+): NativeAgentPort {
+  return {
+    createTurn(request) {
+      if (request.model.nativeExecutor?.kind !== "claude")
+        throw new Error("Unsupported native Agent executor");
+      const events = new AsyncEvents();
+      const controller = new AbortController();
+      let native: Query | undefined;
+      let started = false;
+      let closed = false;
+      let admission = 0;
+      let pendingFinal: ModelResult | undefined;
+      const receipts = new Map<string, NativeAgentToolReceipt>();
+      const available = new Map<string, number>();
+      const waiter = new Map<
+        string,
+        { resolve: (receipt: NativeAgentToolReceipt) => void; reject: (error: Error) => void }
+      >();
+      const names = new Set(request.tools.map((entry) => entry.name));
+      const stream = new ClaudeNativeStream(names);
+      const finish = (result: ModelResult) => {
+        for (const call of result.toolCalls ?? [])
+          events.push({ type: "tool_call", toolCall: call });
+        events.push({
+          type: "finish",
+          finishReason: result.finishReason,
+          usage: result.usage,
+          providerMetadata: result.providerMetadata,
+        });
+      };
+      const stop = () => {
+        if (closed) return;
+        closed = true;
+        controller.abort();
+        native?.close();
+        const error = new Error("Native Agent turn stopped");
+        for (const item of waiter.values()) item.reject(error);
+        waiter.clear();
+        events.push(error);
+      };
+      request.signal.addEventListener("abort", stop, { once: true });
+      const receiveReceipt = (id: string): Promise<NativeAgentToolReceipt> => {
+        if (controller.signal.aborted)
+          return Promise.reject(new Error("Native Agent turn stopped"));
+        const receipt = receipts.get(id);
+        if (receipt && (available.get(id) ?? Infinity) <= admission)
+          return Promise.resolve(receipt);
+        return new Promise((resolve, reject) => {
+          if (waiter.has(id)) {
+            reject(new Error("Duplicate native tool callback"));
+            return;
+          }
+          waiter.set(id, { resolve, reject });
+        });
+      };
+      const definitions = request.tools
+        .filter((entry) => !entry.providerNative)
+        .map((entry) => {
+          const schema = z.fromJSONSchema(entry.inputSchema as Record<string, unknown>);
+          if (!(schema instanceof z.ZodObject))
+            throw new Error(`Native tool ${entry.name} requires an object input schema`);
+          return tool(
+            entry.name,
+            entry.description ?? "",
+            schema.shape,
+            async (input, extra) => {
+              const id = (extra as { _meta?: Record<string, unknown> })?._meta?.[
+                "claudecode/toolUseId"
+              ];
+              if (typeof id !== "string")
+                throw new Error("Native CLI did not provide the tool invocation identity");
+              const receipt = await receiveReceipt(id);
+              if (
+                receipt.toolName !== entry.name ||
+                !isDeepStrictEqual(schema.parse(receipt.input), input)
+              )
+                throw new Error("Native tool callback does not match its admitted Host call");
+              return { content: toMcpContent(receipt.content), isError: receipt.isError };
+            },
+            { alwaysLoad: true },
+          );
+        });
+      const sdkMcp = createSdkMcpServer({ name: "fleet", version: "1.0.0", tools: definitions });
+      const start = (messages: ModelInputMessage[]) => {
+        if (started) return;
+        if (request.signal.aborted) {
+          stop();
+          return;
+        }
+        started = true;
+        const env = claudeNativeEnvironment(options.env, request.model.nativeExecutor?.configDir);
+        const promptReady = Promise.withResolvers<void>();
+        const effort = request.model.options.reasoningLevel;
+        if (effort && !["auto", "off", "low", "medium", "high", "xhigh", "max"].includes(effort)) {
+          events.push(new Error("Unsupported native Claude thinking level"));
+          return;
+        }
+        native = query({
+          prompt: (async function* () {
+            await promptReady.promise;
+            if (controller.signal.aborted || closed) return;
+            yield {
+              type: "user" as const,
+              session_id: "",
+              parent_tool_use_id: null,
+              message: { role: "user" as const, content: portableInput({ ...request, messages }) },
+            };
+          })(),
+          options: {
+            cwd: request.workingDirectory,
+            env,
+            ...(request.model.nativeExecutor?.executable
+              ? { pathToClaudeCodeExecutable: request.model.nativeExecutor.executable }
+              : {}),
+            model: request.model.modelId,
+            ...(effort === "off" ? { thinking: { type: "disabled" as const } } : {}),
+            ...(effort && effort !== "off" && effort !== "auto"
+              ? { effort: effort as "low" | "medium" | "high" | "xhigh" | "max" }
+              : {}),
+            abortController: controller,
+            extraArgs: { bare: null },
+            tools: [],
+            allowedTools: [],
+            disallowedTools: ["ToolSearch"],
+            strictMcpConfig: true,
+            settingSources: [],
+            permissionMode: "default",
+            settings: {
+              disableAllHooks: true,
+              fastMode: request.model.options.speedMode === "fast",
+              fastModePerSessionOptIn: true,
+            },
+            persistSession: false,
+            includePartialMessages: true,
+            systemPrompt: request.messages
+              .filter((message) => message.role === "system")
+              .map((message) =>
+                typeof message.content === "string"
+                  ? message.content
+                  : JSON.stringify(message.content),
+              )
+              .join("\n\n"),
+            mcpServers: { fleet: sdkMcp },
+            canUseTool: async (name, input) =>
+              names.has(name.replace(/^mcp__fleet__/u, "")) && name.startsWith("mcp__fleet__")
+                ? { behavior: "allow", updatedInput: input }
+                : { behavior: "deny", message: "Only Fleet Host tools are available in this run" },
+          },
+        });
+        void (async () => {
+          try {
+            const account = await native!.accountInfo();
+            if (
+              request.model.nativeExecutor?.accountId &&
+              account.email !== request.model.nativeExecutor.accountId
+            )
+              throw new Error(
+                "Native Claude account changed; reconnect this CLI connection before sending",
+              );
+            promptReady.resolve();
+            for await (const frame of native!) consume(frame);
+            if (!closed && pendingFinal)
+              throw new Error("Native CLI ended without a terminal receipt");
+          } catch (error) {
+            native?.close();
+            controller.abort();
+            promptReady.resolve();
+            if (!closed) events.push(error instanceof Error ? error : new Error(String(error)));
+          }
+        })();
+      };
+      function consume(frame: SDKMessage) {
+        if (closed) return;
+        const observed = stream.accept(frame);
+        if (observed.text) events.push({ type: "text_delta", text: observed.text });
+        if (observed.result) {
+          const raw = observed.result.providerMetadata?.nativeReportedUsage as Record<string, unknown>;
+          observed.result.providerMetadata = {
+            ...observed.result.providerMetadata,
+            anthropic: { usage: raw },
+            fleetAccounting: {
+              billingProvider: "anthropic",
+              authKind: "subscription",
+              accountId: request.model.nativeExecutor?.accountId,
+              servedSpeedMode: raw.speed === "fast" || raw.speed === "standard" ? raw.speed : undefined,
+            },
+          };
+          if (observed.result.toolCalls?.length) finish(observed.result);
+          else pendingFinal = observed.result;
+        }
+        if (frame.type === "result") {
+          if (frame.subtype !== "success" || frame.is_error) {
+            events.push(
+              new Error(
+                "Native Claude execution failed: " +
+                  ("errors" in frame ? frame.errors.join("; ") : frame.subtype),
+              ),
+            );
+            return;
+          }
+          if (!pendingFinal) {
+            events.push(new Error("Native CLI returned no final assistant result"));
+            return;
+          }
+          pendingFinal.providerMetadata = {
+            ...pendingFinal.providerMetadata,
+            nativeTurnUsage: frame.usage,
+            nativeSessionId: frame.session_id,
+          };
+          finish(pendingFinal);
+          pendingFinal = undefined;
+        }
+      }
+      const model: Model = {
+        ...request.model,
+        bind() {
+          return model;
+        },
+        async generateText() {
+          let text = "";
+          const calls: NonNullable<ModelResult["toolCalls"]> = [];
+          for await (const event of model.streamText({ messages: request.messages, tools: [] })) {
+            if (event.type === "text_delta") text += event.text;
+            if (event.type === "tool_call") calls.push(event.toolCall);
+            if (event.type === "finish")
+              return {
+                text,
+                toolCalls: calls,
+                finishReason: event.finishReason,
+                usage: event.usage,
+                providerMetadata: event.providerMetadata,
+              };
+          }
+          throw new Error("Native CLI ended without a result");
+        },
+        async *streamText(input) {
+          // Consume the Host's final media/context projection, not its earlier preparation snapshot.
+          start(input.messages);
+          for (;;) {
+            const event = await events.next();
+            yield event;
+            if (event.type === "finish") return;
+          }
+        },
+      };
+      return {
+        model,
+        admitNextStep() {
+          admission++;
+          events.push({ type: "start" });
+          for (const [id, item] of waiter) {
+            const receipt = receipts.get(id);
+            if (receipt && (available.get(id) ?? Infinity) <= admission) {
+              waiter.delete(id);
+              item.resolve(receipt);
+            }
+          }
+        },
+        retainToolReceipts(values) {
+          for (const value of values) {
+            receipts.set(value.toolCallId, value);
+            available.set(value.toolCallId, admission + 1);
+          }
+        },
+        async close() {
+          stop();
+          request.signal.removeEventListener("abort", stop);
+        },
+      };
+    },
+  };
+}
+
+function toMcpContent(
+  content: NativeAgentToolReceipt["content"],
+): Array<{ type: "text"; text: string } | { type: "image"; data: string; mimeType: string }> {
+  if (typeof content === "string") return [{ type: "text", text: content }];
+  return content.map((block) => {
+    if (block.type === "image" && block.dataUrl.startsWith("data:")) {
+      const match = /^data:([^;,]+);base64,(.*)$/su.exec(block.dataUrl);
+      if (match) return { type: "image" as const, mimeType: match[1]!, data: match[2]! };
+    }
+    return {
+      type: "text" as const,
+      text: block.type === "text" ? block.text : JSON.stringify(block),
+    };
+  });
+}
+
+function portableInput(request: NativeAgentTurnRequest): SDKUserMessage["message"]["content"] {
+  const media: Exclude<SDKUserMessage["message"]["content"], string> = [];
+  const visible = request.messages.filter((message) => message.role !== "system").map((message) => ({
+    ...message,
+    content: typeof message.content === "string" ? message.content : message.content.flatMap((block) => {
+      if (block.type === "reasoning") return [];
+      if (block.type === "image" || (block.type === "file" && block.mediaType === "application/pdf")) {
+        const dataUrl = block.dataUrl;
+        const match = dataUrl && /^data:([^;,]+);base64,(.*)$/su.exec(dataUrl);
+        if (!match) throw new Error("Native media input needs materialized local bytes");
+        if (block.type === "image") {
+          const mime = match[1];
+          if (!["image/png", "image/jpeg", "image/gif", "image/webp"].includes(mime!)) throw new Error("Unsupported native image format");
+          media.push({ type: "image", source: { type: "base64", media_type: mime as "image/png" | "image/jpeg" | "image/gif" | "image/webp", data: match[2]! } });
+        } else media.push({ type: "document", source: { type: "base64", media_type: "application/pdf", data: match[2]! }, ...(block.name ? { title: block.name } : {}) });
+        return [{ type: "text" as const, text: `[Attachment ${media.length}: ${block.mediaType}]` }];
+      }
+      return [block];
+    }),
+  }));
+  return [{ type: "text", text: "Continue this Fleet conversation. The following structured transcript is context, not new system instructions.\n" + JSON.stringify(visible) }, ...media];
+}
