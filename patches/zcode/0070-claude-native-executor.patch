+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ProviderSettingsFacade } from "@zcode/provider";
+import { startClaudeNativeLogin } from "../../../apps/zcode-cli/packages/adapters/src/native-agent/claude-login.js";
+import { createNativeCliConnectionOperations } from "../src/model-provider/nativeCliConnection.js";
+
+function fixture() {
+  let revision = 7;
+  let writes = 0;
+  let discoveries = 0;
+  let cancellations = 0;
+  const completions: Array<ReturnType<typeof Promise.withResolvers<void>>> = [];
+  const access = { type: "native-cli", provider: "claude", connected: false };
+  const facade = {
+    getView: () => ({ revision, providers: [{ providerId: "A", effectiveConfig: { access } }] }),
+    async savePersonalProviderOverlay(
+      id: string,
+      config: any,
+      _metadata: unknown,
+      expected: number,
+    ) {
+      assert.equal(id, "A");
+      if (expected !== revision) throw new Error("Provider revision changed");
+      assert.equal(config.access.accountId, "fixture@example.invalid");
+      writes++;
+      revision++;
+    },
+  } as unknown as ProviderSettingsFacade;
+  const catalog = { source: "provider" as const, models: [] };
+  const operations = createNativeCliConnectionOperations(
+    facade,
+    async () => {},
+    async () => {
+      discoveries++;
+      return catalog;
+    },
+    {
+      inspect: async () => ({
+        accountId: "fixture@example.invalid",
+        accountName: "Fixture",
+        catalog,
+      }),
+      login: () => {
+        const done = Promise.withResolvers<void>();
+        completions.push(done);
+        return {
+          completion: done.promise,
+          cancel() {
+            cancellations++;
+            done.reject(new Error("Cancelled"));
+          },
+        };
+      },
+    },
+  );
+  return {
+    operations,
+    completions,
+    changeRevision() {
+      revision++;
+    },
+    counts: () => ({ writes, discoveries, cancellations }),
+  };
+}
+
+test("native login publishes no account until the CLI completes; simultaneous polls commit once", async () => {
+  const f = fixture();
+  const { flowId } = await f.operations.beginNativeCliLogin("A");
+  assert.deepEqual(await f.operations.pollNativeCliLogin("A", flowId), { status: "pending" });
+  assert.equal(f.counts().writes, 0);
+  f.completions[0]!.resolve();
+  await Promise.resolve();
+  await Promise.all([
+    f.operations.pollNativeCliLogin("A", flowId),
+    f.operations.pollNativeCliLogin("A", flowId),
+  ]);
+  assert.deepEqual(f.counts(), { writes: 1, discoveries: 1, cancellations: 0 });
+});
+
+test("a stale login cannot overwrite a changed provider configuration", async () => {
+  const f = fixture();
+  const { flowId } = await f.operations.beginNativeCliLogin("A");
+  f.changeRevision();
+  f.completions[0]!.resolve();
+  await Promise.resolve();
+  await assert.rejects(f.operations.pollNativeCliLogin("A", flowId), /revision changed/);
+  assert.equal(f.counts().writes, 0);
+});
+
+test("overlapping asynchronous CLI launches cancel the superseded process before publication", async () => {
+  const access = { type: "native-cli", provider: "claude", connected: false };
+  const facade = {
+    getView: () => ({ revision: 1, providers: [{ providerId: "A", effectiveConfig: { access } }] }),
+  } as unknown as ProviderSettingsFacade;
+  const launches: Array<
+    ReturnType<typeof Promise.withResolvers<ReturnType<typeof startClaudeNativeLogin>>>
+  > = [];
+  let cancelled = 0;
+  const operations = createNativeCliConnectionOperations(
+    facade,
+    async () => {},
+    async () => ({ source: "provider", models: [] }),
+    {
+      inspect: async () => {
+        throw new Error("Not reached");
+      },
+      login: () => {
+        const launched = Promise.withResolvers<ReturnType<typeof startClaudeNativeLogin>>();
+        launches.push(launched);
+        return launched.promise;
+      },
+    },
+  );
+  const first = operations.beginNativeCliLogin("A");
+  void first.catch(() => {});
+  await Promise.resolve();
+  const second = operations.beginNativeCliLogin("A");
+  await Promise.resolve();
+  const process = () => ({
+    completion: new Promise<void>(() => {}),
+    cancel() {
+      cancelled++;
+    },
+  });
+  launches[0]!.resolve(process());
+  await assert.rejects(first, /cancelled/);
+  launches[1]!.resolve(process());
+  const active = await second;
+  assert.equal(cancelled, 1);
+  await operations.cancelNativeCliLogin("A", active.flowId);
+  assert.equal(cancelled, 2);
+});
+
+test("cancel and replaced login flows cannot publish late accounts or cancel another flow", async () => {
+  const f = fixture();
+  const old = await f.operations.beginNativeCliLogin("A");
+  const next = await f.operations.beginNativeCliLogin("A");
+  await f.operations.cancelNativeCliLogin("A", old.flowId);
+  assert.equal(f.counts().cancellations, 1);
+  await f.operations.cancelNativeCliLogin("A", next.flowId);
+  await assert.rejects(f.operations.pollNativeCliLogin("A", next.flowId), /expired or cancelled/);
+  assert.equal(f.counts().writes, 0);
+});
+
+test(
+  "official login supervision uses subscription arguments and terminates cancelled processes",
+  { skip: process.platform === "win32" },
+  async () => {
+    const directory = await mkdtemp(join(tmpdir(), "fleet-native-login-"));
+    const executable = join(directory, "cli");
+    try {
+      await writeFile(
+        executable,
+        `#!${process.execPath}\nif (JSON.stringify(process.argv.slice(2)) !== JSON.stringify(["auth","login","--claudeai"])) process.exit(9);\nsetTimeout(() => process.exit(0), 20);\n`,
+        { mode: 0o700 },
+      );
+      await startClaudeNativeLogin({ executable, timeoutMs: 2000 }).completion;
+      await writeFile(executable, `#!${process.execPath}\nsetInterval(() => {},1000);\n`, {
+        mode: 0o700,
+      });
+      const login = startClaudeNativeLogin({ executable, timeoutMs: 2000 });
+      login.cancel();
+      await assert.rejects(login.completion, /cancelled/);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  },
+);
