diff --git a/scripts/test-native-bundle.mjs b/scripts/test-native-bundle.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..66380e00809b6d08c6734092e742023754d0e4a1
--- /dev/null
+++ b/scripts/test-native-bundle.mjs
@@ -0,0 +1,339 @@
+// Actual staged desktop CLI, loopback provider, real Read tool and canonical SQLite persistence.
+// No vendor accounts, provider traffic, payments or user profile are involved.
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createServer } from "node:http";
+import { mkdtemp, mkdir, readFile, writeFile, rm, copyFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { createInterface } from "node:readline";
+
+const root = resolve(import.meta.dirname, "..");
+const profile = await mkdtemp(join(tmpdir(), "fleet-pi-bundle-"));
+const workspace = join(profile, "workspace");
+const requests = [];
+const notifications = [];
+const marker = "FLEET_PI_BUNDLE_FIXTURE";
+let child;
+let sessionId;
+let stderr = "";
+let sequence = 0;
+const pending = new Map();
+let serverFailure;
+const server = createServer(async (req, res) => {
+  try {
+    if (!req.url?.split("?")[0]?.endsWith("/messages")) {
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end("{}");
+      return;
+    }
+    const chunks = [];
+    for await (const chunk of req) chunks.push(chunk);
+    const body = JSON.parse(Buffer.concat(chunks).toString());
+    assert.equal(req.headers["x-api-key"], "synthetic-native-bundle");
+    assert.ok(body.tools.every((tool) => tool.name.startsWith("mcp__fleet__")));
+    requests.push(body);
+    assert.ok(requests.length <= 3);
+    const hasResult = JSON.stringify(body.messages).includes(marker);
+    res.writeHead(200, { "content-type": "text/event-stream" });
+    const frame = (type, data) =>
+      res.write(`event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`);
+    frame("message_start", {
+      message: {
+        id: `native-${requests.length}`,
+        type: "message",
+        role: "assistant",
+        model: body.model,
+        content: [],
+        stop_reason: null,
+        stop_sequence: null,
+        usage: { input_tokens: 10, output_tokens: 0 },
+      },
+    });
+    if (!hasResult) {
+      frame("content_block_start", {
+        index: 0,
+        content_block: { type: "tool_use", id: "native-read", name: "mcp__fleet__Read", input: {} },
+      });
+      frame("content_block_delta", {
+        index: 0,
+        delta: {
+          type: "input_json_delta",
+          partial_json: JSON.stringify({ file_path: join(workspace, "evidence.txt") }),
+        },
+      });
+    } else {
+      frame("content_block_start", { index: 0, content_block: { type: "text", text: "" } });
+      frame("content_block_delta", {
+        index: 0,
+        delta: {
+          type: "text_delta",
+          text: requests.length === 2 ? "fixture-complete" : "fixture-restored",
+        },
+      });
+    }
+    frame("content_block_stop", { index: 0 });
+    frame("message_delta", {
+      delta: { stop_reason: hasResult ? "end_turn" : "tool_use", stop_sequence: null },
+      usage: { output_tokens: 5 },
+    });
+    frame("message_stop", {});
+    res.end();
+  } catch (error) {
+    serverFailure = error;
+    res.writeHead(500);
+    res.end("fixture assertion failed");
+  }
+});
+
+function rpc(method, params) {
+  const id = ++sequence;
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      pending.delete(id);
+      reject(new Error(`RPC timed out: ${method}\n${stderr.slice(-2000)}`));
+    }, 15000);
+    pending.set(id, { resolve, reject, timer });
+    child.stdin.write(`${JSON.stringify({ id, method, params })}\n`);
+  });
+}
+function start(env, binary) {
+  child = spawn(process.execPath, [binary, "app-server", "--stdio", "--cwd", workspace], {
+    cwd: workspace,
+    env,
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  child.stderr.on("data", (chunk) => {
+    stderr = (stderr + chunk).slice(-20000);
+  });
+  child.on("exit", (code) => {
+    for (const item of pending.values()) {
+      clearTimeout(item.timer);
+      item.reject(new Error(`CLI exited ${code}: ${stderr.slice(-2000)}`));
+    }
+    pending.clear();
+  });
+  createInterface({ input: child.stdout }).on("line", (line) => {
+    try {
+      const frame = JSON.parse(line);
+      if (frame.method) {
+        notifications.push(frame);
+        if (frame.id !== undefined)
+          child.stdin.write(
+            `${JSON.stringify({ id: frame.id, error: { code: -32601, message: "Fixture does not authorize extra interactions" } })}\n`,
+          );
+      } else {
+        const item = pending.get(frame.id);
+        if (!item) return;
+        clearTimeout(item.timer);
+        pending.delete(frame.id);
+        if (frame.error) item.reject(new Error(JSON.stringify(frame.error)));
+        else item.resolve(frame.result);
+      }
+    } catch (error) {
+      for (const item of pending.values()) item.reject(error);
+    }
+  });
+}
+async function stop() {
+  if (!child || child.exitCode !== null) return;
+  const exited = new Promise((resolve) => child.once("exit", resolve));
+  child.kill("SIGTERM");
+  const timer = setTimeout(() => child.kill("SIGKILL"), 3000);
+  await exited;
+  clearTimeout(timer);
+}
+async function waitFor(text) {
+  const deadline = Date.now() + 15000;
+  let last;
+  while (Date.now() < deadline) {
+    if (serverFailure) throw serverFailure;
+    const result = await rpc("session/read", { sessionId });
+    last = result;
+    if (result.projection?.lastError) throw new Error(JSON.stringify(result.projection.lastError));
+    if (
+      JSON.stringify(result).includes(text) &&
+      ["idle", "completed"].includes(result.projection.status)
+    )
+      return result;
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+  throw new Error(
+    `Missing ${text}: ${stderr.slice(-2000)}\n${JSON.stringify(last)}\nrequests=${requests.length}`,
+  );
+}
+
+try {
+  await mkdir(workspace);
+  await writeFile(join(workspace, "evidence.txt"), marker);
+  for (const [name, disabled] of [
+    ["fixture-discoverable", false],
+    ["fixture-manual-only", true],
+  ]) {
+    const directory = join(workspace, ".zcode", "skills", name);
+    await mkdir(directory, { recursive: true });
+    await writeFile(
+      join(directory, "SKILL.md"),
+      `---\nname: ${name}\ndescription: Fixture skill ${name}\ndisable-model-invocation: ${disabled}\n---\n${disabled ? "MANUAL_ONLY_CONTENT" : "ON_DEMAND_CONTENT"}\n`,
+    );
+  }
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const properties = {
+    contextWindow: 1000000,
+    requiresMfjsToolSchema: false,
+    inputFormat: {
+      supportsText: true,
+      supportsImage: true,
+      supportsAudio: false,
+      supportsVideo: false,
+      supportsPdf: false,
+    },
+    outputFormat: { supportsText: true },
+    supportsToolCall: true,
+    supportsJsonSchemaOutput: false,
+    supportsNativeWebSearch: false,
+    supportsMidConversationSystem: true,
+  };
+  const model = {
+    providerId: "fixture",
+    modelId: "claude-sonnet-4-6",
+    options: { reasoningLevel: "off" },
+  };
+  const wrapper = join(profile, "native-cli-wrapper.mjs");
+  await writeFile(
+    wrapper,
+    `#!/usr/bin/env node\nimport {spawn} from 'node:child_process';import {createInterface} from 'node:readline';
+const child=spawn('/opt/homebrew/bin/claude',process.argv.slice(2),{env:{...process.env,ANTHROPIC_API_KEY:'synthetic-native-bundle',ANTHROPIC_BASE_URL:'http://127.0.0.1:${server.address().port}',CLAUDE_CONFIG_DIR:${JSON.stringify(join(profile, "native-profile"))}},stdio:['pipe','pipe','pipe']});
+process.stdin.pipe(child.stdin);child.stderr.pipe(process.stderr);
+function mark(value){if(!value||typeof value!=='object')return;if('apiKeySource' in value)value.email='fixture-native-account';for(const item of Object.values(value))mark(item);}
+createInterface({input:child.stdout}).on('line',line=>{try{const value=JSON.parse(line);mark(value);process.stdout.write(JSON.stringify(value)+'\\n');}catch{process.stdout.write(line+'\\n');}});
+child.on('exit',code=>process.exit(code??1));process.on('SIGTERM',()=>child.kill('SIGTERM'));process.on('SIGINT',()=>child.kill('SIGINT'));\n`,
+  );
+  const builtin = join(profile, "builtin.json"),
+    personal = join(profile, "personal.json");
+  await copyFile(join(root, "config/provider/zcode-builtin.json"), builtin);
+  await writeFile(
+    personal,
+    JSON.stringify({
+      schemaVersion: 1,
+      config: {
+        providerConfigRules: {
+          providerRules: [
+            {
+              providerId: "fixture",
+              providerName: "Fixture",
+              config: {
+                group: "standard-personal",
+                access: {
+                  type: "native-cli",
+                  provider: "claude",
+                  executable: wrapper,
+                  connected: true,
+                  accountId: "fixture-native-account",
+                },
+                personalModelIds: ["claude-sonnet-4-6"],
+              },
+            },
+          ],
+        },
+        modelConfigRules: {
+          providerModelRules: [
+            {
+              providerId: "fixture",
+              modelId: "claude-sonnet-4-6",
+              config: {
+                enabled: true,
+                properties,
+                optionSpecs: {
+                  maxOutputTokens: { max: 4096, map: "{}" },
+                  reasoningLevel: { values: ["off"], map: "{}" },
+                },
+              },
+            },
+          ],
+          manualProviderModelRules: [],
+        },
+        defaultModelSelection: model,
+      },
+    }),
+  );
+  // Pass only machine necessities and explicit isolated stores; no inherited provider credentials.
+  const env = {
+    PATH: process.env.PATH,
+    LANG: "en_US.UTF-8",
+    ZCODE_RUNTIME_ENV: "production",
+    FLEET_AGENT_EXECUTOR: "pi",
+    ZCODE_BUILTIN_PROVIDER_CONFIG_FILE: builtin,
+    ZCODE_PERSONAL_PROVIDER_CONFIG_FILE: personal,
+  };
+  for (const key of [
+    "ZCODE_DATA_BASE_DIR",
+    "ZCODE_DESKTOP_USER_DATA_DIR",
+    "ZCODE_DESKTOP_HOME_DIR",
+    "ZCODE_STORAGE_DIR",
+    "ZCODE_HOME",
+  ])
+    env[key] = join(profile, key);
+  env.ZCODE_SESSION_DB = join(profile, "session.sqlite");
+  const binary = join(
+    root,
+    `packages/desktop/bundled-agents/${process.platform}-${process.arch}/glm/zcode.cjs`,
+  );
+  await readFile(binary);
+  start(env, binary);
+  const workspaceRef = { workspacePath: workspace, workspaceKey: workspace };
+  const created = await rpc("session/create", {
+    workspace: workspaceRef,
+    model,
+    mode: "build",
+    titleGenerationEnabled: false,
+    toolAllowlist: ["Read"],
+    dynamicWorkflowEnabled: false,
+  });
+  sessionId = created.sessionId ?? created.session?.sessionId;
+  assert.ok(sessionId, JSON.stringify(created));
+  await rpc("session/subscribe", { sessionId, deliveryKind: "desktop-continuous" });
+  await rpc("session/send", {
+    sessionId,
+    content: "Read evidence.txt and finish.",
+    modelSelection: model,
+  });
+  await waitFor("fixture-complete");
+  assert.equal(requests.length, 2);
+  assert.ok(
+    notifications.some((frame) => JSON.stringify(frame).includes("fixture-complete")),
+    "No renderer-facing response notification",
+  );
+  await stop();
+  start(env, binary);
+  await rpc("session/resume", {
+    sessionId,
+    workspace: workspaceRef,
+    toolAllowlist: ["Read"],
+    dynamicWorkflowEnabled: false,
+  });
+  await rpc("session/send", {
+    sessionId,
+    content: "Continue after process restart.",
+    modelSelection: model,
+  });
+  await waitFor("fixture-restored");
+  assert.equal(requests.length, 3);
+  const stats = await rpc("usage/stats", { range: "all" });
+  assert.equal(
+    stats.models.reduce((total, model) => total + model.requestCount, 0),
+    3,
+  );
+  assert.equal(stats.summary.toolCallCount, 1);
+  console.log(
+    "PASS staged native Claude SDK: real CLI, Host Read, streaming, SQLite receipts and fresh Host-history handoff after process restart; all inference loopback",
+  );
+} catch (error) {
+  console.error(error);
+  console.error(stderr.slice(-3000));
+  process.exitCode = 1;
+} finally {
+  await stop();
+  await new Promise((resolve) => server.close(resolve));
+  await rm(profile, { recursive: true, force: true });
+}
