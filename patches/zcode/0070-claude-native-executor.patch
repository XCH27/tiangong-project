diff --git a/packages/services/src/model-provider/nativeCliConnection.ts b/packages/services/src/model-provider/nativeCliConnection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a64c479cccc08dfc06d8b8df2a1b6606a66bfa6d
--- /dev/null
+++ b/packages/services/src/model-provider/nativeCliConnection.ts
@@ -0,0 +1,201 @@
+import type { ProviderSettingsFacade, ProviderId } from "@zcode/provider";
+import type { startClaudeNativeLogin } from "@zcode/adapters/native-agent";
+import type { ProviderConfigObject } from "@zcode/provider";
+import type { ModelDiscoveryResult } from "./modelDiscovery.js";
+
+export interface NativeCliConnectionInspection {
+  accountId: string;
+  accountName: string;
+  planType?: string;
+  catalog: ModelDiscoveryResult;
+}
+export async function inspectNativeCliConnection(
+  access: NonNullable<ProviderConfigObject["access"]>,
+): Promise<NativeCliConnectionInspection> {
+  if (access.type !== "native-cli") throw new Error("This is not a native CLI connection");
+  if (access.provider !== "claude")
+    throw new Error("This native CLI executor is not available yet");
+  // The renderer imports the RPC contract; native execution belongs exclusively to its Node host.
+  const { inspectClaudeNativeConnection } = await import(
+    /* @vite-ignore */ "@zcode/adapters/native-agent"
+  );
+  const { account, models } = await inspectClaudeNativeConnection({
+    executable: access.executable,
+    configDir: access.configDir,
+  });
+  if (!account.email || (account.apiProvider && account.apiProvider !== "firstParty"))
+    throw new Error("Sign in to the official Claude CLI with your Claude account first");
+  if (access.accountId && access.accountId !== account.email)
+    throw new Error("Native CLI account changed; reconnect this connection");
+  return {
+    accountId: account.email,
+    accountName: account.email,
+    planType: account.subscriptionType,
+    catalog: {
+      source: "provider",
+      models: models.map((model) => ({
+        id: model.resolvedModel ?? model.value,
+        name: model.displayName,
+        config: {
+          properties: {
+            inputFormat: {
+              supportsText: true,
+              supportsImage: true,
+              supportsPdf: true,
+              supportsAudio: false,
+              supportsVideo: false,
+            },
+          },
+          optionSpecs: {
+            reasoningLevel: {
+              values: ["auto", ...(model.supportedEffortLevels ?? [])],
+              defaultValue: "auto",
+              map: "{}",
+            },
+          },
+        },
+      })),
+    },
+  };
+}
+
+/** Connect/reconnect use the existing version-checked Provider writer, not another credential store. */
+export function createNativeCliConnectionOperations(
+  facade: ProviderSettingsFacade,
+  ensureReady: () => Promise<void>,
+  discover: (id: string) => Promise<ModelDiscoveryResult>,
+  native: {
+    inspect: typeof inspectNativeCliConnection;
+    login: (
+      options: Parameters<typeof startClaudeNativeLogin>[0],
+    ) =>
+      | ReturnType<typeof startClaudeNativeLogin>
+      | Promise<ReturnType<typeof startClaudeNativeLogin>>;
+  } = {
+    inspect: inspectNativeCliConnection,
+    async login(options) {
+      const { startClaudeNativeLogin } = await import(
+        /* @vite-ignore */ "@zcode/adapters/native-agent"
+      );
+      return startClaudeNativeLogin(options);
+    },
+  },
+) {
+  const flows = new Map<
+    string,
+    {
+      id: string;
+      cancel(): void;
+      status: "pending" | "finished" | "failed";
+      failure?: Error;
+      revision: number;
+      access: NonNullable<ProviderConfigObject["access"]>;
+      commit?: Promise<void>;
+    }
+  >();
+  const connect = async (
+    id: string,
+    access: NonNullable<ProviderConfigObject["access"]>,
+    revision: number,
+  ) => {
+    if (access.type !== "native-cli") throw new Error("This is not a native CLI connection");
+    const result = await native.inspect({ ...access, accountId: undefined });
+    await facade.savePersonalProviderOverlay(
+      id as ProviderId,
+      { access: { ...access, connected: true, accountId: result.accountId } },
+      undefined,
+      revision,
+    );
+    await discover(id);
+  };
+  return {
+    async inspectNativeCli(id: string): Promise<NativeCliConnectionInspection> {
+      await ensureReady();
+      const access = facade.getView().providers.find((entry) => entry.providerId === id)
+        ?.effectiveConfig.access;
+      if (!access) throw new Error("Native CLI connection no longer exists");
+      return native.inspect(access);
+    },
+    async connectNativeCli(id: string) {
+      await ensureReady();
+      const snapshot = facade.getView();
+      const provider = snapshot.providers.find((entry) => entry.providerId === id);
+      const access = provider?.effectiveConfig.access;
+      if (!provider || access?.type !== "native-cli")
+        throw new Error("Native CLI connection no longer exists");
+      await connect(id, access, snapshot.revision);
+      return facade.getView();
+    },
+    async beginNativeCliLogin(id: string): Promise<{ flowId: string }> {
+      await ensureReady();
+      const snapshot = facade.getView();
+      const access = snapshot.providers.find((entry) => entry.providerId === id)?.effectiveConfig
+        .access;
+      if (access?.type !== "native-cli" || access.provider !== "claude")
+        throw new Error("This native CLI login is not available");
+      flows.get(id)?.cancel();
+      let login: ReturnType<typeof startClaudeNativeLogin> | undefined;
+      let cancelled = false;
+      const flow = {
+        id: crypto.randomUUID(),
+        cancel: () => {
+          cancelled = true;
+          login?.cancel();
+        },
+        status: "pending" as "pending" | "finished" | "failed",
+        revision: snapshot.revision,
+        access,
+      };
+      flows.set(id, flow);
+      try {
+        login = await native.login({ executable: access.executable, configDir: access.configDir });
+        if (cancelled || flows.get(id) !== flow) {
+          login.cancel();
+          throw new Error("Native CLI login cancelled");
+        }
+      } catch (error) {
+        if (flows.get(id) === flow) flows.delete(id);
+        throw error;
+      }
+      void login.completion.then(
+        () => {
+          flow.status = "finished";
+        },
+        (error) => {
+          flow.status = "failed";
+          Object.assign(flow, {
+            failure: error instanceof Error ? error : new Error(String(error)),
+          });
+        },
+      );
+      return { flowId: flow.id };
+    },
+    async pollNativeCliLogin(
+      id: string,
+      flowId: string,
+    ): Promise<{ status: "pending" | "connected" }> {
+      const flow = flows.get(id);
+      if (!flow || flow.id !== flowId) throw new Error("Native CLI login expired or cancelled");
+      if (flow.status === "pending") return { status: "pending" };
+      if (flow.status === "failed") {
+        flows.delete(id);
+        throw flow.failure ?? new Error("Native CLI login failed");
+      }
+      // Concurrent renderer polls share exactly one version-checked commit.
+      flow.commit ??= connect(id, flow.access, flow.revision);
+      try {
+        await flow.commit;
+      } finally {
+        if (flows.get(id) === flow) flows.delete(id);
+      }
+      return { status: "connected" };
+    },
+    async cancelNativeCliLogin(id: string, flowId: string): Promise<void> {
+      const flow = flows.get(id);
+      if (!flow || flow.id !== flowId) return;
+      if (flow.commit) return; // The original atomic writer has already admitted this connection.
+      flows.delete(id);
+      flow.cancel();
+    },
+  };
+}
