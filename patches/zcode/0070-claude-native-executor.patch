@@ -0,0 +1,76 @@
+import type { Model, ModelOptions, ModelProviderId, ModelId } from "@zcode/contracts";
+import type { NativeCliAccessConfig, ModelConfig } from "@zcode/provider";
+import { randomUUID } from "node:crypto";
+import { createClaudeNativeAgentPort } from "./claude.js";
+
+/** Native route; auxiliary no-tool requests use the same official executor and account fence. */
+export function createNativeAgentModel(
+  providerId: string,
+  modelId: string,
+  access: NativeCliAccessConfig,
+  config: ModelConfig,
+  options: ModelOptions,
+): Model {
+  const make = (selected: ModelOptions): Model => ({
+    nativeExecutor: {
+      kind: access.provider,
+      executable: access.executable ?? (access.provider === "claude" ? "claude" : "agy"),
+      configDir: access.configDir,
+      accountId: access.accountId,
+    },
+    providerId: providerId as ModelProviderId,
+    modelId: modelId as ModelId,
+    contextWindowEvidence: config.properties?.contextWindow ?? null,
+    properties: {
+      contextWindow: config.properties?.contextWindow ?? 128000,
+      requiresMfjsToolSchema: false,
+      inputFormat: {
+        supportsText: true,
+        supportsImage: config.properties?.inputFormat?.supportsImage ?? false,
+        supportsPdf: config.properties?.inputFormat?.supportsPdf ?? false,
+        supportsAudio: config.properties?.inputFormat?.supportsAudio ?? false,
+        supportsVideo: config.properties?.inputFormat?.supportsVideo ?? false,
+      },
+      outputFormat: { supportsText: true },
+      supportsToolCall: true,
+      supportsJsonSchemaOutput: false,
+      supportsNativeWebSearch: false,
+      supportsMidConversationSystem: true,
+    },
+    optionSpecs: {
+      maxOutputTokens: {
+        max: config.optionSpecs?.maxOutputTokens?.max ?? 4096,
+        map: config.optionSpecs?.maxOutputTokens?.map ?? "{}",
+      },
+      reasoningLevel: {
+        values: config.optionSpecs?.reasoningLevel?.values ?? ["auto"],
+        map: config.optionSpecs?.reasoningLevel?.map ?? "{}",
+      },
+    },
+    options: selected,
+    bind(next) {
+      return make({ ...selected, ...next });
+    },
+    async generateText(request) {
+      let text = "";
+      for await (const event of make(selected).streamText(request)) {
+        if (event.type === "text_delta") text += event.text;
+        if (event.type === "finish") return { text, finishReason: event.finishReason, usage: event.usage, providerMetadata: event.providerMetadata };
+      }
+      throw new Error("Native executor ended without a result");
+    },
+    async *streamText(request) {
+      if (request.tools?.length) throw new Error("Native tools require the Fleet Host execution path");
+      const native = createClaudeNativeAgentPort().createTurn({
+        model: make({ ...selected, ...request.options }), messages: request.messages, tools: [],
+        sessionId: randomUUID(), turnId: randomUUID(), workingDirectory: process.cwd(),
+        signal: request.abortSignal ?? AbortSignal.timeout(60000),
+      });
+      try {
+        native.admitNextStep();
+        yield* native.model.streamText(request);
+      } finally { await native.close(); }
+    },
+  });
+  return make(options);
+}
