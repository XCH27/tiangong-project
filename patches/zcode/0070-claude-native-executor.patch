@@ -0,0 +1,44 @@
+import { query, type AccountInfo, type ModelInfo } from "@anthropic-ai/claude-agent-sdk";
+import { claudeNativeEnvironment } from "./claude-environment.js";
+
+/** Public native control requests only. No prompt, token/cache import, or inference request. */
+export async function inspectClaudeNativeConnection(
+  options: {
+    executable?: string;
+    configDir?: string;
+    env?: Record<string, string | undefined>;
+  } = {},
+): Promise<{ account: AccountInfo; models: ModelInfo[] }> {
+  const controller = new AbortController();
+  const gate = Promise.withResolvers<void>();
+  const native = query({
+    prompt: (async function* () {
+      await gate.promise;
+    })(),
+    options: {
+      pathToClaudeCodeExecutable: options.executable ?? "claude",
+      cwd: process.cwd(),
+      env: claudeNativeEnvironment(options.env, options.configDir),
+      abortController: controller,
+      extraArgs: { bare: null },
+      tools: [],
+      settingSources: [],
+      persistSession: false,
+      strictMcpConfig: true,
+      settings: { disableAllHooks: true },
+    },
+  });
+  const timer = setTimeout(() => {
+    controller.abort();
+    native.close();
+  }, 10000);
+  try {
+    const [account, models] = await Promise.all([native.accountInfo(), native.supportedModels()]);
+    return { account, models };
+  } finally {
+    clearTimeout(timer);
+    native.close();
+    controller.abort();
+    gate.resolve();
+  }
+}
