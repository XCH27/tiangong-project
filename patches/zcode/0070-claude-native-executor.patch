index 0000000000000000000000000000000000000000..f73f82adb284a20094fe593ef0ded765f8ecf7a9
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/claude-stream.ts
@@ -0,0 +1,66 @@
+import type { SDKMessage } from "@anthropic-ai/claude-agent-sdk";
+import type { ModelResult } from "@zcode/contracts";
+
+type AssistantMessage = Extract<SDKMessage, { type: "assistant" }>["message"];
+
+/** SDK assistant frames precede final usage and may arrive once per completed content block. */
+export class ClaudeNativeStream {
+  private current?: {
+    id: string;
+    model: string;
+    usage: AssistantMessage["usage"];
+    blocks: Map<number, AssistantMessage["content"]>;
+    index: number;
+    streamedText: string;
+  };
+  private seenToolIds = new Set<string>();
+  constructor(private readonly names: ReadonlySet<string>) {}
+
+  accept(frame: SDKMessage): { text?: string; result?: ModelResult } {
+    if (frame.type === "assistant") {
+      const current = this.current;
+      if (!current || current.id !== frame.message.id)
+        throw new Error("Native assistant frame has no matching request stream");
+      current.blocks.set(current.index, frame.message.content);
+      current.usage = { ...current.usage, ...frame.message.usage };
+      return {};
+    }
+    if (frame.type !== "stream_event") return {};
+    const event = frame.event;
+    if (event.type === "message_start") {
+      if (this.current) throw new Error("Native request stream overlapped an unfinished message");
+      this.current = { id: event.message.id, model: event.message.model, usage: event.message.usage, blocks: new Map(), index: 0, streamedText: "" };
+      return {};
+    }
+    const current = this.current;
+    if (!current) throw new Error("Native stream event has no current message");
+    if (event.type === "content_block_start") current.index = event.index;
+    if (event.type === "content_block_delta" && event.delta.type === "text_delta") {
+      current.streamedText += event.delta.text;
+      return { text: event.delta.text };
+    }
+    if (event.type === "message_delta") {
+      // Streaming deltas use null for counters not included in this frame.
+      const reported = Object.fromEntries(Object.entries(event.usage).filter(([, value]) => value != null));
+      current.usage = { ...current.usage, ...reported };
+    }
+    if (event.type !== "message_stop") return {};
+    this.current = undefined;
+    const blocks = [...current.blocks].sort(([a], [b]) => a - b).flatMap(([, value]) => value);
+    const text = blocks.filter((block) => block.type === "text").map((block) => block.text).join("");
+    if (text !== current.streamedText) throw new Error("Native text does not match its streamed result");
+    const calls = blocks.filter((block) => block.type === "tool_use").map((block) => {
+      if (this.seenToolIds.has(block.id)) throw new Error("Native CLI repeated a tool invocation identity");
+      this.seenToolIds.add(block.id);
+      const canonical = block.name.startsWith("mcp__fleet__") ? block.name.slice(12) : block.name;
+      return { id: block.id, name: this.names.has(canonical) && block.name.startsWith("mcp__fleet__") ? canonical : `native-unavailable:${block.name}`, input: block.input };
+    });
+    const raw = current.usage;
+    const input = raw.input_tokens + (raw.cache_read_input_tokens ?? 0) + (raw.cache_creation_input_tokens ?? 0);
+    return { result: {
+      text, toolCalls: calls, finishReason: calls.length ? "tool-calls" : "stop",
+      usage: { inputTokens: input, outputTokens: raw.output_tokens, totalTokens: input + raw.output_tokens, cacheReadTokens: raw.cache_read_input_tokens ?? 0, cacheWriteTokens: raw.cache_creation_input_tokens ?? 0 },
+      providerMetadata: { nativeExecutor: "claude", nativeRequestId: current.id, nativeModelId: current.model, nativeReportedUsage: raw },
+    } };
+  }
+}
