diff --git a/apps/zcode-cli/packages/core/test/claude-native-turn.test.ts b/apps/zcode-cli/packages/core/test/claude-native-turn.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b23960a1e9bf7eabee6e127634edb667782d068c
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/claude-native-turn.test.ts
@@ -0,0 +1,151 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "node:child_process";
+import { SessionEventType } from "@zcode/contracts";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { createClaudeNativeAgentPort } from "../../adapters/src/native-agent/claude.js";
+
+const nativeExecutable = process.env.FLEET_CLAUDE_TEST_CLI ?? "claude";
+const nativeAvailable = (() => { try { execFileSync(nativeExecutable, ["--version"], { stdio: "ignore", timeout: 5000 }); return true; } catch { return false; } })();
+
+async function nativeFixture(accountId?: string, checkMedia = false) {
+  const profile = await mkdtemp(join(tmpdir(), "fleet-claude-native-"));
+  let requests = 0;
+  let failure: unknown;
+  const server = createServer(async (req, res) => {
+    try {
+      if (!req.url?.split("?")[0]?.endsWith("/messages")) { res.writeHead(200, { "content-type": "application/json" }); res.end("{}"); return; }
+      const chunks = [];
+      for await (const chunk of req) chunks.push(chunk);
+      const body = JSON.parse(Buffer.concat(chunks).toString());
+      assert.equal(req.headers["x-api-key"], "synthetic-native-test");
+      assert.ok(body.tools.every((entry: any) => entry.name.startsWith("mcp__fleet__")));
+      assert.ok(body.tools.some((entry: any) => entry.name === "mcp__fleet__Probe"));
+      if (checkMedia) {
+        const blocks = body.messages.flatMap((message: any) => Array.isArray(message.content) ? message.content : []);
+        assert.ok(blocks.some((block: any) => block.type === "image" && block.source.media_type === "image/png"));
+        assert.ok(blocks.some((block: any) => block.type === "document" && block.source.media_type === "application/pdf"));
+      }
+      requests++;
+      assert.ok(requests <= 4, "Unexpected native model request");
+      const hasResult = JSON.stringify(body.messages).includes("native-approved") || body.messages.some((message: any) => Array.isArray(message.content) && message.content.some((block: any) => block.type === "tool_result"));
+      res.writeHead(200, { "content-type": "text/event-stream" });
+      const send = (type: string, data: Record<string, unknown>) => res.write(`event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`);
+      send("message_start", { message: { id: `native-request-${requests}`, type: "message", role: "assistant", model: body.model, content: [], stop_reason: null, stop_sequence: null, usage: { input_tokens: 20, cache_read_input_tokens: 30, cache_creation_input_tokens: 5, cache_creation: { ephemeral_5m_input_tokens: 5, ephemeral_1h_input_tokens: 0 }, output_tokens: 0 } } });
+      if (!hasResult) {
+        send("content_block_start", { index: 0, content_block: { type: "tool_use", id: `native-call-${requests}`, name: "mcp__fleet__Probe", input: {} } });
+        send("content_block_delta", { index: 0, delta: { type: "input_json_delta", partial_json: JSON.stringify({ value: "native-approved" }) } });
+      } else {
+        send("content_block_start", { index: 0, content_block: { type: "text", text: "" } });
+        send("content_block_delta", { index: 0, delta: { type: "text_delta", text: "native-complete" } });
+      }
+      send("content_block_stop", { index: 0 });
+      send("message_delta", { delta: { stop_reason: hasResult ? "end_turn" : "tool_use", stop_sequence: null }, usage: { output_tokens: 5 } });
+      send("message_stop", {}); res.end();
+    } catch (error) { failure = error; res.writeHead(400); res.end("Fixture assertion failed"); }
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); assert.ok(address && typeof address === "object");
+  const port = createClaudeNativeAgentPort({ env: { ANTHROPIC_API_KEY: "synthetic-native-test", ANTHROPIC_BASE_URL: `http://127.0.0.1:${address.port}`, CLAUDE_CONFIG_DIR: profile } });
+  const f = await fixture(undefined, true, { nativeExecutor: { kind: "claude", executable: nativeExecutable, accountId }, supportsPdf: checkMedia, deps: { nativeAgentPort: port } });
+  return { f, requests: () => requests, assertTransport() { if (failure) throw failure; }, async close() { await f.close(); server.closeAllConnections(); await new Promise<void>((resolve) => server.close(() => resolve())); await rm(profile, { recursive: true, force: true }); } };
+}
+
+test("native Claude owns continuation while Host permissions, effect receipts and usage remain canonical", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture();
+  try {
+    const result = await n.f.runtime.executeTurn("Use Probe and complete this local task");
+    n.assertTransport();
+    assert.equal(result.response, "native-complete");
+    assert.equal(n.requests(), 2);
+    assert.equal(n.f.requests.length, 0, "Native execution used the Pi/API model transport");
+    assert.equal(n.f.effects, 1);
+    assert.equal(n.f.permissionCalls, 1);
+    assert.equal(await n.f.read(), "native-approved");
+    const rows = await n.f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+    assert.equal(rows.totals.modelRequestCount, 2);
+    assert.equal(rows.toolTotals.toolCallCount, 1);
+    assert.equal(rows.totals.inputTokens, 110, "Inclusive input must count cached tokens exactly once");
+    assert.equal(rows.totals.cacheReadTokens, 60);
+    assert.equal(rows.totals.cacheCreationTokens, 10, JSON.stringify(rows.totals));
+    assert.equal(rows.totals.outputTokens, 10);
+    assert.equal(rows.totals.totalTokens, 120);
+    assert.deepEqual(n.f.executorFacts(), ["claude", "claude"]);
+    await n.f.reopen();
+    assert.equal((await n.f.runtime.executeTurn("Continue after Host restart")).response, "native-complete");
+    n.assertTransport();
+    assert.equal(n.f.effects, 1, "Completed Host tools were replayed on restart");
+  } finally { await n.close(); }
+});
+
+test("a failed Host continuation admission cannot release a native tool receipt", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture();
+  let admissions = 0;
+  const runtime = n.f.runtime as any;
+  const append = runtime.appendEvent.bind(runtime);
+  runtime.appendEvent = async (event: any, ...args: any[]) => {
+    if (event.type === SessionEventType.ModelRequest && ++admissions === 2)
+      throw new Error("Fixture durable admission failed");
+    return append(event, ...args);
+  };
+  try {
+    await assert.rejects(runtime.executeTurn("Use Probe"));
+    assert.equal(n.requests(), 1);
+    assert.equal(n.f.effects, 1);
+    assert.equal(await n.f.read(), "native-approved");
+  } finally { await n.close(); }
+});
+
+test("native Claude refusal reaches the original Host permission path before any effect", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture();
+  try {
+    n.f.deny();
+    assert.equal((await n.f.runtime.executeTurn("Try Probe")).response, "native-complete");
+    n.assertTransport();
+    assert.equal(n.f.effects, 0);
+    assert.equal(n.f.permissionCalls, 1);
+    await assert.rejects(n.f.read(), { code: "ENOENT" });
+  } finally { await n.close(); }
+});
+
+
+test("native account mismatch refuses before any inference or tool effect", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture("wrong-account-fixture");
+  try {
+    await assert.rejects(n.f.runtime.executeTurn("Do the task"), (error: any) => /account changed/.test(error.cause?.message ?? error.message));
+    assert.equal(n.requests(), 0);
+    assert.equal(n.f.effects, 0);
+  } finally { await n.close(); }
+});
+
+test("Stop while native work awaits Host approval has no effect or next native request", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture();
+  const entered = Promise.withResolvers<void>();
+  const answer = Promise.withResolvers<any>();
+  const controller = new AbortController();
+  try {
+    n.f.permissionWith(async () => { entered.resolve(); return answer.promise; });
+    const running = n.f.runtime.executeTurn("Try Probe", undefined, { abortSignal: controller.signal });
+    void running.catch(() => {});
+    await entered.promise;
+    controller.abort(new Error("user stop"));
+    answer.resolve({ decision: "allow" });
+    await assert.rejects(running);
+    assert.equal(n.requests(), 1);
+    assert.equal(n.f.effects, 0);
+  } finally { controller.abort(); answer.resolve({ decision: "deny" }); await n.close(); }
+});
+
+
+test("native SDK receives images and PDF bytes as real media blocks", { timeout: 30000, skip: !nativeAvailable }, async () => {
+  const n = await nativeFixture(undefined, true);
+  try {
+    const image = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVQIHWP4z8DwHwAFgAI/ScLbtAAAAABJRU5ErkJggg==";
+    await n.f.runtime.executeTurn("Review the supplied image and PDF", [{ type: "image", content: image, mimeType: "image/png" }, { type: "pdf", content: "data:application/pdf;base64,JVBERi0xLjQK", mimeType: "application/pdf" }]);
+    n.assertTransport();
+  } finally { await n.close(); }
+});
