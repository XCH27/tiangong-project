+
+/** Account replacement retires that connection's catalogue through the same atomic Facade writer. */
+export async function clearSubscriptionFacadeCatalog(
+  facade: ProviderSettingsFacade,
+  ensureReady: () => Promise<void>,
+  subscriptions: SubscriptionConnectionOwner | undefined,
+  id: string,
+  revision: string,
+): Promise<void> {
+  await ensureReady();
+  const provider = facade.getView().providers.find((entry) => entry.providerId === id);
+  if (!provider || provider.effectiveConfig.access?.type !== "subscription")
+    throw new Error("Subscription connection no longer exists");
+  await facade.mergeDiscoveredModels(
+    id,
+    [],
+    provider.effectiveConfig,
+    async () => {
+      if (!subscriptions || (await subscriptions.accounts(id)).revision !== revision)
+        throw new Error("Subscription account changed; reload its model list");
+    },
+    true,
+  );
+}
