diff --git a/packages/ui/test/connectionIntake.browser.test.tsx b/packages/ui/test/connectionIntake.browser.test.tsx
new file mode 100644
index 0000000..b1c2e02
--- /dev/null
+++ b/packages/ui/test/connectionIntake.browser.test.tsx
@@ -0,0 +1,147 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import {
+  parseProviderTemplateMap,
+  ProviderSettingsFacade,
+  type ProviderRegistryFacadeSource,
+} from "@zcode/provider";
+import builtin from "../../../config/provider/zcode-builtin.json";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { ProviderDetailFeedbackBoundary } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+import { ProviderTemplatePicker } from "../src/settings/model-provider-section/ProviderTemplatePicker.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const templates = new ProviderSettingsFacade({
+  getSnapshot: () => ({
+    registry: { revision: 1 },
+    config: {
+      zcodeBuiltinProviderTemplates: parseProviderTemplateMap(
+        builtin.config.providerConfigRules.templateRules,
+      ),
+    },
+    resolution: { registryProviders: [], resolvedProviders: [] },
+    account: { states: {} },
+  }),
+} as unknown as ProviderRegistryFacadeSource).getView().providerTemplates;
+const results: { name: string; error?: string }[] = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+async function run() {
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const theme of ["theme-zai-light", "theme-zai-dark"]) {
+      const name = `complete connection intake ${locale}/${theme}`;
+      const node = document.createElement("div");
+      node.style.width = "720px";
+      document.documentElement.className = theme;
+      document.body.append(node);
+      const root = createRoot(node);
+      const created: any[] = [];
+      const zh = locale === "zh-CN";
+      const service = {
+        detectNativeClis: async () => ({
+          claude: { bundled: true, installed: true, version: "2.1.fixture" },
+          codex: { bundled: true, installed: false },
+        }),
+      };
+      const buttons = () => [...node.querySelectorAll<HTMLButtonElement>("button")];
+      const click = async (text: string, prefix = false) => {
+        const button = buttons().find((b) =>
+          prefix ? b.textContent?.trim().startsWith(text) : b.textContent?.trim() === text,
+        );
+        check(button, `Missing button ${text}`);
+        await act(async () => {
+          button.dispatchEvent(new MouseEvent("mousedown", { bubbles: true, button: 0 }));
+          button.click();
+        });
+      };
+      try {
+        await act(async () =>
+          root.render(
+            <ServiceProvider services={{ providerSettingsService: service } as never}>
+              <PlatformProvider platform={{ openExternal: async () => {} } as never}>
+                <ZCodeIntlProvider initialLocale={locale}>
+                  <TooltipProvider>
+                    <ProviderDetailFeedbackBoundary>
+                      <ProviderTemplatePicker
+                        templates={templates}
+                        onBack={() => {}}
+                        onCreateFromTemplate={async (...args) => {
+                          created.push(args);
+                        }}
+                        onCreateCustom={async () => {
+                          throw new Error("unexpected custom create");
+                        }}
+                        creating={false}
+                        onImported={() => {}}
+                      />
+                    </ProviderDetailFeedbackBoundary>
+                  </TooltipProvider>
+                </ZCodeIntlProvider>
+              </PlatformProvider>
+            </ServiceProvider>,
+          ),
+        );
+        check(
+          node.textContent?.includes(zh ? "账号登录" : "Account sign-in"),
+          "Missing sign-in mechanism",
+        );
+        await click(zh ? "API 接入" : "API access");
+        await click("MiniMax", true);
+        await click("MiniMax Token Plan");
+        check(node.querySelector("#provider-setup-url"), "API-key plan lost its URL/key form");
+        check(
+          !buttons().some(
+            (b) => b.textContent === (zh ? "连接订阅账号" : "Connect subscription account"),
+          ),
+          "Key-based plan was converted to browser login",
+        );
+        const back = node.querySelector<HTMLButtonElement>("button[aria-label]");
+        check(back, "missing back");
+        await act(async () => back.click());
+        await click(zh ? "终端接入" : "Terminal access");
+        check(
+          node.textContent?.includes("Pi"),
+          "Default assistant/external Agent distinction is missing",
+        );
+        const codex = buttons().find((b) => b.textContent?.startsWith("Codex CLI"));
+        check(
+          codex?.textContent?.includes(zh ? "程序不可用" : "Executable unavailable"),
+          "Broken bundled CLI was advertised as installed/core",
+        );
+        check(
+          !node.textContent?.includes(zh ? "内置" : "Built in"),
+          "Ambiguous builtin label remains",
+        );
+        await click("Claude Code", true);
+        check(
+          !node.querySelector("#provider-setup-url") &&
+            !node.querySelector('input[type="password"]'),
+          "Native CLI got an API form",
+        );
+        check(
+          !buttons().some(
+            (b) => b.textContent === (zh ? "连接订阅账号" : "Connect subscription account"),
+          ),
+          "Native CLI still has subscription CTA",
+        );
+        await click(zh ? "连接当前账号" : "Connect current account");
+        check(
+          created.length === 1 && created[0][0] === "fleet-claude-native" && created[0][2] === true,
+          "Native creation changed its route",
+        );
+        check(JSON.stringify(created[0][1]) === "{}", "Native setup invented API credentials");
+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: error instanceof Error ? error.message : String(error) });
+      } finally {
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    }
+  return results;
+}
+(window as any).__connectionIntakeTests = run();
