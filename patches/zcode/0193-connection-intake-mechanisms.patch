-      const found = executable ? await version(executable) : undefined;
-      return [kind, { bundled: false, installed: found !== undefined, ...(found ? { version: found } : {}) }];
-    }),
+    NATIVE_EXECUTOR_KINDS.map(async (kind): Promise<[NativeExecutorKind, NativeCliDetection]> =>
+      [kind, await detectNativeCli(kind)]),
   );
   return Object.fromEntries(entries) as Record<NativeExecutorKind, NativeCliDetection>;
 }
+
+export async function detectNativeCli(
+  kind: NativeExecutorKind,
+  resolveExecutable: () => string | undefined = () => kind === "claude" ? resolveClaudeNativeExecutable()
+    : kind === "codex" ? resolveCodexNativeExecutable()
+      : kind === "antigravity" ? resolveAntigravityExecutable()
+        : isAcpExecutorKind(kind) ? resolveAcpExecutable(kind) : undefined,
+): Promise<NativeCliDetection> {
+  const bundled = kind === "claude" || kind === "codex";
+  try {
+    const executable = resolveExecutable();
+    const found = executable ? await version(executable) : undefined;
+    // 找到了附带路径不代表程序能运行；版本探测失败必须如实报告不可用。
+    return { bundled, installed: found !== undefined, ...(found ? { version: found } : {}) };
+  } catch {
+    return { bundled, installed: false };
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/test/native-detect.test.ts b/apps/zcode-cli/packages/adapters/test/native-detect.test.ts
new file mode 100644
index 0000000..75e64ec
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/native-detect.test.ts
@@ -0,0 +1,27 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, writeFile, chmod, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { detectNativeCli } from "../src/native-agent/native-detect.js";
+
+test("a shipped binary is only available after its real version probe succeeds", async () => {
+  const found = await detectNativeCli("codex", () => process.execPath);
+  assert.equal(found.bundled, true);
+  assert.equal(found.installed, true);
+  assert.match(found.version!, /^\d+\.\d+/);
+  const missing = await detectNativeCli("codex", () => join(tmpdir(), "fleet-missing-executor-never-created"));
+  assert.deepEqual(missing, { bundled: true, installed: false });
+  const broken = await detectNativeCli("claude", () => { throw new Error("fixture unavailable"); });
+  assert.deepEqual(broken, { bundled: true, installed: false });
+});
+
+test("an existing executable that exits unsuccessfully is not reported installed", { skip: process.platform === "win32" }, async () => {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-cli-detection-"));
+  try {
+    const file = join(dir, "broken-cli");
+    await writeFile(file, "#!/bin/sh\nexit 1\n");
+    await chmod(file, 0o700);
+    assert.deepEqual(await detectNativeCli("claude", () => file), { bundled: true, installed: false });
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
