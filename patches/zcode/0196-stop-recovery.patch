@@ -0,0 +1,82 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { backgroundStopFixture as fixture } from "./helpers/background-stop-fixture.js";
+import {
+  backgroundStopKey,
+  restoreStoppedBackgroundAgentTask,
+} from "../src/subagent/background-agent-settlement.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+
+for (const state of ["pending", "admitted"] as const) {
+  for (const acknowledgementLost of [false, true]) {
+    test(
+      `Stop owns a resumed run while its pending journal write is paused (${state},${acknowledgementLost})`,
+      { timeout: 10000 },
+      async () => {
+        const f = await fixture(false, false, true);
+        const entered = Promise.withResolvers<void>();
+        const release = Promise.withResolvers<void>();
+        let reopened: SqliteSessionStore | undefined;
+        try {
+          await f.stop();
+          const previousSpan = f.registry.get("child")!.traceContext!.spanId;
+          const save = f.store!.saveSessionEntry.bind(f.store);
+          f.store!.saveSessionEntry = async (input) => {
+            if ((input.data as any)?.resumeIntent?.state === state) {
+              entered.resolve();
+              await release.promise;
+              await save(input);
+              if (acknowledgementLost)
+                throw new Error("paused pending journal acknowledgement lost");
+              return;
+            }
+            await save(input);
+          };
+          const resume = f.resume();
+          await entered.promise;
+          const resumedSpan = f.registry.get("child")!.traceContext!.spanId;
+          assert.notEqual(resumedSpan, previousSpan);
+          await f.port.stopTask!("child");
+          const stopped = f.registry.get("child")!;
+          assert.equal(
+            stopped.status,
+            "killed",
+            "Stop cannot wait behind the paused setup journal",
+          );
+          assert.equal(stopped.traceContext!.spanId, resumedSpan);
+          const metadataPath = join(dirname(f.outputFile), "metadata.json");
+          const metadata = await readFile(metadataPath, "utf8");
+          release.resolve();
+          assert.equal((await resume).status, "failed", "interrupted SendMessage must settle");
+          assert.equal(f.runs.length, 1, "no resumed child executed");
+          assert.equal(f.registry.get("child")!.traceContext!.spanId, resumedSpan);
+          assert.equal(f.registry.get("child")!.status, "killed");
+          assert.equal(
+            await readFile(metadataPath, "utf8"),
+            metadata,
+            "stale resume cannot overwrite newer Stop artifacts",
+          );
+          assert.equal(JSON.parse(metadata).status, "stopped");
+          f.closeStore();
+          reopened = new SqliteSessionStore({ dbPath: join(f.root, "session.sqlite") });
+          const entry = (
+            await reopened.sessionEntries({ sessionID: "parent" as never, type: "subagent_stop" })
+          ).find((item) => item.id === backgroundStopKey(stopped))!;
+          const evidence = restoreStoppedBackgroundAgentTask(entry.data)!;
+          assert.equal(evidence.task.traceContext!.spanId, resumedSpan);
+          assert.equal(evidence.task.status, "killed");
+          assert.equal(evidence.backgroundEventEmitted, true);
+          assert.equal(evidence.subagentEventEmitted, true);
+          assert.equal(evidence.notificationEnqueued, true);
+          assert.equal(evidence.resumeIntent, undefined);
+        } finally {
+          release.resolve();
+          reopened?.close();
+          await f.close();
+        }
+      },
+    );
+  }
+}
