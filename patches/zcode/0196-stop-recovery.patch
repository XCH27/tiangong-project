@@ -0,0 +1,364 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { dirname, join } from "node:path";
+import { mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { SessionEventType } from "@zcode/contracts";
+import { backgroundStopFixture as fixture } from "./helpers/background-stop-fixture.js";
+import {
+  backgroundStopKey,
+  restoreStoppedBackgroundAgentTask,
+} from "../src/subagent/background-agent-settlement.js";
+import { createExploreSubagentPort } from "../src/subagent/runner.js";
+import { stopBackgroundTask } from "../src/runtime/methods/background.js";
+import { InMemoryRuntimeTaskRegistry } from "../src/runtime-task/registry.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+// Commit-before-acknowledgement failure must not replay a terminal receipt.
+test("Stop retry after receipt acknowledgement loss does not duplicate the accepted receipt", async () => {
+  const f = await fixture(true, false, true);
+  try {
+    f.failures.afterEvent = SessionEventType.SubagentStopped;
+    await assert.rejects(f.stop(), /acknowledgement lost/);
+    assert.deepEqual(await f.childExit, [null, "SIGTERM"]);
+    f.failures.afterEvent = undefined;
+    await f.stop();
+    assert.equal(
+      f.events.filter((event) => event.type === SessionEventType.SubagentStopped).length,
+      1,
+    );
+    assert.equal(f.notifications.length, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+async function coldPort(root: string) {
+  const store = new SqliteSessionStore({ dbPath: join(root, "session.sqlite") });
+  const registry = new InMemoryRuntimeTaskRegistry();
+  const effects = { events: 0, notifications: 0, executions: 0 };
+  const port = createExploreSubagentPort({
+    runtimeTaskRegistry: registry,
+    outputRootDir: root,
+    stopPersistence: {
+      async save(stopped) {
+        await store.saveSessionEntry({
+          id: backgroundStopKey(stopped.task),
+          sessionID: "parent" as never,
+          type: "subagent_stop",
+          time: { created: stopped.task.completedAt!.getTime(), updated: Date.now() },
+          data: stopped,
+        });
+      },
+      async load(taskId) {
+        const entries = await store.sessionEntries({
+          sessionID: "parent" as never,
+          type: "subagent_stop",
+        });
+        return entries
+          .sort((a, b) => b.time.created - a.time.created)
+          .map((entry) => restoreStoppedBackgroundAgentTask(entry.data))
+          .find((stop) => stop?.task.taskId === taskId);
+      },
+      async hasEvent() {
+        return false;
+      },
+      async hasNotification(id) {
+        return (await store.listSessionInputs({ sessionID: "parent" as never })).some(
+          (input) => input.id === id,
+        );
+      },
+    },
+    async emitParentEvent() {
+      effects.events++;
+    },
+    enqueueParentTaskNotification() {
+      effects.notifications++;
+      return undefined;
+    },
+    async runExploreAgent() {
+      effects.executions++;
+      throw new Error("cold recovery must not execute a child");
+    },
+  });
+  return { port, registry, store, effects };
+}
+
+test("cold SQLite reopen recovers known Stop settlement without a child or notification replay", async () => {
+  const f = await fixture(true, false, true);
+  let cold: Awaited<ReturnType<typeof coldPort>> | undefined;
+  try {
+    await f.stop();
+    await f.childExit;
+    f.closeStore();
+    cold = await coldPort(f.root);
+    assert.equal((await cold.port.getTask!("child"))!.status, "killed");
+    assert.equal((await cold.port.stopTask!("child"))!.status, "killed");
+    assert.deepEqual(cold.effects, { events: 0, notifications: 0, executions: 0 });
+  } finally {
+    cold?.store.close();
+    await f.close();
+  }
+});
+
+test("unknown notification acceptance remains unresolved on retry and cold reopen", async () => {
+  const f = await fixture(true, false, true);
+  let cold: Awaited<ReturnType<typeof coldPort>> | undefined;
+  try {
+    f.failures.afterQueue = true;
+    await assert.rejects(f.stop(), /acknowledgement lost/);
+    await f.childExit;
+    f.closeStore();
+    cold = await coldPort(f.root);
+    await assert.rejects(
+      stopBackgroundTask.call(
+        {
+          runtimeTaskRegistry: cold.registry,
+          subagentPort: cold.port,
+          rebuildProjection: async () => ({ backgroundTasks: [] }),
+        } as never,
+        "child",
+        { strict: true },
+      ),
+      /acceptance is unresolved/,
+    );
+    assert.equal(
+      cold.registry.get("child")!.status,
+      "lost",
+      "unresolved settlement never claims a running child",
+    );
+    assert.deepEqual(cold.effects, { events: 0, notifications: 0, executions: 0 });
+  } finally {
+    cold?.store.close();
+    await f.close();
+  }
+});
+
+test("cold pending receipt has no acknowledgement proof and is preserved without replay", async () => {
+  const f = await fixture(true, false, true);
+  let cold: Awaited<ReturnType<typeof coldPort>> | undefined;
+  try {
+    f.failures.afterEvent = SessionEventType.SubagentStopped;
