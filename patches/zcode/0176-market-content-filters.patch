index 0000000..7abd775
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/plugin-market-content-kinds.test.ts
@@ -0,0 +1,53 @@
+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { inferLocalMarketplacePluginComponentKinds } from "@zcode/adapters/plugins";
+
+// OV-100: Market filters read what a package contains. Catalog entries rarely declare contents, so
+// packages already on disk are inspected; remote packages stay unknown instead of "contains nothing".
+test("a marketplace package on disk reports its contents; a remote one stays unknown", async () => {
+  const storageRoot = await mkdtemp(join(os.tmpdir(), "fleet-market-kinds-"));
+  try {
+    const marketplaceDir = join(storageRoot, "marketplaces", "local-market");
+    const pluginRoot = join(marketplaceDir, "plugins", "writer");
+    await mkdir(join(pluginRoot, "skills", "draft"), { recursive: true });
+    await writeFile(
+      join(pluginRoot, "skills", "draft", "SKILL.md"),
+      "---\nname: draft\ndescription: Draft text\n---\nBody\n",
+    );
+    const manifest = {
+      name: "local-market",
+      plugins: [
+        { name: "writer", source: "./plugins/writer" },
+        { name: "remote", source: { source: "github", repo: "example/remote" } },
+      ],
+    };
+    await writeFile(join(marketplaceDir, "marketplace.json"), JSON.stringify(manifest));
+    const entry = (name: string) => {
+      const raw = manifest.plugins.find((plugin) => plugin.name === name)!;
+      return { name, source: raw.source, raw } as never;
+    };
+
+    assert.deepEqual(
+      inferLocalMarketplacePluginComponentKinds({ entry: entry("writer"), marketplace: "local-market", storageRoot }),
+      ["skill"],
+    );
+    assert.equal(
+      inferLocalMarketplacePluginComponentKinds({ entry: entry("remote"), marketplace: "local-market", storageRoot }),
+      undefined,
+      "an undownloaded package is unknown, not empty",
+    );
+
+    // A new top-level component folder changes the package root, so the cached answer is replaced.
+    await mkdir(join(pluginRoot, "commands"));
+    await writeFile(join(pluginRoot, "commands", "outline.md"), "---\ndescription: Outline\n---\nBody\n");
+    assert.deepEqual(
+      inferLocalMarketplacePluginComponentKinds({ entry: entry("writer"), marketplace: "local-market", storageRoot }),
+      ["command", "skill"],
+    );
+  } finally {
+    await rm(storageRoot, { recursive: true, force: true });
+  }
+});
