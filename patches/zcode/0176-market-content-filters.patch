+/** Market filters by what a package contains (OV-100), in the detail view's section order. */
+export const STORE_CONTENT_KINDS = ["skill", "mcp", "command", "agent", "hook"] as const;
+export type StoreContentKind = (typeof STORE_CONTENT_KINDS)[number];
+
+/**
+ * What a listing contains, from the installed runtime inventory or the catalog projection. Null
+ * means unknown (a remote package not yet described); such items appear only under "All".
+ */
+export function storeItemContentKinds(item: StorePluginItem): ReadonlySet<string> | null {
+  const kinds = new Set<string>();
+  let known = false;
+  if (item.info?.components) {
+    known = true;
