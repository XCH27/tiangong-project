+const localComponentKindsCache = new Map<string, { stamp: string; kinds: string[] }>();
+
+/**
+ * Component kinds of a catalog entry whose package is already on disk (bundled, a folder inside the
+ * cloned marketplace, or a local directory), for browsing filters. Remote sources return undefined:
+ * their contents are unknown until described or installed, which is not the same as "none".
+ */
+export function inferLocalMarketplacePluginComponentKinds(input: {
+  entry: PluginMarketplaceEntry;
+  manifest?: PluginMarketplaceManifest | null;
+  marketplace: string;
+  storageRoot: string;
+}): string[] | undefined {
+  const rootPath = resolveLocalPluginSourceRootSync(input);
+  if (!rootPath) return undefined;
+  const manifestPath = getMarketplaceManifestPath(input.storageRoot, input.marketplace);
+  let stamp: string;
+  try {
+    stamp = `${statSync(rootPath).mtimeMs}:${existsSync(manifestPath) ? statSync(manifestPath).mtimeMs : 0}`;
+  } catch {
+    return undefined;
+  }
+  const cached = localComponentKindsCache.get(rootPath);
+  if (cached?.stamp === stamp) return cached.kinds;
+  const read = readComponentsAtRoot({
+    diagnostics: [],
+    entry: input.entry,
+    marketplace: input.marketplace,
+    rootPath,
+  });
+  const kinds = read.components.filter((group) => group.items.length > 0).map((group) => group.kind);
+  localComponentKindsCache.set(rootPath, { stamp, kinds });
+  return kinds;
+}
+
+/** The on-disk branches of resolvePluginSourceRoot; never clones or downloads. */
+function resolveLocalPluginSourceRootSync(input: {
+  entry: PluginMarketplaceEntry;
+  manifest?: PluginMarketplaceManifest | null;
+  marketplace: string;
+  storageRoot: string;
+}): string | null {
+  const source = input.entry.source;
+  if (source === "filesystem" || source === "sea") {
+    const cachePath = input.entry.cachePath;
+    if (cachePath && directoryExists(cachePath)) return cachePath;
+    const computed = getPluginCacheDir(
+      input.storageRoot,
+      input.marketplace,
+      input.entry.name,
+      input.entry.version ?? DEFAULT_VERSION,
+    );
+    return directoryExists(computed) ? computed : null;
+  }
+  if (typeof source === "string") {
+    const marketplaceDir = dirname(getMarketplaceManifestPath(input.storageRoot, input.marketplace));
+    const manifest =
+      input.manifest ?? loadMarketplaceManifestSync(input.storageRoot, input.marketplace);
+    const local = resolveInside(
+      resolveMarketplacePluginBaseDir(marketplaceDir, manifest),
+      source.replace(/^\.\//, ""),
+    );
+    return local && directoryExists(local) ? local : null;
+  }
+  if (isRecord(source) && source.source === "directory" && typeof source.path === "string") {
+    const path = resolve(source.path);
+    return directoryExists(path) ? path : null;
+  }
+  return null;
+}
