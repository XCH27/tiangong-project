+import assert from "node:assert/strict";
+import test from "node:test";
+import { queueItemSchema } from "@zcode/shared/zcode-protocol-v4";
+import { inputIntentMetadataFromQueueItem } from "../src/zcode-protocol-v4/commands/input-intent.js";
+
+test("queued image input keeps its chosen vision backend when promoted", () => {
+  const item = queueItemSchema.parse({
+    sourceCommandId: "command-1",
+    queueItemId: "queue-1",
+    clientId: "desktop",
+    kind: "sendText",
+    text: "Describe this",
+    attachments: [{ ref: "artifact:fixture", fileName: "fixture.png", mime: "image/png", bytes: 68 }],
+    modelSelection: { providerId: "text-account", modelId: "text-model" },
+    visionModelSelection: { providerId: "vision-account", modelId: "vision-model", options: { reasoningLevel: "low" } },
+    delivery: { requested: "queue", admitted: "queue" },
+    order: { admissionSeq: 2, queuePosition: 0 },
+    steer: { state: "notRequested" },
+    dispatch: { state: "queued" },
+    admittedAt: Date.now(),
+  });
+  const promoted = inputIntentMetadataFromQueueItem(item, item.text);
+  assert.deepEqual(promoted.visionModelSelection, item.visionModelSelection);
+  assert.deepEqual(promoted.modelSelection, item.modelSelection);
+  assert.equal(promoted.attachmentRefs?.[0]?.mime, "image/png");
+});
