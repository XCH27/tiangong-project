diff --git a/apps/zcode-cli/packages/core/test/vision-bridge.test.ts b/apps/zcode-cli/packages/core/test/vision-bridge.test.ts
new file mode 100644
index 0000000..3fabc46
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/vision-bridge.test.ts
@@ -0,0 +1,201 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { MessageWithParts } from "@zcode/contracts";
+import { MessageHistoryImpl } from "../src/agent/message-history.js";
+import { hydrateMessageHistoryFromSession } from "../src/agent/session-history-hydrator.js";
+import {
+  bridgeImageAttachmentText,
+  projectVisionBridgeAttachments,
+  type VisionBridgeImageResult,
+} from "../src/agent/vision-bridge.js";
+import type { ResolvedTurnAttachment } from "../src/runtime/types.js";
+import { applyTurnVisionBridge, describeTurnImages } from "../src/runtime/methods/vision-bridge.js";
+import type { AgentRuntimeInternal } from "../src/runtime/internal.js";
+
+const image = {
+  contentBlock: {
+    type: "image",
+    dataUrl: "data:image/png;base64,aGVsbG8=",
+    mediaType: "image/png",
+  },
+  filename: "sample.png",
+  metadata: { sha256: "image-digest", storageKind: "inline" },
+  mime: "image/png",
+  url: "data:image/png;base64,aGVsbG8=",
+} as ResolvedTurnAttachment;
+
+const described: VisionBridgeImageResult = {
+  attachmentIndex: 0,
+  digest: "image-digest",
+  providerId: "vision-provider",
+  modelId: "vision-model",
+  status: "described",
+  description: "A red ball on a table.",
+};
+
+test("a bridge substitutes only the model-visible image and marks the description untrusted", () => {
+  const original = [image];
+  const projected = projectVisionBridgeAttachments(original, [described]);
+  assert.equal(original[0]?.contentBlock.type, "image");
+  assert.equal(projected[0]?.contentBlock.type, "text");
+  assert.match(bridgeImageAttachmentText(described), /A red ball on a table/);
+  assert.match(bridgeImageAttachmentText(described), /untrusted/);
+  assert.match(bridgeImageAttachmentText(described), /image-digest/);
+});
+
+test("a failed description states that image content is unavailable", () => {
+  const unavailable = bridgeImageAttachmentText({
+    ...described,
+    status: "unavailable",
+    description: undefined,
+  });
+  assert.match(unavailable, /unavailable/);
+  assert.doesNotMatch(unavailable, /red ball/);
+});
+
+test("image description uses the frozen backend and preserves attachment order", async () => {
+  const calls: string[] = [];
+  const results = await describeTurnImages({
+    attachments: [image, { ...image, metadata: { sha256: "second-digest" } }],
+    modelSelection: { providerId: "vision-provider", modelId: "vision-model" },
+    signal: new AbortController().signal,
+    generate: async ({ attachment, modelSelection }) => {
+      calls.push(`${modelSelection.providerId}/${modelSelection.modelId}:${attachment.metadata.sha256}`);
+      return "A test image.";
+    },
+  });
+  assert.deepEqual(calls, [
+    "vision-provider/vision-model:image-digest",
+    "vision-provider/vision-model:second-digest",
+  ]);
+  assert.deepEqual(results.map((result) => result.attachmentIndex), [0, 1]);
+  assert.ok(results.every((result) => result.status === "described"));
+});
+
+test("backend failure is explicit while turn cancellation stops the bridge", async () => {
+  const selection = { providerId: "vision-provider", modelId: "vision-model" };
+  const failed = await describeTurnImages({
+    attachments: [image],
+    modelSelection: selection,
+    signal: new AbortController().signal,
+    generate: async () => { throw new Error("credential expired"); },
+  });
+  assert.equal(failed[0]?.status, "unavailable");
+  assert.equal(failed[0]?.description, undefined);
+
+  const controller = new AbortController();
+  controller.abort(new Error("user stopped"));
+  await assert.rejects(
+    describeTurnImages({
+      attachments: [image],
+      modelSelection: selection,
+      signal: controller.signal,
+      generate: async () => "must not run",
+    }),
+    /user stopped/,
+  );
+});
+
+test("the Session auxiliary path sends pixels only to the chosen vision model and records a redacted event", async () => {
+  const requests: unknown[] = [];
+  const events: Array<{ payload: unknown }> = [];
+  const warnings: unknown[] = [];
+  const model = {
+    providerId: "vision-provider",
+    modelId: "vision-model",
+    displayName: "Vision model",
+    properties: { inputFormat: { supportsImage: true } },
+    optionSpecs: { reasoningLevel: { values: ["low"] }, maxOutputTokens: { max: 1024 } },
+    options: { reasoningLevel: "low", speedMode: "standard" },
+    bind(options: Record<string, unknown>) {
+      return { ...this, options: { ...this.options, ...options } };
+    },
+    async generateText(request: unknown) {
+      requests.push(request);
+      return { text: "A blue square.", finishReason: "stop", usage: { inputTokens: 10, outputTokens: 5 } };
+    },
+  };
+  const runtime = {
+    sessionId: "session-1",
+    config: { taskType: "interactive" },
+    rootTraceContext: { traceId: "trace-1", sessionId: "session-1", turnId: "turn-1" },
+    modelFactory: () => model,
+    createEvent: (_type: unknown, payload: unknown) => ({ type: _type, payload, timestamp: new Date() }),
+    appendEvent: async (event: { payload: unknown }) => { events.push(event); },
+    createModelStatusSink: () => ({ publish: async () => {} }),
+    extractToolCallsFromResult: () => [],
+    logger: { warn: (_message: string, details: unknown) => { warnings.push(details); } },
+    agentTelemetry: { detached: () => ({
+      run: async (fn: () => Promise<unknown>) => fn(),
+      setResultType: () => {},
+      finishCompleted: () => {},
+      finishFailed: () => {},
+      finishCancelled: () => {},
+    }) },
+  } as unknown as AgentRuntimeInternal;
+  const result = await applyTurnVisionBridge({
+    runtime,
+    attachments: [image],
+    modelSelection: { providerId: "vision-provider", modelId: "vision-model", options: { reasoningLevel: "low" } },
+    prompt: "What color is the square?",
+    signal: new AbortController().signal,
+    traceContext: runtime.rootTraceContext,
+  });
+  assert.equal(result.modelAttachments[0]?.contentBlock.type, "text");
+  assert.equal(requests.length, 1, JSON.stringify(warnings));
+  assert.equal(result.evidence?.images[0]?.description, "A blue square.", JSON.stringify(warnings));
+  assert.match(JSON.stringify(requests[0]), /data:image\/png/);
+  assert.match(JSON.stringify(requests[0]), /What color is the square/);
+  assert.equal(JSON.stringify(events).includes("data:image/png"), false);
+  assert.match(JSON.stringify(events), /vision_bridge/);
+});
+
+test("cold hydration restores the derived text, never the original pixels", async () => {
+  const history = new MessageHistoryImpl();
+  const message = {
+    info: {
+      id: "message-1",
+      role: "user",
+      source: "real_user",
+      metadata: {
+        inputIntent: { visionModelSelection: { providerId: "vision-provider", modelId: "vision-model" } },
+        visionBridge: { version: 1, images: [described] },
+      },
+    },
+    parts: [
+      { id: "part-1", type: "text", text: "What is in this image?" },
+      { id: "part-2", type: "file", mime: "image/png", filename: "sample.png", url: image.url, metadata: image.metadata },
+    ],
+  } as unknown as MessageWithParts;
+  await hydrateMessageHistoryFromSession({ history, messages: [message] });
+  const content = history.borrowReadOnlyRuntimeEntries()[0];
+  assert.equal(content?.kind, undefined);
+  assert.equal(content?.message.role, "user");
+  assert.equal(Array.isArray(content?.message.content), true);
+  const blocks = content?.message.content;
+  assert.equal(Array.isArray(blocks) && blocks.some((block) => block.type === "image"), false);
+  assert.match(JSON.stringify(blocks), /A red ball on a table/);
+  assert.equal(message.parts[1]?.type, "file");
+});
+
+test("cold hydration fails closed when the bridge result is absent", async () => {
+  const history = new MessageHistoryImpl();
+  const message = {
+    info: {
+      id: "message-2",
+      role: "user",
+      source: "real_user",
+      metadata: {
+        inputIntent: { visionModelSelection: { providerId: "vision-provider", modelId: "vision-model" } },
+      },
+    },
+    parts: [
+      { id: "part-3", type: "text", text: "Describe this" },
+      { id: "part-4", type: "file", mime: "image/png", filename: "sample.png", url: image.url, metadata: image.metadata },
+    ],
+  } as unknown as MessageWithParts;
+  await hydrateMessageHistoryFromSession({ history, messages: [message] });
+  const entries = history.borrowReadOnlyRuntimeEntries();
+  assert.doesNotMatch(JSON.stringify(entries), /data:image\/png/);
+  assert.match(JSON.stringify(entries), /unavailable/);
+});
