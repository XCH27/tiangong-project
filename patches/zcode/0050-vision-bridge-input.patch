diff --git a/packages/ui/src/v4/VisionBridgeAttachmentChoice.tsx b/packages/ui/src/v4/VisionBridgeAttachmentChoice.tsx
new file mode 100644
index 0000000..640675b
--- /dev/null
+++ b/packages/ui/src/v4/VisionBridgeAttachmentChoice.tsx
@@ -0,0 +1,85 @@
+import { InfoIcon, XIcon } from "lucide-react";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { Button } from "@/components/ui/button.js";
+import {
+  Select,
+  SelectContent,
+  SelectGroup,
+  SelectItem,
+  SelectLabel,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { VisionBridgeChoice } from "./visionBridgeSelection.js";
+
+export function VisionBridgeAttachmentChoice({
+  choice,
+  selectedKey,
+  onSelect,
+}: {
+  choice: VisionBridgeChoice;
+  selectedKey?: string;
+  onSelect(key: string | undefined): void;
+}) {
+  const { intl } = useZCodeIntl();
+  if (choice.mode === "none") return null;
+  const selected = choice.candidates.find((candidate) => candidate.key === selectedKey);
+  const groups = Map.groupBy(choice.candidates, (candidate) => candidate.providerLabel);
+  const label = intl.formatMessage({ id: "chat.visionBridge.title" });
+  return (
+    <div
+      className="flex max-w-full flex-wrap items-center gap-1.5 rounded-md bg-surface px-2 py-1 text-ui-sm text-foreground-subtle"
+      data-testid="vision-bridge-choice"
+    >
+      <ControlHintTooltip
+        title={label}
+        description={intl.formatMessage({ id: "chat.visionBridge.costHint" })}
+      >
+        <span className="inline-flex items-center gap-1 whitespace-nowrap">
+          {label}
+          <InfoIcon className="size-3" />
+        </span>
+      </ControlHintTooltip>
+      {choice.candidates.length > 0 ? (
+        <>
+          <Select value={selected?.key} onValueChange={onSelect}>
+            <SelectTrigger
+              variant="ghost"
+              size="sm"
+              className="max-w-56 min-w-0 text-foreground"
+              aria-label={intl.formatMessage({ id: "chat.visionBridge.select" })}
+            >
+              <SelectValue placeholder={intl.formatMessage({ id: "chat.visionBridge.select" })} />
+            </SelectTrigger>
+            <SelectContent>
+              {[...groups].map(([providerLabel, candidates]) => (
+                <SelectGroup key={providerLabel}>
+                  <SelectLabel>{providerLabel}</SelectLabel>
+                  {candidates.map((candidate) => (
+                    <SelectItem key={candidate.key} value={candidate.key}>
+                      {candidate.selection.modelId}
+                    </SelectItem>
+                  ))}
+                </SelectGroup>
+              ))}
+            </SelectContent>
+          </Select>
+          {choice.mode === "optional" && selected ? (
+            <Button
+              type="button"
+              variant="ghost"
+              size="icon-xs"
+              aria-label={intl.formatMessage({ id: "chat.visionBridge.clear" })}
+              onClick={() => onSelect(undefined)}
+            >
+              <XIcon className="size-3" />
+            </Button>
+          ) : null}
+        </>
+      ) : (
+        <span role="status">{intl.formatMessage({ id: "chat.visionBridge.noBackend" })}</span>
+      )}
+    </div>
+  );
+}
diff --git a/packages/ui/src/v4/visionBridgeSelection.ts b/packages/ui/src/v4/visionBridgeSelection.ts
new file mode 100644
index 0000000..d67ab5a
--- /dev/null
+++ b/packages/ui/src/v4/visionBridgeSelection.ts
@@ -0,0 +1,57 @@
+import { completeNewModelSelection } from "@zcode/provider";
+import type { ModelSelection } from "@zcode/shared";
+import type { ModelSelectionView } from "@zcode/services";
+
+export interface VisionBridgeCandidate {
+  key: string;
+  providerLabel: string;
+  selection: ModelSelection;
+}
+
+export interface VisionBridgeChoice {
+  mode: "none" | "required" | "optional";
+  candidates: VisionBridgeCandidate[];
+}
+
+/** The Host's sourced catalog, not a model-name guess, controls the paid image adapter. */
+export function resolveVisionBridgeChoice(
+  view: ModelSelectionView | null,
+  main: ModelSelection | undefined,
+  attachmentMimes: readonly string[],
+): VisionBridgeChoice {
+  if (!attachmentMimes.some((mime) => mime.startsWith("image/"))) {
+    return { mode: "none", candidates: [] };
+  }
+  const mainModel = view?.providers
+    .find((provider) => provider.providerId === main?.providerId)
+    ?.models.find((model) => model.modelId === main?.modelId);
+  const mainImageEvidence = (mainModel?.evidenceConfig ?? mainModel?.config)?.properties
+    ?.inputFormat?.supportsImage;
+  if (mainImageEvidence === true) {
+    return { mode: "none", candidates: [] };
+  }
+  const candidates =
+    view?.providers.flatMap((provider) =>
+      provider.models.flatMap((model) => {
+        const imageEvidence = (model.evidenceConfig ?? model.config).properties?.inputFormat
+          ?.supportsImage;
+        if (imageEvidence !== true) return [];
+        const selection = completeNewModelSelection(view, {
+          providerId: provider.providerId,
+          modelId: model.modelId,
+        });
+        if (!selection) return [];
+        return [
+          {
+            key: JSON.stringify([selection.providerId, selection.modelId]),
+            providerLabel: provider.providerName?.trim() || provider.providerId,
+            selection,
+          },
+        ];
+      }),
+    ) ?? [];
+  return {
+    mode: mainImageEvidence === false ? "required" : "optional",
+    candidates,
+  };
+}
