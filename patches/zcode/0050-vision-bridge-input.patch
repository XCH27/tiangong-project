diff --git a/packages/ui/test/visionBridgeSelection.test.ts b/packages/ui/test/visionBridgeSelection.test.ts
new file mode 100644
index 0000000..452d515
--- /dev/null
+++ b/packages/ui/test/visionBridgeSelection.test.ts
@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ModelSelectionView } from "@zcode/services";
+import { resolveVisionBridgeChoice } from "../src/v4/visionBridgeSelection.js";
+
+const view = {
+  revision: 1,
+  providers: [
+    {
+      providerId: "text-account",
+      providerName: "Text account",
+      models: [
+        {
+          modelId: "text-model",
+          config: { optionSpecs: { reasoningLevel: { values: ["auto"] } } },
+          evidenceConfig: { properties: { inputFormat: { supportsImage: false } } },
+        },
+      ],
+    },
+    {
+      providerId: "vision-account",
+      providerName: "Vision account",
+      models: [
+        {
+          modelId: "vision-model",
+          config: { optionSpecs: { reasoningLevel: { values: ["auto"] } } },
+          evidenceConfig: { properties: { inputFormat: { supportsImage: true } } },
+        },
+      ],
+    },
+  ],
+} as unknown as ModelSelectionView;
+
+test("a confirmed text-only model with an image requires an explicit eligible backend", () => {
+  const result = resolveVisionBridgeChoice(
+    view,
+    {
+      providerId: "text-account",
+      modelId: "text-model",
+    },
+    ["image/png"],
+  );
+  assert.equal(result.mode, "required");
+  assert.deepEqual(
+    result.candidates.map((item) => item.selection.providerId),
+    ["vision-account"],
+  );
+  assert.equal(result.candidates[0]?.selection.options?.reasoningLevel, "auto");
+});
+
+test("a model with native vision does not add a paid bridge", () => {
+  const result = resolveVisionBridgeChoice(
+    view,
+    {
+      providerId: "vision-account",
+      modelId: "vision-model",
+    },
+    ["image/png"],
+  );
+  assert.equal(result.mode, "none");
+});
+
+test("a video or unknown main model cannot silently trigger a bridge", () => {
+  assert.equal(
+    resolveVisionBridgeChoice(
+      view,
+      {
+        providerId: "text-account",
+        modelId: "text-model",
+      },
+      ["video/mp4"],
+    ).mode,
+    "none",
+  );
+  assert.equal(
+    resolveVisionBridgeChoice(
+      view,
+      {
+        providerId: "missing",
+        modelId: "unknown",
+      },
+      ["image/png"],
+    ).mode,
+    "optional",
+  );
+});
