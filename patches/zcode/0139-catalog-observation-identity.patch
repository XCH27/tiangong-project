diff --git a/packages/services/test/catalog-fact-lifecycle.test.ts b/packages/services/test/catalog-fact-lifecycle.test.ts
new file mode 100644
index 0000000..f4b6f1e
--- /dev/null
+++ b/packages/services/test/catalog-fact-lifecycle.test.ts
@@ -0,0 +1,186 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../src/model-provider/providerRuntime.js";
+
+const SOURCE_ID = "vendor/source-only";
+const MANUAL_ID = "vendor/not-listed";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-catalog-facts-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let unavailable = false;
+  const create = () =>
+    new ProviderRuntime({
+      configRuntime: createProviderConfigRuntime(options),
+      fetch: async () =>
+        unavailable
+          ? new Response(null, { status: 503 })
+          : Response.json({
+              data: [
+                {
+                  id: SOURCE_ID,
+                  context_length: 65536,
+                  max_output_tokens: 4096,
+                  architecture: { input_modalities: ["text"], output_modalities: ["text"] },
+                  supported_parameters: ["tools", "structured_outputs"],
+                },
+              ],
+            }),
+    });
+  let runtime = create();
+  await runtime.start();
+  const add = async () =>
+    runtime.providerSettings.createPersonalProvider({
+      templateId: "openrouter",
+      initialConfig: { access: { type: "api-key", apiKey: "synthetic" } },
+    });
+  const { providerId } = await add();
+  await runtime.providerSettings.discoverModels(providerId);
+  return {
+    providerId,
+    add,
+    get runtime() {
+      return runtime;
+    },
+    get service() {
+      return runtime.providerSettings;
+    },
+    model: async (id: string, provider = providerId) =>
+      (await runtime.providerSettings.getView()).providers
+        .find((row) => row.providerId === provider)!
+        .models.find((row) => row.modelId === id)!,
+    failRefresh() {
+      unavailable = true;
+    },
+    async reopen() {
+      runtime.dispose();
+      runtime = create();
+      await runtime.start();
+    },
+    async close() {
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+for (const edit of ["rename", "draft"] as const) {
+  test(`${edit} does not claim old provider facts for a new model ID through failed refresh/reopen`, async () => {
+    const f = await fixture();
+    try {
+      assert.equal((await f.model(SOURCE_ID)).contextEvidenceSource, "provider");
+      if (edit === "rename")
+        await f.service.renamePersonalModel(f.providerId, SOURCE_ID, MANUAL_ID);
+      else
+        await f.service.savePersonalModelDraft({
+          providerId: f.providerId,
+          originalModelId: SOURCE_ID,
+          nextModelId: MANUAL_ID,
+          personalConfig: {},
+          useRecommendedConfig: true,
+          basedOnRevision: (await f.service.getView()).revision,
+        });
+      const inspect = async () => {
+        const model = await f.model(MANUAL_ID);
+        assert.ok(model);
+        assert.notEqual(model.contextEvidenceSource, "provider");
+        assert.equal(model.evidenceConfig.properties?.contextWindow, undefined);
+        assert.equal(model.evidenceConfig.properties?.supportsToolCall, undefined);
+        assert.equal(model.evidenceConfig.optionSpecs?.maxOutputTokens?.max, undefined);
+      };
+      await inspect();
+      f.failRefresh();
+      await assert.rejects(f.service.discoverModels(f.providerId));
+      await inspect();
+      await f.reopen();
+      await inspect();
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("model draft preview keeps personal correction and omits unrelated provider observation", async () => {
+  const f = await fixture();
+  try {
+    const preview = await f.service.resolveModelConfig({
+      providerId: f.providerId,
+      originalModelId: SOURCE_ID,
+      modelId: MANUAL_ID,
+      personalConfig: { properties: { contextWindow: 32000 } },
+    });
+    assert.equal(preview.effectiveConfig.properties?.contextWindow, 32000);
+    assert.equal(preview.evidenceConfig.optionSpecs?.maxOutputTokens?.max, undefined);
+    assert.equal((await f.model(SOURCE_ID)).contextEvidenceSource, "provider");
+  } finally {
+    await f.close();
+  }
+});
+
+test("actual connection deletion clears observations before same-ID recreation, preserving another connection", async () => {
+  const f = await fixture();
+  try {
+    const other = await f.add();
+    await f.service.discoverModels(other.providerId);
+    await f.service.deletePersonalProvider(f.providerId);
+    const restored = await f.add();
+    assert.equal(restored.providerId, f.providerId);
+    await f.service.addPersonalModel(restored.providerId, SOURCE_ID, {});
+    const check = async () => {
+      const model = await f.model(SOURCE_ID, restored.providerId);
+      assert.equal(model.evidenceConfig.properties?.contextWindow, undefined);
+      assert.notEqual(model.contextEvidenceSource, "provider");
+      assert.equal(
+        (await f.model(SOURCE_ID, other.providerId)).evidenceConfig.properties?.contextWindow,
+        65536,
+      );
+    };
+    await check();
+    await f.reopen();
+    await check();
+  } finally {
+    await f.close();
+  }
+});
+
+test("renamed explicit personal corrections survive; restore keeps exact returned observations", async () => {
+  const f = await fixture();
+  try {
+    await f.service.savePersonalModelDraft({
+      providerId: f.providerId,
+      originalModelId: SOURCE_ID,
+      nextModelId: SOURCE_ID,
+      personalConfig: { properties: { contextWindow: 32000 } },
+      useRecommendedConfig: true,
+      basedOnRevision: (await f.service.getView()).revision,
+    });
+    await f.service.renamePersonalModel(f.providerId, SOURCE_ID, MANUAL_ID);
+    assert.equal((await f.model(MANUAL_ID)).personalExactConfig?.properties?.contextWindow, 32000);
+    await f.service.addPersonalModel(f.providerId, SOURCE_ID, {});
+    await f.service.savePersonalModelDraft({
+      providerId: f.providerId,
+      originalModelId: SOURCE_ID,
+      nextModelId: SOURCE_ID,
+      personalConfig: {},
+      useRecommendedConfig: true,
+      basedOnRevision: (await f.service.getView()).revision,
+    });
+    await f.reopen();
+    assert.equal((await f.model(SOURCE_ID)).evidenceConfig.properties?.contextWindow, 65536);
+    assert.equal((await f.model(MANUAL_ID)).personalExactConfig?.properties?.contextWindow, 32000);
+  } finally {
+    await f.close();
+  }
+});
