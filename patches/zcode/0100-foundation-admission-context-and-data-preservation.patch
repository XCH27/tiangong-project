@@ -0,0 +1,347 @@
+import assert from "node:assert/strict";
+import fs, { existsSync } from "node:fs";
+import { mkdir, mkdtemp, readFile, readdir, rm, symlink, writeFile } from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import os from "node:os";
+import { dirname, join } from "node:path";
+import test, { type TestContext } from "node:test";
+import { getPluginDataDir, listInstalledPluginRecords } from "@zcode/adapters/plugins";
+import { NodeCustomCommandAdapter } from "@zcode/adapters/commands";
+import {
+  addZCodePluginMarketplace,
+  installZCodeMarketplacePlugin,
+  resolveZCodePlugins,
+  uninstallZCodeMarketplacePlugin,
+  updateZCodePluginMarketplace,
+} from "../src/plugins.js";
+import { restoreBuiltinPlugin, uninstallPlugin } from "../src/zcode-protocol/plugins.js";
+import type { ZCodeProtocolAgentServerContext } from "../src/zcode-protocol/server-types.js";
+
+const context = {
+  logger: { info() {}, warn() {}, error() {}, debug() {} },
+} as ZCodeProtocolAgentServerContext;
+const name = "retention-fixture";
+const marketplace = "retention-test";
+const pluginId = `${name}@${marketplace}`;
+
+async function fixture(t: TestContext) {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-plugin-retention-"));
+  const configPath = join(root, ".zcode/cli/config.json");
+  const storage = join(root, "storage");
+  const pluginStorage = join(storage, "cli/plugins");
+  const workingDirectory = join(root, "workspace");
+  const source = join(root, "marketplace");
+  const dataFile = join(getPluginDataDir(pluginStorage, pluginId), "user-document.txt");
+  // Protocol handlers use the normal config resolver. Isolate its native home
+  // lookup without changing HOME or touching a real installed plugin/profile.
+  const home = t.mock.method(os, "homedir", () => root);
+  syncBuiltinESMExports();
+  const previousStorage = process.env.ZCODE_STORAGE_DIR;
+  process.env.ZCODE_STORAGE_DIR = storage;
+  t.after(async () => {
+    home.mock.restore();
+    syncBuiltinESMExports();
+    if (previousStorage === undefined) delete process.env.ZCODE_STORAGE_DIR;
+    else process.env.ZCODE_STORAGE_DIR = previousStorage;
+    await rm(root, { recursive: true, force: true });
+  });
+  for (const dir of [
+    dirname(configPath),
+    workingDirectory,
+    join(source, ".claude-plugin"),
+    join(source, name, ".zcode-plugin"),
+    join(source, name, "skills/fixture"),
+  ]) {
+    await mkdir(dir, { recursive: true });
+  }
+  await writeFile(configPath, JSON.stringify({ storage: { dir: storage } }));
+  await writeFile(
+    join(source, ".claude-plugin/marketplace.json"),
+    JSON.stringify({
+      name: marketplace,
+      plugins: [{ name, source: `./${name}`, version: "1.0.0" }],
+    }),
+  );
+  await writeFile(
+    join(source, name, ".zcode-plugin/plugin.json"),
+    JSON.stringify({
+      name,
+      version: "1.0.0",
+      skills: "./skills",
+    }),
+  );
+  await writeFile(
+    join(source, name, "skills/fixture/SKILL.md"),
+    "---\nname: retention-fixture\ndescription: Local retention fixture\n---\nRead local documents.",
+  );
+  await addZCodePluginMarketplace({ source, workingDirectory });
+  const install = async () => {
+    const result = await installZCodeMarketplacePlugin({
+      pluginName: name,
+      marketplace,
+      workingDirectory,
+    });
+    assert.equal(
+      result.diagnostics.filter((item) => item.severity === "error").length,
+      0,
+      JSON.stringify(result.diagnostics),
+    );
+    const record = result.installedPlugins.find((item) => item.id === pluginId);
+    assert.ok(record?.installPath);
+    return record.installPath;
+  };
+  const readConfig = async () => JSON.parse(await readFile(configPath, "utf8"));
+  const writeData = async (id = pluginId) => {
+    const file = join(getPluginDataDir(pluginStorage, id), "user-document.txt");
+    await mkdir(dirname(file), { recursive: true });
+    await writeFile(file, "User artifact, not installation cache.");
+    return file;
+  };
+  return {
+    configPath,
+    dataFile,
+    install,
+    pluginStorage,
+    readConfig,
+    root,
+    source,
+    workingDirectory,
+    writeData,
+    workspace: { workspacePath: workingDirectory, workspaceKey: workingDirectory },
+  };
+}
+
+async function changeCommands(
+  f: Awaited<ReturnType<typeof fixture>>,
+  version: string,
+  commands: Record<string, { content: string }>,
+) {
+  await writeFile(
+    join(f.source, ".claude-plugin/marketplace.json"),
+    JSON.stringify({
+      name: marketplace,
+      plugins: [{ name, source: `./${name}`, version }],
+    }),
+  );
+  await writeFile(
+    join(f.source, name, ".zcode-plugin/plugin.json"),
+    JSON.stringify({
+      name,
+      version,
+      commands,
+    }),
+  );
+  await updateZCodePluginMarketplace({ marketplace, workingDirectory: f.workingDirectory });
+}
+
+async function commandNames(f: Awaited<ReturnType<typeof fixture>>) {
+  const outcome = resolveZCodePlugins({ workingDirectory: f.workingDirectory });
+  const roots = outcome.commandRoots.filter((root) => root.plugin?.id === pluginId);
+  const commands = await new NodeCustomCommandAdapter().discoverCommands({
+    roots,
+    workingDirectory: f.workingDirectory,
+  });
+  return commands.commands.map((command) => command.name);
+}
+
+test("desktop uninstall removes activation and cache but keeps data through reinstallation", async (t) => {
+  const f = await fixture(t);
+  const installPath = await f.install();
+  await f.writeData();
+  const config = await f.readConfig();
+  config.plugins.options = { [pluginId]: { preference: "old" }, unrelated: { preference: "keep" } };
+  await writeFile(f.configPath, JSON.stringify(config));
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.find(
+      (item) => item.id === pluginId,
+    )?.enabled,
+    true,
+  );
+
+  const result = await uninstallPlugin(context, {
+    workspace: f.workspace,
+    pluginId,
+    removeCache: true,
+  });
+  assert.equal(result.removedPlugin?.id, pluginId);
+  assert.equal(existsSync(installPath), false);
+  assert.equal(
+    listInstalledPluginRecords(f.pluginStorage).some((item) => item.id === pluginId),
+    false,
+  );
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.some(
+      (item) => item.id === pluginId,
+    ),
+    false,
+  );
+  const after = await f.readConfig();
+  assert.equal(after.plugins.enabledPlugins?.[pluginId], undefined);
+  assert.equal(after.plugins.options?.[pluginId], undefined);
+  assert.deepEqual(after.plugins.options.unrelated, { preference: "keep" });
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+
+  assert.ok(existsSync(await f.install()));
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.find(
+      (item) => item.id === pluginId,
+    )?.enabled,
+    true,
+  );
+});
+
+test("desktop cache-retention option does not retain plugin activation", async (t) => {
+  const f = await fixture(t);
+  const installPath = await f.install();
+  await f.writeData();
+  await uninstallPlugin(context, { workspace: f.workspace, pluginId, removeCache: false });
+  assert.equal(existsSync(installPath), true);
+  assert.equal(existsSync(f.dataFile), true);
+  assert.equal(
+    listInstalledPluginRecords(f.pluginStorage).some((item) => item.id === pluginId),
+    false,
+  );
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.some(
+      (item) => item.id === pluginId,
+    ),
+    false,
+  );
+});
+
+test("desktop built-in suppression preserves its immutable package and user data for restore", async (t) => {
+  const f = await fixture(t);
+  const builtin = resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.find(
+    (item) => item.name === "zcode-guide" && item.source === "official",
+  );
+  assert.ok(builtin, "the actual bundled guide must be available for the lifecycle proof");
+  const dataFile = await f.writeData(builtin.id);
+  await uninstallPlugin(context, { workspace: f.workspace, pluginId: builtin.id });
+  assert.ok((await f.readConfig()).plugins.suppressedBuiltins.includes(builtin.id));
+  assert.equal(existsSync(builtin.rootPath), true);
+  assert.equal(existsSync(dataFile), true);
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.some(
+      (item) => item.id === builtin.id,
+    ),
+    false,
+  );
+
+  await restoreBuiltinPlugin(context, { workspace: f.workspace, pluginId: builtin.id });
+  assert.equal((await f.readConfig()).plugins.suppressedBuiltins.includes(builtin.id), false);
+  assert.equal(
+    resolveZCodePlugins({ workingDirectory: f.workingDirectory }).plugins.some(
+      (item) => item.id === builtin.id,
+    ),
+    true,
+  );
+  assert.equal(await readFile(dataFile, "utf8"), "User artifact, not installation cache.");
+});
+
+test("CLI removal keeps its declared purge default and explicit keep-data option", async (t) => {
+  const f = await fixture(t);
+  await f.install();
+  await f.writeData();
+  await uninstallZCodeMarketplacePlugin({ pluginId, workingDirectory: f.workingDirectory });
+  assert.equal(existsSync(f.dataFile), false);
+  await f.install();
+  await f.writeData();
+  await uninstallZCodeMarketplacePlugin({
+    pluginId,
+    keepData: true,
+    workingDirectory: f.workingDirectory,
+  });
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+});
+
+test("reinstallation rebuilds derived commands from the new manifest without deleting user data", async (t) => {
+  const f = await fixture(t);
+  await changeCommands(f, "1.0.0", { old: { content: "Old command" } });
+  await f.install();
+  await f.writeData();
+  assert.deepEqual(await commandNames(f), ["old"]);
+  await uninstallPlugin(context, { workspace: f.workspace, pluginId, removeCache: true });
+  await changeCommands(f, "2.0.0", { replacement: { content: "Current command" } });
+  await f.install();
+  assert.deepEqual(await commandNames(f), ["replacement"]);
+  const generated = join(dirname(f.dataFile), "generated-commands");
+  assert.deepEqual(await readdir(generated), ["replacement.md"]);
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+
+  await uninstallPlugin(context, { workspace: f.workspace, pluginId });
+  await changeCommands(f, "3.0.0", {});
+  await f.install();
+  assert.deepEqual(await commandNames(f), []);
+  assert.deepEqual(await readdir(generated), []);
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+});
+
+test("derived command regeneration never follows directory or command-file symlinks", async (t) => {
+  const f = await fixture(t);
+  await changeCommands(f, "1.0.0", { current: { content: "Current command" } });
+  await f.install();
+  await f.writeData();
+  const generated = join(dirname(f.dataFile), "generated-commands");
+  const foreign = join(f.root, "foreign");
+  await mkdir(foreign);
+  const protectedFile = join(foreign, "current.md");
+  await writeFile(protectedFile, "Unrelated original");
+  await rm(generated, { recursive: true, force: true });
+  await symlink(foreign, generated, "dir");
+  const blocked = resolveZCodePlugins({ workingDirectory: f.workingDirectory });
+  assert.equal(
+    blocked.commandRoots.some((root) => root.plugin?.id === pluginId),
+    false,
+  );
+  assert.ok(
+    blocked.diagnostics.some(
+      (entry) => entry.pluginId === pluginId && entry.code === "plugin_component_path_invalid",
+    ),
+  );
+  assert.equal(await readFile(protectedFile, "utf8"), "Unrelated original");
+
+  await rm(generated);
+  await mkdir(generated);
+  await symlink(protectedFile, join(generated, "current.md"), "file");
+  assert.deepEqual(await commandNames(f), ["current"]);
+  assert.equal(await readFile(protectedFile, "utf8"), "Unrelated original");
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
+});
+
+test("failed derived command writes or activation retain the previous complete command set", async (t) => {
+  const f = await fixture(t);
+  await changeCommands(f, "1.0.0", { current: { content: "Current command" } });
+  await f.install();
+  await f.writeData();
+  assert.deepEqual(await commandNames(f), ["current"]);
+  const generated = join(dirname(f.dataFile), "generated-commands");
+  const original = await readFile(join(generated, "current.md"), "utf8");
+  for (const operation of ["writeFileSync", "renameSync"] as const) {
+    const originalMethod = fs[operation];
+    const mocked = t.mock.method(fs, operation, ((...args: unknown[]) => {
+      const path = String(args[0]);
+      if (
+        path.startsWith(join(dirname(generated), ".generated-commands-")) &&
+        path.includes("/next") &&
+        (operation === "writeFileSync" || args[1] === generated)
+      ) {
+        throw new Error(`synthetic ${operation} failure`);
+      }
+      return Reflect.apply(originalMethod, fs, args);
+    }) as never);
+    syncBuiltinESMExports();
+    try {
+      assert.throws(
+        () => resolveZCodePlugins({ workingDirectory: f.workingDirectory }),
+        /synthetic/,
+      );
+      assert.equal(await readFile(join(generated, "current.md"), "utf8"), original);
+    } finally {
+      mocked.mock.restore();
+      syncBuiltinESMExports();
+    }
+  }
+  assert.deepEqual(await commandNames(f), ["current"]);
+  assert.equal(await readFile(f.dataFile, "utf8"), "User artifact, not installation cache.");
