index 0000000000000000000000000000000000000000..367e9bc6b931b93f78ba7686c10dec15d2c8f713
--- /dev/null
+++ b/packages/services/test/native-cli-usage.test.ts
@@ -0,0 +1,274 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, writeFile, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import type { NativeCliAccessConfigObject, ProviderSettingsFacade } from "@zcode/provider";
+import { readClaudeNativeUsage } from "../../../apps/zcode-cli/packages/adapters/src/native-agent/claude-inspect.js";
+import {
+  createNativeCliUsageReader,
+  parseClaudeNativeUsage,
+} from "../src/model-provider/nativeCliUsage.js";
+import type { SubscriptionUsageResult } from "../src/model-provider/subscriptionUsage.js";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../src/model-provider/providerRuntime.js";
+
+const payload = {
+  rate_limits_available: true,
+  subscription_type: "pro",
+  rate_limits: {
+    five_hour: { utilization: 0, resets_at: "2026-10-02T23:00:00Z" },
+    seven_day: { utilization: 85.5, resets_at: null },
+    seven_day_oauth_apps: { utilization: 100, resets_at: null },
+    seven_day_opus: { utilization: null, resets_at: "2026-10-09T00:00:00Z" },
+    model_scoped: [{ display_name: "Fable", utilization: 25, resets_at: null }],
+    // Extra usage is money, not another subscription allowance or free reset.
+    extra_usage: { is_enabled: true, monthly_limit: 10000, used_credits: 1000, utilization: 10 },
+  },
+};
+
+test("native SDK plan windows preserve zero, exhausted and unknown values without adding paid extra usage", () => {
+  const result = parseClaudeNativeUsage(payload, 123);
+  assert.equal(result.status, "available");
+  if (result.status !== "available") return;
+  assert.equal(result.observedAt, 123);
+  assert.equal(result.plan, "pro");
+  assert.deepEqual(
+    result.windows.map((w) => [w.id, w.usedPercent, w.windowMinutes]),
+    [
+      ["default:five_hour", 0, 300],
+      ["default:seven_day", 85.5, 10080],
+      ["claude-apps:seven_day", 100, 10080],
+      ["Opus:seven_day", undefined, 10080],
+      ["Fable:seven_day", 25, 10080],
+    ],
+  );
+  assert.equal(result.windows[0]!.resetAt, Date.parse("2026-10-02T23:00:00Z"));
+  assert.equal(result.billing, undefined);
+  assert.equal(result.membership, undefined);
+  assert.equal(result.resetsAvailable, undefined);
+});
+
+test("unsupported, empty, malformed and duplicate SDK windows never report fabricated available capacity", () => {
+  assert.deepEqual(parseClaudeNativeUsage({ rate_limits_available: true, rate_limits: null }, 0), {
+    status: "unavailable",
+    unavailableReason: "no-provider-data",
+  });
+  assert.equal(parseClaudeNativeUsage({ rate_limits_available: false }, 0).status, "unsupported");
+  for (const invalid of [
+    null,
+    {},
+    { rate_limits_available: true, rate_limits: {} },
+    {
+      rate_limits_available: true,
+      rate_limits: { five_hour: { utilization: 101, resets_at: "bad" } },
+    },
+  ])
+    assert.equal(parseClaudeNativeUsage(invalid, 0).status, "unavailable");
+  const value = parseClaudeNativeUsage(
+    {
+      ...payload,
+      rate_limits: {
+        seven_day_opus: { utilization: 2 },
+        model_scoped: [{ display_name: "Opus", utilization: 5 }],
+      },
+    },
+    0,
+  );
+  assert.equal(value.status, "available");
+  if (value.status === "available") assert.equal(value.windows.length, 1);
+});
+
+test(
+  "real SDK control transport reads usage without a prompt, transcript scan or model call",
+  { skip: process.platform === "win32" },
+  async () => {
+    const dir = await mkdtemp(join(tmpdir(), "fleet-native-usage-wire-"));
+    const executable = join(dir, "claude-fixture.mjs");
+    const trace = join(dir, "requests.jsonl");
+    await writeFile(
+      executable,
+      `#!${process.execPath}
+import readline from 'node:readline';
+import { appendFileSync } from 'node:fs';
+const lines=readline.createInterface({input:process.stdin});
+lines.on('line',line=>{
+ const msg=JSON.parse(line); appendFileSync(process.env.FLEET_NATIVE_USAGE_TRACE,JSON.stringify(msg)+'\\n');
+ if(msg.type!=='control_request') process.exit(12);
+ const subtype=msg.request.subtype;
+ const response=subtype==='initialize'?{account:{email:'fixture@example.invalid',subscriptionType:'pro',apiProvider:'firstParty'},models:[],commands:[]}:subtype==='get_usage'?${JSON.stringify(payload)}:null;
+ if(!response) process.exit(13);
+ process.stdout.write(JSON.stringify({type:'control_response',response:{subtype:'success',request_id:msg.request_id,response}})+'\\n');
+});
+`,
+      { mode: 0o700 },
+    );
+    try {
+      const response = await readClaudeNativeUsage({
+        executable,
+        configDir: dir,
+        accountId: "fixture@example.invalid",
+        env: { FLEET_NATIVE_USAGE_TRACE: trace },
+      });
+      assert.deepEqual(response, payload);
+      const requests = (await readFile(trace, "utf8"))
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line));
+      assert.deepEqual(
+        requests.map((row) => row.request.subtype),
+        ["initialize", "get_usage"],
+      );
+      assert.equal(requests[1].request.skip_behaviors, true);
+      await writeFile(trace, "");
+      await assert.rejects(
+        readClaudeNativeUsage({
+          executable,
+          configDir: dir,
+          accountId: "other@example.invalid",
+          env: { FLEET_NATIVE_USAGE_TRACE: trace },
+        }),
+        /account changed/,
+      );
+      const mismatch = (await readFile(trace, "utf8"))
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line));
+      assert.deepEqual(
+        mismatch.map((row) => row.request.subtype),
+        ["initialize"],
+      );
+    } finally {
+      await rm(dir, { recursive: true, force: true });
+    }
+  },
+);
+
+test("native usage coalesces reads, retains dated last-good on network failure, clears on account mismatch", async () => {
+  let access: NativeCliAccessConfigObject = {
+    type: "native-cli",
+    provider: "claude",
+    connected: true,
+    accountId: "A",
+  };
+  const facade = {
+    getView: () => ({ providers: [{ providerId: "P", effectiveConfig: { access } }] }),
+  } as unknown as ProviderSettingsFacade;
+  let now = 1;
+  let calls = 0;
+  let read = () => Promise.resolve(parseClaudeNativeUsage(payload, now));
+  const reader = createNativeCliUsageReader(
+    facade,
+    {
+      inspect: async () => {
+        throw new Error("No catalog fetch");
+      },
+      login: () => {
+        throw new Error("No login");
+      },
+      usage: async () => {
+        calls++;
+        return read();
+      },
+    },
+    () => now,
+  );
+  const [first, same] = await Promise.all([reader.read("P"), reader.read("P")]);
+  assert.deepEqual(first, same);
+  assert.equal(calls, 1);
+  assert.equal(first.accountId, "A");
+  assert.equal(first.connectionRevision, reader.accounts("P")?.revision);
+  now = 100;
+  await reader.read("P");
+  assert.equal(calls, 1);
+  read = () => Promise.reject(new Error("Network unavailable"));
+  const stale = await reader.read("P", true);
+  assert.equal(stale.status, "available");
+  if (stale.status === "available") {
+    assert.equal(stale.observedAt, 1);
+    assert.equal(stale.refreshError, "unavailable");
+  }
+  read = () => Promise.reject(new Error("Native CLI account changed; reconnect this connection"));
+  assert.equal((await reader.read("P", true)).status, "auth-required");
+  const pending = Promise.withResolvers<SubscriptionUsageResult>();
+  read = () => pending.promise;
+  const old = reader.read("P", true);
+  access = { ...access, accountId: "B" };
+  pending.resolve(parseClaudeNativeUsage(payload, now));
+  assert.equal((await old).status, "unavailable");
+  const before = calls;
+  assert.equal((await reader.read("P", false, "A")).status, "auth-required");
+  assert.equal(calls, before);
+  assert.equal(reader.accounts("P")?.accounts[0]?.id, "B");
+  const currentRead = Promise.withResolvers<SubscriptionUsageResult>();
+  read = () => currentRead.promise;
+  const b = reader.read("P", true, "B");
+  const bCalls = calls;
+  await reader.read("P", false, "A");
+  const alsoB = reader.read("P", true, "B");
+  assert.equal(calls, bCalls, "Stale A viewer evicted B's pending native query");
+  currentRead.resolve(parseClaudeNativeUsage(payload, now));
+  assert.equal((await b).status, "available");
+  assert.deepEqual(await b, await alsoB);
+});
+
+test("native allowance uses the existing Provider service and survives config reopen without another account store", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-usage-registry-"));
+  let usageCalls = 0;
+  const open = () =>
+    new ProviderRuntime({
+      configRuntime: createProviderConfigRuntime({
+        personalFilePath: join(directory, "providers.json"),
+        zcodeBuiltinFilePath: fileURLToPath(
+          new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+        ),
+        watch: false,
+        personalPollingIntervalMs: false,
+      }),
+      nativeCli: {
+        inspect: async () => ({
+          accountId: "fixture@example.invalid",
+          accountName: "Fixture",
+          catalog: { source: "provider", models: [] },
+        }),
+        login: () => {
+          throw new Error("No login");
+        },
+        usage: async (access) => {
+          assert.equal(access.accountId, "fixture@example.invalid");
+          usageCalls++;
+          return parseClaudeNativeUsage(payload, Date.now());
+        },
+      },
+    });
+  let runtime = open();
+  try {
+    await runtime.start();
+    const { providerId } = await runtime.providerSettings.createPersonalProvider({
+      templateId: "fleet-claude-native",
+    });
+    await runtime.providerSettings.connectNativeCli(providerId);
+    for (let i = 0; i < 2; i++) {
+      const accounts = await runtime.providerSettings.getSubscriptionAccounts(providerId);
+      assert.equal(accounts.accounts.length, 1);
+      assert.equal(accounts.autoSwitch, false);
+      const value = await runtime.providerSettings.getSubscriptionUsage(
+        providerId,
+        false,
+        accounts.accounts[0]!.id,
+      );
+      assert.equal(value.status, "available");
+      assert.equal(value.connectionRevision, accounts.revision);
+      if (i === 0) {
+        runtime.dispose();
+        runtime = open();
+        await runtime.start();
+      }
+    }
+    assert.equal(usageCalls, 2);
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
