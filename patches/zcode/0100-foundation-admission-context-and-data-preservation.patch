new file mode 100644
index 0000000000000000000000000000000000000000..95caf98f462901ee932c27c1602f2cd4aca5c034
--- /dev/null
+++ b/packages/services/src/model-provider/nativeCliUsage.ts
@@ -0,0 +1,200 @@
+import type { NativeCliAccessConfigObject, ProviderSettingsFacade } from "@zcode/provider";
+import type { NativeCliConnectionAdapter } from "./nativeCliConnection.js";
+import type {
+  SubscriptionAccountsView,
+  SubscriptionConnectionOwner,
+} from "./subscriptionConnectionTypes.js";
+import type { SubscriptionUsageResult, SubscriptionUsageWindow } from "./subscriptionUsage.js";
+
+function object(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+/** Both UI callers use the existing service contract, whichever runtime owns authentication. */
+export function createConnectionUsageOperations(
+  facade: ProviderSettingsFacade,
+  ensureReady: () => Promise<void>,
+  native?: NativeCliConnectionAdapter,
+  subscriptions?: SubscriptionConnectionOwner,
+) {
+  const nativeUsage = createNativeCliUsageReader(facade, native);
+  return {
+    async getSubscriptionUsage(
+      id: string,
+      refresh?: boolean,
+      accountId?: string,
+    ): Promise<SubscriptionUsageResult> {
+      await ensureReady();
+      if (nativeUsage.accounts(id)) return nativeUsage.read(id, refresh, accountId);
+      return subscriptions
+        ? subscriptions.usage(id, refresh, accountId)
+        : { status: "unsupported" };
+    },
+    async getSubscriptionAccounts(id: string): Promise<SubscriptionAccountsView> {
+      await ensureReady();
+      const accounts = nativeUsage.accounts(id);
+      if (accounts) return accounts;
+      if (!subscriptions) throw new Error("Subscription login unavailable on this host");
+      return subscriptions.accounts(id);
+    },
+  };
+}
+
+/** SDK 0.3.286 get_usage percentages are 0–100; event utilization is a different contract. */
+export function parseClaudeNativeUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const body = object(payload);
+  if (body?.rate_limits_available === false) return { status: "unsupported" };
+  const limits = object(body?.rate_limits);
+  if (body?.rate_limits_available !== true || !limits)
+    return {
+      status: "unavailable",
+      ...(body?.rate_limits_available === true
+        ? { unavailableReason: "no-provider-data" as const }
+        : {}),
+    };
+  const windows: SubscriptionUsageWindow[] = [];
+  const add = (id: string, value: unknown, windowMinutes: number) => {
+    const row = object(value);
+    if (!row) return;
+    const used = row.utilization;
+    const reset = typeof row.resets_at === "string" ? Date.parse(row.resets_at) : NaN;
+    // Invalid counters never masquerade as zero; a known reset may still be useful.
+    const usedPercent =
+      typeof used === "number" && Number.isFinite(used) && used >= 0 && used <= 100
+        ? used
+        : undefined;
+    if (usedPercent === undefined && !Number.isFinite(reset)) return;
+    windows.push({
+      id,
+      windowMinutes,
+      ...(usedPercent !== undefined ? { usedPercent } : {}),
+      ...(Number.isFinite(reset) ? { resetAt: reset } : {}),
+    });
+  };
+  add("default:five_hour", limits.five_hour, 300);
+  add("default:seven_day", limits.seven_day, 10080);
+  add("claude-apps:seven_day", limits.seven_day_oauth_apps, 10080);
+  add("Opus:seven_day", limits.seven_day_opus, 10080);
+  add("Sonnet:seven_day", limits.seven_day_sonnet, 10080);
+  if (Array.isArray(limits.model_scoped))
+    for (const raw of limits.model_scoped.slice(0, 32)) {
+      const row = object(raw);
+      const label = typeof row?.display_name === "string" ? row.display_name.trim() : "";
+      if (
+        label &&
+        label.length <= 128 &&
+        !windows.some((window) => window.id === `${label}:seven_day`)
+      )
+        add(`${label}:seven_day`, row, 10080);
+    }
+  if (!windows.length) return { status: "unavailable", unavailableReason: "no-provider-data" };
+  return {
+    status: "available",
+    source: "claude-native:get_usage",
+    observedAt,
+    windows,
+    ...(typeof body.subscription_type === "string" && body.subscription_type.length <= 128
+      ? { plan: body.subscription_type }
+      : {}),
+  };
+}
+
+/** Derived cache on the existing native connection owner; no tokens, accounts or usage ledger. */
+export function createNativeCliUsageReader(
+  facade: ProviderSettingsFacade,
+  native?: NativeCliConnectionAdapter,
+  now = Date.now,
+) {
+  const cache = new Map<
+    string,
+    {
+      revision: string;
+      value?: SubscriptionUsageResult;
+      pending?: Promise<SubscriptionUsageResult>;
+    }
+  >();
+  const scope = (id: string) => {
+    const access = facade.getView().providers.find((provider) => provider.providerId === id)
+      ?.effectiveConfig.access;
+    if (access?.type !== "native-cli") return undefined;
+    return {
+      access,
+      revision: JSON.stringify([
+        access.provider,
+        access.executable,
+        access.configDir,
+        access.accountId,
+        access.connected,
+      ]),
+    };
+  };
+  return {
+    accounts(id: string): SubscriptionAccountsView | undefined {
+      const current = scope(id);
+      if (!current) return undefined;
+      const { access, revision } = current;
+      return {
+        accounts:
+          access.connected && access.accountId
+            ? [{ id: access.accountId, label: access.accountId, active: true }]
+            : [],
+        autoSwitch: false,
+        revision,
+      };
+    },
+    async read(id: string, refresh = false, accountId?: string): Promise<SubscriptionUsageResult> {
+      const current = scope(id);
+      const access = current?.access;
+      const scoped = { accountId: access?.accountId, connectionRevision: current?.revision };
+      if (!current || !access?.connected || !access.accountId) {
+        cache.delete(id);
+        return { status: "auth-required", ...scoped };
+      }
+      // A stale viewer cannot invalidate the current account's shared read.
+      if (accountId && accountId !== access.accountId)
+        return { status: "auth-required", ...scoped };
+      if (!native?.usage) return { status: "unsupported", ...scoped };
+      let entry = cache.get(id);
+      if (entry?.revision !== current.revision) {
+        entry = { revision: current.revision };
+        cache.set(id, entry);
+      }
+      if (entry.pending) return entry.pending;
+      if (!refresh && entry.value && (entry.value.refreshAfter ?? 0) > now()) return entry.value;
+      const active = entry;
+      const request = (async (): Promise<SubscriptionUsageResult> => {
+        let value: SubscriptionUsageResult;
+        try {
+          value = await native.usage!({ ...access } as NativeCliAccessConfigObject);
+        } catch (error) {
+          value = {
+            status:
+              error instanceof Error &&
+              /account changed|Sign in to the official Claude CLI/.test(error.message)
+                ? "auth-required"
+                : "unavailable",
+          };
+        }
+        if (scope(id)?.revision !== active.revision || cache.get(id) !== active)
+          return { status: "unavailable", ...scoped };
+        const result: SubscriptionUsageResult =
+          value.status === "unavailable" && active.value?.status === "available"
+            ? { ...active.value, refreshError: "unavailable", refreshAfter: now() + 60000 }
+            : { ...value, ...scoped, refreshAfter: now() + 60000 };
+        active.value = result;
+        return result;
+      })();
+      active.pending = request;
+      try {
+        return await request;
+      } finally {
+        if (active.pending === request) active.pending = undefined;
+      }
+    },
+  };
+}
