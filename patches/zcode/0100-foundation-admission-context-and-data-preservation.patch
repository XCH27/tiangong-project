+function replaceGeneratedCommands(root: string, commands: ReadonlyMap<string, string>): void {
+  mkdirSync(dirname(root), { recursive: true });
+  const stage = mkdtempSync(join(dirname(root), ".generated-commands-"));
+  const next = join(stage, "next");
+  const previous = join(stage, "previous");
+  let preservePrevious = false;
+  try {
+    mkdirSync(next);
+    for (const [fileName, markdown] of commands) {
+      writeFileSync(join(next, fileName), markdown, { encoding: "utf8", flag: "wx" });
+    }
+    const hadPrevious = lstatSync(root, { throwIfNoEntry: false }) !== undefined;
+    if (hadPrevious) renameSync(root, previous);
+    try {
+      renameSync(next, root);
+    } catch (error) {
+      if (hadPrevious) {
+        try {
+          renameSync(previous, root);
+        } catch (rollbackError) {
+          // Keep the last complete derived copy available for recovery on a failed rollback.
+          preservePrevious = true;
+          throw new AggregateError(
+            [error, rollbackError],
+            `Generated commands retained at ${previous}`,
+          );
+        }
+      }
+      throw error;
+    }
+  } finally {
+    // Only this invocation's staging directory is removed; user data is never swept.
+    if (!preservePrevious) rmSync(stage, { recursive: true, force: true });
+  }
+}
