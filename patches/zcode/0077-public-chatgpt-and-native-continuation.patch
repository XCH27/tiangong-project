@@ -0,0 +1,41 @@
+import type { OAuthAuth, OAuthCredential } from "@earendil-works/pi-ai";
+import type { SavedConnection, SubscriptionKind } from "./subscriptionConnectionTypes.js";
+import { chatgptAuthorizationState, isChatGPTPlanCredential, refreshChatGPT, subscriptionCredentialUsable } from "./chatgptAuthorization.js";
+import { saveRefreshedSubscriptionAccount, usableSubscriptionAccounts } from "./subscriptionRecords.js";
+import { withOAuthFetch } from "@earendil-works/pi-ai/utils/oauth-fetch";
+
+/** Inference and readers share refresh under their existing connection owner's lock. */
+export function createSubscriptionCredentialRefresher(options: {
+  now(): number;
+  fetch: typeof fetch;
+  validate(id: string, kind: SubscriptionKind): Promise<void>;
+  oauth(kind: SubscriptionKind, credential: OAuthCredential): OAuthAuth;
+  read(id: string, kind: SubscriptionKind): Promise<SavedConnection | undefined>;
+  write(id: string, saved: SavedConnection): Promise<void>;
+  setConnected(id: string, connected: boolean): Promise<void>;
+  isCurrent(id: string, version: number): boolean;
+}) {
+  return async (id: string, saved: SavedConnection,
+    account: NonNullable<SavedConnection["accounts"]>[number], version: number): Promise<OAuthCredential> => {
+    const current = account.credential;
+    if (!subscriptionCredentialUsable(current)) throw new Error("ChatGPT plan permission requires reauthorization (chatgpt.tokens.use.direct)");
+    if (current.expires > options.now() + 60_000) return current;
+    await options.validate(id, saved.kind);
+    const oauth = options.oauth(saved.kind, current);
+    const save = async (credential: OAuthCredential) => {
+      await saveRefreshedSubscriptionAccount(saved, account, current, credential,
+        () => options.read(id, saved.kind), (value) => options.write(id, value));
+      if (chatgptAuthorizationState(current) !== chatgptAuthorizationState(credential))
+        await options.setConnected(id, usableSubscriptionAccounts(saved) > 0);
+    };
+    const credential = {
+      ...current,
+      ...(await (isChatGPTPlanCredential(current)
+        ? refreshChatGPT(oauth, current, options.fetch, AbortSignal.timeout(30_000), options.now, save)
+        : withOAuthFetch(options.fetch, () => oauth.refresh(current, AbortSignal.timeout(30_000))))),
+    };
+    await save(credential);
+    if (!options.isCurrent(id, version)) throw new Error("Subscription operation cancelled");
+    return credential;
+  };
+}
