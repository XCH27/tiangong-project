--- /dev/null
+++ b/packages/services/src/model-provider/chatgptAuthorization.ts
@@ -0,0 +1,172 @@
+import { createPublicKey, verify, type JsonWebKeyInput } from "node:crypto";
+import type { AuthInteraction, OAuthAuth, OAuthCredential, ProviderAuthInteraction } from "@earendil-works/pi-ai";
+import { withOAuthFetch } from "@earendil-works/pi-ai/utils/oauth-fetch";
+
+export const CHATGPT_PLAN_PROTOCOL = "chatgpt-plan";
+export const CHATGPT_API_URL = "https://api.openai.com/v1";
+const ISSUER = "https://auth.openai.com";
+const TOKEN_URL = `${ISSUER}/api/accounts/oauth/token`;
+const JWKS_URL = `${ISSUER}/.well-known/jwks.json`;
+const HOST_KEY = "chatgpt-agent-host-id";
+
+export function isChatGPTPlanCredential(credential: OAuthCredential): boolean {
+  return credential.protocol === CHATGPT_PLAN_PROTOCOL;
+}
+export function chatgptAuthorizationState(credential: OAuthCredential) {
+  if (!isChatGPTPlanCredential(credential)) return undefined;
+  return credential.reauthRequired === true ? "reauth-required" as const
+    : Array.isArray(credential.scopes) && credential.scopes.includes("chatgpt.tokens.use.direct")
+      ? "granted" as const : "plan-disabled" as const;
+}
+export const subscriptionCredentialUsable = (credential: OAuthCredential) =>
+  !isChatGPTPlanCredential(credential) || chatgptAuthorizationState(credential) === "granted";
+const TERMINAL_REFRESH_CODES = new Set(["invalid_grant", "invalid_refresh_token", "token_expired",
+  "refresh_token_expired", "refresh_token_invalidated", "refresh_token_reused"]);
+export const terminalChatGPTRefreshError = (error: unknown) => error instanceof Error &&
+  TERMINAL_REFRESH_CODES.has(String((error as Error & { code?: string }).code));
+async function tokenFailure(response: Response): Promise<never> {
+  const data = await response.json().catch(() => ({})) as { error?: string | { code?: string } };
+  const code = typeof data.error === "string" ? data.error : data.error?.code;
+  throw Object.assign(new Error(`ChatGPT authorization failed (HTTP ${response.status})`), {
+    statusCode: response.status, ...(code && /^[a-z_]{1,80}$/.test(code) ? { code } : {}),
+  });
+}
+
+/** The existing credential owner's cross-process lock creates one random installation ID. */
+export async function chatgptHostId(owner: {
+  load(key: string): Promise<string | null | undefined>;
+  save(key: string, value: string): Promise<void>;
+}, lock: <T>(key: string, run: () => Promise<T>) => Promise<T>, generate: () => string): Promise<string> {
+  return lock(HOST_KEY, async () => {
+    const existing = await owner.load(HOST_KEY);
+    if (existing) {
+      if (!/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(existing))
+        throw new Error("ChatGPT installation identity is invalid");
+      return existing;
+    }
+    const id = generate();
+    await owner.save(HOST_KEY, id);
+    return id;
+  });
+}
+
+/** Standard RS256/JWK verification; profile claims are used only after signature validation. */
+export async function verifyChatGPTIdentity(token: string, expected: {
+  clientId: string;
+  nonce?: string;
+  subject?: string;
+}, fetcher: typeof fetch, now = Date.now()): Promise<{ subject: string; email?: string }> {
+  if (token.length > 65_536) throw new Error("ChatGPT identity token is invalid");
+  const parts = token.split(".");
+  if (parts.length !== 3 || parts.some((part) => !/^[A-Za-z0-9_-]+$/.test(part)))
+    throw new Error("ChatGPT identity token is invalid");
+  const header = JSON.parse(Buffer.from(parts[0]!, "base64url").toString("utf8"));
+  if (header.alg !== "RS256" || typeof header.kid !== "string")
+    throw new Error("ChatGPT identity signature is invalid");
+  const response = await fetcher(JWKS_URL, { redirect: "error", signal: AbortSignal.timeout(15_000) });
+  if (!response.ok) {
+    await response.body?.cancel();
+    throw new Error("ChatGPT identity verification is unavailable");
+  }
+  const jwks = await response.json() as { keys?: Array<Record<string, unknown>> };
+  const keys = jwks.keys?.filter((key) => key.kid === header.kid && key.kty === "RSA" &&
+    (key.use === undefined || key.use === "sig") && (key.alg === undefined || key.alg === "RS256"));
+  if (keys?.length !== 1 || !verify("RSA-SHA256", Buffer.from(`${parts[0]}.${parts[1]}`),
+    createPublicKey({ key: keys[0] as JsonWebKeyInput["key"], format: "jwk" }), Buffer.from(parts[2]!, "base64url")))
+    throw new Error("ChatGPT identity signature is invalid");
+  const claims = JSON.parse(Buffer.from(parts[1]!, "base64url").toString("utf8"));
+  const audiences = Array.isArray(claims.aud) ? claims.aud : [claims.aud];
+  if (claims.iss !== ISSUER || !audiences.includes(expected.clientId) ||
+    (audiences.length > 1 && claims.azp !== expected.clientId) ||
+    !Number.isFinite(claims.exp) || claims.exp * 1000 <= now ||
+    (claims.nbf !== undefined && (!Number.isFinite(claims.nbf) || claims.nbf * 1000 > now)) ||
+    (expected.nonce !== undefined && claims.nonce !== expected.nonce) ||
+    typeof claims.sub !== "string" || !claims.sub ||
+    (expected.subject !== undefined && claims.sub !== expected.subject))
+    throw new Error("ChatGPT identity does not match this authorization");
+  return { subject: claims.sub, ...(typeof claims.email === "string" ? { email: claims.email } : {}) };
+}
+
+/** Pi still owns PKCE, listener, exchange and cancellation; Fleet validates its account binding. */
+export async function loginChatGPT(oauth: OAuthAuth, interaction: ProviderAuthInteraction,
+  hostId: string, fetcher: typeof fetch, returning?: OAuthCredential, now = Date.now) {
+  let nonce: string | undefined;
+  let tokenResponse: { id_token?: unknown; expires_in?: unknown; earliest_refresh_at?: unknown } | undefined;
+  const expectedClient = isChatGPTPlanCredential(returning ?? {} as OAuthCredential)
+    ? String(returning!.clientId) : undefined;
+  const bridge: AuthInteraction = {
+    ...interaction,
+    notify(event) {
+      if (event.type !== "auth_url") return interaction.notify(event);
+      const url = new URL(event.url);
+      if (url.origin !== ISSUER || url.pathname !== "/api/accounts/authorize")
+        throw new Error("Unexpected ChatGPT authorization address");
+      nonce = url.searchParams.get("nonce") ?? undefined;
+      if (!nonce) throw new Error("ChatGPT authorization nonce is missing");
+      if (expectedClient) {
+        url.searchParams.set("client_id", expectedClient);
+        url.searchParams.delete("agent_name_hint");
+        if (typeof returning?.idToken === "string") url.searchParams.set("id_token_hint", returning.idToken);
+        if (typeof returning?.email === "string") url.searchParams.set("login_hint", returning.email);
+        if (chatgptAuthorizationState(returning!) === "plan-disabled") url.searchParams.set("prompt", "consent");
+      } else url.searchParams.set("agent_name_hint", "Fleet");
+      interaction.notify({ ...event, url: url.href });
+    },
+  };
+  const capture: typeof fetch = async (input, init) => {
+    if (String(input) !== TOKEN_URL) return fetcher(input, init);
+    const form = new URLSearchParams(String(init?.body));
+    if (expectedClient && form.get("client_id") !== expectedClient)
+      throw new Error("ChatGPT registration changed during authorization");
+    const response = await fetcher(input, init);
+    // Vendor bodies may contain secrets; never pass an unsuccessful body to Pi's error string.
+    if (!response.ok) {
+      return tokenFailure(response);
+    }
+    tokenResponse = await response.clone().json() as NonNullable<typeof tokenResponse>;
+    return response;
+  };
+  const loginOptions = { getDeviceId: () => hostId, chatgptClientId: expectedClient, allowChatGPTIdentityOnly: true };
+  const credential = await withOAuthFetch(capture, () => oauth.login(bridge as ProviderAuthInteraction, loginOptions));
+  if (typeof credential.clientId !== "string" || credential.clientId === "dynamic_agent_client" ||
+    typeof tokenResponse?.id_token !== "string" || !nonce)
+    throw new Error("ChatGPT authorization is incomplete");
+  const identity = await verifyChatGPTIdentity(tokenResponse.id_token, {
+    clientId: credential.clientId, nonce,
+    ...(expectedClient ? { subject: String(returning!.subject) } : {}),
+  }, fetcher, now());
+  return { ...credential, ...identity, protocol: CHATGPT_PLAN_PROTOCOL, hostId,
+    idToken: tokenResponse.id_token } as OAuthCredential;
+}
+
+export async function refreshChatGPT(oauth: OAuthAuth, credential: OAuthCredential,
+  fetcher: typeof fetch, signal: AbortSignal, now = Date.now,
+  onTerminal?: (invalidated: OAuthCredential) => Promise<void>): Promise<OAuthCredential> {
+  let idToken: unknown;
+  const capture: typeof fetch = async (input, init) => {
+    const response = await fetcher(input, init);
+    if (!response.ok) {
+      return tokenFailure(response);
+    }
+    if (String(input) === TOKEN_URL) idToken = (await response.clone().json() as { id_token?: unknown }).id_token;
+    return response;
+  };
+  let refreshed: OAuthCredential;
+  try { refreshed = await withOAuthFetch(capture, () => oauth.refresh(credential, signal)); }
+  catch (error) {
+    if (terminalChatGPTRefreshError(error)) {
+      // Retain registration/verified identity for reauthorization; unusable tokens are retired.
+      const invalidated: OAuthCredential = { ...credential, access: "", refresh: "", expires: 0, reauthRequired: true };
+      delete invalidated.idToken; delete invalidated.id_token;
+      await onTerminal?.(invalidated);
+    }
+    throw error;
+  }
+  let identity: { subject: string; email?: string } | undefined;
+  if (idToken !== undefined) {
+    if (typeof idToken !== "string") throw new Error("ChatGPT identity token is invalid");
+    identity = await verifyChatGPTIdentity(idToken, { clientId: String(credential.clientId),
+      subject: String(credential.subject) }, fetcher, now());
+  }
+  return { ...credential, ...refreshed, ...identity, ...(typeof idToken === "string" ? { idToken } : {}) };
+}
