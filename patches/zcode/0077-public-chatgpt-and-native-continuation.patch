--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/claude-executable.ts
@@ -0,0 +1,28 @@
+import { createRequire } from "node:module";
+import { dirname, join } from "node:path";
+import { accessSync, constants, readFileSync } from "node:fs";
+
+export function claudeSdkManifest() {
+  const require = createRequire(typeof __filename === "string" ? __filename : import.meta.url);
+  const entry = require.resolve("@anthropic-ai/claude-agent-sdk");
+  return { entry, manifest: JSON.parse(readFileSync(join(dirname(entry), "package.json"), "utf8")) };
+}
+/** Resolve the unmodified binary shipped with this SDK; explicit user overrides remain explicit. */
+export function resolveClaudeNativeExecutable(override?: string): string {
+  if (override) return override;
+  const { entry: sdkEntry, manifest: sdk } = claudeSdkManifest();
+  const report = process.platform === "linux" ? process.report?.getReport() : undefined;
+  const musl = process.platform === "linux" && typeof report === "object" &&
+    !(report as { header?: { glibcVersionRuntime?: string } }).header?.glibcVersionRuntime;
+  const name = `@anthropic-ai/claude-agent-sdk-${process.platform}-${process.arch}${musl ? "-musl" : ""}`;
+  try {
+    const manifestPath = createRequire(sdkEntry).resolve(`${name}/package.json`);
+    const manifest = JSON.parse(readFileSync(manifestPath, "utf8"));
+    if (manifest.version !== sdk.optionalDependencies?.[name]) throw new Error("SDK binary version mismatch");
+    const binary = join(dirname(manifestPath), process.platform === "win32" ? "claude.exe" : "claude");
+    accessSync(binary, constants.X_OK);
+    return binary;
+  } catch (cause) {
+    throw new Error("The bundled Claude executor is unavailable; repair its SDK installation or select an installed Claude executable", { cause });
+  }
+}
