diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/native-continuation.ts b/apps/zcode-cli/packages/core/src/runtime/methods/native-continuation.ts
new file mode 100644
index 0000000..901f180
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/native-continuation.ts
@@ -0,0 +1,65 @@
+import { createHash } from "node:crypto";
+import type { ModelInputMessage, NativeAgentContinuation, NativeAgentTurnRequest } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+
+const ENTRY = "runtime/native_continuation";
+interface Checkpoint {
+  hostSessionId: string;
+  scope: string;
+  phase: "settled" | "inflight";
+  coveredCount: number;
+  coveredHash: string;
+  continuation?: NativeAgentContinuation;
+}
+const hash = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+const visible = (messages: ModelInputMessage[]) => messages.filter((message) => message.role !== "system");
+function historyHash(messages: ModelInputMessage[]) {
+  return hash(messages.map(({ role, content, toolCalls, toolCallId, toolName, isError }) => ({
+    role, content: typeof content === "string" ? [{ type: "text", text: content }] : content.map((block) => {
+      const { providerOptions: _, ...value } = block as typeof block & { providerOptions?: unknown };
+      return value;
+    }),
+    toolCalls: toolCalls ?? [], toolCallId, toolName, isError,
+  })));
+}
+
+/** A pointer in the existing Session journal, never a second canonical conversation. */
+export async function prepareNativeContinuation(runtime: AgentRuntimeInternal, request: NativeAgentTurnRequest) {
+  const store = runtime.sessionStore;
+  if (!store?.saveSessionEntry || !store.sessionEntries) return { request, settle: async () => {} };
+  const scope = hash({ executor: request.model.nativeExecutor, model: [request.model.providerId, request.model.modelId],
+    cwd: request.workingDirectory, tools: request.tools,
+    instructions: request.messages.filter((message) => message.role === "system").map((message) => message.content),
+  });
+  const entries = await store.sessionEntries({ sessionID: runtime.sessionId, type: ENTRY });
+  const old = entries.find((entry) => entry.id === `${runtime.sessionId}:native-continuation`)?.data as Checkpoint | undefined;
+  const messages = visible(request.messages);
+  const candidate = old?.hostSessionId === runtime.sessionId && old.phase === "settled" && old.scope === scope &&
+    old.coveredCount <= messages.length && old.coveredHash === historyHash(messages.slice(0, old.coveredCount))
+    ? old.continuation : undefined;
+  const continuation = candidate && await runtime.nativeAgentPort?.canResume?.(candidate, request) ? candidate : undefined;
+  const write = async (value: Checkpoint) => {
+    const timestamp = Date.now();
+    await store.saveSessionEntry!({ id: `${runtime.sessionId}:native-continuation`, sessionID: runtime.sessionId,
+      type: ENTRY, touchSession: false, time: { created: timestamp, updated: timestamp }, data: value });
+  };
+  // Write before a native query can mutate its cache. Interrupted/ambiguous runs never reuse it.
+  await write({ hostSessionId: runtime.sessionId, scope, phase: "inflight", coveredCount: 0, coveredHash: "" });
+  const reason = !old ? "no-checkpoint" : old.hostSessionId !== runtime.sessionId ? "different-session"
+    : old.phase !== "settled" ? "interrupted" : old.scope !== scope ? "binding-changed"
+    : !candidate ? "history-changed" : !continuation ? "native-cache-changed" : "resume";
+  runtime.logger?.info("Native continuation selected", { event: "native.continuation.selected", module: "core.runtime",
+    sessionId: runtime.sessionId, mode: continuation ? "resume" : "fresh", reason });
+  return {
+    request: { ...request, persistContinuation: true, continuation,
+      continuationMessageOffset: continuation ? old!.coveredCount : undefined },
+    async settle(checkpoint: NativeAgentContinuation | undefined, committed: ModelInputMessage[]) {
+      if (!checkpoint) return;
+      const all = visible(committed);
+      // Guide and Stop-hook input appended after the final assistant has not reached the SDK.
+      const covered = all.slice(0, all.findLastIndex((message) => message.role === "assistant") + 1);
+      await write({ hostSessionId: runtime.sessionId, scope, phase: "settled", continuation: checkpoint,
+        coveredCount: covered.length, coveredHash: historyHash(covered) });
+    },
+  };
+}
