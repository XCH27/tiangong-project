diff --git a/packages/ui/test/chatgptConnection.browser.test.tsx b/packages/ui/test/chatgptConnection.browser.test.tsx
new file mode 100644
index 0000000..5195543
--- /dev/null
+++ b/packages/ui/test/chatgptConnection.browser.test.tsx
@@ -0,0 +1,75 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { SubscriptionConnectionSection } from "../src/settings/model-provider-section/SubscriptionConnectionSection.js";
+import { ProviderDetailFeedbackBoundary } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+const check = (value: unknown, message: string) => { if (!value) throw new Error(message); };
+
+(window as unknown as Record<string, unknown>).__chatgptConnectionTests = (async () => {
+for (const [locale, dark, size, width] of [["zh-CN", false, 14, 560], ["zh-CN", true, 20, 320], ["en-US", false, 14, 560], ["en-US", true, 20, 320]] as const) {
+for (const authorizationState of ["granted", "plan-disabled", "reauth-required"] as const) {
+  const name = `public ChatGPT ${authorizationState}: ${locale}, ${dark ? "dark" : "light"}, ${size}px, ${width}px`;
+  document.documentElement.classList.toggle("dark", dark);
+  document.documentElement.style.setProperty("--ui-font-size", `${size}px`);
+  const node = document.createElement("div"); document.body.append(node);
+  node.style.width = `${width}px`;
+  const root = createRoot(node);
+  const calls: unknown[][] = [], urls: string[] = [];
+  let quotaCalls = 0;
+  const accounts = { accounts: [{ id: "A", label: "Synthetic account", active: true, publicPlan: true, authorizationState }], revision: "r", autoSwitch: false };
+  const service = {
+    onDidChange: () => ({ dispose() {} }),
+    getSubscriptionAccounts: async () => accounts,
+    getSubscriptionUsage: async () => { quotaCalls++; throw new Error("Unexpected private quota read"); },
+    beginSubscriptionLogin: async (...args: unknown[]) => {
+      calls.push(args); return { method: "browser", flowId: "local", verificationUrl: "https://auth.openai.com/api/accounts/authorize?synthetic" };
+    },
+    finishSubscriptionLogin: async () => ({ authorizedAccountId: "A", accountAdded: false }),
+    cancelSubscriptionLogin: async () => {},
+  };
+  try {
+    await act(async () => root.render(
+      <ServiceProvider services={{ providerSettingsService: service } as never}>
+        <PlatformProvider platform={{ openExternal: async (url: string) => { urls.push(url); } } as never}>
+          <ZCodeIntlProvider initialLocale={locale}>
+            <ProviderDetailFeedbackBoundary>
+              <SubscriptionConnectionSection providerId="chatgpt" kind="openai-codex" connected onRevision={() => {}} />
+            </ProviderDetailFeedbackBoundary>
+          </ZCodeIntlProvider>
+        </PlatformProvider>
+      </ServiceProvider>,
+    ));
+    const button = (text: string) => [...node.querySelectorAll("button")].find((item) => item.textContent?.trim() === text)!;
+    check(quotaCalls === 0, "Public plan row read a private quota endpoint");
+    const reconnect = button(authorizationState === "plan-disabled"
+      ? locale === "zh-CN" ? "启用订阅额度" : "Enable plan usage"
+      : locale === "zh-CN" ? "重新授权此账号" : "Reauthorize this account");
+    check(reconnect, "Missing selected-account reauthorization");
+    await act(async () => reconnect.click());
+    check(JSON.stringify(calls[0]) === JSON.stringify(["chatgpt", "browser", "A"]), "Reauthorization registered an unselected account");
+    check(node.textContent?.includes("Synthetic account"), "Reauthorization lost the saved row");
+    const usage = button(locale === "zh-CN" ? "在 ChatGPT 查看额度" : "View allowance in ChatGPT");
+    check(usage, "Missing official allowance action");
+    await act(async () => usage.click());
+    check(urls.at(-1) === "https://chatgpt.com/settings/usage", "Allowance used an unsupported private endpoint");
+    check(!node.textContent?.includes("100%"), "Unknown quota was presented as a full allowance");
+    if (authorizationState !== "granted") {
+      const badge = authorizationState === "plan-disabled"
+        ? locale === "zh-CN" ? "未授权额度" : "Plan usage disabled"
+        : locale === "zh-CN" ? "需重新授权" : "Reauthorization needed";
+      check(node.textContent?.includes(badge), "Inactive authorization was hidden from the account row");
+    }
+    const group = node.querySelector('[role="group"]')!;
+    check([...group.querySelectorAll("button")].every((item) => item.getBoundingClientRect().right <= group.getBoundingClientRect().right + 1), "Account actions overflow their original card");
+    results.push({ name });
+  } catch (error) { results.push({ name, error: String(error) }); }
+  finally { await act(async () => root.unmount()); node.remove(); }
+}
+}
+return results;
+})();
