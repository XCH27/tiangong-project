+++ b/apps/zcode-cli/packages/adapters/src/native-agent/claude-continuation.ts
@@ -0,0 +1,49 @@
+import { createHash } from "node:crypto";
+import { readFile, readdir } from "node:fs/promises";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { homedir } from "node:os";
+import { join, resolve, dirname, basename } from "node:path";
+import { claudeSdkManifest, resolveClaudeNativeExecutable } from "./claude-executable.js";
+import type { NativeAgentContinuation } from "@zcode/contracts";
+
+export function claudeSdkVersion(): string {
+  return claudeSdkManifest().manifest.version as string;
+}
+const UUID = /^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/i;
+export const claudeProjectsDirectory = (env: NodeJS.ProcessEnv) =>
+  resolve(env.CLAUDE_CONFIG_DIR ?? join(homedir(), ".claude"), "projects");
+const fingerprint = async (path: string) => createHash("sha256").update(await readFile(path)).digest("hex");
+async function executorVersion(env: NodeJS.ProcessEnv, executable?: string) {
+  const binary = resolveClaudeNativeExecutable(executable);
+  try {
+    const result = await promisify(execFile)(binary, ["--version"], { env, timeout: 15_000, maxBuffer: 4096, windowsHide: true });
+    return `${claudeSdkVersion()}:${result.stdout.trim()}`;
+  } catch { return undefined; }
+}
+
+/** Read only the vendor-owned JSONL file; never parse or import its private continuation. */
+export async function claudeContinuation(sessionId: string, env: NodeJS.ProcessEnv, executable?: string): Promise<NativeAgentContinuation | undefined> {
+  if (!UUID.test(sessionId)) return undefined;
+  const root = claudeProjectsDirectory(env);
+  const version = await executorVersion(env, executable);
+  if (!version) return undefined;
+  let folders;
+  try { folders = await readdir(root, { withFileTypes: true }); } catch { return undefined; }
+  for (const folder of folders) {
+    if (!folder.isDirectory()) continue;
+    const path = join(root, folder.name, `${sessionId}.jsonl`);
+    try {
+      return { sessionId, cachePath: path, cacheFingerprint: await fingerprint(path), executorVersion: version };
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    }
+  }
+  return undefined;
+}
+export async function canResumeClaude(continuation: NativeAgentContinuation, env: NodeJS.ProcessEnv, executable?: string): Promise<boolean> {
+  if (!UUID.test(continuation.sessionId) || continuation.executorVersion !== await executorVersion(env, executable) ||
+    dirname(dirname(continuation.cachePath)) !== claudeProjectsDirectory(env) ||
+    basename(continuation.cachePath) !== `${continuation.sessionId}.jsonl`) return false;
+  try { return await fingerprint(continuation.cachePath) === continuation.cacheFingerprint; } catch { return false; }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/claude-executable.ts b/apps/zcode-cli/packages/adapters/src/native-agent/claude-executable.ts
