diff --git a/packages/services/test/chatgpt-authorization.test.ts b/packages/services/test/chatgpt-authorization.test.ts
new file mode 100644
index 0000000..fdaab48
--- /dev/null
+++ b/packages/services/test/chatgpt-authorization.test.ts
@@ -0,0 +1,211 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { generateKeyPairSync, sign } from "node:crypto";
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+import { createSubscriptionConnections } from "../src/model-provider/subscriptionConnections.js";
+import { verifyChatGPTIdentity } from "../src/model-provider/chatgptAuthorization.js";
+import { isSameSubscriptionAccount } from "../src/model-provider/subscriptionAccountIdentity.js";
+import { redactTelemetryUrl, redactTelemetryText } from "@zcode/shared";
+
+const { privateKey, publicKey } = generateKeyPairSync("rsa", { modulusLength: 2048 });
+const jwk = { ...publicKey.export({ format: "jwk" }), kid: "local-test", alg: "RS256", use: "sig" };
+const jwt = (claims: Record<string, unknown>) => {
+  const payload = [ { alg: "RS256", kid: jwk.kid }, {
+    iss: "https://auth.openai.com", aud: "oaiapp-local", sub: "local-person",
+    exp: Math.floor(Date.now() / 1000) + 3600, email: "local@example.test", ...claims,
+  } ].map((item) => Buffer.from(JSON.stringify(item)).toString("base64url")).join(".");
+  return `${payload}.${sign("RSA-SHA256", Buffer.from(payload), privateKey).toString("base64url")}`;
+};
+
+function fixture() {
+  const records = new Map<string, string>();
+  const calls: string[] = [];
+  let authorization: URL;
+  let subject = "local-person";
+  let directScope = true;
+  let refreshFailure: string | undefined;
+  const fetcher: typeof fetch = async (input, init) => {
+    const url = String(input);
+    calls.push(url);
+    if (url.endsWith("/.well-known/jwks.json")) return Response.json({ keys: [jwk] });
+    if (url === "https://auth.openai.com/api/accounts/oauth/token") {
+      const form = new URLSearchParams(String(init?.body));
+      assert.equal(form.get("client_id"), "oaiapp-local");
+      assert.equal(form.get("resource"), "https://api.openai.com/v1");
+      assert.equal(form.get("scope"), null);
+      if (form.get("grant_type") === "refresh_token" && refreshFailure)
+        return Response.json({ error: refreshFailure }, { status: refreshFailure === "temporary" ? 503 : 400 });
+      if (form.get("grant_type") === "authorization_code") {
+        assert.equal(form.get("redirect_uri"), authorization.searchParams.get("redirect_uri"));
+        assert.ok(form.get("code_verifier"));
+      }
+      return Response.json({ access_token: "opaque-oauth-access", refresh_token: "rotated-refresh",
+        expires_in: 3600, scope: `openid email offline_access ${directScope ? "chatgpt.tokens.use.direct" : ""}`,
+        id_token: jwt({ nonce: authorization.searchParams.get("nonce"), sub: subject }),
+      });
+    }
+    if (url === "https://api.openai.com/v1/models") {
+      const headers = new Headers(init?.headers);
+      assert.equal(headers.get("authorization"), "Bearer opaque-oauth-access");
+      assert.equal(headers.get("chatgpt-account-id"), null);
+      return Response.json({ models: [
+        { slug: "local-model", display_name: "Local model", visibility: "list", input_modalities: ["text", "image"],
+          supported_reasoning_levels: [{ effort: "low" }, { effort: "high" }], default_reasoning_level: "low" },
+        { slug: "unlisted-model", visibility: "hide" },
+        { slug: "server-only-model", visibility: "internal" },
+      ] });
+    }
+    throw new Error(`Unexpected network request: ${url}`);
+  };
+  const queues = new Map<string, Promise<unknown>>();
+  const owner = createSubscriptionConnections({
+    credentials: { load: async (key) => records.get(key) ?? null,
+      save: async (key, value) => { records.set(key, value); }, delete: async (key) => { records.delete(key); } },
+    fetch: fetcher,
+    getView: async () => ({ providers: [{ providerId: "chatgpt", effectiveConfig: {
+      access: { type: "subscription", provider: "openai-codex" },
+    } }] }) as never,
+    setConnected: async () => {},
+    withConnectionLock(key, run) {
+      const task = (queues.get(key) ?? Promise.resolve()).catch(() => {}).then(run);
+      queues.set(key, task); return task;
+    },
+  });
+  return { owner, records, calls, fetcher, setSubject(value: string) { subject = value; },
+    noScope() { directScope = false; },
+    enableScope() { directScope = true; },
+    setRefreshFailure(value?: string) { refreshFailure = value; },
+    async begin(accountId?: string) {
+      const login = await owner.begin("chatgpt", "browser", accountId);
+      authorization = new URL(login.verificationUrl);
+      assert.equal(authorization.origin, "https://auth.openai.com");
+      assert.equal(authorization.pathname, "/api/accounts/authorize");
+      assert.equal(authorization.searchParams.get("ext_agent_host_id"), `urn:uuid:${records.get("chatgpt-agent-host-id")}`);
+      assert.equal(new URL(authorization.searchParams.get("redirect_uri")!).hostname, "127.0.0.1");
+      return { login, authorization };
+    },
+    async complete(login: { flowId: string }, clientId: string | undefined = "oaiapp-local") {
+      const callback = new URL(authorization.searchParams.get("redirect_uri")!);
+      callback.searchParams.set("code", "local-code");
+      callback.searchParams.set("state", authorization.searchParams.get("state")!);
+      if (clientId) callback.searchParams.set("client_id", clientId);
+      await owner.submit("chatgpt", login.flowId, callback.href);
+      return owner.finish("chatgpt", login.flowId);
+    },
+  };
+}
+
+test("real Pi ChatGPT login uses Fleet registration, verified identity, public catalog and request routing", async () => {
+  const f = fixture();
+  const { login, authorization } = await f.begin();
+  assert.equal(authorization.searchParams.get("agent_name_hint"), "Fleet");
+  assert.equal(authorization.searchParams.get("client_id"), "dynamic_agent_client");
+  const receipt = await f.complete(login);
+  const saved = JSON.parse(f.records.get("model-subscription:chatgpt")!);
+  assert.equal(saved.accounts[0].credential.subject, "local-person");
+  assert.equal(saved.accounts[0].credential.clientId, "oaiapp-local");
+  assert.ok(saved.accounts[0].credential.idToken);
+  assert.deepEqual((await f.owner.models("chatgpt")).models.map((model) => model.id), ["local-model"]);
+  const auth = await f.owner.resolve("chatgpt", "openai-codex", "local-model");
+  assert.equal(auth.protocol, "chatgpt-plan");
+  assert.equal(auth.baseUrl, "https://api.openai.com/v1");
+  assert.equal(auth.credentialSelection?.accountId, receipt.accountId);
+  const before = f.calls.length;
+  assert.equal((await f.owner.usage("chatgpt", true)).status, "unsupported");
+  await assert.rejects(f.owner.resetCredits("chatgpt", receipt.accountId), /unavailable/);
+  assert.equal(f.calls.length, before, "New tokens reached a private billing endpoint");
+  const stored = JSON.parse(f.records.get("model-subscription:chatgpt")!);
+  stored.accounts[0].credential.expires = 1;
+  stored.accounts[0].credential.refresh = "previous-refresh";
+  f.records.set("model-subscription:chatgpt", JSON.stringify(stored));
+  await Promise.all([f.owner.resolve("chatgpt"), f.owner.resolve("chatgpt")]);
+  const refreshed = JSON.parse(f.records.get("model-subscription:chatgpt")!).accounts[0].credential;
+  assert.equal(refreshed.refresh, "rotated-refresh");
+  assert.equal(refreshed.subject, "local-person");
+  assert.equal(refreshed.clientId, "oaiapp-local");
+});
+
+test("reauthorization reuses the registration and accepts a callback without client_id", async () => {
+  const f = fixture();
+  const first = await f.begin();
+  const receipt = await f.complete(first.login);
+  const second = await f.begin(receipt.accountId);
+  assert.equal(second.authorization.searchParams.get("client_id"), "oaiapp-local");
+  assert.equal(second.authorization.searchParams.has("agent_name_hint"), false);
+  assert.ok(second.authorization.searchParams.get("id_token_hint"));
+  const repeated = await f.complete(second.login, "");
+  assert.equal(repeated.accountId, receipt.accountId);
+  assert.equal(repeated.added, false);
+  assert.equal((await f.owner.accounts("chatgpt")).accounts.length, 1);
+});
+
+test("wrong identity preserves the binding; declined plan permission retains verified registration without inference", async () => {
+  const f = fixture();
+  const first = await f.begin();
+  const receipt = await f.complete(first.login);
+  const before = JSON.parse(f.records.get("model-subscription:chatgpt")!).accounts;
+  f.setSubject("another-person");
+  let next = await f.begin(receipt.accountId);
+  await assert.rejects(f.complete(next.login), /identity/);
+  assert.deepEqual(JSON.parse(f.records.get("model-subscription:chatgpt")!).accounts, before);
+  f.noScope(); f.setSubject("local-person");
+  next = await f.begin(receipt.accountId);
+  await f.complete(next.login);
+  assert.equal((await f.owner.accounts("chatgpt")).accounts[0]?.authorizationState, "plan-disabled");
+  const count = f.calls.length;
+  await assert.rejects(f.owner.resolve("chatgpt"), /chatgpt.tokens.use.direct/);
+  assert.equal(f.calls.length, count);
+  f.enableScope();
+  next = await f.begin(receipt.accountId);
+  assert.equal(next.authorization.searchParams.get("client_id"), "oaiapp-local");
+  assert.equal(next.authorization.searchParams.get("prompt"), "consent");
+  await f.complete(next.login, "");
+  assert.equal((await f.owner.accounts("chatgpt")).accounts[0]?.authorizationState, "granted");
+});
+
+test("confirmed refresh revocation retires tokens but retains registration; temporary errors preserve credentials", async () => {
+  const f = fixture();
+  const first = await f.begin(); const receipt = await f.complete(first.login);
+  const raw = JSON.parse(f.records.get("model-subscription:chatgpt")!);
+  raw.accounts[0].credential.expires = 1;
+  f.records.set("model-subscription:chatgpt", JSON.stringify(raw));
+  f.setRefreshFailure("temporary");
+  await assert.rejects(f.owner.resolve("chatgpt"));
+  assert.equal(JSON.parse(f.records.get("model-subscription:chatgpt")!).accounts[0].credential.refresh, "rotated-refresh");
+  f.setRefreshFailure("invalid_grant");
+  await assert.rejects(f.owner.resolve("chatgpt"));
+  const retired = JSON.parse(f.records.get("model-subscription:chatgpt")!).accounts[0].credential;
+  assert.equal(retired.access, ""); assert.equal(retired.refresh, ""); assert.equal(retired.idToken, undefined);
+  assert.equal(retired.clientId, "oaiapp-local"); assert.equal(retired.subject, "local-person");
+  assert.equal((await f.owner.accounts("chatgpt")).accounts[0]?.authorizationState, "reauth-required");
+  f.setRefreshFailure();
+  const next = await f.begin(receipt.accountId);
+  assert.equal(next.authorization.searchParams.get("id_token_hint"), null);
+  assert.equal(next.authorization.searchParams.get("prompt"), null);
+  await f.complete(next.login, "");
+  assert.equal((await f.owner.accounts("chatgpt")).accounts[0]?.authorizationState, "granted");
+});
+
+test("ID token signature, issuer, audience, expiry and nonce are independently enforced", async () => {
+  const fetcher: typeof fetch = async () => Response.json({ keys: [jwk] });
+  const expected = { clientId: "oaiapp-local", nonce: "nonce" };
+  assert.equal((await verifyChatGPTIdentity(jwt({ nonce: "nonce" }), expected, fetcher)).subject, "local-person");
+  for (const claims of [{ iss: "https://wrong.test" }, { aud: "wrong-client" }, { exp: 1 }, { nonce: "wrong" }, { nbf: 9999999999 }])
+    await assert.rejects(verifyChatGPTIdentity(jwt({ nonce: "nonce", ...claims }), expected, fetcher));
+  const token = jwt({ nonce: "nonce" });
+  await assert.rejects(verifyChatGPTIdentity(token.slice(0, -10) + "invalidsig", expected, fetcher), /signature/);
+});
+
+test("same email across issued registrations never merges account bindings", () => {
+  const a = { type: "oauth", access: "opaque", refresh: "r", expires: 1,
+    protocol: "chatgpt-plan", clientId: "client-a", subject: "person", email: "same@example.test" } as OAuthCredential;
+  assert.equal(isSameSubscriptionAccount("openai-codex", a, { ...a, clientId: "client-b" }), false);
+  assert.equal(isSameSubscriptionAccount("openai-codex", a, { ...a, subject: "other" }), false);
+  assert.equal(isSameSubscriptionAccount("openai-codex", a, { ...a, access: "rotated" }), true);
+});
+
+test("external-browser failure diagnostics omit reauthorization ID-token hints", () => {
+  const url = "https://auth.openai.com/api/accounts/authorize?id_token_hint=synthetic-private-identity&state=local";
+  assert.equal(redactTelemetryUrl(url), "https://auth.openai.com/api/accounts/authorize");
+  assert.equal(redactTelemetryText(`Failed to open ${url}`).includes("synthetic-private-identity"), false);
+});
