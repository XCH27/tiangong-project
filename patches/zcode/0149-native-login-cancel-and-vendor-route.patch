+test("cancelling while the post-login inspection runs publishes nothing (PRI-01)", async () => {
+  let writes = 0;
+  const inspected = Promise.withResolvers<{
+    accountId: string;
+    accountName: string;
+    catalog: { source: "provider"; models: [] };
+  }>();
+  const done = Promise.withResolvers<void>();
+  const access = { type: "native-cli", provider: "claude", connected: false };
+  const facade = {
+    getView: () => ({ revision: 1, providers: [{ providerId: "A", effectiveConfig: { access } }] }),
+    mergeDiscoveredModels: async () => {
+      writes++;
+    },
+  } as unknown as ProviderSettingsFacade;
+  const operations = createNativeCliConnectionOperations(facade, async () => {}, {
+    inspect: () => inspected.promise,
+    login: () => ({ completion: done.promise, cancel() {} }),
+  });
+  const { flowId } = await operations.beginNativeCliLogin("A");
+  done.resolve();
+  await Promise.resolve();
+  const polling = operations.pollNativeCliLogin("A", flowId);
+  void polling.catch(() => {});
+  await Promise.resolve();
+  await operations.cancelNativeCliLogin("A", flowId);
+  inspected.resolve({ accountId: "fixture@example.invalid", accountName: "Fixture", catalog: { source: "provider", models: [] } });
+  await assert.rejects(polling, /cancelled/);
+  assert.equal(writes, 0);
+});
