+test("malformed SSE on an open socket preserves the parser error and closes without effects", async () => {
+  const { createServer } = await import("node:http");
+  let requests = 0;
+  const closed = Promise.withResolvers<void>();
+  const server = createServer((_request, response) => {
+    requests++;
+    response.on("close", () => closed.resolve());
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.write('data: {"choices":"invalid-shape"}\n\n');
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address() as { port: number };
+  const f = await fixture(undefined, true);
+  try {
+    const candidate = model(fetch, "openai-chat-completions", `http://127.0.0.1:${address.port}/v1`, 250);
+    (f.runtime as any).modelFactory = () => candidate;
+    await assert.rejects(f.runtime.executeTurn("Retain the original parser diagnosis"), (error) => {
+      const names: string[] = [];
+      for (let cause: any = error; cause; cause = cause.cause) names.push(cause.name);
+      assert.ok(names.includes("AI_TypeValidationError"), names.join(" → "));
+      assert.ok(!names.includes("ModelStreamIdleTimeoutError"));
+      return true;
+    });
+    await closed.promise;
+    assert.equal(requests, 1);
+    assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 0);
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try { assert.equal(db.prepare("select status from model_usage limit 1").get()!.status, "error"); }
+    finally { db.close(); }
+  } finally {
+    await f.close();
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
