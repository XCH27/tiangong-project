diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/native-variants.ts b/apps/zcode-cli/packages/adapters/src/native-agent/native-variants.ts
new file mode 100644
index 0000000..736454a
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/native-variants.ts
@@ -0,0 +1,96 @@
+/**
+ * Some official CLIs list one model several times: once per thinking effort (Antigravity
+ * `gemini-3.8-flash-high|medium|low`) or per speed (Kimi `kimi-for-coding-highspeed`). Fleet shows
+ * one model and offers those as the existing thinking-level and Fast controls; the executor maps
+ * the chosen options back to the vendor's own model id at request time.
+ */
+export const VARIANT_EFFORTS = ["minimal", "low", "medium", "high", "xhigh", "max"] as const;
+const EFFORT_SUFFIX = new RegExp(`^(.+)-(${VARIANT_EFFORTS.join("|")})$`, "u");
+const FAST_SUFFIXES = ["-highspeed"] as const;
+const LABEL_EFFORT = /\s*\((?:minimal|low|medium|high|xhigh|max)\)\s*$/iu;
+
+export interface VendorModel {
+  id: string;
+  name: string;
+  images?: boolean;
+  contextWindow?: number;
+}
+export interface FoldedModel extends VendorModel {
+  /** Vendor efforts available as `${id}-${effort}`, in ascending order. */
+  efforts?: string[];
+  /** The vendor also lists `${id}-highspeed`. */
+  fast?: boolean;
+}
+
+export function foldVendorModels(
+  models: readonly VendorModel[],
+  options: { efforts?: boolean } = { efforts: true },
+): FoldedModel[] {
+  const ids = new Set(models.map((model) => model.id));
+  const folded = new Map<string, FoldedModel>();
+  const order: string[] = [];
+  const add = (key: string, model: FoldedModel) => {
+    if (!folded.has(key)) order.push(key);
+    folded.set(key, { ...folded.get(key), ...model });
+  };
+  for (const model of models) {
+    const fastBase = FAST_SUFFIXES.map((suffix) => (model.id.endsWith(suffix) ? model.id.slice(0, -suffix.length) : undefined)).find(
+      (base) => base && ids.has(base),
+    );
+    if (fastBase) {
+      const base = folded.get(fastBase);
+      if (base) base.fast = true;
+      else add(fastBase, { ...models.find((entry) => entry.id === fastBase)!, fast: true });
+      continue;
+    }
+    const effort = EFFORT_SUFFIX.exec(model.id);
+    // 只有不存在同名基础模型时才合并档位，避免把真正不同的模型误并。
+    if (options.efforts !== false && effort && !ids.has(effort[1]!)) {
+      const base = effort[1]!;
+      const existing = folded.get(base);
+      const efforts = [...(existing?.efforts ?? []), effort[2]!].sort(
+        (left, right) => VARIANT_EFFORTS.indexOf(left as never) - VARIANT_EFFORTS.indexOf(right as never),
+      );
+      add(base, {
+        ...model,
+        ...existing,
+        id: base,
+        name: existing?.name ?? model.name.replace(LABEL_EFFORT, ""),
+        efforts,
+      });
+      continue;
+    }
+    add(model.id, { ...model, ...folded.get(model.id) });
+  }
+  return order.map((key) => folded.get(key)!);
+}
+
+/** Default effort for "auto": the vendor's middle setting when listed, else its highest. */
+export function defaultVariantEffort(efforts: readonly string[]): string | undefined {
+  return efforts.includes("medium") ? "medium" : efforts.at(-1);
+}
+
+/**
+ * The vendor model id for a folded model. `effortsInId` is true for CLIs whose efforts are model
+ * ids (Antigravity); ACP CLIs carry thinking level as a session option, so only Fast maps to an id.
+ */
+export function resolveVariantModelId(
+  modelId: string,
+  specs: { reasoningLevel?: { values?: readonly string[] }; speedMode?: string | null } | undefined,
+  options: { reasoningLevel?: string; speedMode?: string } | undefined,
+  effortsInId: boolean,
+): string {
+  let id = modelId;
+  const efforts = effortsInId
+    ? (specs?.reasoningLevel?.values ?? []).filter((value) => (VARIANT_EFFORTS as readonly string[]).includes(value))
+    : [];
+  if (efforts.length) {
+    const chosen =
+      options?.reasoningLevel && efforts.includes(options.reasoningLevel)
+        ? options.reasoningLevel
+        : defaultVariantEffort(efforts);
+    if (chosen) id = `${id}-${chosen}`;
+  }
+  if (options?.speedMode === "fast" && specs?.speedMode === "variant-model") id = `${id}${FAST_SUFFIXES[0]}`;
+  return id;
+}
