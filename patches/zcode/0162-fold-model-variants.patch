+
+test("thinking-effort and speed variants of one model fold into one model with options", async () => {
+  const { foldVendorModels, resolveVariantModelId } = await import(
+    "../../../apps/zcode-cli/packages/adapters/src/native-agent/native-variants.js"
+  );
+  const folded = foldVendorModels([
+    { id: "gemini-3.8-flash-high", name: "Gemini 3.8 Flash (High)" },
+    { id: "gemini-3.8-flash-medium", name: "Gemini 3.8 Flash (Medium)" },
+    { id: "gemini-3.8-flash-low", name: "Gemini 3.8 Flash (Low)" },
+    { id: "gemini-3.1-pro-high", name: "Gemini 3.1 Pro (High)" },
+    { id: "gemini-3.1-pro-low", name: "Gemini 3.1 Pro (Low)" },
+    { id: "claude-sonnet-4-6", name: "Claude Sonnet 4.6 (Thinking)" },
+    { id: "kimi-for-coding", name: "kimi-for-coding" },
+    { id: "kimi-for-coding-highspeed", name: "kimi-for-coding-highspeed" },
+  ]);
+  assert.deepEqual(
+    folded.map((model) => [model.id, model.name, model.efforts ?? null, model.fast ?? false]),
+    [
+      ["gemini-3.8-flash", "Gemini 3.8 Flash", ["low", "medium", "high"], false],
+      ["gemini-3.1-pro", "Gemini 3.1 Pro", ["low", "high"], false],
+      ["claude-sonnet-4-6", "Claude Sonnet 4.6 (Thinking)", null, false],
+      ["kimi-for-coding", "kimi-for-coding", null, true],
+    ],
+  );
+  const specs = { reasoningLevel: { values: ["auto", "low", "medium", "high"] } };
+  assert.equal(resolveVariantModelId("gemini-3.8-flash", specs, { reasoningLevel: "auto" }, true), "gemini-3.8-flash-medium");
+  assert.equal(resolveVariantModelId("gemini-3.8-flash", specs, { reasoningLevel: "low" }, true), "gemini-3.8-flash-low");
+  assert.equal(resolveVariantModelId("gemini-3.1-pro", { reasoningLevel: { values: ["auto", "low", "high"] } }, {}, true), "gemini-3.1-pro-high");
+  // ACP 的思考档位是会话选项，不能拼进模型 ID；只有"快速"换成配对模型。
+  assert.equal(resolveVariantModelId("opencode-go/glm-5.3", specs, { reasoningLevel: "high" }, false), "opencode-go/glm-5.3");
+  assert.equal(
