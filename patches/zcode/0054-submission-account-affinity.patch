diff --git a/packages/services/src/zcode-agent/subscriptionCommandAdmission.ts b/packages/services/src/zcode-agent/subscriptionCommandAdmission.ts
new file mode 100644
--- /dev/null
+++ b/packages/services/src/zcode-agent/subscriptionCommandAdmission.ts
@@ -0,0 +1,38 @@
+import { commandPayloadSchemas, type CommandEnvelope } from "@zcode/shared/zcode-protocol-v4";
+
+/** Replace client-supplied account IDs with the Host owner's current identity before CLI admission. */
+export async function bindSubscriptionAccountAtAdmission(
+  envelope: CommandEnvelope,
+  capture?: (providerId: string) => Promise<string | undefined>,
+): Promise<CommandEnvelope> {
+  if (envelope.type === "createSession" || envelope.type === "createSelectionSideSession") {
+    const payload = commandPayloadSchemas[envelope.type].parse(envelope.payload);
+    if (!payload.firstInput) return envelope;
+    const { subscriptionAccountId: _untrusted, ...firstInput } = payload.firstInput;
+    const accountId = firstInput.modelSelection
+      ? await capture?.(firstInput.modelSelection.providerId)
+      : undefined;
+    return {
+      ...envelope,
+      payload: {
+        ...payload,
+        firstInput: {
+          ...firstInput,
+          ...(accountId ? { subscriptionAccountId: accountId } : {}),
+        },
+      },
+    };
+  }
+  if (envelope.type === "sendText" || envelope.type === "sendGoalCommand") {
+    const payload = commandPayloadSchemas[envelope.type].parse(envelope.payload);
+    const { subscriptionAccountId: _untrusted, ...submitted } = payload;
+    const accountId = submitted.modelSelection
+      ? await capture?.(submitted.modelSelection.providerId)
+      : undefined;
+    return {
+      ...envelope,
+      payload: { ...submitted, ...(accountId ? { subscriptionAccountId: accountId } : {}) },
+    };
+  }
+  return envelope;
+}
