diff --git a/packages/services/test/subscription-command-admission.test.ts b/packages/services/test/subscription-command-admission.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/services/test/subscription-command-admission.test.ts
@@ -0,0 +1,92 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { CommandEnvelope } from "@zcode/shared/zcode-protocol-v4";
+import { bindSubscriptionAccountAtAdmission } from "../src/zcode-agent/subscriptionCommandAdmission.js";
+
+function command(type: CommandEnvelope["type"], payload: unknown): CommandEnvelope {
+  return {
+    type,
+    payload,
+    commandId: "command-1",
+    clientId: "desktop",
+    sessionId: "session-1",
+    issuedAt: 1,
+  };
+}
+
+test("Host replaces a forged account ID for queued, goal and first-message submissions", async () => {
+  const selection = { providerId: "chatgpt", modelId: "gpt-6-sol" };
+  const capture = async (providerId: string) => {
+    assert.equal(providerId, "chatgpt");
+    return "account-a";
+  };
+  for (const envelope of [
+    command("sendText", {
+      text: "Next",
+      requestedDelivery: "queue",
+      modelSelection: selection,
+      subscriptionAccountId: "forged",
+    }),
+    command("sendGoalCommand", {
+      text: "Goal",
+      modelSelection: selection,
+      subscriptionAccountId: "forged",
+    }),
+  ]) {
+    const bound = await bindSubscriptionAccountAtAdmission(envelope, capture);
+    assert.equal(
+      (bound.payload as { subscriptionAccountId?: string }).subscriptionAccountId,
+      "account-a",
+    );
+  }
+  for (const type of ["createSession", "createSelectionSideSession"] as const) {
+    const payload =
+      type === "createSession"
+        ? {
+            workspaceId: "workspace",
+            firstInput: {
+              text: "First",
+              modelSelection: selection,
+              subscriptionAccountId: "forged",
+            },
+          }
+        : {
+            firstInput: {
+              text: "First",
+              modelSelection: selection,
+              subscriptionAccountId: "forged",
+            },
+          };
+    const bound = await bindSubscriptionAccountAtAdmission(command(type, payload), capture);
+    assert.equal(
+      (bound.payload as { firstInput?: { subscriptionAccountId?: string } }).firstInput
+        ?.subscriptionAccountId,
+      "account-a",
+    );
+  }
+});
+
+test("Host drops an untrusted identity when the submission has no selected subscription account", async () => {
+  const withoutSelection = await bindSubscriptionAccountAtAdmission(
+    command("sendText", { text: "Next", subscriptionAccountId: "forged" }),
+    async () => {
+      throw new Error("must not capture without a model");
+    },
+  );
+  assert.equal(
+    (withoutSelection.payload as { subscriptionAccountId?: string }).subscriptionAccountId,
+    undefined,
+  );
+  const api = await bindSubscriptionAccountAtAdmission(
+    command("sendText", {
+      text: "Next",
+      modelSelection: { providerId: "deepseek", modelId: "deepseek-chat" },
+      subscriptionAccountId: "forged",
+    }),
+    async () => undefined,
+  );
+  assert.equal(
+    (api.payload as { subscriptionAccountId?: string }).subscriptionAccountId,
+    undefined,
+  );
+});
