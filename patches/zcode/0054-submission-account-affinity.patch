@@ -0,0 +1,21 @@
+import type { ProviderSettingsView } from "@zcode/provider";
+import type { SavedConnection, SubscriptionKind } from "./subscriptionConnectionTypes.js";
+
+/** Read identity under the existing account lock; no OAuth material enters the command. */
+export async function captureSubscriptionAccountId(
+  id: string,
+  getView: () => Promise<ProviderSettingsView>,
+  withConnectionLock: <T>(id: string, operation: () => Promise<T>) => Promise<T>,
+  driver: (id: string) => Promise<{ kind: SubscriptionKind }>,
+  load: (id: string, kind: SubscriptionKind) => Promise<SavedConnection | undefined>,
+): Promise<string | undefined> {
+  const provider = (await getView()).providers.find((entry) => entry.providerId === id);
+  if (provider?.effectiveConfig.access?.type !== "subscription") return undefined;
+  return withConnectionLock(id, async () => {
+    const { kind } = await driver(id);
+    const saved = await load(id, kind);
+    const active = saved?.accounts?.find((account) => account.id === saved.activeAccountId);
+    if (!active) throw new Error("Connect this subscription account before sending");
+    return active.id;
+  });
+}
