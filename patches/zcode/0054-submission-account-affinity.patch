@@ -0,0 +1,46 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  commandPayloadSchemas,
+  conversationInputIntentSchema,
+  queueItemSchema,
+} from "@zcode/shared/zcode-protocol-v4";
+import { inputIntentMetadataFromQueueItem } from "../src/zcode-protocol-v4/commands/input-intent.js";
+import { buildPersistedConversationInputIntent } from "../../core/src/runtime/methods/input-intent-persistence.js";
+
+test("queued subscription input retains the submitted account through promotion and persistence", () => {
+  const item = queueItemSchema.parse({
+    sourceCommandId: "command-1",
+    queueItemId: "queue-1",
+    clientId: "desktop",
+    kind: "sendText",
+    text: "Continue",
+    attachments: [],
+    modelSelection: { providerId: "chatgpt", modelId: "gpt-6-sol" },
+    subscriptionAccountId: "account-a",
+    delivery: { requested: "queue", admitted: "queue" },
+    order: { admissionSeq: 2, queuePosition: 0 },
+    steer: { state: "notRequested" },
+    dispatch: { state: "queued" },
+    admittedAt: Date.now(),
+  });
+  const promoted = inputIntentMetadataFromQueueItem(item, item.text);
+  assert.equal(promoted.subscriptionAccountId, "account-a");
+  const persisted = buildPersistedConversationInputIntent(item.text, promoted, "drained");
+  assert.equal(persisted?.subscriptionAccountId, "account-a");
+  assert.equal(
+    conversationInputIntentSchema.parse(persisted).subscriptionAccountId,
+    "account-a",
+  );
+  assert.equal(
+    commandPayloadSchemas.createSession.parse({
+      workspaceId: "workspace",
+      firstInput: {
+        text: "First",
+        modelSelection: item.modelSelection,
+        subscriptionAccountId: "account-a",
+      },
+    }).firstInput?.subscriptionAccountId,
+    "account-a",
+  );
+});
