diff --git a/packages/services/src/model-provider/nativeCliConnectionAdapter.ts b/packages/services/src/model-provider/nativeCliConnectionAdapter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..140240691901ae41074dad01b367e60bb57161ca
--- /dev/null
+++ b/packages/services/src/model-provider/nativeCliConnectionAdapter.ts
@@ -0,0 +1,54 @@
+import {
+  inspectClaudeNativeConnection,
+  startClaudeNativeLogin,
+} from "@zcode/adapters/native-agent";
+import type { NativeCliConnectionAdapter } from "./nativeCliConnection.js";
+
+/** Node host only, injected alongside the existing subscription and CC Switch adapters. */
+export function createNativeCliConnectionAdapter(): NativeCliConnectionAdapter {
+  return {
+    async inspect(access) {
+      if (access.provider !== "claude")
+        throw new Error("This native CLI executor is not available yet");
+      const { account, models } = await inspectClaudeNativeConnection({
+        executable: access.executable,
+        configDir: access.configDir,
+      });
+      if (!account.email || (account.apiProvider && account.apiProvider !== "firstParty"))
+        throw new Error("Sign in to the official Claude CLI with your Claude account first");
+      if (access.accountId && access.accountId !== account.email)
+        throw new Error("Native CLI account changed; reconnect this connection");
+      return {
+        accountId: account.email,
+        accountName: account.email,
+        planType: account.subscriptionType,
+        catalog: {
+          source: "provider",
+          models: models.map((model) => ({
+            id: model.resolvedModel ?? model.value,
+            name: model.displayName,
+            config: {
+              properties: {
+                inputFormat: {
+                  supportsText: true,
+                  supportsImage: true,
+                  supportsPdf: true,
+                  supportsAudio: false,
+                  supportsVideo: false,
+                },
+              },
+              optionSpecs: {
+                reasoningLevel: {
+                  values: ["auto", ...(model.supportedEffortLevels ?? [])],
+                  defaultValue: "auto",
+                  map: "{}",
+                },
+              },
+            },
+          })),
+        },
+      };
+    },
+    login: startClaudeNativeLogin,
+  };
+}
