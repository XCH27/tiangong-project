@@ -0,0 +1,99 @@
+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { exportAgentPluginsPackage } from "@zcode/adapters/plugins";
+import { resolveZCodePlugins } from "../src/plugins.js";
+
+// OV-100 phase 5: Agent Plugins 1.0.0 packages (root plugin.json + mcp.json + skills/) load like
+// any plugin, and a Fleet plugin exports to that format without its credentials.
+
+async function paths(root: string, dirs: string[]) {
+  const workspace = join(root, "workspace");
+  await mkdir(workspace, { recursive: true });
+  const userConfigPath = join(root, "config.json");
+  await writeFile(userConfigPath, JSON.stringify({ storage: { dir: join(root, "storage") }, plugins: { dirs } }));
+  return { env: {}, officialPluginRoots: [], userConfigPath, workingDirectory: workspace };
+}
+
+test("an Agent Plugins package loads its mcp.json servers, skills and portable placeholders", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-agent-plugins-"));
+  try {
+    const pkg = join(root, "contract-review");
+    await mkdir(join(pkg, "skills", "risk-checklist"), { recursive: true });
+    await mkdir(join(pkg, "bin"), { recursive: true });
+    await writeFile(join(pkg, "plugin.json"), JSON.stringify({ $schema: "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json", name: "contract-review", version: "1.2.0" }));
+    await writeFile(
+      join(pkg, "mcp.json"),
+      JSON.stringify({
+        mcpServers: {
+          clauses: { type: "streamable-http", url: "https://mcp.example.com/clauses" },
+          redline: { type: "stdio", command: "./bin/redline", args: ["--data", "${PLUGIN_DATA}"] },
+        },
+      }),
+    );
+    await writeFile(join(pkg, "skills", "risk-checklist", "SKILL.md"), "---\nname: risk-checklist\ndescription: Risks\n---\n");
+    const outcome = resolveZCodePlugins(await paths(root, [pkg]));
+    const plugin = outcome.plugins.find((entry) => entry.name === "contract-review");
+    assert.ok(plugin, JSON.stringify(outcome.diagnostics));
+    assert.equal(plugin.version, "1.2.0");
+    assert.ok(plugin.skillCount > 0);
+    const clauses = outcome.mcpServers["plugin:contract-review:clauses"];
+    const redline = outcome.mcpServers["plugin:contract-review:redline"];
+    assert.equal(clauses?.type, "http");
+    assert.equal(redline?.type, "stdio");
+    assert.equal((redline as { command: string }).command, join(pkg, "bin", "redline"));
+    assert.equal((redline as { args: string[] }).args[1], plugin.dataPath);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("export writes an Agent Plugins package without credentials, and it loads back", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-agent-plugins-export-"));
+  try {
+    const source = join(root, "Source Tools");
+    await mkdir(join(source, ".claude-plugin"), { recursive: true });
+    await mkdir(join(source, "skills", "notes"), { recursive: true });
+    await mkdir(join(source, "hooks"), { recursive: true });
+    await writeFile(join(source, "hooks", "hooks.json"), "{}");
+    await writeFile(join(source, "skills", "notes", "SKILL.md"), "---\nname: notes\ndescription: Notes\n---\n");
+    await writeFile(
+      join(source, ".claude-plugin", "plugin.json"),
+      JSON.stringify({
+        name: "source-tools",
+        version: "2.0.0",
+        author: "Fleet Test",
+        mcpServers: {
+          api: { type: "http", url: "https://api.example.com/mcp", headers: { Authorization: "Bearer secret" } },
+          local: { command: "node", args: ["${CLAUDE_PLUGIN_ROOT}/server.js"] },
+        },
+        fleet: { views: [{ id: "main", title: "Main", server: "local", resource: "ui://local/main" }] },
+      }),
+    );
+    const out = join(root, "out");
+    await mkdir(out);
+    const result = exportAgentPluginsPackage({ rootPath: source, targetDirectory: out });
+    assert.equal(result.path, join(out, "source-tools"));
+    const manifest = JSON.parse(await readFile(join(result.path, "plugin.json"), "utf8"));
+    assert.equal(manifest.$schema, "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json");
+    assert.deepEqual(manifest.author, { name: "Fleet Test" });
+    assert.equal(manifest.extensions["fleet.workbench"].views[0].id, "main");
+    const mcp = JSON.parse(await readFile(join(result.path, "mcp.json"), "utf8"));
+    assert.equal(mcp.mcpServers.api.type, "streamable-http");
+    assert.equal(mcp.mcpServers.api.headers, undefined, "credentials never travel");
+    assert.deepEqual(mcp.mcpServers.local.args, ["${PLUGIN_ROOT}/server.js"]);
+    assert.ok(result.skipped.some((item) => item.path === "mcp.json#/mcpServers/api/headers"));
+    assert.ok(result.skipped.some((item) => item.path === "hooks"));
+    await assert.rejects(async () => exportAgentPluginsPackage({ rootPath: source, targetDirectory: out }), /already exists/);
+
+    const outcome = resolveZCodePlugins(await paths(root, [result.path]));
+    const reloaded = outcome.plugins.find((entry) => entry.name === "source-tools");
+    assert.ok(reloaded, JSON.stringify(outcome.diagnostics));
+    assert.deepEqual(reloaded.views?.map((view) => view.id), ["main"], "Fleet views survive the round trip");
+    assert.ok(reloaded.skillCount > 0);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
