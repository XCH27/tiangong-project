new file mode 100644
index 0000000..7645203
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/plugins/agent-plugins-export.ts
@@ -0,0 +1,145 @@
+import { cpSync, existsSync, mkdirSync, readdirSync, statSync, writeFileSync } from "node:fs";
+import { join, relative, sep } from "node:path";
+import type { PluginDiagnostic } from "@zcode/contracts";
+import { isRecord } from "./helpers.js";
+import { loadPluginMcpServerDefinitions } from "./mcp.js";
+import { FLEET_EXTENSION_NAMESPACE, readPluginPackage } from "./index.js";
+
+/**
+ * Export a plugin as an Agent Plugins 1.0.0 package (OV-100 phase 5): root `plugin.json`,
+ * `mcp.json` and the package files, so it installs into any Agent Plugins client. Format:
+ * harnessrouter `protocol/versions/2026-09-28/plugins.md` §1, §2.2 and §5 (export rules).
+ * Credentials (`headers`, `auth`, `oauth`) never travel; what Agent Plugins has no place for is
+ * reported as skipped, and Fleet-only data rides in `extensions["fleet.workbench"]`.
+ */
+
+export const AGENT_PLUGINS_SCHEMA = "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json";
+const MANIFEST_DIRECTORIES = new Set([".zcode-plugin", ".claude-plugin", ".codex-plugin"]);
+const REPLACED_FILES = new Set(["plugin.json", "mcp.json", ".mcp.json"]);
+const NON_PORTABLE = ["hooks", "commands", "agents", "lspServers", "outputStyles", "channels", "settings"] as const;
+const PLACEHOLDERS: Array<[RegExp, string]> = [
+  [/\$\{(?:CLAUDE|ZCODE)_PLUGIN_ROOT\}/g, "${PLUGIN_ROOT}"],
+  [/\$\{(?:CLAUDE|ZCODE)_PLUGIN_DATA\}/g, "${PLUGIN_DATA}"],
+];
+
+export interface AgentPluginsExportResult {
+  path: string;
+  skipped: Array<{ path: string; reason: string }>;
+}
+
+/** Agent Plugins §5.5 name: lower-case, `[a-z0-9.-]`, no `--` or `..`, at most 64 characters. */
+export function agentPluginsName(name: string): string {
+  return (
+    name
+      .toLowerCase()
+      .replace(/[^a-z0-9.]+/g, "-")
+      .replace(/\.{2,}/g, ".")
+      .replace(/-{2,}/g, "-")
+      .replace(/^[-.]+|[-.]+$/g, "")
+      .slice(0, 64)
+      .replace(/[-.]+$/g, "") || "plugin"
+  );
+}
+
+export function exportAgentPluginsPackage(input: {
+  rootPath: string;
+  targetDirectory: string;
+}): AgentPluginsExportResult {
+  const diagnostics: PluginDiagnostic[] = [];
+  const loaded = readPluginPackage(input.rootPath, diagnostics);
+  if (!loaded) {
+    throw new Error(diagnostics[0]?.message ?? `Not a plugin folder: ${input.rootPath}`);
+  }
+  const name = agentPluginsName(loaded.manifest.name);
+  const destination = join(input.targetDirectory, name);
+  if (existsSync(destination)) throw new Error(`${destination} already exists; choose another folder.`);
+  const skipped: AgentPluginsExportResult["skipped"] = [];
+
+  mkdirSync(destination, { recursive: true });
+  cpSync(loaded.rootPath, destination, {
+    recursive: true,
+    filter: (source) => {
+      const path = relative(loaded.rootPath, source);
+      if (!path) return true;
+      const [first] = path.split(sep);
+      if (first === ".git") return false;
+      if (first && MANIFEST_DIRECTORIES.has(first)) return false;
+      return !(REPLACED_FILES.has(path));
+    },
+  });
+
+  const manifest = loaded.manifest as unknown as Record<string, unknown>;
+  for (const key of NON_PORTABLE) {
+    if (manifest[key] !== undefined || isNonEmptyDirectory(join(loaded.rootPath, key))) {
+      skipped.push({ path: key, reason: `Agent Plugins has no ${key}; the files are kept but other clients ignore them.` });
+    }
+  }
+
+  const servers: Record<string, unknown> = {};
+  for (const [key, raw] of Object.entries(loadPluginMcpServerDefinitions({ diagnostics, loaded }))) {
+    if (!isRecord(raw)) continue;
+    const server: Record<string, unknown> = { ...raw };
+    for (const secret of ["headers", "auth", "oauth"] as const) {
+      if (server[secret] !== undefined) {
+        delete server[secret];
+        skipped.push({ path: `mcp.json#/mcpServers/${key}/${secret}`, reason: "Credentials are not exported; enter them again after installing." });
+      }
+    }
+    const type = typeof server.type === "string" ? server.type : typeof server.url === "string" ? "http" : "stdio";
+    server.type = type === "http" ? "streamable-http" : type;
+    servers[key] = withPortablePlaceholders(server);
+  }
+  if (Object.keys(servers).length > 0) {
+    writeJson(join(destination, "mcp.json"), { mcpServers: servers });
+  }
+
+  const fleet: Record<string, unknown> = {};
+  if (isRecord(manifest.fleet) && Array.isArray(manifest.fleet.views)) fleet.views = manifest.fleet.views;
+  if (isRecord(manifest.userConfig)) fleet.userConfig = manifest.userConfig;
+  const author = isRecord(manifest.author)
+    ? manifest.author
+    : typeof manifest.author === "string"
+      ? { name: manifest.author }
+      : undefined;
+  const repository = isRecord(manifest.repository) && typeof manifest.repository.url === "string"
+    ? manifest.repository.url
+    : typeof manifest.repository === "string"
+      ? manifest.repository
+      : undefined;
+  writeJson(join(destination, "plugin.json"), {
+    $schema: AGENT_PLUGINS_SCHEMA,
+    name,
+    ...(typeof manifest.version === "string" ? { version: manifest.version } : {}),
+    ...(typeof manifest.description === "string" ? { description: manifest.description } : {}),
+    ...(author ? { author } : {}),
+    ...(typeof manifest.homepage === "string" ? { homepage: manifest.homepage } : {}),
+    ...(repository ? { repository } : {}),
+    ...(typeof manifest.license === "string" ? { license: manifest.license } : {}),
+    ...(Array.isArray(manifest.keywords) ? { keywords: manifest.keywords.filter((k) => typeof k === "string") } : {}),
+    ...(Object.keys(fleet).length > 0 ? { extensions: { [FLEET_EXTENSION_NAMESPACE]: fleet } } : {}),
+  });
+  return { path: destination, skipped };
+}
+
+function withPortablePlaceholders(value: unknown): unknown {
+  if (typeof value === "string") {
+    return PLACEHOLDERS.reduce((text, [pattern, replacement]) => text.replace(pattern, replacement), value);
+  }
+  if (Array.isArray(value)) return value.map(withPortablePlaceholders);
+  if (isRecord(value)) {
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, withPortablePlaceholders(item)]));
+  }
+  return value;
+}
+
+function isNonEmptyDirectory(path: string): boolean {
+  try {
+    return statSync(path).isDirectory() && readdirSync(path).length > 0;
+  } catch {
+    return false;
+  }
+}
+
+function writeJson(path: string, value: unknown): void {
+  writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`);
+}
