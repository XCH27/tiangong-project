+test(
+  "public Host Stop cancels queued automatic admission before dispatch",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture([]);
+    const entered = Promise.withResolvers<void>();
+    const standard = {
+      providerId: f.providerId,
+      modelId: "middle-model",
+      options: { reasoningLevel: "off" },
+    };
+    const host = await hostFixture(undefined, false, {
+      config: { modelSelection: standard as never },
+      deps: {
+        decisionModelPort: f.port,
+        modelRequestAdmission: {
+          acquire: async ({ model, signal }: any) => {
+            if (model.modelId !== "small-model") return { release() {}, publish: async () => {} };
+            entered.resolve();
+            return new Promise((_resolve, reject) =>
+              signal.addEventListener("abort", () => reject(signal.reason), { once: true }),
+            );
+          },
+        } as never,
+      },
+    });
+    try {
+      await f.save({
+        newConversationModelPolicy: "automatic",
+        decisionModelSettings: {
+          enabled: true,
+          selection: { providerId: f.providerId, modelId: "small-model" },
+          automaticTiers: {
+            standard: { providerId: f.providerId, modelId: "middle-model" },
+            deep: { providerId: f.providerId, modelId: "large-model" },
+          },
+        },
+      });
+      const turn = host.runtime.executeTurn("Wait for synthetic admission", undefined, {
+        inputId: "queued",
+        intent: { allowAutomaticModelSelection: true, modelSelection: standard },
+      } as never);
+      const rejected = assert.rejects(turn);
+      await entered.promise;
+      host.runtime.stopActiveForegroundExecution();
+      await rejected;
+      assert.equal(f.prompts.length, 0);
+      assert.equal(host.requests.length, 0);
+      await host.reopen();
+      assert.equal(f.prompts.length, 0);
+    } finally {
+      await host.close();
+      await f.close();
+    }
+  },
+);
