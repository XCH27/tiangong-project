+/** 复用 Host 的 artifact/Session 用量所有者；未知收据在冷恢复后也阻止重发。 */
+async function executeAutomaticDecision(
+  runtime: AgentRuntimeInternal,
+  request: DecisionInput,
+  offered: ModelSelection,
+  prompt: string,
+  operation: { signal: AbortSignal; trace: TraceContext; inputId?: string },
+): Promise<DecisionModelResult> {
+  const port = runtime.decisionModelPort!;
+  const artifacts = runtime.artifactStore;
+  const usage = runtime.sessionStore as Partial<UsageStorePort> | undefined;
+  if (
+    !artifacts?.writeToolResultArtifactOnce ||
+    !usage?.recordModelUsage ||
+    !runtime.sessionStore?.saveSessionEntry
+  )
+    throw new Error(
+      "Automatic decision receipt/accounting storage unavailable; no inference was made",
+    );
+  const signal = AbortSignal.any([operation.signal, AbortSignal.timeout(10000)]);
+  signal.throwIfAborted();
+  const key = createHash("sha256")
+    .update(
+      JSON.stringify([
+        runtime.sessionId,
+        operation.inputId !== undefined
+          ? ["input", operation.inputId]
+          : ["fallback", prompt, offered],
+      ]),
+    )
+    .digest("hex");
+  const id = `automatic-decision:${key}`;
+  const prepared = await port.prepare(request, signal);
+  const startedAt = Date.now();
+  const artifact = (suffix: string, content: unknown) =>
+    artifacts.writeToolResultArtifactOnce!({
+      sessionId: runtime.sessionId,
+      toolCallId: id,
+      toolName: "DecisionReceipt",
+      idempotencyKey: `${id}:${suffix}`,
+      content: JSON.stringify(content),
+      contentType: "application/json",
+      retention: "session",
+      trace: operation.trace,
+    });
+  const claim = await artifact("intent", {
+    version: 1,
+    status: "unknown",
+    id,
+    model: prepared.model,
+    offered,
+    inputDigest: prepared.inputDigest,
+    startedAt,
+  });
+  if (!claim.created)
+    throw new Error("Automatic decision may already exist; no repeated inference was made");
+  let result: DecisionModelResult;
+  try {
+    result = await port.classify({
+      ...request,
+      binding: prepared.binding,
+      signal,
+      admission: runtime.modelRequestAdmission,
+      trace: operation.trace,
+    });
+  } catch {
+    result = {
+      status: signal.aborted ? "cancelled" : "error",
+      requestedModel: prepared.model,
+      inputDigest: prepared.inputDigest,
+      answers: {},
+      message: "Automatic decision binding unavailable",
+    };
+  }
+  const completedAt = Date.now();
+  const record: ModelUsageRecord = {
+    id,
+    logicalRequestId: id,
+    sessionID: runtime.sessionId,
+    turnID: operation.trace.turnId,
+    traceID: operation.trace.traceId,
+    querySource: "decision_classification",
+    providerId: result.requestedModel.providerId,
+    modelId: result.requestedModel.modelId,
+    startedAt,
+    completedAt,
+    status:
+      result.status === "completed"
+        ? "completed"
+        : result.status === "cancelled"
+          ? "cancelled"
+          : "error",
+    inputTokens: result.usage?.inputTokens,
+    outputTokens: result.usage?.outputTokens,
+    rawUsage: result.usage,
+    errorMessage: result.message,
+    providerMetadata: {
+      operation: "classifier",
+      reportedModelId: result.reportedModelId,
+      inputDigest: result.inputDigest,
+      fleetAccounting: {
+        billingProvider: result.billingProvider,
+        workspacePath: runtime.config.workspacePath,
+        reportedRequestUsd: result.reportedCostUsd,
+      },
+    },
+  };
+  let usageRecorded = true;
+  let usageRecoveryPending = false;
+  try {
+    await usage.recordModelUsage!(record);
+  } catch {
+    usageRecorded = false;
+    // 复用已有 Session 恢复指令；已提交但回执丢失也按原始 ID 对账，绝不重发推理。
+    try {
+      await retainPendingModelUsage(runtime, record);
+      usageRecoveryPending = true;
+    } catch (error) {
+      runtime.logger?.warn("Automatic decision usage recovery instruction unavailable", {
+        event: "usage.model.recovery.failed",
+        module: "core.runtime",
+        receiptId: id,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+  await artifact("result", {
+    version: 1,
+    id,
+    startedAt,
+    completedAt,
+    ...result,
+    usageRecorded,
+    usageRecoveryPending,
+  });
+  signal.throwIfAborted();
+  if (!usageRecorded)
+    throw new Error("Automatic decision accounting unavailable; retaining offered model");
+  return result;
+}
