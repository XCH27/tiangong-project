diff --git a/apps/zcode-cli/packages/adapters/src/model/decision-observed-facts.ts b/apps/zcode-cli/packages/adapters/src/model/decision-observed-facts.ts
new file mode 100644
index 0000000..ff12eaa
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/decision-observed-facts.ts
@@ -0,0 +1,29 @@
+export const observedTokenCount = (value: unknown) =>
+  typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+
+export function reportedFacts(wire?: Record<string, any>) {
+  const usage =
+    wire?.usage && typeof wire.usage === "object"
+      ? {
+          ...(observedTokenCount(wire.usage.input_tokens) === undefined
+            ? {}
+            : { inputTokens: observedTokenCount(wire.usage.input_tokens) }),
+          ...(observedTokenCount(wire.usage.output_tokens) === undefined
+            ? {}
+            : { outputTokens: observedTokenCount(wire.usage.output_tokens) }),
+        }
+      : undefined;
+  const model =
+    typeof wire?.model === "string" && wire.model.length <= 256 ? wire.model : undefined;
+  const cost =
+    typeof wire?.usage?.cost === "number" &&
+    Number.isFinite(wire.usage.cost) &&
+    wire.usage.cost >= 0
+      ? wire.usage.cost
+      : undefined;
+  return {
+    ...(usage && Object.keys(usage).length ? { usage } : {}),
+    ...(model ? { reportedModelId: model } : {}),
+    ...(cost === undefined ? {} : { reportedCostUsd: cost }),
+  };
+}
