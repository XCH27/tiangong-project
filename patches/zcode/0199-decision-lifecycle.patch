index 0000000..679b325
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/automatic-model-intent.test.ts
@@ -0,0 +1,227 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import type { DecisionModelPort } from "@zcode/contracts";
+import {
+  parseCommandEnvelope,
+  queueItemSchema,
+  conversationInputIntentSchema,
+} from "@zcode/shared/zcode-protocol-v4";
+import { fixture, reply, selection } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { createInputFacade } from "../src/app/input-facade.js";
+import { V4CommandExecutor } from "../src/zcode-protocol-v4/commands/executor.js";
+import {
+  inputIntentMetadata,
+  inputIntentMetadataFromCanonical,
+  inputIntentMetadataFromQueueItem,
+} from "../src/zcode-protocol-v4/commands/input-intent.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { synthesizeEventsFromMessages } from "../src/zcode-protocol-v4/transcript-hydration.js";
+
+for (const { marker, taskType } of [
+  { marker: true },
+  { marker: false },
+  { marker: undefined },
+  { marker: true, taskType: "page_assistant" },
+]) {
+  test(`native protocol admission retains automatic-default marker ${String(marker)} for ${taskType ?? "interactive"} through runtime and cold hydration`, async () => {
+    let routed = 0;
+    const port: DecisionModelPort = {
+      isAvailable: () => true,
+      listModels: () => [],
+      prepare: async () => {
+        throw new Error("No classification in this metadata fixture");
+      },
+      classify: async () => {
+        throw new Error("No classification in this metadata fixture");
+      },
+      automaticModel: async () => {
+        routed++;
+        return {};
+      },
+    };
+    const f = await fixture(undefined, false, {
+      config: { taskType: taskType as never },
+      deps: { decisionModelPort: port },
+    });
+    const runtime = f.runtime;
+    const projection = new ProductProjection("session", "live");
+    const unsubscribe = runtime.subscribeEvents({
+      onSessionEvent: async (event) => {
+        projection.applyEvent(event);
+      },
+    });
+    const trace = (runtime as any).rootTraceContext;
+    const facade = createInputFacade({
+      runtime,
+      sessionId: "session" as never,
+      traceContext: trace,
+      logger: { info() {}, warn() {}, error() {}, debug() {} } as never,
+      prepareUserExecutionBoundary: async () => {},
+    });
+    let completion: Promise<unknown> | undefined;
+    let submitted: any;
+    const record = {
+      app: {
+        ...facade,
+        sessionId: "session",
+        runtime,
+        getModel: () => "fixture/model-a",
+        getMode: () => "build",
+        sendInput: async (input: any, options: any) => {
+          submitted = options.intent;
+          const admitted = await facade.sendInput(input, options);
+          if (admitted.kind === "started_turn") completion = admitted.completion;
+          return admitted;
+        },
+      },
+      traceContext: trace,
+      workspace: { workspacePath: f.dir },
+      persistence: "immediate",
+      taskType: taskType ?? "interactive",
+    };
+    const executor = new V4CommandExecutor({
+      getRecord: () => record,
+      getInputRoutingMode: () => null,
+    } as never);
+    const parsed = parseCommandEnvelope({
+      commandId: "first",
+      clientId: "desktop",
+      sessionId: "session",
+      type: "sendText",
+      issuedAt: Date.now(),
+      payload: {
+        text: "Synthetic first input",
+        modelSelection: selection(),
+        ...(marker === undefined ? {} : { allowAutomaticModelSelection: marker }),
+      },
+    });
+    assert.equal(parsed.ok, true);
+    if (!parsed.ok) return;
+    try {
+      f.steps.push(() => reply("Synthetic result"));
+      await executor.execute(parsed.envelope, {
+        admissionSeq: 1,
+        admittedAt: Date.now(),
+        queueItemId: "queue-first",
+      });
+      assert.ok(completion);
+      await completion;
+      assert.equal(submitted.allowAutomaticModelSelection, marker);
+      assert.equal(routed, marker === true && taskType === undefined ? 1 : 0);
+      const messages = await f.store.messages({ sessionID: "session" as never });
+      const user = messages.find((message) => message.info.role === "user")!;
+      const retained = conversationInputIntentSchema.parse(
+        user.info.metadata?.conversationInputIntent,
+      );
+      assert.equal(retained.allowAutomaticModelSelection, marker);
+      const liveRow = projection.getSnapshot().rows.window.find((row) => row.kind === "userInput")!;
+      assert.equal(
+        projection.resolveEditTarget(liveRow.rowId)?.intent.allowAutomaticModelSelection,
+        marker,
+      );
+      await f.reopen();
+      const cold = new ProductProjection("session", "cold");
+      const restored = await f.store.messages({ sessionID: "session" as never });
+      cold.beginHydrationReplay();
+      for (const event of synthesizeEventsFromMessages(restored, { sessionId: "session" }))
+        cold.applyHydrationEvent(event);
+      cold.completeHydrationReplay();
+      const coldRow = cold.getSnapshot().rows.window.find((row) => row.kind === "userInput")!;
+      const canonical = cold.resolveEditTarget(coldRow.rowId)!.intent;
+      assert.equal(canonical.allowAutomaticModelSelection, marker);
+      const queued = queueItemSchema.parse({
+        ...retained,
+        delivery: { requested: "queue", admitted: "queue" },
+        dispatch: { state: "queued" },
+      });
+      assert.equal(
+        inputIntentMetadataFromQueueItem(queued, queued.text).allowAutomaticModelSelection,
+        marker,
+      );
+      assert.equal(
+        inputIntentMetadataFromCanonical({ ...parsed.envelope, commandId: "retry" }, canonical)
+          .allowAutomaticModelSelection,
+        marker,
+      );
+      assert.equal(
+        routed,
+        marker === true && taskType === undefined ? 1 : 0,
+        "cold hydration must not invoke the optional decision",
+      );
+    } finally {
+      unsubscribe();
+      await f.close();
+    }
+  });
+}
+
+for (const delivery of ["queue", "guide"] as const) {
+  for (const marker of [true, false]) {
+    test(`${delivery} projection preserves explicit automatic marker ${marker} through drain and canonical retry`, () => {
+      const projection = new ProductProjection("session", "projection");
+      const envelope = {
+        commandId: "queued",
+        clientId: "desktop",
+        sessionId: "session",
+        type: "sendText",
+        issuedAt: 1,
+        payload: {},
+      } as const;
+      const intent = inputIntentMetadata(envelope, {
+        text: "Queued input",
+        modelSelection: selection(),
+        allowAutomaticModelSelection: marker,
+        requestedDelivery: delivery,
+        admittedDelivery: delivery,
+      });
+      const event = (type: string, sequenceNumber: number, payload: unknown) =>
+        ({
+          id: `event-${sequenceNumber}`,
+          sessionId: "session",
+          turnId: "parent",
+          traceId: "trace",
+          timestamp: new Date(sequenceNumber),
+          type,
+          sequenceNumber,
+          payload,
+        }) as never;
+      projection.applyEvent(
+        event(SessionEventType.TurnSteerQueued, 1, {
+          pendingInputId: intent.queueItemId,
+          inputId: "queued",
+          input: "Queued input",
+          inputPreview: "Queued input",
+          inputSize: 12,
+          targetTurnId: "parent",
+          queueLength: 1,
+          delivery,
+          intent,
+        }),
+      );
+      const queued = projection.getSnapshot().queue.items[0]!;
+      assert.equal(queued.allowAutomaticModelSelection, marker);
+      assert.equal(
+        inputIntentMetadataFromQueueItem(queued, queued.text).allowAutomaticModelSelection,
+        marker,
+      );
+      projection.applyEvent(
+        event(SessionEventType.TurnSteerDrained, 2, {
+          pendingInputIds: [queued.queueItemId],
+          injectedMessageIds: ["injected"],
+          targetTurnId: "parent",
+        }),
+      );
+      const row = projection
+        .getSnapshot()
+        .rows.window.find((candidate) => candidate.kind === "userInput")!;
+      const canonical = projection.resolveEditTarget(row.rowId)!.intent;
+      assert.equal(canonical.allowAutomaticModelSelection, marker);
+      assert.equal(
+        inputIntentMetadataFromCanonical({ ...envelope, commandId: "retry" }, canonical)
+          .allowAutomaticModelSelection,
+        marker,
+      );
+    });
+  }
+}
