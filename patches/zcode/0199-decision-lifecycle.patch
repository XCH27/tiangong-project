@@ -0,0 +1,66 @@
+import type { DecisionModelPort } from "@zcode/contracts";
+import type { ProviderRegistryServiceSnapshot } from "@zcode/provider";
+import { decisionInputSchema, type DecisionInput, type DecisionModelRef } from "@zcode/shared";
+import { AUTOMATIC_TIER_QUESTION } from "./decision-chat.js";
+
+type AutomaticModel = NonNullable<DecisionModelPort["automaticModel"]>;
+
+/** Policy only: the required callback dispatches through the existing Host owners. */
+export async function routeAutomaticDecision(
+  value: Parameters<AutomaticModel>[0],
+  signal: Parameters<AutomaticModel>[1],
+  execute: Parameters<AutomaticModel>[2],
+  input: {
+    getSnapshot(): ProviderRegistryServiceSnapshot | null;
+    refresh(signal: AbortSignal): Promise<unknown>;
+    isAvailable(): boolean;
+  },
+): ReturnType<AutomaticModel> {
+  const snapshot = input.getSnapshot();
+  const tiers = snapshot?.config.decisionModelSettings?.automaticTiers;
+  const standard = tiers?.standard;
+  const same = (ref?: DecisionModelRef) =>
+    ref?.providerId === value.current.providerId && ref?.modelId === value.current.modelId;
+  if (snapshot?.config.newConversationModelPolicy !== "automatic" || !standard || !same(standard))
+    return {};
+  const executable = (ref?: DecisionModelRef) =>
+    Boolean(
+      ref &&
+      (input.getSnapshot()?.resolution.resolvedProviders ?? [])
+        .find((provider) => provider.providerId === ref.providerId)
+        ?.models.find((model) => model.modelId === ref.modelId)?.executable,
+    );
+  if (value.prompt.length > 6000) return { tier: "standard", reason: "evidence-incomplete" };
+  let request: DecisionInput;
+  try {
+    request = decisionInputSchema.parse({
+      state: value.prompt,
+      questions: AUTOMATIC_TIER_QUESTION,
+    });
+  } catch {
+    return {};
+  }
+  if (!input.isAvailable()) return { tier: "standard", reason: "decision-unavailable" };
+  const result = await execute(request);
+  signal.throwIfAborted();
+  await input.refresh(signal);
+  signal.throwIfAborted();
+  const latest = input.getSnapshot();
+  // 策略或档位撤回后，不使用请求开始时捕获的旧选择。
+  if (
+    latest?.config.newConversationModelPolicy !== "automatic" ||
+    JSON.stringify(latest.config.decisionModelSettings?.automaticTiers) !== JSON.stringify(tiers) ||
+    !latest.config.decisionModelSettings?.enabled
+  )
+    return { tier: "standard", reason: "policy-changed" };
+  const choice = (result.answers.tier as { choice?: string } | undefined)?.choice;
+  if (result.status !== "completed" || (choice !== "fast" && choice !== "deep"))
+    return {
+      tier: "standard",
+      reason: result.status === "completed" ? "decision" : "decision-unavailable",
+    };
+  const target = tiers[choice];
+  return executable(target)
+    ? { selection: { ...target! }, tier: choice, reason: "decision" }
+    : { tier: "standard", reason: "tier-unavailable" };
+}
