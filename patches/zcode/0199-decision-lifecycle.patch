+for (const failure of ["stop", "policy", "tier", "observer", "refresh"] as const) {
+  test(
+    `public Host lifecycle ${failure} uses existing admission, usage and receipts`,
+    { timeout: 15000 },
+    async () => {
+      let host: Awaited<ReturnType<typeof hostFixture>>;
+      let f: Awaited<ReturnType<typeof fixture>>;
+      f = await fixture(
+        [
+          JSON.stringify({
+            answers: {
+              tier: {
+                type: "choice",
+                choice: "deep",
+                probabilities: { fast: 0.1, standard: 0.1, deep: 0.8 },
+              },
+            },
+          }),
+        ],
+        async () => {
+          if (failure === "stop") host.runtime.stopActiveForegroundExecution();
+          if (failure === "refresh") await f.save({ decisionModelSettings: { enabled: false } });
+          if (failure === "policy") await f.save({ newConversationModelPolicy: "recent" });
+          if (failure === "tier")
+            await f.save({
+              decisionModelSettings: {
+                enabled: true,
+                selection: { providerId: f.providerId, modelId: "small-model" },
+                automaticTiers: { standard: { providerId: f.providerId, modelId: "middle-model" } },
+              },
+            });
+        },
+      );
+      const standard = {
+        providerId: f.providerId,
+        modelId: "middle-model",
+        options: { reasoningLevel: "off" },
+      };
+      let decisionAdmission = 0;
+      let decisionReleased = 0;
+      host = await hostFixture(undefined, false, {
+        config: { modelSelection: standard as never },
+        deps: {
+          decisionModelPort: f.port,
+          modelRequestAdmission: {
+            acquire: async ({ model }: any) => {
+              const decision = model.modelId === "small-model";
+              if (decision) decisionAdmission++;
+              return {
+                release() {
+                  if (decision) decisionReleased++;
+                },
+                publish: async (event: any) => {
+                  if (
+                    decision &&
+                    failure === "observer" &&
+                    event.type === "model_request_completed"
+                  )
+                    throw new Error("observer failed");
+                },
+              };
+            },
+          } as never,
+        },
+      });
+      // The real model factory supplies default options for a tier reference.
+      const modelFactory = (host.runtime as any).modelFactory;
+      (host.runtime as any).modelFactory = (value: any) =>
+        modelFactory({
+          ...value,
+          selection: {
+            ...value.selection,
+            options: value.selection.options ?? { reasoningLevel: "off" },
+          },
+        });
+      try {
+        await f.save({
+          newConversationModelPolicy: "automatic",
+          decisionModelSettings: {
+            enabled: true,
+            selection: { providerId: f.providerId, modelId: "small-model" },
+            automaticTiers: {
+              standard: { providerId: f.providerId, modelId: "middle-model" },
+              deep: { providerId: f.providerId, modelId: "large-model" },
+            },
+          },
+        });
+        host.steps.push(() => reply("Original model retained"));
+        const turn = host.runtime.executeTurn("Synthetic automatic task", undefined, {
+          inputId: `input-${failure}`,
+          intent: { allowAutomaticModelSelection: true, modelSelection: standard },
+        } as never);
+        if (failure === "stop") await assert.rejects(turn);
+        else await turn;
+        assert.equal(f.prompts.length, 1);
+        if (failure === "stop") assert.equal(host.requests.length, 0);
+        else assert.equal(host.requests[0]?.selection.modelId, "middle-model");
+        const db = new DatabaseSync(join(host.dir, "session.sqlite"), { readOnly: true });
+        try {
+          const rows = db
+            .prepare(
+              "select input_tokens, output_tokens from model_usage where query_source = 'decision_classification'",
+            )
+            .all();
+          assert.equal(rows.length, 1);
+          assert.equal(rows[0]?.input_tokens, 40);
+          assert.equal(rows[0]?.output_tokens, 12);
+        } finally {
+          db.close();
+        }
+        assert.equal(decisionAdmission, 1);
+        assert.equal(decisionReleased, 1);
+        await host.reopen();
+        assert.equal(f.prompts.length, 1, "cold recovery must not submit auxiliary inference");
+      } finally {
+        await host.close();
+        await f.close();
+      }
+    },
+  );
+}
