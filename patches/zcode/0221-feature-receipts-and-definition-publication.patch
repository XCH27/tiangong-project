diff --git a/packages/ui/src/store/skillStoreRequests.ts b/packages/ui/src/store/skillStoreRequests.ts
new file mode 100644
index 00000000..1f721c98
--- /dev/null
+++ b/packages/ui/src/store/skillStoreRequests.ts
@@ -0,0 +1,110 @@
+import type { ISkillsService } from "@zcode/services";
+import type { ZCodeProvider } from "@zcode/shared";
+
+export interface SkillRequestScope {
+  workspacePath: string | null;
+  workspaceIdentity: string | null;
+  provider: ZCodeProvider;
+}
+type Get = () => SkillRequestScope;
+interface RequestOwner {
+  key: string;
+  service: ISkillsService;
+  epoch: number;
+  generation: number;
+}
+interface PendingRead {
+  owner: RequestOwner;
+  epoch: number;
+  generation: number;
+  promise: ReturnType<ISkillsService["list"]>;
+}
+// 只登记原 store 的请求归属及 pending Promise；技能事实仍仅存在于原 SkillStore。
+const owners = new WeakMap<Get, RequestOwner>();
+const inFlight = new WeakMap<ISkillsService, Map<string, PendingRead>>();
+function scopeKey(scope: SkillRequestScope): string {
+  return JSON.stringify([scope.workspacePath, scope.workspaceIdentity, scope.provider]);
+}
+function capture(get: Get, scope: SkillRequestScope, service: ISkillsService) {
+  const key = scopeKey(scope);
+  let owner = owners.get(get);
+  const changed =
+    !owner || owner.key !== key || owner.service !== service || scopeKey(get()) !== owner.key;
+  if (!owner) {
+    owner = { key, service, epoch: 0, generation: 0 };
+    owners.set(get, owner);
+  } else if (changed) {
+    owner.key = key;
+    owner.service = service;
+    owner.epoch++;
+    owner.generation++;
+  }
+  return { owner, key, epoch: owner.epoch, changed };
+}
+function token(get: Get, context: ReturnType<typeof capture>, generation: number) {
+  return {
+    changed: context.changed,
+    isCurrent: () =>
+      context.owner.epoch === context.epoch &&
+      context.owner.generation === generation &&
+      scopeKey(get()) === context.key,
+  };
+}
+
+export function invalidateSkillRequests(get: Get): void {
+  const owner = owners.get(get);
+  if (owner) {
+    owner.epoch++;
+    owner.generation++;
+  }
+}
+
+export function beginSkillRead(
+  get: Get,
+  scope: SkillRequestScope,
+  service: ISkillsService,
+  forceFresh = false,
+) {
+  const context = capture(get, scope, service);
+  let reads = inFlight.get(service);
+  if (!reads) {
+    reads = new Map();
+    inFlight.set(service, reads);
+  }
+  const existing = reads.get(context.key);
+  // 同服务同 scope 的首屏消费者共享当前请求；ABA 不得加入前一 epoch 的 A。
+  if (
+    !forceFresh &&
+    !context.changed &&
+    existing?.owner === context.owner &&
+    existing.epoch === context.epoch &&
+    existing.generation === context.owner.generation
+  ) {
+    return { ...token(get, context, existing.generation), promise: existing.promise };
+  }
+  const generation = ++context.owner.generation;
+  const pending: PendingRead = {
+    owner: context.owner,
+    epoch: context.epoch,
+    generation,
+    promise: Promise.resolve()
+      .then(() =>
+        service.list({
+          workspacePath: scope.workspacePath!,
+          workspaceIdentity: scope.workspaceIdentity ?? undefined,
+          provider: scope.provider,
+        }),
+      )
+      .finally(() => {
+        // 旧 failure/finally 只能释放自己的 pending 登记，不能清除较新的强制读取。
+        if (reads.get(context.key) === pending) reads.delete(context.key);
+      }),
+  };
+  reads.set(context.key, pending);
+  return { ...token(get, context, generation), promise: pending.promise };
+}
+
+export function beginSkillMutation(get: Get, service: ISkillsService) {
+  const context = capture(get, get(), service);
+  return token(get, context, ++context.owner.generation);
+}
