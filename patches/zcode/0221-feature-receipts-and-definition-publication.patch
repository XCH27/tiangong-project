diff --git a/packages/ui/src/app-shell/useWorkflowRunControl.ts b/packages/ui/src/app-shell/useWorkflowRunControl.ts
new file mode 100644
index 00000000..c6917290
--- /dev/null
+++ b/packages/ui/src/app-shell/useWorkflowRunControl.ts
@@ -0,0 +1,237 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import type { WorkflowRunState } from "@zcode/shared/zcode-protocol-v4";
+import type { V4ConversationContextValue } from "@/v4/V4ConversationContext.js";
+import type { ConversationStoreState } from "@/v4/conversationProjectionStore.js";
+import type { PaneWorkspaceScope } from "@/v4/paneLayoutStore.js";
+import { pendingCommandRegistry } from "@/v4/pendingCommandRegistry.js";
+import { workflowControlAckDisposition } from "@/v4/pendingCommandReplay.js";
+import { createCommandEnvelope } from "@/v4/commandFactory.js";
+import {
+  describeWorkflowRunActionRejection,
+  type WorkflowRunAction,
+  type WorkflowRunActionRejection,
+} from "./workflowRunActionRejection.js";
+import {
+  checkWorkflowRunControl,
+  dispatchWorkflowRunControl,
+  workflowRunControlEntries,
+  type WorkflowRunControlOutcome,
+} from "./useWorkflowRunControlHelpers.js";
+
+/** registry 是唯一未结命令所有者；ref 只做当前视图 single-flight 与换代防护。 */
+export function useWorkflowRunControl(input: {
+  conversation: V4ConversationContextValue;
+  scope: PaneWorkspaceScope;
+  sessionId: string;
+  runId: string;
+  workflowName?: string;
+  run: WorkflowRunState | undefined;
+  projection: ConversationStoreState;
+  canCancel: boolean;
+  canResume: boolean;
+}) {
+  const { conversation, scope, sessionId, runId, run, projection } = input;
+  const token = useMemo(
+    () => Symbol("workflow-control-view"),
+    [
+      conversation,
+      scope.workspacePath,
+      scope.workspaceIdentity,
+      scope.remoteSessionId,
+      sessionId,
+      runId,
+      projection.status,
+      projection.subscriptionId,
+      projection.snapshot?.logEpoch,
+    ],
+  );
+  const current = useRef<{ token: symbol; logEpoch: string | null } | null>(null);
+  const flight = useRef<{ token: symbol; commandId: string; kind: "dispatch" | "query" } | null>(
+    null,
+  );
+  const [version, setVersion] = useState(0);
+  const [rejection, setRejection] = useState<WorkflowRunActionRejection>();
+  const refresh = useCallback(() => setVersion((value) => value + 1), []);
+  useLayoutEffect(() => {
+    current.current = { token, logEpoch: projection.snapshot?.logEpoch ?? null };
+    return () => {
+      if (current.current?.token === token) current.current = null;
+    };
+  }, [token, projection.snapshot?.logEpoch]);
+  useEffect(() => pendingCommandRegistry.subscribe(refresh), [refresh]);
+  useEffect(() => setRejection(undefined), [token, run?.status]);
+  void version;
+  const entries = workflowRunControlEntries(sessionId, runId, scope);
+  const entry = entries[0];
+  const live = projection.status === "live" && projection.snapshot?.sessionId === sessionId;
+  const activeFlight = flight.current?.token === token ? flight.current : null;
+  const checking = activeFlight?.kind === "query";
+  const delivery = entry?.workflowControl?.delivery;
+  const phase =
+    delivery === "accepted"
+      ? "accepted"
+      : entry && activeFlight?.kind === "dispatch"
+        ? "pending"
+        : entry
+          ? "unknown"
+          : undefined;
+
+  useEffect(() => {
+    const snapshot = projection.snapshot;
+    if (!live || !snapshot) return;
+    // 仅当前解析 scope 的 receipt 消费投影；generic Session recovery 不对控制命令清账。
+    for (const pending of workflowRunControlEntries(sessionId, runId, scope)) {
+      pendingCommandRegistry.reconcileWorkflowControlProjection(pending.commandId, snapshot);
+    }
+  }, [live, projection.snapshot, sessionId, runId, scope, version]);
+
+  const applyOutcome = useCallback(
+    (action: WorkflowRunAction, outcome: WorkflowRunControlOutcome) => {
+      if (current.current?.token !== token) return;
+      if (outcome.kind === "receipt") {
+        const type = action === "cancel" ? "cancelBackgroundWork" : "resumeWorkflowRun";
+        if (workflowControlAckDisposition(type, outcome.ack) === "settled") {
+          setRejection(describeWorkflowRunActionRejection(action, outcome.ack));
+        }
+      } else if (outcome.kind === "not_sent") {
+        setRejection({
+          action,
+          reason:
+            outcome.code === "client.workflowControlReceiptUnavailable"
+              ? "receipt_unavailable"
+              : "generic",
+          code: outcome.code,
+        });
+      }
+    },
+    [token],
+  );
+
+  const send = useCallback(
+    async (action: WorkflowRunAction) => {
+      const snapshot = projection.snapshot;
+      if (
+        current.current?.token !== token ||
+        flight.current?.token === token ||
+        !live ||
+        !snapshot ||
+        !run ||
+        (action === "cancel" ? !input.canCancel : !input.canResume)
+      )
+        return;
+      if (workflowRunControlEntries(sessionId, runId, scope).length) return;
+      const envelope =
+        action === "cancel"
+          ? createCommandEnvelope({
+              type: "cancelBackgroundWork",
+              payload: { workId: runId },
+              sessionId,
+            })
+          : createCommandEnvelope({
+              type: "resumeWorkflowRun",
+              payload: {
+                workId: runId,
+                ...(input.workflowName?.trim() ? { name: input.workflowName.trim() } : {}),
+              },
+              sessionId,
+            });
+      const operation = { token, commandId: envelope.commandId, kind: "dispatch" as const };
+      flight.current = operation;
+      setRejection(undefined);
+      refresh();
+      try {
+        const outcome = await dispatchWorkflowRunControl({
+          envelope,
+          scope,
+          issue: {
+            logEpoch: snapshot.logEpoch,
+            revision: snapshot.revision,
+            lastEventSequence: run.lastEventSequence,
+            status: run.status,
+          },
+          sendCommand: conversation.sendCommand,
+          queryCommands: (params) => conversation.layer.queryCommands(params),
+          isCurrent: () =>
+            current.current?.token === token && current.current.logEpoch === snapshot.logEpoch,
+        });
+        applyOutcome(action, outcome);
+      } finally {
+        if (flight.current === operation) flight.current = null;
+        if (current.current?.token === token) refresh();
+      }
+    },
+    [
+      projection.snapshot,
+      token,
+      live,
+      run,
+      input.canCancel,
+      input.canResume,
+      input.workflowName,
+      sessionId,
+      runId,
+      scope,
+      refresh,
+      conversation,
+      applyOutcome,
+    ],
+  );
+
+  const checkResult = useCallback(async () => {
+    if (current.current?.token !== token || flight.current?.token === token || !live) return;
+    const pending = workflowRunControlEntries(sessionId, runId, scope)[0];
+    if (pending?.replay.kind !== "workflowControl") return;
+    const operation = { token, commandId: pending.commandId, kind: "query" as const };
+    flight.current = operation;
+    refresh();
+    try {
+      const outcome = await checkWorkflowRunControl({
+        entry: pending,
+        ...(projection.snapshot
+          ? {
+              observation: {
+                logEpoch: projection.snapshot.logEpoch,
+                revision: projection.snapshot.revision,
+              },
+            }
+          : {}),
+        queryCommands: (params) => conversation.layer.queryCommands(params),
+        workflowRunEvents: conversation.workflowRunEvents,
+        isCurrent: () =>
+          current.current?.token === token &&
+          current.current.logEpoch === projection.snapshot?.logEpoch,
+      });
+      applyOutcome(pending.replay.type === "cancelBackgroundWork" ? "cancel" : "resume", outcome);
+    } finally {
+      if (flight.current === operation) flight.current = null;
+      if (current.current?.token === token) refresh();
+    }
+  }, [
+    token,
+    live,
+    sessionId,
+    runId,
+    scope,
+    refresh,
+    conversation,
+    applyOutcome,
+    projection.snapshot,
+  ]);
+
+  return {
+    rejection,
+    phase,
+    checking,
+    actionsDisabled: !live || entries.length > 0 || activeFlight !== null,
+    checkDisabled: !live || activeFlight !== null,
+    cancel: () => {
+      void send("cancel");
+    },
+    resume: () => {
+      void send("resume");
+    },
+    checkResult: () => {
+      void checkResult();
+    },
+  };
+}
diff --git a/packages/ui/src/app-shell/useWorkflowRunControlHelpers.ts b/packages/ui/src/app-shell/useWorkflowRunControlHelpers.ts
new file mode 100644
index 00000000..aa1c01df
--- /dev/null
+++ b/packages/ui/src/app-shell/useWorkflowRunControlHelpers.ts
@@ -0,0 +1,141 @@
+import type {
+  CommandAck,
+  CommandEnvelope,
+  V4ConversationWorkflowRunEventsParams,
+  V4ConversationWorkflowRunEventsResult,
+} from "@zcode/shared/zcode-protocol-v4";
+import { pendingCommandRegistry, type PendingCommandEntry } from "@/v4/pendingCommandRegistry.js";
+import type {
+  WorkflowControlIssue,
+  WorkflowControlObservation,
+} from "@/v4/pendingCommandReplay.js";
+import { isPendingCommandForWorkspace } from "@/v4/pendingCommandWorkspace.js";
+import type { PaneWorkspaceScope } from "@/v4/paneLayoutStore.js";
+import type { ConversationTransport } from "@/v4/transport.js";
+import { logger } from "@/logger.js";
+
+export type WorkflowRunControlOutcome =
+  | { kind: "receipt"; ack: CommandAck }
+  | { kind: "uncertain" }
+  | { kind: "blocked" }
+  | { kind: "not_sent"; code: string };
+
+export function workflowRunControlEntries(
+  sessionId: string,
+  workId: string,
+  scope: PaneWorkspaceScope,
+): readonly PendingCommandEntry[] {
+  return pendingCommandRegistry
+    .list(sessionId)
+    .filter(
+      (entry) =>
+        entry.replay.kind === "workflowControl" &&
+        entry.replay.workId === workId &&
+        isPendingCommandForWorkspace(entry, scope.workspacePath, scope.workspaceIdentity) &&
+        (entry.clientContext?.workspace?.remoteSessionId ?? null) ===
+          (scope.remoteSessionId ?? null),
+    );
+}
+
+/** 这里只读原 command key；丢失 ACK 不得降成失败，更不得重发 Resume。 */
+export async function checkWorkflowRunControl(input: {
+  entry: PendingCommandEntry;
+  observation?: WorkflowControlObservation;
+  workflowRunEvents?: (
+    params: V4ConversationWorkflowRunEventsParams,
+  ) => Promise<V4ConversationWorkflowRunEventsResult>;
+  queryCommands: ConversationTransport["queryCommands"];
+  isCurrent: () => boolean;
+}): Promise<WorkflowRunControlOutcome> {
+  const { entry, isCurrent } = input;
+  if (!isCurrent()) return { kind: "uncertain" };
+  const key = { sessionId: entry.sessionId, commandId: entry.commandId };
+  try {
+    const result = await input.queryCommands({ commands: [key] });
+    if (!isCurrent()) return { kind: "uncertain" };
+    const receipt = result.results.find(
+      (item) => item.key.sessionId === key.sessionId && item.key.commandId === key.commandId,
+    );
+    if (!receipt || receipt.result === "unknown" || receipt.result.commandId !== key.commandId) {
+      pendingCommandRegistry.markWorkflowControl(key.sessionId, key.commandId, "unknown");
+      return { kind: "uncertain" };
+    }
+    pendingCommandRegistry.applyQuery({ results: [receipt] }, input.observation);
+    const issue = entry.workflowControl?.issue;
+    if (
+      entry.replay.kind === "workflowControl" &&
+      entry.replay.type === "resumeWorkflowRun" &&
+      entry.sessionId !== null &&
+      issue &&
+      input.observation &&
+      input.workflowRunEvents &&
+      (receipt.result.status === "accepted" || receipt.result.status === "duplicate") &&
+      !receipt.result.reasonCode
+    ) {
+      try {
+        const journal = await input.workflowRunEvents({
+          sessionId: entry.sessionId,
+          runId: entry.replay.workId,
+          afterSequence: issue.lastEventSequence,
+          limit: 500,
+        });
+        if (!isCurrent()) return { kind: "uncertain" };
+        const start = journal.events.find(
+          (event) => event.type === "run-started" && event.sequence > issue.lastEventSequence,
+        );
+        if (start)
+          pendingCommandRegistry.applyQuery(
+            { results: [receipt] },
+            {
+              ...input.observation,
+              resumeStartSequence: start.sequence,
+            },
+          );
+      } catch {
+        logger.warn("[workflow-run-control] original run journal unavailable", {
+          commandId: key.commandId,
+        });
+      }
+    }
+    return { kind: "receipt", ack: receipt.result };
+  } catch {
+    if (isCurrent())
+      pendingCommandRegistry.markWorkflowControl(key.sessionId, key.commandId, "unknown");
+    logger.warn("[workflow-run-control] command receipt unavailable", { commandId: key.commandId });
+    return { kind: "uncertain" };
+  }
+}
+
+export async function dispatchWorkflowRunControl(input: {
+  envelope: CommandEnvelope;
+  scope: PaneWorkspaceScope;
+  issue: WorkflowControlIssue;
+  sendCommand: ConversationTransport["sendCommand"];
+  queryCommands: ConversationTransport["queryCommands"];
+  isCurrent: () => boolean;
+}): Promise<WorkflowRunControlOutcome> {
+  const { envelope, scope, isCurrent } = input;
+  if (!isCurrent()) return { kind: "not_sent", code: "client.workflowControlContextChanged" };
+  if (envelope.type !== "cancelBackgroundWork" && envelope.type !== "resumeWorkflowRun") {
+    return { kind: "not_sent", code: "client.workflowControlInvalidAction" };
+  }
+  const { workId } = envelope.payload as { workId: string };
+  if (!envelope.sessionId || workflowRunControlEntries(envelope.sessionId, workId, scope).length) {
+    return { kind: "blocked" };
+  }
+  const entry = pendingCommandRegistry.record(envelope, { workspace: { ...scope } }, input.issue);
+  if (!entry) return { kind: "not_sent", code: "client.workflowControlReceiptUnavailable" };
+  try {
+    const ack = await input.sendCommand(envelope);
+    if (!isCurrent() || ack.commandId !== envelope.commandId) {
+      pendingCommandRegistry.markWorkflowControl(envelope.sessionId, envelope.commandId, "unknown");
+      return { kind: "uncertain" };
+    }
+    pendingCommandRegistry.applyAck(envelope, ack);
+    return { kind: "receipt", ack };
+  } catch {
+    pendingCommandRegistry.markWorkflowControl(envelope.sessionId, envelope.commandId, "unknown");
+    // 捕获的同一 layer/sender 属于发起上下文；换代后不通过新服务查询旧命令。
+    return checkWorkflowRunControl({ entry, queryCommands: input.queryCommands, isCurrent });
+  }
+}
