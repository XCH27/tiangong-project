+export function workflowControlAckDisposition(
+  type: "cancelBackgroundWork" | "resumeWorkflowRun",
+  ack: CommandAck,
+): "settled" | "accepted" | "unknown" {
+  if (ack.status === "noop" || ack.status === "rejected" || ack.status === "stale")
+    return "settled";
