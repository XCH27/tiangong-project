+        receipt.results[0]?.result === "unknown",
+        fault === "write",
+        "index failure happens after accepted fact bytes committed; entry write failure has no durable ACK",
+      );
+      await checkWorkflowRunControl({
+        entry: registry.list(sessionId)[0]!,
+        queryCommands: (params) => cold.queryCommands(params),
+        isCurrent: () => true,
+      });
+      assert.equal(effects, 1);
+      assert.equal(registry.list(sessionId).length, 1, "receipt is not engine completion");
+      if (fault === "index") assert.equal((await cold.handleCommand(envelope)).status, "duplicate");
+      assert.equal(effects, 1);
+    } finally {
+      h.store.saveSessionEntry = originalWrite;
+      registry.settle(sessionId, envelope.commandId);
+      gateway.dispose();
+      await h.close();
+    }
+  });
+}
