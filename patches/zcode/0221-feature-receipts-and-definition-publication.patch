@@ -0,0 +1,190 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import type { IServiceAccessor } from "@zcode/services";
+import type { IPlatformService } from "@zcode/shared";
+import {
+  conversationSnapshotSchema,
+  conversationTopicWireFrameSchema,
+  type CommandAck,
+  type CommandEnvelope,
+} from "@zcode/shared/zcode-protocol-v4";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { WorkflowRunSidePane } from "../src/app-shell/WorkflowRunSidePane.js";
+import { useDynamicWorkflowAvailabilityStore } from "../src/store/dynamicWorkflowAvailabilityStore.js";
+import { pendingCommandRegistry } from "../src/v4/pendingCommandRegistry.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 40; i++) await Promise.resolve();
+};
+
+async function scenario(locale: "en-US" | "zh-CN", result: "accepted" | "preflight") {
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  const fixture = nativePresentationAgent();
+  const scope = { workspacePath: `/authored/workflow-control/${locale}/${crypto.randomUUID()}` };
+  const runId = `run-${locale}`;
+  const parentSessionId = `parent-${locale}`;
+  const framePort = fixture.agent.onDynamicConversationFrame;
+  fixture.agent.onDynamicConversationFrame = () => (listener) =>
+    framePort()((candidate) => {
+      const wire = conversationTopicWireFrameSchema.parse(candidate);
+      if (wire.kind !== "complete" || wire.frame.payload.kind !== "snapshot")
+        return listener(candidate);
+      const snapshot = conversationSnapshotSchema.parse({
+        ...wire.frame.payload.snapshot,
+        workflowRuns: {
+          revision: 1,
+          runs: [
+            {
+              runId,
+              status: "stopped",
+              resumable: true,
+              stopReason: "user",
+              usage: { spentTokens: 0, nodesUsed: 0 },
+              actors: [],
+              nodes: [],
+              lastEventSequence: 1,
+            },
+          ],
+        },
+      });
+      listener({ ...wire, frame: { ...wire.frame, payload: { kind: "snapshot", snapshot } } });
+    });
+  let sends = 0;
+  let queries = 0;
+  let queryReceipt: CommandAck | "unknown" = "unknown";
+  let captured: CommandEnvelope | undefined;
+  fixture.agent.sendConversationCommandV4 = async ({ envelope }) => {
+    captured = envelope;
+    sends++;
+    throw new Error("Authored accepted reply loss");
+  };
+  fixture.agent.queryConversationCommandsV4 = async ({ commands }) => {
+    queries++;
+    check(
+      commands.length === 1 && commands[0]?.commandId === captured?.commandId,
+      "check uses original command identity",
+    );
+    return { results: commands.map((key) => ({ key, result: queryReceipt })) };
+  };
+  fixture.agent.conversationWorkflowRunArtifactsV4 = async () => ({ artifacts: [] });
+  fixture.agent.conversationWorkflowRunEventsV4 = async () => ({ events: [], hasMore: false });
+  useDynamicWorkflowAvailabilityStore.setState({ status: "ready", enabled: true });
+  const mount = async () =>
+    act(async () => {
+      root.render(
+        <PlatformProvider platform={{} as IPlatformService}>
+          <ServiceProvider services={{ zcodeAgentService: fixture.agent } as IServiceAccessor}>
+            <TabStoreProvider>
+              <ZCodeIntlProvider initialLocale={locale}>
+                <TooltipProvider>
+                  <WorkflowRunSidePane
+                    tab={{
+                      type: "workflow-run",
+                      workspaceKey: scope.workspacePath,
+                      id: `control-${locale}`,
+                      toolCallId: "authored-tool",
+                      runId,
+                      parentSessionId,
+                      ...scope,
+                    }}
+                  />
+                </TooltipProvider>
+              </ZCodeIntlProvider>
+            </TabStoreProvider>
+          </ServiceProvider>
+        </PlatformProvider>,
+      );
+      await tick();
+    });
+  try {
+    await mount();
+    const resume = () =>
+      node.querySelector<HTMLButtonElement>('[data-testid="workflow-run-resume"]');
+    check(resume() && !resume()!.disabled, "actual SidePane receives live original run projection");
+    await act(async () => {
+      resume()!.click();
+      await tick();
+    });
+    check(sends === 1 && queries === 1, "actual failed transport is caught and queries once");
+    check(resume()?.disabled, "unknown blocks duplicate Resume");
+    const notice =
+      node.querySelector('[data-testid="workflow-run-control-notice"]')?.textContent ?? "";
+    check(
+      locale === "en-US" ? notice.includes("unconfirmed") : notice.includes("尚未确认"),
+      "localized uncertain notice remains visible",
+    );
+    check(captured, "sent envelope is captured at authored service boundary");
+    queryReceipt =
+      result === "accepted"
+        ? { commandId: captured.commandId, status: "accepted", revisionAtDecision: 0 }
+        : {
+            commandId: captured.commandId,
+            status: "failed",
+            reasonCode: "fault.command.workflowRunResumeRejected.not_resumable",
+            revisionAtDecision: 0,
+          };
+    await act(async () => {
+      node.querySelector<HTMLButtonElement>('[data-testid="workflow-run-check-result"]')!.click();
+      await tick();
+    });
+    check(sends === 1 && queries === 2, "explicit Check result never sends Resume");
+    if (result === "accepted")
+      check(resume()?.disabled, "accepted receipt is not a new run projection");
+    else {
+      check(
+        resume() && !resume()!.disabled,
+        "definite preflight rejection releases control without new send",
+      );
+      check(
+        node.querySelector('[data-testid="workflow-run-rejection"]'),
+        "definite rejection has its original explanation",
+      );
+    }
+  } finally {
+    await act(async () => root.unmount());
+    node.remove();
+    for (const entry of pendingCommandRegistry.list(parentSessionId))
+      pendingCommandRegistry.settle(parentSessionId, entry.commandId);
+    useDynamicWorkflowAvailabilityStore.setState(
+      useDynamicWorkflowAvailabilityStore.getInitialState(),
+      true,
+    );
+  }
+}
+
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    for (const result of ["accepted", "preflight"] as const) {
+      const name = `actual WorkflowRunSidePane ${locale}: lost ACK, readonly check, ${result}`;
+      try {
+        await scenario(locale, result);
+        results.push({ name });
+      } catch (error) {
+        results.push({
+          name,
+          error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+        });
+      }
+    }
+  }
+  document.body.dataset.testResults = JSON.stringify(results);
+  (globalThis as { __TEST_RESULTS__?: unknown }).__TEST_RESULTS__ = results;
+}
+declare global {
+  interface Window {
+    __workflowRunControlTests: Promise<Array<{ name: string; error?: string }>>;
+  }
+}
+window.__workflowRunControlTests = run().then(() => results);
