+import assert from "node:assert/strict";
+import test from "node:test";
+import { ZCODE_AGENT_PROVIDER } from "@zcode/shared";
+import type { ISkillsService } from "@zcode/services";
+import { useSkillStore as store } from "../src/store/skillStore.js";
+
+type ListResult = Awaited<ReturnType<ISkillsService["list"]>>;
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+function result(id: string): ListResult {
+  return {
+    skills: [
+      {
+        id,
+        name: id,
+        description: id,
+        path: `/authored/${id}/SKILL.md`,
+        scope: "workspace",
+        enabled: true,
+      },
+    ],
+    capability: null,
+    diagnostics: [],
+  } as ListResult;
+}
+function service(
+  list: ISkillsService["list"],
+  setEnabled: ISkillsService["setEnabled"] = async () => {},
+) {
+  return { list, setEnabled } as ISkillsService;
+}
+function reset() {
+  store.setState({ ...store.getInitialState() }, true);
+}
+
+test("a slow workspace read cannot overwrite a completed different service/workspace", async () => {
+  reset();
+  const slow = deferred<ListResult>();
+  const old = store.getState().initialize(
+    "/authored/A",
+    service(() => slow.promise),
+  );
+  try {
+    await store.getState().initialize(
+      "/authored/B",
+      service(async () => result("B")),
+    );
+    slow.resolve(result("A"));
+    await old;
+    assert.equal(store.getState().skills[0]?.id, "B");
+    assert.equal(store.getState().loadedWorkspacePath, "/authored/B");
+  } finally {
+    slow.resolve(result("A"));
+    await old;
+    reset();
+  }
+});
+
+test("same-path replacement service does not join the old service pending read", async () => {
+  reset();
+  const slow = deferred<ListResult>();
+  let newReads = 0;
+  const old = store.getState().initialize(
+    "/authored/same",
+    service(() => slow.promise),
+  );
+  const current = store.getState().initialize(
+    "/authored/same",
+    service(async () => {
+      newReads++;
+      return result("new-service");
+    }),
+  );
+  try {
+    await Promise.resolve();
+    await Promise.resolve();
+    assert.equal(newReads, 1);
