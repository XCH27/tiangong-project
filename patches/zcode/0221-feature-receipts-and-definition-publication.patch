@@ -0,0 +1,113 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { runAfterSuccessfulPluginEnabledChange as run } from "../src/settings/pluginEnabledChange.js";
+
+function receipt(succeeded: boolean, canonicalChanged: boolean, isCurrent = () => true) {
+  return { succeeded, canonicalChanged, isCurrent };
+}
+
+test("a confirmed partial enabled change refreshes definitions without success or authorization", async () => {
+  let refreshes = 0,
+    successes = 0;
+  const completed = await run({
+    submit: async () => receipt(false, true),
+    isCurrent: () => true,
+    onCanonicalChange: async (isCurrent) => {
+      assert.equal(isCurrent(), true);
+      refreshes++;
+    },
+    onSuccess: () => {
+      successes++;
+    },
+  });
+  assert.equal(refreshes, 1);
+  assert.equal(successes, 0);
+  assert.equal(completed, false);
+});
+
+test("unobserved failure cannot refresh definitions or report success", async () => {
+  let effects = 0;
+  const completed = await run({
+    submit: async () => receipt(false, false),
+    isCurrent: () => true,
+    onCanonicalChange: () => {
+      effects++;
+    },
+    onSuccess: () => {
+      effects++;
+    },
+  });
+  assert.equal(effects, 0);
+  assert.equal(completed, false);
+});
+
+test("a current success still refreshes and notifies with compatible boolean callers", async () => {
+  let effects = 0;
+  for (const value of [true, receipt(true, false)]) {
+    assert.equal(
+      await run({
+        submit: async () => value,
+        isCurrent: () => true,
+        onCanonicalChange: () => {
+          effects++;
+        },
+        onSuccess: () => {
+          effects++;
+        },
+      }),
+      true,
+    );
+  }
+  assert.equal(effects, 4);
+  assert.equal(
+    await run({
+      submit: async () => false,
+      isCurrent: () => true,
+      onSuccess: () => {
+        throw new Error("False legacy result cannot continue");
+      },
+    }),
+    false,
+  );
+});
+
+test("obsolete receipt cannot refresh a replacement context even if its view remains mounted", async () => {
+  let effects = 0;
+  assert.equal(
+    await run({
+      submit: async () => receipt(true, true, () => false),
+      isCurrent: () => true,
+      onCanonicalChange: () => {
+        effects++;
+      },
+      onSuccess: () => {
+        effects++;
+      },
+    }),
+    false,
+  );
+  assert.equal(effects, 0);
+});
+
+test("ownership is rechecked after draft refresh before status or success callbacks", async () => {
+  let current = true,
+    successes = 0,
+    statuses = 0;
+  assert.equal(
+    await run({
+      submit: async () => receipt(true, true),
+      isCurrent: () => current,
+      onCanonicalChange: async (isCurrent) => {
+        current = false;
+        await Promise.resolve();
+        if (isCurrent()) statuses++;
+      },
+      onSuccess: () => {
+        successes++;
+      },
+    }),
+    false,
+  );
+  assert.equal(statuses, 0);
+  assert.equal(successes, 0);
+});
