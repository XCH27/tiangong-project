@@ -0,0 +1,527 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { WorkflowControlProjection } from "../src/v4/pendingCommandReplay.js";
+import { createCommandEnvelope } from "../src/v4/commandFactory.js";
+
+const persisted = new Map<string, string>();
+Object.defineProperty(globalThis, "localStorage", {
+  configurable: true,
+  value: {
+    getItem: (key: string) => persisted.get(key) ?? null,
+    setItem: (key: string, value: string) => persisted.set(key, value),
+    removeItem: (key: string) => persisted.delete(key),
+  },
+});
+const { pendingCommandRegistry: registry } = await import("../src/v4/pendingCommandRegistry.js");
+
+test("unconfirmed Resume remains queryable after a missing receipt and can never be replayed", () => {
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "authored-run" },
+    sessionId: "authored-parent",
+  });
+  const entry = registry.record(envelope, {
+    workspace: { workspacePath: "/authored/workspace", workspaceIdentity: "authored-workspace" },
+  });
+  try {
+    assert.ok(entry, "Resume needs the original pending receipt owner before dispatch");
+    registry.applyQuery({
+      results: [
+        {
+          key: { sessionId: envelope.sessionId, commandId: envelope.commandId },
+          result: "unknown",
+        },
+      ],
+    });
+    assert.equal(registry.list(envelope.sessionId).length, 1);
+    assert.equal(
+      registry.consumeReplay({ sessionId: envelope.sessionId, commandId: envelope.commandId }),
+      null,
+    );
+    assert.ok([...persisted.values()].some((value) => value.includes(envelope.commandId)));
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("a generic failed Resume receipt does not prove the engine never started", () => {
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "partial-run" },
+    sessionId: "partial-parent",
+  });
+  registry.record(envelope);
+  try {
+    registry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "failed",
+      reasonCode: "fault.command.executionFailed",
+      revisionAtDecision: 4,
+    });
+    assert.equal(
+      registry.list(envelope.sessionId).length,
+      1,
+      "post-launch tracking failure must block another Resume",
+    );
+    assert.equal(registry.list(envelope.sessionId)[0]?.workflowControl?.delivery, "unknown");
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("accepted Stop stays pending until a newer matching terminal projection; unknown survives status ABA", () => {
+  const envelope = createCommandEnvelope({
+    type: "cancelBackgroundWork",
+    payload: { workId: "stop-run" },
+    sessionId: "stop-parent",
+  });
+  registry.record(envelope, undefined, {
+    logEpoch: "authored-epoch",
+    revision: 10,
+    lastEventSequence: 7,
+    status: "running",
+  });
+  try {
+    registry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 10,
+    });
+    const snapshot: WorkflowControlProjection = {
+      sessionId: "stop-parent",
+      logEpoch: "authored-epoch",
+      revision: 10,
+      workflowRuns: {
+        revision: 1,
+        runs: [{ runId: "stop-run", status: "running", lastEventSequence: 7 }],
+      },
+    };
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(registry.list(envelope.sessionId).length, 1, "ACK is not Stop completion");
+    registry.reconcileWorkflowControlProjection(envelope.commandId, {
+      ...snapshot,
+      revision: 11,
+      workflowRuns: {
+        revision: 2,
+        runs: [{ runId: "stop-run", status: "stopped", lastEventSequence: 8 }],
+      },
+    });
+    assert.equal(registry.list(envelope.sessionId).length, 0);
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("original transport lost Resume ACK queries its exact identity, then explicit check never replays the engine", async () => {
+  const { createAgentConversationTransport } =
+    await import("../src/v4/agentConversationTransport.js");
+  const { dispatchWorkflowRunControl, checkWorkflowRunControl } =
+    await import("../src/app-shell/useWorkflowRunControlHelpers.js");
+  const { V4_WIRE_PROTOCOL_VERSION } = await import("@zcode/shared/zcode-protocol-v4");
+  let engines = 0;
+  let known = false;
+  let received: import("@zcode/shared/zcode-protocol-v4").CommandEnvelope | undefined;
+  const queries: string[] = [];
+  const service = {
+    helloConversationV4: async () => ({
+      kind: "hello",
+      protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+      connectionId: "authored-connection",
+      clientMode: "desktop-continuous",
+      deliveryProfile: "continuous",
+      serverTime: Date.now(),
+      capabilities: {
+        nativeDialogs: true,
+        localTerminal: true,
+        binaryFrames: false,
+        compression: "none",
+      },
+      auth: {},
+    }),
+    initializeConversationV4: async () => {},
+    sendConversationCommandV4: async ({ envelope }: { envelope: typeof received }) => {
+      received = envelope;
+      engines += 1;
+      throw new Error("Authored accepted reply lost");
+    },
+    queryConversationCommandsV4: async ({
+      commands,
+    }: {
+      commands: Array<{ sessionId: string | null; commandId: string }>;
+    }) => {
+      queries.push(commands[0]!.commandId);
+      return {
+        results: commands.map((key) => ({
+          key,
+          result: known
+            ? { commandId: key.commandId, status: "accepted", revisionAtDecision: 12 }
+            : "unknown",
+        })),
+      };
+    },
+  } as Parameters<typeof createAgentConversationTransport>[0];
+  const transport = createAgentConversationTransport(service, {
+    workspacePath: "/authored/control",
+  });
+  const scope = {
+    workspacePath: "/authored/control",
+    workspaceIdentity: "control-ws",
+    remoteSessionId: "control-remote",
+  };
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "lost-run" },
+    sessionId: "lost-parent",
+  });
+  try {
+    const outcome = await dispatchWorkflowRunControl({
+      envelope,
+      scope,
+      issue: { logEpoch: "lost-epoch", revision: 12, lastEventSequence: 9, status: "stopped" },
+      sendCommand: transport.sendCommand,
+      queryCommands: transport.queryCommands,
+      isCurrent: () => true,
+    });
+    assert.equal(outcome.kind, "uncertain");
+    assert.equal(engines, 1);
+    const entry = registry.list(envelope.sessionId)[0]!;
+    assert.equal(entry.commandId, received?.commandId);
+    known = true;
+    await checkWorkflowRunControl({
+      entry,
+      queryCommands: transport.queryCommands,
+      isCurrent: () => true,
+    });
+    assert.deepEqual(queries, [envelope.commandId, envelope.commandId]);
+    assert.equal(engines, 1);
+    assert.equal(registry.list(envelope.sessionId)[0]?.workflowControl?.delivery, "accepted");
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("unpersistable control refuses dispatch before any engine effect, retaining prior receipts", async () => {
+  const { dispatchWorkflowRunControl } =
+    await import("../src/app-shell/useWorkflowRunControlHelpers.js");
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "quota-run" },
+    sessionId: "quota-parent",
+  });
+  let engines = 0;
+  const write = globalThis.localStorage.setItem;
+  globalThis.localStorage.setItem = () => {
+    throw new Error("Authored storage quota");
+  };
+  try {
+    const outcome = await dispatchWorkflowRunControl({
+      envelope,
+      scope: { workspacePath: "/authored/quota" },
+      issue: { logEpoch: "quota-epoch", revision: 0, lastEventSequence: 0, status: "stopped" },
+      sendCommand: async () => {
+        engines += 1;
+        throw new Error("must not send");
+      },
+      queryCommands: async () => {
+        throw new Error("nothing sent");
+      },
+      isCurrent: () => true,
+    });
+    assert.equal(outcome.kind, "not_sent");
+    assert.equal(engines, 0);
+  } finally {
+    globalThis.localStorage.setItem = write;
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("late ACK and late receipt query cannot settle an operation after its context generation changed", async () => {
+  const { dispatchWorkflowRunControl, checkWorkflowRunControl } =
+    await import("../src/app-shell/useWorkflowRunControlHelpers.js");
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "late-run" },
+    sessionId: "late-parent",
+  });
+  let current = true;
+  let release!: (ack: import("@zcode/shared/zcode-protocol-v4").CommandAck) => void;
+  const ack = { commandId: envelope.commandId, status: "accepted" as const, revisionAtDecision: 2 };
+  const pending = dispatchWorkflowRunControl({
+    envelope,
+    scope: { workspacePath: "/authored/late", remoteSessionId: "late-remote" },
+    issue: { logEpoch: "late-epoch", revision: 1, lastEventSequence: 1, status: "stopped" },
+    sendCommand: () =>
+      new Promise((resolve) => {
+        release = resolve;
+      }),
+    queryCommands: async () => {
+      throw new Error("must not query stale connection");
+    },
+    isCurrent: () => current,
+  });
+  try {
+    current = false;
+    release(ack);
+    await pending;
+    const entry = registry.list(envelope.sessionId)[0]!;
+    assert.equal(entry.workflowControl?.delivery, "unknown");
+    current = true;
+    let queryRelease!: (
+      value: import("@zcode/shared/zcode-protocol-v4").CommandsQueryResult,
+    ) => void;
+    const query = checkWorkflowRunControl({
+      entry,
+      queryCommands: () =>
+        new Promise((resolve) => {
+          queryRelease = resolve;
+        }),
+      isCurrent: () => current,
+    });
+    current = false;
+    queryRelease({
+      results: [
+        { key: { sessionId: envelope.sessionId, commandId: envelope.commandId }, result: ack },
+      ],
+    });
+    await query;
+    assert.equal(registry.list(envelope.sessionId)[0]?.workflowControl?.delivery, "unknown");
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("workflow controls stay bounded without expiring unknown identities; original input TTL still expires", async () => {
+  const controlKeys: Array<ReturnType<typeof createCommandEnvelope>> = [];
+  const originalInput = createCommandEnvelope({
+    type: "sendText",
+    payload: { text: "authored pending input" },
+    sessionId: "bounded-input",
+  });
+  registry.record(originalInput);
+  try {
+    for (let index = 0; index < 64; index++) {
+      const control = createCommandEnvelope({
+        type: "resumeWorkflowRun",
+        payload: { workId: `bound-${index}` },
+        sessionId: "bounded-controls",
+      });
+      assert.ok(registry.record(control));
+      controlKeys.push(control);
+    }
+    const overflow = createCommandEnvelope({
+      type: "resumeWorkflowRun",
+      payload: { workId: "overflow" },
+      sessionId: "bounded-controls",
+    });
+    assert.equal(registry.record(overflow), null);
+    const storageKey = "zcode-v4-pending-commands:v1";
+    const stored = JSON.parse(persisted.get(storageKey)!);
+    for (const item of stored) item.expiresAt = 0;
+    persisted.set(storageKey, JSON.stringify(stored));
+    const path =
+      new URL("../src/v4/pendingCommandRegistry.ts", import.meta.url).href +
+      "?authored-expired-owner";
+    const cold: typeof registry = (await import(path)).pendingCommandRegistry;
+    assert.equal(cold.list("bounded-controls").length, 64);
+    assert.equal(cold.list("bounded-input").length, 0);
+  } finally {
+    for (const control of controlKeys) registry.settle(control.sessionId, control.commandId);
+    registry.settle(originalInput.sessionId, originalInput.commandId);
+  }
+});
+
+test("cold renderer reload retains exact remote control identity and never turns it into replayable input", async () => {
+  const envelope = createCommandEnvelope({
+    type: "cancelBackgroundWork",
+    payload: { workId: "cold-run" },
+    sessionId: "cold-parent",
+  });
+  registry.record(envelope, {
+    workspace: {
+      workspacePath: "/authored/cold",
+      workspaceIdentity: "cold-ws",
+      remoteSessionId: "cold-remote",
+    },
+  });
+  registry.applyQuery({
+    results: [
+      { key: { sessionId: envelope.sessionId, commandId: envelope.commandId }, result: "unknown" },
+    ],
+  });
+  try {
+    const path =
+      new URL("../src/v4/pendingCommandRegistry.ts", import.meta.url).href + "?authored-cold-owner";
+    const cold: typeof registry = (await import(path)).pendingCommandRegistry;
+    const restored = cold.list(envelope.sessionId)[0]!;
+    assert.equal(restored.commandId, envelope.commandId);
+    assert.equal(restored.clientContext?.workspace?.remoteSessionId, "cold-remote");
+    assert.equal(restored.workflowControl?.delivery, "unknown");
+    assert.equal(
+      cold.consumeReplay({ sessionId: envelope.sessionId, commandId: envelope.commandId }),
+      null,
+    );
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("positive current-epoch query permits matching durable Stop progress without comparing old revisions", () => {
+  const envelope = createCommandEnvelope({
+    type: "cancelBackgroundWork",
+    payload: { workId: "epoch-run" },
+    sessionId: "epoch-parent",
+  });
+  registry.record(envelope, undefined, {
+    logEpoch: "old-epoch",
+    revision: 100,
+    lastEventSequence: 7,
+    status: "running",
+  });
+  try {
+    registry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 101,
+    });
+    const snapshot: WorkflowControlProjection = {
+      sessionId: "epoch-parent",
+      logEpoch: "new-epoch",
+      revision: 5,
+      workflowRuns: {
+        revision: 1,
+        runs: [{ runId: "epoch-run", status: "stopped", lastEventSequence: 8 }],
+      },
+    };
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(
+      registry.list(envelope.sessionId).length,
+      1,
+      "epoch change alone cannot settle control",
+    );
+    registry.applyQuery(
+      {
+        results: [
+          {
+            key: { sessionId: envelope.sessionId, commandId: envelope.commandId },
+            result: { commandId: envelope.commandId, status: "accepted", revisionAtDecision: 101 },
+          },
+        ],
+      },
+      { logEpoch: "new-epoch", revision: 5 },
+    );
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(
+      registry.list(envelope.sessionId).length,
+      0,
+      "new epoch revision5 must not be compared to old101",
+    );
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("Resume terminal status ABA needs actual newer run-started evidence before release", () => {
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "aba-run" },
+    sessionId: "aba-parent",
+  });
+  registry.record(envelope, undefined, {
+    logEpoch: "aba-epoch",
+    revision: 10,
+    lastEventSequence: 7,
+    status: "stopped",
+  });
+  try {
+    registry.applyAck(envelope, {
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 11,
+    });
+    const snapshot: WorkflowControlProjection = {
+      sessionId: "aba-parent",
+      logEpoch: "aba-epoch",
+      revision: 12,
+      workflowRuns: {
+        revision: 2,
+        runs: [{ runId: "aba-run", status: "stopped", lastEventSequence: 9 }],
+      },
+    };
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(registry.list(envelope.sessionId).length, 1);
+    registry.applyQuery(
+      {
+        results: [
+          {
+            key: { sessionId: envelope.sessionId, commandId: envelope.commandId },
+            result: { commandId: envelope.commandId, status: "accepted", revisionAtDecision: 11 },
+          },
+        ],
+      },
+      { logEpoch: "aba-epoch", revision: 12, resumeStartSequence: 8 },
+    );
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(registry.list(envelope.sessionId).length, 0);
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
+
+test("unknown receipt, missing run and not-yet-projected journal start never release Resume", () => {
+  const envelope = createCommandEnvelope({
+    type: "resumeWorkflowRun",
+    payload: { workId: "future-run" },
+    sessionId: "future-parent",
+  });
+  registry.record(envelope, undefined, {
+    logEpoch: "future-epoch",
+    revision: 1,
+    lastEventSequence: 7,
+    status: "stopped",
+  });
+  const snapshot: WorkflowControlProjection = {
+    sessionId: "future-parent",
+    logEpoch: "future-epoch",
+    revision: 5,
+    workflowRuns: {
+      revision: 1,
+      runs: [{ runId: "future-run", status: "running", lastEventSequence: 8 }],
+    },
+  };
+  try {
+    registry.applyQuery({
+      results: [
+        {
+          key: { sessionId: envelope.sessionId, commandId: envelope.commandId },
+          result: "unknown",
+        },
+      ],
+    });
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(registry.list(envelope.sessionId).length, 1);
+    registry.applyQuery(
+      {
+        results: [
+          {
+            key: { sessionId: envelope.sessionId, commandId: envelope.commandId },
+            result: { commandId: envelope.commandId, status: "accepted", revisionAtDecision: 2 },
+          },
+        ],
+      },
+      { logEpoch: "future-epoch", revision: 5, resumeStartSequence: 9 },
+    );
+    registry.reconcileWorkflowControlProjection(envelope.commandId, {
+      ...snapshot,
+      workflowRuns: { revision: 2, runs: [] },
+    });
+    assert.equal(registry.list(envelope.sessionId).length, 1);
+    registry.reconcileWorkflowControlProjection(envelope.commandId, snapshot);
+    assert.equal(
+      registry.list(envelope.sessionId).length,
+      1,
+      "journal start is newer than current projection",
+    );
+  } finally {
+    registry.settle(envelope.sessionId, envelope.commandId);
+  }
+});
