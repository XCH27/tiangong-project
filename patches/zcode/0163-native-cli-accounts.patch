diff --git a/packages/services/test/native-cli-accounts.test.ts b/packages/services/test/native-cli-accounts.test.ts
new file mode 100644
index 0000000..38f7a72
--- /dev/null
+++ b/packages/services/test/native-cli-accounts.test.ts
@@ -0,0 +1,233 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { mapCodexNativeModels } from "../src/model-provider/nativeCliConnectionAdapter.js";
+import { pickNativeSwitchTarget } from "../src/model-provider/nativeCliUsage.js";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../src/model-provider/providerRuntime.js";
+import type { SubscriptionUsageResult } from "../src/model-provider/subscriptionUsage.js";
+
+const usage = (percent: number, id = "codex:primary"): SubscriptionUsageResult => ({
+  status: "available",
+  source: "fixture",
+  observedAt: 1,
+  windows: [{ id, usedPercent: percent }],
+});
+
+/** Each CLI home is one official sign-in; the fake CLI answers by home, as the real one does. */
+function fixture(directory: string) {
+  const identities = new Map<string, string>([["", "default@example.invalid"]]);
+  const percents = new Map<string, number>();
+  const homes: string[] = [];
+  const removed: string[] = [];
+  let nextLogin = "second@example.invalid";
+  const model = (id: string) =>
+    mapCodexNativeModels([
+      {
+        id,
+        model: id,
+        displayName: id,
+        hidden: false,
+        inputModalities: ["text"],
+        isDefault: true,
+        supportedReasoningEfforts: [{ reasoningEffort: "high", description: "Fixture" }],
+        defaultReasoningEffort: "high",
+      },
+    ]);
+  const runtime = new ProviderRuntime({
+    configRuntime: createProviderConfigRuntime({
+      personalFilePath: join(directory, "providers.json"),
+      zcodeBuiltinFilePath: fileURLToPath(
+        new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+      ),
+      watch: false,
+      personalPollingIntervalMs: false,
+    }),
+    nativeCli: {
+      inspect: async (access) => {
+        const accountId = identities.get(access.configDir || "");
+        if (!accountId) throw new Error("Sign in to the official Codex CLI first");
+        if (access.accountId && access.accountId !== accountId)
+          throw new Error("Native CLI account changed; reconnect this connection");
+        return {
+          accountId,
+          accountName: accountId,
+          planType: "plus",
+          catalog: { source: "provider", models: model(`model-for-${accountId.split("@")[0]}`) },
+        };
+      },
+      usage: async (access) => usage(percents.get(access.accountId!) ?? 0),
+      accountHomes: {
+        create: (provider) => {
+          const home = join(directory, "homes", provider, String(homes.length));
+          homes.push(home);
+          return home;
+        },
+        remove: (home) => removed.push(home),
+      },
+      login: (options) => {
+        identities.set(options.configDir || "", nextLogin);
+        return { completion: Promise.resolve(), cancel() {} };
+      },
+    },
+  });
+  return {
+    runtime,
+    homes,
+    removed,
+    percents,
+    setNextLogin: (accountId: string) => {
+      nextLogin = accountId;
+    },
+  };
+}
+
+async function signIn(
+  service: ProviderRuntime["providerSettings"],
+  providerId: string,
+): Promise<void> {
+  const { flowId } = await service.beginNativeCliLogin(providerId, { addAccount: true });
+  while ((await service.pollNativeCliLogin(providerId, flowId)).status === "pending");
+}
+
+test("native CLI keeps several sign-ins in isolated homes and switches between them", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-accounts-"));
+  const { runtime, homes, removed, setNextLogin } = fixture(directory);
+  try {
+    await runtime.start();
+    const service = runtime.providerSettings;
+    const { providerId } = await service.createPersonalProvider({
+      templateId: "fleet-chatgpt-native",
+    });
+    await service.connectNativeCli(providerId);
+    const access = async () => {
+      const value = (await service.getView()).providers.find((p) => p.providerId === providerId)!
+        .effectiveConfig.access;
+      assert.equal(value?.type, "native-cli");
+      return value as Extract<typeof value, { type: "native-cli" }>;
+    };
+    const models = async () =>
+      (await service.getView()).providers
+        .find((p) => p.providerId === providerId)!
+        .models.filter((m) => m.enabled)
+        .map((m) => m.modelId);
+
+    await signIn(service, providerId);
+    let current = await access();
+    assert.equal(current.accountId, "second@example.invalid", "a new sign-in becomes active");
+    assert.equal(current.configDir, homes[0]);
+    assert.deepEqual(
+      current.accounts?.map((a) => [a.id, a.configDir ?? ""]),
+      [
+        ["default@example.invalid", ""],
+        ["second@example.invalid", homes[0]],
+      ],
+    );
+    assert.deepEqual(await models(), ["model-for-second"], "catalog follows the active account");
+
+    // Signing the same account in again is refused and its fresh home discarded.
+    setNextLogin("second@example.invalid");
+    await assert.rejects(signIn(service, providerId), /already added/);
+    assert.deepEqual(removed, [homes[1]]);
+    assert.equal((await access()).accounts?.length, 2);
+
+    const view = await service.getSubscriptionAccounts(providerId);
+    assert.deepEqual(
+      view.accounts.map((a) => [a.id, a.active]),
+      [
+        ["default@example.invalid", false],
+        ["second@example.invalid", true],
+      ],
+    );
+
+    await service.updateSubscriptionAccounts(providerId, { select: "default@example.invalid" });
+    current = await access();
+    assert.equal(current.accountId, "default@example.invalid");
+    assert.equal(current.configDir, "", "the CLI's own home is selected explicitly");
+    assert.deepEqual(await models(), ["model-for-default"]);
+
+    const toggled = await service.updateSubscriptionAccounts(providerId, { autoSwitch: true });
+    assert.equal(toggled.autoSwitch, true);
+
+    // Removing the active account moves to the next saved one and keeps the default home on disk.
+    await service.updateSubscriptionAccounts(providerId, { remove: "default@example.invalid" });
+    current = await access();
+    assert.equal(current.accountId, "second@example.invalid");
+    assert.deepEqual(current.accounts?.map((a) => a.id), ["second@example.invalid"]);
+    assert.equal(current.autoSwitch, false, "one account cannot switch");
+    assert.deepEqual(removed, [homes[1]], "the CLI default home is never removed");
+
+    await service.updateSubscriptionAccounts(providerId, { remove: "second@example.invalid" });
+    current = await access();
+    assert.equal(current.connected, false);
+    assert.deepEqual(removed, [homes[1], homes[0]]);
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test("exhausted native allowance switches to the saved account with the most headroom", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-autoswitch-"));
+  const { runtime, percents, setNextLogin } = fixture(directory);
+  try {
+    await runtime.start();
+    const service = runtime.providerSettings;
+    const { providerId } = await service.createPersonalProvider({
+      templateId: "fleet-chatgpt-native",
+    });
+    await service.connectNativeCli(providerId);
+    await signIn(service, providerId);
+    setNextLogin("third@example.invalid");
+    await signIn(service, providerId);
+    await service.updateSubscriptionAccounts(providerId, { select: "default@example.invalid" });
+    percents.set("default@example.invalid", 99);
+    percents.set("second@example.invalid", 60);
+    percents.set("third@example.invalid", 20);
+
+    // Without the switch enabled, an exhausted reading changes nothing.
+    await service.getSubscriptionUsage(providerId, true);
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    let active = (await service.getSubscriptionAccounts(providerId)).accounts.find((a) => a.active);
+    assert.equal(active?.id, "default@example.invalid");
+
+    await service.updateSubscriptionAccounts(providerId, { autoSwitch: true });
+    await service.getSubscriptionUsage(providerId, true);
+    for (let attempt = 0; attempt < 50; attempt++) {
+      active = (await service.getSubscriptionAccounts(providerId)).accounts.find((a) => a.active);
+      if (active?.id !== "default@example.invalid") break;
+      await new Promise((resolve) => setTimeout(resolve, 10));
+    }
+    assert.equal(active?.id, "third@example.invalid");
+  } finally {
+    runtime.dispose();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test("switch target needs an exhausted active window and clear headroom elsewhere", () => {
+  assert.equal(pickNativeSwitchTarget("codex", usage(80), [{ id: "b", usage: usage(0) }]), undefined);
+  assert.equal(
+    pickNativeSwitchTarget("codex", usage(100), [
+      { id: "b", usage: usage(95) },
+      { id: "c", usage: { status: "unavailable" } },
+    ]),
+    undefined,
+    "nearly spent or unreadable accounts are not chosen",
+  );
+  assert.equal(
+    pickNativeSwitchTarget("codex", usage(100), [
+      { id: "b", usage: usage(50) },
+      { id: "c", usage: usage(10) },
+    ]),
+    "c",
+  );
+  assert.equal(
+    pickNativeSwitchTarget("claude", usage(100, "Opus:seven_day"), [{ id: "b", usage: usage(0) }]),
+    undefined,
+    "a Claude model-scoped window does not exhaust the account",
+  );
+});
