diff --git a/packages/ui/src/settings/model-provider-section/NativeCliAccountList.tsx b/packages/ui/src/settings/model-provider-section/NativeCliAccountList.tsx
new file mode 100644
index 0000000..4d8b709
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/NativeCliAccountList.tsx
@@ -0,0 +1,226 @@
+import { LoaderCircleIcon, MoreHorizontal, Plus } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Badge } from "@/components/ui/badge.js";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { useConfirmDialog } from "@/hooks/useConfirmDialog.js";
+import { useSubscriptionUsage } from "@/hooks/useSubscriptionUsage.js";
+import { subscriptionPlanPresentation } from "@/lib/subscriptionPlanPresentation.js";
+import { PlanStatusCardSurface } from "./PlanStatusCardSurface.js";
+import { SubscriptionUsageSection } from "./SubscriptionUsageSection.js";
+import { CredentialAutoSwitchSection } from "./CredentialAutoSwitchSection.js";
+
+type Kind = "claude" | "openai-codex";
+interface Account {
+  id: string;
+  label?: string;
+  active: boolean;
+}
+
+/**
+ * One saved sign-in as ZCode's own plan card, the same card a single account shows. Cockpit's
+ * account cards supply the rest: the allowance stays visible, the current account is tagged, and
+ * switching is one direct action.
+ */
+function AccountCard({
+  providerId,
+  revision,
+  kind,
+  account,
+  busy,
+  onSelect,
+  onReconnect,
+  onRemove,
+  onScopeChanged,
+}: {
+  providerId: string;
+  revision: string;
+  kind: Kind;
+  account: Account;
+  busy: boolean;
+  onSelect(): void;
+  onReconnect(): void;
+  onRemove(): void;
+  onScopeChanged(): void;
+}) {
+  const { intl } = useZCodeIntl();
+  const reading = useSubscriptionUsage({ providerId, revision, accountId: account.id, onScopeChanged });
+  const label = account.label ?? account.id;
+  const result = reading.result;
+  const plan = result?.status === "available" ? result.plan : undefined;
+  const tier = plan ? subscriptionPlanPresentation(kind, plan) : undefined;
+  const signInNeeded = result?.status === "auth-required";
+  const status = intl.formatMessage({
+    id: signInNeeded
+      ? "settings.modelProvider.nativeCli.accounts.signInNeeded"
+      : account.active
+        ? "settings.modelProvider.nativeCli.accounts.inUse"
+        : "settings.modelProvider.nativeCli.accounts.standby",
+  });
+  return (
+    <div data-slot="native-account-card" data-active={account.active || undefined} role="group" aria-label={label}>
+      <PlanStatusCardSurface
+        compact
+        trailingActionFillNarrow={false}
+        planTitle={label}
+        titleAccessory={
+          <>
+            {tier ? (
+              <Badge variant="secondary" className={tier.className}>
+                {tier.name}
+              </Badge>
+            ) : null}
+            {account.active ? (
+              <Badge variant="outline">
+                {intl.formatMessage({ id: "settings.modelProvider.nativeCli.accounts.current" })}
+              </Badge>
+            ) : null}
+          </>
+        }
+        statusMeta={
+          <p className={signInNeeded ? "text-ui-base text-warning" : "text-ui-base text-foreground-subtle"}>
+            {status}
+          </p>
+        }
+        trailingAction={
+          <div className="flex items-center gap-1">
+            {account.active ? null : (
+              <Button type="button" variant="outline" disabled={busy || signInNeeded} onClick={onSelect}>
+                {intl.formatMessage({ id: "settings.modelProvider.nativeCli.accounts.use" })}
+              </Button>
+            )}
+            <DropdownMenu>
+              <DropdownMenuTrigger asChild>
+                <Button
+                  type="button"
+                  variant="ghost"
+                  size="icon"
+                  disabled={busy}
+                  aria-label={intl.formatMessage(
+                    { id: "settings.modelProvider.nativeCli.accounts.more" },
+                    { account: label },
+                  )}
+                >
+                  <MoreHorizontal />
+                </Button>
+              </DropdownMenuTrigger>
+              <DropdownMenuContent align="end">
+                <DropdownMenuItem onSelect={onReconnect}>
+                  {intl.formatMessage({ id: "settings.modelProvider.nativeCli.accounts.reconnect" })}
+                </DropdownMenuItem>
+                <DropdownMenuItem variant="destructive" onSelect={onRemove}>
+                  {intl.formatMessage({ id: "settings.modelProvider.credentials.removeAccount" })}
+                </DropdownMenuItem>
+              </DropdownMenuContent>
+            </DropdownMenu>
+          </div>
+        }
+        usageContent={
+          signInNeeded ? undefined : (
+            <SubscriptionUsageSection
+              providerId={providerId}
+              revision={revision}
+              kind={kind}
+              accountId={account.id}
+              compact
+              reading={reading}
+              onScopeChanged={onScopeChanged}
+              showReset={false}
+            />
+          )
+        }
+      />
+    </div>
+  );
+}
+
+/** Several official-CLI sign-ins, laid out like the page's own model list: heading, cards, add. */
+export function NativeCliAccountList({
+  providerId,
+  kind,
+  accounts,
+  revision,
+  autoSwitch,
+  busy,
+  adding,
+  onAdd,
+  onReconnect,
+  onUpdate,
+  onScopeChanged,
+}: {
+  providerId: string;
+  kind: Kind;
+  accounts: Account[];
+  revision: string;
+  autoSwitch: boolean;
+  busy: boolean;
+  adding: boolean;
+  onAdd(): void;
+  /** Re-checks the current account's CLI home; a signed-out home opens that CLI's login. */
+  onReconnect(accountId: string): void;
+  onUpdate(change: { select?: string; remove?: string; autoSwitch?: boolean }): void;
+  onScopeChanged(): void;
+}) {
+  const { intl } = useZCodeIntl();
+  const confirm = useConfirmDialog();
+  const remove = async (account: Account) => {
+    const label = account.label ?? account.id;
+    const confirmed = await confirm({
+      title: intl.formatMessage(
+        { id: "settings.modelProvider.nativeCli.accounts.removeTitle" },
+        { account: label },
+      ),
+      description: intl.formatMessage({
+        id: "settings.modelProvider.nativeCli.accounts.removeDescription",
+      }),
+      confirmLabel: intl.formatMessage({ id: "settings.modelProvider.credentials.removeAccount" }),
+      confirmVariant: "destructive",
+      cancelLabel: intl.formatMessage({ id: "common.cancel" }),
+    });
+    if (confirmed) onUpdate({ remove: account.id });
+  };
+  return (
+    <section
+      data-slot="native-account-list"
+      className="space-y-2"
+      aria-label={intl.formatMessage({ id: "settings.modelProvider.credentials.accounts" })}
+    >
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-ui-base text-foreground-subtle">
+          {intl.formatMessage({ id: "settings.modelProvider.credentials.accounts" })}
+        </span>
+        <Button type="button" variant="ghost" disabled={busy || accounts.length >= 10} onClick={onAdd}>
+          {adding ? <LoaderCircleIcon className="animate-spin" /> : <Plus />}
+          {intl.formatMessage({ id: "settings.modelProvider.nativeCli.addAccount" })}
+        </Button>
+      </div>
+      {accounts.map((account) => (
+        <AccountCard
+          key={account.id}
+          providerId={providerId}
+          revision={revision}
+          kind={kind}
+          account={account}
+          busy={busy}
+          onSelect={() => onUpdate({ select: account.id })}
+          onReconnect={() => onReconnect(account.id)}
+          onRemove={() => void remove(account)}
+          onScopeChanged={onScopeChanged}
+        />
+      ))}
+      <CredentialAutoSwitchSection
+        kind="accounts"
+        count={accounts.length}
+        checked={autoSwitch}
+        disabled={busy}
+        hint={intl.formatMessage({ id: "settings.modelProvider.nativeCli.autoSwitchHint" })}
+        onCheckedChange={(checked) => onUpdate({ autoSwitch: checked })}
+      />
+    </section>
+  );
+}
