+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { NativeCliAccountList } from "../src/settings/model-provider-section/NativeCliAccountList.js";
+import { useConfirmDialogStore } from "../src/store/confirmDialogStore.js";
+import { auditLayout } from "./layoutAudit.js";
+import { NativeCliConnectionSection } from "../src/settings/model-provider-section/NativeCliConnectionSection.js";
+import { ProviderDetailFeedbackBoundary } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+const settle = () => act(async () => new Promise((resolve) => setTimeout(resolve, 40)));
+
+const ACCOUNTS = [
+  { id: "a", label: "very.long.account.name.for.layout@example-company.invalid", active: true },
+  { id: "b", label: "second@example.invalid", active: false },
+  { id: "c", label: "third@example.invalid", active: false },
+];
+
+async function fixture(locale: "zh-CN" | "en-US", theme: string, width: number) {
+  document.documentElement.className = theme;
+  // The page background the settings view sits on; contrast is measured against it.
+  const background = getComputedStyle(document.documentElement).getPropertyValue("--color-background").trim();
+  check(background, `Theme ${theme} defines no page background`);
+
+  const node = document.createElement("div");
+  node.className = `${theme} p-3`;
+  // Desktop CSS keeps <body> transparent for window vibrancy; the settings root paints this colour.
+  node.style.backgroundColor = background;
+  node.style.width = `${width}px`;
+  document.body.append(node);
+  const root = createRoot(node);
+  const updates: unknown[] = [];
+  const service = {
+    onDidChange: () => ({ dispose() {} }),
+    getSubscriptionUsage: async (_id: string, _refresh?: boolean, accountId?: string) =>
+      accountId === "c"
+        ? { status: "auth-required", accountId, connectionRevision: "r1" }
+        : {
+            status: "available",
+            accountId,
+            connectionRevision: "r1",
+            source: "fixture",
+            plan: accountId === "a" ? "max" : "pro",
+            observedAt: Date.now(),
+            refreshAfter: Date.now() + 60000,
+            windows: [
+              { id: "default:five_hour", usedPercent: accountId === "a" ? 38 : 0, windowMinutes: 300 },
+              { id: "default:seven_day", usedPercent: accountId === "a" ? 93 : 12, windowMinutes: 10080 },
+              { id: "Opus:seven_day", usedPercent: 100, windowMinutes: 10080 },
+            ],
+          },
+  };
+  await act(async () =>
+    root.render(
+      <ServiceProvider services={{ providerSettingsService: service } as never}>
+        <ZCodeIntlProvider initialLocale={locale}>
+          <TooltipProvider>
+          <div>
+            <NativeCliAccountList
+              providerId="claude-native"
+              kind="claude"
+              accounts={ACCOUNTS}
+              revision="r1"
+              autoSwitch={false}
+              busy={false}
+              adding={false}
+              onAdd={() => updates.push("add")}
+              onReconnect={(accountId) => updates.push({ reconnect: accountId })}
+              onUpdate={(change) => updates.push(change)}
+              onScopeChanged={() => {}}
+            />
+          </div>
+          </TooltipProvider>
+        </ZCodeIntlProvider>
+      </ServiceProvider>,
+    ),
+  );
+  await settle();
+  return {
+    node,
+    updates,
+    rows: () => [...node.querySelectorAll<HTMLElement>('[data-slot="native-account-card"]')],
+    async close() {
+      await act(async () => root.unmount());
+      node.remove();
+      document.documentElement.className = "";
+    },
+  };
+}
+
+function buttonByText(scope: ParentNode, text: string) {
+  return [...scope.querySelectorAll<HTMLElement>("button, [role=menuitem]")].find(
+    (element) => element.textContent?.trim() === text,
+  );
+}
+
+/** Computed type of each text role, keyed by role, for comparing two renderings. */
+function typeRoles(scope: HTMLElement) {
+  const size = (element: Element | null | undefined) =>
+    element ? `${getComputedStyle(element).fontSize}/${getComputedStyle(element).fontWeight}` : "missing";
+  const meterLabel = [...scope.querySelectorAll("span")].find((span) => /^(5小时|5 hr)$/.test(span.textContent?.trim() ?? ""));
+  return {
+    title: size(scope.querySelector("h3")),
+    status: size(scope.querySelector("p")),
+    allowanceHeading: size(scope.querySelector('[data-slot="subscription-usage"] h4, [data-slot="subscription-usage"] [role="heading"]') ?? [...scope.querySelectorAll("span,div,h4")].find((e) => /^(订阅额度|Plan allowance)/.test(e.textContent?.trim() ?? "") && !e.children.length)),
+    meterLabel: size(meterLabel),
+    meterValue: size(meterLabel?.nextElementSibling),
+  };
+}
+
+async function run() {
+  await test("multi-account cards keep the single-account card's typography role for role", async () => {
+    const theme = "theme-zai-light";
+    const multi = await fixture("zh-CN", theme, 720);
+    const single = document.createElement("div");
+    single.style.width = "720px";
+    document.body.append(single);
+    const root = createRoot(single);
+    const service = {
+      onDidChange: () => ({ dispose() {} }),
+      getSubscriptionAccounts: async () => ({ accounts: [{ id: "a", label: "a@example.invalid", active: true }], autoSwitch: false, revision: "r1" }),
+      getSubscriptionUsage: async () => ({
+        status: "available", accountId: "a", connectionRevision: "r1", source: "fixture", plan: "max", observedAt: Date.now(), refreshAfter: Date.now() + 60000,
+        windows: [
+          { id: "default:five_hour", usedPercent: 38, windowMinutes: 300 },
+          { id: "default:seven_day", usedPercent: 93, windowMinutes: 10080 },
+        ],
+      }),
+    };
+    try {
+      await act(async () =>
+        root.render(
+          <ServiceProvider services={{ providerSettingsService: service } as never}>
+            <PlatformProvider platform={{ openExternal: async () => {} } as never}>
+              <ZCodeIntlProvider initialLocale="zh-CN">
+                <TooltipProvider>
+                <ProviderDetailFeedbackBoundary>
+                  <NativeCliConnectionSection
+                    providerId="single"
+                    access={{ type: "native-cli", provider: "claude", connected: true, accountId: "a" }}
+                  />
+                </ProviderDetailFeedbackBoundary>
+                </TooltipProvider>
+              </ZCodeIntlProvider>
+            </PlatformProvider>
+          </ServiceProvider>,
+        ),
+      );
+      await settle();
+      const expected = typeRoles(single);
+      const actual = typeRoles(multi.rows()[0]!);
+      for (const role of Object.keys(expected) as (keyof typeof expected)[]) {
+        check(expected[role] !== "missing", `Single-account card has no ${role}`);
+        check(actual[role] === expected[role], `${role}: multi ${actual[role]} ≠ single ${expected[role]}`);
+      }
+    } finally {
+      await act(async () => root.unmount());
+      single.remove();
+      await multi.close();
+    }
+  });
+
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const theme of ["theme-zai-light", "theme-zai-dark"])
+      for (const width of [360, 720]) {
+        await test(`account list passes the layout audit: ${locale}/${theme}/${width}px`, async () => {
+          const f = await fixture(locale, theme, width);
+          try {
+            const issues = auditLayout(f.node);
+            const rows = f.rows();
+            check(rows.length === 3, "Every saved account needs a card");
+            check(
+              f.node.querySelectorAll('[data-slot="native-account-card"][data-active]').length === 1,
+              "Exactly one account is current",
+            );
+            // Cards are peers on the page, like the model list, not nested inside another card.
+            for (const card of rows)
+              check(
+                !card.parentElement!.closest(".rounded-xl"),
+                "Account card is nested inside another card",
+              );
+            // Account-wide windows only: the Opus weekly is not an account limit.
+            check(
+              rows[0]!.querySelectorAll('[role="progressbar"]').length >= 2,
+              "Current account shows its allowance",
+            );
+            check(
+              rows[2]!.querySelectorAll('[role="progressbar"]').length === 0 &&
+                rows[2]!.textContent?.includes(locale === "zh-CN" ? "需要重新登录" : "Sign in again"),
+              "An account that needs sign-in states it instead of inventing a quota",
+            );
+            // Nothing below the caption scale except design-system badges.
+            const floor = (() => {
+              const probe = document.createElement("span");
+              probe.className = "text-ui-sm";
+              f.node.append(probe);
+              const size = parseFloat(getComputedStyle(probe).fontSize);
+              probe.remove();
+              return size;
+            })();
+            for (const element of f.node.querySelectorAll<HTMLElement>("*")) {
+              if (!element.childNodes.length || element.closest('[data-slot="badge"]')) continue;
+              const own = [...element.childNodes].some((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim());
+              if (own)
+                check(
+                  parseFloat(getComputedStyle(element).fontSize) >= floor,
+                  `"${element.textContent?.trim().slice(0, 30)}" is below the caption size`,
+                );
+            }
+          } finally {
+            await f.close();
+          }
+        });
+      }
+
+  await test("switch, keyboard menu, confirmed removal and automatic switching reach the account owner", async () => {
+    const f = await fixture("zh-CN", "theme-zai-light", 720);
+    try {
+      const second = f.rows()[1]!;
+      const use = buttonByText(second, "切换到此账号");
+      check(use, "Inactive account lacks a switch action");
+      check(!buttonByText(f.rows()[0]!, "切换到此账号"), "Current account offers switching to itself");
+      check(
+        (buttonByText(f.rows()[2]!, "切换到此账号") as HTMLButtonElement | undefined)?.disabled,
+        "A signed-out account can be made current",
+      );
+      await act(async () => use.click());
+      check(JSON.stringify(f.updates.at(-1)) === JSON.stringify({ select: "b" }), "Switch did not select the account");
+
+      const trigger = second.querySelector<HTMLElement>('button[aria-haspopup="menu"]');
+      check(trigger?.getAttribute("aria-label")?.includes("second@example.invalid"), "Menu trigger lacks an account-specific name");
+      trigger.focus();
+      await act(async () => {
+        trigger.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+      });
+      await settle();
+      const items = [...document.querySelectorAll<HTMLElement>('[role="menuitem"]')].map((item) => item.textContent?.trim());
+      check(
+        JSON.stringify(items) === JSON.stringify(["重新登录此账号", "移除此账号"]),
+        `Unexpected menu: ${items.join("|")}`,
+      );
+      const menu = document.querySelector<HTMLElement>('[role="menu"]');
+      check(menu && menu.contains(document.activeElement), "Keyboard focus did not move into the menu");
+      await act(async () => {
+        document.activeElement!.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
+      });
+      await settle();
+      // Radix keeps the closed menu mounted for its exit animation; the state is what matters.
+      check(!document.querySelector('[role="menu"][data-state="open"]'), "Escape did not close the menu");
+      await act(async () => new Promise((resolve) => setTimeout(resolve, 400)));
+      check(document.activeElement === trigger, "Focus did not return to the menu trigger");
+
+      await act(async () => {
+        trigger.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+      });
+      await settle();
+      const removeItem = buttonByText(document, "移除此账号");
+      check(removeItem, "Remove action missing");
+      await act(async () => removeItem.click());
+      await settle();
+      const pending = useConfirmDialogStore.getState().pendingRequest;
+      check(pending?.title.includes("second@example.invalid"), "Removal is not confirmed by name");
+      check(!f.updates.some((u) => JSON.stringify(u).includes("remove")), "Removed before confirmation");
+      await act(async () => useConfirmDialogStore.getState().settleConfirmation(true));
+      await settle();
+      check(JSON.stringify(f.updates.at(-1)) === JSON.stringify({ remove: "b" }), "Confirmed removal did not reach the owner");
+
+      const toggle = f.node.querySelector<HTMLElement>('[role="switch"]');
+      check(toggle, "Automatic switching missing with several accounts");
+      await act(async () => toggle.click());
+      check(JSON.stringify(f.updates.at(-1)) === JSON.stringify({ autoSwitch: true }), "Toggle did not enable automatic switching");
+
+    } finally {
+      await f.close();
+    }
+  });
+}
+(window as any).__nativeAccountListTests = run().then(() => results);
