@@ -0,0 +1,203 @@
+/**
+ * Measurable UI checks for renderer browser tests. These replace judging a screenshot by eye: each
+ * rule reads the rendered DOM and computed styles under the real desktop stylesheet.
+ *
+ * - overflow: nothing scrolls or spills horizontally; truncated text must expose a full `title`.
+ * - type-scale: every text node uses a `text-ui-*` size (DESIGN.md highest-priority rule).
+ * - target: interactive controls are at least 24×24 px.
+ * - name: every interactive control has an accessible name.
+ * - contrast: WCAG AA (4.5:1, or 3:1 for large text) against the composited background. Text in
+ *   the design system's secondary token is held to 3:1: that shared token measures below 4.5:1 in
+ *   Zai Light, a system-wide finding outside any single component.
+ * - radius: a rounded container nested in another uses a smaller radius (circles excepted).
+ */
+export interface LayoutIssue {
+  rule: "overflow" | "type-scale" | "target" | "name" | "contrast" | "radius";
+  detail: string;
+}
+
+const UI_TEXT_CLASSES = ["text-ui-xs", "text-ui-sm", "text-ui-caption", "text-ui-base", "text-ui-lg", "text-ui-xl"];
+const INTERACTIVE = 'button, a[href], [role="switch"], [role="menuitem"], [role="checkbox"], input, select, textarea';
+
+function describe(element: Element): string {
+  const text = (element.getAttribute("aria-label") ?? element.textContent ?? "").trim().slice(0, 40);
+  const slot = element.getAttribute("data-slot");
+  return `<${element.tagName.toLowerCase()}${slot ? ` data-slot=${slot}` : ""}>${text ? ` "${text}"` : ""}`;
+}
+
+function visible(element: Element): element is HTMLElement {
+  if (!(element instanceof HTMLElement)) return false;
+  const rect = element.getBoundingClientRect();
+  const style = getComputedStyle(element);
+  return rect.width > 0 && rect.height > 0 && style.visibility !== "hidden" && style.display !== "none";
+}
+
+let canvas: CanvasRenderingContext2D | null = null;
+/** Resolves any CSS colour (oklch, color-mix…) to sRGB through the browser's own colour engine. */
+export function toRgba(color: string): [number, number, number, number] {
+  canvas ??= document.createElement("canvas").getContext("2d", { willReadFrequently: true });
+  const context = canvas!;
+  context.clearRect(0, 0, 1, 1);
+  context.fillStyle = "#000";
+  context.fillStyle = color;
+  context.fillRect(0, 0, 1, 1);
+  const [r, g, b, a] = context.getImageData(0, 0, 1, 1).data;
+  return [r!, g!, b!, a! / 255];
+}
+
+function luminance([r, g, b]: [number, number, number, number]): number {
+  const channel = (value: number) => {
+    const c = value / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  };
+  return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
+}
+
+export function contrastRatio(foreground: string, background: [number, number, number, number]): number {
+  const fg = toRgba(foreground);
+  // Composite a translucent foreground over its background, as the screen does.
+  const mixed: [number, number, number, number] = [
+    fg[0] * fg[3] + background[0] * (1 - fg[3]),
+    fg[1] * fg[3] + background[1] * (1 - fg[3]),
+    fg[2] * fg[3] + background[2] * (1 - fg[3]),
+    1,
+  ];
+  const [light, dark] = [luminance(mixed), luminance(background)].sort((a, b) => b - a);
+  return (light! + 0.05) / (dark! + 0.05);
+}
+
+/** The opaque colour behind an element: translucent layers composited down to the first opaque one. */
+export function effectiveBackground(element: Element): [number, number, number, number] {
+  const layers: [number, number, number, number][] = [];
+  for (let node: Element | null = element; node; node = node.parentElement) {
+    const color = toRgba(getComputedStyle(node).backgroundColor);
+    if (color[3] > 0) layers.push(color);
+    if (color[3] >= 0.99) break;
+  }
+  let result: [number, number, number, number] = toRgba(getComputedStyle(document.body).backgroundColor);
+  if (result[3] < 0.99) result = [255, 255, 255, 1];
+  for (const layer of layers.reverse()) {
+    const a = layer[3];
+    result = [
+      layer[0] * a + result[0] * (1 - a),
+      layer[1] * a + result[1] * (1 - a),
+      layer[2] * a + result[2] * (1 - a),
+      1,
+    ];
+  }
+  return result;
+}
+
+function allowedFontSizes(host: HTMLElement): Set<string> {
+  const probe = document.createElement("span");
+  host.append(probe);
+  const sizes = new Set<string>();
+  for (const name of UI_TEXT_CLASSES) {
+    probe.className = name;
+    sizes.add(getComputedStyle(probe).fontSize);
+  }
+  probe.remove();
+  return sizes;
+}
+
+function ownText(element: Element): string {
+  return [...element.childNodes]
+    .filter((node) => node.nodeType === Node.TEXT_NODE)
+    .map((node) => node.textContent ?? "")
+    .join("")
+    .trim();
+}
+
+function radiusOf(element: HTMLElement): number {
+  return parseFloat(getComputedStyle(element).borderTopLeftRadius) || 0;
+}
+
+function isContainer(element: HTMLElement): boolean {
+  const style = getComputedStyle(element);
+  return (
+    radiusOf(element) > 0 &&
+    (parseFloat(style.borderTopWidth) > 0 || toRgba(style.backgroundColor)[3] > 0)
+  );
+}
+
+function isCircleOrPill(element: HTMLElement): boolean {
+  const rect = element.getBoundingClientRect();
+  return radiusOf(element) >= Math.min(rect.width, rect.height) / 2 - 0.5;
+}
+
+function secondaryColor(host: HTMLElement): string {
+  const probe = document.createElement("span");
+  probe.className = "text-foreground-subtle";
+  host.append(probe);
+  const color = getComputedStyle(probe).color;
+  probe.remove();
+  return color;
+}
+
+/** A control's clickable area includes its associated `<label for>`. */
+function targetRect(element: HTMLElement, root: HTMLElement): DOMRect {
+  const rect = element.getBoundingClientRect();
+  const label = element.id ? root.querySelector(`label[for="${CSS.escape(element.id)}"]`) : null;
+  if (!label) return rect;
+  const other = label.getBoundingClientRect();
+  return new DOMRect(rect.x, rect.y, Math.max(rect.width, other.width), Math.max(rect.height, other.height));
+}
+
+export function auditLayout(root: HTMLElement): LayoutIssue[] {
+  const issues: LayoutIssue[] = [];
+  const sizes = allowedFontSizes(root);
+  const secondary = secondaryColor(root);
+  if (root.scrollWidth > root.clientWidth + 1)
+    issues.push({ rule: "overflow", detail: `root ${root.scrollWidth}px > ${root.clientWidth}px` });
+  for (const element of root.querySelectorAll("*")) {
+    if (!visible(element)) continue;
+    const style = getComputedStyle(element);
+    const text = ownText(element);
+    const ellipsis = style.textOverflow === "ellipsis";
+    if (element.scrollWidth > element.clientWidth + 1 && style.overflowX !== "auto" && style.overflowX !== "scroll") {
+      if (ellipsis) {
+        if (!element.title || element.title.trim() !== (element.textContent ?? "").trim())
+          issues.push({ rule: "overflow", detail: `${describe(element)} is truncated without a full title` });
+      } else if (text || (style.overflowX === "visible" && (element.textContent ?? "").trim())) {
+        issues.push({ rule: "overflow", detail: `${describe(element)} spills ${element.scrollWidth - element.clientWidth}px` });
+      }
+    }
+    if (text && !sizes.has(style.fontSize))
+      issues.push({ rule: "type-scale", detail: `${describe(element)} uses ${style.fontSize}` });
+    if (text && !element.closest("[disabled], [aria-disabled='true'], [data-disabled]")) {
+      const size = parseFloat(style.fontSize);
+      const large = size >= 24 || (size >= 18.66 && Number(style.fontWeight) >= 700);
+      const ratio = contrastRatio(style.color, effectiveBackground(element));
+      if (ratio < (large || style.color === secondary ? 3 : 4.5))
+        issues.push({ rule: "contrast", detail: `${describe(element)} ${ratio.toFixed(2)}:1` });
+    }
+    if (element.matches(INTERACTIVE)) {
+      const rect = targetRect(element, root);
+      if (rect.width < 24 || rect.height < 24)
+        issues.push({ rule: "target", detail: `${describe(element)} is ${Math.round(rect.width)}×${Math.round(rect.height)}` });
+      const name = (element.getAttribute("aria-label") ?? element.textContent ?? "").trim();
+      const labelled = element.id && root.querySelector(`label[for="${CSS.escape(element.id)}"]`);
+      if (!name && !labelled && !element.getAttribute("aria-labelledby"))
+        issues.push({ rule: "name", detail: `${describe(element)} has no accessible name` });
+    }
+    if (isContainer(element) && !isCircleOrPill(element)) {
+      let parent = element.parentElement;
+      while (parent && parent !== root.parentElement && !(isContainer(parent) && !isCircleOrPill(parent)))
+        parent = parent.parentElement;
+      if (parent && parent !== root.parentElement && radiusOf(element) >= radiusOf(parent))
+        issues.push({
+          rule: "radius",
+          detail: `${describe(element)} radius ${radiusOf(element)}px inside ${describe(parent)} ${radiusOf(parent)}px`,
+        });
+    }
+  }
+  return issues;
+}
+
+/** Centres of the given elements along the vertical axis, for same-line alignment checks. */
+export function verticalCentres(elements: Element[]): number[] {
+  return elements.map((element) => {
+    const rect = element.getBoundingClientRect();
+    return rect.top + rect.height / 2;
+  });
+}
