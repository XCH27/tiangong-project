+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { ProviderSettingsFacade, ModelConfig, type DecisionSourceSaveInput } from "@zcode/provider";
+import { NodeProviderRegistryRuntime } from "@zcode/provider-node";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-atomic-source-"));
+  const path = join(root, "personal.json");
+  const options = {
+    personalFilePath: path,
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let runtime = new NodeProviderRegistryRuntime(options);
+  await runtime.start();
+  let failProjection = false;
+  const facade = () =>
+    new ProviderSettingsFacade(runtime.registryService, {
+      saveDecisionSource: (input, assertCurrent) =>
+        runtime.configService.saveDecisionSource(input, assertCurrent),
+      refresh: async (reason) => {
+        if (failProjection) {
+          failProjection = false;
+          throw new Error("projection unavailable");
+        }
+        return runtime.registryService.refresh(reason);
+      },
+    } as never);
+  return {
+    get runtime() {
+      return runtime;
+    },
+    facade,
+    path,
+    input: async (
+      overrides: Partial<DecisionSourceSaveInput> = {},
+    ): Promise<DecisionSourceSaveInput> => ({
+      target: { kind: "create", providerId: `decision-source-${randomUUID()}` },
+      expectedPersonalRevision: (await runtime.personalRepository.read()).revision,
+      expectedBuiltinRevision: runtime.registryService.getSnapshot()!.config.zcodeBuiltinRevision,
+      templateId: "fleet-laya-local",
+      config: { access: { type: "api-key", apiKey: "" } },
+      modelId: "auto",
+      ...overrides,
+    }),
+    failProjection() {
+      failProjection = true;
+    },
+    async reopen() {
+      runtime.dispose();
+      runtime = new NodeProviderRegistryRuntime(options);
+      await runtime.start();
+    },
+    async close() {
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+test("source, model membership and purpose binding commit in one Personal write and survive reopen", async () => {
+  const f = await fixture();
+  try {
+    const before = await f.runtime.personalRepository.read();
+    await f.runtime.personalRepository.update((current) => ({
+      ...current,
+      newConversationModelPolicy: "recent",
+      decisionModelSettings: {
+        enabled: false,
+        automaticTiers: { standard: { providerId: "unchanged", modelId: "main" } },
+      },
+    }));
+    let writes = 0;
+    const original = f.runtime.personalRepository.update.bind(f.runtime.personalRepository);
+    f.runtime.personalRepository.update = async (transform) => {
+      writes++;
+      return original(transform);
+    };
+    const input = await f.input({ modelId: "private-classifier" });
+    const receipt = await f.facade().saveDecisionSource(input);
+    assert.equal(writes, 1);
+    assert.equal(receipt.publicationPending, false);
+    assert.equal(receipt.view?.personalRevision, receipt.personalRevision);
+    const saved = await f.runtime.personalRepository.read();
+    assert.deepEqual(saved.decisionModelSettings, {
+      enabled: false,
+      selection: receipt.selection,
+      automaticTiers: { standard: { providerId: "unchanged", modelId: "main" } },
+    });
+    assert.ok(
+      saved.providers
+        .get(input.target.providerId)
+        ?.personalModelIds?.includes("private-classifier"),
+    );
+    assert.ok(saved.models.getExact(input.target.providerId, "private-classifier"));
+    assert.equal(saved.newConversationModelPolicy, "recent");
+    assert.deepEqual(saved.defaultModelSelection, before.defaultModelSelection);
+    await f.reopen();
+    assert.deepEqual(
+      (await f.runtime.personalRepository.read()).decisionModelSettings,
+      saved.decisionModelSettings,
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("pre-commit write failure leaves no provider, model or binding; the same identity can retry", async () => {
+  const f = await fixture();
+  try {
+    const input = await f.input({ modelId: "private-classifier" });
+    const before = await f.runtime.personalRepository.read();
+    const update = f.runtime.personalRepository.update.bind(f.runtime.personalRepository);
+    f.runtime.personalRepository.update = async (transform) => {
+      return update((current) => {
+        transform(current);
+        throw new Error("write unavailable");
+      });
+    };
+    await assert.rejects(f.facade().saveDecisionSource(input), /write unavailable/);
+    assert.equal((await f.runtime.personalRepository.read()).revision, before.revision);
+    f.runtime.personalRepository.update = update;
+    await f.facade().saveDecisionSource(input);
+    assert.equal(
+      (await f.runtime.personalRepository.read()).providers
+        .rules()
+        .filter((row) => row.providerId === input.target.providerId).length,
+      1,
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("committed acknowledgement loss reconciles from the same source after cold reopen without another connection", async () => {
