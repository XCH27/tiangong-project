diff --git a/packages/provider/src/decision-source-save.ts b/packages/provider/src/decision-source-save.ts
new file mode 100644
index 0000000..27939d3
--- /dev/null
+++ b/packages/provider/src/decision-source-save.ts
@@ -0,0 +1,178 @@
+import { z } from "zod";
+import {
+  ProviderConfig,
+  ModelConfig,
+  ModelConfigRules,
+  parseProviderConfig,
+} from "./config/index.js";
+import type { ProviderConfigLayerSnapshot, ProviderConfigLayerUpdate } from "./config-service.js";
+import { getEnabledApiKeys } from "./api-key-credentials.js";
+import { isLocalClassifierEndpoint } from "./classifier-models.js";
+
+export const decisionSourceSaveSchema = z
+  .object({
+    target: z.discriminatedUnion("kind", [
+      z
+        .object({
+          kind: z.literal("create"),
+          providerId: z
+            .string()
+            .regex(
+              /^decision-source-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/,
+            ),
+        })
+        .strict(),
+      z
+        .object({ kind: z.literal("existing"), providerId: z.string().trim().min(1).max(256) })
+        .strict(),
+    ]),
+    expectedPersonalRevision: z.string().min(1).max(256),
+    expectedBuiltinRevision: z.string().min(1).max(256),
+    templateId: z.string().trim().min(1).max(256).optional(),
+    providerName: z.string().trim().min(1).max(200).optional(),
+    locale: z.enum(["en-US", "zh-CN"]).optional(),
+    config: z.object({ api: z.unknown().optional(), access: z.unknown().optional() }).strict(),
+    modelId: z.string().trim().min(1).max(256),
+  })
+  .strict();
+export type DecisionSourceSaveInput = z.infer<typeof decisionSourceSaveSchema>;
+export interface DecisionSourceCommit {
+  providerId: string;
+  personalRevision: string;
+  selection: { providerId: string; modelId: string };
+  reconciled: boolean;
+}
+export function sourceSaveConflict(message = "The source changed; reload before saving"): Error {
+  return Object.assign(new Error(message), { code: "decision_source_conflict" });
+}
+const equivalent = (left: unknown, right: unknown): boolean => {
+  const canonical = (value: any): any =>
+    Array.isArray(value)
+      ? value.map(canonical)
+      : value && typeof value === "object"
+        ? Object.fromEntries(
+            Object.keys(value)
+              .sort()
+              .filter((key) => value[key] !== undefined)
+              .map((key) => [key, canonical(value[key])]),
+          )
+        : value;
+  return JSON.stringify(canonical(left)) === JSON.stringify(canonical(right));
+};
+const matchesRequestedLabel = (saved: string | null | undefined, requested: string): boolean => {
+  if (saved === requested) return true;
+  // 原 Provider 命名器会为同名连接添加数字后缀；确认丢失后的重试必须识别该已提交名称。
+  if (!saved?.startsWith(`${requested} `)) return false;
+  return /^[2-9]$|^[1-9][0-9]+$/.test(saved.slice(requested.length + 1));
+};
+/** Pure transaction transform. The existing Personal repository owns lock/write/publication. */
+export function buildDecisionSourceUpdate(
+  input: DecisionSourceSaveInput,
+  builtin: ProviderConfigLayerSnapshot,
+  current: ProviderConfigLayerSnapshot,
+  label: string,
+): { update: ProviderConfigLayerUpdate; reconciled: boolean } {
+  const { providerId } = input.target;
+  const create = input.target.kind === "create";
+  const rule = current.providers.getRule(providerId);
+  if (!create && !rule)
+    throw sourceSaveConflict("The source was removed; it cannot be recreated by a late save");
+  if (!create && (input.templateId !== undefined || input.providerName !== undefined))
+    throw new Error("An existing source keeps its identity and label");
+  if (create && builtin.providers.has(providerId)) throw sourceSaveConflict();
+  const templateId = create ? input.templateId : rule?.templateId;
+  const template = templateId ? builtin.providerTemplates?.get(templateId) : undefined;
+  if (templateId && !template) throw new Error("Decision source template is unavailable");
+  const submitted = parseProviderConfig(input.config);
+  const baseline = template?.config ?? new ProviderConfig();
+  const existing =
+    rule?.config ??
+    new ProviderConfig({ group: "standard-personal", personalModelIds: [], modelOrder: [] });
+  const proposed = create
+    ? new ProviderConfig({
+        group: "standard-personal",
+        personalModelIds: [],
+        modelOrder: [],
+      }).overlay(submitted)
+    : existing.overlay(submitted);
+  const effective = baseline.overlay(proposed);
+  if (effective.api?.type !== "typesafe-system-one" || effective.access?.type !== "api-key")
+    throw new Error("Only dedicated System One sources can use this operation");
+  const url = new URL(effective.api.baseUrl ?? "");
+  if (
+    !["http:", "https:"].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  )
+    throw new Error("Invalid decision service address");
+  if (!getEnabledApiKeys(effective.access).length && !isLocalClassifierEndpoint(url.href))
+    throw new Error("A remote decision source requires an enabled API key");
+  if (rule?.enabled === false) throw new Error("The source is disabled");
+  const model = ModelConfigRules.composeEffective(builtin.models, current.models).resolve({
+    providerId,
+    templateId,
+    modelId: input.modelId,
+    apiType: effective.api.type,
+    baseUrl: effective.api.baseUrl,
+  });
+  if (model.enabled === false) throw new Error("The selected decision model is disabled");
+  const member =
+    (template?.config.builtinModelIds ?? []).includes(input.modelId) ||
+    existing.personalModelIds?.includes(input.modelId);
+  const currentEffective = baseline.overlay(existing);
+  const selection = current.decisionModelSettings?.selection;
+  if (
+    rule &&
+    member &&
+    selection?.providerId === providerId &&
+    selection.modelId === input.modelId &&
+    (!create || (rule.templateId ?? undefined) === input.templateId) &&
+    (!input.providerName || matchesRequestedLabel(rule.providerName, input.providerName)) &&
+    equivalent(
+      { api: currentEffective.api?.toJSON(), access: currentEffective.access?.toJSON() },
+      { api: effective.api?.toJSON(), access: effective.access?.toJSON() },
+    )
+  ) {
+    return { update: current, reconciled: true };
+  }
+  // A repeated create with changed facts must not overwrite the record or a later binding.
+  if (create && rule) throw sourceSaveConflict();
+  if (
+    current.revision !== input.expectedPersonalRevision ||
+    builtin.revision !== input.expectedBuiltinRevision
+  )
+    throw sourceSaveConflict();
+  let personal = proposed;
+  let models = current.models;
+  if (!member) {
+    personal = personal
+      .withPersonalModelIds([...(personal.personalModelIds ?? []), input.modelId])
+      .withManualModelIds([...new Set([...(personal.manualModelIds ?? []), input.modelId])])
+      .withModelOrder([...new Set([...(personal.modelOrder ?? []), input.modelId])]);
+    if (!models.getExact(providerId, input.modelId))
+      models = models.setExact(providerId, input.modelId, new ModelConfig({ enabled: true }), true);
+  }
+  const providers = current.providers.setRule(
+    create
+      ? { providerId, ...(templateId ? { templateId } : {}), providerName: label, config: personal }
+      : { ...rule!, config: personal },
+  );
+  return {
+    reconciled: false,
+    update: {
+      ...current,
+      providers,
+      models,
+      providerOrder: create
+        ? [...(current.providerOrder ?? []), providerId]
+        : current.providerOrder,
+      decisionModelSettings: {
+        ...current.decisionModelSettings,
+        enabled: current.decisionModelSettings?.enabled === true,
+        selection: { providerId, modelId: input.modelId },
+      },
+    },
+  };
+}
