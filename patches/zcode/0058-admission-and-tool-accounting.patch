@@ -0,0 +1,44 @@
+import type { TurnInputIntentMetadata, TurnState } from "./deps.js";
+import type { ExecuteTurnOptions } from "./types.js";
+
+/** Admission owns a value snapshot; live cancellation and credential ports retain their owners. */
+export function snapshotInputMetadata<
+  T extends {
+    intent?: TurnInputIntentMetadata;
+    toolDisallowlist?: readonly string[];
+  },
+>(input: T): T {
+  return {
+    ...input,
+    ...(input.intent ? { intent: structuredClone(input.intent) } : {}),
+    ...(input.toolDisallowlist ? { toolDisallowlist: [...input.toolDisallowlist] } : {}),
+  };
+}
+
+export function snapshotPromptOptions(
+  options: ExecuteTurnOptions | undefined,
+): ExecuteTurnOptions | undefined {
+  if (!options) return;
+  return {
+    ...snapshotInputMetadata(options),
+    ...(options.sharedContextRefs
+      ? { sharedContextRefs: structuredClone(options.sharedContextRefs) }
+      : {}),
+    ...(options.modelExecution
+      ? {
+          modelExecution: {
+            ...options.modelExecution,
+            ...(options.modelExecution.subagents
+              ? { subagents: { ...options.modelExecution.subagents } }
+              : {}),
+          },
+        }
+      : {}),
+  };
+}
+
+export function snapshotAttachments(
+  attachments: TurnState["attachments"],
+): TurnState["attachments"] {
+  return attachments && structuredClone(attachments);
+}
