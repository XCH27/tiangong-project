@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { NodeProviderRegistryRuntime } from "@zcode/provider-node";
+import { ProviderSettingsFacade, parseModelConfig, parseProviderConfig } from "@zcode/provider";
+
+test("stale model visibility rejects without overwriting a concurrent edit; fresh change survives reopen", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-model-toggle-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let runtime = new NodeProviderRegistryRuntime(options);
+  try {
+    await runtime.start();
+    const { providerId } = await runtime.configService.createPersonalProvider({
+      providerName: "Fixture",
+      initialConfig: parseProviderConfig({
+        api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+        access: { type: "api-key", apiKey: "synthetic" },
+      }),
+    });
+    await runtime.configService.addPersonalModel(
+      providerId,
+      "fixture-model",
+      parseModelConfig({ enabled: true }),
+    );
+    await runtime.registryService.refresh("fixture");
+    const facade = new ProviderSettingsFacade(runtime.registryService, {
+      setPersonalModelEnabled: (
+        ...args: Parameters<typeof runtime.configService.setPersonalModelEnabled>
+      ) => runtime.configService.setPersonalModelEnabled(...args),
+      refresh: (reason: string) => runtime.registryService.refresh(reason),
+    } as never);
+    const stale = facade.getView().revision;
+    await runtime.configService.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig({ api: { baseUrl: "https://changed.fixture.invalid/v1" } }),
+    );
+    await runtime.registryService.refresh("concurrent edit");
+    const before = await readFile(options.personalFilePath, "utf8");
+    await assert.rejects(
+      facade.setPersonalModelEnabled(providerId, "fixture-model", false, stale),
+      /revision conflict/,
+    );
+    assert.equal(await readFile(options.personalFilePath, "utf8"), before);
+    await facade.setPersonalModelEnabled(
+      providerId,
+      "fixture-model",
+      false,
+      facade.getView().revision,
+    );
+    runtime.dispose();
+    runtime = new NodeProviderRegistryRuntime(options);
+    await runtime.start();
+    const saved = (await runtime.configService.read()).personalModels
+      .getExact(providerId, "fixture-model")!
+      .toJSON();
+    assert.equal(saved.enabled, false);
+    const restored = (await runtime.configService.read()).personalProviders
+      .get(providerId)!
+      .toJSON();
+    assert.equal(
+      restored.api?.baseUrl,
+      "https://changed.fixture.invalid/v1",
+      "the model action cannot overwrite the newer endpoint",
+    );
+  } finally {
+    runtime.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
