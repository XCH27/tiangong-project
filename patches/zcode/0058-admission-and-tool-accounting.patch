+        abortSignal: controller.signal,
+      });
+      await entered.promise;
+      controller.abort(new Error("Stop"));
+      permission.resolve({ decision: "allow" });
+      await assert.rejects(running);
+      assert.equal(f.effects, 0);
+      assert.equal(f.requests.length, 1);
+      assert.equal(f.toolFacts()[0]!.status, "cancelled");
+      const stats = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(stats.toolTotals.toolErrorCount, 0, "Stop is not a tool failure");
+    } finally {
+      permission.resolve({ decision: "deny" });
+      await running?.catch(() => {});
+      await f.close();
+    }
+  },
+);
+
+test(
+  "model-scoped activity retains tools across a Guide model switch",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    const entered = Promise.withResolvers<void>(),
+      release = Promise.withResolvers<void>();
+    let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+    try {
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("first tool", [call("model-a-tool", "one")]);
+        },
+        () => reply("second tool", [call("model-b-tool", "two")]),
+        () => reply("complete"),
+      );
+      running = f.runtime.executeTurn("First model");
+      await entered.promise;
+      const intent = {
+        sourceCommandId: "activity-guide",
+        queueItemId: "activity-item",
+        clientId: "fixture",
+        kind: "sendText",
+        admissionSeq: 1,
+        admittedAt: Date.now(),
+        requestedDelivery: "guide",
+        admittedDelivery: "guide",
+        modelSelection: selection("model-b"),
+      } as const;
+      assert.equal(
+        (
+          await f.runtime.admitPrompt("Continue with model B", undefined, {
+            intent,
+            queueDelivery: "guide",
+          })
+        ).kind,
+        "queued",
+      );
+      release.resolve();
+      await running;
+      const stats = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(stats.toolTotals.toolCallCount, 2);
+      assert.deepEqual(
+        stats.modelActivities?.map((item) => [item.modelId, item.toolCallCount]),
+        [
+          ["model-a", 1],
+          ["model-b", 1],
+        ],
+      );
+      await f.reopen();
+      const restored = await f.store.queryAppUsage({
+        since: 0,
+        until: Date.now() + 1,
+        tzOffsetMs: 0,
+      });
+
+      assert.deepEqual(restored.modelActivities, stats.modelActivities);
+    } finally {
+      release.resolve();
+      await running?.catch(() => {});
+      await f.close();
+    }
+  },
+);
+
+test("final accounting retains the real permission decision", { timeout: 10000 }, async () => {
+  for (const denied of [false, true]) {
+    const f = await fixture("pi", true);
+    try {
+      if (denied) f.deny();
+      f.steps.push(
+        () => reply("requires permission", [call("approval", "write")]),
+        () => reply("done"),
+      );
+      await f.runtime.executeTurn("Run a permission-controlled tool");
+      assert.equal(f.toolFacts()[0]!.approval_status, denied ? "denied" : "allowed");
+      assert.equal(f.effects, denied ? 0 : 1);
+    } finally {
+      await f.close();
+    }
+  }
+});
