+test("exact request receipts attribute skills once and reject conflicting model identities", async () => {
+  const f = await fixture();
+  const turnID = "mixed-exact" as TurnId;
+  const at = Date.UTC(2026, 7, 1);
+  try {
+    const request = (modelId: string, ids: string[]) => ({
+      modelId,
+      turnID,
+      providerMetadata: { fleetAccounting: { toolUsageIds: ids } },
+    });
+    await f.record(
+      "exact-a",
+      "a",
+      "standard",
+      request("model-a", ["tool-a", "skill-a", "ambiguous"]),
+    );
+    await f.record(
+      "exact-a",
+      "a",
+      "standard",
+      request("model-a", ["tool-a", "skill-a", "ambiguous"]),
+    );
+    await f.record("exact-b", "a", "standard", request("model-b", ["tool-b", "ambiguous"]));
+    for (const id of ["tool-a", "skill-a", "tool-b", "ambiguous"]) {
+      await f.store.upsertToolUsage({
+        id,
+        sessionID: "session" as SessionId,
+        turnID,
+        toolCallID: id,
+        toolName: id === "skill-a" ? "Skill" : "Read",
+        status: "completed",
+        startedAt: at,
+        durationMs: 4,
+        ...(id === "skill-a"
+          ? {
+              skillMetadata: {
+                qualifiedName: "suite:review",
+                pluginId: "suite@registry",
+                source: "plugin",
+              },
+            }
+          : {}),
+      });
+    }
+    f.reopen();
+    const result = await f.query();
+    assert.equal(result.toolTotals.toolCallCount, 4);
+    const a = result.modelActivities?.find((model) => model.modelId === "model-a");
+    const b = result.modelActivities?.find((model) => model.modelId === "model-b");
+    assert.equal(a?.toolCallCount, 2);
+    assert.equal(b?.toolCallCount, 1);
+    assert.equal(a?.skills[0]?.skillId, "suite:review");
+    assert.equal(a?.skills[0]?.callCount, 1);
+    assert.equal(a?.unidentifiedSkillCalls, 0);
+  } finally {
+    await f.close();
+  }
+});
