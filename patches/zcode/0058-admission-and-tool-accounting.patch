+    const f = await fixture("pi", true);
+    const entered = Promise.withResolvers<void>(),
+      release = Promise.withResolvers<void>();
+    const running: Array<ReturnType<typeof f.runtime.executeTurn>> = [];
+    try {
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("first done");
+        },
+        () => reply("second done"),
+      );
+      running.push(f.runtime.executeTurn("First input"));
+      await entered.promise;
+      running.push(f.runtime.executeTurn("Queued input"));
+      f.runtime.setSessionModelSelection(selection("model-b"));
+      release.resolve();
+      await Promise.all(running);
+      assert.deepEqual(
+        f.requests.map((request) => request.selection.modelId),
+        ["model-a", "model-a"],
+      );
+    } finally {
+      release.resolve();
+      await Promise.allSettled(running);
+      await f.close();
+    }
+  },
+);
+
+test(
+  "a late permission grant after Stop cannot execute an effect",
