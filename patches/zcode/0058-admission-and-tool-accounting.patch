+      attachments.length = 0;
+      release.resolve();
+      await Promise.all(running);
+    } finally {
+      release.resolve();
+      await Promise.allSettled(running);
+      await f.close();
+    }
+  },
+);
+
+test(
+  "queued direct execution uses its accepted model rather than a later picker change",
+  { timeout: 10000 },
