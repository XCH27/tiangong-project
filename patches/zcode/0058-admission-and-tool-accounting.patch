+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, selection, reply, call } from "./helpers/pi-runtime-fixture.js";
+
+test(
+  "reused upstream tool-call IDs retain separate request receipts",
+  { timeout: 10000 },
+  async () => {
+    for (const sameInput of [false, true]) {
+      const f = await fixture("pi", true);
+      try {
+        f.steps.push(() => reply("one", [call("upstream-reused", "one")]));
+        if (!sameInput) f.steps.push(() => reply("first done"));
+        f.steps.push(
+          () => reply("two", [call("upstream-reused", "two")]),
+          () => reply("done"),
+        );
+        await f.runtime.executeTurn("First request");
+        if (!sameInput) await f.runtime.executeTurn("Second request");
+        assert.equal(f.effects, 2);
+        const result = await f.store.queryAppUsage({
+          since: 0,
+          until: Date.now() + 1,
+          tzOffsetMs: 0,
+        });
+        assert.equal(result.toolTotals.toolCallCount, 2);
+        assert.equal(result.modelActivities?.[0]?.toolCallCount, 2);
+      } finally {
+        await f.close();
+      }
+    }
+  },
+);
+
+test(
+  "accepted model options cannot be mutated during model initialization",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    const intent = {
+      sourceCommandId: "command",
+      queueItemId: "item",
+      clientId: "fixture",
+      kind: "sendText",
+      admissionSeq: 0,
+      admittedAt: Date.now(),
+      requestedDelivery: "startNow",
+      admittedDelivery: "startNow",
+      modelSelection: { ...selection(), options: { reasoningLevel: "off", speedMode: "standard" } },
+      subscriptionAccountId: "account-a",
+    } as const;
+    try {
+      f.enableSubscription();
+      f.steps.push(() => reply("done"));
+      const accepted = await f.runtime.admitPrompt("Use the selected model", undefined, { intent });
+      assert.equal(accepted.kind, "started");
+      intent.modelSelection.modelId = "model-b";
+      intent.modelSelection.options.reasoningLevel = "high";
+      intent.modelSelection.options.speedMode = "fast";
+      if (accepted.kind === "started") await accepted.completion;
+      assert.equal(f.requests[0]!.selection.modelId, "model-a");
+      assert.equal(f.requests[0]!.selection.options.reasoningLevel, "off");
+      assert.equal(f.requests[0]!.selection.options.speedMode, "standard");
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "Guide keeps its accepted model and account after the caller edits its draft",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    const entered = Promise.withResolvers<void>(),
+      release = Promise.withResolvers<void>();
+    let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+    try {
+      f.enableSubscription();
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("first response");
+        },
+        () => reply("guided response"),
+      );
+      running = f.runtime.executeTurn("Initial request");
+      await entered.promise;
+      const intent = {
+        sourceCommandId: "guide",
+        queueItemId: "guide-item",
+        clientId: "fixture",
+        kind: "sendText",
+        admissionSeq: 1,
+        admittedAt: Date.now(),
+        requestedDelivery: "guide",
+        admittedDelivery: "guide",
+        modelSelection: selection("model-b"),
+        subscriptionAccountId: "account-b",
+      } as const;
+      const accepted = await f.runtime.admitPrompt("Guide input", undefined, {
+        intent,
+        queueDelivery: "guide",
+      });
+      assert.equal(accepted.kind, "queued");
+      intent.modelSelection.modelId = "model-c";
+      release.resolve();
+      await running;
+      assert.deepEqual(
+        f.requests.map((request) => request.selection.modelId),
+        ["model-a", "model-b"],
+      );
+      assert.deepEqual(f.accounts, ["account-a", "account-b"]);
+    } finally {
+      release.resolve();
+      await running?.catch(() => {});
+      await f.close();
+    }
+  },
+);
+
+test(
+  "queued attachment values cannot be replaced by subsequent draft editing",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture("pi", true);
+    const entered = Promise.withResolvers<void>(),
+      release = Promise.withResolvers<void>();
+    const running: Array<ReturnType<typeof f.runtime.executeTurn>> = [];
+    try {
+      f.steps.push(
+        async () => {
+          entered.resolve();
+          await release.promise;
+          return reply("first done");
+        },
+        (request) => {
+          const text = JSON.stringify(request.messages);
+          assert.ok(text.includes("ORIGINAL_ATTACHMENT"));
+          assert.ok(!text.includes("REPLACED_ATTACHMENT"));
+          return reply("attachment done");
+        },
+      );
+      running.push(f.runtime.executeTurn("First request"));
+      await entered.promise;
+      const attachments = [
+        { type: "file" as const, content: "ORIGINAL_ATTACHMENT", filename: "original.txt" },
+      ];
+      running.push(f.runtime.executeTurn("Queued attachment", attachments));
