diff --git a/packages/services/test/usage-project-membership.test.ts b/packages/services/test/usage-project-membership.test.ts
new file mode 100644
index 0000000..5c63e61
--- /dev/null
+++ b/packages/services/test/usage-project-membership.test.ts
@@ -0,0 +1,38 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { TaskIndexRepo } from "../src/session/taskIndexRepo.js";
+import { createUsageStatsService } from "../src/usage-stats/usageStatsService.js";
+import { buildUsageCostReport, type UsageAccountingRow } from "@zcode/shared";
+
+test("project cost membership comes from the full existing index, independent of recent-ten navigation", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-usage-projects-"));
+  const repo = new TaskIndexRepo(join(directory, "tasks.sqlite"));
+  const paths = Array.from({ length: 13 }, (_, index) => `/registered/project-${index}`);
+  const base = { traceId: "local", title: "fixture", mode: "build" as const, provider: "glm" as const, createdAt: 1, updatedAt: 1 };
+  try {
+    for (const [index, workspacePath] of paths.entries())
+      await repo.syncTaskMeta({ meta: { ...base, taskId: `local-${index}`, workspacePath } });
+    await repo.syncTaskMeta({ meta: { ...base, taskId: "folderless", workspacePath: "/backing/default" } });
+    await repo.syncTaskMeta({ meta: { ...base, taskId: "explicit-conversation", workspacePath: "/backing/another", workspacePurpose: "conversation" } });
+    await repo.syncTaskMeta({ meta: { ...base, taskId: "remote", workspacePath: paths[0]!, workspaceIdentity: "ssh:another-host" } });
+    const projectPaths = await repo.listLocalProjectPaths("/backing/default");
+    assert.equal(projectPaths.length, 13);
+    assert.deepEqual(new Set(projectPaths), new Set(paths));
+    const usage = (workspacePath: string) => ({ providerId: "p", accountId: null, workspacePath, modelId: "m",
+      requestCount: 1, reportedCount: 1, pricedCount: 1, inputTokens: 1, outputTokens: 0, estimatedUsd: 1 }) as UsageAccountingRow;
+    const rows = [usage(paths[0]!), usage("/backing/default"), usage("/unregistered/path")];
+    const service = createUsageStatsService({ apiClient: {} as never, accountRequestAuthService: {} as never,
+      zcodeAgentService: { getAppUsageStats: async () => ({ accounting: rows }) as never },
+      readLocalProjectPaths: () => repo.listLocalProjectPaths("/backing/default"),
+    });
+    const snapshot = await service.getAppUsageSnapshot({ range: "all" });
+    const report = buildUsageCostReport(snapshot.accounting!, { projectPaths: snapshot.projectPaths });
+    assert.equal(report.projects.find((project) => project.workspacePath === paths[0])?.apiUsd, 1);
+    assert.equal(report.projects.find((project) => project.workspacePath === null)?.apiUsd, 2);
+    repo.close();
+    assert.deepEqual(await repo.listLocalProjectPaths("/backing/default"), projectPaths);
+  } finally { repo.close(); await rm(directory, { recursive: true, force: true }); }
+});
