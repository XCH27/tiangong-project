+/** 与连接池原有 key 相同的规范化：可选字段缺席和显式 undefined 表示同一配置。 */
+export function mcpConfigIdentity(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value) ?? "null";
+  if (Array.isArray(value)) return `[${value.map(mcpConfigIdentity).join(",")}]`;
+  const record = value as Record<string, unknown>;
+  return `{${Object.keys(record)
+    .toSorted()
+    .filter((key) => record[key] !== undefined)
+    .map((key) => `${JSON.stringify(key)}:${mcpConfigIdentity(record[key])}`)
+    .join(",")}}`;
+}
