+test(
+  "same-name MCP ownership conflicts refuse views, including a previously connected owner",
+  { timeout: 60000 },
+  async () => {
+    const root = await mkdtemp(join(os.tmpdir(), "fleet-plugin-view-owners-"));
+    const previousHome = process.env.ZCODE_HOME;
+    const pool = createMcpAdapterConnectionPool({ idleGraceMs: 0 });
+    const mcpPort = pool.acquireLease({ leaseId: "protocol-settings" });
+    try {
+      process.env.ZCODE_HOME = join(root, "profile");
+      const workspace = join(root, "workspace");
+      const userConfigPath = join(root, "profile", "cli", "config.json");
+      const pluginStorageRoot = join(root, "storage", "cli", "plugins");
+      await mkdir(join(root, "profile", "cli"), { recursive: true });
+      await mkdir(workspace);
+      await writeFile(userConfigPath, JSON.stringify({ storage: { dir: join(root, "storage") } }));
+      const paths = {
+        env: {},
+        officialPluginRoots: [],
+        workingDirectory: workspace,
+        userConfigPath,
+        pluginStorageRoot,
+      };
+      const server = resolve(import.meta.dirname, "fixtures/plugin-view/server.mjs");
+      for (const marketName of ["market-a", "market-b"]) {
+        const market = join(root, marketName);
+        const plugin = join(market, "counter");
+        await mkdir(join(market, ".claude-plugin"), { recursive: true });
+        await mkdir(join(plugin, ".claude-plugin"), { recursive: true });
+        await writeFile(
+          join(market, ".claude-plugin", "marketplace.json"),
+          JSON.stringify({ name: marketName, plugins: [{ name: "counter", source: "./counter" }] }),
+        );
+        await writeFile(
+          join(plugin, ".claude-plugin", "plugin.json"),
+          JSON.stringify({
+            name: "counter",
+            version: "1.0.0",
+            mcpServers: {
+              shared: { command: process.execPath, args: [server] },
+              [marketName]: { command: process.execPath, args: [server] },
+            },
+            fleet: {
+              views: [
+                { id: "shared", title: "Shared", server: "shared", resource: "ui://counter/main" },
+                {
+                  id: "unique",
+                  title: "Unique",
+                  server: marketName,
+                  resource: "ui://counter/main",
+                },
+              ],
+            },
+          }),
+        );
+        await addMarketplace({
+          source: { source: "directory", path: market },
+          storageRoot: pluginStorageRoot,
+        });
+        await installZCodeMarketplacePlugin({
+          ...paths,
+          marketplace: marketName,
+          pluginName: "counter",
+        });
+        const info = resolveZCodePlugins(paths).plugins.find(
+          (item) => item.id === `counter@${marketName}`,
+        )!;
+        grantZCodePlugin({ ...paths, plugin: info.id, fingerprint: info.grant!.fingerprint });
+      }
+      const context = { deps: { env: process.env, mcpPort }, logger: undefined } as never;
+      const target = (pluginId: string, viewId = "shared") => ({
+        workspace: { workspacePath: workspace, workspaceKey: workspace },
+        pluginId,
+        viewId,
+      });
+      const call = (pluginId: string, viewId = "shared") =>
+        callPluginViewTool(context, { ...target(pluginId, viewId), tool: "increment" });
+      const a = "counter@market-a",
+        b = "counter@market-b";
+      const count = async (id: string) => {
+        const plugin = resolveZCodePlugins(paths).plugins.find((item) => item.id === id)!;
+        return JSON.parse(await readFile(join(plugin.dataPath, "counter.json"), "utf8")).value;
+      };
+      await setZCodePluginEnabled({ ...paths, plugin: b, enabled: false });
+      assert.deepEqual((await call(a)).structuredContent, { value: 1 });
+      await setZCodePluginEnabled({ ...paths, plugin: b, enabled: true });
+      const conflicting = resolveZCodePlugins(paths);
+      assert.equal(conflicting.mcpServers["plugin:counter:shared"], undefined);
+      for (const id of [a, b]) {
