+        { ...target(a), tool: "increment" },
+      );
+      await dispatchedA.promise;
+      await setZCodePluginEnabled({ ...paths, plugin: a, enabled: false });
+      await setZCodePluginEnabled({ ...paths, plugin: b, enabled: true });
+      assert.deepEqual((await call(b)).structuredContent, { value: 4 });
+      releaseResult.resolve();
+      assert.deepEqual((await accepted).structuredContent, { value: 4 });
+      assert.equal(await count(a), 4);
+      assert.equal(await count(b), 4);
+    } finally {
