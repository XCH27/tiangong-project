diff --git a/apps/zcode-cli/packages/adapters/src/plugins/agent-plugins-export-config.ts b/apps/zcode-cli/packages/adapters/src/plugins/agent-plugins-export-config.ts
new file mode 100644
index 0000000..aecd36f
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/plugins/agent-plugins-export-config.ts
@@ -0,0 +1,154 @@
+import { lstatSync, readFileSync } from "node:fs";
+import { isAbsolute, join, relative, sep } from "node:path";
+import type { PluginDiagnostic } from "@zcode/contracts";
+import { isNotFoundError, isRecord, resolveInside } from "./helpers.js";
+import { loadPluginMcpServerDefinitions } from "./mcp.js";
+import type { LoadedPlugin } from "./types.js";
+
+export interface ExportOmission {
+  path: string;
+  reason: string;
+}
+
+const ENVIRONMENT_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
+const PLACEHOLDER = /^(?:\$\{(?:[A-Za-z_][A-Za-z0-9_]*|user_config\.[A-Za-z_][A-Za-z0-9_.-]*)\})+$/;
+const CREDENTIAL_FIELDS = ["headers", "auth", "oauth"] as const;
+
+/** 先检查包内每一层，不能让被声明的配置 symlink 在脱敏前读取包外内容。 */
+export function assertUnlinkedPackagePath(root: string, path: string): void {
+  const rel = relative(root, path);
+  if (isAbsolute(rel) || rel === ".." || rel.startsWith(`..${sep}`))
+    throw new Error("Export configuration path escapes the plugin package");
+  let current = root;
+  for (const segment of rel.split(sep).filter(Boolean)) {
+    current = join(current, segment);
+    if (lstatSync(current).isSymbolicLink())
+      throw new Error(`Cannot export a symbolic link as plugin configuration: ${rel}`);
+  }
+}
+
+export function planExportConfiguration(loaded: LoadedPlugin, skipped: ExportOmission[]) {
+  const diagnostics: PluginDiagnostic[] = [];
+  const sourceFiles = new Map<string, unknown>();
+  const declaredFiles = new Set<string>();
+  const collectDeclaredFiles = (spec: unknown): void => {
+    if (Array.isArray(spec)) {
+      spec.forEach(collectDeclaredFiles);
+      return;
+    }
+    if (typeof spec !== "string") return;
+    const path = resolveInside(loaded.rootPath, spec);
+    if (path) declaredFiles.add(path);
+  };
+  collectDeclaredFiles(loaded.manifest.mcpServers);
+  const definitions = loadPluginMcpServerDefinitions({
+    loaded,
+    diagnostics,
+    sourceFiles,
+    readFile: (path) => {
+      try {
+        assertUnlinkedPackagePath(loaded.rootPath, path);
+        return readFileSync(path, "utf8");
+      } catch (error) {
+        if (isNotFoundError(error) && declaredFiles.has(path))
+          throw new Error(
+            `Declared MCP configuration is missing: ${relative(loaded.rootPath, path)}`,
+          );
+        throw error;
+      }
+    },
+  });
+  if (diagnostics.some((item) => item.severity === "error"))
+    throw new Error(
+      `Cannot export MCP configuration: ${diagnostics.map((item) => item.message).join("; ")}`,
+    );
+  const servers = sanitizeServers(definitions, "mcp.json#/mcpServers", skipped);
+  const files = new Map<string, unknown>();
+  for (const [path, raw] of sourceFiles) {
+    if (!isRecord(raw)) continue;
+    const label = relative(loaded.rootPath, path);
+    files.set(
+      path,
+      isRecord(raw.mcpServers)
+        ? { ...raw, mcpServers: sanitizeServers(raw.mcpServers, `${label}#/mcpServers`, skipped) }
+        : sanitizeServers(raw, `${label}#`, skipped),
+    );
+  }
+  const userConfig = isRecord(loaded.manifest.userConfig)
+    ? Object.fromEntries(
+        Object.entries(loaded.manifest.userConfig).map(([key, option]) => {
+          if (!isRecord(option) || option.sensitive !== true || !("default" in option))
+            return [key, option];
+          const { default: _removed, ...rest } = option;
+          skipped.push({
+            path: `plugin.json#/extensions/fleet.workbench/userConfig/${key}/default`,
+            reason: "Sensitive default omitted; supply it after installing.",
+          });
+          return [key, rest];
+        }),
+      )
+    : undefined;
+  return { servers, files, userConfig };
+}
+
+function sanitizeServers(raw: Record<string, unknown>, path: string, skipped: ExportOmission[]) {
+  return Object.fromEntries(
+    Object.entries(raw).map(([key, value]) => {
+      if (!isRecord(value)) return [key, value];
+      const server = { ...value };
+      for (const field of CREDENTIAL_FIELDS) {
+        if (!(field in server)) continue;
+        delete server[field];
+        skipped.push({
+          path: `${path}/${key}/${field}`,
+          reason: "Credential configuration omitted; supply it after installing.",
+        });
+      }
+      if (isRecord(server.env)) {
+        // env 没有可靠的敏感字段类型，不能仅凭 API_KEY 等名字猜测。保留变量表达式，
+        // 字面值变成同名占位符，连普通运行常量也明确要求接收者重新配置。
+        server.env = Object.fromEntries(
+          Object.entries(server.env).flatMap(([name, value]) => {
+            if (typeof value === "string" && PLACEHOLDER.test(value)) return [[name, value]];
+            skipped.push({
+              path: `${path}/${key}/env/${name}`,
+              reason: "Literal environment value omitted; supply this variable after installing.",
+            });
+            return ENVIRONMENT_NAME.test(name) ? [[name, `\${${name}}`]] : [];
+          }),
+        );
+      }
+      return [key, server];
+    }),
+  );
+}
+
+/** Templates remain useful instructions, while actual .env profiles never travel. */
+export function sanitizeEnvTemplate(
+  contents: string,
+  path: string,
+  skipped: ExportOmission[],
+): string | undefined {
+  const result: string[] = [];
+  const omissions: ExportOmission[] = [];
+  for (const line of contents.split(/\r?\n/)) {
+    if (!line.trim() || line.trimStart().startsWith("#")) {
+      result.push(line);
+      continue;
+    }
+    const match = /^(\s*(?:export\s+)?)([A-Za-z_][A-Za-z0-9_]*)(\s*=\s*)(.*)$/.exec(line);
+    if (!match) return undefined;
+    const value = match[4]!.trim();
+    const unquoted = /^(['"])(.*)\1$/.exec(value)?.[2] ?? value;
+    if (PLACEHOLDER.test(unquoted)) result.push(line);
+    else {
+      result.push(`${match[1]}${match[2]}${match[3]}\${${match[2]}}`);
+      omissions.push({
+        path: `${path}#${match[2]}`,
+        reason: "Template value replaced by a variable placeholder; supply it after installing.",
+      });
+    }
+  }
+  skipped.push(...omissions);
+  return result.join("\n");
+}
