+      const stale = callPluginViewTool(delayedContext, { ...target(a), tool: "increment" });
+      const rejected = assert.rejects(stale, /configuration changed/i);
+      await connectedA.promise;
+      await setZCodePluginEnabled({ ...paths, plugin: a, enabled: false });
+      await setZCodePluginEnabled({ ...paths, plugin: b, enabled: true });
+      assert.deepEqual((await call(b)).structuredContent, { value: 3 });
+      releaseConnection.resolve();
+      await rejected;
+      assert.equal(await count(a), 3);
+      assert.equal(await count(b), 3, "the old A request must not increment B");
+
+      // Once dispatched, returning the original result must not cancel/replay a completed effect.
+      const dispatchedA = Promise.withResolvers<void>();
+      const releaseResult = Promise.withResolvers<void>();
+      const acceptedPort = {
+        ...mcpPort,
+        async callTool(...args: Parameters<typeof mcpPort.callTool>) {
+          const result = await mcpPort.callTool(...args);
+          dispatchedA.resolve();
+          await releaseResult.promise;
+          return result;
+        },
+      };
+      await setZCodePluginEnabled({ ...paths, plugin: b, enabled: false });
+      await setZCodePluginEnabled({ ...paths, plugin: a, enabled: true });
+      const accepted = callPluginViewTool(
