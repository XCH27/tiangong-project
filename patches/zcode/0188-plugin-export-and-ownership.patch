diff --git a/apps/zcode-cli/packages/adapters/src/plugins/mcp-ownership.ts b/apps/zcode-cli/packages/adapters/src/plugins/mcp-ownership.ts
new file mode 100644
index 0000000..2906392
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/plugins/mcp-ownership.ts
@@ -0,0 +1,35 @@
+import type { PluginDiagnostic, PluginLoadOutcome, PluginMetadata } from "@zcode/contracts";
+
+/** 保留旧工具名称和权限规则，但绝不让不同完整插件 id 静默覆盖同一个 MCP 名称。 */
+export function withholdConflictingPluginMcpServers(
+  plugins: PluginMetadata[],
+  servers: PluginLoadOutcome["mcpServers"],
+  diagnostics: PluginDiagnostic[],
+): void {
+  const owners = new Map<string, PluginMetadata[]>();
+  for (const plugin of plugins) {
+    for (const server of plugin.mcpServerNames) {
+      const entries = owners.get(server) ?? [];
+      entries.push(plugin);
+      owners.set(server, entries);
+    }
+  }
+  for (const [server, claimants] of owners) {
+    if (claimants.length < 2) continue;
+    delete servers[server];
+    const ids = claimants
+      .map((plugin) => plugin.id)
+      .sort()
+      .join(", ");
+    for (const plugin of claimants) {
+      plugin.mcpServerNames = plugin.mcpServerNames.filter((name) => name !== server);
+      diagnostics.push({
+        code: "plugin_mcp_server_disabled",
+        severity: "error",
+        pluginId: plugin.id,
+        path: plugin.rootPath,
+        message: `MCP server name conflict: ${server} belongs to multiple plugins (${ids}). Disable one conflicting plugin or use distinct server names.`,
+      });
+    }
+  }
+}
