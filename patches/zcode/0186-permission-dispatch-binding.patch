diff --git a/apps/zcode-cli/packages/core/test/permission-revocation.test.ts b/apps/zcode-cli/packages/core/test/permission-revocation.test.ts
index 75ad94e..51263c0 100644
--- a/apps/zcode-cli/packages/core/test/permission-revocation.test.ts
+++ b/apps/zcode-cli/packages/core/test/permission-revocation.test.ts
@@ -2,6 +2,112 @@ import assert from "node:assert/strict";
 import test from "node:test";
 import { fixture, reply, call } from "./helpers/pi-runtime-fixture.js";
 
+test("a permission approval cannot authorize a later mutation of its input", async () => {
+  const approved = { value: "approved input" };
+  const f = await fixture(undefined, false, {
+    deps: {
+      eventSink: {
+        async onSessionEvent(event) {
+          if (event.type === "tool_call_started") approved.value = "unapproved replacement";
+        },
+      },
+    },
+  });
+  try {
+    f.permissionWith(async () => ({ decision: "modify", modifiedInput: approved }));
+    f.steps.push(
+      () => reply("Request", [call("input", "original")]),
+      () => reply("Done"),
+    );
+    await f.runtime.executeTurn("Request approval for a specific input");
+    assert.equal(f.permissionCalls, 1);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+for (const trustedGate of ["hook", "tool"] as const) {
+  test(`unchanged call-specific ${trustedGate} approval retains its original path`, async () => {
+    const f = await fixture(
+      undefined,
+      false,
+      trustedGate === "hook"
+        ? {
+            deps: {
+              hookRunner: {
+                run: async () => ({ additionalContexts: [], permissionBehavior: "allow" }),
+              },
+            },
+          }
+        : {},
+    );
+    try {
+      if (trustedGate === "tool")
+        f.runtime.getToolRegistry().get("Probe")!.prepareApproval = () => ({ gate: "proceed" });
+      f.steps.push(
+        () => reply("Request", [call("trusted", "approved")]),
+        () => reply("Done"),
+      );
+      await f.runtime.executeTurn("Use the existing call-specific approval");
+      assert.equal(f.effects, 1);
+      assert.equal(f.permissionCalls, 0);
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+for (const tightenedPolicy of ["ask", "deny"] as const) {
+  test(`a new Project ${tightenedPolicy} cannot reuse an automatic Allow`, async () => {
+    let tighten = true;
+    const f = await fixture(undefined, false, {
+      deps: {
+        eventSink: {
+          async onSessionEvent(event) {
+            if (!tighten || event.type !== "tool_call_started") return;
+            tighten = false;
+            const session = await f.store.getSession("session" as never);
+            assert.ok(session);
+            await f.store.saveProjectPermission({
+              projectID: session.projectID,
+              permission: { version: 1, [tightenedPolicy]: [{ toolName: "Probe" }] },
+            });
+          },
+        },
+      },
+    });
+    try {
+      f.steps.push(
+        async () => {
+          const session = await f.store.getSession("session" as never);
+          assert.ok(session);
+          await f.store.saveProjectPermission({
+            projectID: session.projectID,
+            permission: { version: 1, allow: [{ toolName: "Probe" }] },
+          });
+          return reply("Use the automatic permission", [call("automatic", "must not run")]);
+        },
+        () => reply("The rule changed"),
+      );
+      await f.runtime.executeTurn("Execute while the Project policy changes");
+      assert.equal(f.effects, 0, "a tightened rule must stop the previously allowed effect");
+      assert.equal(f.permissionCalls, 0, "the first attempt only had an automatic allowance");
+      if (tightenedPolicy === "deny") return;
+      f.steps.push(
+        () => reply("Request again", [call("fresh", "approved")]),
+        () => reply("Done"),
+      );
+      await f.runtime.executeTurn("Request the same operation under the current Ask rule");
+      assert.equal(f.effects, 1);
+      assert.equal(f.permissionCalls, 1, "this call's explicit approval is not asked twice");
+      assert.equal(await f.read(), "approved");
+    } finally {
+      await f.close();
+    }
+  });
+}
