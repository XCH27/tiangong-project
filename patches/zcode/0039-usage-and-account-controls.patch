diff --git a/apps/zcode-cli/packages/adapters/src/storage/session-store/repositories/usage-model-activity.ts b/apps/zcode-cli/packages/adapters/src/storage/session-store/repositories/usage-model-activity.ts
new file mode 100644
index 0000000..4d9fbb4
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/storage/session-store/repositories/usage-model-activity.ts
@@ -0,0 +1,72 @@
+import type { DatabaseSync } from "node:sqlite";
+import type { AppUsageModelActivityRow } from "@zcode/contracts";
+
+const uniqueTurnModels = `with relevant_turns as (
+    select distinct session_id, turn_id from tool_usage
+    where started_at >= ? and started_at <= ? and turn_id is not null
+  ), unique_turn_models as (
+    select usage.session_id, usage.turn_id, min(usage.model_id) as modelId
+    from model_usage usage join relevant_turns turn
+      on usage.session_id = turn.session_id and usage.turn_id = turn.turn_id
+    where usage.query_source in ('main_turn','subagent','workflow_child')
+    group by usage.session_id, usage.turn_id having count(distinct usage.model_id) = 1
+)`;
+
+/** Attribute tools only when one model served that turn; mixed-model turns stay in global totals. */
+export function queryModelActivity(db: DatabaseSync, since: number, until: number): AppUsageModelActivityRow[] {
+  const sessions = db.prepare(`select model_id as modelId, count(distinct session_id) as sessionCount
+    from model_usage where started_at >= ? and started_at <= ? and query_source = 'main_turn'
+    group by model_id`).all(since, until) as unknown as { modelId: string; sessionCount: number }[];
+  const tools = db.prepare(`${uniqueTurnModels} select m.modelId, t.tool_name as toolName,
+      count(*) as callCount,
+      sum(case when t.status = 'error' then 1 else 0 end) as errorCount,
+      avg(t.duration_ms) as avgDurationMs
+    from tool_usage t join unique_turn_models m
+      on t.session_id = m.session_id and t.turn_id = m.turn_id
+    where t.started_at >= ? and t.started_at <= ?
+    group by m.modelId, t.tool_name
+    order by m.modelId, callCount desc, t.tool_name`).all(since, until, since, until) as unknown as {
+    modelId: string; toolName: string; callCount: number; errorCount: number; avgDurationMs: number | null;
+  }[];
+  const skills = db.prepare(`${uniqueTurnModels} select m.modelId,
+      json_extract(t.skill_metadata_json,'$.qualifiedName') as skillId,
+      json_extract(t.skill_metadata_json,'$.pluginId') as pluginId,
+      json_extract(t.skill_metadata_json,'$.source') as source,
+      count(*) as callCount,
+      sum(case when t.status = 'error' then 1 else 0 end) as errorCount,
+      avg(t.duration_ms) as avgDurationMs
+    from tool_usage t join unique_turn_models m
+      on t.session_id = m.session_id and t.turn_id = m.turn_id
+    where t.started_at >= ? and t.started_at <= ? and t.tool_name = 'Skill'
+      and json_type(t.skill_metadata_json,'$.qualifiedName') = 'text'
+      and length(trim(json_extract(t.skill_metadata_json,'$.qualifiedName'))) > 0
+    group by m.modelId, skillId, pluginId, source
+    order by m.modelId, callCount desc, skillId`).all(since, until, since, until) as unknown as {
+    modelId: string; skillId: string; pluginId: string | null; source: string | null;
+    callCount: number; errorCount: number; avgDurationMs: number | null;
+  }[];
+  const byModel = new Map<string, AppUsageModelActivityRow>();
+  const itemFor = (modelId: string) => {
+    let item = byModel.get(modelId);
+    if (!item) {
+      item = { modelId, sessionCount: 0, toolCallCount: 0, toolErrorCount: 0,
+        tools: [], skills: [], unidentifiedSkillCalls: 0 };
+      byModel.set(modelId, item);
+    }
+    return item;
+  };
+  for (const row of sessions) itemFor(row.modelId).sessionCount = row.sessionCount;
+  for (const row of tools) {
+    const item = itemFor(row.modelId);
+    item.toolCallCount += row.callCount;
+    item.toolErrorCount += row.errorCount;
+    item.tools.push({ toolName: row.toolName, callCount: row.callCount,
+      errorCount: row.errorCount, avgDurationMs: row.avgDurationMs });
+  }
+  for (const { modelId, ...skill } of skills) itemFor(modelId).skills.push(skill);
+  for (const item of byModel.values()) {
+    const skillCalls = item.tools.find((tool) => tool.toolName === "Skill")?.callCount ?? 0;
+    item.unidentifiedSkillCalls = skillCalls - item.skills.reduce((sum, skill) => sum + skill.callCount, 0);
+  }
+  return [...byModel.values()].sort((a, b) => a.modelId.localeCompare(b.modelId));
+}
