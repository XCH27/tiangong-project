diff --git a/packages/ui/src/settings/usage-stats/usageCostSourceViewModel.ts b/packages/ui/src/settings/usage-stats/usageCostSourceViewModel.ts
new file mode 100644
index 0000000..ff94e0d
--- /dev/null
+++ b/packages/ui/src/settings/usage-stats/usageCostSourceViewModel.ts
@@ -0,0 +1,55 @@
+import type { UsageAccountingRow } from "@zcode/shared";
+
+export type UsageCostSource = "conversation" | "tool" | "delegate" | "other";
+export interface UsageCostSourceRow {
+  key: string;
+  label: string;
+  fullLabel: string;
+  conversation: number;
+  tool: number;
+  delegate: number;
+  other: number;
+  total: number | null;
+  pricedCount: number;
+  requestCount: number;
+}
+
+export function usageCostSource(querySource: string | undefined): UsageCostSource {
+  if (querySource === "main_turn") return "conversation";
+  if (["web_search_tool", "web_fetch_processing", "read_session_context"].includes(querySource ?? ""))
+    return "tool";
+  if (querySource === "subagent" || querySource === "workflow_child") return "delegate";
+  return "other";
+}
+
+/** Public API-value composition follows the recorded request source, never tool-call counts. */
+export function buildUsageCostSourceRows(
+  rows: readonly UsageAccountingRow[],
+  group: "models" | "projects",
+  projectPaths: readonly string[] = [],
+): UsageCostSourceRow[] {
+  const projects = new Set(projectPaths);
+  const byKey = new Map<string, UsageCostSourceRow>();
+  for (const row of rows) {
+    if (row.requestCount <= 0) continue;
+    const path = row.workspacePath && projects.has(row.workspacePath) ? row.workspacePath : null;
+    const key = group === "models" ? row.modelId : path ?? "other";
+    let item = byKey.get(key);
+    if (!item) {
+      item = {
+        key, label: group === "models" ? row.modelId : path?.split(/[/\\]/).filter(Boolean).at(-1) ?? "other",
+        fullLabel: group === "models" ? row.modelId : path ?? "other",
+        conversation: 0, tool: 0, delegate: 0, other: 0,
+        total: null, pricedCount: 0, requestCount: 0,
+      };
+      byKey.set(key, item);
+    }
+    item.requestCount += row.requestCount;
+    item.pricedCount += row.pricedCount;
+    if (row.pricedCount > 0) {
+      item.total = (item.total ?? 0) + row.estimatedUsd;
+      item[usageCostSource(row.querySource)] += row.estimatedUsd;
+    }
+  }
+  return [...byKey.values()].sort((a, b) => (b.total ?? -1) - (a.total ?? -1) || a.key.localeCompare(b.key));
+}
