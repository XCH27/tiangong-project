+  const f = await fixture();
+  const at = Date.UTC(2026, 7, 1);
+  try {
+    await f.record("main-a", "a", "standard", { modelId: "model-a", turnID: "turn-a" as TurnId });
+    await f.record("main-b", "a", "standard", { modelId: "model-b", turnID: "turn-b" as TurnId });
+    await f.record("mixed-a", "a", "standard", { modelId: "model-a", turnID: "turn-mixed" as TurnId });
+    await f.record("mixed-b", "a", "standard", { modelId: "model-b", turnID: "turn-mixed" as TurnId });
+    await f.record("tool-model", "a", "standard", { modelId: "model-a", querySource: "web_search_tool" });
+    const tool = (id: string, turnID: string, toolName: string) => ({
+      id, sessionID: "session" as SessionId, turnID: turnID as TurnId,
+      toolCallID: id, toolName, status: "completed" as const, startedAt: at, durationMs: 10,
+    });
+    await f.store.upsertToolUsage(tool("bash-a", "turn-a", "Bash"));
+    await f.store.upsertToolUsage({ ...tool("skill-a", "turn-a", "Skill"), skillMetadata: { qualifiedName: "design:review", pluginId: "design@registry", source: "plugin" } });
+    await f.store.upsertToolUsage(tool("read-b", "turn-b", "Read"));
+    await f.store.upsertToolUsage(tool("mixed", "turn-mixed", "Bash"));
