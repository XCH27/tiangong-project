@@ -0,0 +1,77 @@
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import { Progress } from "@/components/ui/progress.js";
+import type { UsageCostSource, UsageCostSourceRow } from "./usageCostSourceViewModel.js";
+import { USAGE_PROGRESS_TONES } from "@/lib/usageProgressTones.js";
+
+const SOURCES: UsageCostSource[] = ["conversation", "tool", "delegate", "other"];
+const COLORS = USAGE_PROGRESS_TONES;
+
+/** Original segmented Progress treatment, applied to recorded request-source API estimates. */
+export function UsageCostSourceBars({
+  rows, focused, onFocus, money, label, otherLabel,
+  sourceLabels,
+}: {
+  rows: readonly UsageCostSourceRow[];
+  focused?: string;
+  onFocus: (key?: string) => void;
+  money: (value: number | null) => string;
+  label: string;
+  otherLabel?: string;
+  sourceLabels: Record<UsageCostSource, string>;
+}) {
+  const max = Math.max(0, ...rows.map((row) => row.total ?? 0));
+  const present = SOURCES.filter((source) => rows.some((row) => row[source] > 0));
+  return (
+    <div className="space-y-3">
+      {present.length ? (
+        <div className="flex flex-wrap gap-x-4 gap-y-1 text-ui-sm text-foreground-subtle">
+          {present.map((source) => (
+            <span key={source} className="inline-flex items-center gap-1.5">
+              <span className="size-2 rounded-sm" style={{ backgroundColor: COLORS[SOURCES.indexOf(source)] }} />
+              {sourceLabels[source]}
+            </span>
+          ))}
+        </div>
+      ) : null}
+      <div className="max-h-80 space-y-1 overflow-y-auto" role="list" aria-label={label}>
+        {rows.map((row) => {
+          const total = row.total;
+          const detail = total === null
+            ? `${row.fullLabel} · ${money(null)}`
+            : [row.fullLabel, money(total), ...SOURCES.filter((source) => row[source] > 0)
+              .map((source) => `${sourceLabels[source]} ${Math.round(row[source] / total * 100)}%`)].join(" · ");
+          return (
+            <ControlHintTooltip key={row.key} title={detail}>
+              <div
+                role="listitem"
+                tabIndex={0}
+                onMouseEnter={() => onFocus(row.key)}
+                onMouseLeave={() => onFocus(undefined)}
+                onFocus={() => onFocus(row.key)}
+                onBlur={() => onFocus(undefined)}
+                className={`flex min-w-0 items-center gap-3 rounded-md px-2 py-1.5 text-ui-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/30 ${focused === row.key ? "bg-hover" : ""}`}
+                aria-label={detail}
+              >
+                <span className="w-28 shrink-0 truncate font-mono text-foreground sm:w-36" title={row.fullLabel}>
+                  {otherLabel && row.key === "other" ? otherLabel : row.label}
+                </span>
+                <Progress
+                  className="h-2 min-w-0 flex-1"
+                  value={max > 0 && total !== null ? total / max * 100 : 0}
+                  aria-label={row.fullLabel}
+                  segments={total && total > 0 ? SOURCES.map((source, index) => ({
+                    id: source, percent: row[source] / total,
+                    style: { backgroundColor: COLORS[index] },
+                  })) : undefined}
+                />
+                <span className="w-20 shrink-0 text-right font-mono tabular-nums text-foreground-subtle">
+                  {row.pricedCount < row.requestCount && total !== null ? "≥ " : ""}{money(total)}
+                </span>
+              </div>
+            </ControlHintTooltip>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
