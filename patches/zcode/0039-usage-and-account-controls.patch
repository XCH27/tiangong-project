@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { UsageAccountingRow } from "@zcode/shared";
+import { buildUsageCostSourceRows, usageCostSource } from "../src/settings/usage-stats/usageCostSourceViewModel.js";
+
+const usage = (querySource: string, modelId: string, estimatedUsd: number, workspacePath = "/project") => ({
+  providerId: "provider", accountId: "account", workspacePath, modelId, querySource,
+  requestCount: 1, pricedCount: 1, reportedCount: 1, estimatedUsd,
+}) as UsageAccountingRow;
+
+test("cost composition uses recorded model request sources rather than tool-call counts", () => {
+  const rows = [
+    usage("main_turn", "m", 6), usage("web_search_tool", "m", 2),
+    usage("subagent", "m", 1), usage("compact", "m", 1),
+    { ...usage("main_turn", "m", 0), pricedCount: 0 },
+  ];
+  const model = buildUsageCostSourceRows(rows, "models")[0]!;
+  assert.equal(model.total, 10);
+  assert.deepEqual([model.conversation, model.tool, model.delegate, model.other], [6, 2, 1, 1]);
+  assert.deepEqual([model.pricedCount, model.requestCount], [4, 5]);
+  assert.equal(usageCostSource("web_fetch_processing"), "tool");
+  assert.equal(usageCostSource("unrecognized"), "other");
+});
+
+test("project composition groups unregistered and projectless usage under Other without inventing cost", () => {
+  const rows = [usage("main_turn", "m", 2), usage("main_turn", "m", 3, "/unregistered"),
+    { ...usage("main_turn", "m", 0, "/project"), pricedCount: 0 }];
+  const projects = buildUsageCostSourceRows(rows, "projects", ["/project"]);
+  assert.equal(projects.find((row) => row.key === "/project")?.total, 2);
+  assert.equal(projects.find((row) => row.key === "other")?.total, 3);
+  assert.equal(projects.find((row) => row.key === "/project")?.requestCount, 2);
+});
+
+test("model and project bars include only recorded requests", () => {
+  const rows = [usage("main_turn", "used", 1), {
+    ...usage("main_turn", "never-used", 0, "/unused-project"), requestCount: 0,
+  }];
+  assert.deepEqual(buildUsageCostSourceRows(rows, "models").map((row) => row.key), ["used"]);
+  assert.deepEqual(buildUsageCostSourceRows(rows, "projects", ["/project", "/unused-project"])
+    .map((row) => row.key), ["/project"]);
+});
