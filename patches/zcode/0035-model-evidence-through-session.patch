diff --git a/packages/ui/test/modelEvidenceSelection.test.ts b/packages/ui/test/modelEvidenceSelection.test.ts
new file mode 100644
index 0000000..924ae10
--- /dev/null
+++ b/packages/ui/test/modelEvidenceSelection.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ModelSelectionView } from "@zcode/services";
+import { resolveDraftInitialModelSelection } from "../src/lib/composerRecent.js";
+import { resolveModelThoughtOption } from "../src/lib/modelThoughtOption.js";
+
+const runtimeConfig = {
+  properties: { contextWindow: 200_000 },
+  optionSpecs: { reasoningLevel: { values: ["low", "high"] } },
+};
+
+function view(evidenceConfig: object): ModelSelectionView {
+  return {
+    providers: [{
+      providerId: "synthetic-provider",
+      models: [{ modelId: "unknown-model", config: runtimeConfig, evidenceConfig }],
+    }],
+  } as unknown as ModelSelectionView;
+}
+
+test("unreported reasoning is absent from the control and invalidates a stale explicit effort", () => {
+  const catalog = view({});
+  assert.equal(resolveModelThoughtOption({
+    modelSelectionView: catalog,
+    providerId: "synthetic-provider",
+    modelId: "unknown-model",
+  }), null);
+  assert.deepEqual(resolveDraftInitialModelSelection(catalog, {
+    providerId: "synthetic-provider",
+    modelId: "unknown-model",
+    options: { reasoningLevel: "high" },
+  }), {
+    selection: { providerId: "synthetic-provider", modelId: "unknown-model" },
+    invalidated: true,
+  });
+  assert.equal(resolveDraftInitialModelSelection(catalog, {
+    providerId: "synthetic-provider",
+    modelId: "unknown-model",
+    options: { reasoningLevel: "auto" },
+  }).invalidated, false);
+});
+
+test("reported reasoning is available without borrowing fallback-only levels", () => {
+  const catalog = view({ optionSpecs: { reasoningLevel: { values: ["low"] } } });
+  const option = resolveModelThoughtOption({
+    modelSelectionView: catalog,
+    providerId: "synthetic-provider",
+    modelId: "unknown-model",
+  });
+  assert.deepEqual(option?.options?.map((item) => item.value), ["low"]);
+  assert.equal(resolveDraftInitialModelSelection(catalog, {
+    providerId: "synthetic-provider",
+    modelId: "unknown-model",
+    options: { reasoningLevel: "high" },
+  }).invalidated, true);
+});
