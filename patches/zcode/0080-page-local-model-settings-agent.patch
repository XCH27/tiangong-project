diff --git a/apps/zcode-cli/packages/core/test/page-settings-assistant.test.ts b/apps/zcode-cli/packages/core/test/page-settings-assistant.test.ts
new file mode 100644
index 0000000..79892d5
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/page-settings-assistant.test.ts
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { MODEL_SETTINGS_ASSISTANT_ENTRY, modelSettingsAssistantInstructions, MODEL_SETTINGS_ASSISTANT_TOOLS } from "@zcode/shared";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+const target = { feature: "model-settings" as const, providerId: "selected-provider", modelId: "model-b", openingRevision: 7 };
+const config = { modelSettingsAssistant: target, taskType: "page_assistant" as const,
+  systemPrompt: modelSettingsAssistantInstructions(target), toolAllowlist: [...MODEL_SETTINGS_ASSISTANT_TOOLS] };
+const tool = (name: string, input: unknown) => ({ id: name, name, input });
+
+test("real Pi page Session advertises only its scoped tools, commits permission receipts and survives reopen", async () => {
+  const calls: unknown[] = [];
+  const f = await fixture("pi", true, { config, deps: { modelSettingsPort: { async perform(command) {
+    calls.push(command);
+    return { target, revision: 8, providerName: "Selected", connectionKind: "api", apiFormat: "openai-chat-completions", providerEnabled: true, models: [{ modelId: "model-b", enabled: false,
+      contextWindow: null, reasoningLevels: [], fastSupported: null }] };
+  } } } });
+  try {
+    f.steps.push(() => reply("", [tool("ReadModelSettings", {})]),
+      () => reply("", [tool("SetModelEnabled", { modelId: "model-b", enabled: false, basedOnRevision: 8 })]),
+      () => reply("Model disabled for future selection."));
+    await f.runtime.executeTurn("Disable model-b on this page");
+    for (const request of f.requests) {
+      assert.deepEqual(new Set(request.tools), new Set(MODEL_SETTINGS_ASSISTANT_TOOLS));
+      const system = request.messages.filter((message) => message.role === "system").map((message) => JSON.stringify(message.content)).join("");
+      assert.ok(system.length < 4000, `Page prompt grew to ${system.length} characters`);
+      assert.equal(system.includes("synthetic"), false);
+    }
+    assert.equal(f.permissionCalls, 1);
+    assert.deepEqual(calls, [{ operation: "read" }, { operation: "set-enabled", modelId: "model-b", enabled: false, basedOnRevision: 8 }]);
+    const entry = (await f.store.sessionEntries({ sessionID: "session" as never, type: MODEL_SETTINGS_ASSISTANT_ENTRY }))[0];
+    assert.deepEqual(entry.data, target);
+    const facts = f.toolFacts(); assert.equal(facts.length, 2);
+    await f.reopen();
+    f.steps.push(() => reply("The same page target is retained."));
+    await f.runtime.executeTurn("Which provider is this assistant bound to?");
+    assert.equal(calls.length, 2, "Reopening replayed an already completed settings change");
+  } finally { await f.close(); }
+});
+
+test("denial and invented registered tools cannot cross the page assistant's operation boundary", async () => {
+  let calls = 0;
+  const f = await fixture("pi", true, { config, deps: { modelSettingsPort: { async perform() { calls++; throw new Error("Should never run"); } } } });
+  try {
+    f.deny();
+    f.steps.push(() => reply("", [tool("SetModelEnabled", { modelId: "model-b", enabled: false, basedOnRevision: 7 })]),
+      () => reply("", [tool("Probe", { value: "Do not write" })]), () => reply("No changes made."));
+    await f.runtime.executeTurn("Change this page");
+    assert.equal(calls, 0); assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 1);
+  } finally { await f.close(); }
+});
