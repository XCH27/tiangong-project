@@ -0,0 +1,38 @@
+import { modelSettingsAssistantViewSchema } from "@zcode/shared";
+import { ReadModelSettingsInputSchema, SetModelEnabledInputSchema,
+  ReadModelSettingsInputJsonSchema, SetModelEnabledInputJsonSchema, ModelSettingsOutputJsonSchema } from "@zcode/contracts";
+import type { ToolEntry } from "../types.js";
+
+function entry(write: boolean): ToolEntry {
+  const name = write ? "SetModelEnabled" : "ReadModelSettings";
+  return {
+    capability: write ? "Change model availability on the selected settings page" : "Explain the selected model settings without credentials",
+    metadata: { name,
+      description: write
+        ? "Enable or disable a model inside this settings assistant's immutable target. Uses the same revision-checked writer as the human page. Does not change active conversation selection. On conflict, explain it and wait; never silently retry with a newer revision."
+        : "Read current non-secret models and evidenced capabilities for this settings assistant's immutable target. Returns the current configuration revision, never keys, tokens or account login data.",
+      readOnly: !write, destructive: false, concurrentSafe: !write,
+      sideEffectScope: write ? "system" : "none", riskLevel: write ? "high" : "low", needsApproval: write },
+    handler: async (input, context) => {
+      if (!context.modelSettingsPort) return { result: false, errorCode: 32, message: "Model settings operations are unavailable in this Session" };
+      context.abortSignal.throwIfAborted();
+      const command = write ? { operation: "set-enabled" as const, ...SetModelEnabledInputSchema.parse(input) } : { operation: "read" as const };
+      return modelSettingsAssistantViewSchema.parse(await context.modelSettingsPort.perform(command, context.abortSignal));
+    },
+    inputSchema: write ? SetModelEnabledInputJsonSchema : ReadModelSettingsInputJsonSchema,
+    outputSchema: ModelSettingsOutputJsonSchema,
+    runtimeInputSchema: write ? SetModelEnabledInputSchema : ReadModelSettingsInputSchema,
+    runtimeOutputSchema: modelSettingsAssistantViewSchema,
+    permission: { permission: write ? "modelSettings.setEnabled" : "modelSettings.read",
+      reason: write ? "Change future model availability in the selected provider" : "Read non-secret model settings",
+      riskLevel: write ? "high" : "low", sideEffectScope: write ? "system" : "none", needsApproval: write,
+      ...(write ? { alwaysAsk: true, askOptions: { allowAlways: false as const } } : {}),
+      patternSources: ["toolName"], alwaysAllowPatternSources: write ? [] : ["toolName"], denyPriority: "beforeAsk" },
+    resultBudget: { maxInlineBytes: 24000, maxModelBytes: 24000, strategy: "truncate", preview: { maxBytes: 24000, direction: "head" } },
+    timeout: { kind: "timed", defaultMs: 15000, maxMs: 15000, allowCallOverride: false },
+    cancellation: { supported: false, cleanup: "none", userVisibleMessage: "Finishing the model settings operation" },
+    trace: { required: true, propagateToAdapters: true, recordInput: "summary", recordOutput: "summary" },
+  };
+}
+export const readModelSettingsToolEntry = entry(false);
+export const setModelEnabledToolEntry = entry(true);
