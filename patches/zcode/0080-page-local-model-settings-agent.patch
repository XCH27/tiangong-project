@@ -0,0 +1,29 @@
+import type { ModelSettingsPort } from "@zcode/contracts";
+import { zcodeProtocolMethods, modelSettingsAssistantTargetSchema, modelSettingsAssistantViewSchema,
+  MODEL_SETTINGS_ASSISTANT_TOOLS, modelSettingsAssistantInstructions, type ModelSettingsAssistantTarget } from "@zcode/shared";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+export function modelSettingsAssistantConfig(input: ModelSettingsAssistantTarget) {
+  const target = modelSettingsAssistantTargetSchema.parse(input);
+  return { modelSettingsAssistant: target, taskType: "page_assistant" as const,
+    systemPrompt: modelSettingsAssistantInstructions(target),
+    toolAllowlist: [...MODEL_SETTINGS_ASSISTANT_TOOLS],
+    mode: "build" as const, planEnabled: false, dynamicWorkflowEnabled: false,
+    titleGeneration: { enabled: false }, hooks: { enabled: false, events: {}, timeoutMs: 60000, maxOutputBytes: 32768 },
+    mcp: { enabled: false, servers: {} }, memory: { enabled: false }, subagents: { enabled: false } };
+}
+
+export function createModelSettingsPort(context: ZCodeProtocolAgentServerContext, sessionId: string,
+  target: ModelSettingsAssistantTarget): ModelSettingsPort {
+  const fixedTarget = modelSettingsAssistantTargetSchema.parse(target);
+  return {
+    async perform(command, signal) {
+      signal?.throwIfAborted();
+      if (command.operation === "set-enabled" && fixedTarget.modelId && command.modelId !== fixedTarget.modelId)
+        throw new Error("Model settings operation is outside the selected page target");
+      return context.requestClient(zcodeProtocolMethods.interactionModelSettingsAssistant,
+        { sessionId, target: fixedTarget, command }, modelSettingsAssistantViewSchema,
+        { signal, timeoutMs: 15000 });
+    },
+  };
+}
