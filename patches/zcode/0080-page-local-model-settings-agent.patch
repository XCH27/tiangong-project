@@ -0,0 +1,64 @@
+import { Settings2 } from "lucide-react";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { ToolLayout } from "../ToolLayout.js";
+import { readRawToolCallInput } from "../fileSummaryTypes.js";
+import type { ToolCallBlockRenderContext } from "../shared.js";
+
+export function isModelSettingsToolCall(
+  tool: ToolCallBlockRenderContext["toolCallNode"]["toolCall"],
+) {
+  return [tool.toolName, tool.kind, tool.title].some(
+    (name) => name === "ReadModelSettings" || name === "SetModelEnabled",
+  );
+}
+
+/** The same compact summary in the timeline and the original permission card. */
+export function ModelSettingsToolCallBlock(context: ToolCallBlockRenderContext) {
+  const { intl } = useZCodeIntl();
+  const tool = context.toolCallNode.toolCall;
+  const input = readRawToolCallInput(tool.raw) ?? tool.input;
+  const value = input && typeof input === "object" ? (input as Record<string, unknown>) : {};
+  const write = [tool.toolName, tool.kind, tool.title].includes("SetModelEnabled");
+  const id = write && typeof value.modelId === "string" ? value.modelId : undefined;
+  const title = intl.formatMessage({
+    id: write
+      ? "settings.modelProvider.assistant.changeModel"
+      : "settings.modelProvider.assistant.readModels",
+  });
+  const primary = id
+    ? intl.formatMessage(
+        {
+          id:
+            value.enabled === true
+              ? "settings.modelProvider.assistant.enableModel"
+              : "settings.modelProvider.assistant.disableModel",
+        },
+        { model: id },
+      )
+    : title;
+  const error = context.errorText
+    ? intl.formatMessage({
+        id: /revision|conflict/i.test(context.errorText)
+          ? "settings.modelProvider.assistant.conflict"
+          : /no longer exists|outside.*target/i.test(context.errorText)
+            ? "settings.modelProvider.assistant.targetLost"
+            : "settings.modelProvider.assistant.operationFailed",
+      })
+    : undefined;
+  return (
+    <ToolLayout
+      toolId={tool.toolId}
+      icon={<Settings2 className="size-4 text-foreground-subtle" />}
+      showIcon={context.showIcon}
+      canToggle={false}
+      kindLabel={context.kindLabelOverride ?? title}
+      primaryText={primary}
+      isRunning={context.isRunning}
+      secondaryText={context.statusLabel}
+      showFailureStatus={tool.status === "failed"}
+      statusLabel={tool.status === "failed" ? context.statusLabel : undefined}
+      statusTooltip={error}
+      title={primary}
+    />
+  );
+}
