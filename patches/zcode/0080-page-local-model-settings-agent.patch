@@ -0,0 +1,198 @@
+import { useEffect, useRef, useState } from "react";
+import { MessageCircle, X } from "lucide-react";
+import type { ModelSettingsAssistantView } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { Popover, PopoverAnchor, PopoverContent } from "@/components/ui/popover.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { V4ConversationProvider, useV4Conversation } from "@/v4/V4ConversationContext.js";
+import { SessionPane } from "@/v4/SessionPane.js";
+import { createCommandEnvelope } from "@/v4/commandFactory.js";
+
+export interface ModelSettingsAssistantSelection {
+  providerId: string;
+  providerName: string;
+  modelId?: string;
+}
+
+function AssistantConversation({
+  workspacePath,
+  view,
+}: {
+  workspacePath: string;
+  view: ModelSettingsAssistantView;
+}) {
+  const { sendCommand } = useV4Conversation();
+  const { intl } = useZCodeIntl();
+  const [sessionId, setSessionId] = useState<string>();
+  const [failed, setFailed] = useState(false);
+  // Retain the same identity through effect replay; creation never sends an input or starts inference.
+  const envelope = useRef(
+    createCommandEnvelope({
+      type: "createSession",
+      sessionId: null,
+      payload: {
+        workspaceId: workspacePath,
+        modelSettingsAssistant: view.target,
+        config: { mode: "build" },
+      },
+    }),
+  );
+  const pending = useRef<ReturnType<typeof sendCommand> | undefined>(undefined);
+  useEffect(() => {
+    let mounted = true;
+    pending.current ??= sendCommand(envelope.current);
+    void pending.current
+      .then((ack) => {
+        if (!mounted) return;
+        const result = ack.result;
+        if (ack.status !== "accepted" && ack.status !== "duplicate")
+          throw new Error("Page assistant creation failed");
+        if (
+          result?.type !== "createSession" ||
+          result.modelSettingsAssistant?.providerId !== view.target.providerId ||
+          result.modelSettingsAssistant.modelId !== view.target.modelId
+        )
+          throw new Error("Host does not support a scoped page assistant");
+        setSessionId(result.sessionId);
+      })
+      .catch(() => {
+        if (mounted) setFailed(true);
+      });
+    return () => {
+      mounted = false;
+    };
+  }, [sendCommand, view.target]);
+  if (failed)
+    return (
+      <p role="alert" className="p-4 text-ui-base text-destructive">
+        {intl.formatMessage({ id: "settings.modelProvider.assistant.failed" })}
+      </p>
+    );
+  if (!sessionId)
+    return (
+      <p className="p-4 text-ui-base text-foreground-subtle">
+        {intl.formatMessage({ id: "common.loading" })}
+      </p>
+    );
+  return (
+    <SessionPane
+      paneId={`model-settings:${sessionId}`}
+      sessionId={sessionId}
+      workspacePath={workspacePath}
+      compactAssistant
+      isDesktop
+      focused
+      telemetryVisible
+    />
+  );
+}
+
+export function ModelSettingsAssistant({
+  selected,
+  target,
+  onOpen,
+  onClose,
+}: {
+  selected: ModelSettingsAssistantSelection | null;
+  target: ModelSettingsAssistantSelection | null;
+  onOpen(target: ModelSettingsAssistantSelection): void;
+  onClose(): void;
+}) {
+  const { providerSettingsService } = useServices();
+  const { intl } = useZCodeIntl();
+  const [context, setContext] = useState<{
+    workspacePath: string;
+    view: ModelSettingsAssistantView;
+  }>();
+  const [failed, setFailed] = useState(false);
+  useEffect(() => {
+    setContext(undefined);
+    setFailed(false);
+    if (!target) return;
+    let mounted = true;
+    void providerSettingsService
+      .modelSettingsAssistantContext(target.providerId, target.modelId)
+      .then((value) => {
+        if (mounted) setContext(value);
+      })
+      .catch(() => {
+        if (mounted) setFailed(true);
+      });
+    return () => {
+      mounted = false;
+    };
+  }, [target, providerSettingsService]);
+  const label = intl.formatMessage({ id: "settings.modelProvider.assistant.open" });
+  const currentContext =
+    context &&
+    context.view.target.providerId === target?.providerId &&
+    context.view.target.modelId === target?.modelId
+      ? context
+      : undefined;
+  return (
+    <Popover
+      open={Boolean(target)}
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}
+    >
+      <PopoverAnchor asChild>
+        <Button
+          variant="outline"
+          disabled={!selected}
+          onClick={() => selected && onOpen(selected)}
+          aria-label={label}
+        >
+          <MessageCircle className="size-4" />
+          {label}
+        </Button>
+      </PopoverAnchor>
+      <PopoverContent
+        align="end"
+        side="bottom"
+        className="flex h-[min(32rem,calc(100vh-2rem))] w-[min(28rem,calc(100vw-2rem))] flex-col overflow-hidden p-0"
+        onInteractOutside={(event) => {
+          if (
+            (event.target as Element)?.closest(
+              '[data-slot="context-menu-content"], [data-slot="dialog-content"], [data-slot="alert-dialog-content"], [data-slot="select-content"]',
+            )
+          )
+            event.preventDefault();
+        }}
+      >
+        <div className="flex min-w-0 items-center justify-between gap-2 border-b border-border p-3">
+          <span className="min-w-0 truncate text-ui-base font-semibold">
+            {target?.modelId ?? target?.providerName}
+          </span>
+          <Button
+            variant="ghost"
+            size="icon-sm"
+            onClick={onClose}
+            aria-label={intl.formatMessage({ id: "common.close" })}
+          >
+            <X className="size-4" />
+          </Button>
+        </div>
+        <div className="min-h-0 flex-1">
+          {failed ? (
+            <p role="alert" className="p-4 text-ui-base text-destructive">
+              {intl.formatMessage({ id: "settings.modelProvider.assistant.failed" })}
+            </p>
+          ) : currentContext ? (
+            <V4ConversationProvider workspacePath={currentContext.workspacePath}>
+              <AssistantConversation
+                key={`${currentContext.view.target.providerId}/${currentContext.view.target.modelId ?? ""}`}
+                {...currentContext}
+              />
+            </V4ConversationProvider>
+          ) : (
+            <p className="p-4 text-ui-base text-foreground-subtle">
+              {intl.formatMessage({ id: "common.loading" })}
+            </p>
+          )}
+        </div>
+      </PopoverContent>
+    </Popover>
+  );
+}
