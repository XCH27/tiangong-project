index 0000000..25eef0b
--- /dev/null
+++ b/packages/services/src/model-provider/modelSettingsAssistant.ts
@@ -0,0 +1,97 @@
+import type { ProviderSettingsFacade } from "@zcode/provider";
+import {
+  modelSettingsAssistantTargetSchema,
+  modelSettingsAssistantOperationSchema,
+  modelSettingsAssistantViewSchema,
+  type ModelSettingsAssistantTarget,
+  type ModelSettingsAssistantOperation,
+} from "@zcode/shared";
+
+/** UI and Agent consume the existing Provider transaction; whitelist output before crossing a prompt. */
+export function createModelSettingsAssistantOperations(
+  facade: ProviderSettingsFacade,
+  ensureReady: () => Promise<void>,
+) {
+  return async (target: ModelSettingsAssistantTarget, command: ModelSettingsAssistantOperation) => {
+    const submittedTarget = modelSettingsAssistantTargetSchema.parse(target);
+    const submitted = modelSettingsAssistantOperationSchema.parse(command);
+    await ensureReady();
+    const current = facade.getView();
+    const provider = current.providers.find(
+      (item) => item.providerId === submittedTarget.providerId,
+    );
+    if (
+      !provider ||
+      (submittedTarget.modelId &&
+        !provider.models.some((item) => item.modelId === submittedTarget.modelId))
+    )
+      throw new Error("Model settings target no longer exists");
+    let view = current;
+    if (submitted.operation === "set-enabled") {
+      if (submittedTarget.modelId && submitted.modelId !== submittedTarget.modelId)
+        throw new Error("Model settings operation is outside the selected page target");
+      view = await facade.setPersonalModelEnabled(
+        submittedTarget.providerId,
+        submitted.modelId,
+        submitted.enabled,
+        submitted.basedOnRevision,
+      );
+    }
+    const saved = view.providers.find((item) => item.providerId === submittedTarget.providerId);
+    if (!saved) throw new Error("Model settings target no longer exists");
+    return modelSettingsAssistantViewSchema.parse({
+      target: submittedTarget,
+      revision: view.revision,
+      providerName: saved.providerName ?? null,
+      connectionKind:
+        saved.effectiveConfig.access?.type === "api-key"
+          ? "api"
+          : saved.effectiveConfig.access?.type === "subscription"
+            ? "subscription"
+            : saved.effectiveConfig.access?.type === "native-cli"
+              ? "native-cli"
+              : saved.effectiveConfig.access?.type === "zhipu-account"
+                ? "managed-account"
+                : "unknown",
+      apiFormat: saved.effectiveConfig.api?.type ?? null,
+      providerEnabled: saved.enabled,
+      models: saved.models
+        .filter((model) => !submittedTarget.modelId || model.modelId === submittedTarget.modelId)
+        .map((model) => ({
+          modelId: model.modelId,
+          enabled: model.enabled,
+          contextWindow: model.evidenceConfig?.properties?.contextWindow ?? null,
+          reasoningLevels: model.evidenceConfig?.optionSpecs?.reasoningLevel?.values ?? [],
+          fastSupported:
+            model.evidenceConfig?.optionSpecs?.speedMode === undefined
+              ? null
+              : Boolean(model.evidenceConfig?.optionSpecs?.speedMode),
+        })),
+    });
+  };
+}
+
+export function createModelSettingsAssistantService(
+  facade: ProviderSettingsFacade,
+  ensureReady: () => Promise<void>,
+  workspacePath?: () => string,
+) {
+  const performModelSettingsAssistant = createModelSettingsAssistantOperations(facade, ensureReady);
+  return {
+    performModelSettingsAssistant,
+    async modelSettingsAssistantContext(providerId: string, modelId?: string) {
+      if (!workspacePath) throw new Error("Page assistant is unavailable on this host");
+      await ensureReady();
+      const target: ModelSettingsAssistantTarget = {
+        feature: "model-settings",
+        providerId,
+        ...(modelId ? { modelId } : {}),
+        openingRevision: facade.getView().revision,
+      };
+      return {
+        workspacePath: workspacePath(),
+        view: await performModelSettingsAssistant(target, { operation: "read" }),
+      };
+    },
+  };
+}
