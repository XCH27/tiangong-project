index 0000000..89b85c4
--- /dev/null
+++ b/packages/ui/test/modelSettingsTool.browser.test.tsx
@@ -0,0 +1,74 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { ModelSettingsToolCallBlock } from "../src/ToolCallBlocks/renderers/model-settings.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+(window as unknown as Record<string, unknown>).__modelSettingsToolTests = (async () => {
+  const results: { name: string; error?: string }[] = [];
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const dark of [false, true]) {
+      const name = `Model operation summary: ${locale}, ${dark ? "dark" : "light"}, narrow`;
+      document.documentElement.classList.toggle("dark", dark);
+      const node = document.createElement("div");
+      node.style.width = "320px";
+      document.body.append(node);
+      const root = createRoot(node);
+      try {
+        await act(async () =>
+          root.render(
+            <ZCodeIntlProvider initialLocale={locale}>
+              <TooltipProvider>
+                <ModelSettingsToolCallBlock
+                  {...({
+                    toolCallNode: {
+                      toolCall: {
+                        toolId: "test",
+                        kind: "SetModelEnabled",
+                        title: "SetModelEnabled",
+                        status: "completed",
+                        raw: {
+                          input: { modelId: "model-b", enabled: false, basedOnRevision: 7 },
+                          debug: "not-for-product-display",
+                        },
+                      },
+                      childToolCalls: [],
+                    },
+                    isRunning: false,
+                    statusLabel: "",
+                    childToolList: null,
+                    displayModel: { inlinePreview: { type: "none" } },
+                    kindLabelOverride: locale === "zh-CN" ? "等待确认" : "Awaiting approval",
+                  } as never)}
+                />
+              </TooltipProvider>
+            </ZCodeIntlProvider>,
+          ),
+        );
+        check(
+          node.textContent?.includes(locale === "zh-CN" ? "停用 model-b" : "Disable model-b"),
+          "The exact operation target was not localized",
+        );
+        check(
+          !node.textContent?.includes("SetModelEnabled"),
+          "The summary exposed an implementation tool name",
+        );
+        check(!node.querySelector("pre"), "An approval requires reading a JSON dump");
+        check(
+          !node.textContent?.includes("not-for-product-display"),
+          "Raw transport fields entered the approval summary",
+        );
+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: String(error) });
+      } finally {
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    }
+  return results;
+})();
