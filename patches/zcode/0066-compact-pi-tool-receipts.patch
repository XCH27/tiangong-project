+test(
+  "a compact private Pi receipt preserves the Host's full text and image tool result",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    const text = "host-owned-result ".repeat(200);
+    const dataUrl =
+      "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVQIHWP4z8DwHwAFgAI/ScLbtAAAAABJRU5ErkJggg==";
