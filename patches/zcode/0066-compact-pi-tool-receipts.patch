+      const entry = f.runtime.getToolRegistry().get("Probe")!;
+      entry.handler = async () => ({ saved: true });
+      entry.formatModelContent = () => [
+        { type: "text", text },
+        { type: "image", dataUrl, mediaType: "image/png" },
+      ];
+      f.steps.push(
+        () => reply("working", [call("media", "fixture")]),
+        (request) => {
+          const payload = request.messages
+            .filter((message: any) => message.role === "tool")
+            .flatMap((message: any) =>
+              Array.isArray(message.content)
+                ? message.content
+                : [{ type: "text", text: message.content }],
+            );
+          assert.ok(
+            payload.some((block: any) => block.type === "text" && block.text.includes(text)),
+          );
+          assert.ok(
+            payload.some((block: any) => block.type === "image" && block.dataUrl === dataUrl),
+          );
+          return reply("complete");
+        },
+      );
+      assert.equal((await f.runtime.executeTurn("Inspect the result")).response, "complete");
+      assert.equal(f.requests.length, 2);
+    } finally {
+      await f.close();
+    }
+  },
+);
