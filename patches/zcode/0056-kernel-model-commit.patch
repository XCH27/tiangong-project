diff --git a/apps/zcode-cli/packages/bootstrap/test/kernel-model-commit.test.ts b/apps/zcode-cli/packages/bootstrap/test/kernel-model-commit.test.ts
new file mode 100644
index 0000000..25b71f3
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/kernel-model-commit.test.ts
@@ -0,0 +1,246 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { createRootTraceContext, SESSION_ENTRY_MODEL_SELECTION } from "@zcode/contracts";
+import {
+  createRegistryModelConfig,
+  createRegistryProviderConfig,
+  parseModelConfig,
+  parseProviderConfig,
+  ProviderRegistry,
+} from "@zcode/provider";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { applySubmissionExecutionState } from "../../core/src/runtime/methods/turn-model.js";
+import { createSessionFacade } from "../src/app/session-facade.js";
+
+const original = { providerId: "fixture", modelId: "first", options: { reasoningLevel: "medium" } };
+const requested = { providerId: "fixture", modelId: "second", options: { reasoningLevel: "high" } };
+
+async function fixture() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-kernel-commit-"));
+  const path = join(dir, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath: path });
+  const sessionId = "session" as never;
+  await store.createSession({
+    id: sessionId,
+    projectID: "project" as never,
+    directory: dir,
+    slug: "fixture",
+    title: "fixture",
+    version: "fixture",
+  });
+  await store.saveSessionEntry({
+    id: `${sessionId}:runtime-model-selection`,
+    sessionID: sessionId,
+    type: SESSION_ENTRY_MODEL_SELECTION,
+    touchSession: false,
+    time: { created: 1, updated: 1 },
+    data: original,
+  });
+  const provider = createRegistryProviderConfig(
+    parseProviderConfig({
+      group: "standard-personal",
+      api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+      access: { type: "api-key", apiKey: "synthetic" },
+    }),
+  );
+  const model = createRegistryModelConfig(
+    parseModelConfig({
+      enabled: true,
+      properties: {
+        contextWindow: 4096,
+        requiresMfjsToolSchema: false,
+        inputFormat: {
+          supportsText: true,
+          supportsImage: false,
+          supportsAudio: false,
+          supportsVideo: false,
+          supportsPdf: false,
+        },
+        outputFormat: { supportsText: true },
+        supportsToolCall: true,
+        supportsJsonSchemaOutput: false,
+        supportsNativeWebSearch: false,
+        supportsMidConversationSystem: false,
+      },
+      optionSpecs: {
+        maxOutputTokens: { max: 512, map: "{}" },
+        reasoningLevel: { values: ["medium", "high"], map: "{}" },
+      },
+    }),
+  );
+  assert.ok(provider.ok, JSON.stringify(provider));
+  assert.ok(model.ok, JSON.stringify(model));
+  const registry = new ProviderRegistry([
+    {
+      providerId: "fixture",
+      config: provider.config,
+      models: ["first", "second"].map((modelId) => ({ modelId, config: model.config })),
+    },
+  ]);
+  let current = structuredClone(original);
+  let fail = false;
+  let gate: Promise<void> | undefined;
+  const started = Promise.withResolvers<void>();
+  const events: unknown[] = [];
+  const pendingChanges: unknown[] = [];
+  const writer = {
+    async saveSessionEntry(entry: Parameters<typeof store.saveSessionEntry>[0]) {
+      started.resolve();
+      if (gate) await gate;
+      if (fail) throw new Error("synthetic disk write failed");
+      await store.saveSessionEntry(entry);
+    },
+  };
+  const trace = createRootTraceContext({ sessionId });
+  const runtime = {
+    sessionId,
+    sessionStore: writer,
+    getSessionModelSelection: () => current,
+    setSessionModelSelection: (selection: typeof original) => {
+      current = selection;
+    },
+    emitModelSelected: async (event: unknown) => {
+      events.push(event);
+    },
+    recordPendingModelChange: (change: unknown) => {
+      pendingChanges.push(change);
+    },
+    logger: { warn() {} },
+  };
+  const facade = createSessionFacade({
+    runtime,
+    sessionId,
+    sessionStore: writer,
+    providerRegistry: registry,
+    configResult: { config: { ui: { locale: "en-US" } } },
+    traceContext: trace,
+    logger: { info() {}, warn() {} },
+  } as never);
+  return {
+    runtime,
+    facade,
+    trace,
+    events,
+    pendingChanges,
+    started,
+    get current() {
+      return current;
+    },
+    block(promise: Promise<void>) {
+      gate = promise;
+    },
+    fail(value: boolean) {
+      fail = value;
+    },
+    async persisted() {
+      store.close();
+      store = new SqliteSessionStore({ dbPath: path });
+      return (
+        await store.sessionEntries({ sessionID: sessionId, type: SESSION_ENTRY_MODEL_SELECTION })
+      )[0]?.data;
+    },
+    async submit(executionOnly = false) {
+      return applySubmissionExecutionState(
+        runtime as never,
+        { modelSelection: requested } as never,
+        trace,
+        executionOnly ? ({ selectionScope: "execution" } as never) : undefined,
+        { ...requested, optionSpecs: { reasoningLevel: { values: ["medium", "high"] } } } as never,
+      );
+    },
+    async close() {
+      store.close();
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test("submission does not switch or publish a model until its persisted selection commits", async () => {
+  const f = await fixture();
+  const release = Promise.withResolvers<void>();
+  let pending: ReturnType<typeof f.submit> | undefined;
+  try {
+    f.block(release.promise);
+    pending = f.submit();
+    await f.started.promise;
+    assert.deepEqual(f.current, original);
+    assert.equal(f.events.length, 0);
+    release.resolve();
+    await pending;
+    assert.deepEqual(f.current, requested);
+    assert.deepEqual(await f.persisted(), requested);
+    assert.equal(f.events.length, 1);
+  } finally {
+    release.resolve();
+    await pending?.catch(() => {});
+    await f.close();
+  }
+});
+
+test("failed submission selection leaves memory and cold recovery unchanged, then permits retry", async () => {
+  const f = await fixture();
+  try {
+    f.fail(true);
+    await assert.rejects(f.submit(), /disk write failed/);
+    assert.deepEqual(f.current, original);
+    assert.deepEqual(await f.persisted(), original);
+    assert.equal(f.events.length, 0);
+    f.fail(false);
+    await f.submit();
+    assert.deepEqual(await f.persisted(), requested);
+  } finally {
+    await f.close();
+  }
+});
+
+test("execution-scoped models do not overwrite the conversation selection", async () => {
+  const f = await fixture();
+  try {
+    f.fail(true);
+    await f.submit(true);
+    assert.deepEqual(f.current, original);
+    assert.deepEqual(await f.persisted(), original);
+    assert.equal(f.events.length, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+for (const method of ["model", "effort"] as const) {
+  test(`the app facade rejects failed ${method} saves without advertising an in-memory switch`, async () => {
+    const f = await fixture();
+    const change = () =>
+      method === "model" ? f.facade.setModel(requested) : f.facade.setThoughtLevel("high");
+    const expected =
+      method === "model" ? requested : { ...original, options: { reasoningLevel: "high" } };
+    try {
+      f.fail(true);
+      await assert.rejects(change(), /disk write failed/);
+      assert.deepEqual(f.current, original);
+      assert.deepEqual(await f.persisted(), original);
+      assert.equal(f.pendingChanges.length, 0);
+      f.fail(false);
+      await change();
+      assert.deepEqual(f.current, expected);
+      assert.deepEqual(await f.persisted(), expected);
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("explicit transient model selection remains transient", async () => {
+  const f = await fixture();
+  try {
+    f.fail(true);
+    await f.facade.setModel(requested, { transient: true });
+    assert.deepEqual(f.current, requested);
+    assert.deepEqual(await f.persisted(), original);
+    assert.equal(f.pendingChanges.length, 0);
+  } finally {
+    await f.close();
+  }
+});
