+            db.close();
+          }
+        };
+        const saved = receipts();
+        assert.equal(saved.length, 1);
+        assert.equal(saved[0]!.status, stop ? "cancelled" : "error");
+        assert.equal(saved[0]!.input_tokens, 321);
+        assert.equal(saved[0]!.output_tokens, 12);
+        assert.equal(saved[0]!.provider_total_tokens, 333);
+        assert.deepEqual(JSON.parse(String(saved[0]!.raw_usage_json)), {
+          inputTokens: 321,
+          outputTokens: 12,
+          totalTokens: 333,
+        });
+        const accounting = JSON.parse(String(saved[0]!.provider_metadata_json)).fleetAccounting;
+        assert.equal(accounting.accountId, "finish-account");
+        assert.equal(accounting.requestId, "finish-receipt");
+        const assertText = async () => {
