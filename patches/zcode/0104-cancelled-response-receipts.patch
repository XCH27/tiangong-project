+            async *streamText(request: any) {
+              for await (const event of model.streamText(request)) {
+                yield event;
+                if (event.type === "finish") {
+                  finished.resolve();
+                  await releaseTail.promise;
+                  throw Object.assign(new Error("Transport tail failed after finish"), {
+                    code: "model_network_error",
+                  });
+                }
+              }
+            },
+          };
+        };
+        f.steps.push(() => ({
+          ...reply("Completed text received at finish", [call("finish-call", "must not run")]),
+          usage: { inputTokens: 321, outputTokens: 12, totalTokens: 333 },
+          providerMetadata: {
+            fleetAccounting: { accountId: "finish-account", requestId: "finish-receipt" },
+          },
+        }));
+        running = f.runtime.executeTurn("Retain completed response evidence");
+        const rejected = assert.rejects(running);
+        await finished.promise;
+        if (stop) f.runtime.stopActiveForegroundExecution();
+        releaseTail.resolve();
+        await rejected;
+        assert.equal(f.requests.length, 1, "A known finished request entered stream recovery");
+        assert.equal(f.effects, 0, "Trailing failure must not execute returned tools");
+        const receipts = () => {
