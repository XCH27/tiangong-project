+/** One observation path for known responses; logical cancellation is not zero consumption. */
+export async function publishModelResponseObservation(
+  runtime: AgentRuntimeInternal,
+  state: RegularTurnLoopState,
+  input: {
+    result: RuntimeModelTextResult;
+    querySource: string;
+    contextWindow?: number | null;
+    traceContext: TraceContext;
+    toolCallCount: number;
+    outcome?: "completed" | "cancelled" | "error";
+    content?: string;
+    cacheHit?: ReturnType<typeof recordMainTurnCacheHitUsage>;
+    fileChanges?: TurnFileChangeSummary;
+  },
+): Promise<void> {
+  const accountId = (input.result.providerMetadata?.fleetAccounting as { accountId?: unknown } | undefined)?.accountId;
+  const event = runtime.createEvent(SessionEventType.ModelComplete, {
+    content: input.content ?? input.result.text,
+    ...(typeof accountId === "string" && accountId ? { accountId } : {}),
+    ...(input.querySource === "main_turn" && input.contextWindow != null ? { contextWindow: input.contextWindow } : {}),
+    querySource: input.querySource,
+    stopReason: input.result.finishReason,
+    usage: input.result.usage,
+    ...(input.outcome && input.outcome !== "completed" ? { outcome: input.outcome } : {}),
+    ...(input.cacheHit ? { cacheHit: input.cacheHit } : {}),
+    ...(input.fileChanges ? { fileChanges: input.fileChanges } : {}),
+    ...(input.querySource === "main_turn" && input.result.contextUsageBreakdown ? { contextUsageBreakdown: input.result.contextUsageBreakdown } : {}),
+    toolCallCount: input.toolCallCount,
+  }, input.traceContext);
+  await runtime.appendEvent(event, input.traceContext);
+  state.events.push(event);
+}
