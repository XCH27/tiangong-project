index 0000000000000000000000000000000000000000..61cef4d93002cbd8be7d6437691edd3b5f420b90
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/cancelled-model-observation.test.ts
@@ -0,0 +1,147 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createInMemorySessionEventStore, SessionEventType, type SessionId } from "@zcode/contracts";
+import { fixture, reply, call } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { synthesizeEventsFromMessages } from "../src/zcode-protocol-v4/transcript-hydration.js";
+import { sessionUsageSeedFromRuntimeContextUsage } from "../src/zcode-protocol/v4-bridge.js";
+
+const sessionId = "session" as SessionId;
+for (const streaming of [false, true]) {
+  test(`known ${streaming ? "streaming" : "non-streaming"} Stop consumption reaches live V4, the original ledger and cold replay`, async () => {
+    const eventStore = createInMemorySessionEventStore();
+    const f = await fixture("pi", streaming, { deps: { eventStore } });
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    let running: Promise<unknown> | undefined;
+    try {
+      if (streaming) {
+        const runtime = f.runtime as any;
+        const factory = runtime.modelFactory;
+        runtime.modelFactory = (input: any) => {
+          const model = factory(input);
+          return { ...model, async *streamText(request: any) {
+            yield { type: "reasoning_start", id: "thought" };
+            yield { type: "reasoning_delta", id: "thought", text: "Known thought" };
+            yield { type: "reasoning_end", id: "thought" };
+            yield* model.streamText(request);
+          } };
+        };
+      }
+      f.steps.push(async () => {
+        entered.resolve(); await release.promise;
+        return { ...reply("Received before Stop settled", [call("never-execute", "no effect")]),
+          reasoning: [{ type: "reasoning", text: "Known thought" }],
+          providerMetadata: { fleetAccounting: { accountId: "actually-served-account" } } };
+      });
+      running = f.runtime.executeTurn("Observe consumed response without completing the turn");
+      const rejected = assert.rejects(running);
+      await entered.promise;
+      f.runtime.stopActiveForegroundExecution();
+      release.resolve(); await rejected;
+      const events = await eventStore.getEvents(sessionId);
+      const reports = events.filter(e => e.type === SessionEventType.ModelComplete);
+      assert.equal(reports.length, 1);
+      assert.equal((reports[0]!.payload as any).outcome, "cancelled");
+      const live = new ProductProjection(sessionId, "live");
+      for (const event of events) live.applyEventAtomically(event, () => true);
+      const snapshot = live.getSnapshot();
+      assert.equal(snapshot.usage.lastRequest?.accountId, "actually-served-account");
+      assert.equal(snapshot.usage.lastRequest?.inputTokens, 100);
+      assert.equal(snapshot.usage.lastRequest?.outputTokens, 10);
+      assert.equal(snapshot.usage.cumulative.inputTokens, 100);
+      assert.equal(snapshot.usage.cumulative.outputTokens, 10);
+      assert.equal((await f.runtime.rebuildProjection()).totalTokenCount, 110);
+      assert.equal(snapshot.rows.window.filter(row => row.kind === "assistantText").map(row => row.text).join(""), "Received before Stop settled");
+      assert.equal(snapshot.rows.window.filter(row => row.kind === "reasoning").map(row => row.text).join(""), "Known thought");
+      assert.equal(snapshot.rows.window.find(row => row.kind === "turnHeader")?.state, "completedInterrupted");
+      assert.equal(f.effects, 0);
+      assert.equal(f.requests.length, 1);
+      const retained = await f.store.queryTaskUsage({ sessionID: sessionId });
+      assert.equal(retained.lastRequest?.accountId, "actually-served-account");
+      assert.equal(retained.cumulativeMainUsage?.inputTokens, 100);
+      await f.reopen();
+      const cold = new ProductProjection(sessionId, "cold");
+      for (const event of synthesizeEventsFromMessages(await f.store.messages({ sessionID: sessionId }), { sessionId }))
+        cold.applyEventAtomically(event, () => true);
+      const saved = await f.store.queryTaskUsage({ sessionID: sessionId });
+      const seed = sessionUsageSeedFromRuntimeContextUsage(undefined, undefined, saved.lastRequest, saved.cumulativeMainUsage);
+      assert.ok(seed); cold.seedUsage(seed);
+      assert.deepEqual(cold.getSnapshot().usage.lastRequest, { ...snapshot.usage.lastRequest, observedAt: saved.lastRequest!.observedAt });
+      assert.deepEqual(cold.getSnapshot().usage.cumulative, snapshot.usage.cumulative);
+      assert.equal(cold.getSnapshot().rows.window.find(row => row.kind === "turnHeader")?.state, "completedInterrupted");
+      assert.equal(cold.getSnapshot().rows.window.filter(row => row.kind === "assistantText").map(row => row.text).join(""), "Received before Stop settled");
+      assert.equal(cold.getSnapshot().rows.window.filter(row => row.kind === "reasoning").map(row => row.text).join(""), "Known thought");
+    } finally { release.resolve(); await running?.catch(() => {}); await f.close(); }
+  });
+}
+
+test("a known failed response with a length finish never advertises successful continuation", async () => {
+  const eventStore = createInMemorySessionEventStore();
+  const f = await fixture("pi", true, { deps: { eventStore } });
+  try {
+    const runtime = f.runtime as any;
+    const factory = runtime.modelFactory;
+    runtime.modelFactory = (input: any) => {
+      const model = factory(input);
+      return { ...model, async *streamText(request: any) {
+        for await (const event of model.streamText(request)) {
+          yield event;
+          if (event.type === "finish") throw Object.assign(new Error("Trailing failure"), { code: "model_network_error" });
+        }
+      } };
+    };
+    f.steps.push(() => ({ ...reply("Known response"), finishReason: "length" }));
+    await assert.rejects(f.runtime.executeTurn("Retain known usage; do not continue"));
+    const projection = new ProductProjection(sessionId, "failed");
+    const events = await eventStore.getEvents(sessionId);
+    for (const event of events) projection.applyEventAtomically(event, () => true);
+    assert.equal((events.find(e => e.type === SessionEventType.ModelComplete)!.payload as any).outcome, "error");
+    assert.equal(projection.getSnapshot().usage.lastRequest?.inputTokens, 100);
+    assert.equal((await f.runtime.rebuildProjection()).totalTokenCount, 110);
+    assert.equal(projection.getSnapshot().rows.window.filter(row => row.kind === "assistantText").map(row => row.text).join(""), "Known response");
+    assert.equal(projection.getSnapshot().rows.window.find(row => row.kind === "turnHeader")?.state, "failed");
+    assert.equal(f.requests.length, 1);
+    assert.equal(f.effects, 0);
+  } finally { await f.close(); }
+});
+
+test("a failed streamed text write publishes only the missing saved suffix after a known finish", async () => {
+  const eventStore = createInMemorySessionEventStore();
+  const append = eventStore.append.bind(eventStore);
+  let deltas = 0;
+  eventStore.append = async event => {
+    if (event.type === SessionEventType.ModelStreaming && (event.payload as any).kind === "text_delta" && ++deltas === 2)
+      throw new Error("One failed text-frame write");
+    return append(event);
+  };
+  const f = await fixture("pi", true, { deps: { eventStore } });
+  try {
+    const runtime = f.runtime as any;
+    const factory = runtime.modelFactory;
+    runtime.modelFactory = (input: any) => {
+      const model = factory(input);
+      return { ...model, async *streamText(request: any) {
+        await model.generateText(request);
+        yield { type: "start" };
+        yield { type: "text_delta", text: "First " };
+        yield { type: "text_delta", text: "tail" };
+        yield { type: "finish", finishReason: "stop", usage: { inputTokens: 100, outputTokens: 10, totalTokens: 110 } };
+      } };
+    };
+    f.steps.push(() => reply("placeholder"));
+    await assert.rejects(f.runtime.executeTurn("Preserve the one failed delivery"));
+    const live = new ProductProjection(sessionId, "partial");
+    const events = await eventStore.getEvents(sessionId);
+    for (const event of events) live.applyEventAtomically(event, () => true);
+    assert.equal(live.getSnapshot().rows.window.filter(row => row.kind === "assistantText").map(row => row.text).join(""), "First tail");
+    assert.equal(events.filter(e => e.type === SessionEventType.ModelComplete).length, 1);
+    assert.equal(live.getSnapshot().usage.cumulative.inputTokens, 100);
+    assert.equal(f.requests.length, 1);
+    await f.reopen();
+    const cold = new ProductProjection(sessionId, "partial-cold");
+    for (const event of synthesizeEventsFromMessages(await f.store.messages({ sessionID: sessionId }), { sessionId }))
+      cold.applyEventAtomically(event, () => true);
+    assert.equal(cold.getSnapshot().rows.window.filter(row => row.kind === "assistantText").map(row => row.text).join(""), "First tail");
+  } finally { await f.close(); }
+});
