diff --git a/apps/zcode-cli/packages/core/test/usage-before-publication.test.ts b/apps/zcode-cli/packages/core/test/usage-before-publication.test.ts
new file mode 100644
index 0000000..017e908
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/usage-before-publication.test.ts
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { DatabaseSync } from "node:sqlite";
+import { join } from "node:path";
+import { call, fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+test("a received main response keeps its usage when ModelComplete publication fails (K-04)", async () => {
+  const f = await fixture();
+  try {
+    const runtime = f.runtime as never as { appendEvent(event: { type: string }, trace: unknown): Promise<void> };
+    const append = runtime.appendEvent.bind(runtime);
+    runtime.appendEvent = async (event, trace) => {
+      if (event.type === "model_complete") throw new Error("synthetic completion publication failure");
+      return append(event, trace);
+    };
+    f.steps.push(() => ({
+      ...reply("known complete response", [call("effect", "must not run")]),
+      usage: { inputTokens: 701, outputTokens: 23, totalTokens: 724 },
+    }));
+    await assert.rejects(f.runtime.executeTurn("Run local publish fault fixture"));
+    await f.reopen();
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    const rows = db.prepare("select query_source, input_tokens, output_tokens from model_usage").all().map((row) => ({ ...row }));
+    db.close();
+    assert.equal(f.effects, 0);
+    assert.deepEqual(rows, [{ query_source: "main_turn", input_tokens: 701, output_tokens: 23 }]);
+  } finally {
+    await f.close();
+  }
+});
