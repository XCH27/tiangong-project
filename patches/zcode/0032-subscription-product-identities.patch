+test("Grok tier and quota are independent facts and optional settings never grant access or imply an expiry", async () => {
+  const read = (billing: Response, settings: Response) =>
+    readSubscriptionUsage(
+      "xai",
+      credential,
+      async (url) => (String(url).endsWith("/settings") ? settings : billing),
+      () => 99,
+    );
+  const tierOnly = await read(
+    Response.json({ config: {} }),
+    Response.json({
+      subscription_tier_display: "SuperGrok Plus",
+      allow_access: false,
+    }),
+  );
+  assert.equal(tierOnly.status, "available");
+  if (tierOnly.status === "available") {
+    assert.equal(tierOnly.plan, "SuperGrok Plus");
+    assert.deepEqual(tierOnly.windows, []);
+    assert.equal(tierOnly.membership, undefined);
+    assert.equal(tierOnly.billing, undefined);
+  }
+  const quotaOnly = await read(
+    Response.json({ config: { creditUsagePercent: 17 } }),
+    new Response(null, { status: 503 }),
+  );
+  assert.equal(quotaOnly.status, "available");
+  if (quotaOnly.status === "available") {
+    assert.equal(quotaOnly.windows[0]?.usedPercent, 17);
+    assert.equal(quotaOnly.plan, undefined);
+  }
+  const unknown = await read(
+    Response.json({ config: {} }),
+    Response.json({ subscription_tier: "future_plan" }),
+  );
+  assert.equal(unknown.status, "available");
+  if (unknown.status === "available") assert.equal(unknown.plan, "future_plan");
+  assert.equal(
+    (
+      await read(
+        Response.json({ config: { creditUsagePercent: 17 } }),
+        new Response(null, { status: 401 }),
+      )
+    ).status,
+    "auth-required",
+  );
+  assert.equal(
