new file mode 100644
index 0000000..a12b45d
--- /dev/null
+++ b/packages/ui/src/lib/subscriptionPlanPresentation.ts
@@ -0,0 +1,55 @@
+type SubscriptionKind = "openai-codex" | "github-copilot" | "xai";
+const COLORS = {
+  neutral: "bg-muted text-foreground-subtle",
+  green: "bg-success/15 text-foreground border-success/30",
+  gold: "bg-warning/15 text-foreground border-warning/30",
+  blue: "bg-usage-chart-1/15 text-foreground border-usage-chart-1/30",
+  purple: "bg-usage-chart-3/15 text-foreground border-usage-chart-3/30",
+  teal: "bg-usage-chart-4/15 text-foreground border-usage-chart-4/30",
+} as const;
+type Plan = readonly [name: string, color: keyof typeof COLORS];
+const PLANS: Record<SubscriptionKind, Record<string, Plan>> = {
+  "openai-codex": {
+    free: ["Free", "neutral"],
+    plus: ["Plus", "green"],
+    pro: ["Pro", "gold"],
+    team: ["Team", "purple"],
+    business: ["Business", "purple"],
+    enterprise: ["Enterprise", "teal"],
+    chatgptteamplan: ["Team", "purple"],
+    chatgptplusplan: ["Plus", "green"],
+    chatgptproplan: ["Pro", "gold"],
+  },
+  "github-copilot": {
+    free: ["Free", "neutral"],
+    pro: ["Pro", "green"],
+    proplus: ["Pro+", "gold"],
+    business: ["Business", "purple"],
+    enterprise: ["Enterprise", "teal"],
+  },
+  xai: {
+    free: ["Free", "neutral"],
+    xbasic: ["X Basic", "neutral"],
+    premium: ["X Premium", "blue"],
+    xpremium: ["X Premium", "blue"],
+    premiumplus: ["X Premium+", "purple"],
+    xpremiumplus: ["X Premium+", "purple"],
+    supergroklite: ["SuperGrok Lite", "teal"],
+    supergrok: ["SuperGrok", "green"],
+    supergrokplus: ["SuperGrok Plus", "blue"],
+    supergrokheavy: ["SuperGrok Heavy", "gold"],
+    business: ["Business", "purple"],
+    enterprise: ["Enterprise", "teal"],
+  },
+};
+
+/** 仅格式化服务商已报告的档位；不按名称推算额度、费用或使用权限。 */
+export function subscriptionPlanPresentation(kind: SubscriptionKind, plan: string) {
+  const key = plan
+    .trim()
+    .toLowerCase()
+    .replace(/[\s_-]/g, "")
+    .replace(/\+/g, "plus");
+  const known = PLANS[kind][key];
+  return { name: known?.[0] ?? plan, className: COLORS[known?.[1] ?? "neutral"] };
+}
