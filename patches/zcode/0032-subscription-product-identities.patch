+
+async function readGrokUsage(
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+  now: () => number,
+): Promise<SubscriptionUsageResult> {
+  const headers = grokSubscriptionHeaders(credential);
+  // 官方 billing.rs 从 /settings 补充档位；额度响应本身不保证包含 subscriptionTier。
+  // 同一账号的两个只读结果进入既有额度缓存，不能把远端 settings 应用为 Fleet 配置。
+  const [credits, settings] = await Promise.allSettled(
+    ["/billing?format=credits", "/settings"].map((path) =>
+      readSubscriptionJson(`${GROK_SUBSCRIPTION_BASE_URL}${path}`, headers, fetcher, 10_000),
+    ),
+  );
+  for (const result of [credits, settings]) {
+    if (
+      result?.status === "rejected" &&
+      [401, 403].includes(Number(record(result.reason)?.statusCode))
+    )
+      return { status: "auth-required" };
+  }
+  const remote = settings?.status === "fulfilled" ? record(settings.value) : undefined;
+  const payload = credits?.status === "fulfilled" ? record(credits.value) : undefined;
+  const plan =
+    text(remote?.subscription_tier_display) ??
+    text(remote?.subscription_tier) ??
+    text(payload?.subscriptionTier);
+  if (!payload && !plan)
+    return {
+      status:
+        credits?.status === "rejected" && record(credits.reason)?.statusCode === 429
+          ? "rate-limited"
+          : "unavailable",
+    };
+  return parseSubscriptionUsage("xai", { ...payload, subscriptionTier: plan }, now());
+}
