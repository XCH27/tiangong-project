diff --git a/packages/ui/test/combinedModelControl.browser.test.tsx b/packages/ui/test/combinedModelControl.browser.test.tsx
new file mode 100644
index 0000000..098e257
--- /dev/null
+++ b/packages/ui/test/combinedModelControl.browser.test.tsx
@@ -0,0 +1,166 @@
+import { act, useState } from "react";
+import { createRoot } from "react-dom/client";
+import { ComposerModelControl } from "../src/chat-input-toolbar/ComposerModelControl.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { useComposerToolbarFit } from "../src/prompt-editor/useComposerToolbarFit.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const results: { name: string; error?: string }[] = [];
+let writes: string[] = [];
+
+function Fixture({ width, unknown = false }: { width: number; unknown?: boolean }) {
+  const ref = useComposerToolbarFit();
+  const [thought, setThought] = useState(unknown ? "unobserved" : "medium");
+  const [model, setModel] = useState("a");
+  const [speed, setSpeed] = useState<"standard" | "fast">("standard");
+  return (
+    <div ref={ref} className="group/toolbar flex items-center gap-3" style={{ width }}>
+      <div data-composer-leading-actions className="min-w-0 flex-1">
+        <div
+          data-composer-leading-content
+          className="inline-flex items-center gap-2 whitespace-nowrap"
+        >
+          <button style={{ width: 28 }}>+</button>
+          <ComposerModelControl
+            provider="zcode"
+            thought={
+              {
+                type: "select",
+                id: "reasoningLevel",
+                name: "Thinking",
+                currentValue: thought,
+                options: ["low", "medium", "high"].map((value) => ({ value, name: value })),
+              } as never
+            }
+            onThoughtChange={(next) => {
+              writes.push(`thought:${next}`);
+              setThought(next);
+            }}
+            speed={{
+              value: speed,
+              note: "Synthetic provider-specific allowance note",
+              onChange: (next) => {
+                writes.push(`speed:${next}`);
+                setSpeed(next);
+              },
+            }}
+            model={{
+              modelGroups: [
+                {
+                  key: "provider",
+                  label: "Connected provider",
+                  directItems: true,
+                  items: [
+                    { key: "a", value: "a", name: "A deliberately long model name" },
+                    { key: "b", value: "b", name: "Another model" },
+                  ],
+                },
+              ],
+              normalizedValue: model,
+              triggerLabel: model === "a" ? "A deliberately long model name" : "Another model",
+              showManageModelsAction: false,
+              lockReasonMessage: "Locked",
+              isItemLocked: () => false,
+              onValueChange: (next) => {
+                writes.push(`model:${next}`);
+                setModel(next);
+              },
+              triggerClassName:
+                "composer-model-trigger group-data-[composer-model-icon=true]/toolbar:size-7 group-data-[composer-model-icon=true]/toolbar:p-0 group-data-[composer-model-icon=true]/toolbar:gap-0",
+              triggerLabelClassName: "group-data-[composer-model-icon=true]/toolbar:hidden",
+              indicatorClassName: "group-data-[composer-model-icon=true]/toolbar:hidden",
+              focusSelectorOnClose: null,
+            }}
+          />
+        </div>
+      </div>
+      <div data-composer-trailing-actions style={{ width: 32 }}>
+        <button>↑</button>
+      </div>
+    </div>
+  );
+}
+
+(window as unknown as Record<string, unknown>).__combinedModelTests = (async () => {
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const dark of [false, true])
+      for (const width of [560, 150]) {
+        const name = `${locale}, ${dark ? "dark" : "light"}, ${width}px: one model/effort entry and scoped Fast`;
+        document.documentElement.classList.toggle("dark", dark);
+        const node = document.createElement("div");
+        document.body.append(node);
+        const root = createRoot(node);
+        writes = [];
+        try {
+          await act(async () =>
+            root.render(
+              <ZCodeIntlProvider initialLocale={locale}>
+                <TooltipProvider><Fixture width={width} /></TooltipProvider>
+              </ZCodeIntlProvider>,
+            ),
+          );
+          await act(async () => {
+            await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+          });
+          const trigger =
+            node.querySelector<HTMLButtonElement>('[data-testid="chat-model-select-trigger"]') ??
+            node.querySelector<HTMLButtonElement>(".composer-model-trigger");
+          check(trigger, "Combined model entry is missing");
+          check(
+            node.querySelectorAll('[data-chat-toolbar-popover-trigger="true"]').length === 1,
+            "The old separate thought trigger survived",
+          );
+          check(writes.length === 0, "Mount/resize changed model or effort");
+          if (width === 150) {
+            check(
+              node.querySelector('[data-composer-model-icon="true"]'),
+              "Narrow toolbar did not collapse",
+            );
+            check(
+              trigger!.getBoundingClientRect().width <= 30,
+              "Narrow control retained a long model label",
+            );
+            const brain = trigger!.querySelector<SVGElement>(".lucide-brain");
+            check(
+              brain && getComputedStyle(brain).display !== "none",
+              "Compact model did not use the original Brain icon",
+            );
+          }
+          await act(async () => {
+            trigger!.dispatchEvent(
+              new PointerEvent("pointerdown", { bubbles: true, button: 0, pointerType: "mouse" }),
+            );
+            trigger!.dispatchEvent(
+              new PointerEvent("pointerup", { bubbles: true, button: 0, pointerType: "mouse" }),
+            );
+          });
+          const fast = [...document.querySelectorAll<HTMLElement>('[role="menuitem"]')].find(
+            (element) =>
+              element.getAttribute("aria-label")?.toLowerCase().includes(locale === "zh-CN" ? "快速" : "fast"),
+          );
+          check(fast, "The menu lost its Fast action");
+          await act(async () => fast!.click());
+          check(writes.at(-1) === "speed:fast", "Fast was translated into an effort change");
+          const high = [...document.querySelectorAll<HTMLElement>('[role="menuitemradio"]')].find(
+            (element) => element.textContent?.trim() === (locale === "zh-CN" ? "高" : "High"),
+          );
+          check(high, "Only the evidenced effort rows should be present");
+          await act(async () => high!.click());
+          check(
+            writes.at(-1) === "thought:high",
+            "Effort selection did not use its existing callback",
+          );
+          results.push({ name });
+        } catch (error) {
+          results.push({ name, error: String(error) });
+        } finally {
+          await act(async () => root.unmount());
+          node.remove();
+        }
+      }
+  return results;
+})();
