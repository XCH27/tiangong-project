@@ -0,0 +1,138 @@
+import type { ComponentProps } from "react";
+import { BrainIcon, ZapIcon } from "lucide-react";
+import type { ZCodeConfigOption, ZCodeProvider } from "@zcode/shared";
+import { TID_CHAT_THOUGHT_LEVEL_SELECT_ITEM, testId } from "@zcode/shared";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { ControlHintTooltip } from "@/ControlHintTooltip.js";
+import {
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+} from "@/components/ui/dropdown-menu.js";
+import { getThoughtLevelLabel } from "./thoughtLevelOptions.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { cn } from "@/components/lib/utils.js";
+
+/** One host model picker; effort/Fast remain independent, composer-owned request fields. */
+export function ComposerModelControl({
+  model,
+  thought,
+  provider,
+  onThoughtChange,
+  speed,
+}: {
+  model: ComponentProps<typeof ModelConfigSelect>;
+  thought?: ZCodeConfigOption | null;
+  provider?: ZCodeProvider;
+  onThoughtChange(value: string): void;
+  speed?: { value: "standard" | "fast"; note: string; onChange(value: "standard" | "fast"): void };
+}) {
+  const { intl } = useZCodeIntl();
+  const entries = thought?.type === "select" ? (thought.options ?? []) : [];
+  const current = entries.find((entry) => entry.value === String(thought?.currentValue));
+  const thoughtLabel =
+    current && thought
+      ? getThoughtLevelLabel(intl, provider, thought, current)
+      : entries.length
+        ? intl.formatMessage({ id: "chat.toolbar.thoughtLevel.placeholder" })
+        : undefined;
+  const fullLabel = [
+    model.tooltipTitle ?? model.triggerLabel,
+    thoughtLabel,
+    speed?.value === "fast" ? intl.formatMessage({ id: "chat.toolbar.speed.label" }) : null,
+  ]
+    .filter(Boolean)
+    .join(" · ");
+  const menuOptions =
+    entries.length || speed ? (
+      <>
+        <div className="flex items-center justify-between gap-2 pr-1">
+          <DropdownMenuLabel>
+            {intl.formatMessage({ id: "chat.toolbar.options.thinking" })}
+          </DropdownMenuLabel>
+          {speed ? (
+            <ControlHintTooltip
+              title={intl.formatMessage({ id: "chat.toolbar.speed.tooltipTitle" })}
+              description={speed.note}
+              side="left"
+              align="start"
+              className="z-[70]"
+            >
+              <DropdownMenuItem
+                disabled={model.disabled}
+                aria-label={intl.formatMessage({
+                  id:
+                    speed.value === "fast"
+                      ? "chat.toolbar.speed.disable"
+                      : "chat.toolbar.speed.enable",
+                })}
+                className={cn(
+                  "size-7 min-h-7 justify-center p-0",
+                  speed.value === "fast" && "bg-menu-hover",
+                )}
+                onSelect={(event) => {
+                  event.preventDefault();
+                  speed.onChange(speed.value === "fast" ? "standard" : "fast");
+                }}
+              >
+                <ZapIcon
+                  className={cn(
+                    "size-4",
+                    speed.value === "fast" ? "fill-current" : "text-foreground-subtle",
+                  )}
+                />
+              </DropdownMenuItem>
+            </ControlHintTooltip>
+          ) : null}
+        </div>
+        <DropdownMenuRadioGroup
+          value={current?.value ?? ""}
+          onValueChange={(next) => {
+            if (entries.some((entry) => entry.value === next)) onThoughtChange(next);
+          }}
+        >
+          {entries.map((entry) => (
+            <DropdownMenuRadioItem
+              key={entry.value}
+              value={entry.value}
+              disabled={model.disabled}
+              data-testid={testId(TID_CHAT_THOUGHT_LEVEL_SELECT_ITEM, entry.value)}
+            >
+              {getThoughtLevelLabel(intl, provider, thought!, entry)}
+            </DropdownMenuRadioItem>
+          ))}
+        </DropdownMenuRadioGroup>
+        <DropdownMenuSeparator />
+      </>
+    ) : undefined;
+  return (
+    <ModelConfigSelect
+      {...model}
+      tooltipTitle={fullLabel}
+      leadingContent={menuOptions}
+      triggerIcon={
+        <BrainIcon
+          className="pointer-events-none hidden size-4 shrink-0 group-data-[composer-model-icon=true]/toolbar:inline-flex"
+          aria-hidden="true"
+        />
+      }
+      triggerBadge={
+        <>
+          {thoughtLabel ? (
+            <span className="min-w-0 truncate text-foreground-subtle group-data-[composer-model-icon=true]/toolbar:hidden">
+              {thoughtLabel}
+            </span>
+          ) : null}
+          {speed?.value === "fast" ? (
+            <ZapIcon
+              className="size-3.5 shrink-0 fill-current group-data-[composer-model-icon=true]/toolbar:hidden"
+              aria-hidden="true"
+            />
+          ) : null}
+        </>
+      }
+    />
+  );
+}
