+test("explicit auxiliary budgets reach the wire even when model output capacity is unknown", async () => {
+  for (const api of [
+    "openai-chat-completions",
+    "openai-responses",
+    "anthropic-messages",
+  ] as const) {
+    const outputField = api === "openai-responses" ? "max_output_tokens" : "max_tokens";
+    const { execution, requests } = fixture();
+    const model = bind(execution, {
+      api,
+      outputLimitMap: `{\"${outputField}\": maxOutputTokens}`,
+      omitUnsourcedOutputLimit: true,
+    });
+    await runWithModelInvocationContext(
+      { modelCall: { operation: "workspace_generate_text" } },
+      () => run(model, undefined, 1),
+    );
+    assert.equal(requests[0]!.body[outputField], 1);
+  }
+});
