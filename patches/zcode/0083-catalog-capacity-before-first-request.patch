diff --git a/packages/ui/test/contextCapacity.browser.test.tsx b/packages/ui/test/contextCapacity.browser.test.tsx
new file mode 100644
index 0000000..74fd4dd
--- /dev/null
+++ b/packages/ui/test/contextCapacity.browser.test.tsx
@@ -0,0 +1,76 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ChatContextUsage } from "../src/chat-input-toolbar/contextUsage.js";
+import { ZCodeIntlProvider, useZCodeIntl } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+function Capacity({ capacity }: { capacity?: number }) {
+  const { intl, locale } = useZCodeIntl();
+  return (
+    <ChatContextUsage
+      taskUsage={null}
+      modelContextCapacity={capacity}
+      selectedProvider="zcode"
+      intl={intl}
+      locale={locale}
+    />
+  );
+}
+(window as unknown as Record<string, unknown>).__contextCapacityTests = (async () => {
+  const results: { name: string; error?: string }[] = [];
+  for (const locale of ["zh-CN", "en-US"] as const)
+    for (const dark of [false, true]) {
+      const name = `${locale}, ${dark ? "dark" : "light"}: model capacity before first request, occupancy unknown`;
+      document.documentElement.classList.toggle("dark", dark);
+      const node = document.createElement("div");
+      document.body.append(node);
+      const root = createRoot(node);
+      const render = (capacity?: number) =>
+        root.render(
+          <ZCodeIntlProvider initialLocale={locale}>
+            <TooltipProvider>
+              <Capacity capacity={capacity} />
+            </TooltipProvider>
+          </ZCodeIntlProvider>,
+        );
+      try {
+        await act(async () => render());
+        check(!node.querySelector("button"), "Unknown capacity created a fabricated meter");
+        await act(async () => render(256000));
+        const trigger = node.querySelector<HTMLButtonElement>("button")!;
+        check(trigger, "Known capacity remained hidden until first inference");
+        await act(async () => trigger.click());
+        check(
+          document.body.textContent?.includes("256K"),
+          "Capacity did not come from the selected catalog model",
+        );
+        check(
+          document.body.textContent?.includes(
+            locale === "zh-CN" ? "尚无实测用量" : "No measured usage",
+          ),
+          "Unknown occupancy was not labelled",
+        );
+        check(!document.body.textContent?.includes("0%"), "Unknown occupancy became zero percent");
+        await act(async () => render(128000));
+        check(
+          document.body.textContent?.includes("128K"),
+          "A next-model capacity retained the previous model limit",
+        );
+        check(
+          !document.body.textContent?.includes("256K"),
+          "Old capacity leaked after selection changed",
+        );
+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: String(error) });
+      } finally {
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    }
+  return results;
+})();
