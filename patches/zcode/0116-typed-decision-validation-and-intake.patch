new file mode 100644
index 0000000..3695e41
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/decision-classifier.test.ts
@@ -0,0 +1,266 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { classify } from "@earendil-works/pi-ai/api/typesafe-system-one";
+import { classify as classifyCloudflare } from "@earendil-works/pi-ai/api/cloudflare-workers-ai-system-one";
+import type { ClassifierContext, ClassifierModel } from "@earendil-works/pi-ai";
+
+const model: ClassifierModel<"typesafe-system-one"> = {
+  type: "classifier",
+  id: "decision-fixture",
+  name: "Decision fixture",
+  api: "typesafe-system-one",
+  provider: "typesafe",
+  baseUrl: "https://fixture.invalid/v1",
+  input: ["text"],
+  contextWindow: 8192,
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+};
+const context: ClassifierContext = {
+  state: { article: "Synthetic news; no user data or actual model inference." },
+  questions: {
+    event: {
+      type: "choice",
+      instructions: "Which event?",
+      criteria: { earnings: "Financial results", other: "Other news" },
+    },
+    relevance: {
+      type: "score",
+      instructions: "Rate relevance",
+      criteria: ["low", "medium", "high"],
+    },
+    related: {
+      type: "bool",
+      instructions: "Is this related?",
+      criteria: { true: "Related", false: "Unrelated" },
+    },
+  },
+};
+const answers = () => ({
+  event: {
+    type: "choice",
+    choice: "earnings",
+    probabilities: { earnings: 0.8, other: 0.2 },
+    confidence: 0.3,
+  },
+  relevance: { type: "score", score: 1.5, confidence: 0.8 },
+  related: { type: "noul", noul: 0.9 },
+});
+
+for (const [name, change] of [
+  [
+    "an option never offered",
+    (a: any) => {
+      a.event.choice = "trade_now";
+    },
+  ],
+  [
+    "a choice inconsistent with its distribution",
+    (a: any) => {
+      a.event.choice = "other";
+    },
+  ],
+  [
+    "an inherited option name",
+    (a: any) => {
+      a.event.choice = "toString";
+    },
+  ],
+  [
+    "probabilities outside zero to one",
+    (a: any) => {
+      a.event.probabilities = { earnings: 1.8, other: -0.8 };
+    },
+  ],
+  [
+    "a missing option probability",
+    (a: any) => {
+      delete a.event.probabilities.other;
+    },
+  ],
+  [
+    "an extra option probability",
+    (a: any) => {
+      a.event.probabilities.trade_now = 0;
+    },
+  ],
+  [
+    "a distribution with missing mass",
+    (a: any) => {
+      a.event.probabilities = { earnings: 0.2, other: 0.2 };
+    },
+  ],
+  [
+    "confidence outside zero to one",
+    (a: any) => {
+      a.event.confidence = 7;
+    },
+  ],
+  [
+    "a score outside its rubric",
+    (a: any) => {
+      a.relevance.score = 99;
+    },
+  ],
+  [
+    "a boolean probability outside zero to one",
+    (a: any) => {
+      a.related.noul = -0.7;
+    },
+  ],
+] as const) {
+  test(`System One rejects ${name} and retains the billed usage`, async () => {
+    const wire = answers();
+    change(wire);
+    let calls = 0;
+    const result = await classify(model, context, {
+      apiKey: "synthetic-key",
+      maxRetries: 0,
+      fetch: async () => {
+        calls++;
+        return Response.json({ answers: wire, usage: { input_tokens: 18, output_tokens: 0 } });
+      },
+    });
+    assert.equal(result.stopReason, "error");
+    assert.deepEqual(result.answers, {});
+    assert.equal(result.usage?.input, 18);
+    assert.equal(calls, 1);
+  });
+}
+
+test("valid System One responses preserve probability and confidence as distinct quantities", async () => {
+  const result = await classify(model, context, {
+    apiKey: "synthetic-key",
+    maxRetries: 0,
+    fetch: async () => Response.json({ answers: answers() }),
+  });
+  assert.equal(result.stopReason, "stop");
+  assert.deepEqual(result.answers.event, answers().event);
+  assert.deepEqual(result.answers.relevance, answers().relevance);
+  assert.deepEqual(result.answers.related, { type: "bool", probability: 0.9 });
+  assert.equal(result.usage, undefined);
+});
+
+test("a local compatible server uses the real SDK protocol and cancels without retry", async () => {
+  const calls: { path: string; body: any }[] = [];
+  const server = createServer(async (request, response) => {
+    let body = "";
+    for await (const chunk of request) body += chunk;
+    const parsed = JSON.parse(body);
+    calls.push({ path: request.url!, body: parsed });
+    if (parsed.state.stall) return;
+    response.setHeader("content-type", "application/json");
+    response.end(
+      JSON.stringify({
+        model: "served-fixture",
+        answers: answers(),
+        usage: { input_tokens: 18, output_tokens: 0 },
+      }),
+    );
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert(address && typeof address === "object");
+  const local = { ...model, baseUrl: `http://127.0.0.1:${address.port}/v1` };
+  try {
+    const result = await classify(local, context, {
+      apiKey: "synthetic-local",
+      maxRetries: 0,
+      timeoutMs: 1000,
+    });
+    assert.equal(result.stopReason, "stop");
+    assert.equal(calls[0]?.path, "/v1/systemone");
+    assert.equal(calls[0]?.body.questions.related.type, "noul");
+    assert.equal(result.usage?.input, 18);
+    const stop = new AbortController();
+    const pending = classify(
+      local,
+      { ...context, state: { stall: true } },
+      { apiKey: "synthetic-local", maxRetries: 0, signal: stop.signal },
+    );
+    const timeout = setTimeout(() => stop.abort(), 30);
+    const cancelled = await pending;
+    clearTimeout(timeout);
+    assert.equal(cancelled.stopReason, "aborted");
+    assert(calls.length <= 2);
+  } finally {
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
+
+test("four-decimal local distributions remain compatible without inventing normalized probabilities", async () => {
+  const criteria = Object.fromEntries(
+    Array.from({ length: 255 }, (_, i) => [`label-${i}`, `Option ${i}`]),
+  );
+  const distribution = Object.fromEntries(Object.keys(criteria).map((key) => [key, 0.0039]));
+  const result = await classify(
+    model,
+    { state: {}, questions: { q: { type: "choice", instructions: "Select a label", criteria } } },
+    {
+      apiKey: "synthetic-key",
+      maxRetries: 0,
+      fetch: async () =>
+        Response.json({
+          answers: {
+            q: { type: "choice", choice: "label-0", probabilities: distribution, confidence: 0 },
+          },
+        }),
+    },
+  );
+  assert.equal(result.stopReason, "stop");
+  assert.deepEqual(result.answers.q, {
+    type: "choice",
+    choice: "label-0",
+    probabilities: distribution,
+    confidence: 0,
+  });
+});
+
+test("explicit prototype-like labels are valid own options", async () => {
+  const criteria = JSON.parse('{"toString":"A real label","other":"Other"}');
+  const probabilities = JSON.parse('{"toString":0.8,"other":0.2}');
+  const result = await classify(
+    model,
+    { state: {}, questions: { q: { type: "choice", instructions: "Pick a label", criteria } } },
+    {
+      apiKey: "synthetic-key",
+      maxRetries: 0,
+      fetch: async () =>
+        Response.json({
+          answers: { q: { type: "choice", choice: "toString", probabilities, confidence: 0.3 } },
+        }),
+    },
+  );
+  assert.equal(result.stopReason, "stop");
+  assert.equal(result.answers.q?.type, "choice");
+});
+
+test("Cloudflare's completed-run envelope uses the same strict validation and preserves usage on failure", async () => {
+  const wire = answers();
+  wire.related.noul = 7;
+  const result = await classifyCloudflare(
+    {
+      ...model,
+      api: "cloudflare-workers-ai-system-one",
+      provider: "cloudflare-workers-ai",
+      baseUrl: "https://fixture.invalid/accounts/synthetic/ai",
+    },
+    context,
+    {
+      apiKey: "synthetic-key",
+      maxRetries: 0,
+      fetch: async () =>
+        Response.json({
+          success: true,
+          result: {
+            state: "Completed",
+            result: { answers: wire, usage: { input_tokens: 18, output_tokens: 0 } },
+          },
+        }),
+    },
+  );
+  assert.equal(result.stopReason, "error");
+  assert.equal(result.usage?.input, 18);
+  assert.deepEqual(result.answers, {});
+});
