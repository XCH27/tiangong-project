diff --git a/scripts/prepare-git-hooks.mjs b/scripts/prepare-git-hooks.mjs
new file mode 100644
index 0000000..1d0f1ac
--- /dev/null
+++ b/scripts/prepare-git-hooks.mjs
@@ -0,0 +1,18 @@
+import { existsSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+
+// Dependency installation must not replace Fleet's configured commit gates.
+if (process.env.HUSKY !== "0" && existsSync(".git")) {
+  const current = spawnSync("git", ["config", "--get", "core.hooksPath"], { encoding: "utf8" });
+  if (current.error || (current.status !== 0 && current.status !== 1)) {
+    throw new Error("Unable to inspect the configured Git hooks");
+  }
+  const hooksPath = current.stdout.trim();
+  if (hooksPath && hooksPath !== ".husky" && hooksPath !== ".husky/_") {
+    console.log("Preserved the configured Git hooks.");
+  } else {
+    const { default: install } = await import("husky");
+    const message = install(".husky");
+    if (message) console.log(message);
+  }
+}
diff --git a/scripts/prepare-git-hooks.test.mjs b/scripts/prepare-git-hooks.test.mjs
new file mode 100644
index 0000000..98fe457
--- /dev/null
+++ b/scripts/prepare-git-hooks.test.mjs
@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "node:child_process";
+
+const script = fileURLToPath(new URL("./prepare-git-hooks.mjs", import.meta.url));
+const env = {
+  ...process.env,
+  GIT_CONFIG_GLOBAL: join(tmpdir(), `fleet-no-global-config-${process.pid}`),
+  GIT_CONFIG_NOSYSTEM: "1",
+  HUSKY: "1",
+};
+for (const existing of ["/fixture/fleet/.githooks/zcode", ".githooks", undefined]) {
+  test(`dependency preparation preserves ${existing ?? "ordinary Husky setup"}`, async () => {
+    const cwd = await mkdtemp(join(tmpdir(), "fleet-hooks-test-"));
+    const git = (...args) => {
+      const result = spawnSync("git", args, { cwd, env, encoding: "utf8" });
+      assert.equal(result.status, 0, result.stderr);
+      return result.stdout.trim();
+    };
+    try {
+      git("init", "--quiet");
+      if (existing) git("config", "core.hooksPath", existing);
+      const prepare = spawnSync(process.execPath, [script], { cwd, env, encoding: "utf8" });
+      assert.equal(prepare.status, 0, prepare.stderr);
+      assert.equal(git("config", "--get", "core.hooksPath"), existing ?? ".husky/_");
+    } finally {
+      await rm(cwd, { recursive: true, force: true });
+    }
+  });
+}
