+test("single credential edits persist independently through the existing owner and survive restart", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-key-row-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  const runtime = createProviderConfigRuntime(options);
+  let restarted: ReturnType<typeof createProviderConfigRuntime> | undefined;
+  try {
+    await runtime.start();
+    const fixture = rowFixture();
+    const created = await runtime.configService.createPersonalProvider({
+      providerName: fixture.providerName!,
+      initialConfig: parseProviderConfig(fixture.config),
+    });
+    fixture.providerId = created.providerId;
+    const first = resolveCredentialRowEdit(fixture, ["new-a", "unfinished-b", "new-c"], {
+      kind: "confirm",
+      index: 2,
+    })!;
+    await runtime.configService.savePersonalProviderOverlay(
+      created.providerId,
+      parseProviderConfig(first.provider!.personalConfig),
+    );
+    const second = resolveCredentialRowEdit(first.provider!, first.draftKeys, {
+      kind: "confirm",
+      index: 0,
+    })!;
+    await runtime.configService.savePersonalProviderOverlay(
+      created.providerId,
+      parseProviderConfig(second.provider!.personalConfig),
+    );
+    runtime.dispose();
+    restarted = createProviderConfigRuntime(options);
+    await restarted.start();
+    const stored = (await restarted.configService.read()).personalProviders
+      .get(created.providerId)!
+      .toJSON();
+    assert.deepEqual(stored.access, {
+      type: "api-key",
+      apiKey: "new-a",
+      additionalApiKeys: ["saved-b", "new-c"],
+      autoSwitchCredentials: true,
+    });
+    assert.deepEqual(stored.api, fixture.config.api);
+    assert.deepEqual(second.draftKeys, ["new-a", "unfinished-b", "new-c"]);
+  } finally {
+    runtime.dispose();
+    restarted?.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
