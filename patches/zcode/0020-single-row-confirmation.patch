index 0000000..7cdd943
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ProviderCredentialEdit.ts
@@ -0,0 +1,87 @@
+import { isApiKeyAccess } from "@zcode/provider";
+import type { ProviderSettingsFormProvider } from "../../lib/providerSettingsFormTypes.js";
+
+export type CredentialRowEdit =
+  | { kind: "confirm" | "remove" | "default" | "revert"; index: number }
+  | { kind: "automatic"; value: boolean };
+
+export function configuredProviderKeys(provider: ProviderSettingsFormProvider): string[] {
+  if (!isApiKeyAccess(provider.config.access)) return [];
+  const keys = [
+    provider.config.access.apiKey ?? "",
+    ...(provider.config.access.additionalApiKeys ?? []),
+  ];
+  // 旧数据允许主密钥留空；保留槽位才能让删除/确认对应屏幕上的同一行。
+  return keys.some((key) => key.trim()) ? keys : [];
+}
+
+/** Project one row intent onto committed credentials; other input rows never enter the write. */
+export function resolveCredentialRowEdit(
+  provider: ProviderSettingsFormProvider,
+  draftKeys: readonly string[],
+  edit: CredentialRowEdit,
+): {
+  provider: ProviderSettingsFormProvider | null;
+  draftKeys: string[];
+  automatic: boolean;
+} | null {
+  if (!isApiKeyAccess(provider.config.access)) return null;
+  const committed = configuredProviderKeys(provider);
+  const keys = [...committed];
+  const draft = [...draftKeys];
+  let automatic = provider.config.access.autoSwitchCredentials === true;
+  if (edit.kind === "automatic") automatic = edit.value;
+  else {
+    const { index } = edit;
+    if (!Number.isInteger(index) || index < 0 || index >= draft.length) return null;
+    const saved = index < committed.length;
+    if (edit.kind === "confirm") {
+      const value = draft[index]!.trim();
+      if (!value || committed.some((key, i) => key === value && i !== index)) return null;
+      if (saved) {
+        keys[index] = value;
+        draft[index] = value;
+      } else {
+        keys.push(value);
+        draft.splice(index, 1);
+        // Keep saved rows first so confirming a later new row preserves every other draft.
+        draft.splice(committed.length, 0, value);
+      }
+    } else if (edit.kind === "remove") {
+      if (saved) keys.splice(index, 1);
+      draft.splice(index, 1);
+    } else if (edit.kind === "revert") {
+      if (saved) draft[index] = committed[index]!;
+      else draft.splice(index, 1);
+    } else {
+      if (!saved) return null;
+      keys.unshift(...keys.splice(index, 1));
+      draft.unshift(...draft.splice(index, 1));
+    }
+  }
+  automatic = automatic && new Set(keys.map((key) => key.trim()).filter(Boolean)).size >= 2;
+  const credentialChanges = {
+    type: provider.config.access.type,
+    apiKey: keys[0] ?? "",
+    additionalApiKeys: keys.slice(1),
+    autoSwitchCredentials: automatic,
+  };
+  const access = { ...provider.config.access, ...credentialChanges };
+  const localOnly =
+    edit.kind === "revert" || (edit.kind === "remove" && edit.index >= committed.length);
+  const changed = !localOnly && JSON.stringify(access) !== JSON.stringify(provider.config.access);
+  return {
+    provider: changed
+      ? {
+          ...provider,
+          config: { ...provider.config, access },
+          personalConfig: {
+            ...provider.personalConfig,
+            access: { ...provider.personalConfig.access, ...credentialChanges },
+          },
+        }
+      : null,
+    draftKeys: draft.length ? draft : [""],
+    automatic,
+  };
+}
