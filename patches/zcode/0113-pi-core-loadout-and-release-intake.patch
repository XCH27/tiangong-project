@@ -50,6 +50,67 @@ const wireChars = (tools: any[]) =>
     tools.map(({ name, description, inputSchema }) => ({ name, description, inputSchema })),
   ).length;
 
+test("ordinary work keeps essential tools and defers optional planning/history capabilities", async () => {
+  const f = await fixture(undefined, false, { config: { toolAllowlist: undefined } });
+  const fullChars = wireChars(f.runtime.getTools());
+  try {
+    f.steps.push((request) => {
+      const names = request.tools.map((tool: any) => tool.name);
+      for (const name of [
+        "Read",
+        "Write",
+        "Edit",
+        "Bash",
+        "AskUserQuestion",
+        "TodoRead",
+        "TodoWrite",
+        "SearchTools",
+      ])
+        assert.ok(names.includes(name), name);
+      for (const name of [
+        "Agent",
+        "EnterPlanMode",
+        "ExitPlanMode",
+        "ReadSessionContext",
+        "ReadUsageStats",
+      ])
+        assert.ok(!names.includes(name), name);
+      console.log(
+        JSON.stringify({
+          fixture: "ordinary-core",
+          fullChars,
+          initialChars: wireChars(request.tools),
+          initialTools: names.length,
+        }),
+      );
+      assert.ok(wireChars(request.tools) < fullChars * 0.75);
+      return reply("ordinary task complete");
+    });
+    assert.equal(
+      (await f.runtime.executeTurn("Explain a document task")).response,
+      "ordinary task complete",
+    );
+    assert.equal(f.requests.length, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("active plan mode retains its original exit tool without discovery", async () => {
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: undefined, planEnabled: true },
+  });
+  try {
+    f.steps.push((request) => {
+      assert.ok(request.tools.some((tool: any) => tool.name === "ExitPlanMode"));
+      return reply("plan preserved");
+    });
+    await f.runtime.executeTurn("Continue the selected plan mode");
+  } finally {
+    await f.close();
+  }
+});
+
