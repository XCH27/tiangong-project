@@ -0,0 +1,329 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createOpenAICompatible } from "@ai-sdk/openai-compatible";
+import {
+  createGoogleToolSignatureExtractor,
+  googleToolSignatureReplay,
+  googleToolSignatureScope,
+  isOfficialGoogleChatBaseURL,
+  matchesGoogleToolSignatureScope,
+  withGoogleToolSignatureCarrier,
+  type GoogleToolSignatureScope,
+} from "../src/model/google-thought-signatures.js";
+import { withApiCompletionEvidence } from "../src/model/api-completion-evidence.js";
+
+const scope: GoogleToolSignatureScope = {
+  providerId: "account-independent-google-api",
+  modelId: "synthetic-gemini-model",
+  baseURL: "https://generativelanguage.googleapis.com/v1beta/openai/",
+};
+const signature = "synthetic+/signature=\u0000\nopaque";
+const extra = (value = signature) => ({ google: { thought_signature: value } });
+const tool = (id = "same-id", value = signature) => ({
+  id,
+  index: 0,
+  type: "function",
+  function: { name: "Probe", arguments: '{"value":"read-only"}' },
+  extra_content: extra(value),
+});
+const chunk = (calls: unknown[]) => ({ choices: [{ index: 0, delta: { tool_calls: calls } }] });
+const prompt = [{ role: "user" as const, content: [{ type: "text" as const, text: "Probe" }] }];
+const tools = [
+  {
+    type: "function" as const,
+    name: "Probe",
+    inputSchema: { type: "object", properties: { value: { type: "string" } } },
+  },
+];
+const normalizedScope = { ...scope, baseURL: scope.baseURL.slice(0, -1) };
+const content = (providerOptions: any) => [
+  { type: "reasoning" as const, text: "", providerOptions },
+];
+
+function sdkFixture(late: boolean, streaming: boolean, withFinish = true) {
+  const captured: any[] = [];
+  const fetch: typeof globalThis.fetch = async (input, init) => {
+    captured.push(JSON.parse(await new Request(input, init).text()));
+    if (!streaming)
+      return Response.json({
+        choices: [
+          {
+            message: { role: "assistant", content: null, tool_calls: [tool()] },
+            finish_reason: withFinish ? "tool_calls" : null,
+          },
+        ],
+      });
+    const first = tool();
+    if (late) delete (first as any).extra_content;
+    const frames = [chunk([first])];
+    if (late)
+      frames.push(chunk([{ index: 0, function: { arguments: "" }, extra_content: extra() }]));
+    if (withFinish)
+      frames.push({ choices: [{ index: 0, delta: {}, finish_reason: "tool_calls" }] } as never);
+    return new Response(
+      frames.map((frame) => `data: ${JSON.stringify(frame)}\n\n`).join("") + "data: [DONE]\n\n",
+      { headers: { "content-type": "text/event-stream" } },
+    );
+  };
+  const provider = createOpenAICompatible({
+    name: "custom-google-alias",
+    baseURL: scope.baseURL,
+    apiKey: "synthetic-unused-key",
+    fetch,
+    metadataExtractor: createGoogleToolSignatureExtractor(scope),
+  });
+  const model = withGoogleToolSignatureCarrier(
+    withApiCompletionEvidence(provider(scope.modelId), "chat-completions"),
+    scope,
+  );
+  return { model, captured };
+}
+
+test("official route is exact; aliases, proxies, native Google routes and URL credentials cannot qualify", () => {
+  assert.equal(isOfficialGoogleChatBaseURL(scope.baseURL), true);
+  assert.equal(isOfficialGoogleChatBaseURL(normalizedScope.baseURL), true);
+  for (const baseURL of [
+    "https://proxy.example/v1beta/openai",
+    "https://generativelanguage.googleapis.com.evil/v1beta/openai",
+    "http://generativelanguage.googleapis.com/v1beta/openai",
+    "https://generativelanguage.googleapis.com/v1beta",
+    "https://generativelanguage.googleapis.com/v1beta/openai?key=secret",
+    "https://user@generativelanguage.googleapis.com/v1beta/openai",
+  ]) {
+    assert.equal(isOfficialGoogleChatBaseURL(baseURL), false, baseURL);
+    assert.throws(
+      () => createGoogleToolSignatureExtractor({ ...scope, baseURL }),
+      /official Chat route/,
+    );
+  }
+  assert.throws(() => createGoogleToolSignatureExtractor({ ...scope, modelId: "" }), /bound model/);
+});
+
+test("nonstream signatures keep original bytes and remain isolated to each response", async () => {
+  const extractor = createGoogleToolSignatureExtractor(scope);
+  const metadata = await extractor.extractMetadata({
+    parsedBody: { choices: [{ message: { tool_calls: [tool()] } }] },
+  });
+  assert.deepEqual(googleToolSignatureScope(metadata), normalizedScope);
+  assert.equal(googleToolSignatureReplay(content(metadata), scope)?.get("same-id"), signature);
+  const next = await extractor.extractMetadata({
+    parsedBody: {
+      choices: [{ message: { tool_calls: [tool("same-id", "another-assistant-signature")] } }],
+    },
+  });
+  assert.equal(
+    googleToolSignatureReplay(content(next), scope)?.get("same-id"),
+    "another-assistant-signature",
+  );
+  assert.equal(googleToolSignatureReplay(content(metadata), scope)?.get("same-id"), signature);
+});
+
+test("signature may arrive before identity or after name; parallel unsigned calls never borrow it", () => {
+  const current = createGoogleToolSignatureExtractor(scope).createStreamExtractor();
+  current.processChunk(chunk([{ index: 0, function: { arguments: "" }, extra_content: extra() }]));
+  current.processChunk(
+    chunk([
+      { index: 0, id: "first", function: { name: "Probe", arguments: "{}" } },
+      { index: 1, id: "second", function: { name: "Probe", arguments: "{}" } },
+    ]),
+  );
+  current.processChunk(
+    chunk([{ index: 1, function: { arguments: "" }, extra_content: extra("second-signature") }]),
+  );
+  const replay = googleToolSignatureReplay(content(current.buildMetadata()), scope);
+  assert.deepEqual(
+    [...replay!],
+    [
+      ["first", signature],
+      ["second", "second-signature"],
+    ],
+  );
+  const unsigned = createGoogleToolSignatureExtractor(scope).createStreamExtractor();
+  unsigned.processChunk(
+    chunk([
+      tool("first"),
+      { index: 1, id: "second", function: { name: "Probe", arguments: "{}" } },
+    ]),
+  );
+  assert.deepEqual(
+    [...googleToolSignatureReplay(content(unsigned.buildMetadata()), scope)!],
+    [["first", signature]],
+  );
+});
+
+test("stream collectors do not retain signatures when upstream ids recur in another response", () => {
+  const extractor = createGoogleToolSignatureExtractor(scope);
+  const first = extractor.createStreamExtractor();
+  first.processChunk(chunk([tool()]));
+  const second = extractor.createStreamExtractor();
+  second.processChunk(chunk([tool("same-id", "new-signature")]));
+  assert.equal(
+    googleToolSignatureReplay(content(first.buildMetadata()), scope)?.get("same-id"),
+    signature,
+  );
+  assert.equal(
+    googleToolSignatureReplay(content(second.buildMetadata()), scope)?.get("same-id"),
+    "new-signature",
+  );
+});
+
+for (const contradictory of [
+  { index: 0, id: "replacement" },
+  { index: 1, id: "same-id" },
+  { index: 0, extra_content: extra("different-signature") },
+])
+  test(`contradictory association fails: ${JSON.stringify(contradictory)}`, () => {
+    const current = createGoogleToolSignatureExtractor(scope).createStreamExtractor();
+    current.processChunk(chunk([tool()]));
+    assert.throws(
+      () => current.processChunk(chunk([contradictory])),
+      /contradictory|changed identity/,
+    );
+  });
+
+test("an orphan, ambiguous or malformed signature is not guessed or concatenated", () => {
+  for (const calls of [
+    [{ extra_content: extra() }],
+    [{ index: 0, extra_content: { google: { thought_signature: 123 } } }],
+    [{ index: -1, id: "bad", extra_content: extra() }],
+  ])
+    assert.throws(
+      () =>
+        createGoogleToolSignatureExtractor(scope)
+          .createStreamExtractor()
+          .processChunk(chunk(calls)),
+      /Google/,
+    );
+  const orphan = createGoogleToolSignatureExtractor(scope).createStreamExtractor();
+  orphan.processChunk(chunk([{ index: 0, extra_content: extra() }]));
+  assert.throws(() => orphan.buildMetadata(), /completed tool identity/);
+});
+
+test("foreign model/provider/proxy/missing scope or metadata never replays an opaque signature", async () => {
+  const metadata = await createGoogleToolSignatureExtractor(scope).extractMetadata({
+    parsedBody: { choices: [{ message: { tool_calls: [tool()] } }] },
+  });
+  for (const target of [
+    undefined,
+    { ...scope, modelId: "foreign-model" },
+    { ...scope, providerId: "foreign-provider" },
+    { ...scope, baseURL: "https://proxy.example/v1beta/openai" },
+  ]) {
+    assert.equal(matchesGoogleToolSignatureScope(metadata, target), false);
+    assert.equal(googleToolSignatureReplay(content(metadata), target), undefined);
+  }
+  assert.equal(
+    googleToolSignatureReplay(
+      content({
+        fleetGoogle: { serializedToolSignatures: '[{"id":"same-id","signature":"unscoped"}]' },
+      }),
+      scope,
+    ),
+    undefined,
+  );
+  assert.equal(googleToolSignatureReplay(content(undefined), scope), undefined);
+});
+
+for (const [streaming, late] of [
+  [false, false],
+  [true, false],
+  [true, true],
+]) {
+  test(`installed SDK + public V3 carrier: ${streaming ? (late ? "late streaming" : "first streaming") : "nonstream"}`, async () => {
+    const f = sdkFixture(late!, streaming!);
+    let opaque: any;
+    let metadata: any;
+    if (!streaming) {
+      const response = await f.model.doGenerate({ prompt, tools });
+      opaque = response.content.find(
+        (part) => part.type === "reasoning" && part.text === "",
+      )?.providerMetadata;
+      metadata = response.providerMetadata;
+    } else {
+      const response = await f.model.doStream({ prompt, tools });
+      const events = [];
+      for await (const event of response.stream) events.push(event);
+      const carrierEvent = events.find(
+        (event) => event.type === "reasoning-end" && event.id === "fleet-google-tool-signatures",
+      );
+      opaque =
+        carrierEvent && "providerMetadata" in carrierEvent
+          ? carrierEvent.providerMetadata
+          : undefined;
+      metadata = events.find((event) => event.type === "finish")?.providerMetadata;
+      assert.equal(
+        events.filter(
+          (event) => event.type === "reasoning-end" && event.id === "fleet-google-tool-signatures",
+        ).length,
+        1,
+      );
+      assert.ok(
+        events.findIndex((event) => event.type === "tool-call") <
+          events.findIndex((event) => event === carrierEvent),
+        "carrier follows complete tool input",
+      );
+    }
+    assert.ok(opaque, "alias-independent opaque carrier");
+    assert.equal(metadata?.fleetGoogle, undefined, "accounting has no duplicate opaque carrier");
+    const replay = googleToolSignatureReplay(content(JSON.parse(JSON.stringify(opaque))), scope);
+    assert.equal(
+      replay?.get("same-id"),
+      signature,
+      "serialized cold carrier preserves original bytes",
+    );
+    // Public SDK serializer requires the fixed Google namespace, regardless of provider alias.
+    const wire: any[] = [];
+    const destination = createOpenAICompatible({
+      name: "another-google-alias",
+      baseURL: scope.baseURL,
+      fetch: async (input, init) => {
+        wire.push(JSON.parse(await new Request(input, init).text()));
+        return Response.json({
+          choices: [{ message: { role: "assistant", content: "done" }, finish_reason: "stop" }],
+        });
+      },
+    });
+    await destination(scope.modelId).doGenerate({
+      prompt: [
+        ...prompt,
+        {
+          role: "assistant",
+          content: [
+            {
+              type: "tool-call",
+              toolCallId: "same-id",
+              toolName: "Probe",
+              input: { value: "read-only" },
+              providerOptions: { google: { thoughtSignature: replay!.get("same-id")! } },
+            },
+          ],
+        },
+      ],
+    });
+    assert.equal(
+      wire[0].messages[1].tool_calls[0].extra_content.google.thought_signature,
+      signature,
+    );
+  });
+}
+
+test("absence of provider completion cannot publish a carrier even when the SDK observed signatures", async () => {
+  const f = sdkFixture(false, true, false);
+  const response = await f.model.doStream({ prompt, tools });
+  const observed: any[] = [];
+  await assert.rejects(async () => {
+    for await (const part of response.stream) observed.push(part);
+  }, /completion evidence/);
+  assert.equal(
+    observed.some((part) => part.id === "fleet-google-tool-signatures"),
+    false,
+  );
+});
+
+test("wrapper cannot bind a carrier to another model", () => {
+  const f = sdkFixture(false, false);
+  assert.throws(
+    () => withGoogleToolSignatureCarrier(f.model, { ...scope, modelId: "other" }),
+    /model scope mismatch/,
+  );
+});
