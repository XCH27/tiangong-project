index 0000000..cc10af4
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/google-thought-signatures.ts
@@ -0,0 +1,319 @@
+import type { MetadataExtractor } from "@ai-sdk/openai-compatible";
+import { wrapLanguageModel, type LanguageModel } from "ai";
+import { ModelErrorCode, ModelProtocolError, type ModelMessageContent } from "@zcode/contracts";
+
+export interface GoogleToolSignatureScope {
+  providerId: string;
+  modelId: string;
+  baseURL: string;
+}
+const NAMESPACE = "fleetGoogle";
+const OFFICIAL_CHAT_BASE = "https://generativelanguage.googleapis.com/v1beta/openai";
+type ApiModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+type Metadata = NonNullable<Awaited<ReturnType<ApiModel["doGenerate"]>>["providerMetadata"]>;
+interface ToolSignature {
+  id: string;
+  signature: string;
+}
+
+/** A model name, alias, proxy path or another Google API is not this protocol route. */
+export function isOfficialGoogleChatBaseURL(baseURL: string): boolean {
+  try {
+    const url = new URL(baseURL);
+    return (
+      url.origin === "https://generativelanguage.googleapis.com" &&
+      url.pathname.replace(/\/$/, "") === "/v1beta/openai" &&
+      !url.username &&
+      !url.password &&
+      !url.search &&
+      !url.hash
+    );
+  } catch {
+    return false;
+  }
+}
+
+function scopeFrom(value: unknown): GoogleToolSignatureScope | undefined {
+  const scoped = record(value);
+  if (
+    typeof scoped?.providerId !== "string" ||
+    !scoped.providerId.trim() ||
+    typeof scoped.modelId !== "string" ||
+    !scoped.modelId.trim() ||
+    typeof scoped.baseURL !== "string" ||
+    !isOfficialGoogleChatBaseURL(scoped.baseURL)
+  )
+    return undefined;
+  return { providerId: scoped.providerId, modelId: scoped.modelId, baseURL: OFFICIAL_CHAT_BASE };
+}
+function requireScope(scope: GoogleToolSignatureScope): GoogleToolSignatureScope {
+  const normalized = scopeFrom(scope);
+  if (!normalized)
+    throw new ModelProtocolError(
+      ModelErrorCode.InvalidModelRequest,
+      "Google tool signatures require a bound model and the official Chat route",
+    );
+  return normalized;
+}
+export function googleToolSignatureScope(metadata: unknown): GoogleToolSignatureScope | undefined {
+  return scopeFrom(record(metadata)?.[NAMESPACE]);
+}
+export function matchesGoogleToolSignatureScope(
+  metadata: unknown,
+  target: GoogleToolSignatureScope | undefined,
+): boolean {
+  const source = googleToolSignatureScope(metadata);
+  const destination = scopeFrom(target);
+  return (
+    !!source &&
+    !!destination &&
+    source.providerId === destination.providerId &&
+    source.modelId === destination.modelId &&
+    source.baseURL === destination.baseURL
+  );
+}
+function invalid(message: string): never {
+  throw new ModelProtocolError(ModelErrorCode.InvalidModelResponse, message);
+}
+
+/** Request-local associations; a reused id in another assistant response starts a fresh collector. */
+function collector(scope: GoogleToolSignatureScope) {
+  const byIndex = new Map<number, { id?: string; signature?: string }>();
+  const indexById = new Map<string, number>();
+  const ingest = (tool: unknown, position?: number) => {
+    const item = record(tool);
+    if (!item) invalid("Invalid Google tool signature association");
+    const id = item.id;
+    if (id !== undefined && id !== null && (typeof id !== "string" || !id))
+      invalid("Invalid Google tool signature id");
+    const declaredIndex = position ?? item.index;
+    if (
+      declaredIndex !== undefined &&
+      (typeof declaredIndex !== "number" ||
+        !Number.isSafeInteger(declaredIndex) ||
+        declaredIndex < 0)
+    )
+      invalid("Invalid Google tool signature index");
+    const google = record(record(item.extra_content)?.google);
+    const signature = google?.thought_signature;
+    if (
+      signature !== undefined &&
+      signature !== null &&
+      (typeof signature !== "string" || !signature)
+    )
+      invalid("Invalid Google thought signature");
+    const knownIndex = typeof id === "string" ? indexById.get(id) : undefined;
+    const index =
+      declaredIndex ??
+      knownIndex ??
+      (typeof id === "string" ? Math.max(-1, ...byIndex.keys()) + 1 : undefined);
+    if (index === undefined) invalid("Google tool signature delta has no unambiguous identity");
+    if (knownIndex !== undefined && knownIndex !== index)
+      invalid("Google tool signature id belongs to contradictory indexes");
+    const previous = byIndex.get(index) ?? {};
+    if (typeof id === "string" && previous.id && previous.id !== id)
+      invalid("Google tool signature index changed identity");
+    if (typeof signature === "string" && previous.signature && previous.signature !== signature)
+      invalid("Google tool call returned contradictory signatures");
+    const next = {
+      id: typeof id === "string" ? id : previous.id,
+      signature: typeof signature === "string" ? signature : previous.signature,
+    };
+    byIndex.set(index, next);
+    if (next.id) indexById.set(next.id, index);
+  };
+  return {
+    process(value: unknown, streaming: boolean) {
+      const choices = record(value)?.choices;
+      const choice = Array.isArray(choices) ? record(choices[0]) : undefined;
+      const calls = record(choice?.[streaming ? "delta" : "message"])?.tool_calls;
+      if (calls === undefined || calls === null) return;
+      if (!Array.isArray(calls)) invalid("Invalid Google tool signature call batch");
+      calls.forEach((tool, position) => ingest(tool, streaming ? undefined : position));
+    },
+    metadata(): Metadata | undefined {
+      const signatures: ToolSignature[] = [];
+      for (const item of byIndex.values()) {
+        if (!item.signature) continue;
+        if (!item.id) invalid("Google thought signature has no completed tool identity");
+        signatures.push({ id: item.id, signature: item.signature });
+      }
+      return signatures.length
+        ? {
+            [NAMESPACE]: { ...scope, serializedToolSignatures: JSON.stringify(signatures) },
+          }
+        : undefined;
+    },
+  };
+}
+
+export function createGoogleToolSignatureExtractor(
+  scope: GoogleToolSignatureScope,
+): MetadataExtractor {
+  const bound = requireScope(scope);
+  return {
+    async extractMetadata({ parsedBody }) {
+      const current = collector(bound);
+      current.process(parsedBody, false);
+      return current.metadata();
+    },
+    createStreamExtractor() {
+      const current = collector(bound);
+      return {
+        processChunk: (chunk) => current.process(chunk, true),
+        buildMetadata: () => current.metadata(),
+      };
+    },
+  };
+}
+
+function signaturesFrom(metadata: unknown, scope: GoogleToolSignatureScope): ToolSignature[] {
+  if (!matchesGoogleToolSignatureScope(metadata, scope)) return [];
+  const serialized = record(record(metadata)?.[NAMESPACE])?.serializedToolSignatures;
+  if (typeof serialized !== "string") invalid("Missing Google tool signature carrier");
+  let values: unknown;
+  try {
+    values = JSON.parse(serialized);
+  } catch {
+    invalid("Invalid Google tool signature carrier");
+  }
+  if (
+    !Array.isArray(values) ||
+    !values.every((value) => {
+      const item = record(value);
+      return (
+        typeof item?.id === "string" &&
+        item.id.length > 0 &&
+        typeof item.signature === "string" &&
+        item.signature.length > 0
+      );
+    })
+  )
+    invalid("Invalid Google tool signature carrier");
+  return values as ToolSignature[];
+}
+function withoutCarrier(metadata: Metadata | undefined): Metadata | undefined {
+  if (!metadata || !(NAMESPACE in metadata)) return metadata;
+  const { [NAMESPACE]: _carrier, ...remaining } = metadata;
+  return remaining;
+}
+function carrier(
+  metadata: Metadata | undefined,
+  scope: GoogleToolSignatureScope,
+): Metadata | undefined {
+  const values = signaturesFrom(metadata, scope);
+  if (!values.length) return undefined;
+  const byId = new Map<string, string>();
+  for (const { id, signature } of values) {
+    if (byId.has(id) && byId.get(id) !== signature)
+      invalid("Contradictory Google signature carrier");
+    byId.set(id, signature);
+  }
+  return {
+    [NAMESPACE]: {
+      ...scope,
+      serializedToolSignatures: JSON.stringify(
+        [...byId].map(([id, signature]) => ({ id, signature })),
+      ),
+    },
+  };
+}
+
+/** The existing assistant reasoning part is the sole durable opaque replay carrier. */
+export function withGoogleToolSignatureCarrier(
+  model: ApiModel,
+  scope: GoogleToolSignatureScope,
+): ApiModel {
+  const bound = requireScope(scope);
+  if (model.modelId !== bound.modelId)
+    throw new ModelProtocolError(
+      ModelErrorCode.InvalidModelRequest,
+      "Google signature model scope mismatch",
+    );
+  const assertCompleted = (reason: Awaited<ReturnType<ApiModel["doGenerate"]>>["finishReason"]) => {
+    if (
+      !reason.raw?.trim() ||
+      reason.raw.trim().toLowerCase() === "error" ||
+      reason.unified === "error"
+    )
+      invalid("Google Chat signature carrier requires provider completion evidence");
+  };
+  return wrapLanguageModel({
+    model,
+    middleware: {
+      specificationVersion: "v3",
+      async wrapGenerate({ doGenerate }) {
+        const result = await doGenerate();
+        assertCompleted(result.finishReason);
+        const opaque = carrier(result.providerMetadata, bound);
+        return {
+          ...result,
+          providerMetadata: withoutCarrier(result.providerMetadata),
+          content: [
+            ...result.content,
+            ...(opaque ? [{ type: "reasoning" as const, text: "", providerMetadata: opaque }] : []),
+          ],
+        };
+      },
+      async wrapStream({ doStream }) {
+        const result = await doStream();
+        let failed = false;
+        return {
+          ...result,
+          stream: result.stream.pipeThrough(
+            new TransformStream({
+              transform(part, controller) {
+                if (part.type === "error") failed = true;
+                if (part.type !== "finish") {
+                  controller.enqueue(part);
+                  return;
+                }
+                if (!failed) assertCompleted(part.finishReason);
+                const opaque = failed ? undefined : carrier(part.providerMetadata, bound);
+                if (opaque) {
+                  controller.enqueue({
+                    type: "reasoning-start",
+                    id: "fleet-google-tool-signatures",
+                  });
+                  controller.enqueue({
+                    type: "reasoning-end",
+                    id: "fleet-google-tool-signatures",
+                    providerMetadata: opaque,
+                  });
+                }
+                controller.enqueue({
+                  ...part,
+                  providerMetadata: withoutCarrier(part.providerMetadata),
+                });
+              },
+            }),
+          ),
+        };
+      },
+    },
+  });
+}
+
+/** Only this assistant batch and its exact producing route/model may replay these signatures. */
+export function googleToolSignatureReplay(
+  content: ModelMessageContent,
+  target: GoogleToolSignatureScope | undefined,
+): ReadonlyMap<string, string> | undefined {
+  const bound = scopeFrom(target);
+  if (!Array.isArray(content) || !bound) return undefined;
+  const signatures = new Map<string, string>();
+  for (const block of content) {
+    if (block.type !== "reasoning") continue;
+    for (const { id, signature } of signaturesFrom(block.providerOptions, bound)) {
+      if (signatures.has(id) && signatures.get(id) !== signature)
+        invalid("Contradictory Google signature carrier in assistant batch");
+      signatures.set(id, signature);
+    }
+  }
+  return signatures.size ? signatures : undefined;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/message-content-transforms.ts b/apps/zcode-cli/packages/adapters/src/model/message-content-transforms.ts
