+/** Same official service, legacy root alias; never rewrite a proxy or a saved URL. */
+export function normalizeOpenRouterApiBaseUrl(baseUrl: string): string {
+  try {
+    const url = new URL(baseUrl);
+    if (
+      url.origin === "https://openrouter.ai" &&
+      !url.username &&
+      !url.password &&
+      /^\/api\/?$/.test(url.pathname) &&
+      !url.search &&
+      !url.hash
+    ) {
+      url.pathname = "/api/v1";
+      return url.href;
+    }
+  } catch {
+    /* The existing provider validator owns invalid addresses. */
+  }
+  return baseUrl;
+}
+
+export function isOpenRouterApiBaseUrl(baseUrl: string | null | undefined): boolean {
