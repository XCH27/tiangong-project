diff --git a/apps/zcode-cli/packages/adapters/src/model/openrouter-reasoning.ts b/apps/zcode-cli/packages/adapters/src/model/openrouter-reasoning.ts
new file mode 100644
index 0000000..7f0da0b
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/openrouter-reasoning.ts
@@ -0,0 +1,170 @@
+import type { MetadataExtractor } from "@ai-sdk/openai-compatible";
+import type { LanguageModel } from "ai";
+import { ModelErrorCode, ModelProtocolError, type ModelMessageContent } from "@zcode/contracts";
+
+export interface OpenRouterReasoningScope {
+  providerId: string;
+  modelId: string;
+}
+const NAMESPACE = "fleetOpenRouter";
+type SdkModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+type SdkMetadata = NonNullable<Awaited<ReturnType<SdkModel["doGenerate"]>>["providerMetadata"]>;
+type Detail = SdkMetadata[string] & { type: string };
+
+export function createOpenRouterReasoningExtractor(
+  scope: OpenRouterReasoningScope,
+): MetadataExtractor {
+  const metadata = (details: Detail[]) =>
+    details.length
+      ? {
+          [NAMESPACE]: {
+            providerId: scope.providerId,
+            modelId: scope.modelId,
+            serializedDetails: JSON.stringify(details),
+          },
+        }
+      : undefined;
+  return {
+    async extractMetadata({ parsedBody }) {
+      return metadata(readDetails(record(choice(parsedBody)?.message)?.reasoning_details));
+    },
+    createStreamExtractor() {
+      const details: Detail[] = [];
+      return {
+        processChunk(value) {
+          for (const detail of readDetails(record(choice(value)?.delta)?.reasoning_details)) {
+            const last = details.at(-1);
+            // 只合并同一逻辑块的连续文本 delta；不同 id/index/格式或不透明 encrypted 块保持顺序。
+            const field =
+              detail.type === "reasoning.text"
+                ? "text"
+                : detail.type === "reasoning.summary"
+                  ? "summary"
+                  : undefined;
+            if (
+              field &&
+              last?.type === detail.type &&
+              ["id", "index", "format"].every((key) => last[key] === detail[key]) &&
+              (!last.signature || !detail.signature || last.signature === detail.signature)
+            ) {
+              last[field] = String(last[field]) + String(detail[field]);
+              if (!last.signature && detail.signature !== undefined)
+                last.signature = detail.signature;
+            } else details.push({ ...detail });
+          }
+        },
+        buildMetadata: () => metadata(details),
+      };
+    },
+  };
+}
+
+export function openRouterScope(metadata: unknown): OpenRouterReasoningScope | undefined {
+  const scoped = record(record(metadata)?.[NAMESPACE]);
+  return typeof scoped?.providerId === "string" && typeof scoped.modelId === "string"
+    ? { providerId: scoped.providerId, modelId: scoped.modelId }
+    : undefined;
+}
+
+export function matchesOpenRouterScope(
+  metadata: unknown,
+  target: OpenRouterReasoningScope | undefined,
+): boolean {
+  const scope = openRouterScope(metadata);
+  return (
+    !!scope &&
+    !!target &&
+    scope.providerId === target.providerId &&
+    scope.modelId === target.modelId
+  );
+}
+
+export function scopedOpenRouterMetadata(
+  scope: OpenRouterReasoningScope,
+  metadata?: SdkMetadata,
+): SdkMetadata {
+  return { ...metadata, [NAMESPACE]: { ...metadata?.[NAMESPACE], ...scope } };
+}
+
+/** Completed details have one durable home: the existing assistant reasoning part. */
+export function takeOpenRouterDetails(metadata: SdkMetadata | undefined): SdkMetadata | undefined {
+  const details = metadata?.[NAMESPACE];
+  if (typeof details?.serializedDetails !== "string") return undefined;
+  const parsed = readDetails(JSON.parse(details.serializedDetails));
+  if (!parsed.length) return undefined;
+  return { [NAMESPACE]: { ...details } };
+}
+
+export function withoutOpenRouterDetails(
+  metadata: SdkMetadata | undefined,
+): SdkMetadata | undefined {
+  if (!metadata || !(NAMESPACE in metadata)) return metadata;
+  const { [NAMESPACE]: _details, ...remaining } = metadata;
+  return remaining;
+}
+
+export function openRouterReplayDetails(
+  content: ModelMessageContent,
+  target: OpenRouterReasoningScope | undefined,
+) {
+  if (!Array.isArray(content) || !target) return undefined;
+  const details = content
+    .filter(
+      (block) =>
+        block.type === "reasoning" && matchesOpenRouterScope(block.providerOptions, target),
+    )
+    .flatMap((block) => {
+      const serialized = record(
+        record(block.type === "reasoning" ? block.providerOptions : undefined)?.[NAMESPACE],
+      )?.serializedDetails;
+      return typeof serialized === "string" ? readDetails(JSON.parse(serialized)) : [];
+    });
+  return details.length ? details : undefined;
+}
+
+function readDetails(value: unknown): Detail[] {
+  if (value === undefined || value === null) return [];
+  if (
+    !Array.isArray(value) ||
+    !value.every((entry) => {
+      const item = record(entry);
+      if (!item) return false;
+      const field =
+        item.type === "reasoning.text"
+          ? "text"
+          : item.type === "reasoning.summary"
+            ? "summary"
+            : item.type === "reasoning.encrypted"
+              ? "data"
+              : undefined;
+      return (
+        field &&
+        typeof item[field] === "string" &&
+        (item.id === undefined || item.id === null || typeof item.id === "string") &&
+        (item.format === undefined || typeof item.format === "string") &&
+        (item.index === undefined ||
+          (typeof item.index === "number" &&
+            Number.isSafeInteger(item.index) &&
+            item.index >= 0)) &&
+        (item.signature === undefined ||
+          item.signature === null ||
+          typeof item.signature === "string")
+      );
+    })
+  )
+    throw new ModelProtocolError(
+      ModelErrorCode.InvalidModelResponse,
+      "Invalid OpenRouter reasoning_details",
+    );
+  return value as Detail[];
+}
+
+function choice(value: unknown): Record<string, unknown> | undefined {
+  const choices = record(value)?.choices;
+  return Array.isArray(choices) ? record(choices[0]) : undefined;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/provider-usage-observation.ts b/apps/zcode-cli/packages/adapters/src/model/provider-usage-observation.ts
new file mode 100644
index 0000000..ce7816b
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/provider-usage-observation.ts
@@ -0,0 +1,205 @@
+import type { MetadataExtractor } from "@ai-sdk/openai-compatible";
+import type { LanguageModel } from "ai";
+import type { ModelUsage } from "@zcode/contracts";
+
+type ApiModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+type SdkUsage = Awaited<ReturnType<ApiModel["doGenerate"]>>["usage"];
+type Metadata = NonNullable<Awaited<ReturnType<ApiModel["doGenerate"]>>["providerMetadata"]>;
+export interface UsageObservationScope {
+  providerId: string;
+  modelId: string;
+  protocol: "chat-completions" | "responses" | "messages";
+  billingProvider?: string;
+  authKind?: string;
+}
+const NAMESPACE = "fleetProviderUsage";
+
+/** The SDK parser owns framing; its public raw metadata callback retains only reported usage. */
+export function withProviderUsageExtractor(
+  extractor: MetadataExtractor | undefined,
+  scope: UsageObservationScope,
+): MetadataExtractor {
+  const metadata = (raw: unknown): Metadata | undefined => {
+    const observed = observation(raw, scope);
+    return observed
+      ? { [NAMESPACE]: { serializedUsage: JSON.stringify(safeUsage(raw, scope)), ...scope } }
+      : undefined;
+  };
+  return {
+    async extractMetadata({ parsedBody }) {
+      const raw = record(parsedBody)?.usage;
+      try {
+        return { ...(await extractor?.extractMetadata({ parsedBody })), ...metadata(raw) };
+      } catch (error) {
+        throw attachUsageObservation(error, observation(raw, scope));
+      }
+    },
+    createStreamExtractor() {
+      const current = extractor?.createStreamExtractor();
+      let raw: unknown;
+      return {
+        processChunk(value) {
+          const reported = record(value)?.usage;
+          if (observation(reported, scope)) raw = reported;
+          try {
+            current?.processChunk(value);
+          } catch (error) {
+            throw attachUsageObservation(error, observation(raw, scope));
+          }
+        },
+        buildMetadata() {
+          try {
+            return { ...current?.buildMetadata(), ...metadata(raw) };
+          } catch (error) {
+            throw attachUsageObservation(error, observation(raw, scope));
+          }
+        },
+      };
+    },
+  };
+}
+
+export function attachSdkUsageObservation(
+  error: unknown,
+  usage: SdkUsage | undefined,
+  metadata: Metadata | undefined,
+  scope: UsageObservationScope,
+  native?: unknown,
+) {
+  const retained = record(metadata?.[NAMESPACE]);
+  const raw =
+    native ??
+    (typeof retained?.serializedUsage === "string"
+      ? JSON.parse(retained.serializedUsage)
+      : usage?.raw);
+  return attachUsageObservation(error, observation(raw, scope, metadata));
+}
+
+export function withReportedCostMetadata(
+  metadata: Metadata | undefined,
+  scope: UsageObservationScope,
+): Metadata | undefined {
+  const retained = record(metadata?.[NAMESPACE]);
+  if (typeof retained?.serializedUsage !== "string") return metadata;
+  const known = observation(JSON.parse(retained.serializedUsage), scope);
+  return known
+    ? {
+        ...metadata,
+        fleetAccounting: {
+          ...record(metadata?.fleetAccounting),
+          ...known.providerMetadata.fleetAccounting,
+        },
+      }
+    : metadata;
+}
+
+function safeUsage(raw: unknown, scope: UsageObservationScope) {
+  const value = record(raw);
+  const safe: Record<string, unknown> = {};
+  for (const key of [
+    "prompt_tokens",
+    "completion_tokens",
+    "input_tokens",
+    "output_tokens",
+    "total_tokens",
+    "cache_read_input_tokens",
+    "cache_creation_input_tokens",
+  ])
+    if (count(value?.[key]) !== undefined) safe[key] = value![key];
+  for (const key of [
+    "prompt_tokens_details",
+    "input_tokens_details",
+    "completion_tokens_details",
+    "output_tokens_details",
+  ]) {
+    const nested = record(value?.[key]);
+    const selected: Record<string, number> = {};
+    for (const field of ["cached_tokens", "cache_write_tokens", "reasoning_tokens"]) {
+      const reported = count(nested?.[field]);
+      if (reported !== undefined) selected[field] = reported;
+    }
+    if (Object.keys(selected).length) safe[key] = selected;
+  }
+  if (
+    scope.billingProvider === "openrouter" &&
+    typeof value?.cost === "number" &&
+    Number.isFinite(value.cost) &&
+    value.cost >= 0
+  )
+    safe.cost = value.cost;
+  return safe;
+}
+
+/** No completion flag or tool output is produced by an accounting-only observation. */
+function attachUsageObservation(error: unknown, value: ReturnType<typeof observation>) {
+  if (error instanceof Error && value) {
+    Object.assign(error, {
+      context: { ...record(record(error)?.context), fleetUsageObservation: value },
+    });
+  }
+  return error;
+}
+
+function observation(raw: unknown, scope: UsageObservationScope, metadata?: Metadata) {
+  const reported = record(raw);
+  if (!reported) return undefined;
+  const input = count(reported.prompt_tokens ?? reported.input_tokens);
+  const output = count(reported.completion_tokens ?? reported.output_tokens);
+  const inputDetails = record(reported.prompt_tokens_details ?? reported.input_tokens_details);
+  const outputDetails = record(
+    reported.completion_tokens_details ?? reported.output_tokens_details,
+  );
+  const cacheRead = count(inputDetails?.cached_tokens ?? reported.cache_read_input_tokens);
+  const cacheWrite = count(
+    inputDetails?.cache_write_tokens ?? reported.cache_creation_input_tokens,
+  );
+  const inputTokens =
+    scope.protocol === "messages" && input !== undefined
+      ? input + (cacheRead ?? 0) + (cacheWrite ?? 0)
+      : input;
+  const usd =
+    scope.billingProvider === "openrouter" &&
+    typeof reported.cost === "number" &&
+    Number.isFinite(reported.cost) &&
+    reported.cost >= 0
+      ? reported.cost
+      : undefined;
+  const usage: ModelUsage = {
+    inputTokens,
+    outputTokens: output,
+    totalTokens: count(reported.total_tokens),
+    cacheReadTokens: cacheRead,
+    cacheWriteTokens: cacheWrite,
+    reasoningTokens: count(outputDetails?.reasoning_tokens),
+  };
+  if (Object.values(usage).every((value) => value === undefined) && usd === undefined)
+    return undefined;
+  const {
+    fleetOpenRouter: _router,
+    fleetGoogle: _google,
+    [NAMESPACE]: _raw,
+    ...remaining
+  } = metadata ?? {};
+  return {
+    providerId: scope.providerId,
+    modelId: scope.modelId,
+    usage,
+    providerMetadata: {
+      ...remaining,
+      fleetAccounting: {
+        ...record(remaining.fleetAccounting),
+        ...(scope.billingProvider ? { billingProvider: scope.billingProvider } : {}),
+        ...(scope.authKind ? { authKind: scope.authKind } : {}),
+        ...(usd !== undefined ? { reportedRequestUsd: usd } : {}),
+      },
+    },
+  };
+}
+function count(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
