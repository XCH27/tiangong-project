--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/api-completion-evidence.ts
@@ -0,0 +1,211 @@
+import { wrapLanguageModel, type LanguageModel } from "ai";
+import { ModelErrorCode, ModelProtocolError } from "@zcode/contracts";
+import {
+  scopedOpenRouterMetadata,
+  takeOpenRouterDetails,
+  withoutOpenRouterDetails,
+  type OpenRouterReasoningScope,
+} from "./openrouter-reasoning.js";
+import {
+  attachSdkUsageObservation,
+  withReportedCostMetadata,
+  type UsageObservationScope,
+} from "./provider-usage-observation.js";
+
+type ApiModel = Extract<LanguageModel, { specificationVersion: "v3" }>;
+type FinishReason = Awaited<ReturnType<ApiModel["doGenerate"]>>["finishReason"];
+export type CompletionProtocol = "chat-completions" | "responses" | "messages";
+
+/** Completion control is protocol-specific; SDK EOF alone does not settle a Host request. */
+export function withApiCompletionEvidence(
+  model: ApiModel,
+  protocol: CompletionProtocol,
+  scope?: OpenRouterReasoningScope,
+  usageScope?: UsageObservationScope,
+): ApiModel {
+  const observationScope = usageScope ?? {
+    providerId: model.provider,
+    modelId: model.modelId,
+    protocol,
+  };
+  const rejectIncomplete = (): never => {
+    // SDK 的自然 EOF 会合成 finish。只有对应协议的上游完成事实才能授权 Host 后续工具；
+    // 保留 public V3 元数据/usage，不把 raw 调试帧传到 Session 或再解析一次 SSE。
+    throw new ModelProtocolError(
+      ModelErrorCode.InvalidModelResponse,
+      `${protocol} ended without valid provider completion evidence`,
+      {
+        modelId: model.modelId,
+        source: "provider",
+        errorPhase: "parse",
+        exceptionKind: "protocol",
+        retryable: false,
+      },
+    );
+  };
+  const assertFinishReason = (reason: FinishReason | undefined) => {
+    if (
+      typeof reason?.raw !== "string" ||
+      !reason.raw.trim() ||
+      reason.raw.trim().toLowerCase() === "error" ||
+      reason.unified === "error"
+    )
+      rejectIncomplete();
+  };
+  return wrapLanguageModel({
+    model,
+    middleware: {
+      specificationVersion: "v3",
+      async transformParams({ type, params }) {
+        return type === "stream" && protocol === "responses"
+          ? { ...params, includeRawChunks: true }
+          : params;
+      },
+      async wrapGenerate({ doGenerate }) {
+        const result = await doGenerate();
+        try {
+          if (protocol === "responses") {
+            const status = record(result.response?.body)?.status;
+            if (status !== "completed" && status !== "incomplete") rejectIncomplete();
+          } else assertFinishReason(result.finishReason);
+          const providerMetadata = withReportedCostMetadata(
+            result.providerMetadata,
+            observationScope,
+          );
+          if (!scope) return { ...result, providerMetadata };
+          const details = takeOpenRouterDetails(result.providerMetadata);
+          return {
+            ...result,
+            providerMetadata: withoutOpenRouterDetails(providerMetadata),
+            content: [
+              ...result.content.map((part) =>
+                part.type === "reasoning"
+                  ? {
+                      ...part,
+                      providerMetadata: scopedOpenRouterMetadata(scope, part.providerMetadata),
+                    }
+                  : part,
+              ),
+              ...(details
+                ? [{ type: "reasoning" as const, text: "", providerMetadata: details }]
+                : []),
+            ],
+          };
+        } catch (error) {
+          throw attachSdkUsageObservation(
+            error,
+            result.usage,
+            result.providerMetadata,
+            observationScope,
+            record(result.response?.body)?.usage,
+          );
+        }
+      },
+      async wrapStream({ doStream }) {
+        const result = await doStream();
+        let finished = false;
+        let failed = false;
+        let responsesTerminal = false;
+        let responseId: string | undefined;
+        let responseUsage: unknown;
+        return {
+          ...result,
+          stream: result.stream.pipeThrough(
+            new TransformStream({
+              transform(part, controller) {
+                try {
+                  if (protocol === "responses" && part.type === "raw") {
+                    const event = record(part.rawValue);
+                    const response = record(event?.response);
+                    if (response?.usage) responseUsage = response.usage;
+                    if (event?.type === "response.created" && typeof response?.id === "string")
+                      responseId = response.id;
+                    if (
+                      event?.type === "response.completed" ||
+                      event?.type === "response.incomplete"
+                    ) {
+                      const expected =
+                        event.type === "response.completed" ? "completed" : "incomplete";
+                      if (
+                        response?.status !== expected ||
+                        (responseId && response.id !== undefined && response.id !== responseId)
+                      )
+                        rejectIncomplete();
+                      responsesTerminal = true;
+                    }
+                    return; // Only control state is retained; raw payloads remain SDK-private.
+                  }
+                  if (part.type === "error") failed = true;
+                  if (part.type === "finish") {
+                    // 原始 error part 仍由既有错误链处理，不能被完成校验替换。
+                    if (!failed) {
+                      if (protocol === "responses") {
+                        if (!responsesTerminal || part.finishReason.unified === "error")
+                          rejectIncomplete();
+                      } else assertFinishReason(part.finishReason);
+                    }
+                    finished = true;
+                    if (scope && !failed) {
+                      const details = takeOpenRouterDetails(part.providerMetadata);
+                      if (details) {
+                        controller.enqueue({
+                          type: "reasoning-start",
+                          id: "fleet-openrouter-replay",
+                        });
+                        controller.enqueue({
+                          type: "reasoning-end",
+                          id: "fleet-openrouter-replay",
+                          providerMetadata: details,
+                        });
+                      }
+                      controller.enqueue({
+                        ...part,
+                        providerMetadata: withoutOpenRouterDetails(
+                          withReportedCostMetadata(part.providerMetadata, observationScope),
+                        ),
+                      });
+                      return;
+                    }
+                  }
+                  if (
+                    scope &&
+                    (part.type === "reasoning-start" ||
+                      part.type === "reasoning-delta" ||
+                      part.type === "reasoning-end")
+                  ) {
+                    controller.enqueue({
+                      ...part,
+                      providerMetadata: scopedOpenRouterMetadata(
+                        scope,
+                        "providerMetadata" in part ? part.providerMetadata : undefined,
+                      ),
+                    });
+                    return;
+                  }
+                  controller.enqueue(part);
+                } catch (error) {
+                  throw attachSdkUsageObservation(
+                    error,
+                    part.type === "finish" ? part.usage : undefined,
+                    "providerMetadata" in part ? part.providerMetadata : undefined,
+                    observationScope,
+                    responseUsage,
+                  );
+                }
+              },
+              flush() {
+                if (!finished && !failed) rejectIncomplete();
+              },
+            }),
+          ),
+        };
+      },
+    },
+  });
+}
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/google-thought-signatures.ts b/apps/zcode-cli/packages/adapters/src/model/google-thought-signatures.ts
