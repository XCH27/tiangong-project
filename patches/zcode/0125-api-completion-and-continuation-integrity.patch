+++ b/apps/zcode-cli/packages/core/test/openrouter-reasoning-replay.test.ts
@@ -0,0 +1,104 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { AiSdkModelAdapter } from "../../adapters/src/model/runner.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+
+const scope = { providerId: "fixture", modelId: "model-a" };
+const format = "anthropic-claude-v1";
+const details = [
+  { type: "reasoning.text", text: "first second", signature: "signed-text", id: "text-0", index: 0, format },
+  { type: "reasoning.encrypted", data: "opaque-encrypted", id: "encrypted-1", index: 1, format },
+  { type: "reasoning.text", text: "separate", signature: "signed-other", id: "text-2", index: 2, format },
+  { type: "reasoning.text", text: "also separate", signature: "signed-last", id: "text-3", index: 3, format },
+];
+const usage = { prompt_tokens: 11, completion_tokens: 3, total_tokens: 14,
+  prompt_tokens_details: { cached_tokens: 4 }, completion_tokens_details: { reasoning_tokens: 2 } };
+const wireCall = { id: "call", type: "function", function: { name: "Probe", arguments: '{"value":"once"}' } };
+
+function apiModel(transport: typeof fetch, target = scope, baseUrl = "https://openrouter.ai/api") {
+  return new AiSdkModelAdapter({ env: {}, transport, retry: { maxAttempts: 1 } }).createModel({
+    ...target, providerConfig: { access: { type: "api-key", apiKey: "synthetic-key" },
+      api: { type: "openai-chat-completions", baseUrl } } as never,
+    modelConfig: { properties: { contextWindow: 65536, requiresMfjsToolSchema: false,
+      inputFormat: { supportsText: true, supportsImage: false, supportsVideo: false, supportsAudio: false, supportsPdf: false },
+      outputFormat: { supportsText: true }, supportsToolCall: true, supportsJsonSchemaOutput: false,
+      supportsNativeWebSearch: false, supportsMidConversationSystem: true },
+      optionSpecs: { reasoningLevel: { values: ["off"], default: "off", map: "{}" },
+        maxOutputTokens: { max: 256, default: 256, map: "{'max_tokens':maxOutputTokens}" } } } as never,
+    options: { reasoningLevel: "off", maxOutputTokens: 256 },
+  });
+}
+
+for (const streaming of [false, true]) {
+  test(`OpenRouter ${streaming ? "stream fragments" : "JSON"} preserves scoped signed/encrypted tool replay and cold history`, async () => {
+    const f = await fixture(undefined, streaming);
+    const bodies: any[] = [];
+    const transport: typeof fetch = async (raw, init) => {
+      const request = new Request(raw, init);
+      assert.equal(request.url, "https://openrouter.ai/api/v1/chat/completions");
+      const body = await request.json() as any; bodies.push(body);
+      if (bodies.length > 1) {
+        const assistant = body.messages.find((message: any) => message.role === "assistant" && message.tool_calls?.some((call: any) => call.id === "call"));
+        assert.deepEqual(assistant.reasoning_details, details);
+        assert.equal(assistant.reasoning_content, undefined, "Structured replay duplicated plaintext reasoning");
+      }
+      if (!body.stream) return Response.json({ id: "response", created: 1, model: "model-a",
+        choices: [{ index: 0, message: { role: "assistant", content: bodies.length === 1 ? "tool" : "finished",
+          ...(bodies.length === 1 ? { reasoning_content: "displayed thought", reasoning_details: details, tool_calls: [wireCall] } : {}) },
+          finish_reason: bodies.length === 1 ? "tool_calls" : "stop" }], usage });
+      const frame = (delta: unknown, finish_reason: string | null = null, reported?: typeof usage) => ({
+        id: "response", created: 1, model: "model-a", choices: [{ index: 0, delta, finish_reason }], ...(reported ? { usage: reported } : {}),
+      });
+      const frames = bodies.length === 1 ? [
+        frame({ role: "assistant", reasoning_content: "displayed thought", reasoning_details: [
+          { ...details[0], text: "first ", signature: null },
+        ] }),
+        frame({ reasoning_details: [{ ...details[0], text: "second" }, ...details.slice(1)] }),
+        frame({ content: "tool", tool_calls: [{ index: 0, ...wireCall }] }),
+        frame({}, "tool_calls"), frame({ role: "assistant", content: "" }, "tool_calls", usage),
+      ] : [frame({ role: "assistant", content: "finished" }, "stop", usage)];
+      return new Response(frames.map((frame) => `data: ${JSON.stringify(frame)}\n\n`).join("") + "data: [DONE]\n\n",
+        { headers: { "content-type": "text/event-stream" } });
+    };
+    try {
+      (f.runtime as any).modelFactory = () => apiModel(transport);
+      await f.runtime.executeTurn("One scoped fixture effect");
+      assert.equal(f.effects, 1); assert.equal(f.permissionCalls, 1); assert.equal(bodies.length, 2);
+      await f.reopen();
+      (f.runtime as any).modelFactory = () => apiModel(transport);
+      await f.runtime.executeTurn("Continue from cold history");
+      assert.equal(bodies.length, 3); assert.equal(f.effects, 1);
+      const entries = await f.store.messages({ sessionID: "session" as never });
+      const serialized = JSON.stringify(entries);
+      assert.ok(serialized.includes("opaque-encrypted"));
+      assert.ok(serialized.includes("displayed thought"));
+      const metadata = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+      assert.equal(metadata.accounting?.[0]?.requestCount, 3);
+    } finally { await f.close(); }
+  });
+}
+
+for (const target of [
+  { providerId: "other", modelId: "model-a" }, { providerId: "fixture", modelId: "model-b" },
+  { ...scope, baseUrl: "https://proxy.example/v1" },
+]) {
+  test(`OpenRouter opaque/plain reasoning cannot cross ${JSON.stringify(target)}`, async () => {
+    let body: any;
+    const candidate = apiModel(async (raw, init) => {
+      body = await new Request(raw, init).json();
+      return Response.json({ id: "safe", created: 1, model: target.modelId,
+        choices: [{ index: 0, message: { role: "assistant", content: "safe" }, finish_reason: "stop" }], usage });
+    }, target, "baseUrl" in target ? target.baseUrl : undefined);
+    const metadata = { fleetOpenRouter: { ...scope } };
+    await candidate.generateText({ messages: [{ role: "user", content: "initial" },
+      { role: "assistant", providerId: scope.providerId as never, modelId: scope.modelId as never,
+        content: [{ type: "reasoning", text: "private thought", providerOptions: metadata },
+          { type: "reasoning", text: "", providerOptions: { fleetOpenRouter: { ...scope, serializedDetails: JSON.stringify(details) } } },
+          { type: "text", text: "visible answer" }], toolCalls: [{ id: wireCall.id, name: "Probe", input: { value: "once" } }] },
+      { role: "tool", toolCallId: wireCall.id, toolName: "Probe", content: "saved result" },
+    ] });
+    assert.equal(JSON.stringify(body).includes("private thought"), false);
+    assert.equal(JSON.stringify(body).includes("opaque-encrypted"), false);
+    assert.ok(JSON.stringify(body).includes("visible answer"));
+  });
+}
