@@ -0,0 +1,50 @@
+import type { Model, ModelUsage } from "@zcode/contracts";
+
+/** Failed model decoding can still report consumption; this never supplies a completed response. */
+export function readModelErrorUsage(
+  error: unknown,
+  model: Model,
+):
+  | {
+      usage: ModelUsage;
+      providerMetadata?: Record<string, unknown>;
+    }
+  | undefined {
+  const seen = new Set<unknown>();
+  for (
+    let current = record(error), depth = 0;
+    current && depth < 12 && !seen.has(current);
+    depth++
+  ) {
+    seen.add(current);
+    const observed = record(record(current.context)?.fleetUsageObservation);
+    const usage = record(observed?.usage);
+    if (
+      observed?.providerId === String(model.providerId) &&
+      observed.modelId === String(model.modelId) &&
+      usage
+    ) {
+      const known: ModelUsage = {};
+      for (const key of [
+        "inputTokens",
+        "outputTokens",
+        "totalTokens",
+        "cacheReadTokens",
+        "cacheWriteTokens",
+        "reasoningTokens",
+      ] as const) {
+        const value = usage[key];
+        if (typeof value === "number" && Number.isSafeInteger(value) && value >= 0)
+          known[key] = value;
+      }
+      return { usage: known, providerMetadata: record(observed.providerMetadata) };
+    }
+    current = record(current.cause ?? current.lastError ?? current.error);
+  }
+  return undefined;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
