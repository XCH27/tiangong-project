@@ -0,0 +1,258 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { DatabaseSync } from "node:sqlite";
+import { join } from "node:path";
+import { AiSdkModelAdapter } from "../../adapters/src/model/runner.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+
+const usage = { prompt_tokens: 11, completion_tokens: 3, total_tokens: 14,
+  prompt_tokens_details: { cached_tokens: 4 }, completion_tokens_details: { reasoning_tokens: 2 } };
+const call = { index: 0, id: "original-call", type: "function",
+  function: { name: "Probe", arguments: '{"value":"must-not-execute"}' } };
+const frame = (delta: unknown, finish_reason: unknown = null, reported?: typeof usage) => ({
+  id: "fixture", object: "chat.completion.chunk", created: 1, model: "model-a",
+  choices: [{ index: 0, delta, finish_reason }], ...(reported ? { usage: reported } : {}),
+});
+const sse = (frames: unknown[], done = true) => new Response(
+  frames.map((value) => `${typeof value === "string" ? value : `data: ${JSON.stringify(value)}`}\n\n`).join("") +
+  (done ? "data: [DONE]\n\n" : ""), { headers: { "content-type": "text/event-stream" } },
+);
+
+function model(transport: typeof fetch, api = "openai-chat-completions", baseUrl = "https://synthetic.example/v1") {
+  const adapter = new AiSdkModelAdapter({ env: {}, transport, retry: { maxAttempts: 1 } });
+  return adapter.createModel({
+    providerId: "fixture", modelId: "model-a",
+    providerConfig: { access: { type: "api-key", apiKey: "synthetic-key" },
+      api: { type: api, baseUrl } } as never,
+    modelConfig: {
+      properties: { contextWindow: 65536, requiresMfjsToolSchema: false,
+        inputFormat: { supportsText: true, supportsImage: false, supportsAudio: false,
+          supportsVideo: false, supportsPdf: false }, outputFormat: { supportsText: true },
+        supportsToolCall: true, supportsJsonSchemaOutput: false, supportsNativeWebSearch: false,
+        supportsMidConversationSystem: true },
+      optionSpecs: { reasoningLevel: { values: ["off"], default: "off", map: "{}" },
+        maxOutputTokens: { max: 256, default: 256, map: api === "openai-responses"
+          ? "{'max_output_tokens': maxOutputTokens}" : "{'max_tokens': maxOutputTokens}" } },
+    } as never,
+    options: { reasoningLevel: "off", maxOutputTokens: 256 },
+  });
+}
+
+for (const streaming of [false, true]) {
+  for (const failure of ["missing", "empty", "malformed", "error"] as const) {
+    test(`Chat Completions ${streaming ? "stream" : "JSON"} ${failure} completion cannot admit a Host effect`, async () => {
+      const f = await fixture(undefined, streaming);
+      let requests = 0;
+      const candidate = model(async () => {
+        requests++;
+        if (requests > 1) return streaming
+          ? sse([frame({ role: "assistant", content: "safe recovery" }, "stop", usage)])
+          : Response.json({ id: "safe", created: 1, model: "model-a",
+            choices: [{ index: 0, message: { role: "assistant", content: "safe recovery" }, finish_reason: "stop" }], usage });
+        const rawReason = failure === "missing" ? undefined : failure === "empty" ? "" : failure === "malformed" ? 42 : "error";
+        if (!streaming) return Response.json({ id: "unfinished", created: 1, model: "model-a",
+          choices: [{ index: 0, message: { role: "assistant", content: "unfinished",
+            tool_calls: [{ id: call.id, type: call.type, function: call.function }] }, finish_reason: rawReason }] });
+        return sse([frame({ role: "assistant", content: "unfinished", tool_calls: [call] }, rawReason)], false);
+      });
+      try {
+        (f.runtime as any).modelFactory = () => candidate;
+        await f.runtime.executeTurn("Reject unfinished fixture tools").catch(() => {});
+        assert.equal(f.effects, 0, "An unconfirmed completion reached the actual Host handler");
+        assert.equal(f.permissionCalls, 0, "An unconfirmed completion requested effect approval");
+        const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+        try {
+          const receipts = db.prepare("select status, finish_reason, raw_usage_json from model_usage order by started_at, id").all();
+          assert.ok(receipts.length);
+          assert.notEqual(receipts[0]!.status, "completed", "The unfinished physical request became a completed usage fact");
+        } finally { db.close(); }
+        await f.reopen();
+        assert.equal(f.effects, 0, "Cold reopen replayed an unfinished effect");
+      } finally { await f.close(); }
+    });
+  }
+}
+
+test("Chat Completions retains one completion and real counters after a repeated OpenRouter usage-tail finish", async () => {
+  const candidate = model(async () => sse([
+    ": OPENROUTER PROCESSING", frame({ role: "assistant", reasoning_content: "thought" }),
+    frame({ content: "complete" }, "stop"), frame({ content: "", role: "assistant" }, "stop", usage),
+  ]));
+  const events: any[] = [];
+  for await (const event of candidate.streamText({ messages: [{ role: "user", content: "fixture" }] })) events.push(event);
+  const finishes = events.filter((event) => event.type === "finish");
+  assert.equal(finishes.length, 1);
+  assert.equal(finishes[0].providerMetadata.rawFinishReason, "stop");
+  assert.deepEqual(finishes[0].usage, { inputTokens: 11, outputTokens: 3, totalTokens: 14,
+    cacheReadTokens: 4, cacheWriteTokens: undefined, reasoningTokens: 2 });
+  assert.equal(events.filter((event) => event.type === "reasoning_delta").map((event) => event.text).join(""), "thought");
+});
+
+test("Chat Completions preserves a structured mid-stream provider error without tool admission", async () => {
+  const f = await fixture(undefined, true);
+  const candidate = model(async () => sse([
+    frame({ role: "assistant", content: "partial" }),
+    { ...frame({ content: "" }, "error"), error: { code: "context_length_exceeded", message: "Fixture context rejected" } },
+  ]));
+  try {
+    (f.runtime as any).modelFactory = () => candidate;
+    await assert.rejects(f.runtime.executeTurn("Retain the provider failure"), (error: unknown) => {
+      const causes: any[] = [];
+      for (let current = error as any; current; current = current.cause) causes.push(current);
+      assert.ok(causes.some((cause) => cause.providerCode === "context_length_exceeded"));
+      assert.ok(causes.some((cause) => cause.message === "Fixture context rejected"));
+      return true;
+    });
+    assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 0);
+  } finally { await f.close(); }
+});
+
+for (const api of ["openai-responses", "anthropic-messages"]) {
+  for (const streaming of [false, true]) {
+    test(`${api} ${streaming ? "stream" : "JSON"} without its terminal evidence cannot execute a Host tool`, async () => {
+      const f = await fixture(undefined, streaming);
+      let requests = 0;
+      const candidate = model(async () => {
+        requests++;
+        const safe = requests > 1;
+        if (api === "openai-responses") {
+          const output = safe
+            ? [{ type: "message", id: "message", role: "assistant", status: "completed",
+              content: [{ type: "output_text", text: "safe", annotations: [] }] }]
+            : [{ type: "function_call", id: "fc", call_id: call.id, name: "Probe",
+              arguments: call.function.arguments, status: "completed" }];
+          const response = { id: "response", created_at: 1, model: "model-a", output,
+            ...(safe ? { status: "completed", usage: { input_tokens: 11, output_tokens: 3, total_tokens: 14 } } : {}) };
+          if (!streaming) return Response.json(response);
+          return sse([{ type: "response.created", response: { id: "response", created_at: 1, model: "model-a" } },
+            ...(safe ? [{ type: "response.output_item.done", output_index: 0, item: output[0] },
+              { type: "response.completed", response }] : [
+              { type: "response.output_item.added", output_index: 0, item: { ...output[0], arguments: "" } },
+              { type: "response.function_call_arguments.delta", item_id: "fc", output_index: 0, delta: call.function.arguments },
+              { type: "response.output_item.done", output_index: 0, item: output[0] },
+            ])], false);
+        }
+        const content = safe ? [{ type: "text", text: "safe" }]
+          : [{ type: "tool_use", id: call.id, name: "Probe", input: { value: "must-not-execute" } }];
+        const message = { id: "message", type: "message", role: "assistant", model: "model-a", content,
+          usage: { input_tokens: 11, output_tokens: 3 }, ...(safe ? { stop_reason: "end_turn" } : {}) };
+        if (!streaming) return Response.json(message);
+        const frames = [{ type: "message_start", message: { ...message, content: [], usage: { input_tokens: 11, output_tokens: 0 } } },
+          { type: "content_block_start", index: 0, content_block: safe ? { type: "text", text: "" }
+            : { type: "tool_use", id: call.id, name: "Probe", input: {} } },
+          { type: "content_block_delta", index: 0, delta: safe ? { type: "text_delta", text: "safe" }
+            : { type: "input_json_delta", partial_json: call.function.arguments } },
+          { type: "content_block_stop", index: 0 }, ...(safe ? [
+            { type: "message_delta", delta: { stop_reason: "end_turn" }, usage: { output_tokens: 3 } },
+            { type: "message_stop" },
+          ] : [])];
+        return new Response(frames.map((value) => `event: ${value.type}\ndata: ${JSON.stringify(value)}\n\n`).join(""),
+          { headers: { "content-type": "text/event-stream" } });
+      }, api);
+      try {
+        (f.runtime as any).modelFactory = () => candidate;
+        await f.runtime.executeTurn("Reject unconfirmed protocol completion").catch(() => {});
+        assert.equal(f.effects, 0);
+        assert.equal(f.permissionCalls, 0);
+        const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+        try { assert.notEqual(db.prepare("select status from model_usage order by started_at, id limit 1").get()!.status, "completed"); }
+        finally { db.close(); }
+        await f.reopen(); assert.equal(f.effects, 0);
+      } finally { await f.close(); }
+    });
+  }
+}
+
+for (const streaming of [false, true]) {
+  test(`Responses valid incomplete ${streaming ? "stream" : "JSON"} retains output-limit evidence and counters`, async () => {
+    const response = { id: "response", created_at: 1, model: "model-a", status: "incomplete",
+      incomplete_details: { reason: "max_output_tokens" },
+      output: [{ type: "message", id: "message", role: "assistant", status: "incomplete",
+        content: [{ type: "output_text", text: "partial", annotations: [] }] }],
+      usage: { input_tokens: 11, output_tokens: 3, total_tokens: 14 } };
+    const candidate = model(async () => streaming ? sse([
+      { type: "response.created", response: { id: response.id, created_at: 1, model: "model-a" } },
+      { type: "response.output_item.added", output_index: 0, item: response.output[0] },
+      { type: "response.output_text.delta", item_id: "message", delta: "partial" },
+      { type: "response.output_item.done", output_index: 0, item: response.output[0] },
+      { type: "response.incomplete", response },
+    ]) : Response.json(response), "openai-responses");
+    const request = { messages: [{ role: "user" as const, content: "fixture" }] };
+    if (streaming) {
+      const events: any[] = []; for await (const event of candidate.streamText(request)) events.push(event);
+      const finish = events.find((event) => event.type === "finish");
+      assert.equal(finish.finishReason, "length"); assert.equal(finish.usage.inputTokens, 11);
+      assert.equal(events.some((event) => event.type === "raw"), false);
+    } else { const result = await candidate.generateText(request); assert.equal(result.finishReason, "length"); assert.equal(result.usage.inputTokens, 11); }
+  });
+}
+
+test("Chat Completions Stop closes its real local response without completion or effects", async () => {
+  const { createServer } = await import("node:http");
+  const started = Promise.withResolvers<void>();
+  const closed = Promise.withResolvers<void>();
