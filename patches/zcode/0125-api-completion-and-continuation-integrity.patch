+      url.origin === "https://openrouter.ai" &&
+      !url.username &&
+      !url.password &&
+      /^\/api\/v1\/?$/.test(url.pathname) &&
+      !url.search &&
+      !url.hash
+    );
+  } catch {
+    return false;
+  }
