+        choices: [{ index: 0, message: { role: "assistant", content: bodies.length === 1 ? "tool" : "finished",
+          ...(bodies.length === 1 ? { tool_calls: [{ ...call, extra_content: { google: { thought_signature: opaque } } }] } : {}) },
+          finish_reason: bodies.length === 1 ? "tool_calls" : "stop" }], usage });
+      const frame = (delta: unknown, finish_reason: string | null = null, reported?: typeof usage) => ({
+        id: "response", created: 1, model: "model-a", choices: [{ index: 0, delta, finish_reason }], ...(reported ? { usage: reported } : {}),
+      });
+      const frames = bodies.length === 1 ? [
+        frame({ role: "assistant", content: "tool", tool_calls: [{ index: 0, ...call,
+          ...(mode === "first" ? { extra_content: { google: { thought_signature: opaque } } } : {}) }] }),
+        ...(mode === "late" ? [frame({ tool_calls: [{ index: 0, function: { arguments: "" },
+          extra_content: { google: { thought_signature: opaque } } }] })] : []),
+        frame({}, "tool_calls", usage),
+      ] : [frame({ role: "assistant", content: "finished" }, "stop", usage)];
+      return new Response(frames.map((frame) => `data: ${JSON.stringify(frame)}\n\n`).join("") + "data: [DONE]\n\n",
+        { headers: { "content-type": "text/event-stream" } });
+    };
+    try {
+      (f.runtime as any).modelFactory = () => model(transport);
+      await f.runtime.executeTurn("One signature-bound fixture effect");
+      assert.equal(f.effects, 1); assert.equal(f.permissionCalls, 1); assert.equal(bodies.length, 2);
+      await f.reopen(); (f.runtime as any).modelFactory = () => model(transport);
+      await f.runtime.executeTurn("Continue the original signed tool history");
+      assert.equal(f.effects, 1); assert.equal(bodies.length, 3);
+      assert.ok(JSON.stringify(await f.store.messages({ sessionID: "session" as never })).includes(opaque));
+    } finally { await f.close(); }
+  });
+}
+
+for (const target of [ { ...scope, modelId: "model-b" }, { ...scope, providerId: "other" },
+  { ...scope, baseURL: "https://proxy.example/v1" } ]) {
+  test(`Google tool signature cannot cross ${JSON.stringify(target)}`, async () => {
+    let body: any;
+    const candidate = model(async (raw, init) => {
+      body = await new Request(raw, init).json();
+      return Response.json({ id: "safe", created: 1, model: target.modelId,
+        choices: [{ index: 0, message: { role: "assistant", content: "safe" }, finish_reason: "stop" }], usage });
+    }, target);
+    await candidate.generateText({ messages: [{ role: "user", content: "initial" },
+      { role: "assistant", providerId: scope.providerId as never, modelId: scope.modelId as never,
+        content: [{ type: "reasoning", text: "", providerOptions: { fleetGoogle: { ...scope,
+          serializedToolSignatures: JSON.stringify([{ id: call.id, signature: opaque }]) } } }, { type: "text", text: "visible answer" }],
+        toolCalls: [{ id: call.id, name: "Probe", input: { value: "once" } }] },
+      { role: "tool", toolCallId: call.id, toolName: "Probe", content: "saved result" },
+    ] });
+    assert.equal(JSON.stringify(body).includes(opaque), false);
+    assert.equal(body.messages.find((value: any) => value.role === "assistant").tool_calls[0].extra_content, undefined);
+  });
+}
