+    request.resume(); requests++;
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.write(`data: ${JSON.stringify(frame({ role: "assistant", content: "partial" }))}\n\n`);
+    response.on("close", closed.resolve); started.resolve();
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address() as { port: number };
+  const f = await fixture(undefined, true);
+  let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+  try {
+    (f.runtime as any).modelFactory = () => model(fetch, "openai-chat-completions", `http://127.0.0.1:${address.port}/v1`);
+    running = f.runtime.executeTurn("Stop the actual local stream");
+    await started.promise; f.runtime.stopActiveForegroundExecution();
+    await running.catch(() => {}); await closed.promise;
+    assert.equal(requests, 1); assert.equal(f.effects, 0); assert.equal(f.permissionCalls, 0);
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try { assert.notEqual(db.prepare("select status from model_usage limit 1").get()!.status, "completed"); }
+    finally { db.close(); }
+  } finally {
+    f.runtime.stopActiveForegroundExecution(); await running?.catch(() => {}); await f.close();
+    server.closeAllConnections(); await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
+
+for (const failure of ["usage-before-EOF", "completed-invalid-reasoning"] as const) {
+  test(`${failure} retains reported usage/cost as an error without effects or model replay`, async () => {
+    const f = await fixture(undefined, failure === "usage-before-EOF");
+    let requests = 0;
+    const candidate = model(async () => {
+      requests++;
+      if (requests > 1) return sse([frame({ role: "assistant", content: "safe recovery" }, "stop", usage)]);
+      const reported = { ...usage, cost: 0.031 };
+      if (failure === "completed-invalid-reasoning") return Response.json({
+        id: "failed-extraction", created: 1, model: "model-a",
+        choices: [{ index: 0, finish_reason: "tool_calls", message: { role: "assistant", content: "tool",
+          tool_calls: [{ id: call.id, type: call.type, function: call.function }],
+          reasoning_details: [{ type: "reasoning.encrypted", data: 42 }] } }], usage: reported,
+      });
+      return sse([frame({ role: "assistant", content: "unfinished", tool_calls: [call] }),
+        frame({ role: "assistant", content: "" }, null, reported)], false);
+    }, "openai-chat-completions", "https://openrouter.ai/api/v1");
+    try {
+      (f.runtime as any).modelFactory = () => candidate;
+      await f.runtime.executeTurn("Retain reported consumption on protocol failure").catch(() => {});
+      assert.equal(f.effects, 0); assert.equal(f.permissionCalls, 0);
+      const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+      try {
+        const first = db.prepare("select * from model_usage order by started_at, id limit 1").get()!;
+        assert.equal(first.status, "error");
+        assert.equal(first.input_tokens, 11, "Known input disappeared with rejected completion");
+        assert.equal(first.output_tokens, 3);
+        assert.equal(first.cache_read_input_tokens, 4);
+        assert.equal(first.reasoning_tokens, 2);
+        assert.equal(first.provider_total_tokens, 14);
+        const metadata = JSON.parse(String(first.provider_metadata_json));
+        assert.equal(metadata.fleetAccounting.reportedRequestUsd, 0.031);
+        assert.equal(requests, 1, "A terminal protocol failure started another model request");
+      } finally { db.close(); }
+      await f.reopen(); assert.equal(f.effects, 0); assert.equal(requests, 1);
+    } finally { await f.close(); }
+  });
+}
