+    providerName: "Confirmation fixture",
+    templateId: null,
+    enabled: true,
+    executable: true,
+    hasPersonalConfig: true,
+    personalConfig: config,
+    config,
+    models: [],
+  };
+  const draft = {
+    nameValue: provider.providerName!,
+    apiFormat: config.api.type,
+    baseUrlValue: config.api.baseUrl,
+    apiKeyValue: config.access.apiKey,
+    additionalApiKeys: ["", "   "],
+  };
+  const pending = resolvePendingProviderDraftSave({ provider, draft, now: Date.now });
+  assert.equal(pending, null);
+  assert.equal(modelDiscoveryBlockReason(config, pending !== null), undefined);
+  const removal = resolvePendingProviderDraftSave({
+    provider,
+    draft: { ...draft, apiKeyValue: "" },
+    now: Date.now,
+  });
+  assert.ok(removal);
+  assert.equal(removal.config.access?.type, "api-key");
+  assert.equal((removal.config.access as { apiKey: string }).apiKey, "");
+  assert.ok(modelDiscoveryBlockReason(config, removal !== null));
+});
 
