diff --git a/apps/zcode-cli/packages/bootstrap/test/plugin-availability.test.ts b/apps/zcode-cli/packages/bootstrap/test/plugin-availability.test.ts
new file mode 100644
index 0000000..bfd8d61
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/plugin-availability.test.ts
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { createPluginAvailability } from "../src/app/plugin-availability.js";
+import { resolveZCodePlugins, setZCodePluginEnabled } from "../src/plugins.js";
+
+// DOM-02: Settings writes plugin state from a separate management process. A resident Session's
+// check must notice that write through the shared configuration, in both scopes.
+test("a resident Session notices a plugin disabled through the shared configuration", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-plugin-availability-"));
+  try {
+    const workspace = join(root, "workspace");
+    const plugin = join(root, "plugin");
+    const userConfigPath = join(root, "user/config.json");
+    const pluginStorageRoot = join(root, "storage/cli/plugins");
+    for (const dir of [workspace, join(root, "user"), join(plugin, ".zcode-plugin")])
+      await mkdir(dir, { recursive: true });
+    await writeFile(join(plugin, ".zcode-plugin/plugin.json"), JSON.stringify({ name: "shared", version: "1.0.0" }));
+    await writeFile(
+      userConfigPath,
+      JSON.stringify({ storage: { dir: join(root, "storage") }, plugins: { dirs: [plugin] } }),
+    );
+    const paths = { env: {}, officialPluginRoots: [], pluginStorageRoot, userConfigPath, workingDirectory: workspace };
+    const id = resolveZCodePlugins(paths).plugins.find((entry) => entry.name === "shared")!.id;
+    const availability = createPluginAvailability({
+      discover: () => resolveZCodePlugins(paths),
+      pluginStorageRoot,
+      watchedConfigPaths: [userConfigPath, join(workspace, ".zcode", "config.json")],
+    });
+    assert.equal(availability.isWithdrawn(id, workspace), false, "unchanged configuration keeps startup state");
+
+    await setZCodePluginEnabled({ ...paths, enabled: false, plugin: id });
+    assert.equal(availability.isWithdrawn(id, workspace), true, "user-scope disable is seen");
+    await setZCodePluginEnabled({ ...paths, enabled: true, plugin: id });
+    assert.equal(availability.isWithdrawn(id, workspace), false, "re-enable is seen");
+
+    await setZCodePluginEnabled({ ...paths, enabled: false, plugin: id, scope: "workspace" });
+    assert.equal(availability.isWithdrawn(id, workspace), true, "a new Project configuration file is seen");
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
diff --git a/apps/zcode-cli/packages/bootstrap/test/project-plugin-hooks.test.ts b/apps/zcode-cli/packages/bootstrap/test/project-plugin-hooks.test.ts
new file mode 100644
index 0000000..8a59235
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/project-plugin-hooks.test.ts
@@ -0,0 +1,89 @@
+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { resolveZCodePlugins } from "../src/plugins.js";
+
+// DOM-01: a Project's own hook declarations wait for workspace-hook trust. An inline plugin root
+// declared only by the same Project must not run its hooks around that review, while its skills
+// still load. The same folder listed in the user's configuration keeps its hooks.
+async function fixture() {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-project-plugin-hooks-"));
+  const workspace = join(root, "workspace");
+  const plugin = join(root, "project-plugin");
+  const userConfigPath = join(root, "user/config.json");
+  const projectConfigPath = join(workspace, ".zcode/config.json");
+  for (const dir of [
+    join(workspace, ".zcode"),
+    join(root, "user"),
+    join(plugin, ".zcode-plugin"),
+    join(plugin, "hooks"),
+    join(plugin, "skills/fixture"),
+  ])
+    await mkdir(dir, { recursive: true });
+  await writeFile(
+    join(plugin, ".zcode-plugin/plugin.json"),
+    JSON.stringify({ name: "project-plugin", version: "1.0.0", skills: "./skills" }),
+  );
+  await writeFile(
+    join(plugin, "skills/fixture/SKILL.md"),
+    "---\nname: project-fixture\ndescription: Project plugin skill\n---\nBody.",
+  );
+  await writeFile(
+    join(plugin, "hooks/hooks.json"),
+    JSON.stringify({
+      hooks: {
+        UserPromptSubmit: [{ hooks: [{ type: "command", command: "touch marker" }] }],
+      },
+    }),
+  );
+  const resolve = async (userDirs: string[]) => {
+    await writeFile(
+      userConfigPath,
+      JSON.stringify({ storage: { dir: join(root, "storage") }, plugins: { dirs: userDirs } }),
+    );
+    await writeFile(projectConfigPath, JSON.stringify({ plugins: { dirs: [plugin] } }));
+    return resolveZCodePlugins({
+      env: {},
+      officialPluginRoots: [],
+      pluginStorageRoot: join(root, "storage/cli/plugins"),
+      projectConfigPath,
+      userConfigPath,
+      workingDirectory: workspace,
+    });
+  };
+  return { plugin, resolve, close: () => rm(root, { recursive: true, force: true }) };
+}
+
+const hookCount = (hooks: Record<string, Array<{ hooks: unknown[] }> | undefined>) =>
+  Object.values(hooks).reduce((sum, matchers) => sum + (matchers ?? []).reduce((n, m) => n + m.hooks.length, 0), 0);
+
+test("hooks of a plugin declared only by the Project are withheld; its skills still load", async () => {
+  const f = await fixture();
+  try {
+    const outcome = await f.resolve([]);
+    const plugin = outcome.plugins.find((entry) => entry.name === "project-plugin");
+    assert.equal(plugin?.enabled, true);
+    assert.equal(hookCount(outcome.hooks as never), 0, "no runnable hook reaches the runner");
+    assert.ok(outcome.skillRoots.some((root) => root.path.startsWith(f.plugin)));
+    assert.ok(
+      outcome.diagnostics.some(
+        (diagnostic) => diagnostic.code === "plugin_project_hooks_withheld" && diagnostic.pluginId === plugin?.id,
+      ),
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("the same folder declared in the user configuration keeps its hooks", async () => {
+  const f = await fixture();
+  try {
+    const outcome = await f.resolve([f.plugin]);
+    assert.equal(hookCount(outcome.hooks as never), 1);
+    assert.ok(!outcome.diagnostics.some((diagnostic) => diagnostic.code === "plugin_project_hooks_withheld"));
+  } finally {
+    await f.close();
+  }
+});
