diff --git a/apps/zcode-cli/packages/core/test/plugin-hook-withdrawal.test.ts b/apps/zcode-cli/packages/core/test/plugin-hook-withdrawal.test.ts
new file mode 100644
index 0000000..374aced
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/plugin-hook-withdrawal.test.ts
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+// DOM-02: a resident Session keeps its startup plugin outcome. Withdrawing the plugin in Settings
+// must stop its hooks from running in that Session's later turns, without touching other plugins.
+test("a plugin disabled after a Session started no longer runs its hooks in later turns", async () => {
+  const withdrawn = new Set<string>();
+  const commands: string[] = [];
+  const plugin = (id: string) => ({ id, name: id, dataPath: "/tmp/fleet-plugin-data", rootPath: "/tmp/fleet-plugin-root" });
+  const f = await fixture(undefined, false, {
+    config: {
+      hooks: {
+        enabled: true,
+        maxOutputBytes: 10_000,
+        timeoutMs: 5_000,
+        events: {
+          UserPromptSubmit: [
+            {
+              hooks: [
+                { type: "command", command: "withdrawn-plugin-hook", plugin: plugin("gone@market") },
+                { type: "command", command: "kept-plugin-hook", plugin: plugin("kept@market") },
+                { type: "command", command: "user-hook" },
+              ],
+            },
+          ],
+        },
+      },
+    } as never,
+    deps: {
+      executionPort: {
+        async run(request: { command: { command: string } }) {
+          commands.push(request.command.command);
+          return { exitCode: 0, stdout: "", stderr: "", durationMs: 1, truncated: false } as never;
+        },
+      } as never,
+      pluginAvailability: {
+        isWithdrawn: (pluginId: string) => withdrawn.has(pluginId),
+      },
+    },
+  });
+  try {
+    f.steps.push(() => reply("first"));
+    await f.runtime.executeTurn("first turn");
+    assert.deepEqual(commands.sort(), ["kept-plugin-hook", "user-hook", "withdrawn-plugin-hook"]);
+    commands.length = 0;
+    withdrawn.add("gone@market");
+    f.steps.push(() => reply("second"));
+    await f.runtime.executeTurn("second turn");
+    assert.deepEqual(commands.sort(), ["kept-plugin-hook", "user-hook"]);
+  } finally {
+    await f.close();
+  }
+});
