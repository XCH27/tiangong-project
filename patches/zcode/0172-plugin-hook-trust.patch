@@ -0,0 +1,57 @@
+import { statSync } from "node:fs";
+import { join } from "node:path";
+import type { PluginAvailabilityPort } from "@zcode/core";
+import type { Logger, PluginLoadOutcome } from "@zcode/contracts";
+
+/**
+ * Whether a plugin a resident Session started with has since been disabled or uninstalled (DOM-02).
+ * Plugin settings are written by a separate management process, so the shared owner is the plugin
+ * configuration on disk. Each check compares the user/Project configuration and the install record;
+ * only when one changed does it rerun the app's own discovery. A running turn is not interrupted,
+ * nothing is added back to the Session, and a failed rediscovery withholds plugin hooks.
+ */
+export function createPluginAvailability(input: {
+  discover: () => PluginLoadOutcome;
+  logger?: Logger;
+  pluginStorageRoot: string;
+  watchedConfigPaths: Array<string | undefined>;
+}): PluginAvailabilityPort {
+  const watched = [
+    ...input.watchedConfigPaths.filter((path): path is string => Boolean(path)),
+    join(input.pluginStorageRoot, "installed_plugins.json"),
+  ];
+  const signature = () =>
+    watched
+      .map((path) => {
+        try {
+          const stat = statSync(path);
+          return `${stat.mtimeMs}:${stat.size}`;
+        } catch {
+          return "missing";
+        }
+      })
+      .join("|");
+  let seen = signature();
+  let enabled: Set<string> | undefined;
+  return {
+    isWithdrawn(pluginId) {
+      const current = signature();
+      if (current !== seen) {
+        seen = current;
+        try {
+          enabled = new Set(
+            input.discover().plugins.filter((plugin) => plugin.enabled).map((plugin) => plugin.id),
+          );
+        } catch (error) {
+          enabled = new Set();
+          input.logger?.warn("Plugin rediscovery failed; plugin hooks are withheld", {
+            error: error instanceof Error ? error.message : String(error),
+            event: "plugin.availability.rediscovery_failed",
+            module: "bootstrap.plugins",
+          });
+        }
+      }
+      return enabled ? !enabled.has(pluginId) : false;
+    },
+  };
+}
