+import { resolve } from "node:path";
+import type { ConfigResult } from "@zcode/adapters/config";
+
+/** Inline plugin roots that only Project configuration declares; their hooks are withheld (DOM-01). */
+export function projectDeclaredPluginRoots(configResult: ConfigResult): string[] {
+  const user = new Set(configResult.sources.plugins.dirs.user.map((root) => resolve(root)));
+  return configResult.sources.plugins.dirs.workspace.filter((root) => !user.has(resolve(root)));
+}
