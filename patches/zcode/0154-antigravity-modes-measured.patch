 /**
- * Fleet 权限选择 → agy 参数（OV-094）。agy 无法在 stream-json 中转发确认请求，且 agy 1.2.13 实测
- * （Paseo tools-* 抓包）在默认、plan、accept-edits 三种模式下都允许读写文件、只自动拒绝命令，
- * 被拒的操作在 result.denied_actions 中报告。因此只有 yolo（完全访问）→ --dangerously-skip-permissions
- * 会执行命令；文件改动的逐次确认需要 PreToolUse 钩子作为唯一闸门，尚待 owner 决定。
+ * Fleet 权限选择 → agy 参数（OV-094）。agy 1.2.14 本机实测：默认模式拒绝写文件和命令；
+ * accept-edits 允许写文件、拒绝命令；plan 只规划不改动；--dangerously-skip-permissions 全部放行。
+ * 无界面模式不能弹出确认，被拒的操作在 result.denied_actions 中报告。用户自己的 agy
+ * settings.json（permissions.allow）仍可能放宽这些默认值。
  */
 export function agyPermissionArgs(mode: CollaborationMode | undefined): string[] {
+  // --disable-slash-commands 会让 --mode plan 失效（agy 警告 "has no effect"），计划模式不加它；
+  // 其它模式加上，避免用户文本里的 "/xxx" 被当成 agy 命令。
   if (mode === "plan") return ["--mode", "plan"];
-  if (mode === "edit") return ["--mode", "accept-edits"];
-  if (mode === "yolo") return ["--dangerously-skip-permissions"];
-  return [];
+  if (mode === "edit") return ["--mode", "accept-edits", "--disable-slash-commands"];
+  if (mode === "yolo") return ["--dangerously-skip-permissions", "--disable-slash-commands"];
+  return ["--disable-slash-commands"];
+}
+
+/** 按被拒操作的类型指向能放行它的权限：写文件 → 自动编辑；命令或其它 → 完全访问。 */
+export function agyDeniedNote(denied: readonly { action?: string; display_name?: string }[]): string {
+  if (!denied.length) return "";
+  const names = denied.map((item) => item.display_name || item.action).filter(Boolean);
+  const onlyEdits = denied.every((item) => /write|edit|file/iu.test(item.action ?? ""));
+  return `\n\n> Antigravity 未执行需要确认的操作：${names.join("、")}。如需执行，请在输入框切换到“${onlyEdits ? "自动编辑" : "完全访问"}”后重试。`;
 }
 
