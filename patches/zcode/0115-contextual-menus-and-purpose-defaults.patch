     await f.close();
   }
 });
+
+test("vision default uses confirmed input capability, persists across reopen and shares the original preference writer", async () => {
+  const f = await fixture();
+  try {
+    await f.service.savePreferences({
+      defaultModelSelection: f.selection("primary"),
+      pageAssistantDefaultModelSelection: f.selection("helper"),
+      visionBridgeDefaultModelSelection: f.selection("helper"),
+      expectedRevision: (await f.service.getPreferences()).revision,
+    });
+    await f.reopen();
+    assert.deepEqual(
+      (await f.service.getView()).visionBridgeDefaultSelection,
+      f.selection("helper"),
+    );
+    const before = await f.read();
+    await assert.rejects(
+      f.service.savePreferences({
+        visionBridgeDefaultModelSelection: f.selection("primary"),
+        expectedRevision: (await f.service.getPreferences()).revision,
+      }),
+      { code: "model_preference_unavailable" },
+    );
+    assert.equal(await f.read(), before);
+    await f.runtime.configService.savePersonalProviderOverlay(
+      f.providerId,
+      parseProviderConfig({}),
+      undefined,
+      { providerName: "Renamed purpose fixture" },
+    );
+    await f.reopen();
+    assert.deepEqual(
+      (await f.service.getPreferences()).visionBridgeDefaultModelSelection,
+      f.selection("helper"),
+    );
+    await f.service.savePreferences({
+      visionBridgeDefaultModelSelection: null,
+      expectedRevision: (await f.service.getPreferences()).revision,
+    });
+    await f.reopen();
+    const final = await f.service.getPreferences();
+    assert.equal(final.visionBridgeDefaultModelSelection, undefined);
+    assert.deepEqual(final.defaultModelSelection, f.selection("primary"));
+    assert.deepEqual(final.pageAssistantDefaultModelSelection, f.selection("helper"));
+  } finally {
+    await f.close();
+  }
+});
