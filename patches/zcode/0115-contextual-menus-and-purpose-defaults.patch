@@ -1,4 +1,4 @@
-import { completeNewModelSelection } from "@zcode/provider";
+import { completeNewModelSelection, validateModelSelectionOptions } from "@zcode/provider";
 import type { ModelSelection } from "@zcode/shared";
 import type { ModelSelectionView } from "@zcode/services";
 
@@ -55,3 +55,27 @@ export function resolveVisionBridgeChoice(
     candidates,
   };
 }
+
+/** A configured bridge applies only to confirmed text-only input; explicit message choices win. */
+export function resolveVisionBridgeBackend(
+  view: ModelSelectionView | null,
+  choice: VisionBridgeChoice,
+  messageChoice?: { selectedKey?: string },
+): VisionBridgeCandidate | undefined {
+  if (choice.mode === "none") return undefined;
+  if (messageChoice)
+    return choice.candidates.find((candidate) => candidate.key === messageChoice.selectedKey);
+  const configured = view?.visionBridgeDefaultSelection;
+  if (choice.mode !== "required" || !configured) return undefined;
+  const candidate = choice.candidates.find(
+    (item) =>
+      item.selection.providerId === configured.providerId &&
+      item.selection.modelId === configured.modelId,
+  );
+  const model = view?.providers
+    .find((provider) => provider.providerId === configured.providerId)
+    ?.models.find((item) => item.modelId === configured.modelId);
+  if (!candidate || !model || !validateModelSelectionOptions(model, configured).ok)
+    return undefined;
+  return { ...candidate, selection: structuredClone(configured) };
+}
