+import assert from "node:assert/strict";
+import { SessionEventType, type Model, type SessionEvent } from "@zcode/contracts";
+import { ProductProjection } from "../../../bootstrap/src/zcode-protocol-v4/product-projection.js";
+import { mergeColdConversationEvents } from "../../../bootstrap/src/zcode-protocol-v4/cold-event-merge.js";
+import { resolveSessionContextUsage } from "../../../bootstrap/src/zcode-protocol/session-mapper.js";
+import { sessionUsageSeedFromRuntimeContextUsage } from "../../../bootstrap/src/zcode-protocol/v4-bridge.js";
+import type { fixture } from "./pi-runtime-fixture.js";
+
+/** Existing live/cold projection paths, using actual Host events and reopened SQLite facts. */
+export async function assertUnknownCapacityReplay(
+  f: Awaited<ReturnType<typeof fixture>>,
+  events: SessionEvent[],
+  model: Model,
+) {
+  assert.equal(model.contextWindowEvidence, null);
+  assert.ok(
+    !events.some(
+      (event) =>
+        event.type === SessionEventType.ModelSelected &&
+        (event.payload as { contextWindow?: number | null }).contextWindow === null,
+    ),
+  );
+  const live = new ProductProjection("session", "live");
+  live.applyEventAtomically(
+    {
+      ...events[0]!,
+      id: "old-capacity-selection" as never,
+      sequenceNumber: 0,
+      type: SessionEventType.ModelSelected,
+      payload: {
+        modelSelection: { providerId: model.providerId, modelId: model.modelId },
+        contextWindow: 200000,
+      },
+    },
+    () => true,
+  );
+  let completions = 0;
+  for (const event of events) {
+    live.applyEventAtomically(event, () => true);
+    if (event.type === SessionEventType.ModelComplete) {
+      completions++;
+      assert.equal(
+        live.getSnapshot().usage.contextWindow?.maxTokens ?? null,
+        completions === 1 ? 200000 : null,
+      );
+    }
+  }
+  assert.equal(completions, 2);
+  assert.equal(live.getSnapshot().usage.lastRequest?.inputTokens, 17);
+  assert.equal(live.getSnapshot().usage.cumulative.inputTokens, 34);
+  await f.reopen();
+  const messages = await f.store.messages({ sessionID: "session" as never });
+  const retained = await f.store.queryTaskUsage({ sessionID: "session" as never });
+  assert.equal(retained.cumulativeMainUsage?.inputTokens, 34);
+  assert.equal(retained.lastRequest?.inputTokens, 17);
+  const cold = new ProductProjection("session", "cold");
+  for (const event of mergeColdConversationEvents({
+    sessionId: "session",
+    messages,
+    memoryEvents: [],
+  }).events)
+    cold.applyEventAtomically(event, () => true);
+  const seed = sessionUsageSeedFromRuntimeContextUsage(
+    resolveSessionContextUsage({ messages, projection: await f.runtime.getProjection() }),
+    undefined,
+    retained.lastRequest,
+    retained.cumulativeMainUsage,
+  );
+  assert.ok(seed);
+  cold.seedUsage(seed);
+  assert.equal(cold.getSnapshot().usage.contextWindow, null);
+  assert.deepEqual(cold.getSnapshot().usage.cumulative, live.getSnapshot().usage.cumulative);
+  assert.equal(cold.getSnapshot().usage.lastRequest?.inputTokens, 17);
+  assert.equal(messages.filter((message) => message.info.role === "assistant").length, 2);
+}
diff --git a/apps/zcode-cli/packages/core/test/model-tool-capability.test.ts b/apps/zcode-cli/packages/core/test/model-tool-capability.test.ts
new file mode 100644
index 0000000..5d4399a
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/model-tool-capability.test.ts
@@ -0,0 +1,197 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, writeFile, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import type { Model, NativeAgentPort } from "@zcode/contracts";
+import {
+  createRegistryModelConfig,
+  createRegistryProviderConfig,
+  parseModelConfig,
+  parseProviderConfig,
+} from "../../../../../packages/provider/src/index.js";
+import { AiSdkModelAdapter } from "../../adapters/src/model/runner.js";
+import { NodeSkillAdapter } from "../../adapters/src/skills/index.js";
+import { createNativeAgentModel } from "../../adapters/src/native-agent/model.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+
+type Api = "openai-chat-completions" | "openai-responses" | "anthropic-messages";
+const usage = { prompt_tokens: 11, completion_tokens: 3, total_tokens: 14 };
+const args = { value: "original-host-effect" };
+const skillDescription = "CAPABILITY_SKILL_METADATA";
+
+for (const kind of ["codex", "claude"] as const) {
+  test(`native ${kind} respects an explicit negative tool correction through frozen binding and Host`, async () => {
+    const access = parseProviderConfig({ access: {
+      type: "native-cli", provider: kind, connected: true, accountId: "synthetic-account", executable: "/bin/false",
+    } }).access;
+    assert.ok(access?.type === "native-cli");
+    const model = createNativeAgentModel("provider-a", "model-a", access,
+      parseModelConfig({ properties: { supportsToolCall: false } }), { reasoningLevel: "auto" }, null);
+    let requests = 0;
+    const port: NativeAgentPort = { createTurn(request) {
+      assert.deepEqual(request.tools, []);
+      const result = { text: "native text", finishReason: "stop" as const,
+        usage: { inputTokens: 11, outputTokens: 3, totalTokens: 14, cacheReadTokens: 0, cacheWriteTokens: 0 },
+        providerMetadata: { nativeExecutor: kind, nativeRequestId: "negative-tools" } };
+      const observed: Model = { ...request.model, bind() { return observed; },
+        async generateText() { requests++; return result; },
+        async *streamText() { requests++; yield { type: "text_delta", text: result.text }; yield { type: "finish", ...result }; },
+      };
+      return { model: observed, admitNextStep() {}, retainToolReceipts() {}, async close() {} };
+    } };
+    const f = await fixture(undefined, true, {
+      nativeExecutor: model.nativeExecutor,
+      config: { modelSelection: { providerId: "provider-a", modelId: "model-a", options: { reasoningLevel: "auto" } } },
+      deps: { modelFactory: () => model, nativeAgentPort: port },
+    });
+    try {
+      assert.equal((await f.runtime.executeTurn("Reply with text only")).response, "native text");
+      assert.equal(requests, 1); assert.equal(f.permissionCalls, 0); assert.equal(f.effects, 0);
+      assert.ok(f.runtime.getTools().length > 0, "Native restriction mutated the local tool catalogue");
+    } finally { await f.close(); }
+  });
+}
+const sse = (frames: unknown[]) => new Response(
+  frames.map((value) => `data: ${JSON.stringify(value)}\n\n`).join(""),
+  { headers: { "content-type": "text/event-stream" } },
+);
+
+function response(api: Api, streaming: boolean, tool: boolean): Response {
+  if (api === "openai-chat-completions") {
+    const calls = [{ id: "capability-call", type: "function", function: { name: "Probe", arguments: JSON.stringify(args) } }];
+    if (!streaming) return Response.json({
+      id: "completion", object: "chat.completion", created: 1, model: "model-a",
+      choices: [{ index: 0, message: { role: "assistant", content: tool ? null : "complete", ...(tool ? { tool_calls: calls } : {}) }, finish_reason: tool ? "tool_calls" : "stop" }], usage,
+    });
+    const frame = (delta: unknown, finish_reason: unknown = null) => ({
+      id: "completion", object: "chat.completion.chunk", created: 1, model: "model-a",
+      choices: [{ index: 0, delta, finish_reason }], usage,
+    });
+    return sse([frame({ role: "assistant", ...(tool ? { tool_calls: [{ index: 0, ...calls[0] }] } : { content: "complete" }) }), frame({}, tool ? "tool_calls" : "stop")]);
+  }
+  if (api === "openai-responses") {
+    const item = tool
+      ? { type: "function_call", id: "tool-item", call_id: "capability-call", name: "Probe", arguments: JSON.stringify(args), status: "completed" }
+      : { type: "message", id: "message", role: "assistant", status: "completed", content: [{ type: "output_text", text: "complete", annotations: [] }] };
+    const result = { id: "response", model: "model-a", created_at: 1, status: "completed", output: [item], usage: { input_tokens: 11, output_tokens: 3, total_tokens: 14 } };
+    if (!streaming) return Response.json(result);
+    return sse([
+      { type: "response.created", response: { ...result, output: [], status: "in_progress" } },
+      { type: "response.output_item.added", output_index: 0, item: tool ? { ...item, arguments: "", status: "in_progress" } : { ...item, content: [], status: "in_progress" } },
+      ...(tool ? [] : [{ type: "response.content_part.added", item_id: "message", output_index: 0, content_index: 0, part: { type: "output_text", text: "", annotations: [] } }]),
+      ...(tool ? [] : [{ type: "response.output_text.delta", item_id: "message", output_index: 0, content_index: 0, delta: "complete" }]),
+      { type: "response.output_item.done", output_index: 0, item },
+      { type: "response.completed", response: result },
+    ]);
+  }
+  const content = tool
+    ? { type: "tool_use", id: "capability-call", name: "Probe", input: args }
+    : { type: "text", text: "complete" };
+  const result = { id: "message", type: "message", role: "assistant", model: "model-a", content: [content], stop_reason: tool ? "tool_use" : "end_turn", stop_sequence: null, usage: { input_tokens: 11, output_tokens: 3 } };
+  if (!streaming) return Response.json(result);
+  return sse([
+    { type: "message_start", message: { ...result, content: [], stop_reason: null, usage: { input_tokens: 11, output_tokens: 0 } } },
+    { type: "content_block_start", index: 0, content_block: tool ? { ...content, input: {} } : { type: "text", text: "" } },
+    { type: "content_block_delta", index: 0, delta: tool ? { type: "input_json_delta", partial_json: JSON.stringify(args) } : { type: "text_delta", text: "complete" } },
+    { type: "content_block_stop", index: 0 },
+    { type: "message_delta", delta: { stop_reason: result.stop_reason, stop_sequence: null }, usage: { output_tokens: 3 } },
+    { type: "message_stop" },
+  ]);
+}
+
+async function setup(api: Api, streaming: boolean, supportsToolCall: boolean, offerCall = false) {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-model-capability-"));
+  const skillDir = join(dir, "automatic");
+  await mkdir(skillDir);
+  await writeFile(join(skillDir, "SKILL.md"), `---\nname: capability-fixture\ndescription: ${skillDescription}\n---\nFixture instructions.\n`);
+  const skillPort = new NodeSkillAdapter({ homeDirectory: dir, includeZcodeSkills: false, extraRoots: [dir] });
+  const requests: Record<string, unknown>[] = [];
+  const adapter = new AiSdkModelAdapter({
+    env: {}, retry: { maxAttempts: 1 },
+    transport: async (input, init) => {
+      const request = new Request(input, init);
+      const body = JSON.parse(await request.text()) as Record<string, unknown>;
+      requests.push(body);
+      return response(api, body.stream === true, offerCall && requests.length === 1);
+    },
+  });
+  const provider = createRegistryProviderConfig(parseProviderConfig({
+    group: "standard-personal", access: { type: "api-key", apiKey: "synthetic-only" },
+    api: { type: api, baseUrl: "https://capability.invalid/v1" },
+  }));
+  const config = createRegistryModelConfig(parseModelConfig({
+    enabled: true,
+    properties: {
+      contextWindow: 65536, requiresMfjsToolSchema: false,
+      inputFormat: { supportsText: true, supportsImage: false, supportsAudio: false, supportsVideo: false, supportsPdf: false },
+      outputFormat: { supportsText: true }, supportsToolCall, supportsJsonSchemaOutput: false,
+      supportsNativeWebSearch: false, supportsMidConversationSystem: true,
+    },
+    optionSpecs: {
+      reasoningLevel: { values: ["off"], map: "{}" },
+      maxOutputTokens: { max: 256, map: api === "openai-responses" ? '{"max_output_tokens":maxOutputTokens}' : '{"max_tokens":maxOutputTokens}' },
+    },
+  }));
+  assert.ok(provider.ok);
+  assert.ok(config.ok, JSON.stringify(config));
+  const model = adapter.createModel({ providerId: "fixture", modelId: "model-a", providerConfig: provider.config, modelConfig: config.config, options: { reasoningLevel: "off", maxOutputTokens: 256 } });
+  const f = await fixture(undefined, streaming, { config: { toolAllowlist: ["Skill", "Probe"] }, deps: { skillPort, modelFactory: () => model } });
+  return { f, model, requests, async close() { await f.close(); await rm(dir, { recursive: true, force: true }); } };
+}
+
+for (const api of ["openai-chat-completions", "openai-responses", "anthropic-messages"] as const) {
+  for (const streaming of [false, true]) {
+    test(`negative tool capability allows ${api} ${streaming ? "stream" : "JSON"} text through real Host/SDK without tool context`, async () => {
+      const c = await setup(api, streaming, false);
+      try {
+        const localNames = c.f.runtime.getTools().map((tool) => tool.name);
+        assert.ok(localNames.includes("Skill") && localNames.includes("Probe"));
+        for (const cold of [false, true]) {
+          if (cold) await c.f.reopen();
+          assert.equal((await c.f.runtime.executeTurn("Reply briefly.")).response, "complete");
+          assert.deepEqual(c.f.runtime.getTools(c.model), []);
+          assert.deepEqual(c.f.runtime.getTools().map((tool) => tool.name), localNames);
+          const wire = c.requests.at(-1)!;
+          assert.equal(wire.tools, undefined);
+          const serialized = JSON.stringify(wire);
+          assert.ok(!serialized.includes(skillDescription));
+          assert.ok(!serialized.includes("The following skills are available for use with the Skill tool"));
+          assert.ok(!serialized.includes("invoke it via Skill"));
+        }
+        assert.equal(c.requests.length, 2);
+        assert.equal(c.f.effects, 0);
+        assert.equal(c.f.permissionCalls, 0);
+      } finally { await c.close(); }
+    });
+  }
+  test(`supported ${api} tool calls retain original Host approval and effects`, async () => {
+    const c = await setup(api, false, true, true);
+    try {
+      const localNames = c.f.runtime.getTools().map((tool) => tool.name);
+      const unknown = { ...c.model, properties: { ...c.model.properties, supportsToolCall: undefined } } as unknown as Model;
+      assert.deepEqual(c.f.runtime.getTools(unknown).map((tool) => tool.name), localNames);
+      assert.equal((await c.f.runtime.executeTurn("Use Probe once.")).response, "complete");
+      assert.equal(c.f.effects, 1);
+      assert.equal(c.f.permissionCalls, 1);
+      assert.equal(await c.f.read(), args.value);
+      assert.ok(Array.isArray(c.requests[0]!.tools));
+      assert.ok(JSON.stringify(c.requests[0]).includes(skillDescription));
+    } finally { await c.close(); }
+  });
+}
+
+for (const streaming of [false, true]) {
+  test(`invented tool from a negative-capability ${streaming ? "stream" : "JSON"} reply cannot dispatch a Host effect`, async () => {
+    const c = await setup("openai-chat-completions", streaming, false, true);
+    try {
+      await c.f.runtime.executeTurn("Reply briefly.").catch(() => {});
+      assert.ok(c.requests.length > 0);
+      assert.ok(c.requests.every((wire) => wire.tools === undefined));
+      assert.equal(c.f.effects, 0);
+      assert.equal(c.f.permissionCalls, 0);
+      await c.f.reopen();
+      assert.equal(c.f.effects, 0);
+    } finally { await c.close(); }
+  });
+}
diff --git a/apps/zcode-cli/packages/core/test/native-model-capacity.test.ts b/apps/zcode-cli/packages/core/test/native-model-capacity.test.ts
new file mode 100644
index 0000000..85b138d
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/native-model-capacity.test.ts
@@ -0,0 +1,370 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { DatabaseSync } from "node:sqlite";
+import { fileURLToPath } from "node:url";
+import {
+  createInMemorySessionEventStore,
+  SessionEventType,
+  type Model,
+  type NativeAgentPort,
+} from "@zcode/contracts";
+import { createProviderConfigRuntime } from "../../../../../packages/services/src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../../../../../packages/services/src/model-provider/providerRuntime.js";
+import { ApiProviderModelRuntime } from "../../bootstrap/src/app/provider-registry-model-runtime.js";
+import { AiSdkModelAdapter } from "../../adapters/src/model/runner.js";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { assertUnknownCapacityReplay } from "./helpers/model-capacity-v4-replay.js";
+
+const reported = { input_tokens: 17, output_tokens: 3, total_tokens: 20 };
+const usage = {
+  inputTokens: 17,
+  outputTokens: 3,
+  totalTokens: 20,
+  cacheReadTokens: 0,
+  cacheWriteTokens: 0,
+};
+
+async function providerFixture(native: boolean) {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-native-capacity-"));
+  const personalFilePath = join(directory, "providers.json");
+  let capacity = 64000;
+  const config = () => ({
+    properties: { contextWindow: capacity },
+    optionSpecs: { maxOutputTokens: { max: 4096 } },
+  });
+  const open = () =>
+    new ProviderRuntime({
+      configRuntime: createProviderConfigRuntime({
+        personalFilePath,
+        zcodeBuiltinFilePath: fileURLToPath(
+          new URL("../../../../../config/provider/zcode-builtin.json", import.meta.url),
+        ),
+        personalPollingIntervalMs: false,
+        watch: false,
+      }),
+      fetch: async () =>
+        Response.json({
+          data: [{ id: "observed-model", context_window: capacity, max_output_tokens: 4096 }],
+        }),
+      nativeCli: {
+        inspect: async () => ({
+          accountId: "synthetic",
+          accountName: "Fixture",
+          catalog: {
+            source: "provider",
+            models: [{ id: "observed-model", name: "Observed", config: config() }],
+          },
+        }),
+        login: () => {
+          throw new Error("No CLI, login or credential access in this fixture");
+        },
+      },
+    });
+  let runtime = open();
+  await runtime.start();
+  const { providerId } = await runtime.providerSettings.createPersonalProvider(
+    native
+      ? {
+          templateId: "fleet-chatgpt-native",
+          initialConfig: {
+            access: {
+              type: "native-cli",
+              provider: "codex",
+              connected: true,
+              accountId: "synthetic",
+              executable: "/not-invoked/native-fixture",
+              configDir: directory,
+            },
+          },
+        }
+      : {
+          initialConfig: {
+            api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+            access: { type: "api-key", apiKey: "synthetic" },
+          },
+        },
+  );
+  await runtime.providerSettings.addPersonalModel(providerId, "unknown-model", {}, true);
+  const factories: ApiProviderModelRuntime[] = [];
+  let apiRequests = 0;
+  return {
+    providerId,
+    get runtime() {
+      return runtime;
+    },
+    get apiRequests() {
+      return apiRequests;
+    },
+    setCapacity(value: number) {
+      capacity = value;
+    },
+    bind(modelId: string, contextWindow?: number) {
+      const factory = new ApiProviderModelRuntime({
+        registry: runtime.registryService,
+        modelAdapter: new AiSdkModelAdapter({
+          env: {},
+          transport: async () => {
+            apiRequests++;
+            return Response.json({
+              id: "original",
+              created: 1,
+              model: modelId,
+              choices: [
+                {
+                  index: 0,
+                  message: { role: "assistant", content: "local observation" },
+                  finish_reason: "stop",
+                },
+              ],
+              usage: { prompt_tokens: 17, completion_tokens: 3, total_tokens: 20 },
+            });
+          },
+        }),
+      });
+      factories.push(factory);
+      factory.start();
+      return factory.modelFactory({
+        selection: {
+          providerId,
+          modelId,
+          options: {
+            reasoningLevel: "auto",
+            ...(contextWindow === undefined ? {} : { contextWindow }),
+          },
+        },
+      });
+    },
+    async reopen() {
+      runtime.dispose();
+      runtime = open();
+      await runtime.start();
+    },
+    async close() {
+      for (const factory of factories) factory.dispose();
+      runtime.dispose();
+      await rm(directory, { recursive: true, force: true });
+    },
+  };
+}
+
+async function observe(
+  bound: Model,
+  native: boolean,
+  contextWindow?: number,
+  replayOldCapacity = false,
+) {
+  const events = createInMemorySessionEventStore();
+  let nativeSteps = 0;
+  const port: NativeAgentPort = {
+    createTurn(request) {
+      const observation: Model = {
+        ...request.model,
+        bind() {
+          return observation;
+        },
+        async generateText() {
+          nativeSteps++;
+          return {
+            text: "local observation",
+            finishReason: "stop",
+            usage,
+            providerMetadata: {
+              nativeExecutor: "codex",
+              nativeRequestId: "original",
+              nativeReportedUsage: reported,
+            },
+          };
+        },
+      };
+      return { model: observation, admitNextStep() {}, retainToolReceipts() {}, async close() {} };
+    },
+  };
+  const f = await fixture(undefined, false, {
+    config: {
+      modelSelection: {
+        providerId: bound.providerId,
+        modelId: bound.modelId,
+        options: {
+          reasoningLevel: "auto",
+          ...(contextWindow === undefined ? {} : { contextWindow }),
+        },
+      },
+    },
+    deps: { eventStore: events, ...(native ? { nativeAgentPort: port } : {}) },
+  });
+  try {
+    if (replayOldCapacity) {
+      const old: Model = {
+        ...bound,
+        contextWindowEvidence: 200000,
+        bind() {
+          return old;
+        },
+        generateText: bound.generateText.bind(bound),
+        streamText: bound.streamText.bind(bound),
+      };
+      (f.runtime as any).modelFactory = () => old;
+      await f.runtime.executeTurn("Record the same model's historical capacity");
+    }
+    (f.runtime as any).modelFactory = () => bound;
+    await f.runtime.executeTurn("Observe capacity through the existing Host writers");
+    assert.equal(f.effects, 0);
+    assert.equal(f.permissionCalls, 0);
+    const actualEvents = await events.getEvents("session" as never);
+    const complete = actualEvents.findLast(
+      (event) => event.type === SessionEventType.ModelComplete,
+    )!;
+    assert.ok(complete);
+    assert.equal((complete.payload as any).usage.inputTokens, 17);
+    assert.equal((complete.payload as any).usage.outputTokens, 3);
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try {
+      const row = db.prepare("select status,provider_metadata_json from model_usage").get()!;
+      assert.equal(row.status, "completed");
+      if (native)
+        assert.deepEqual(
+          JSON.parse(String(row.provider_metadata_json)).nativeReportedUsage,
+          reported,
+        );
+    } finally {
+      db.close();
+    }
+    if (replayOldCapacity) await assertUnknownCapacityReplay(f, actualEvents, bound);
+    assert.equal(nativeSteps, native ? (replayOldCapacity ? 2 : 1) : 0);
+    return (complete.payload as any).contextWindow;
+  } finally {
+    await f.close();
+  }
+}
+
+for (const native of [false, true]) {
+  test(`${native ? "native" : "API"} future/private suffixes cannot inherit bundled capacity evidence`, async () => {
+    const p = await providerFixture(native);
+    try {
+      for (const modelId of [
+        "mimo-v2-flash-future-private",
+        "vendor/mimo-v2-flash-future-private",
+        "gpt-6-astra-future-private",
+        "gpt-5.4-mini:unknown-router",
+      ]) {
+        await p.runtime.providerSettings.addPersonalModel(p.providerId, modelId, {}, true);
+        const row = (await p.runtime.providerSettings.getView()).providers
+          .find((entry) => entry.providerId === p.providerId)!
+          .models.find((entry) => entry.modelId === modelId)!;
+        assert.equal(row.contextEvidenceSource, "unknown");
+        assert.equal(row.evidenceConfig.properties?.contextWindow, undefined);
+        const frozen = p.bind(modelId);
+        assert.equal(frozen.properties.contextWindow, 200000);
+        assert.equal(frozen.contextWindowEvidence, null);
+        assert.equal(await observe(frozen, native), null);
+      }
+      await p.runtime.providerSettings.addPersonalModel(p.providerId, "gpt-6-astra", {}, true);
+      const known = p.bind("gpt-6-astra");
+      assert.equal(known.properties.contextWindow, 1050000);
+      assert.equal(known.contextWindowEvidence, 1050000);
+      await p.reopen();
+      assert.equal(p.bind("gpt-6-astra").contextWindowEvidence, 1050000);
+      assert.equal(p.bind("mimo-v2-flash-future-private").contextWindowEvidence, null);
+    } finally {
+      await p.close();
+    }
+  });
+
+  test(`${native ? "native" : "API"} unknown capacity remains unknown through frozen binding and Host observation`, async () => {
+    const p = await providerFixture(native);
+    try {
+      const row = (await p.runtime.providerSettings.getView()).providers
+        .find((entry) => entry.providerId === p.providerId)!
+        .models.find((entry) => entry.modelId === "unknown-model")!;
+      assert.equal(row.contextEvidenceSource, "unknown");
+      assert.equal(row.evidenceConfig.properties?.contextWindow, undefined);
+      const bound = p.bind("unknown-model");
+      assert.equal(bound.properties.contextWindow, 200000, "Internal working budget changed");
+      assert.equal(bound.contextWindowEvidence, null);
+      assert.equal(bound.bind({ maxOutputTokens: 1024 }).contextWindowEvidence, null);
+      assert.equal(
+        await observe(bound, native, undefined, true),
+        null,
+        "Fallback became a confirmed denominator",
+      );
+      assert.equal(p.apiRequests, native ? 0 : 2, "Replay or reopen dispatched another request");
+      await p.reopen();
+      assert.equal(p.bind("unknown-model").contextWindowEvidence, null);
+    } finally {
+      await p.close();
+    }
+  });
+
+  for (const manual of [false, true]) {
+    test(`${native ? "native" : "API"} ${manual ? "manual" : "catalog"} capacity wins, freezes and survives repository reopen`, async () => {
+      const p = await providerFixture(native);
+      try {
+        await p.runtime.providerSettings.discoverModels(p.providerId);
+        if (manual)
+          await p.runtime.providerSettings.savePersonalModelDraft({
+            providerId: p.providerId,
+            originalModelId: "observed-model",
+            nextModelId: "observed-model",
+            personalConfig: { properties: { contextWindow: 48000 } },
+            useRecommendedConfig: true,
+            basedOnRevision: (await p.runtime.providerSettings.getView()).revision,
+          });
+        const expected = manual ? 48000 : 64000;
+        const frozen = p.bind("observed-model");
+        assert.equal(frozen.properties.contextWindow, expected);
+        assert.equal(frozen.contextWindowEvidence, expected);
+        p.setCapacity(32000);
+        await p.runtime.providerSettings.discoverModels(p.providerId);
+        assert.equal(frozen.properties.contextWindow, expected);
+        assert.equal(frozen.bind({ maxOutputTokens: 1024 }).contextWindowEvidence, expected);
+        assert.equal(await observe(frozen, native), expected);
+        const next = p.bind("observed-model");
+        assert.equal(next.contextWindowEvidence, manual ? 48000 : 32000);
+        await p.reopen();
+        const reopened = p.bind("observed-model");
+        assert.equal(reopened.properties.contextWindow, manual ? 48000 : 32000);
+        assert.equal(reopened.contextWindowEvidence, manual ? 48000 : 32000);
+        assert.equal(await observe(reopened, native), manual ? 48000 : 32000);
+        const row = (await p.runtime.providerSettings.getView()).providers
+          .find((entry) => entry.providerId === p.providerId)!
+          .models.find((entry) => entry.modelId === "observed-model")!;
+        assert.equal(row.effectiveBuiltinConfig.properties?.contextWindow, 32000);
+        assert.equal(row.contextEvidenceSource, manual ? "saved" : "provider");
+      } finally {
+        await p.close();
+      }
+    });
+  }
+
+  test(`${native ? "native" : "API"} Host context choices freeze separately from catalog defaults`, async () => {
+    const p = await providerFixture(native);
+    try {
+      await p.runtime.providerSettings.discoverModels(p.providerId);
+      await p.runtime.providerSettings.savePersonalModelDraft({
+        providerId: p.providerId,
+        originalModelId: "observed-model",
+        nextModelId: "observed-model",
+        personalConfig: { properties: { contextWindows: [64000, 96000] } },
+        useRecommendedConfig: true,
+        basedOnRevision: (await p.runtime.providerSettings.getView()).revision,
+      });
+      const selected = p.bind("observed-model", 96000);
+      assert.equal(selected.properties.contextWindow, 96000);
+      assert.equal(selected.contextWindowEvidence, 96000);
+      assert.equal(await observe(selected, native, 96000), 96000);
+      assert.equal(
+        p.runtime.registryService.getModel(p.providerId, "observed-model")!.config.properties
+          .contextWindow,
+        64000,
+      );
+      assert.throws(() => p.bind("observed-model", 128000), /Context window is not supported/);
+      await p.reopen();
+      assert.equal(p.bind("observed-model", 96000).contextWindowEvidence, 96000);
+    } finally {
+      await p.close();
+    }
+  });
+}
diff --git a/config/README.md b/config/README.md
index 723cfa9..a20ec8e 100644
--- a/config/README.md
+++ b/config/README.md
@@ -42,4 +42,21 @@ do not guess which were edited by the user or silently migrate them away. An ups
 update the observed layer without erasing those values. This additive contract does not establish
 capabilities for ID-only API catalogs or solve the inherited generic runtime fallback policy.
 
+Native Codex discovery carries the scoped executor's resolved context window from its own fresh
+model manager, with native configuration applied. It supplies neither inferred output limits nor
+membership for unknown IDs. Optional positive integer capacity enters the same observed rule
+layer and survives reopen; explicit corrections retain priority. Missing capacity remains unknown
+through Registry and Host observations. The internal execution budget is never capacity evidence.
+
+Anthropic-compatible model directories retain the current official max_input_tokens/max_tokens
+limits and nested capability support flags, including explicit false. Advertised effort grades
+replace old recommendation lists; only a declared adaptive-thinking type enables adaptive mode.
+Missing/null fields supply no guessed flags or limits. Output token limits stay independent of
+input capacity. Model Studio ASR preserves Audio→Text, while chat eligibility checks both ends.
+
 An advertised default reasoning level is stored as `optionSpecs.reasoningLevel.defaultValue` and used only when it belongs to the current supported set. New model selection, Composer options and the Agent model catalog use the same public Provider resolver; an absent or unsupported default retains the existing last-supported-level fallback. Explicit Session choices and saved user defaults keep priority. An unknown-only subscription effort list fails refresh explicitly instead of inventing `off`; last successful configuration remains intact.
+
+Named recommendation rules declare exact published `evidenceModelIds` for model facts. Unknown
+private/future suffixes cannot inherit those facts; pure protocol maps still apply independently.
+Legacy broad rules retain internal recommendations only, without confirmed capacity. The scope
+uses the admitted Pi 1.0.1 and fixed-template IDs, not account membership or a second catalogue.
