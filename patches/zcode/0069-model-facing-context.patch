+++ b/apps/zcode-cli/packages/core/test/context-footprint.test.ts
@@ -0,0 +1,283 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { NodeSkillAdapter } from "../../adapters/src/skills/index.js";
+import { buildSkillsSection } from "../src/context/sections/skills.js";
+import {
+  buildToolUsageDetail,
+  buildSkillUsageDetails,
+} from "../src/runtime/methods/context-usage.js";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+async function skills() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-context-skills-"));
+  const paths: string[] = [];
+  for (const [name, flag] of [
+    ["automatic", "false # model invocation allowed"],
+    ["manual", '"true" # explicit invocation only'],
+    ["manual-yes", "YES"],
+    ["manual-on", "on"],
+    ["manual-one", "1"],
+  ]) {
+    const folder = join(dir, name!);
+    await mkdir(folder);
+    const path = join(folder, "SKILL.md");
+    paths.push(path);
+    await writeFile(
+      path,
+      `---\nname: ${name}\ndescription: Instructions for ${name}\ndisable-model-invocation: ${flag}\n---\nBODY_${name}\n`,
+    );
+  }
+  const port = new NodeSkillAdapter({
+    homeDirectory: dir,
+    includeZcodeSkills: false,
+    extraRoots: [dir],
+  });
+  return { dir, paths, port, close: () => rm(dir, { recursive: true, force: true }) };
+}
+
+test("manual-only skills stay installed and explicitly loadable without entering model discovery", async () => {
+  const s = await skills();
+  try {
+    const outcome = await s.port.discoverSkills({ workingDirectory: s.dir });
+    assert.equal(outcome.skills.length, 5);
+    const section = buildSkillsSection({ outcome })!;
+    assert.ok(section.content.includes("automatic"));
+    assert.ok(!section.content.includes("manual"));
+    assert.ok(!section.content.includes("BODY_"));
+    for (const name of ["manual", "manual-yes", "manual-on", "manual-one"]) {
+      const loaded = await s.port.loadSkill({ name, workingDirectory: s.dir });
+      assert.equal(loaded.metadata.policy?.allowImplicitInvocation, false);
+      assert.equal(loaded.content, `BODY_${name}`);
+    }
+    assert.equal(
+      buildSkillsSection({
+        outcome: {
+          ...outcome,
+          skills: outcome.skills.filter((skill) => skill.name !== "automatic"),
+        },
+      }),
+      null,
+    );
+  } finally {
+    await s.close();
+  }
+});
+
+test(
+  "full Pi cannot auto-load a manual-only skill even if the model invents its name",
+  { timeout: 10000 },
+  async () => {
+    const s = await skills();
+    const f = await fixture(undefined, false, {
+      config: { toolAllowlist: ["Skill"] },
+      deps: { skillPort: s.port },
+    });
+    try {
+      f.steps.push(
+        (request) => {
+          const prompt = JSON.stringify(request.messages);
+          assert.ok(!prompt.includes("manual"));
+          assert.ok(!prompt.includes("BODY_"));
+          return reply("loading", [{ id: "manual", name: "Skill", input: { skill: "manual" } }]);
+        },
+        (request) => {
+          const result = JSON.stringify(
+            request.messages.filter((message: any) => message.role === "tool"),
+          );
+          assert.ok(result.includes("manual-only"));
+          assert.ok(!result.includes("BODY_manual"));
+          return reply("Use /manual to invoke it explicitly");
+        },
+      );
+      assert.match((await f.runtime.executeTurn("Complete the task")).response, /explicitly/);
+      assert.equal(f.requests.length, 2);
+    } finally {
+      await f.close();
+      await s.close();
+    }
+  },
+);
+
+test("context tool estimates exclude execution-only metadata that adapters never send to the model", async () => {
+  const f = await fixture();
+  try {
+    const base = f.runtime.getTools()[0]!;
+    const changed = {
+      ...base,
+      outputSchema: { description: "LOCAL_OUTPUT".repeat(500) },
+      permission: { description: "LOCAL_POLICY".repeat(500) } as any,
+      resultBudget: { description: "LOCAL_BUDGET".repeat(500) } as any,
+    };
+    const estimate = (tool: typeof base) => buildToolUsageDetail.call(f.runtime as never, tool);
+    assert.equal(estimate(base).chars, estimate(changed).chars);
+    assert.equal(estimate(base).tokens, estimate(changed).tokens);
+    assert.ok(
+      estimate({ ...base, description: (base.description ?? "") + "MODEL_DESCRIPTION".repeat(50) })
+        .chars > estimate(base).chars,
+    );
+    assert.equal(changed.outputSchema.description.length, 6000);
+  } finally {
+    await f.close();
+  }
+});
+
+test("skill contributors reflect the actual truncated or names-only catalogue entries", async () => {
+  const s = await skills();
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: ["Skill"], skillMetadataBudget: 1 },
+    deps: { skillPort: s.port },
+  });
+  try {
+    f.steps.push(() => reply("finished"));
+    await f.runtime.executeTurn("A plain task");
+    const details = buildSkillUsageDetails.call(f.runtime as never);
+    assert.deepEqual(
+      details.map((skill) => skill.name),
+      ["automatic"],
+    );
+    const outcome = await s.port.discoverSkills({ workingDirectory: s.dir });
+    const section = buildSkillsSection({ outcome, metadataBudget: 1 })!;
+    const entry = section.content.split("\n").find((line) => line.startsWith("- automatic"))!;
+    assert.equal(details[0]!.chars, entry.length);
+  } finally {
+    await f.close();
+    await s.close();
+  }
+});
+
+test(
+  "Skill arguments reuse command expansion without rescanning inserted dollar signs or running shell text",
+  { timeout: 10000 },
+  async () => {
+    const s = await skills();
+    try {
+      for (const content of [
+        "Use $ARGUMENTS in ${CLAUDE_SKILL_DIR}",
+        "Use $1",
+        "No placeholders",
+      ]) {
+        await writeFile(
+          s.paths[0]!,
+          `---\nname: automatic\ndescription: Fixture arguments\n---\n${content}\n`,
+        );
+        const f = await fixture(undefined, false, {
+          config: { toolAllowlist: ["Skill"] },
+          deps: { skillPort: s.port },
+        });
+        try {
+          const args = '"$1 !`must-not-execute`"';
+          f.steps.push(
+            () =>
+              reply("loading", [
+                { id: "args", name: "Skill", input: { skill: "automatic", args } },
+              ]),
+            (request) => {
+              const result = JSON.stringify(
+                request.messages.filter((message: any) => message.role === "tool"),
+              );
+              assert.ok(result.includes("$1 !`must-not-execute`"));
+              assert.ok(!result.includes("$ARGUMENTS"));
+              assert.ok(!result.includes("${CLAUDE_SKILL_DIR}"));
+              return reply("complete");
+            },
+          );
+          assert.equal((await f.runtime.executeTurn("Load the skill")).response, "complete");
+        } finally {
+          await f.close();
+        }
+      }
+    } finally {
+      await s.close();
+    }
+  },
+);
+
+test(
+  "desktop requests have one workbench identity and use desktop rendering guidance; terminal control stays intact",
+  { timeout: 10000 },
+  async () => {
+    for (const presentationSurface of ["zcode_desktop", "terminal"] as const) {
+      const f = await fixture(undefined, false, { config: { presentationSurface } });
+      try {
+        f.steps.push((request) => {
+          const system = request.messages
+            .filter((message: any) => message.role === "system")
+            .map((message: any) => message.content)
+            .join("\n");
+          if (presentationSurface === "zcode_desktop") {
+            assert.equal(system.match(/You are Fleet/g)?.length, 1);
+            assert.ok(system.includes("desktop workbench"));
+            assert.ok(!system.includes("in a terminal"));
+            assert.ok(!system.includes("software engineering tasks"));
+            assert.ok(system.includes("Markdown links"));
+          } else {
+            assert.ok(system.includes("interactive coding agent"));
+            assert.ok(system.includes("in a terminal"));
+            assert.ok(system.includes("file_path:line_number"));
+          }
+          assert.ok(system.includes("user-selected permission mode"));
+          return reply("complete");
+        });
+        assert.equal((await f.runtime.executeTurn("A local task")).response, "complete");
+      } finally {
+        await f.close();
+      }
+    }
+  },
+);
+
+test(
+  "explicit composer and CLI Skill selection is bound to this input and expires before the next input",
+  { timeout: 10000 },
+  async () => {
+    const s = await skills();
+    try {
+      for (const input of [
+        "/manual requested",
+        "$manual requested",
+        `Use [$manual](${s.paths[1]}) requested`,
+      ]) {
+        const f = await fixture(undefined, true, {
+          config: { toolAllowlist: ["Skill"] },
+          deps: { skillPort: s.port },
+        });
+        try {
+          f.steps.push(
+            () => reply("loading", [{ id: "explicit", name: "Skill", input: { skill: "manual" } }]),
+            (request) => {
+              const last = request.messages
+                .filter((message: any) => message.role === "tool")
+                .at(-1);
+              assert.ok(JSON.stringify(last).includes("BODY_manual"));
+              return reply("explicit-complete");
+            },
+          );
+          assert.equal((await f.runtime.executeTurn(input)).response, "explicit-complete");
+          f.steps.push(
+            () =>
+              reply("loading again", [{ id: "later", name: "Skill", input: { skill: "manual" } }]),
+            (request) => {
+              const last = request.messages
+                .filter((message: any) => message.role === "tool")
+                .at(-1);
+              assert.ok(JSON.stringify(last).includes("manual-only"));
+              assert.ok(!JSON.stringify(last).includes("BODY_manual"));
+              return reply("later-denied");
+            },
+          );
+          assert.equal(
+            (await f.runtime.executeTurn("Another unrelated task")).response,
+            "later-denied",
+          );
+        } finally {
+          await f.close();
+        }
+      }
+    } finally {
+      await s.close();
+    }
+  },
+);
