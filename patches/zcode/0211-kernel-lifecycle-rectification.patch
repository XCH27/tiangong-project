+import {
+  background,
+  fixture,
+  launch,
+  projected,
+  sessionId,
+  subscribe,
+} from "./helpers/cold-workflow-background-fixture.js";
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import {
+  persistBackgroundTaskCompletedEntry,
+  persistBackgroundTaskStartedEntry,
+} from "@zcode/core";
+
+test("newer same-ID workflow resume survives an older terminal in warm replay", () => {
+  const terminal = background(SessionEventType.BackgroundTaskCompleted, "resume", 1000, 1);
+  const resumed = background(SessionEventType.BackgroundTaskStarted, "resume", 2000, 2);
+  assert.equal(projected([terminal, resumed])[0]?.status, "running");
+});
+
+test("terminal still protects against a genuinely stale Started appended by cold synthesis", () => {
+  const terminal = background(SessionEventType.BackgroundTaskCompleted, "stale", 2000, 2);
+  const stale = background(SessionEventType.BackgroundTaskStarted, "stale", 1000, 0);
+  assert.equal(projected([terminal, stale])[0]?.status, "cancelled");
+});
+
+test("same-timestamp live resume uses known sequence order", () => {
+  const terminal = background(SessionEventType.BackgroundTaskCompleted, "same-time", 1000, 1);
+  const resumed = background(SessionEventType.BackgroundTaskStarted, "same-time", 1000, 2);
+  assert.equal(projected([terminal, resumed])[0]?.status, "running");
+});
+
+test("public Host cold subscribe reads the original SQLite workflow journal after reopen", async () => {
+  const f = await fixture("pi");
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    await launch(f, "journal-only", 2000);
+    await launch(f, "foreign", 2000, "other-session");
+    await launch(f, "journal-terminal", 2000);
+    f.store.workflowJournalStore().updateRunStatus("journal-terminal", "completed");
+    await persistBackgroundTaskStartedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskStarted, "journal-missing", 2000, 2),
+    });
+    await f.reopen();
+    for (const mode of ["web-remote-replayable", "desktop-continuous"] as const) {
+      const works = await subscribe(f, mode);
+      assert.equal(works.find((work) => work.workId === "journal-only")?.status, "running");
+      for (const id of ["foreign", "journal-terminal", "journal-missing"]) {
+        assert.equal(
+          works.some((work) => work.workId === id),
+          false,
+        );
+      }
+    }
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("SQLite reopen projects a newer resumed workflow and retains a newer terminal", async () => {
+  const f = await fixture("pi");
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    // SQLite upsert keeps the first row's time.created; resume must retain its own emission.
+    await launch(f, "resumed", 500);
+    f.store.workflowJournalStore().updateRunStatus("resumed", "completed");
+    await persistBackgroundTaskCompletedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskCompleted, "resumed", 1000, 1),
+    });
+    f.store.workflowJournalStore().updateRunStatus("resumed", "running");
+    const resumed = background(SessionEventType.BackgroundTaskStarted, "resumed", 2000, 4);
+    (resumed.payload as { startedAt: Date }).startedAt = new Date(500);
+    await persistBackgroundTaskStartedEntry({ sessionStore: f.store, sessionId, event: resumed });
+    await launch(f, "stale-start", 1000);
+    await persistBackgroundTaskCompletedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskCompleted, "stale-start", 2000, 3),
+    });
+    await launch(f, "late-stale", 4000);
+    await persistBackgroundTaskCompletedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskCompleted, "late-stale", 5000, 6),
+    });
+    // A delayed old Started write updates the same SQLite row last, but must not revive it.
+    await persistBackgroundTaskStartedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskStarted, "late-stale", 3000, 1),
+    });
+    await f.reopen();
+    const works = await subscribe(f);
+    assert.equal(works.find((work) => work.workId === "resumed")?.status, "running");
+    assert.equal(works.find((work) => work.workId === "late-stale")?.status, "cancelled");
+    assert.equal(works.find((work) => work.workId === "stale-start")?.status, "cancelled");
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("public cold Host conservatively reads uncertain legacy timing without rewriting old entries", async () => {
+  const f = await fixture("pi");
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    f.store.workflowJournalStore().createRun({
+      runId: "legacy-resume",
+      parentSessionId: String(sessionId),
+      caps: { maxConcurrency: 1 },
+      spentTokens: 0,
+      status: "running",
+    });
+    await f.store.saveSessionEntry({
+      id: "background-task-completed:legacy-resume",
+      sessionID: sessionId,
+      type: "background_task_completed",
+      touchSession: false,
+      time: { created: 1000, updated: 1000 },
+      data: { taskId: "legacy-resume", toolName: "CreateWorkflow", status: "cancelled" },
+    });
+    await f.store.saveSessionEntry({
+      id: "background-task-started:legacy-resume",
+      sessionID: sessionId,
+      type: "background_task_started",
+      touchSession: false,
+      time: { created: 500, updated: 2000 },
+      data: {
+        taskId: "legacy-resume",
+        toolName: "ResumeWorkflowRun",
+        status: "running",
+        startedAt: new Date(500).toISOString(),
+      },
+    });
+    const original = await f.store.sessionEntries({ sessionID: sessionId });
+    await f.reopen();
+    const works = await subscribe(f);
+    assert.equal(works.find((work) => work.workId === "legacy-resume")?.status, "cancelled");
+    assert.deepEqual(await f.store.sessionEntries({ sessionID: sessionId }), original);
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("delayed legacy Started I/O cannot masquerade as a resume after a known terminal", async () => {
+  const f = await fixture("pi");
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    const observations: Array<{ id: string; started: number; terminal: number; saved: number }> =
+      [];
+    for (const journalState of ["absent", "completed", "running"] as const) {
+      const id = `legacy-delayed-${journalState}`;
+      if (journalState !== "absent") {
+        f.store.workflowJournalStore().createRun({
+          runId: id,
+          parentSessionId: String(sessionId),
+          caps: { maxConcurrency: 1 },
+          spentTokens: 0,
+          status: "running",
+        });
+      }
+      const started = background(SessionEventType.BackgroundTaskStarted, id, Date.now(), 1);
+      // Reproduce the original writer: original emission in created, I/O clock in updated,
+      // one stable entry key, no eventTimestamp in old data. No authored clock shortcuts.
+      const saveLegacyStarted = async () => {
+        await f.store.saveSessionEntry({
+          id: `background-task-started:${id}`,
+          sessionID: sessionId,
+          type: "background_task_started",
+          touchSession: false,
+          time: { created: started.timestamp.getTime(), updated: Date.now() },
+          data: {
+            ...(started.payload as Record<string, unknown>),
+            eventId: String(started.id),
+            sequenceNumber: started.sequenceNumber,
+          },
+        });
+      };
+      await saveLegacyStarted();
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      const terminal = background(SessionEventType.BackgroundTaskCompleted, id, Date.now(), 2);
+      await f.store.saveSessionEntry({
+        id: `background-task-completed:${id}`,
+        sessionID: sessionId,
+        type: "background_task_completed",
+        touchSession: false,
+        time: { created: terminal.timestamp.getTime(), updated: Date.now() },
+        data: {
+          ...(terminal.payload as Record<string, unknown>),
+          eventId: String(terminal.id),
+          sequenceNumber: terminal.sequenceNumber,
+        },
+      });
+      if (journalState === "completed") {
+        f.store.workflowJournalStore().updateRunStatus(id, "completed");
+      }
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      await saveLegacyStarted(); // delayed old writer: update time now follows terminal
+      const entry = (await f.store.sessionEntries({ sessionID: sessionId })).find(
+        (row) => row.id === `background-task-started:${id}`,
+      )!;
+      assert.equal(entry.time.created, started.timestamp.getTime());
+      assert.ok(entry.time.updated > terminal.timestamp.getTime());
+      observations.push({
+        id,
+        started: entry.time.created,
+        terminal: terminal.timestamp.getTime(),
+        saved: entry.time.updated,
+      });
+    }
+    const original = await f.store.sessionEntries({ sessionID: sessionId });
+    await f.reopen();
+    const works = await subscribe(f);
+    for (const observation of observations) {
+      assert.equal(
+        works.find((work) => work.workId === observation.id)?.status,
+        "cancelled",
+        JSON.stringify(observation),
+      );
+    }
+    assert.deepEqual(await f.store.sessionEntries({ sessionID: sessionId }), original);
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
