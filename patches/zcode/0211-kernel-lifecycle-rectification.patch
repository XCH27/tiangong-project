+import assert from "node:assert/strict";
+import test from "node:test";
+import { createRootTraceContext, SessionEventType } from "@zcode/contracts";
+import {
+  AgentRuntime as BuiltAgentRuntime,
+  persistBackgroundTaskCompletedEntry,
+  persistBackgroundTaskStartedEntry,
+} from "@zcode/core";
+import {
+  background,
+  fixture,
+  projected,
+  sessionId,
+  subscribe,
+} from "./helpers/cold-workflow-background-fixture.js";
+
+type FixtureRuntimeConstructor = NonNullable<
+  NonNullable<Parameters<typeof fixture>[2]>["runtimeConstructor"]
+>;
+// Source and declaration classes have nominal private fields; use the same public built API.
+const compiledRuntimeConstructor = BuiltAgentRuntime as unknown as FixtureRuntimeConstructor;
+
+function writer(f: Awaited<ReturnType<typeof fixture>>) {
+  return f.runtime;
+}
+function event(type: SessionEventType, id: string, time: number) {
+  return background(type, id, time, 0); // actual Runtime eventStore assigns sequence
+}
+function run(f: Awaited<ReturnType<typeof fixture>>, id: string) {
+  f.store.workflowJournalStore().createRun({
+    runId: id,
+    parentSessionId: String(sessionId),
+    caps: { maxConcurrency: 1 },
+    spentTokens: 0,
+    status: "running",
+  });
+}
+
+test("actual Runtime writer preserves same-epoch resume through clock rollback, SQLite and public Host", async () => {
+  const f = await fixture("pi", false, { runtimeConstructor: compiledRuntimeConstructor });
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    const trace = createRootTraceContext();
+    await writer(f).appendEvent(
+      event(SessionEventType.BackgroundTaskCompleted, "rollback", 2000),
+      trace,
+    );
+    run(f, "rollback");
+    await writer(f).appendEvent(
+      event(SessionEventType.BackgroundTaskStarted, "rollback", 1000),
+      trace,
+    );
+    const entries = await f.store.sessionEntries({ sessionID: sessionId });
+    const completed = entries.find((row) => row.type === "background_task_completed")!
+      .data as Record<string, unknown>;
+    const started = entries.find((row) => row.type === "background_task_started")!.data as Record<
+      string,
+      unknown
+    >;
+    assert.equal(typeof started.eventEpoch, "string");
+    assert.equal(started.eventEpoch, completed.eventEpoch);
+    assert.ok(Number(started.sequenceNumber) > Number(completed.sequenceNumber));
+    assert.ok(Number(started.eventTimestamp) < Number(completed.eventTimestamp));
+    const live = await writer(f).getSessionEventStore().getEvents(sessionId);
+    assert.equal(projected(live)[0]?.status, "running");
+    for (const item of live) assert.equal("eventEpoch" in item, false);
+    assert.equal(
+      (await subscribe(f, "web-remote-replayable", writer(f).getSessionEventStore()))[0]?.status,
+      "running",
+    );
+    await f.reopen();
+    for (const mode of ["web-remote-replayable", "desktop-continuous"] as const) {
+      assert.equal((await subscribe(f, mode))[0]?.status, "running");
+    }
+    assert.deepEqual(await f.store.sessionEntries({ sessionID: sessionId }), entries);
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("new Runtime epoch cannot make a larger reset sequence globally newer after clock rollback", async () => {
+  const f = await fixture("pi", false, { runtimeConstructor: compiledRuntimeConstructor });
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    const trace = createRootTraceContext();
+    await writer(f).appendEvent(
+      event(SessionEventType.BackgroundTaskCompleted, "cross-epoch", 2000),
+      trace,
+    );
+    run(f, "cross-epoch");
+    await f.reopen();
+    // Advance the new namespace without making a new launch for the target.
+    await writer(f).appendEvent(
+      event(SessionEventType.BackgroundTaskCompleted, "other", 900),
+      trace,
+    );
+    await writer(f).appendEvent(
+      event(SessionEventType.BackgroundTaskStarted, "cross-epoch", 1000),
+      trace,
+    );
+    const entries = await f.store.sessionEntries({ sessionID: sessionId });
+    const completed = entries.find((row) => row.id === "background-task-completed:cross-epoch")!
+      .data as Record<string, unknown>;
+    const started = entries.find((row) => row.id === "background-task-started:cross-epoch")!
+      .data as Record<string, unknown>;
+    assert.notEqual(started.eventEpoch, completed.eventEpoch);
+    assert.ok(Number(started.sequenceNumber) > Number(completed.sequenceNumber));
+    await f.reopen();
+    const works = await subscribe(f);
+    assert.equal(works.find((work) => work.workId === "cross-epoch")?.status, "cancelled");
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("standalone persistence without an owner epoch cannot claim comparable cold positive sequences", async () => {
+  const f = await fixture("pi", false, { runtimeConstructor: compiledRuntimeConstructor });
+  try {
+    await f.runtime.ensureSessionPersistedForExternalActivity("fixture");
+    await persistBackgroundTaskCompletedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskCompleted, "no-epoch", 2000, 1),
+    });
+    run(f, "no-epoch");
+    await persistBackgroundTaskStartedEntry({
+      sessionStore: f.store,
+      sessionId,
+      event: background(SessionEventType.BackgroundTaskStarted, "no-epoch", 1000, 99),
+    });
+    await f.reopen();
+    assert.equal((await subscribe(f))[0]?.status, "cancelled");
+    assert.equal(f.requests.length, 0);
+    assert.equal(f.effects, 0);
+  } finally {
+    await f.close();
+  }
+});
