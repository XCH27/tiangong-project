+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import type { Options } from "@anthropic-ai/claude-agent-sdk";
+
+type ClaudeSpawnInput = Parameters<NonNullable<Options["spawnClaudeCodeProcess"]>>[0];
+
+/** Spawn only the existing turn-owned process; the caller retains its close barrier. */
+export function spawnClaudeNativeProcess(
+  input: ClaudeSpawnInput,
+  options: { onStdinWrite?: (chunk: string) => void },
+) {
+  const nativeProcess = spawn(input.command, input.args, {
+    cwd: input.cwd,
+    env: input.env,
+    signal: input.signal,
+    shell: false,
+    detached: process.platform !== "win32",
+    windowsHide: true,
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  if (options.onStdinWrite) {
+    const stdin = nativeProcess.stdin;
+    const write = stdin.write.bind(stdin);
