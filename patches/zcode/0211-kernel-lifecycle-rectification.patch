+import type { ModelInputMessage, NativeAgentTurnRequest } from "@zcode/contracts";
+
+/** Exact existing native thread scope/configuration; owns no live turn or callback state. */
+export function codexThreadParams(
+  request: NativeAgentTurnRequest,
+  messages: ModelInputMessage[],
+  definitions: NativeAgentTurnRequest["tools"],
+) {
+  return {
+    ...(request.continuation ? { threadId: request.continuation.sessionId } : {}),
+    model: request.model.modelId,
+    modelProvider: "openai",
+    cwd: request.workingDirectory,
+    ephemeral: request.persistContinuation !== true,
+    environments: [],
+    selectedCapabilityRoots: [],
+    approvalPolicy: "never",
+    sandbox: "read-only",
+    experimentalRawEvents: true,
+    developerInstructions: messages
+      .filter((message) => message.role === "system")
+      .map((message) =>
+        typeof message.content === "string" ? message.content : JSON.stringify(message.content),
+      )
+      .join("\n\n"),
+    ...(!request.continuation
+      ? {
+          dynamicTools: [
+            {
+              type: "namespace",
+              name: "fleet",
+              description: "Fleet Host operations",
+              tools: definitions.map((tool) => ({
+                type: "function",
+                name: tool.name,
+                description: tool.description ?? "",
+                inputSchema: tool.inputSchema,
+              })),
+            },
+          ],
+        }
+      : {}),
+    config: {
+      "features.code_mode.enabled": false,
+      "features.code_mode.direct_only_tool_namespaces": ["fleet"],
+      "features.plugins": false,
+      "features.skip_host_skill_discovery": true,
+      "features.apps": false,
+      "features.enable_mcp_apps": false,
+      "orchestrator.mcp.enabled": false,
+      "cloud.mcp.enabled": false,
+      "skills.include_instructions": false,
+      project_doc_max_bytes: 0,
+    },
+  };
+}
