@@ -0,0 +1,117 @@
+import assert from "node:assert/strict";
+import { existsSync, readFileSync, rmSync } from "node:fs";
+import test from "node:test";
+import { fixture, selection } from "./helpers/pi-runtime-fixture.js";
+import { ignoredSteerAgent } from "./helpers/acp-ignored-steer-fixture.js";
+import { createAcpNativeAgentPort } from "../../adapters/src/native-agent/acp-turn.js";
+
+const GUIDE = "retain this guidance on the original vendor session";
+for (const decision of ["allow", "deny", "stop"] as const) {
+  test(
+    `generic ACP Guide defers safely through actual stdio (${decision})`,
+    { timeout: 15000 },
+    async () => {
+      const agent = ignoredSteerAgent();
+      const entered = Promise.withResolvers<void>(),
+        release = Promise.withResolvers<void>();
+      const f = await fixture(undefined, true, {
+        nativeExecutor: { kind: "kimi", executable: agent.script, accountId: "fixture" } as never,
+        config: { modelSelection: selection("k3") },
+        deps: { nativeAgentPort: createAcpNativeAgentPort("kimi") },
+      });
+      f.permissionWith(async () => {
+        entered.resolve();
+        await release.promise;
+        return { decision: decision === "deny" ? "deny" : "allow" };
+      });
+      const running = f.runtime.executeTurn("perform original action", [], {
+        intent: { modelSelection: selection("k3"), allowAutomaticModelSelection: false },
+      });
+      const outcome = running.then(
+        (result) => ({ result }),
+        (error: Error) => ({ error: error.message }),
+      );
+      try {
+        await entered.promise;
+        const active = (f.runtime as any).activeTurn;
+        assert.ok(
+          active.hostToolCallbacksOutstanding > 0,
+          "real native approval callback reaches Core admission",
+        );
+        const guide = await f.runtime.steerTurn({
+          input: GUIDE,
+          delivery: "guide",
+          pendingInputId: "original-guide-id",
+        });
+        assert.equal(guide.kind, "queued");
+        assert.equal(
+          active.nativeGuideVendorDeliveredIds?.has("original-guide-id") ?? false,
+          false,
+        );
+        assert.equal(
+          agent.records().filter((entry) => entry.permissionOutcome).length,
+          0,
+          "Guide cannot settle approval",
+        );
+        if (decision === "stop") f.runtime.stopActiveForegroundExecution();
+        release.resolve();
+        const settled = await outcome;
+        const records = agent.records();
+        assert.equal(
+          records.some(
+            (entry) => entry.method === "session/steer" || entry.method === "_session/steering",
+          ),
+          false,
+          "no unnegotiated vendor API",
+        );
+        const prompts = records.filter((entry) => entry.method === "session/prompt");
+        if (decision === "stop") {
+          assert.ok("error" in settled);
+          assert.equal(settled.error, "Turn was cancelled.");
+          assert.equal(prompts.length, 1, "Stop cannot dispatch a Guide continuation");
+          assert.equal(existsSync(agent.effectPath), false, "late allow after Stop cannot mutate");
+        } else {
+          assert.ok("result" in settled);
+          assert.equal(settled.result.response, "GUIDE RECEIVED ONCE");
+          assert.equal(prompts.length, 2, "one original prompt plus one normal Guide fallback");
+          assert.equal(prompts[1]!.params.sessionId, prompts[0]!.params.sessionId);
+          assert.equal(prompts[1]!.params.sessionId, "vendor-original");
+          assert.deepEqual(
+            records.filter((entry) => entry.resumed).map((entry) => entry.resumed),
+            ["vendor-original"],
+          );
+          assert.deepEqual(records.find((entry) => entry.normalFallback)?.normalFallback, [
+            { type: "text", text: GUIDE },
+          ]);
+          assert.deepEqual(records.find((entry) => entry.permissionOutcome)?.permissionOutcome, {
+            outcome: "selected",
+            optionId: decision === "allow" ? "yes" : "no",
+          });
+          assert.equal(existsSync(agent.effectPath), decision === "allow");
+          if (decision === "allow")
+            assert.equal(readFileSync(agent.effectPath, "utf8"), "original effect\n");
+          assert.equal((await (f.runtime as any).rebuildProjection()).pendingSteerInputs.length, 0);
+          await f.reopen();
+          const saved = await f.store.messages({ sessionID: "session" as never });
+          assert.equal(
+            saved
+              .flatMap((message) => message.parts)
+              .filter((part) => part.type === "text" && part.text === GUIDE).length,
+            1,
+            "cold SQLite transcript retains the original Guide once",
+          );
+          assert.equal(
+            agent.records().filter((entry) => entry.method === "session/prompt").length,
+            2,
+            "cold reopen does not replay input",
+          );
+        }
+      } finally {
+        release.resolve();
+        await outcome;
+        await f.close();
+        rmSync(agent.dir, { recursive: true, force: true });
+      }
+    },
+  );
+}
