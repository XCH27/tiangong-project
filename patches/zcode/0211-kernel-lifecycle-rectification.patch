@@ -0,0 +1,81 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { MessageChannel } from "node:worker_threads";
+import { SqliteSessionStore } from "../../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { ZCodeProtocolClient } from "../../../../../../packages/services/src/zcode-agent/zcodeProtocolClient.js";
+import { zcodeSessionPersistRemoteHostAttachmentStopResultSchema, type ZCodeRemoteHostAttachmentStopReceipt } from "@zcode/shared";
+
+export async function receiptFixture() {
+  const root = await mkdtemp(join(tmpdir(), "zcode-remote-receipts-"));
+  const dbPath = join(root, "session.sqlite");
+  const store = new SqliteSessionStore({ dbPath });
+  let storeClosed = false;
+  for (const id of ["conversation-a", "conversation-b"]) {
+    await store.createSession({
+      id: id as never, projectID: "fixture" as never, slug: id,
+      directory: root, title: id, version: "fixture",
+    });
+  }
+  const server = new ZCodeProtocolAgentServer({
+    cwd: root, version: "fixture", sessionStore: store,
+    createZCodeApp: async () => { throw new Error("Receipt writes must not start inference"); },
+  } as never);
+  const { port1, port2 } = new MessageChannel();
+  let holdAcknowledgements = false;
+  let heldSessionId: string | undefined;
+  const heldAcknowledgements: unknown[] = [];
+  const receiptSaved = Promise.withResolvers<void>();
+  port2.on("message", async (message) => {
+    const response = await server.handleMessage(message);
+    if (response && holdAcknowledgements && (!heldSessionId || message.params?.sessionId === heldSessionId)) {
+      heldAcknowledgements.push(response); receiptSaved.resolve();
+    } else if (response) port2.postMessage(response);
+  });
+  const client = new ZCodeProtocolClient({
+    kind: "memory",
+    onMessage(listener) {
+      port1.on("message", listener);
+      return { dispose: () => { port1.off("message", listener); } };
+    },
+    onClose(listener) {
+      const closed = () => listener({ reason: "fixture closed" });
+      port1.on("close", closed);
+      return { dispose: () => { port1.off("close", closed); } };
+    },
+    async send(message) { port1.postMessage(message); },
+    dispose() { port1.close(); port2.close(); },
+  }, { requestTimeoutMs: 1_000 });
+  const receipt = {
+    remoteSessionId: "shared-remote", reason: "session_detach" as const,
+    targetKind: "ssh" as const, attachmentIds: ["desktop", "mobile"], stoppedAt: 1_000,
+  };
+  return {
+    store, dbPath, receipt,
+    reopen() {
+      store.close(); storeClosed = true;
+      return new SqliteSessionStore({ dbPath });
+    },
+    holdAcknowledgements(sessionId?: string) {
+      holdAcknowledgements = true; heldSessionId = sessionId;
+      return receiptSaved.promise;
+    },
+    releaseAcknowledgements() {
+      holdAcknowledgements = false;
+      for (const acknowledgement of heldAcknowledgements.splice(0)) port2.postMessage(acknowledgement);
+    },
+    pendingRequests: () => client.pendingRequestCount,
+    write: (sessionId: string, value: ZCodeRemoteHostAttachmentStopReceipt = receipt,
+      options?: { signal?: AbortSignal }) => client.request(
+      "session/persistRemoteHostAttachmentStop", { sessionId, receipt: value },
+      zcodeSessionPersistRemoteHostAttachmentStopResultSchema, options,
+    ),
+    async close() {
+      client.dispose(); server.disposeProjections();
+      if (!storeClosed) store.close();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
