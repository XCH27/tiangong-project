+++ b/packages/services/test/page-assistant-memory-recovery.test.ts
@@ -0,0 +1,92 @@
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import test from "node:test";
+
+test("Agent memory preference survives actual account-record recovery", async () => {
+  const originalHome = process.env.ZCODE_DESKTOP_HOME_DIR;
+  const originalData = process.env.ZCODE_DATA_BASE_DIR;
+  const dir = await mkdtemp(join(tmpdir(), "memory-parity-"));
+  process.env.ZCODE_DESKTOP_HOME_DIR = dir;
+  process.env.ZCODE_DATA_BASE_DIR = join(dir, "data");
+  const root = new URL("../src", import.meta.url).pathname;
+  const { createSettingService } = await import(root + "/setting/settingService.ts");
+  const { createOnboardingRecordService } = await import(
+    root + "/onboarding/onboardingRecordService.ts"
+  );
+  const { createPageAssistantService } = await import(
+    root + "/page-assistant/pageAssistantService.ts"
+  );
+  const { getAppConfigDir } = await import(root + "/paths.ts");
+  assert.ok(getAppConfigDir().startsWith(dir));
+  const setting = createSettingService();
+  let userId = "synthetic-A";
+  const record = createOnboardingRecordService({
+    loadUserId: async () => userId,
+    hasExistingLocalTask: async () => false,
+  });
+  const entry = {
+    occupation: "other",
+    interfaceMode: "office",
+    memoryEnabled: false,
+    proactiveSuggestionsEnabled: false,
+    completedAt: "2026-10-11T00:00:00Z",
+  };
+  try {
+    await record.appendRecord("synthetic-device", entry);
+    userId = "synthetic-B";
+    await record.appendRecord("synthetic-device", entry);
+    userId = "synthetic-A";
+    await setting.update({ memoryEnabled: false });
+    const service = createPageAssistantService({
+      settingService: setting,
+      onboardingRecordService: record,
+      modelSelectionService: {} as never,
+      providerSettingsService: {} as never,
+      workspacePath: () => dir,
+    });
+    await service.perform(
+      { feature: "app-page", pageId: "memory" },
+      { operation: "set-preference", key: "memoryEnabled", value: true, expectedValue: false },
+    );
+    assert.equal((await setting.get()).memoryEnabled, true);
+    assert.equal((await record.getLatestEntry())?.memoryEnabled, true);
+    userId = "synthetic-B";
+    await setting.update((await record.syncSettingsFromRecord())!);
+    userId = "synthetic-A";
+    await setting.update((await record.syncSettingsFromRecord())!);
+    console.log(
+      JSON.stringify({
+        case: "actual services and temporary setting/onboarding files",
+        afterAgentCommit: true,
+        onboardingPreferenceAfterAgentCommit: (await record.getLatestEntry())?.memoryEnabled,
+        afterAtoBtoA: (await setting.get()).memoryEnabled,
+      }),
+    );
+    assert.equal(
+      (await setting.get()).memoryEnabled,
+      true,
+      "Agent preference must survive account recovery",
+    );
+    await setting.update({ memoryEnabled: true });
+    await record.updateRecordPreferences({ memoryEnabled: true });
+    userId = "synthetic-B";
+    await setting.update((await record.syncSettingsFromRecord())!);
+    userId = "synthetic-A";
+    await setting.update((await record.syncSettingsFromRecord())!);
+    assert.equal((await setting.get()).memoryEnabled, true);
+    console.log(
+      JSON.stringify({
+        case: "same current human writer sequence control",
+        afterAtoBtoA: (await setting.get()).memoryEnabled,
+      }),
+    );
+  } finally {
+    if (originalHome === undefined) delete process.env.ZCODE_DESKTOP_HOME_DIR;
+    else process.env.ZCODE_DESKTOP_HOME_DIR = originalHome;
+    if (originalData === undefined) delete process.env.ZCODE_DATA_BASE_DIR;
+    else process.env.ZCODE_DATA_BASE_DIR = originalData;
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/packages/services/test/staged-agent-receipt-recovery.test.ts b/packages/services/test/staged-agent-receipt-recovery.test.ts
new file mode 100644
index 00000000..9d02459f
--- /dev/null
+++ b/packages/services/test/staged-agent-receipt-recovery.test.ts
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn } from "node:child_process";
+import { mkdtemp, mkdir, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { SqliteSessionStore } from "../../../apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.js";
+import { ZCodeProtocolClient } from "../src/zcode-agent/zcodeProtocolClient.js";
+import { ZCodeStdioTransport } from "../src/zcode-agent/zcodeStdioTransport.js";
+import { zcodeSessionPersistRemoteHostAttachmentStopResultSchema } from "@zcode/shared";
+
+// Runs only after the current desktop CLI has actually been built and staged.
+test(
+  "staged CLI persists separate Session receipts through EOF and a new process",
+  { timeout: 40000 },
+  async () => {
+    const root = resolve(dirname(fileURLToPath(import.meta.url)), "../../..");
+    const bundle = join(
+      root,
+      "packages/desktop/bundled-agents",
+      `${process.platform}-${process.arch}`,
+      "glm/zcode.cjs",
+    );
+    const dir = await mkdtemp(join(tmpdir(), "staged-receipt-recovery-"));
+    const dbPath = join(dir, "sessions.sqlite");
+    const workspace = join(dir, "workspace");
+    await mkdir(workspace);
+    let store = new SqliteSessionStore({ dbPath });
+    for (const id of ["conversation-a", "conversation-b"]) {
+      await store.createSession({
+        id: id as never,
+        projectID: "fixture" as never,
+        slug: id,
+        directory: workspace,
+        title: id,
+        version: "fixture",
+      });
+    }
+    store.close();
+    let reopened = false;
+    const receipt = {
+      remoteSessionId: "one-remote",
+      reason: "session_detach" as const,
+      attachmentIds: [],
+      stoppedAt: 1770000000000,
+      phase: "settled" as const,
+    };
+    async function run(write: boolean) {
+      const started = Date.now();
+      const child = spawn(
+        process.env.ZCODE_STAGED_TEST_NODE || process.execPath,
+        [bundle, "app-server", "--stdio"],
+        {
+          cwd: workspace,
+          detached: process.platform !== "win32",
+          stdio: ["pipe", "pipe", "pipe"],
+          // Deliberately supply no account/API credentials and no production profile.
+          env: {
+            PATH: process.env.PATH,
+            TMPDIR: process.env.TMPDIR,
+            ZCODE_HOME: join(dir, "home"),
+            ZCODE_STORAGE_DIR: join(dir, "storage"),
+            ZCODE_SESSION_DB: dbPath,
+            ZCODE_DATA_BASE_DIR: join(dir, "data"),
+            ZCODE_DESKTOP_HOME_DIR: join(dir, "desktop-home"),
+            ZCODE_BUILTIN_PROVIDER_CONFIG_FILE: join(root, "config/provider/zcode-builtin.json"),
+            ZCODE_PERSONAL_PROVIDER_CONFIG_FILE: join(dir, "absent-provider-config.json"),
+          },
+        },
+      );
+      const transport = new ZCodeStdioTransport(child, {
+        ownedProcessStartedAtMs: started,
+        ...(process.platform === "win32" ? {} : { ownedProcessGroupId: child.pid }),
+      });
+      const client = new ZCodeProtocolClient(transport, { requestTimeoutMs: 10000 });
+      const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>(
+        (resolve, reject) => {
+          child.once("error", reject);
+          child.once("exit", (code, signal) => resolve({ code, signal }));
+        },
+      );
+      const timer = setTimeout(() => child.kill("SIGKILL"), 20000);
+      try {
+        for (const sessionId of write
+          ? ["unsent-draft", "conversation-a", "conversation-b", "conversation-a"]
+          : ["conversation-a", "conversation-b"]) {
+          const result = await client.request(
+            "session/persistRemoteHostAttachmentStop",
+            { sessionId, receipt },
+            zcodeSessionPersistRemoteHostAttachmentStopResultSchema,
+          );
+          assert.equal(result.persisted, sessionId !== "unsent-draft");
+        }
+        await client.disposeAndWait();
+        assert.deepEqual(await exited, { code: 0, signal: null });
+      } finally {
+        clearTimeout(timer);
+        await transport.disposeAndWait();
+        client.dispose();
+      }
+    }
+    try {
+      await run(true);
+      await run(false); // Reuse the same database from a cold, newly staged process.
+      store = new SqliteSessionStore({ dbPath });
+      reopened = true;
+      const a = await store.sessionEntries({
+        sessionID: "conversation-a" as never,
+        type: "remote_host_attachment_stop",
+      });
+      const b = await store.sessionEntries({
+        sessionID: "conversation-b" as never,
+        type: "remote_host_attachment_stop",
+      });
+      assert.equal(a.length, 1);
+      assert.equal(b.length, 1);
+      assert.notEqual(a[0]!.id, b[0]!.id);
+      assert.equal((a[0]!.data as { phase: string }).phase, "settled");
+      assert.equal(await store.getSession("unsent-draft" as never), null);
+      assert.equal(
+        (await store.messages({ sessionID: "conversation-a" as never })).length,
+        0,
+        "receipt recovery must not execute or replay a model input",
+      );
+    } finally {
+      if (reopened) store.close();
+      await rm(dir, { recursive: true, force: true });
+    }
+  },
+);
diff --git a/packages/services/test/zcode-stdio-shutdown-settlement.test.ts b/packages/services/test/zcode-stdio-shutdown-settlement.test.ts
new file mode 100644
index 00000000..48b67afc
--- /dev/null
+++ b/packages/services/test/zcode-stdio-shutdown-settlement.test.ts
@@ -0,0 +1,154 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn } from "node:child_process";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+import { ZCodeStdioTransport } from "../src/zcode-agent/zcodeStdioTransport.js";
+import { SqliteSessionStore } from "../../../apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.js";
+
+/** Actual parent transport/owned process tree → actual App/CLI → durable SQLite. */
+async function closeThroughTransport(mode: "slow-known" | "failed" | "hung") {
+  const logs = await mkdtemp(join(tmpdir(), "parent-stdio-shutdown-"));
+  const marker = join(logs, "session-path.json");
+  const entry = resolve(
+    dirname(fileURLToPath(import.meta.url)),
+    "../../../apps/zcode-cli/packages/bootstrap/test/helpers/protocol-shutdown-child.ts",
+  );
+  const env = { ...process.env, ZCODE_E2E_COVERAGE: "0" };
+  delete env.NODE_TEST_CONTEXT;
+  const startedAt = Date.now();
+  const child = spawn(
+    process.execPath,
+    [resolve("node_modules/tsx/dist/cli.mjs"), entry, marker, mode, "--protocol-frames"],
+    {
+      stdio: ["pipe", "pipe", "pipe"],
+      detached: process.platform !== "win32",
+      env,
+    },
+  );
+  const transport = new ZCodeStdioTransport(child, {
+    ownedProcessStartedAtMs: startedAt,
+    ...(process.platform === "win32" ? {} : { ownedProcessGroupId: child.pid }),
+  });
+  const ready = Promise.withResolvers<void>();
+  const stages: string[] = [],
+    protocolCloses: unknown[] = [];
+  let output = "";
+  transport.onMessage((message) => {
+    if ("method" in message && message.method === "fixture/shutdown") {
+      const stage = (message.params as { stage: string }).stage;
+      stages.push(stage);
+      if (stage === "READY_FOR_EOF") ready.resolve();
+    }
+  });
+  transport.onClose((event) => {
+    protocolCloses.push(event);
+  });
+  child.stdout.on("data", (data) => {
+    output += data.toString();
+  });
+  child.stderr.on("data", (data) => {
+    output += data.toString();
+  });
+  // The actual manager observes this independently of protocol/resource disposal.
+  const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>(
+    (resolve, reject) => {
+      child.once("error", reject);
+      child.once("exit", (code, signal) => resolve({ code, signal }));
+    },
+  );
+  const timer = setTimeout(() => child.kill("SIGKILL"), 25000);
+  try {
+    await Promise.race([
+      ready.promise,
+      exited.then((event) => {
+        throw new Error(`Child exited before readiness: ${JSON.stringify(event)}\n${output}`);
+      }),
+    ]);
+    assert.deepEqual(protocolCloses, [], "readiness is a valid protocol frame");
+    const eofAt = Date.now();
+    // No manual stdin.end: production parent transport alone requests EOF and joins ownership.
+    await transport.disposeAndWait();
+    const outcome = await exited;
+    const { dir } = JSON.parse(await readFile(marker, "utf8")) as { dir: string };
+    return {
+      outcome,
+      elapsed: Date.now() - eofAt,
+      stages,
+      output,
+      dir,
+      async dispose() {
+        await rm(dir, { recursive: true, force: true });
+        await rm(logs, { recursive: true, force: true });
+      },
+    };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+for (const mode of ["slow-known", "failed", "hung"] as const) {
+  test(
+    `actual stdio parent retains truthful ${mode} shutdown and cold receipts`,
+    { timeout: 30000 },
+    async () => {
+      const result = await closeThroughTransport(mode);
+      try {
+        assert.equal(result.outcome.signal, null, result.output);
+        assert.equal(result.outcome.code, mode === "slow-known" ? 0 : 1, result.output);
+        assert.equal(
+          await readFile(join(result.dir, "effect-count.txt"), "utf8"),
+          "effect\n",
+          "no effect replay",
+        );
+        assert.equal(await readFile(join(result.dir, "effect.txt"), "utf8"), "committed once");
+        if (mode === "slow-known") {
+          assert.ok(result.elapsed >= 2200 && result.elapsed < 7500, result.output);
+          assert.match(result.output, /ACTUAL_SETTLEMENT_COMPLETED/);
+        } else if (mode === "hung") {
+          assert.ok(result.elapsed >= 5900 && result.elapsed < 10000, result.output);
+          assert.doesNotMatch(result.output, /ACTUAL_SETTLEMENT_COMPLETED/);
+        }
+        const store = new SqliteSessionStore({ dbPath: join(result.dir, "session.sqlite") });
+        try {
+          const receipts = await store.sessionEntries({
+            sessionID: "session" as never,
+            type: "runtime/late_tool_settlement",
+          });
+          const parts = (await store.messages({ sessionID: "session" as never }))
+            .flatMap((message) => message.parts)
+            .filter((part) => part.type === "tool");
+          assert.equal(parts.length, 1);
+          if (mode === "slow-known") {
+            assert.equal(receipts.length, 1);
+            assert.equal((receipts[0]!.data as any).pending, false);
+            assert.equal(parts[0]!.state.status, "completed");
+          } else if (mode === "hung") {
+            assert.equal(receipts.length, 0);
+            assert.equal(parts[0]!.state.status, "error");
+            assert.equal(
+              parts[0]!.state.metadata?.lateSettlement,
+              "pending",
+              "forced termination cannot invent completion",
+            );
+          }
+        } finally {
+          store.close();
+        }
+        const db = new DatabaseSync(join(result.dir, "session.sqlite"), { readOnly: true });
+        try {
+          const rows = db.prepare("select status from tool_usage").all();
+          assert.equal(rows.length, 1);
+          assert.equal(rows[0]!.status, mode === "hung" ? "cancelled" : "completed");
+        } finally {
+          db.close();
+        }
+      } finally {
+        await result.dispose();
+      }
+    },
+  );
+}
