+  const out = join(temporary, "manager.mjs");
+  await build({
+    entryPoints: [base + "/packages/desktop/src/main/desktopRemoteSessions.ts"],
+    outfile: out,
+    bundle: true,
+    platform: "node",
+    format: "esm",
+    logLevel: "silent",
+    plugins: [
+      {
+        name: "review-electron",
+        setup(b) {
+          b.onResolve({ filter: /^electron$/ }, () => ({ path: "electron", namespace: "review" }));
+          b.onLoad({ filter: /.*/, namespace: "review" }, () => ({
+            contents:
+              "export const BrowserWindow = globalThis.__remoteReviewElectron.BrowserWindow; export const MessageChannelMain = globalThis.__remoteReviewElectron.MessageChannelMain;",
+          }));
+        },
+      },
+    ],
+  });
+  globalThis.__remoteReviewElectron = {
+    BrowserWindow: {
+      fromId() {
+        return undefined;
+      },
+    },
+    MessageChannelMain: MessageChannel,
+  };
+  const { createRemoteWorkspaceSessionManager } = await import(out);
+  const logger = { info() {}, warn() {}, error() {} };
+  const messages = [],
+    ports = [];
+  let manager;
+  function child(id) {
+    const emitter = new EventEmitter();
+    return Object.assign(emitter, {
+      pid: id,
+      postMessage(msg, transfer) {
+        messages.push({ hostWindow: id, ...msg });
+        if (transfer) ports.push(...transfer);
+        if (msg.type === "connect-remote-workspace")
+          queueMicrotask(() =>
+            emitter.emit("message", {
+              type: "remote-workspace-connected",
+              requestId: msg.requestId,
+              descriptor: {
+                remoteSessionId: "remote-window-" + id,
+                target: msg.target,
+                workspacePath: msg.workspacePath,
+                workspaceIdentity: msg.workspaceIdentity,
+                generation: 1,
+              },
+            }),
+          );
+      },
+    });
+  }
+  const children = new Map([
+    [1, child(1)],
+    [2, child(2)],
+  ]);
+  function win(id) {
+    return {
+      isDestroyed: () => false,
+      webContents: {
+        id,
+        isDestroyed: () => false,
+        send() {},
+        postMessage(_channel, payload, transfer) {
+          ports.push(...transfer);
+          queueMicrotask(() =>
+            manager.confirmRendererAttachmentReady(id, {
+              sessionId: payload.sessionId,
+              attachmentId: payload.attachmentId,
+            }),
+          );
+        },
+      },
+    };
+  }
+  manager = createRemoteWorkspaceSessionManager({
+    logger,
+    windowHostProcessMap: children,
+    resolveRemoteAssetDirs: () => ({}),
+    createMessageChannel: () => new MessageChannel(),
+    providerProvisioningCoordinator: {
+      register() {
+        return { dispose() {}, initialSync: Promise.resolve() };
+      },
+    },
+    rendererAttachmentReadyTimeoutMs: 1000,
+  });
+  try {
+    const target = { kind: "ssh", host: "review.example.invalid", username: "review", port: 22 };
+    const sid = await manager.createRemoteWorkspaceSession(win(1), target, "review-connect", {
+      workspacePath: "/fixture",
+      workspaceIdentity: "review-workspace",
+    });
+    let bindError;
+    try {
+      await manager.bindRemoteWorkspaceSessionContext(
+        sid,
+        { workspacePath: "/fixture", workspaceIdentity: "review-workspace" },
+        2,
+      );
+    } catch (e) {
+      bindError = e.message;
+    }
+    assert.match(bindError, /不属于当前窗口/);
+    const source = await readFile(
+      base + "/packages/desktop/src/main/desktopMainIpcRemote.ts",
+      "utf8",
+    );
+    const first = source.indexOf("ipcMain.handle(PlatformChannels.DisposeRemoteSession,");
+    const last = source.indexOf("\n  });", first) + 7;
+    const exact = source.slice(first, last);
+    let handler;
+    vm.runInNewContext(
+      ts.transpileModule(exact, {
+        compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS },
+      }).outputText,
+      {
+        ipcMain: {
+          handle(_channel, h) {
+            handler = h;
+          },
+        },
+        PlatformChannels: { DisposeRemoteSession: "review-dispose" },
+        options: { disposeRemoteWorkspaceSession: manager.disposeRemoteWorkspaceSession },
+      },
+    );
+    const before = messages.length;
+    await assert.rejects(handler({ sender: { id: 2 } }, sid), /不属于当前窗口/);
+    assert.equal(messages.length, before, "foreign window cannot detach or stop resources");
+    await handler({ sender: { id: 1 } }, sid);
+    assert.ok(messages.slice(before).some((m) => m.type === "dispose-remote-workspace-session"));
+  } finally {
+    for (const p of ports) p.close();
+    await manager.disposeAllAndWaitForAppShutdown("fixture");
+    delete globalThis.__remoteReviewElectron;
+    await rm(temporary, { recursive: true, force: true });
+  }
+});
