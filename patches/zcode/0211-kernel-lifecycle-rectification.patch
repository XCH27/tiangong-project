+import assert from "node:assert/strict";
+import test from "node:test";
+import { receiptFixture } from "./helpers/remote-host-stop-receipts-fixture.js";
+import { createRemoteHostAttachmentStopSessionGlue } from "../../../../../packages/desktop/src/host/remoteHostAttachmentStopSessionGlue.js";
+import { createRemoteHostAttachmentStopProductWiring } from "../../../../../packages/desktop/src/host/remoteHostAttachmentStopProductWiring.js";
+
+test("a rejected Session close retains its receipt writer and binding for the actual owner's retry", async () => {
+  const f = await receiptFixture();
+  const glue = createRemoteHostAttachmentStopSessionGlue();
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  wiring.installPersistRouter();
+  const service = wiring.wrapSessionService({
+    async createSession() { return { session: { sessionId: "conversation-a" } }; },
+    async resumeSession() { return { session: { sessionId: "conversation-a" } }; },
+    async closeSession() { throw new Error("fixture App close incomplete"); },
+  }, { persistViaAgent: ({ sessionId, receipt }) => f.write(sessionId, receipt) });
+  const params = { remoteSessionId: "remote-close", sessionId: "conversation-a", workspacePath: "fixture" };
+  try {
+    await service.resumeSession(params);
+    await assert.rejects(service.closeSession(params), /fixture App close incomplete/);
+    assert.deepEqual(glue.listBoundSessionIds(params.remoteSessionId), [params.sessionId]);
+    assert.deepEqual(wiring.listPersistSessionIds(), [params.sessionId]);
+    const saved = await glue.notifyStopped({ remoteSessionId: params.remoteSessionId,
+      reason: "session_detach", attachmentIds: [] });
+    assert.deepEqual(saved.writtenSessionIds, [params.sessionId]);
+    assert.equal((await f.store.sessionEntries({ sessionID: params.sessionId as never })).length, 1);
+  } finally { wiring.clear(); await f.close(); }
+});
+
+test("a delayed old close acknowledgement cannot remove the resumed Session's receipt writer", async () => {
+  const f = await receiptFixture();
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const glue = createRemoteHostAttachmentStopSessionGlue();
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  wiring.installPersistRouter();
+  const service = wiring.wrapSessionService({
+    async createSession() { return { session: { sessionId: "conversation-a" } }; },
+    async resumeSession() { return { session: { sessionId: "conversation-a" } }; },
+    async closeSession() { entered.resolve(); await release.promise; },
+  }, { persistViaAgent: ({ sessionId, receipt }) => f.write(sessionId, receipt) });
+  const params = { remoteSessionId: "remote-resumed", sessionId: "conversation-a", workspacePath: "fixture" };
+  let closing: Promise<void> | undefined;
+  try {
+    await service.resumeSession(params);
+    closing = service.closeSession(params);
+    await entered.promise;
+    await service.resumeSession(params);
+    release.resolve(); await closing;
+    assert.deepEqual(glue.listBoundSessionIds(params.remoteSessionId), [params.sessionId]);
+    assert.deepEqual(wiring.listPersistSessionIds(), [params.sessionId]);
+    const saved = await glue.notifyStopped({ remoteSessionId: params.remoteSessionId,
+      reason: "session_detach", attachmentIds: [] });
+    assert.deepEqual(saved.writtenSessionIds, [params.sessionId]);
+  } finally { release.resolve(); await closing; wiring.clear(); await f.close(); }
+});
