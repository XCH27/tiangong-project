@@ -0,0 +1,126 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn } from "node:child_process";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+
+async function child(mode: string) {
+  const logs = await mkdtemp(join(tmpdir(), "protocol-shutdown-proof-"));
+  const marker = join(logs, "session-path.json");
+  const entry = join(dirname(fileURLToPath(import.meta.url)), "helpers/protocol-shutdown-child.ts");
+  // A production child must not inherit node:test's stdout serialization context.
+  const env = { ...globalThis.process.env, ZCODE_E2E_COVERAGE: "0" };
+  delete env.NODE_TEST_CONTEXT;
+  const process = spawn(
+    globalThis.process.execPath,
+    [resolve("node_modules/tsx/dist/cli.mjs"), entry, marker, mode],
+    {
+      stdio: ["pipe", "pipe", "pipe"],
+      env,
+    },
+  );
+  let output = "",
+    ended = false,
+    eofAt = 0;
+  process.stdout.on("data", (data) => {
+    output += data.toString();
+    if (!ended && output.includes("READY_FOR_EOF")) {
+      ended = true;
+      eofAt = Date.now();
+      process.stdin.end();
+    }
+  });
+  process.stderr.on("data", (data) => {
+    output += data.toString();
+  });
+  const timeout = setTimeout(() => process.kill("SIGKILL"), 20000);
+  let code: number | null;
+  try {
+    code = await new Promise<number | null>((resolve, reject) => {
+      process.once("error", reject);
+      process.once("close", resolve);
+    });
+  } finally {
+    clearTimeout(timeout);
+  }
+  assert.equal(ended, true, output);
+  const { dir } = JSON.parse(await readFile(marker, "utf8")) as { dir: string };
+  return {
+    code,
+    output,
+    elapsed: Date.now() - eofAt,
+    dir,
+    async dispose() {
+      await rm(dir, { recursive: true, force: true });
+      await rm(logs, { recursive: true, force: true });
+    },
+  };
+}
+
+test(
+  "real App/Protocol/CLI EOF retains a 2200 ms known receipt write through cold SQLite reopen",
+  { timeout: 20000 },
+  async () => {
+    const result = await child("slow-known");
+    try {
+      assert.equal(result.code, 0, result.output);
+      assert.match(result.output, /KNOWN_RECEIPT_WRITE_PENDING/);
+      assert.match(result.output, /ACTUAL_SETTLEMENT_COMPLETED/);
+      assert.ok(result.elapsed >= 2200);
+      assert.equal(await readFile(join(result.dir, "effect.txt"), "utf8"), "committed once");
+      const store = new SqliteSessionStore({ dbPath: join(result.dir, "session.sqlite") });
+      try {
+        const receipts = await store.sessionEntries({
+          sessionID: "session" as never,
+          type: "runtime/late_tool_settlement",
+        });
+        assert.equal(receipts.length, 1);
+        assert.equal((receipts[0]!.data as any).pending, false);
+        const tools = (await store.messages({ sessionID: "session" as never }))
+          .flatMap((message) => message.parts)
+          .filter((part) => part.type === "tool");
+        assert.equal(tools.length, 1);
+        assert.equal(tools[0]!.state.status, "completed");
+      } finally {
+        store.close();
+      }
+      const db = new DatabaseSync(join(result.dir, "session.sqlite"), { readOnly: true });
+      try {
+        assert.equal(db.prepare("select status from tool_usage").get()!.status, "completed");
+      } finally {
+        db.close();
+      }
+    } finally {
+      await result.dispose();
+    }
+  },
+);
+
+test("cleanup failure upgrades an initial EOF zero to nonzero", { timeout: 20000 }, async () => {
+  const result = await child("failed");
+  try {
+    assert.equal(result.code, 1, result.output);
+    assert.match(result.output, /CLEANUP_INCOMPLETE/);
+  } finally {
+    await result.dispose();
+  }
+});
+
+test(
+  "non-settling owned cleanup retains a finite nonzero CLI termination",
+  { timeout: 20000 },
+  async () => {
+    const result = await child("hung");
+    try {
+      assert.equal(result.code, 1, result.output);
+      assert.ok(result.elapsed >= 5900 && result.elapsed < 9000, result.output);
+      assert.doesNotMatch(result.output, /ACTUAL_SETTLEMENT_COMPLETED/);
+    } finally {
+      await result.dispose();
+    }
+  },
+);
