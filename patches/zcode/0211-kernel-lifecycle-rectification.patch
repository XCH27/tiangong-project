index 00000000..f87dd569
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/background-task-lifecycle-order.ts
@@ -0,0 +1,123 @@
+import { SessionEventType, type SessionEvent } from "../deps.js";
+
+type SequenceEvidence = { epoch: string; sequence: number };
+type LifecycleEntry = { data: unknown; time: { created: number; updated?: number } };
+const eventSequenceEvidence = new WeakMap<SessionEvent, SequenceEvidence>();
+const EPOCH_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+function sequenceEvidence(epoch: unknown, sequence: unknown): SequenceEvidence | undefined {
+  return typeof epoch === "string" &&
+    EPOCH_PATTERN.test(epoch) &&
+    typeof sequence === "number" &&
+    Number.isSafeInteger(sequence) &&
+    sequence > 0
+    ? { epoch, sequence }
+    : undefined;
+}
+
+function entrySequenceEvidence(entry: LifecycleEntry): SequenceEvidence | undefined {
+  const data = entry.data as { eventEpoch?: unknown; sequenceNumber?: unknown } | undefined;
+  return sequenceEvidence(data?.eventEpoch, data?.sequenceNumber);
+}
+
+/** Derive ordering from the original owner; never serialize fields onto the public event. */
+export function backgroundTaskSequenceMetadata(
+  event: SessionEvent,
+  epoch?: string,
+): { eventEpoch?: string } {
+  const evidence = sequenceEvidence(epoch, event.sequenceNumber);
+  if (!evidence) return {};
+  eventSequenceEvidence.set(event, evidence);
+  return { eventEpoch: evidence.epoch };
+}
+
+export function retainBackgroundTaskEntrySequence(
+  event: SessionEvent,
+  entry: LifecycleEntry,
+): void {
+  const evidence = entrySequenceEvidence(entry);
+  if (evidence) eventSequenceEvidence.set(event, evidence);
+}
+
+function compareOrder(
+  leftTime: number,
+  rightTime: number,
+  left?: SequenceEvidence,
+  right?: SequenceEvidence,
+  leftLiveSequence = 0,
+  rightLiveSequence = 0,
+): number {
+  // 同一原执行者的序号才是顺序证明；时钟回拨不能使后发恢复启动变成旧事件。
+  if (left && right && left.epoch === right.epoch) return left.sequence - right.sequence;
+  // 未标记的正 seq 只来自同一 getEvents live 源；冷合成必须保持 public seq=0。
+  if (
+    !left &&
+    !right &&
+    Number.isSafeInteger(leftLiveSequence) &&
+    Number.isSafeInteger(rightLiveSequence) &&
+    leftLiveSequence > 0 &&
+    rightLiveSequence > 0
+  ) {
+    return leftLiveSequence - rightLiveSequence;
+  }
+  // 跨 epoch / 不确定冷证据不能比较全局正序号；同刻不确定仍保护终态。
+  return Number.isFinite(leftTime) && Number.isFinite(rightTime) ? leftTime - rightTime : 0;
+}
+
+export function compareBackgroundTaskEventOrder(left: SessionEvent, right: SessionEvent): number {
+  return compareOrder(
+    left.timestamp?.getTime?.(),
+    right.timestamp?.getTime?.(),
+    eventSequenceEvidence.get(left),
+    eventSequenceEvidence.get(right),
+    left.sequenceNumber,
+    right.sequenceNumber,
+  );
+}
+
+export function compareBackgroundTaskEntryToEvent(
+  entry: LifecycleEntry,
+  event: SessionEvent,
+): number {
+  return compareOrder(
+    backgroundTaskEntryEventTime(entry),
+    event.timestamp?.getTime?.(),
+    entrySequenceEvidence(entry),
+    eventSequenceEvidence.get(event),
+  );
+}
+
+export function currentBackgroundTaskEvents(
+  events: readonly SessionEvent[] | undefined,
+  sessionId: string,
+): Map<string, SessionEvent> {
+  const current = new Map<string, SessionEvent>();
+  for (const event of events ?? []) {
+    if (String(event.sessionId) !== sessionId) continue;
+    if (
+      event.type !== SessionEventType.BackgroundTaskStarted &&
+      event.type !== SessionEventType.BackgroundTaskUpdated &&
+      event.type !== SessionEventType.BackgroundTaskCompleted
+    )
+      continue;
+    const taskId = (event.payload as { taskId?: unknown } | undefined)?.taskId;
+    if (typeof taskId !== "string" || taskId.length === 0) continue;
+    const previous = current.get(taskId);
+    const order = previous ? compareBackgroundTaskEventOrder(event, previous) : 1;
+    if (
+      !previous ||
+      order > 0 ||
+      (order === 0 && event.type === SessionEventType.BackgroundTaskCompleted)
+    )
+      current.set(taskId, event);
+  }
+  return current;
+}
+
+/** Old upsert update time is only an I/O clock; it cannot prove a new emission. */
+export function backgroundTaskEntryEventTime(entry: LifecycleEntry): number {
+  const recorded = (entry.data as { eventTimestamp?: unknown } | undefined)?.eventTimestamp;
+  if (typeof recorded === "number" && Number.isFinite(recorded)) return recorded;
+  // 旧 upsert 的 updated 是落库时钟：迟到的旧写入也会更大，不能拿它发明一次恢复启动。
+  return entry.time.created;
+}
