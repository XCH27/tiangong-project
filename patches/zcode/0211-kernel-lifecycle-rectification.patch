+import { appendFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { shutdownAppFixture } from "./shutdown-app-fixture.js";
+import { reply } from "../../../core/test/helpers/pi-runtime-fixture.js";
+import { createProtocolProcessLifecycle } from "../../../cli/src/protocol-lifecycle.js";
+import { ProtocolRuntimeResources } from "../../src/zcode-protocol/runtime-resources.js";
+import { cleanupProtocolRuntime } from "../../src/zcode-protocol/runtime-cleanup.js";
+
+const [marker, mode] = process.argv.slice(2);
+if (process.argv.includes("--protocol-frames")) {
+  console.log = (...values: unknown[]) => {
+    process.stdout.write(
+      `${JSON.stringify({
+        method: "fixture/shutdown",
+        params: { stage: values.map(String).join(" ") },
+      })}\n`,
+    );
+  };
+}
+const { f, app } = await shutdownAppFixture();
+console.error("APP_READY");
+const finish = Promise.withResolvers<void>(),
+  entered = Promise.withResolvers<void>();
+const original = app.runtime.getToolRegistry().get("Probe")!;
+app.runtime.getToolRegistry().register({
+  ...original,
+  async handler() {
+    await writeFile(join(f.dir, "effect.txt"), "committed once");
+    await appendFile(join(f.dir, "effect-count.txt"), "effect\n");
+    entered.resolve();
+    await finish.promise;
+    return { saved: "known-result" };
+  },
+});
+app.runtime.invalidateToolCache();
+f.steps.push(() =>
+  reply("effect", [{ id: "one-effect", name: "Probe", input: { value: "effect" } }]),
+);
+const turn = app.submitPrompt("one effect").catch((error) => error.message);
+await Promise.race([
+  entered.promise,
+  turn.then((value) => {
+    throw new Error(`Fixture turn ended before effect: ${String(value)}`);
+  }),
+]);
+console.error("EFFECT_ENTERED");
+app.runtime.stopActiveForegroundExecution();
+await turn;
+console.error("TURN_STOPPED");
+await writeFile(marker!, JSON.stringify({ dir: f.dir }));
+const save = f.store.saveSessionEntry.bind(f.store);
+f.store.saveSessionEntry = async (entry) => {
+  if (mode === "slow-known" && entry.type === "runtime/late_tool_settlement") {
+    console.log("KNOWN_RECEIPT_WRITE_PENDING");
+    await new Promise((resolve) => setTimeout(resolve, 2200));
+  }
+  return save(entry);
+};
+if (mode === "hung") {
+  (app.runtime as any).executionPort.close = () => new Promise<void>(() => {});
+} else if (mode === "failed") {
+  (app.runtime as any).executionPort.close = async () => {
+    throw new Error("termination unconfirmed");
+  };
+}
+const logger = {
+  warn(message: string) {
+    console.log(message);
+  },
+  info() {},
+  debug() {},
+};
+const resources = new ProtocolRuntimeResources(async () => app);
+await resources.create({} as never);
+const lifecycle = createProtocolProcessLifecycle(); // Actual default process.exit owner and real stdin EOF.
+lifecycle.input.once("end", () => {
+  if (mode !== "hung") finish.resolve();
+  void (async () => {
+    try {
+      await cleanupProtocolRuntime({
+        logger: logger as never,
+        deadlineAt: lifecycle.deadlineAt,
+        server: { shutdown: () => resources.close(), disposeProjections() {} },
+        sessionStore: f.store,
+      });
+      console.log("ACTUAL_SETTLEMENT_COMPLETED");
+      await lifecycle.complete(0);
+    } catch {
+      console.log("CLEANUP_INCOMPLETE");
+      await lifecycle.complete(1);
+    }
+  })();
+});
+lifecycle.input.resume();
+console.log("READY_FOR_EOF");
