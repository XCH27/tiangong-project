+import assert from "node:assert/strict";
+import {
+  createInMemorySessionEventStore,
+  createSessionEvent,
+  SessionEventType,
+  type SessionEvent,
+  type SessionEventStorePort,
+} from "@zcode/contracts";
+import { persistBackgroundTaskStartedEntry } from "@zcode/core";
+import { ZCodeProtocolAgentServer } from "../../dist/zcode-protocol/server.js";
+import { fixture } from "../../../core/test/helpers/pi-runtime-fixture.js";
+import { mergeColdConversationEvents } from "../../src/zcode-protocol-v4/cold-event-merge.js";
+import { ProductProjection } from "../../src/zcode-protocol-v4/product-projection.js";
+export { fixture };
+
+export const sessionId = "session" as never;
+export function background(type: SessionEventType, taskId: string, time: number, sequence: number) {
+  const completed = type === SessionEventType.BackgroundTaskCompleted;
+  const event = createSessionEvent(
+    type,
+    sessionId,
+    {
+      taskId,
+      toolName: completed ? "CreateWorkflow" : "ResumeWorkflowRun",
+      taskKind: "workflow",
+      status: completed ? "cancelled" : "running",
+      cancellable: !completed,
+      startedAt: new Date(time),
+      ...(completed ? { completedAt: new Date(time) } : {}),
+      description: taskId,
+      terminalId: taskId,
+    },
+    { traceId: "fixture-trace" as never, sequenceNumber: sequence },
+  );
+  event.timestamp = new Date(time);
+  return event;
+}
+
+export function projected(events: SessionEvent[]) {
+  const result = mergeColdConversationEvents({ memoryEvents: events, messages: [], sessionId });
+  const projection = new ProductProjection(sessionId, "fixture-epoch");
+  for (const event of result.events) projection.applyEventAtomically(event, () => true);
+  return projection.getSnapshot().backgroundWorks;
+}
+
+export async function subscribe(
+  f: Awaited<ReturnType<typeof fixture>>,
+  clientMode: "web-remote-replayable" | "desktop-continuous" = "web-remote-replayable",
+  liveStore?: SessionEventStorePort,
+) {
+  const server = new ZCodeProtocolAgentServer({
+    sessionStore: f.store,
+    cwd: f.dir,
+    version: "fixture",
+    createZCodeApp: async () => {
+      throw new Error("cold projection must not start inference");
+    },
+  } as ConstructorParameters<typeof ZCodeProtocolAgentServer>[0]);
+  const context = (server as unknown as { context: { sessions: Map<string, unknown> } }).context;
+  context.sessions.set(sessionId, {
+    app: {
+      sessionId,
+      runtime: f.runtime,
+      listModels: () => [],
+      getMode: () => f.runtime.getMode(),
+      getModelOption: () => ({ contextWindow: 1000000 }),
+    },
+    eventStore: liveStore ?? createInMemorySessionEventStore(),
+    workspace: { workspaceKey: f.dir, workspacePath: f.dir },
+    createdAt: 0,
+    updatedAt: 0,
+    stateRevision: 0,
+    persistence: "immediate",
+  });
+  try {
+    const response = await server.handleMessage({
+      jsonrpc: "2.0",
+      id: "cold-subscribe",
+      method: "v4/conversation/subscribe",
+      params: {
+        topic: "conversation/session",
+        connectionId: "fixture",
+        clientMode,
+      },
+    } as Parameters<typeof server.handleMessage>[0]);
+    assert.equal("error" in response, false);
+    const messages = server.takePostResponseMessages("cold-subscribe");
+    const frame = messages[0] as unknown as {
+      params: {
+        frame: { payload: { snapshot: { backgroundWorks: ReturnType<typeof projected> } } };
+      };
+    };
+    assert.ok(frame?.params?.frame?.payload?.snapshot);
+    return frame.params.frame.payload.snapshot.backgroundWorks;
+  } finally {
+    server.disposeProjections();
+  }
+}
+
+export async function launch(
+  f: Awaited<ReturnType<typeof fixture>>,
+  id: string,
+  time: number,
+  parent = "session",
+  originalStart = time,
+) {
+  f.store.workflowJournalStore().createRun({
+    runId: id,
+    parentSessionId: parent,
+    caps: { maxConcurrency: 1 },
+    spentTokens: 0,
+    status: "running",
+  });
+  const event = background(SessionEventType.BackgroundTaskStarted, id, time, 2);
+  (event.payload as { startedAt: Date }).startedAt = new Date(originalStart);
+  await persistBackgroundTaskStartedEntry({ sessionStore: f.store, sessionId, event });
+}
