+import { chmodSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+/** ACP v1 agent without steering support; unknown notifications have no semantic effect. */
+export function ignoredSteerAgent() {
+  const dir = mkdtempSync(join(tmpdir(), "acp-guide-fallback-"));
+  const script = join(dir, "kimi"),
+    logPath = join(dir, "wire.jsonl"),
+    effectPath = join(dir, "effect.txt");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs = require("node:fs");
+if (process.argv.includes("--version")) { console.log("fixture-1"); process.exit(0); }
+const log = value => fs.appendFileSync(${JSON.stringify(logPath)}, JSON.stringify(value) + "\\n");
+const send = value => process.stdout.write(JSON.stringify(value) + "\\n");
+const config = [
+ { id:"model", category:"model", type:"select", currentValue:"k3", options:[{value:"k3"}] },
+ { id:"mode", category:"mode", type:"select", currentValue:"default", options:[{value:"default"},{value:"plan"}] }
+];
+let buffer="", pendingPrompt, permissionId=1000;
+process.stdin.on("data", chunk => {
+ buffer += chunk;
+ let end;
+ while ((end=buffer.indexOf("\\n"))>=0) {
+  const message=JSON.parse(buffer.slice(0,end)); buffer=buffer.slice(end+1); log(message);
+  if (message.method==="session/cancel") {
+   if(pendingPrompt) {send({jsonrpc:"2.0",id:pendingPrompt.id,result:{stopReason:"cancelled"}});pendingPrompt=undefined;}
+   continue;
+  }
+  if (message.method===undefined) {
+   if(message.id===permissionId && pendingPrompt) {
+    const outcome=message.result?.outcome; log({permissionOutcome:outcome});
+    if(outcome?.outcome==="selected" && outcome.optionId==="yes") fs.appendFileSync(${JSON.stringify(effectPath)},"original effect\\n");
+    send({jsonrpc:"2.0",method:"session/update",params:{sessionId:"vendor-original",update:{sessionUpdate:"agent_message_chunk",content:{type:"text",text:"ORIGINAL COMPLETE"}}}});
+    send({jsonrpc:"2.0",id:pendingPrompt.id,result:{stopReason:"end_turn",usage:{inputTokens:1,outputTokens:1,totalTokens:2}}});pendingPrompt=undefined;
+   }
+   continue;
+  }
+  if (message.id===undefined) {log({ignoredNotification:message.method});continue;}
+  const reply=result=>send({jsonrpc:"2.0",id:message.id,result});
+  switch(message.method) {
+   case "initialize": reply({protocolVersion:1,agentCapabilities:{loadSession:true,sessionCapabilities:{resume:{}},promptCapabilities:{image:false}},agentInfo:{version:"fixture-1"}});break;
+   case "session/new": reply({sessionId:"vendor-original",configOptions:config});break;
+   case "session/resume":
+   case "session/load": log({resumed:message.params.sessionId});reply({sessionId:"vendor-original",configOptions:config});break;
+   case "session/set_config_option": reply({configOptions:config});break;
+   case "session/prompt": {
+    const prompts=fs.readFileSync(${JSON.stringify(logPath)},"utf8").trim().split("\\n").map(x=>JSON.parse(x)).filter(x=>x.method==="session/prompt");
+    if(prompts.length>1) {
+     log({normalFallback:message.params.prompt});
+     send({jsonrpc:"2.0",method:"session/update",params:{sessionId:"vendor-original",update:{sessionUpdate:"agent_message_chunk",content:{type:"text",text:"GUIDE RECEIVED ONCE"}}}});
+     reply({stopReason:"end_turn",usage:{inputTokens:1,outputTokens:1,totalTokens:2}});break;
+    }
+    pendingPrompt=message;
+    send({jsonrpc:"2.0",id:permissionId,method:"session/request_permission",params:{sessionId:"vendor-original",toolCall:{toolCallId:"write-1",title:"Original edit",kind:"edit",rawInput:{path:"fixture.txt"}},options:[{optionId:"yes",kind:"allow_once"},{optionId:"no",kind:"reject_once"}]}});break;
+   }
+   default: send({jsonrpc:"2.0",id:message.id,error:{code:-32601,message:"Method not found"}});
+  }
+ }
+});
+`,
+  );
+  chmodSync(script, 0o755);
+  const records = () =>
+    readFileSync(logPath, "utf8")
+      .trim()
+      .split("\n")
+      .map((line) => JSON.parse(line) as Record<string, any>);
+  return { dir, script, effectPath, records };
+}
