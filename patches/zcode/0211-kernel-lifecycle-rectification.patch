diff --git a/packages/ui/test/codePreviewLinePrefsCommit.test.ts b/packages/ui/test/codePreviewLinePrefsCommit.test.ts
new file mode 100644
index 00000000..9a7beea9
--- /dev/null
+++ b/packages/ui/test/codePreviewLinePrefsCommit.test.ts
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  commitCodePreviewLinePrefsToSettings,
+  shouldMigrateCodePreviewLinePrefsToSettings,
+  CODE_PREVIEW_LINE_PREFS_MIGRATED_KEY,
+} from "../src/lib/codePreviewLinePrefsSettings.js";
+
+test("appearance commit failure preserves local state and permits retry", async () => {
+  const previous = Object.getOwnPropertyDescriptor(globalThis, "window");
+  const values = new Map<string, string>();
+  Object.defineProperty(globalThis, "window", {
+    configurable: true,
+    value: {
+      localStorage: {
+        getItem: (key: string) => values.get(key) ?? null,
+        setItem: (key: string, value: string) => values.set(key, value),
+      },
+    },
+  });
+  const prior = { showLineNumbers: false, wrapLongLines: true };
+  try {
+    const write = Promise.withResolvers<void>();
+    const pending = commitCodePreviewLinePrefsToSettings(() => write.promise, prior);
+    assert.equal(shouldMigrateCodePreviewLinePrefsToSettings(), true);
+    write.reject(new Error("disk temporarily unavailable"));
+    await assert.rejects(pending, /temporarily unavailable/);
+    assert.equal(values.has(CODE_PREVIEW_LINE_PREFS_MIGRATED_KEY), false);
+    assert.deepEqual(prior, { showLineNumbers: false, wrapLongLines: true });
+    let stored;
+    await commitCodePreviewLinePrefsToSettings(async (patch) => {
+      stored = patch;
+    }, prior);
+    assert.deepEqual(stored, prior);
+    assert.equal(shouldMigrateCodePreviewLinePrefsToSettings(), false);
+  } finally {
+    if (previous) Object.defineProperty(globalThis, "window", previous);
+    else Reflect.deleteProperty(globalThis, "window");
+  }
+});
