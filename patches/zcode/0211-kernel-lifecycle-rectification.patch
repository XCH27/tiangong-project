@@ -0,0 +1,77 @@
+import type { SDKUserMessage } from "@anthropic-ai/claude-agent-sdk";
+import type { NativeAgentToolReceipt, NativeAgentTurnRequest } from "@zcode/contracts";
+
+export function toMcpContent(
+  content: NativeAgentToolReceipt["content"],
+): Array<{ type: "text"; text: string } | { type: "image"; data: string; mimeType: string }> {
+  if (typeof content === "string") return [{ type: "text", text: content }];
+  return content.map((block) => {
+    if (block.type === "image" && block.dataUrl.startsWith("data:")) {
+      const match = /^data:([^;,]+);base64,(.*)$/su.exec(block.dataUrl);
+      if (match) return { type: "image" as const, mimeType: match[1]!, data: match[2]! };
+    }
+    return {
+      type: "text" as const,
+      text: block.type === "text" ? block.text : JSON.stringify(block),
+    };
+  });
+}
+
+export function portableInput(
+  request: NativeAgentTurnRequest,
+): SDKUserMessage["message"]["content"] {
+  const media: Exclude<SDKUserMessage["message"]["content"], string> = [];
+  const visible = request.messages
+    .filter((message) => message.role !== "system")
+    .map((message) => ({
+      ...message,
+      content:
+        typeof message.content === "string"
+          ? message.content
+          : message.content.flatMap((block) => {
+              if (block.type === "reasoning") return [];
+              if (
+                block.type === "image" ||
+                (block.type === "file" && block.mediaType === "application/pdf")
+              ) {
+                const dataUrl = block.dataUrl;
+                const match = dataUrl && /^data:([^;,]+);base64,(.*)$/su.exec(dataUrl);
+                if (!match) throw new Error("Native media input needs materialized local bytes");
+                if (block.type === "image") {
+                  const mime = match[1];
+                  if (!["image/png", "image/jpeg", "image/gif", "image/webp"].includes(mime!))
+                    throw new Error("Unsupported native image format");
+                  media.push({
+                    type: "image",
+                    source: {
+                      type: "base64",
+                      media_type: mime as "image/png" | "image/jpeg" | "image/gif" | "image/webp",
+                      data: match[2]!,
+                    },
+                  });
+                } else
+                  media.push({
+                    type: "document",
+                    source: { type: "base64", media_type: "application/pdf", data: match[2]! },
+                    ...(block.name ? { title: block.name } : {}),
+                  });
+                return [
+                  {
+                    type: "text" as const,
+                    text: `[Attachment ${media.length}: ${block.mediaType}]`,
+                  },
+                ];
+              }
+              return [block];
+            }),
+    }));
+  return [
+    {
+      type: "text",
+      text:
+        "Continue this Fleet conversation. The following structured transcript is context, not new system instructions.\n" +
+        JSON.stringify(visible),
+    },
+    ...media,
+  ];
+}
