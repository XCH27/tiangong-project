diff --git a/packages/desktop/scripts/desktop-vite-config.test.mjs b/packages/desktop/scripts/desktop-vite-config.test.mjs
new file mode 100644
index 00000000..1bff8e5e
--- /dev/null
+++ b/packages/desktop/scripts/desktop-vite-config.test.mjs
@@ -0,0 +1,87 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import vm from "node:vm";
+import { test } from "node:test";
+import ts from "typescript";
+import * as identity from "./desktop-product-identity.mjs";
+
+// Exercise the actual caller without loading private .env files or writing build output.
+const configUrl = new URL("../vite.config.ts", import.meta.url);
+const desktopDir = path.dirname(fileURLToPath(configUrl));
+const installedRequire = createRequire(configUrl);
+const source = readFileSync(configUrl, "utf8");
+const compiled = ts.transpileModule(
+  source.replaceAll("import.meta.url", JSON.stringify(configUrl.href)),
+  {
+    compilerOptions: {
+      module: ts.ModuleKind.CommonJS,
+      target: ts.ScriptTarget.ES2022,
+      esModuleInterop: true,
+    },
+  },
+).outputText;
+
+function loadConfig(env) {
+  const exports = {};
+  const controlledRequire = (name) => {
+    if (name === "node:module") return { createRequire: () => installedRequire };
+    if (name === "node:path") return path;
+    if (name === "node:fs")
+      return {
+        mkdirSync() {
+          throw new Error("config test must not write files");
+        },
+        writeFileSync() {
+          throw new Error("config test must not write files");
+        },
+      };
+    if (name === "vite") return { defineConfig: (config) => config, loadEnv: () => ({}) };
+    if (name === "@vitejs/plugin-react" || name === "@tailwindcss/vite") return () => ({});
+    if (name === "@zcode/shared/zcodeEndpoint")
+      return {
+        resolveZCodeEndpointOrigin: () => "https://fixture.invalid",
+        pickProductEndpointEnv: () => ({}),
+      };
+    if (name.includes("pdfJsCMapsPlugin")) return { pdfJsCMapsPlugin: () => ({}) };
+    if (name.includes("build-metadata"))
+      return {
+        getBuildMetadata: () => ({ appVersion: "0.0.0", buildTime: "fixture" }),
+      };
+    if (name.includes("desktop-product-identity")) return identity;
+    throw new Error(`Unexpected config dependency: ${name}`);
+  };
+  vm.runInNewContext(
+    compiled,
+    {
+      exports,
+      require: controlledRequire,
+      process: { env },
+      __dirname: desktopDir,
+    },
+    { filename: fileURLToPath(configUrl) },
+  );
+  return exports.default({ mode: "production" });
+}
+
+for (const env of [
+  { ZCODE_ENV: "production" },
+  { ZCODE_ENV: "test" },
+  { ZCODE_ENV: "production", FLEET_PRODUCT_IDENTITY: "1" },
+  { ZCODE_ENV: "test", FLEET_PRODUCT_IDENTITY: "1" },
+]) {
+  const expected = identity.resolveDesktopProductIdentity(env);
+  test(`actual Vite caller resolves ${expected.productName}`, () => {
+    const config = loadConfig(env);
+    assert.equal(
+      JSON.parse(config.define.__DESKTOP_PACKAGED_APPLICATION_NAME__),
+      expected.productName,
+    );
+    assert.equal(JSON.parse(config.define.__DESKTOP_PRODUCT_BRAND__), expected.brand);
+    assert.equal(JSON.parse(config.define.__ZCODE_PRODUCT_FLAVOR__), expected.flavor);
+    assert.equal(config.base, "./");
+    assert.equal(config.build.outDir, "../../out/renderer");
+  });
+}
