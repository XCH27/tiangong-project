+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import { reply } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { shutdownAppFixture } from "./helpers/shutdown-app-fixture.js";
+import { SessionResidentPool } from "../src/zcode-protocol/session-resident-pool.js";
+import { createSessionResidentPoolHost } from "../src/zcode-protocol/session-residency.js";
+
+const tick = () => new Promise<void>((resolve) => setImmediate(resolve));
+
+test("real App settles all FIFO callers and retries failed preservation under original IDs", async () => {
+  const { f, app } = await shutdownAppFixture();
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  f.steps.push(async () => {
+    entered.resolve();
+    await release.promise;
+    return reply("first");
+  });
+  const first = app.submitPrompt("first").catch((error) => error.message);
+  await entered.promise;
+  const one = app.submitPrompt("queued-one", { inputId: "one" }).catch((error) => error.message);
+  const two = app.submitPrompt("queued-two", { inputId: "two" }).catch((error) => error.message);
+  await tick();
+  const save = f.store.saveSessionInput.bind(f.store);
+  const attempts: string[] = [];
+  f.store.saveSessionInput = async (input) => {
+    attempts.push(input.id);
+    if (input.id === "one") throw new Error("transient admission failure");
+    return save(input);
+  };
+  try {
+    const closing = app.close().catch((error) => error.message);
+    assert.equal(await one, "transient admission failure");
+    assert.equal(await two, "Turn was cancelled.");
+    release.resolve();
+    assert.equal(await first, "Turn was cancelled.");
+    assert.equal(await closing, "Session cleanup did not settle");
+    assert.equal((await f.store.getSessionInputById("two"))?.status, "admitted");
+    f.store.saveSessionInput = save;
+    await app.close();
+    assert.equal((await f.store.getSessionInputById("one"))?.payload.text, "queued-one");
+    const events = await app.runtime.eventStore.getEvents("session" as never);
+    const queued = events.filter((event) => event.type === SessionEventType.TurnSteerQueued);
+    assert.deepEqual(queued.map((event: any) => event.payload.pendingInputId).sort(), [
+      "one",
+      "two",
+    ]);
+    assert.equal(attempts.filter((id) => id === "two").length, 1);
+    assert.equal(f.requests.length, 1, "shutdown/retry never executes preserved input");
+    await f.reopen();
+    for (const id of ["one", "two"]) {
+      assert.equal((await f.store.getSessionInputById(id))?.status, "discarded");
+    }
+    assert.equal(f.requests.length, 1, "cold recovery does not replay");
+  } finally {
+    release.resolve();
+    f.store.saveSessionInput = save;
+    await app.close();
+    await f.close();
+  }
+});
+
+test("retry reconciles a committed queue event whose acknowledgement failed", async () => {
+  const { f, app } = await shutdownAppFixture();
+  const entered = Promise.withResolvers<void>(),
+    release = Promise.withResolvers<void>();
+  f.steps.push(async () => {
+    entered.resolve();
+    await release.promise;
+    return reply("first");
+  });
+  const first = app.submitPrompt("first").catch((error) => error.message);
+  await entered.promise;
+  const queued = app
+    .submitPrompt("retained once", { inputId: "same-original-id" })
+    .catch((error) => error.message);
+  await tick();
+  const runtime = app.runtime as any;
+  const append = runtime.appendEvent.bind(runtime);
+  let once = true;
+  runtime.appendEvent = async (event: any, trace: any) => {
+    await append(event, trace);
+    if (once && event.type === SessionEventType.TurnSteerQueued) {
+      once = false;
+      throw new Error("lost acknowledgement after commit");
+    }
+  };
+  try {
+    const closing = app.close().catch((error) => error.message);
+    assert.equal(await queued, "lost acknowledgement after commit");
+    release.resolve();
+    await first;
+    await closing;
+    await app.close();
+    const events = await runtime.eventStore.getEvents("session");
+    assert.equal(
+      events.filter((event: any) => event.type === SessionEventType.TurnSteerQueued).length,
+      1,
+    );
+    assert.equal((await f.store.getSessionInputById("same-original-id"))?.status, "admitted");
+    assert.equal(f.requests.length, 1);
+  } finally {
+    release.resolve();
+    await app.close();
+    await f.close();
+  }
+});
+
+test(
+  "resident pool retries the retained real App and holds its gate beyond close acknowledgement",
+  { timeout: 15000 },
+  async () => {
+    const { f, app } = await shutdownAppFixture();
+    f.steps.push(() => reply("persist the session"));
+    await app.submitPrompt("persist");
+    const execution = (app.runtime as any).executionPort;
+    const close = execution.close.bind(execution);
+    const release = Promise.withResolvers<void>();
+    let calls = 0,
+      closed = false;
+    execution.close = async () => {
+      if (++calls === 1) throw new Error("transient termination failure");
+      await release.promise;
+      await close();
+      closed = true;
+    };
+    const context: any = {
+      sessions: new Map([
+        [
+          "session",
+          {
+            app,
+            persistence: "immediate",
+            updatedAt: 0,
+            eventStore: (app.runtime as any).eventStore,
+          },
+        ],
+      ]),
+      v4Interactions: { hasPendingForSession: () => false },
+    };
+    const pool = new SessionResidentPool(createSessionResidentPoolHost(context), {
+      idleTimeoutMs: 0,
+    });
+    try {
+      pool.rebalance();
+      await assert.rejects(pool.waitForDeactivation("session"), /did not settle/);
+      assert.equal(context.sessions.has("session"), false);
+      let admitted = false;
+      const lease = pool.acquireOperation("session").then((releaseLease) => {
+        admitted = true;
+        return releaseLease;
+      });
+      await tick();
+      await assert.rejects(app.close(), (error: any) => error.code === "session_close_incomplete");
+      assert.equal(admitted, false, "six-second acknowledgement cannot release the old owner");
+      assert.equal(closed, false);
+      await f.store.getSession("session" as never);
+      release.resolve();
+      (await lease)();
+      assert.equal(closed, true);
+      assert.equal(calls, 2, "only the failed resource close retries");
+      await app.close();
+      assert.equal(calls, 2);
+      assert.equal(f.requests.length, 1);
+    } finally {
+      release.resolve();
+      await app.close();
+      await f.close();
+    }
+  },
+);
