+import assert from "node:assert/strict";
+import test from "node:test";
+import { MessageChannel } from "node:worker_threads";
+import { DatabaseSync } from "node:sqlite";
+import { receiptFixture } from "./helpers/remote-host-stop-receipts-fixture.js";
+import type { ZCodeRemoteHostAttachmentStopReceipt } from "@zcode/shared";
+import { createRemoteHostAttachmentStopSessionGlue } from "../../../../../packages/desktop/src/host/remoteHostAttachmentStopSessionGlue.js";
+import { createRemoteHostAttachmentStopProductWiring } from "../../../../../packages/desktop/src/host/remoteHostAttachmentStopProductWiring.js";
+import { createWindowRemoteConnectionRegistry } from "../../../../../packages/desktop/src/host/windowRemoteConnectionRegistry.js";
+import { createMessagePortServiceConnection } from "../../../../../packages/client/src/messageport.js";
+import { ChannelServer, MessagePortProtocol, ProxyChannel } from "../../../../../packages/rpc/src/index.js";
+import { IZCodeAgentService } from "../../../../../packages/services/src/zcode-agent/zcodeAgent.js";
+
+
+test("one physical remote Stop remains durable in each Session after duplicate RPC and cold reopen", async () => {
+  const f = await receiptFixture();
+  try {
+    assert.deepEqual(await f.write("conversation-a"), { persisted: true });
+    assert.deepEqual(await f.write("conversation-b"), { persisted: true });
+    assert.deepEqual(await f.write("conversation-a"), { persisted: true });
+    const reopened = f.reopen();
+    try {
+      const a = await reopened.sessionEntries({ sessionID: "conversation-a" as never });
+      const b = await reopened.sessionEntries({ sessionID: "conversation-b" as never });
+      assert.equal(a.length, 1);
+      assert.equal(b.length, 1);
+      assert.notEqual(a[0]?.id, b[0]?.id);
+      assert.deepEqual(a[0]?.data, f.receipt);
+      assert.deepEqual(b[0]?.data, f.receipt);
+    } finally { reopened.close(); }
+  } finally { await f.close(); }
+});
+
+test("an unknown unsent Session is skipped without inventing a durable conversation", async () => {
+  const f = await receiptFixture();
+  try {
+    assert.deepEqual(await f.write("unsent-draft"), { persisted: false });
+    assert.equal(await f.store.getSession("unsent-draft" as never), null);
+    assert.deepEqual(await f.store.sessionEntries({ sessionID: "unsent-draft" as never }), []);
+    assert.deepEqual(await f.write("conversation-b"), { persisted: true });
+    assert.equal((await f.store.sessionEntries({ sessionID: "conversation-b" as never })).length, 1);
+  } finally { await f.close(); }
+});
+
+test("late cancelled RPC acknowledgement leaves one durable receipt and an explicit same-ID retry is idempotent", async () => {
+  const f = await receiptFixture();
+  try {
+    const saved = f.holdAcknowledgements();
+    const controller = new AbortController();
+    const pending = f.write("conversation-a", f.receipt, { signal: controller.signal });
+    const rejected = assert.rejects(pending, { name: "AbortError" });
+    await saved;
+    controller.abort();
+    await rejected;
+    f.releaseAcknowledgements();
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(f.pendingRequests(), 0);
+    assert.deepEqual(await f.write("conversation-a"), { persisted: true });
+    const reopened = f.reopen();
+    try {
+      assert.equal((await reopened.sessionEntries({ sessionID: "conversation-a" as never })).length, 1);
+    } finally { reopened.close(); }
+  } finally { await f.close(); }
+});
+
+test("a legacy receipt remains owned by its Session without duplicate evidence on retry", async () => {
+  const f = await receiptFixture();
+  try {
+    const legacyId = "remote-host-attachment-stop:shared-remote:session_detach:1000";
+    await f.store.saveSessionEntry({ id: legacyId, sessionID: "conversation-a" as never,
+      type: "remote_host_attachment_stop", touchSession: false,
+      time: { created: 1_000, updated: 1_000 }, data: f.receipt });
+    assert.deepEqual(await f.write("conversation-a"), { persisted: true });
