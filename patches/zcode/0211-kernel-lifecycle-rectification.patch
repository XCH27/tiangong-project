+import { createSessionEvent, SessionEventType } from "@zcode/contracts";
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  backgroundTaskEntryEventTime,
+  compareBackgroundTaskEventOrder,
+  retainBackgroundTaskEntrySequence,
+} from "../src/runtime/methods/background-task-lifecycle-order.js";
+
+test("entry emission timestamp takes precedence over original SQLite creation and write time", () => {
+  assert.equal(
+    backgroundTaskEntryEventTime({
+      data: { eventTimestamp: 2000 },
+      time: { created: 500, updated: 9000 },
+    }),
+    2000,
+  );
+});
+
+test("legacy I/O update time and invalid eventTimestamp values cannot establish newer emission", () => {
+  for (const eventTimestamp of [undefined, "2000", Number.NaN, Number.POSITIVE_INFINITY]) {
+    assert.equal(
+      backgroundTaskEntryEventTime({
+        data: { eventTimestamp },
+        time: { created: 500, updated: 2000 },
+      }),
+      500,
+    );
+  }
+  assert.equal(backgroundTaskEntryEventTime({ data: {}, time: { created: 500 } }), 500);
+});
+
+test("restored same-epoch sequence outranks wall clock while public synthetic seq stays zero", () => {
+  const epoch = crypto.randomUUID();
+  const completed = createSessionEvent(
+    SessionEventType.BackgroundTaskCompleted,
+    "fixture" as never,
+    {},
+    { traceId: "fixture" as never },
+  );
+  const started = createSessionEvent(
+    SessionEventType.BackgroundTaskStarted,
+    "fixture" as never,
+    {},
+    { traceId: "fixture" as never },
+  );
+  completed.timestamp = new Date(2000);
+  started.timestamp = new Date(1000);
+  retainBackgroundTaskEntrySequence(completed, {
+    data: { eventEpoch: epoch, sequenceNumber: 1 },
+    time: { created: 2000 },
+  });
+  retainBackgroundTaskEntrySequence(started, {
+    data: { eventEpoch: epoch, sequenceNumber: 2 },
+    time: { created: 1000 },
+  });
+  assert.ok(compareBackgroundTaskEventOrder(started, completed) > 0);
+  assert.equal(started.sequenceNumber, 0);
+  assert.equal("eventEpoch" in started, false);
+});
+
+test("cross-epoch and invalid epoch metadata never compare cold sequence globally", () => {
+  for (const eventEpoch of [crypto.randomUUID(), "trace-is-not-runtime-epoch", undefined]) {
+    const completed = createSessionEvent(
+      SessionEventType.BackgroundTaskCompleted,
+      "fixture" as never,
+      {},
+      { traceId: "fixture" as never },
+    );
+    const started = createSessionEvent(
+      SessionEventType.BackgroundTaskStarted,
+      "fixture" as never,
+      {},
+      { traceId: "fixture" as never },
+    );
+    completed.timestamp = new Date(2000);
+    started.timestamp = new Date(1000);
+    retainBackgroundTaskEntrySequence(completed, {
+      data: { eventEpoch: crypto.randomUUID(), sequenceNumber: 1 },
+      time: { created: 2000 },
+    });
+    retainBackgroundTaskEntrySequence(started, {
+      data: { eventEpoch, sequenceNumber: 99 },
+      time: { created: 1000 },
+    });
+    assert.ok(compareBackgroundTaskEventOrder(started, completed) < 0);
+  }
+});
