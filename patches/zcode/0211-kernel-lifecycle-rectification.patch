@@ -0,0 +1,48 @@
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { compareBackgroundTaskEventOrder, durableBackgroundTaskStartedPayload } from "@zcode/core";
+
+/** Terminal protection applies to the current lifecycle, not every past use of taskId. */
+export function backgroundTaskLifecycleEvidence(
+  events: readonly SessionEvent[],
+  sessionId: string,
+) {
+  const terminal = new Map<string, SessionEvent>();
+  const started = new Map<string, SessionEvent>();
+  for (const event of events) {
+    if (String(event.sessionId) !== sessionId) continue;
+    const map =
+      event.type === SessionEventType.BackgroundTaskCompleted
+        ? terminal
+        : event.type === SessionEventType.BackgroundTaskStarted &&
+            durableBackgroundTaskStartedPayload(event.payload)
+          ? started
+          : undefined;
+    const taskId = (event.payload as { taskId?: unknown } | undefined)?.taskId;
+    if (!map || typeof taskId !== "string" || !taskId) continue;
+    const previous = map.get(taskId);
+    if (!previous || backgroundEventIsNewer(event, previous)) map.set(taskId, event);
+  }
+  return { terminal, started };
+}
+
+function backgroundEventIsNewer(left: SessionEvent, right: SessionEvent): boolean {
+  return compareBackgroundTaskEventOrder(left, right) > 0;
+}
+
+export function isStaleBackgroundTaskLifecycleEvent(
+  event: SessionEvent,
+  evidence: ReturnType<typeof backgroundTaskLifecycleEvidence>,
+): boolean {
+  if (event.type === SessionEventType.BackgroundTaskStarted) {
+    const durable = durableBackgroundTaskStartedPayload(event.payload);
+    const terminal = durable ? evidence.terminal.get(durable.taskId) : undefined;
+    return Boolean(terminal && !backgroundEventIsNewer(event, terminal));
+  }
+  if (event.type === SessionEventType.BackgroundTaskCompleted) {
+    const taskId = (event.payload as { taskId?: unknown } | undefined)?.taskId;
+    const resumed = typeof taskId === "string" ? evidence.started.get(taskId) : undefined;
+    // Session 合成可能追加旧终态；必须按原始发射顺序判断，不能信任数组尾部。
+    return Boolean(resumed && backgroundEventIsNewer(resumed, event));
+  }
+  return false;
+}
