diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/cold-background-lifecycle-evidence.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/cold-background-lifecycle-evidence.ts
