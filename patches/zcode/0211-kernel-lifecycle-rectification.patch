@@ -0,0 +1,106 @@
+import { EventEmitter } from "node:events";
+import type { WindowHostAttachmentScope } from "@zcode/shared";
+
+export type FixtureServices = { id: string };
+export type FixtureCapabilities = { label: string };
+
+export type FixtureStopReason =
+  | "session_detach"
+  | "transport_close"
+  | "idle_dispose"
+  | "dispose_remote";
+
+export type FixtureStopTargetKind = "docker" | "ssh" | "wsl";
+
+export interface FixtureStopLinkedTask {
+  taskId: string;
+  toolName: "Bash" | "Agent" | "Task";
+  taskKind: "bash" | "subagent";
+  status: "cancelled" | "lost";
+  description?: string;
+  command?: string;
+  toolCallId?: string;
+  startedAt?: number;
+  completedAt?: number;
+  traceId?: string;
+}
+
+export interface FixtureStopReceipt {
+  remoteSessionId: string;
+  reason: FixtureStopReason;
+  targetKind?: FixtureStopTargetKind;
+  attachmentIds: string[];
+  stoppedAt: number;
+  linkedTasks?: FixtureStopLinkedTask[];
+}
+
+/**
+ * MessagePortMain-shaped attachment port for Host registry proofs.
+ * Matches the Host attach surface (EventEmitter once("close"), close/start/postMessage)
+ * without importing electron or inventing live MessagePort RPC.
+ */
+export interface MessagePortShapedAttachmentPort extends EventEmitter {
+  /** True after close(); further close()/emitClose() are no-ops (MessagePortMain honesty). */
+  readonly closed: boolean;
+  /** MessagePortMain.close — emits "close" once; Host registry dispose listens here. */
+  close(): void;
+  /** MessagePortMain.start — no-op in fixture (RPC handshake not invented). */
+  start(): void;
+  /** MessagePortMain.postMessage — records payloads; does not invent ChannelServer RPC. */
+  postMessage(data: unknown): void;
+  /** Test helper alias for close() (kept for older fixture callers). */
+  emitClose(): void;
+  /** Payloads passed to postMessage (fixture inspection only). */
+  readonly posted: unknown[];
+}
+
+/** @deprecated Prefer MessagePortShapedAttachmentPort — same shape. */
+export type FakeAttachmentPort = MessagePortShapedAttachmentPort;
+
+export function createMessagePortShapedAttachmentPort(): MessagePortShapedAttachmentPort {
+  const emitter = new EventEmitter() as MessagePortShapedAttachmentPort;
+  const posted: unknown[] = [];
+  let closed = false;
+  Object.defineProperty(emitter, "closed", {
+    get: () => closed,
+    enumerable: true,
+  });
+  Object.defineProperty(emitter, "posted", {
+    get: () => posted,
+    enumerable: true,
+  });
+  emitter.start = () => {
+    // MessagePortMain.start is required before message delivery; fixture has no RPC.
+  };
+  emitter.postMessage = (data: unknown) => {
+    if (closed) return;
+    posted.push(data);
+  };
+  emitter.close = () => {
+    if (closed) return;
+    closed = true;
+    emitter.emit("close");
+  };
+  emitter.emitClose = () => {
+    emitter.close();
+  };
+  return emitter;
+}
+
+/** Alias — MessagePort-shaped is the default fake attachment port. */
+export function createFakeAttachmentPort(): MessagePortShapedAttachmentPort {
+  return createMessagePortShapedAttachmentPort();
+}
+
+export function remoteScope(
+  remoteSessionId: string,
+  workspacePath = "/remote/ws",
+  workspaceIdentity = "remote-ws-id",
+): Extract<WindowHostAttachmentScope, { kind: "remote" }> {
+  return {
+    kind: "remote",
+    remoteSessionId,
+    workspacePath,
+    workspaceIdentity,
+  };
+}
