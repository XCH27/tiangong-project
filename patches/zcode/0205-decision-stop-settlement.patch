 });
+
+for (const delayed of ["intent", "ledger-before", "ledger-ack", "result-ack"] as const) {
+  test(
+    `automatic Stop closes foreground during delayed ${delayed} without losing owned settlement`,
+    { timeout: 5000 },
+    async () => {
+      const entered = Promise.withResolvers<void>();
+      const release = Promise.withResolvers<void>();
+      const settled = Promise.withResolvers<void>();
+      let calls = 0;
+      const usage = {
+        inputTokens: 40,
+        outputTokens: 12,
+        totalTokens: 52,
+        cacheReadTokens: 7,
+        reasoningTokens: 2,
+      };
+      const port: DecisionModelPort = {
+        isAvailable: () => true,
+        listModels: () => [],
+        prepare: async () => ({
+          binding: randomUUID(),
+          model: { providerId: "fixture", modelId: "classifier" },
+          inputDigest: "c".repeat(64),
+        }),
+        classify: async () => {
+          calls++;
+          return {
+            status: "completed",
+            requestedModel: { providerId: "fixture", modelId: "classifier" },
+            inputDigest: "c".repeat(64),
+            answers: {},
+            usage,
+          };
+        },
+        automaticModel: async (_value, _signal, execute) => {
+          await execute({
+            state: "Synthetic evidence",
+            questions: {
+              q: { type: "bool", instructions: "Check", criteria: { true: "yes", false: "no" } },
+            },
+          });
+          return { selection: { providerId: "fixture", modelId: "deep" }, tier: "deep" };
+        },
+      };
+      const f = await hostFixture(undefined, false, { deps: { decisionModelPort: port } });
+      const rt = f.runtime as any;
+      const artifact = rt.artifactStore.writeToolResultArtifactOnce.bind(rt.artifactStore);
+      const ledger = f.store.recordModelUsage.bind(f.store);
+      rt.artifactStore.writeToolResultArtifactOnce = async (input: any) => {
+        if (delayed === "intent" && input.idempotencyKey.endsWith(":intent")) {
+          entered.resolve();
+          await release.promise;
+        }
+        const receipt = await artifact(input);
+        if (input.idempotencyKey.endsWith(":result")) {
+          if (delayed === "result-ack") {
+            entered.resolve();
+            await release.promise;
+          }
+          settled.resolve();
+        }
+        return receipt;
+      };
+      f.store.recordModelUsage = async (record) => {
+        if (record.querySource !== "decision_classification") return ledger(record);
+        if (delayed === "ledger-before") {
+          entered.resolve();
+          await release.promise;
+        }
+        await ledger(record);
+        if (delayed === "ledger-ack") {
+          entered.resolve();
+          await release.promise;
+        }
+      };
+      let first: Promise<unknown> | undefined;
+      try {
+        first = f.runtime.executeTurn("Synthetic first", undefined, {
+          inputId: "stopped-operation",
+          intent: { modelSelection: selection(), allowAutomaticModelSelection: true },
+        } as never);
+        const rejected = assert.rejects(first);
+        await entered.promise;
+        f.runtime.stopActiveForegroundExecution();
+        const stopped = await Promise.race([
+          rejected.then(() => true),
+          new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 100)),
+        ]);
+        assert.equal(stopped, true, "Stop must not await storage settlement");
+        assert.equal(f.requests.length, 0);
+        assert.equal(rt.residencyBlockingWorkCount, 1);
+        f.steps.push(() => {
+          assert.equal(rt.activeTurn.steerable, true);
+          return reply("Next manual turn");
+        });
+        await f.runtime.executeTurn("Next manual turn", undefined, {
+          intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+        } as never);
+        assert.equal(f.requests[0]?.selection.modelId, "model-a");
+        release.resolve();
+        await settled.promise;
+        await new Promise<void>((resolve) => setImmediate(resolve));
+        assert.equal(rt.residencyBlockingWorkCount, 0);
+        assert.equal(f.runtime.getSessionModelSelection().modelId, "model-a");
+        assert.equal(calls, delayed === "intent" ? 0 : 1);
+        const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+        try {
+          const rows = db
+            .prepare("select * from model_usage where query_source='decision_classification'")
+            .all();
+          assert.equal(rows.length, 1);
+          if (delayed !== "intent")
+            assert.deepEqual(JSON.parse(String(rows[0]!.raw_usage_json)), usage);
+          else assert.equal(rows[0]!.status, "cancelled");
+        } finally {
+          db.close();
+        }
+        await f.reopen();
+        assert.equal(calls, delayed === "intent" ? 0 : 1);
+      } finally {
+        release.resolve();
+        if (first) await first.catch(() => {});
+        await f.close();
+      }
+    },
+  );
+}
