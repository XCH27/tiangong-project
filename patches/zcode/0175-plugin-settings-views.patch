@@ -0,0 +1,27 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createSettingsPageConfig,
+  resolveSettingsSectionForPlatform,
+  SETTINGS_PLUGIN_VIEW_TABS,
+  settingsSidebarSection,
+} from "../src/settings/settingsPageConfig.js";
+
+// OV-100: Skills, MCP, Commands and Hooks are views of the one Plugins page. Their sidebar entries
+// are retired, but every existing link to them must still open that page on the matching view.
+test("plugin primitives are views of the one Plugins page, not separate sidebar entries", () => {
+  const { settingsSectionGroups, settingsSections } = createSettingsPageConfig({
+    isDesktop: true,
+    isMacDesktop: true,
+    isWindowsDesktop: false,
+  });
+  const sidebar = settingsSectionGroups.flatMap((group) => group.sections.map((section) => section.id));
+  assert.ok(sidebar.includes("plugin"));
+  for (const alias of ["mcp", "skill", "commands", "hooks"] as const) {
+    assert.ok(!sidebar.includes(alias), `${alias} must not be its own sidebar entry`);
+    assert.equal(resolveSettingsSectionForPlatform(alias, settingsSections), alias, `${alias} stays routable`);
+    assert.equal(settingsSidebarSection(alias, settingsSections), "plugin", `${alias} highlights Plugins`);
