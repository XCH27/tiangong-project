diff --git a/scripts/typecheck-root.mjs b/scripts/typecheck-root.mjs
new file mode 100644
index 00000000..ab809200
--- /dev/null
+++ b/scripts/typecheck-root.mjs
@@ -0,0 +1,41 @@
+import { dirname, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { runCommand } from "./spawn-command.mjs";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+// Original root typecheck coverage and order. Each invocation releases its compiler graphs.
+export const ROOT_TYPECHECK_PROJECTS = Object.freeze([
+  "packages/rpc",
+  "packages/provider",
+  "packages/provider-node",
+  "packages/shared",
+  "packages/services",
+  "packages/client",
+  "packages/server",
+  "packages/zcode-server-cli",
+  "packages/ui",
+  "packages/web",
+  "packages/desktop/tsconfig.host.json",
+  "packages/desktop/tsconfig.main.json",
+  "packages/desktop/tsconfig.preload.json",
+  "packages/desktop/tsconfig.renderer.json",
+  "packages/desktop/tsconfig.scheduler.json",
+  "packages/desktop/tsconfig.tooling.json",
+]);
+
+/** Options are a local test seam; the command entry always uses the complete original list. */
+export function typecheckRoot({
+  cwd = root,
+  compiler = resolve(cwd, "node_modules/typescript/bin/tsc"),
+  projects = ROOT_TYPECHECK_PROJECTS,
+  env = process.env,
+} = {}) {
+  for (const project of projects) {
+    console.log(`[typecheck] ${project}`);
+    runCommand(process.execPath, [compiler, "-b", project], { cwd, env });
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  typecheckRoot();
+}
diff --git a/scripts/typecheck-root.test.mjs b/scripts/typecheck-root.test.mjs
new file mode 100644
index 00000000..03903aad
--- /dev/null
+++ b/scripts/typecheck-root.test.mjs
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { mkdtemp, writeFile, readFile, realpath, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { typecheckRoot } from "./typecheck-root.mjs";
+
+async function fixture() {
+  const cwd = await mkdtemp(join(tmpdir(), "root types ' "));
+  const compiler = join(cwd, "compiler fixture.cjs");
+  const log = join(cwd, "calls.jsonl");
+  await writeFile(compiler, `const fs = require('node:fs');
+const record = { pid: process.pid, cwd: process.cwd(), args: process.argv.slice(2), heap: process.env.NODE_OPTIONS, marker: process.env.TYPECHECK_FIXTURE_MARKER };
+fs.appendFileSync(process.env.TYPECHECK_FIXTURE_LOG, JSON.stringify(record) + '\\n');
+if (process.argv[3] === 'reject') process.exit(19);
+`);
+  const env = { ...process.env, NODE_OPTIONS: "--max-old-space-size=128", TYPECHECK_FIXTURE_MARKER: "caller-preserved", TYPECHECK_FIXTURE_LOG: log };
+  return { cwd, compiler, env, async calls() { return (await readFile(log, "utf8")).trim().split("\n").map(JSON.parse); }, async close() { await rm(cwd, { recursive: true, force: true }); } };
+}
+
+test("serial root gate launches fresh compiler processes in order with caller environment", async () => {
+  const f = await fixture();
+  try {
+    typecheckRoot({ ...f, projects: ["project a", "project ' b", "last"] });
+    const calls = await f.calls();
+    assert.deepEqual(calls.map(call => call.args), [["-b", "project a"], ["-b", "project ' b"], ["-b", "last"]]);
+    assert.equal(new Set(calls.map(call => call.pid)).size, 3);
+    const expectedCwd = await realpath(f.cwd);
+    assert.ok(calls.every(call => call.pid !== process.pid && call.cwd === expectedCwd && call.heap === f.env.NODE_OPTIONS && call.marker === "caller-preserved"));
+  } finally { await f.close(); }
+});
+
+test("a real compiler subprocess rejection stops the gate before later projects", async () => {
+  const f = await fixture();
+  try {
+    assert.throws(() => typecheckRoot({ ...f, projects: ["first", "reject", "must-not-run"] }), /failed with code 19/);
+    assert.deepEqual((await f.calls()).map(call => call.args), [["-b", "first"], ["-b", "reject"]]);
+  } finally { await f.close(); }
+});
