+++ b/packages/services/test/usage-price-directory.test.ts
@@ -0,0 +1,150 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFile } from "node:fs/promises";
+import { estimateUsagePrice } from "../../shared/src/usage-price.js";
+import {
+  lookupCatalogPrice,
+  resolveUsageBillingProvider,
+  USAGE_PRICE_CATALOG_INFO,
+} from "../../shared/src/usage-price-catalog.js";
+
+const input = {
+  startedAt: Date.parse("2026-09-28T12:00:00Z"),
+  inputTokens: 1_000_000,
+  outputTokens: 100_000,
+  cacheReadTokens: 500_000,
+  cacheWriteTokens: 200_000,
+  speedMode: "standard" as const,
+  hasTieredMediaInput: false,
+};
+const close = (actual: number | undefined, expected: number) =>
+  assert.ok(
+    actual !== undefined && Math.abs(actual - expected) < 1e-10,
+    `${actual} != ${expected}`,
+  );
+
+test("public price catalog covers scoped providers and never resolves an impostor endpoint", () => {
+  assert.ok(USAGE_PRICE_CATALOG_INFO.models > 7000);
+  assert.equal(resolveUsageBillingProvider("https://api.z.ai/api/anthropic"), "zai");
+  assert.equal(resolveUsageBillingProvider("https://api.openai.com.evil.example/v1"), undefined);
+  assert.equal(
+    resolveUsageBillingProvider("https://dashscope.aliyuncs.com/compatible-mode/v1"),
+    "alibaba-cn",
+  );
+  assert.equal(
+    resolveUsageBillingProvider("https://dashscope-intl.aliyuncs.com/compatible-mode/v1"),
+    "alibaba",
+  );
+  assert.equal(lookupCatalogPrice("missing", "glm-5.3", 1), undefined);
+  assert.equal(lookupCatalogPrice("zai", "glm-5.3-random", 1), undefined);
+  assert.equal(lookupCatalogPrice("openai", "gpt-6-sol", 272000)?.rates.input, 2);
+  assert.equal(lookupCatalogPrice("openai", "gpt-6-sol", 272001)?.rates.input, 4);
+  assert.deepEqual(
+    estimateUsagePrice({ ...input, billingProvider: "openai", modelId: "GPT-6-SOL" }),
+    estimateUsagePrice({ ...input, billingProvider: "openai", modelId: "gpt-6-sol" }),
+  );
+});
+
+test("official ZAI cache storage exemption does not make inference writes free", () => {
+  const price = estimateUsagePrice({ ...input, billingProvider: "zai", modelId: "GLM-5.3-Flash" });
+  close(price.estimatedUsd, 0.5 * 0.15 + 0.5 * 0.03 + 0.1 * 0.5);
+  close(
+    estimateUsagePrice({
+      ...input,
+      billingProvider: "zai",
+      modelId: "GLM-5.3-Flash",
+      speedMode: undefined,
+    }).estimatedUsd,
+    price.estimatedUsd!,
+  );
+  assert.equal(price.sourceUrl, "https://docs.z.ai/guides/overview/pricing");
+  close(
+    estimateUsagePrice({ ...input, billingProvider: "zai", modelId: "glm-4.6v" }).estimatedUsd,
+    0.5 * 0.3 + 0.5 * 0.05 + 0.1 * 0.9,
+  );
+  close(
+    estimateUsagePrice({ ...input, billingProvider: "zai", modelId: "glm-4.7-flash" }).estimatedUsd,
+    0,
+  );
+});
+
+test("official Anthropic prices use real write duration and supported Fast rates", () => {
+  const request = {
+    ...input,
+    billingProvider: "anthropic",
+    modelId: "claude-opus-5-5",
+    cacheWrite1hTokens: 50_000,
+  };
+  close(
+    estimateUsagePrice(request).estimatedUsd,
+    0.3 * 4 + 0.5 * 0.2 + 0.15 * 5 + 0.05 * 8 + 0.1 * 20,
+  );
+  close(estimateUsagePrice({ ...request, speedMode: "fast" }).estimatedUsd, 8.9);
+  assert.equal(
+    estimateUsagePrice({ ...request, cacheWrite1hTokens: undefined }).reason,
+    "cache-write-duration-missing",
+  );
+  assert.equal(
+    estimateUsagePrice({ ...request, modelId: "claude-opus-4-7", speedMode: "fast" }).reason,
+    "fast-price-unavailable",
+  );
+  close(
+    estimateUsagePrice({
+      ...request,
+      modelId: "claude-mythos-5-1",
+      cacheWriteTokens: 0,
+      cacheWrite1hTokens: 0,
+    }).estimatedUsd,
+    10.125,
+  );
+});
+
+test("directory prices are distinct from official overrides and media breakdown is not fabricated", () => {
+  const kimi = estimateUsagePrice({ ...input, billingProvider: "moonshotai", modelId: "kimi-k3" });
+  close(kimi.estimatedUsd, 0.5 * 3 + 0.5 * 0.3 + 0.1 * 15);
+  assert.equal(kimi.sourceUrl, "https://models.dev/api.json");
+  assert.ok(kimi.priceVersion.startsWith("models.dev-"));
+  const gemini = { ...input, billingProvider: "google", modelId: "gemini-3.1-pro-preview" };
+  const entry = lookupCatalogPrice(gemini.billingProvider, gemini.modelId, gemini.inputTokens);
+  assert.ok(entry);
+  if (entry.rates.inputAudio !== undefined && entry.rates.inputAudio !== entry.rates.input)
+    assert.equal(
+      estimateUsagePrice({ ...gemini, hasTieredMediaInput: true }).reason,
+      "media-token-breakdown-missing",
+    );
+  assert.equal(
+    estimateUsagePrice({ ...input, billingProvider: undefined, modelId: "gpt-6-sol" }).estimatedUsd,
+    undefined,
+  );
+});
+
+test("DeepSeek's explicitly retained legacy names share the current Flash schedule", () => {
+  const main = estimateUsagePrice({
+    ...input,
+    billingProvider: "deepseek",
+    modelId: "deepseek-flash",
+  });
+  for (const modelId of ["deepseek-v4-flash", "deepseek-v4-flash-vision-exp"])
+    assert.deepEqual(estimateUsagePrice({ ...input, billingProvider: "deepseek", modelId }), main);
+  assert.equal(
+    estimateUsagePrice({
+      ...input,
+      billingProvider: "deepseek",
+      modelId: "deepseek-v4-flash-made-up",
+    }).estimatedUsd,
+    undefined,
+  );
+});
+
+test("every shipped API preset resolves pricing through the same vendor across protocol paths", async () => {
+  const builtin = JSON.parse(
+    await readFile(new URL("../../../config/provider/zcode-builtin.json", import.meta.url), "utf8"),
+  );
+  for (const template of builtin.config.providerConfigRules.templateRules) {
+    if (template.config?.access?.type === "subscription") continue;
+    const url = template.config?.api?.baseUrl;
+    if (url) assert.ok(resolveUsageBillingProvider(url), template.templateId);
+  }
+  assert.equal(resolveUsageBillingProvider("https://api.minimaxi.com/anthropic"), "minimax-cn");
+  assert.equal(resolveUsageBillingProvider("https://api.minimax.io/anthropic"), "minimax");
+});
