new file mode 100644
index 0000000000000000000000000000000000000000..b980ae2a4102350fc6996ae4abf9ad2d3f737804
--- /dev/null
+++ b/packages/services/test/usage-price-catalog-sync.test.ts
@@ -0,0 +1,202 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { execFile } from "node:child_process";
+import { mkdtemp, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+import test from "node:test";
+import { normalizeCatalog } from "../../../scripts/sync-usage-price-catalog.mjs";
+
+const fetchedAt = "2026-09-28T08:00:00.000Z";
+const sourceHash = "a".repeat(64);
+const model = (cost: Record<string, unknown>, output = ["text"]) => ({
+  modalities: { input: ["text"], output },
+  cost,
+});
+const catalog = (models: Record<string, unknown>) => ({ provider: { name: "Provider", models } });
+const normalize = (models: Record<string, unknown>) =>
+  normalizeCatalog(catalog(models), fetchedAt, sourceHash).providers.provider.models;
+
+test("known zero differs from absent cache pricing and additional modality rates remain explicit", () => {
+  const models = normalize({
+    free: model({ input: 0, output: 0, cache_read: 0, cache_write: 0 }),
+    plain: model({ input: 1, output: 2 }),
+    reasoning: model({ input: 1, output: 2, reasoning: 2, input_audio: 3, output_audio: 4 }),
+  });
+  assert.deepEqual(models.free, { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 });
+  assert.deepEqual(models.plain, { input: 1, output: 2 });
+  assert.deepEqual(models.reasoning, {
+    input: 1,
+    output: 2,
+    reasoning: 2,
+    inputAudio: 3,
+    outputAudio: 4,
+  });
+});
+
+test("invalid and unsupported rates never become zero or flatten to the base price", () => {
+  const models: Record<string, unknown> = { valid: model({ input: 1, output: 2 }) };
+  for (const [index, cost] of [
+    { input: -1, output: 2 },
+    { input: "1", output: 2 },
+    { input: 1 },
+    { input: Infinity, output: 2 },
+    { input: NaN, output: 2 },
+    { input: Number.MAX_SAFE_INTEGER + 1, output: 2 },
+    { input: 1, output: 2, cache_read: null },
+    { input: 1, output: 2, reasoning: -1 },
+    { input: 1, output: 2, request: 5 },
+    { input: 1, output: 2, tiers: {} },
+    { input: 1, output: 2, tiers: [] },
+    { input: 1, output: 2, tiers: [{ input: 4, tier: { type: "batch", size: 200_000 } }] },
+    { input: 1, output: 2, tiers: [{ input: 4, tier: { type: "context", size: 0 } }] },
+    { input: 1, output: 2, tiers: [{ cache_write: -1, tier: { type: "context", size: 200_000 } }] },
+    { input: 1, output: 2, context_over_200k: { unexpected: 1 } },
+  ].entries())
+    models[`invalid-${index}`] = model(cost);
+  assert.deepEqual(normalize(models), { valid: { input: 1, output: 2 } });
+});
+
+test("explicit context thresholds take priority, merge partial rates, and sort without losing audio rates", () => {
+  const models = normalize({
+    current: model({
+      input: 1,
+      output: 2,
+      cache_read: 0.1,
+      input_audio: 3,
+      tiers: [
+        { output: 8, input_audio: 6, tier: { type: "context", size: 272_000 } },
+        { input: 2, cache_read: 0, tier: { type: "context", size: 128_000 } },
+      ],
+      context_over_200k: { input: 100, output: 100 },
+    }),
+    legacy: model({ input: 1, output: 2, context_over_200k: { output: 3 } }),
+  });
+  assert.deepEqual(models.current.tiers, [
+    { above: 128_000, input: 2, output: 2, cacheRead: 0, inputAudio: 3 },
+    { above: 272_000, input: 1, output: 8, cacheRead: 0.1, inputAudio: 6 },
+  ]);
+  assert.deepEqual(models.legacy.tiers, [{ above: 200_000, input: 1, output: 3 }]);
+  const duplicate = { input: 3, tier: { type: "context", size: 200_000 } };
+  assert.deepEqual(
+    normalize({
+      valid: model({ input: 1, output: 2 }),
+      duplicate: model({ input: 1, output: 2, tiers: [duplicate, duplicate] }),
+    }),
+    { valid: { input: 1, output: 2 } },
+  );
+});
+
+test("provider-scoped model IDs never collide, keys are deterministic, and unsafe URLs are omitted", () => {
+  const a = {
+    name: "A",
+    api: "https://api.example.com/v1",
+    doc: "https://docs.example.com/pricing",
+    models: {
+      "a/model": model({ input: 1, output: 2 }),
+      "MODEL:1": model({ input: 3, output: 4 }),
+    },
+  };
+  const z = {
+    name: "Z",
+    api: "https://secret:password@api.example.com/v1",
+    doc: "https://docs.example.com/?key=secret",
+    models: { "a/model": model({ input: 10, output: 20 }) },
+  };
+  const result = normalizeCatalog({ z, a }, fetchedAt, sourceHash);
+  assert.deepEqual(result, normalizeCatalog({ a, z }, fetchedAt, sourceHash));
+  assert.deepEqual(Object.keys(result.providers), ["a", "z"]);
+  assert.deepEqual(Object.keys(result.providers.a.models), ["MODEL:1", "a/model"]);
+  assert.equal(result.providers.a.models["a/model"].input, 1);
+  assert.equal(result.providers.z.models["a/model"].input, 10);
+  assert.equal(result.providers.a.api, a.api);
+  assert.equal(result.providers.a.doc, a.doc);
+  assert.equal(result.providers.z.api, undefined);
+  assert.equal(result.providers.z.doc, undefined);
+  for (const url of ["http://api.example.com", "https://api.example.com/#key", "not a url"]) {
+    assert.equal(
+      normalizeCatalog({ a: { ...a, api: url } }, fetchedAt, sourceHash).providers.a.api,
+      undefined,
+    );
+  }
+});
+
+test("only explicitly text-only output models enter the token price catalog", () => {
+  assert.deepEqual(
+    normalize({
+      text: model({ input: 1, output: 2 }),
+      image: model({ input: 1, output: 2 }, ["image"]),
+      mixed: model({ input: 1, output: 2 }, ["text", "audio"]),
+      empty: model({ input: 1, output: 2 }, []),
+      unknown: { cost: { input: 1, output: 2 } },
+    }),
+    { text: { input: 1, output: 2 } },
+  );
+});
+
+test("empty, malformed, or provenance-free catalogs are rejected before publishing", () => {
+  for (const invalid of [
+    null,
+    [],
+    {},
+    { provider: null },
+    { provider: { name: "P" } },
+    catalog({}),
+    catalog({ invalid: model({ input: -1, output: 2 }) }),
+  ]) {
+    assert.throws(() => normalizeCatalog(invalid, fetchedAt, sourceHash));
+  }
+  assert.throws(() =>
+    normalizeCatalog(catalog({ valid: model({ input: 1, output: 2 }) }), "invalid", sourceHash),
+  );
+  assert.throws(() =>
+    normalizeCatalog(catalog({ valid: model({ input: 1, output: 2 }) }), fetchedAt, ""),
+  );
+});
+
+test("CLI publishes deterministic content with its actual source hash and preserves the prior file on failure", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-price-catalog-"));
+  const input = join(directory, "input.json");
+  const output = join(directory, "output.json");
+  const script = fileURLToPath(
+    new URL("../../../scripts/sync-usage-price-catalog.mjs", import.meta.url),
+  );
+  const run = () =>
+    promisify(execFile)(process.execPath, [
+      script,
+      "--input",
+      input,
+      "--output",
+      output,
+      "--fetched-at",
+      fetchedAt,
+    ]);
+  try {
+    const raw = JSON.stringify(catalog({ model: model({ input: 1, output: 2 }) }));
+    await writeFile(input, raw);
+    await run();
+    const saved = await readFile(output, "utf8");
+    const hash = createHash("sha256").update(raw).digest("hex");
+    const parsed = JSON.parse(saved);
+    assert.equal(parsed.sourceHash, hash);
+    assert.equal(parsed.version, `models.dev-2026-09-28-${hash.slice(0, 12)}`);
+    assert.equal(parsed.sourceUrl, "https://models.dev/api.json");
+    await run();
+    assert.equal(await readFile(output, "utf8"), saved);
+    for (const invalid of [
+      "{",
+      "{}",
+      JSON.stringify(catalog({})),
+      " ".repeat(12 * 1024 * 1024 + 1),
+    ]) {
+      await writeFile(input, invalid);
+      await assert.rejects(run());
+      assert.equal(await readFile(output, "utf8"), saved);
+    }
+    assert.deepEqual((await readdir(directory)).sort(), ["input.json", "output.json"]);
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
