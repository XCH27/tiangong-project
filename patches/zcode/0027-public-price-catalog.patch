diff --git a/scripts/sync-usage-price-catalog.mjs b/scripts/sync-usage-price-catalog.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3f8a666731695cc37767ca731cdf82d4e3253bb0
--- /dev/null
+++ b/scripts/sync-usage-price-catalog.mjs
@@ -0,0 +1,221 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, readFile, rename, rm, stat, writeFile } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const SOURCE_URL = "https://models.dev/api.json";
+const MAX_BYTES = 12 * 1024 * 1024;
+const RATE_NAMES = {
+  input: "input",
+  output: "output",
+  cache_read: "cacheRead",
+  cache_write: "cacheWrite",
+  reasoning: "reasoning",
+  input_audio: "inputAudio",
+  output_audio: "outputAudio",
+};
+const RATE_FIELDS = Object.keys(RATE_NAMES);
+const COST_FIELDS = new Set([...RATE_FIELDS, "tiers", "context_over_200k"]);
+const isRecord = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const isRate = (value) =>
+  typeof value === "number" &&
+  Number.isFinite(value) &&
+  value >= 0 &&
+  value <= Number.MAX_SAFE_INTEGER;
+
+function safeUrl(value) {
+  if (typeof value !== "string") return undefined;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && !url.username && !url.password && !url.search && !url.hash
+      ? url.href
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function rates(value, base) {
+  if (!isRecord(value)) return undefined;
+  for (const field of RATE_FIELDS) {
+    if (Object.hasOwn(value, field) && !isRate(value[field])) return undefined;
+  }
+  const input = value.input ?? base?.input;
+  const output = value.output ?? base?.output;
+  if (!isRate(input) || !isRate(output)) return undefined;
+  const result = { input, output };
+  for (const [source, destination] of Object.entries(RATE_NAMES)) {
+    const rate = value[source] ?? base?.[destination];
+    if (rate !== undefined) result[destination] = rate;
+  }
+  return result;
+}
+
+function normalizeCost(cost) {
+  if (!isRecord(cost) || Object.keys(cost).some((key) => !COST_FIELDS.has(key))) return undefined;
+  const base = rates(cost);
+  if (!base) return undefined;
+  let tiers;
+  // models.dev 的显式阈值可能是 256K/272K，不能被旧的 context_over_200k 字段覆盖。
+  if (Object.hasOwn(cost, "tiers")) {
+    if (!Array.isArray(cost.tiers) || cost.tiers.length === 0) return undefined;
+    tiers = [];
+    for (const entry of cost.tiers) {
+      if (
+        !isRecord(entry) ||
+        Object.keys(entry).some((key) => key !== "tier" && !RATE_FIELDS.includes(key)) ||
+        !isRecord(entry.tier) ||
+        Object.keys(entry.tier).some((key) => key !== "type" && key !== "size") ||
+        entry.tier.type !== "context" ||
+        !Number.isSafeInteger(entry.tier.size) ||
+        entry.tier.size <= 0 ||
+        !RATE_FIELDS.some((field) => Object.hasOwn(entry, field))
+      )
+        return undefined;
+      const tierRates = rates(entry, base);
+      if (!tierRates || tiers.some((tier) => tier.above === entry.tier.size)) return undefined;
+      tiers.push({ above: entry.tier.size, ...tierRates });
+    }
+    tiers.sort((a, b) => a.above - b.above);
+  } else if (Object.hasOwn(cost, "context_over_200k")) {
+    const legacy = cost.context_over_200k;
+    if (
+      !isRecord(legacy) ||
+      Object.keys(legacy).some((key) => !RATE_FIELDS.includes(key)) ||
+      !RATE_FIELDS.some((field) => Object.hasOwn(legacy, field))
+    )
+      return undefined;
+    const tierRates = rates(legacy, base);
+    if (!tierRates) return undefined;
+    tiers = [{ above: 200_000, ...tierRates }];
+  }
+  return { ...base, ...(tiers ? { tiers } : {}) };
+}
+
+/** Reduce models.dev's USD-per-million text token prices without inventing missing rates. */
+export function normalizeCatalog(payload, fetchedAt, sourceHash) {
+  if (!isRecord(payload) || Object.keys(payload).length === 0)
+    throw new Error("Empty or malformed catalog");
+  if (typeof fetchedAt !== "string" || !Number.isFinite(Date.parse(fetchedAt)))
+    throw new Error("Invalid fetchedAt");
+  if (typeof sourceHash !== "string" || !/^[a-f0-9]{64}$/.test(sourceHash))
+    throw new Error("Invalid sourceHash");
+  const timestamp = new Date(fetchedAt).toISOString();
+  const providers = [];
+  for (const providerId of Object.keys(payload).sort()) {
+    const provider = payload[providerId];
+    if (
+      !providerId ||
+      !isRecord(provider) ||
+      typeof provider.name !== "string" ||
+      !provider.name.trim() ||
+      !isRecord(provider.models)
+    ) {
+      throw new Error(`Malformed provider: ${providerId}`);
+    }
+    const models = [];
+    for (const modelId of Object.keys(provider.models).sort()) {
+      const model = provider.models[modelId];
+      if (
+        !modelId ||
+        !isRecord(model) ||
+        !Array.isArray(model.modalities?.output) ||
+        model.modalities.output.length !== 1 ||
+        model.modalities.output[0] !== "text"
+      )
+        continue;
+      const cost = normalizeCost(model.cost);
+      if (cost) models.push([modelId, cost]);
+    }
+    if (!models.length) continue;
+    const api = safeUrl(provider.api);
+    const doc = safeUrl(provider.doc);
+    providers.push([
+      providerId,
+      {
+        name: provider.name,
+        ...(api ? { api } : {}),
+        ...(doc ? { doc } : {}),
+        models: Object.fromEntries(models),
+      },
+    ]);
+  }
+  if (!providers.length) throw new Error("Catalog contains no supported text prices");
+  return {
+    version: `models.dev-${timestamp.slice(0, 10)}-${sourceHash.slice(0, 12)}`,
+    fetchedAt: timestamp,
+    sourceUrl: SOURCE_URL,
+    sourceHash,
+    providers: Object.fromEntries(providers),
+  };
+}
+
+async function fetchCatalog() {
+  const response = await fetch(SOURCE_URL, {
+    signal: AbortSignal.timeout(30_000),
+    redirect: "error",
+  });
+  if (!response.ok || !response.body)
+    throw new Error(`Catalog download failed: HTTP ${response.status}`);
+  if (Number(response.headers.get("content-length")) > MAX_BYTES) {
+    await response.body.cancel();
+    throw new Error("Catalog exceeds 12 MB");
+  }
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of response.body) {
+    size += chunk.byteLength;
+    if (size > MAX_BYTES) throw new Error("Catalog exceeds 12 MB");
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks);
+}
+
+async function main(args) {
+  const options = new Map();
+  for (let i = 0; i < args.length; i += 2) {
+    if (
+      !["--input", "--output", "--fetched-at"].includes(args[i]) ||
+      !args[i + 1] ||
+      args[i + 1].startsWith("--") ||
+      options.has(args[i])
+    ) {
+      throw new Error(
+        "Usage: node scripts/sync-usage-price-catalog.mjs [--input file] [--output file] [--fetched-at ISO]",
+      );
+    }
+    options.set(args[i], args[i + 1]);
+  }
+  const input = options.get("--input");
+  if (input && (await stat(input)).size > MAX_BYTES) throw new Error("Catalog exceeds 12 MB");
+  const bytes = input ? await readFile(input) : await fetchCatalog();
+  if (bytes.length > MAX_BYTES) throw new Error("Catalog exceeds 12 MB");
+  const catalog = normalizeCatalog(
+    JSON.parse(bytes.toString("utf8")),
+    options.get("--fetched-at") ?? new Date().toISOString(),
+    createHash("sha256").update(bytes).digest("hex"),
+  );
+  const output = resolve(
+    options.get("--output") ??
+      fileURLToPath(new URL("../packages/shared/src/usage-price-catalog.json", import.meta.url)),
+  );
+  await mkdir(dirname(output), { recursive: true });
+  const temporary = `${output}.${randomUUID()}.tmp`;
+  try {
+    await writeFile(temporary, `${JSON.stringify(catalog, null, 2)}\n`, { flag: "wx" });
+    await rename(temporary, output);
+  } finally {
+    await rm(temporary, { force: true });
+  }
+  const providers = Object.values(catalog.providers);
+  console.log(
+    `${catalog.version}: ${providers.length} providers, ${providers.reduce((total, provider) => total + Object.keys(provider.models).length, 0)} models`,
+  );
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  main(process.argv.slice(2)).catch((error) => {
+    console.error(error.message);
+    process.exitCode = 1;
+  });
+}
