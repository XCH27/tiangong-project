diff --git a/packages/shared/src/usage-price-catalog.ts b/packages/shared/src/usage-price-catalog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..115de3ff3de6b68700f1ce546722787a0551f50e
--- /dev/null
+++ b/packages/shared/src/usage-price-catalog.ts
@@ -0,0 +1,114 @@
+import snapshot from "./usage-price-catalog.json" with { type: "json" };
+
+export interface CatalogTokenRates {
+  input: number;
+  output: number;
+  cacheRead?: number;
+  cacheWrite?: number;
+  reasoning?: number;
+  inputAudio?: number;
+  outputAudio?: number;
+}
+export interface CatalogPrice extends CatalogTokenRates {
+  tiers?: Array<CatalogTokenRates & { above: number }>;
+}
+interface CatalogProvider {
+  name: string;
+  api?: string;
+  doc?: string;
+  models: Record<string, CatalogPrice>;
+}
+interface PriceCatalog {
+  version: string;
+  fetchedAt: string;
+  sourceUrl: string;
+  providers: Record<string, CatalogProvider>;
+}
+const catalog = snapshot as unknown as PriceCatalog;
+export const USAGE_PRICE_CATALOG_INFO = {
+  version: catalog.version,
+  fetchedAt: catalog.fetchedAt,
+  sourceUrl: catalog.sourceUrl,
+  providers: Object.keys(catalog.providers).length,
+  models: Object.values(catalog.providers).reduce(
+    (total, provider) => total + Object.keys(provider.models).length,
+    0,
+  ),
+};
+
+export function lookupCatalogPrice(providerId: string, modelId: string, inputTokens: number) {
+  if (!Object.hasOwn(catalog.providers, providerId)) return undefined;
+  const provider = catalog.providers[providerId]!;
+  // 营销名称常保留大写；只接受同供应商内唯一的大小写匹配，不删除模型版本/后缀。
+  const matches = Object.hasOwn(provider.models, modelId)
+    ? [modelId]
+    : Object.keys(provider.models).filter((id) => id.toLowerCase() === modelId.toLowerCase());
+  if (matches.length !== 1) return undefined;
+  const id = matches[0]!;
+  const model = provider.models[id]!;
+  const tier = model.tiers?.filter((value) => inputTokens > value.above).at(-1);
+  return {
+    modelId: id,
+    rates: tier ?? model,
+    sourceUrl: catalog.sourceUrl,
+    providerUrl: provider.doc,
+    version: catalog.version,
+  };
+}
+
+const nativeOrigins: Record<string, string> = {
+  "https://api.openai.com": "openai",
+  "https://api.anthropic.com": "anthropic",
+  "https://generativelanguage.googleapis.com": "google",
+  "https://api.x.ai": "xai",
+  "https://cli-chat-proxy.grok.com": "xai",
+  "https://api.deepseek.com": "deepseek",
+  "https://api.z.ai": "zai",
+  "https://open.bigmodel.cn": "zhipuai",
+  "https://dashscope.aliyuncs.com": "alibaba-cn",
+  "https://dashscope-intl.aliyuncs.com": "alibaba",
+  "https://api.moonshot.cn": "moonshotai-cn",
+  "https://api.moonshot.ai": "moonshotai",
+  "https://api.minimaxi.com": "minimax-cn",
+  "https://api.minimax.cn": "minimax-cn",
+  "https://api.minimax.io": "minimax",
+  "https://api.xiaomimimo.com": "xiaomi",
+  "https://openrouter.ai": "openrouter",
+  "https://api.groq.com": "groq",
+  "https://api.cerebras.ai": "cerebras",
+  "https://api.mistral.ai": "mistral",
+  "https://api.together.ai": "togetherai",
+  "https://api.kimi.com": "kimi-code-plan-cn",
+  "https://api.kimi.ai": "kimi-code-plan-global",
+};
+const catalogRoutes = Object.entries(catalog.providers).flatMap(([id, provider]) => {
+  if (!provider.api) return [];
+  try {
+    const url = new URL(provider.api);
+    return [{ id, origin: url.origin, path: url.pathname.replace(/\/+$/, "") }];
+  } catch {
+    return [];
+  }
+});
+
+/** Pricing attribution only: never changes the actual endpoint or authentication. */
+export function resolveUsageBillingProvider(baseUrl: string): string | undefined {
+  let url: URL;
+  try {
+    url = new URL(baseUrl);
+  } catch {
+    return undefined;
+  }
+  if (url.protocol !== "https:" || url.username || url.password) return undefined;
+  if (Object.hasOwn(nativeOrigins, url.origin)) return nativeOrigins[url.origin];
+  const path = url.pathname.replace(/\/+$/, "");
+  const matches = catalogRoutes.filter(
+    (route) =>
+      route.origin === url.origin && (path === route.path || path.startsWith(`${route.path}/`)),
+  );
+  const longest = Math.max(-1, ...matches.map((route) => route.path.length));
+  const ids = new Set(
+    matches.filter((route) => route.path.length === longest).map((route) => route.id),
+  );
+  return ids.size === 1 ? [...ids][0] : undefined;
+}
diff --git a/packages/shared/src/usage-price-directory.ts b/packages/shared/src/usage-price-directory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c446a833eaa92812c65f961954b758baefc62617
--- /dev/null
+++ b/packages/shared/src/usage-price-directory.ts
@@ -0,0 +1,61 @@
+import { lookupCatalogPrice } from "./usage-price-catalog.js";
+import { lookupOfficialPrice } from "./usage-price-official.js";
+import type { UsagePriceEstimate, UsagePriceInput } from "./usage-price.js";
+
+/** Current token-rate estimate; raw counters and provider identity are already validated by the owner. */
+export function estimateDirectoryUsagePrice(input: UsagePriceInput): UsagePriceEstimate {
+  const official = lookupOfficialPrice(input.billingProvider!, input.modelId);
+  const entry = lookupCatalogPrice(input.billingProvider!, input.modelId, input.inputTokens!);
+  const version = official?.version ?? entry?.version ?? "unpriced";
+  const sourceUrl = official?.sourceUrl ?? entry?.sourceUrl;
+  const missing = (reason: string): UsagePriceEstimate => ({
+    priceVersion: version,
+    sourceUrl,
+    reason,
+  });
+  const rates = official?.rates ?? entry?.rates;
+  if (!rates) return missing("model-price-unavailable");
+  if (
+    rates.inputAudio !== undefined &&
+    rates.inputAudio !== rates.input &&
+    input.hasTieredMediaInput !== false
+  )
+    return missing("media-token-breakdown-missing");
+  // GLM 的 Flash/FlashX 是分别定价的模型 ID，没有同一 ID 的通用 Fast 计费档。
+  // 不为与该价目无关的历史速度字段阻断估算；也不把未知速度改写成 Standard。
+  if (input.speedMode === undefined && !official?.rates.speedIndependent)
+    return missing("speed-mode-missing");
+  if (input.speedMode !== undefined && input.speedMode !== "standard" && input.speedMode !== "fast")
+    return missing("speed-mode-unavailable");
+  const multiplier = input.speedMode === "fast" ? official?.rates.fastMultiplier : 1;
+  if (multiplier === undefined) return missing("fast-price-unavailable");
+  const reads = input.cacheReadTokens!;
+  if (reads > 0 && rates.cacheRead === undefined) return missing("cache-read-price-unavailable");
+  // Z.AI 的“缓存存储免费”不是写入推理免费；这些 tokens 仍按普通输入计价。
+  const writesIncluded = official?.rates.writesIncluded === true;
+  const writes = writesIncluded || rates.cacheWrite === undefined ? 0 : input.cacheWriteTokens;
+  if (writes === undefined) return missing("cache-write-tokens-missing");
+  let oneHour = 0;
+  if (input.billingProvider === "anthropic" && writes > 0) {
+    if (input.cacheWrite1hTokens === undefined) return missing("cache-write-duration-missing");
+    oneHour = input.cacheWrite1hTokens;
+    if (!Number.isSafeInteger(oneHour) || oneHour < 0 || oneHour > writes)
+      return missing("invalid-cache-write-duration");
+    if (oneHour > 0 && official?.rates.cacheWrite1h === undefined)
+      return missing("cache-write-duration-price-unavailable");
+  }
+  let cost =
+    (input.inputTokens! - reads - writes) * rates.input +
+    reads * (rates.cacheRead ?? 0) +
+    (writes - oneHour) * (rates.cacheWrite ?? 0) +
+    oneHour * (official?.rates.cacheWrite1h ?? 0) +
+    input.outputTokens! * rates.output;
+  if (rates.reasoning !== undefined && rates.reasoning !== rates.output) {
+    const reasoning = input.reasoningTokens;
+    if (reasoning === undefined) return missing("reasoning-token-count-missing");
+    if (!Number.isSafeInteger(reasoning) || reasoning < 0 || reasoning > input.outputTokens!)
+      return missing("invalid-reasoning-tokens");
+    cost += reasoning * (rates.reasoning - rates.output);
+  }
+  return { estimatedUsd: (cost / 1_000_000) * multiplier, priceVersion: version, sourceUrl };
+}
