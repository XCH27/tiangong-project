+    25,
+    0.5,
+    undefined,
+  ],
+  [["claude-sonnet-4-6", "claude-sonnet-4-5", "claude-sonnet-4-5-20250929"], 3, 15, 0.3, undefined],
+  [["claude-haiku-4-5", "claude-haiku-4-5-20251001"], 1, 5, 0.1, undefined],
+] as const)
+  for (const id of ids)
+    claude[id] = {
+      input,
+      output,
+      cacheRead: read,
+      cacheWrite: input * 1.25,
+      cacheWrite1h: input * 2,
+      fastMultiplier: fast,
+    };
+
+const zai: Record<string, OfficialRate> = {};
+for (const [ids, input, output, read] of [
+  [["glm-5.3-flash"], 0.15, 0.5, 0.03],
+  [["glm-5.3-flashx"], 0.37, 1.25, 0.075],
+  [["glm-5.3", "glm-5.2", "glm-5.1"], 1.4, 4.4, 0.26],
+  [["glm-5"], 1, 3.2, 0.2],
+  [["glm-4.7", "glm-4.6", "glm-4.5"], 0.6, 2.2, 0.11],
+  [["glm-4.7-flashx"], 0.07, 0.4, 0.01],
+  [["glm-4.5-x"], 2.2, 8.9, 0.45],
+  [["glm-4.5-air"], 0.2, 1.1, 0.03],
+  [["glm-4.5-airx"], 1.1, 4.5, 0.22],
+  [["glm-4-32b-0414-128k"], 0.1, 0.1, undefined],
+  [["glm-4.6v"], 0.3, 0.9, 0.05],
+  [["glm-4.6v-flashx"], 0.04, 0.4, 0.004],
+  [["glm-4.5v"], 0.6, 1.8, 0.11],
+  [["glm-4.7-flash", "glm-4.5-flash", "glm-4.6v-flash"], 0, 0, 0],
+] as const)
+  for (const id of ids)
+    zai[id] = { input, output, cacheRead: read, writesIncluded: true, speedIndependent: true };
+
+/** Official corrections override directory data only within the verified provider/region. */
+export function lookupOfficialPrice(provider: string, modelId: string) {
+  const values = provider === "anthropic" ? claude : provider === "zai" ? zai : undefined;
+  const id = modelId.toLowerCase();
+  if (!values || !Object.hasOwn(values, id)) return undefined;
+  return {
+    rates: values[id]!,
+    sourceUrl: provider === "anthropic" ? CLAUDE_SOURCE : ZAI_SOURCE,
+    version: "official-2026-09-28",
+  };
+}
