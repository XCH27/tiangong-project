+
+test("enqueue routing stays queue_path even when control.steerable true", () => {
+  const honesty = classifyNativeGuideHonestyFromSnapshotControl({
+    inputRouting: { mode: "enqueue" },
+    steerable: true,
+  });
+  assert.equal(honesty, "queue_path");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+});
+
+test("projectPendingGuideQueue: control.steerable false overrides guide routing", () => {
+  const queue: QueueState = {
+    items: [guideItem("g1", 1)],
+  } as QueueState;
+  const projected = projectPendingGuideQueue(queue, {
+    inputRouting: { mode: "guide" },
+    steerable: false,
+  });
+  assert.equal(projected.honesty, "not_steerable");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(projected.honesty), false);
+});
+
+test("projectPendingGuideQueue: control.steerable true + guide is steerable", () => {
+  const queue: QueueState = {
+    items: [guideItem("g1", 1)],
+  } as QueueState;
+  const projected = projectPendingGuideQueue(queue, {
+    inputRouting: { mode: "guide" },
+    steerable: true,
