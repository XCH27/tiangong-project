@@ -0,0 +1,234 @@
+import {
+  SessionEventType,
+  createSessionEvent,
+  type SessionEvent,
+  type SessionId,
+  type SessionStorePort,
+} from "../deps.js";
+
+/**
+ * Remote Host / attachment Stop → Session cold writer toehold.
+ *
+ * OSS pattern (bash_stop / subagent_stop): stop lifetime events are durable Session
+ * entries; cold reopen never invents running. Registry Stop is already DI-proven
+ * (`remote-host-attachment-stop-fixture`); this module persists honest detach / idle /
+ * transport-close receipts and projects **linked** bash/subagent tasks only.
+ *
+ * Never invents live SSH/WSL/Docker/MessagePort. Never invents a new BackgroundTask
+ * taskKind. Empty linkedTasks → durable receipt, zero backgroundWorks rows.
+ */
+
+export const REMOTE_HOST_ATTACHMENT_STOP_SESSION_ENTRY =
+  "remote_host_attachment_stop" as const;
+
+export type RemoteHostAttachmentStopReason =
+  | "session_detach"
+  | "transport_close"
+  | "idle_dispose"
+  | "dispose_remote";
+
+export type RemoteHostAttachmentStopTargetKind = "docker" | "ssh" | "wsl";
+
+export interface RemoteHostAttachmentStopLinkedTask {
+  taskId: string;
+  toolName: "Bash" | "Agent" | "Task";
+  taskKind: "bash" | "subagent";
+  /** Terminal only — never running. */
+  status: "cancelled" | "lost";
+  description?: string;
+  command?: string;
+  toolCallId?: string;
+  startedAt?: number;
+  completedAt?: number;
+  traceId?: string;
+}
+
+export interface RemoteHostAttachmentStopReceipt {
+  remoteSessionId: string;
+  reason: RemoteHostAttachmentStopReason;
+  targetKind?: RemoteHostAttachmentStopTargetKind;
+  attachmentIds: string[];
+  stoppedAt: number;
+  linkedTasks?: RemoteHostAttachmentStopLinkedTask[];
+}
+
+export function remoteHostAttachmentStopKey(receipt: RemoteHostAttachmentStopReceipt): string {
+  return `remote-host-attachment-stop:${receipt.remoteSessionId}:${receipt.reason}:${receipt.stoppedAt}`;
+}
+
+export function restoreRemoteHostAttachmentStopReceipt(
+  value: unknown,
+): RemoteHostAttachmentStopReceipt | undefined {
+  if (!value || typeof value !== "object") return undefined;
+  const data = value as RemoteHostAttachmentStopReceipt;
+  if (typeof data.remoteSessionId !== "string" || data.remoteSessionId.length === 0) {
+    return undefined;
+  }
+  if (
+    data.reason !== "session_detach" &&
+    data.reason !== "transport_close" &&
+    data.reason !== "idle_dispose" &&
+    data.reason !== "dispose_remote"
+  ) {
+    return undefined;
+  }
+  if (
+    data.targetKind !== undefined &&
+    data.targetKind !== "docker" &&
+    data.targetKind !== "ssh" &&
+    data.targetKind !== "wsl"
+  ) {
+    return undefined;
+  }
+  if (!Array.isArray(data.attachmentIds) || !data.attachmentIds.every((id) => typeof id === "string")) {
+    return undefined;
+  }
+  if (typeof data.stoppedAt !== "number" || !Number.isFinite(data.stoppedAt) || data.stoppedAt < 0) {
+    return undefined;
+  }
+  const linkedTasks: RemoteHostAttachmentStopLinkedTask[] = [];
+  if (data.linkedTasks !== undefined) {
+    if (!Array.isArray(data.linkedTasks)) return undefined;
+    for (const task of data.linkedTasks) {
+      if (!task || typeof task !== "object") return undefined;
+      if (typeof task.taskId !== "string" || task.taskId.length === 0) return undefined;
+      if (task.toolName !== "Bash" && task.toolName !== "Agent" && task.toolName !== "Task") {
+        return undefined;
+      }
+      if (task.taskKind !== "bash" && task.taskKind !== "subagent") return undefined;
+      if (task.status !== "cancelled" && task.status !== "lost") return undefined;
+      if (task.description !== undefined && typeof task.description !== "string") return undefined;
+      if (task.command !== undefined && typeof task.command !== "string") return undefined;
+      if (task.toolCallId !== undefined && typeof task.toolCallId !== "string") return undefined;
+      if (
+        task.startedAt !== undefined &&
+        (typeof task.startedAt !== "number" || !Number.isFinite(task.startedAt))
+      ) {
+        return undefined;
+      }
+      if (
+        task.completedAt !== undefined &&
+        (typeof task.completedAt !== "number" || !Number.isFinite(task.completedAt))
+      ) {
+        return undefined;
+      }
+      if (task.traceId !== undefined && typeof task.traceId !== "string") return undefined;
+      linkedTasks.push({
+        taskId: task.taskId,
+        toolName: task.toolName,
+        taskKind: task.taskKind,
+        status: task.status,
+        ...(task.description !== undefined ? { description: task.description } : {}),
+        ...(task.command !== undefined ? { command: task.command } : {}),
+        ...(task.toolCallId !== undefined ? { toolCallId: task.toolCallId } : {}),
+        ...(task.startedAt !== undefined ? { startedAt: task.startedAt } : {}),
+        ...(task.completedAt !== undefined ? { completedAt: task.completedAt } : {}),
+        ...(task.traceId !== undefined ? { traceId: task.traceId } : {}),
+      });
+    }
+  }
+  return {
+    remoteSessionId: data.remoteSessionId,
+    reason: data.reason,
+    ...(data.targetKind !== undefined ? { targetKind: data.targetKind } : {}),
+    attachmentIds: [...data.attachmentIds],
+    stoppedAt: data.stoppedAt,
+    ...(linkedTasks.length > 0 ? { linkedTasks } : {}),
+  };
+}
+
+export async function persistRemoteHostAttachmentStopReceipt(input: {
+  sessionStore?: Pick<SessionStorePort, "saveSessionEntry">;
+  sessionId: SessionId;
+  receipt: RemoteHostAttachmentStopReceipt;
+}): Promise<void> {
+  const store = input.sessionStore;
+  if (!store?.saveSessionEntry) return;
+  const receipt = restoreRemoteHostAttachmentStopReceipt(input.receipt);
+  if (!receipt) return;
+  const now = Date.now();
+  await store.saveSessionEntry({
+    id: remoteHostAttachmentStopKey(receipt),
+    sessionID: input.sessionId,
+    type: REMOTE_HOST_ATTACHMENT_STOP_SESSION_ENTRY,
+    touchSession: false,
+    time: { created: receipt.stoppedAt, updated: now },
+    data: receipt,
+  });
+}
+
+/**
+ * Cold projection: linked bash/subagent tasks → BackgroundTaskCompleted.
+ * Skips taskIds already covered by memory/prior projectors. Never invents running.
+ * Receipts with empty linkedTasks contribute no panel rows (honest non-invent).
+ */
+export function synthesizeBackgroundTaskEventsFromRemoteHostAttachmentStopEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+}): SessionEvent[] {
+  const sessionId = String(input.sessionId);
+  const memoryTerminalTaskIds = new Set<string>();
+  for (const event of input.memoryEvents ?? []) {
+    if (event.type !== SessionEventType.BackgroundTaskCompleted) continue;
+    const taskId =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown }).taskId
+        : undefined;
+    if (typeof taskId === "string" && taskId.length > 0) {
+      memoryTerminalTaskIds.add(taskId);
+    }
+  }
+
+  const byTaskId = new Map<
+    string,
+    { task: RemoteHostAttachmentStopLinkedTask; stoppedAt: number }
+  >();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== REMOTE_HOST_ATTACHMENT_STOP_SESSION_ENTRY) {
+      continue;
+    }
+    const receipt = restoreRemoteHostAttachmentStopReceipt(entry.data);
+    if (!receipt?.linkedTasks?.length) continue;
+    for (const task of receipt.linkedTasks) {
+      const existing = byTaskId.get(task.taskId);
+      const stoppedAt = task.completedAt ?? receipt.stoppedAt;
+      if (!existing || stoppedAt >= existing.stoppedAt) {
+        byTaskId.set(task.taskId, { task, stoppedAt });
+      }
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { task, stoppedAt } of byTaskId.values()) {
+    if (memoryTerminalTaskIds.has(task.taskId)) continue;
+    const completedAt = new Date(task.completedAt ?? stoppedAt);
+    const startedAt =
+      task.startedAt !== undefined ? new Date(task.startedAt) : new Date(completedAt.getTime() - 1);
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskCompleted,
+      sessionId as SessionId,
+      {
+        taskId: task.taskId,
+        ...(task.toolCallId ? { toolCallId: task.toolCallId } : {}),
+        toolName: task.toolName,
+        taskKind: task.taskKind,
+        cancellable: false,
+        ...(task.command ? { command: task.command } : {}),
+        ...(task.description ? { description: task.description } : {}),
+        status: task.status,
+        startedAt,
+        completedAt,
+        terminalId: task.taskId,
+      },
+      {
+        ...(task.traceId ? { traceId: task.traceId as never } : {}),
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = completedAt;
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
