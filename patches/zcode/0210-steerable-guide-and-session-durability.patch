+export async function settleVendorDeliveredNativeGuides(
+  runtime: AgentRuntimeInternal,
+  state: RegularTurnLoopState,
+): Promise<number> {
+  const activeTurn = state.activeTurn;
+  const deliveredIds = activeTurn?.nativeGuideVendorDeliveredIds;
+  if (!activeTurn || !deliveredIds?.size) return 0;
+  let settled = 0;
+  while (runtime.hasInlineGuidePendingInput(activeTurn)) {
