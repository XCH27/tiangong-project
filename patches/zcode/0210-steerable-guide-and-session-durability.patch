+test("MessagePort-shaped attach → Host session_detach → product Session write (fixture e2e)", async () => {
+  const store = memorySessionStore();
+  const glue = createRemoteHostAttachmentStopSessionGlue({ now: () => 1_700_000_410_000 });
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
