+): false {
+  return false;
+}
+
+export function isForbiddenPluginMcpProductLabel(
+  label: string,
+): label is PluginMcpForbiddenProductLabel {
+  return (PLUGIN_MCP_FORBIDDEN_PRODUCT_LABELS as readonly string[]).includes(label);
+}
