+import assert from "node:assert/strict";
+import test from "node:test";
+import { admitAttempt } from "../src/model/request-admission.js";
+
+test("admitAttempt is a no-op without a Host admission port", async () => {
+  const attempt = await admitAttempt({
+    model: { providerId: "p", modelId: "m" },
+  });
+  assert.equal(attempt.ticket, undefined);
+  attempt.release();
+  attempt.release();
+});
+
+test("admitAttempt uses tryAcquire before any queued acquire", async () => {
+  let acquires = 0;
+  const ticket = { publish: async () => {}, release() {} };
+  const attempt = await admitAttempt({
+    admission: {
+      tryAcquire() {
+        return ticket;
+      },
+      async acquire() {
+        acquires++;
+        return ticket;
+      },
+    },
+    model: { providerId: "p", modelId: "m" },
+  });
+  assert.equal(attempt.ticket, ticket);
+  assert.equal(acquires, 0);
+  attempt.release();
+});
+
+test("admitAttempt queues only after tryAcquire misses and reports wait boundaries", async () => {
+  const events: string[] = [];
+  const ticket = {
+    publish: async () => {},
+    release() {
+      events.push("release");
+    },
+  };
+  const attempt = await admitAttempt({
+    admission: {
+      tryAcquire() {
+        events.push("try");
+        return undefined;
+      },
+      async acquire() {
+        events.push("acquire");
+        return ticket;
+      },
+    },
+    model: { providerId: "p", modelId: "m" },
+    onQueued: async () => {
+      events.push("queued");
+    },
+    onAdmitted: async (queuedMs) => {
+      assert.ok(queuedMs >= 0);
+      events.push("admitted");
+    },
+  });
+  assert.deepEqual(events, ["try", "queued", "acquire", "admitted"]);
+  attempt.release();
+  attempt.release();
+  assert.deepEqual(events, ["try", "queued", "acquire", "admitted", "release"]);
+});
+
+test("admitAttempt rejects with the abort reason before minting a ticket", async () => {
+  const reason = new Error("stopped while waiting for a slot");
+  await assert.rejects(
+    admitAttempt({
+      admission: {
+        tryAcquire() {
+          return undefined;
+        },
+        async acquire({ signal }) {
+          assert.ok(signal);
+          throw signal!.reason ?? reason;
+        },
+      },
+      model: { providerId: "p", modelId: "m" },
+      signal: AbortSignal.abort(reason),
+    }),
+    (error: unknown) => error === reason || (error instanceof Error && error.message === reason.message),
+  );
+});
