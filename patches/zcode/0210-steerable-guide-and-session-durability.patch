+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createRootTraceContext } from "@zcode/contracts";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { InMemoryRuntimeTaskRegistry } from "../src/runtime-task/registry.js";
+import { stopBackgroundTask } from "../src/runtime/methods/background.js";
+import {
+  BASH_STOP_SESSION_ENTRY,
+  bashStopKey,
+  loadStoppedBashBackgroundTask,
+  persistStoppedBashBackgroundTask,
+  recoverStoppedBashBackgroundTask,
+  restoreStoppedBashBackgroundTask,
+} from "../src/runtime/methods/bash-stop-settlement.js";
+
+const sessionId = "bash-parent" as never;
+
+function stoppedTask(status: "killed" | "lost" = "killed") {
+  const startedAt = new Date("2026-10-10T18:00:00.000Z");
+  const completedAt = new Date("2026-10-10T18:00:05.000Z");
+  const traceContext = createRootTraceContext({ sessionId });
+  return {
+    task: {
+      agentId: "bash-1",
+      agentType: "local_bash" as const,
+      branchGeneration: 0,
+      completedAt,
+      description: "sleep fixture",
+      isBackgrounded: true,
+      parentSessionId: sessionId,
+      prompt: "sleep 30",
+      startedAt,
+      status,
+      taskId: "bash-1",
+      taskType: "local_bash" as const,
+      type: "local_bash" as const,
+      traceContext,
+    },
+    totalDurationMs: 5000,
+    traceContext,
+  };
+}
+
+test("restoreStoppedBashBackgroundTask accepts local_bash terminal settlement only", () => {
+  const ok = restoreStoppedBashBackgroundTask(stoppedTask("lost"));
+  assert.equal(ok?.task.type, "local_bash");
+  assert.equal(ok?.task.status, "lost");
+  assert.equal(ok?.cold, true);
+  assert.equal(restoreStoppedBashBackgroundTask(undefined), undefined);
+  assert.equal(
+    restoreStoppedBashBackgroundTask({
+      ...stoppedTask(),
+      task: { ...stoppedTask().task, type: "local_agent" },
+    }),
+    undefined,
+  );
+  assert.equal(
+    restoreStoppedBashBackgroundTask({
+      ...stoppedTask(),
+      task: { ...stoppedTask().task, status: "running" },
+    }),
+    undefined,
+  );
+  assert.equal(
+    restoreStoppedBashBackgroundTask({
+      ...stoppedTask(),
+      task: { ...stoppedTask().task, parentSessionId: undefined },
+    }),
+    undefined,
+  );
+});
+
+test("cold SQLite reopen recovers bash Stop settlement without a live child", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-bash-stop-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const stopped = stoppedTask("killed");
+    await persistStoppedBashBackgroundTask({
+      sessionStore: store,
+      sessionId,
+      stopped,
+    });
+    const entries = await store.sessionEntries({
+      sessionID: sessionId,
+      type: BASH_STOP_SESSION_ENTRY,
+    });
+    assert.equal(entries.length, 1);
+    assert.equal(entries[0]?.id, bashStopKey(stopped.task));
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const registry = new InMemoryRuntimeTaskRegistry();
+    registry.setActiveBranchGeneration(0);
+    let cancelCalls = 0;
+    const recovered = await recoverStoppedBashBackgroundTask({
+      sessionStore: store,
+      sessionId,
+      branchGeneration: 0,
+      runtimeTaskRegistry: registry,
+      taskId: "bash-1",
+    });
+    assert.equal(recovered?.status, "killed");
+    assert.equal(registry.get("bash-1")?.type, "local_bash");
+    assert.equal(registry.get("bash-1")?.status, "killed");
+
+    const result = await stopBackgroundTask.call(
+      {
+        sessionId,
+        branchGeneration: 0,
+        rootTraceContext: stopped.traceContext,
+        sessionStore: store,
+        runtimeTaskRegistry: registry,
+        subagentPort: undefined,
+        executionPort: {
+          async cancelBackgroundTask() {
+            cancelCalls += 1;
+            throw new Error("cold recovery must not cancel a live child");
+          },
+        },
+        async rebuildProjection() {
+          return { backgroundTasks: [] };
+        },
+      } as never,
+      "bash-1",
+      { strict: false },
+    );
+    assert.equal(result.ok, true);
+    assert.equal(result.alreadyTerminal, true);
+    assert.equal(result.status, "killed");
+    assert.equal(result.type, "local_bash");
+    assert.equal(cancelCalls, 0);
+    assert.equal(
+      (await loadStoppedBashBackgroundTask({
+        sessionStore: store,
+        sessionId,
+        branchGeneration: 0,
+        taskId: "bash-1",
+      }))?.task.status,
+      "killed",
+    );
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("bash Stop settlement persists through stopLocalBashBackgroundTask and restores after reopen", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-bash-stop-live-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const registry = new InMemoryRuntimeTaskRegistry();
+    registry.setActiveBranchGeneration(0);
+    const startedAt = new Date(Date.now() - 2000);
+    const traceContext = createRootTraceContext({ sessionId });
+    registry.register({
+      agentId: "bash-live",
+      agentType: "local_bash",
+      branchGeneration: 0,
+      description: "live cancel fixture",
+      isBackgrounded: true,
+      parentSessionId: sessionId,
+      prompt: "sleep 60",
+      startedAt,
+      status: "running",
+      taskId: "bash-live",
+      taskType: "local_bash",
+      type: "local_bash",
+      traceContext,
+    });
+    const events: unknown[] = [];
+    const runtime = {
+      sessionId,
+      branchGeneration: 0,
+      rootTraceContext: traceContext,
+      sessionStore: store,
+      runtimeTaskRegistry: registry,
+      subagentPort: undefined,
+      executionPort: {
+        async cancelBackgroundTask(taskId: string) {
+          assert.equal(taskId, "bash-live");
+          return {
+            taskId,
+            status: "cancelled" as const,
+            startedAt,
+            completedAt: new Date(),
+          };
+        },
+      },
+      async rebuildProjection() {
+        return { backgroundTasks: [] };
+      },
+      createEvent(type: string, payload: unknown) {
+        return { type, payload };
+      },
+      async appendEvent(event: unknown) {
+        events.push(event);
+      },
+      buildBackgroundTaskPayload(
+        taskId: string,
+        _existing: unknown,
+        _snapshot: unknown,
+        overrides: { status?: string; completedAt?: Date } = {},
+      ) {
+        return {
+          taskId,
+          taskKind: "bash",
+          status: overrides.status ?? "running",
+          completedAt: overrides.completedAt,
+        };
+      },
+    };
+
+    const stop = await stopBackgroundTask.call(runtime as never, "bash-live", {
+      strict: false,
+      traceContext,
+    });
+    assert.equal(stop.ok, true);
+    assert.equal(stop.status, "cancelled");
+    assert.equal(registry.get("bash-live")?.status, "killed");
+    const entries = await store.sessionEntries({
+      sessionID: sessionId,
+      type: BASH_STOP_SESSION_ENTRY,
+    });
+    assert.equal(entries.length, 1);
+    assert.equal(restoreStoppedBashBackgroundTask(entries[0]?.data)?.task.status, "killed");
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const coldRegistry = new InMemoryRuntimeTaskRegistry();
+    coldRegistry.setActiveBranchGeneration(0);
+    let cancelCalls = 0;
+    const coldStop = await stopBackgroundTask.call(
+      {
+        sessionId,
+        branchGeneration: 0,
+        rootTraceContext: traceContext,
+        sessionStore: store,
+        runtimeTaskRegistry: coldRegistry,
+        subagentPort: undefined,
+        executionPort: {
+          async cancelBackgroundTask() {
+            cancelCalls += 1;
+            throw new Error("cold recovery must not cancel a live child");
+          },
+        },
+        async rebuildProjection() {
+          return { backgroundTasks: [] };
+        },
+      } as never,
+      "bash-live",
+      { strict: false },
+    );
+    assert.equal(coldStop.ok, true);
+    assert.equal(coldStop.alreadyTerminal, true);
+    assert.equal(coldStop.status, "killed");
+    assert.equal(cancelCalls, 0);
+    assert.equal(coldRegistry.get("bash-live")?.status, "killed");
+    assert.equal(events.length >= 0, true);
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
