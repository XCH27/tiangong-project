+function workflowCompletedEvent(
+  taskId = "wf-btc-1",
+  status: "completed" | "failed" | "cancelled" | "lost" = "completed",
+  toolName: "CreateWorkflow" | "ResumeWorkflowRun" | "AmendWorkflow" = "CreateWorkflow",
+): SessionEvent {
+  return createSessionEvent(
+    SessionEventType.BackgroundTaskCompleted,
+    sessionId,
+    {
+      taskId,
+      toolCallId: `tool-${taskId}`,
+      toolName,
+      taskKind: "workflow" as const,
+      cancellable: false,
+      description: "saved workflow natural settle",
+      status,
+      startedAt: new Date("2026-10-10T21:00:00.000Z"),
+      completedAt: new Date("2026-10-10T21:00:05.000Z"),
+      terminalId: taskId,
+    },
+    { traceId: `trace-${taskId}` as never, sequenceNumber: 11 },
+  );
+}
+
+function workflowStartedEvent(
+  taskId = "wf-bts-1",
+  toolName: "CreateWorkflow" | "ResumeWorkflowRun" | "AmendWorkflow" = "CreateWorkflow",
+): SessionEvent {
+  return createSessionEvent(
+    SessionEventType.BackgroundTaskStarted,
+    sessionId,
+    {
+      taskId,
+      toolCallId: `tool-${taskId}`,
+      toolName,
+      taskKind: "workflow" as const,
+      cancellable: true,
+      description: "saved workflow launch",
+      status: "running" as const,
+      startedAt: new Date("2026-10-10T21:01:00.000Z"),
+      terminalId: taskId,
+    },
+    { traceId: `trace-${taskId}` as never, sequenceNumber: 12 },
+  );
+}
+
+function seedJournalRun(
+  store: SqliteSessionStore,
+  runId: string,
+  status: "pending" | "running" | "completed" | "errored" | "stopped",
+): void {
+  store.workflowJournalStore().createRun({
+    runId,
+    parentSessionId: String(sessionId),
+    caps: { maxConcurrency: 1 },
+    spentTokens: 0,
+    status,
+  });
+}
