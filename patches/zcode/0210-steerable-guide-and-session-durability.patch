+    memoryEvents: [],
+  });
+  assert.equal(events.length, 1);
+  assert.equal(events[0]?.type, SessionEventType.BackgroundTaskCompleted);
+  const payload = events[0]?.payload as {
+    taskId: string;
+    taskKind: string;
+    toolName: string;
+    status: string;
+    cancellable: boolean;
+    childSessionId?: string;
+  };
+  assert.equal(payload.taskId, "agent-proj-1");
+  assert.equal(payload.taskKind, "subagent");
+  assert.equal(payload.toolName, "Agent");
+  assert.equal(payload.status, "cancelled");
+  assert.equal(payload.cancellable, false);
+  assert.equal(payload.childSessionId, "child-sess-1");
+
+  const projection = new ProductProjection(sessionId, "subagent-stop-cold");
+  for (const event of events) {
+    projection.applyEventAtomically(event, () => true);
+  }
+  const works = projection.getSnapshot().backgroundWorks;
+  assert.equal(works.length, 1);
+  assert.equal(works[0]?.workId, "agent-proj-1");
+  assert.equal(works[0]?.kind, "subagent");
+  assert.equal(works[0]?.status, "cancelled");
+  assert.equal(works[0]?.cancellable, false);
+  assert.equal(works[0]?.childSessionId, "child-sess-1");
+});
+
+test("incomplete subagent_stop projects lost backgroundWorks without inventing running", () => {
+  const stopped = stoppedAgent({ complete: false });
+  const events = synthesizeBackgroundTaskEventsFromSubagentStopEntries({
+    entries: [
+      {
+        type: SUBAGENT_STOP_SESSION_ENTRY,
+        data: stopped,
+        time: { created: Date.now() },
+      },
+    ],
+    sessionId,
+    memoryEvents: [],
+  });
+  assert.equal(events.length, 1);
+  assert.equal((events[0]?.payload as { status: string }).status, "lost");
+
+  const projection = new ProductProjection(sessionId, "subagent-incomplete");
+  for (const event of events) {
+    projection.applyEventAtomically(event, () => true);
+  }
+  const works = projection.getSnapshot().backgroundWorks;
+  assert.equal(works.length, 1);
+  assert.equal(works[0]?.kind, "subagent");
+  // lost → projection failed bucket
+  assert.equal(works[0]?.status, "failed");
+  assert.notEqual(works[0]?.status, "running");
+});
+
+test("synthesis skips when memory already has BackgroundTaskCompleted for the task", () => {
+  const stopped = stoppedAgent({ complete: true });
+  const memoryCompleted = createSessionEvent(
+    SessionEventType.BackgroundTaskCompleted,
+    sessionId,
