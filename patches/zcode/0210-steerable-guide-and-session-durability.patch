@@ -0,0 +1,211 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import test from "node:test";
+import type { ChildProcess } from "node:child_process";
+import {
+  terminateProcessTreeAndWait,
+  type ProcessIdentity,
+  type WindowsTaskkillRequest,
+} from "../src/process/processTreeTerminator.js";
+
+const ROOT_PID = 910_001;
+const CHILD_PID = 910_002;
+const ROOT_START = "windows-utc-us:1000";
+const CHILD_START = "windows-utc-us:2000";
+
+function createFakeChild(pid: number): ChildProcess & { emitExit: () => void } {
+  const emitter = new EventEmitter();
+  const child = emitter as unknown as ChildProcess & {
+    pid: number;
+    exitCode: number | null;
+    signalCode: NodeJS.Signals | null;
+    kill: (signal?: NodeJS.Signals | number) => boolean;
+    emitExit: () => void;
+  };
+  child.pid = pid;
+  child.exitCode = null;
+  child.signalCode = null;
+  child.kill = () => true;
+  child.emitExit = () => {
+    child.exitCode = 1;
+    emitter.emit("exit", 1, null);
+  };
+  return child;
+}
+
+function ownedSnapshot(identities: ProcessIdentity[]) {
+  return {
+    rootPid: ROOT_PID,
+    descendantPids: identities.filter((identity) => identity.pid !== ROOT_PID).map((i) => i.pid),
+    identities,
+  };
+}
+
+const rootIdentity: ProcessIdentity = {
+  parentPid: 1,
+  pid: ROOT_PID,
+  startTime: ROOT_START,
+};
+const childIdentity: ProcessIdentity = {
+  parentPid: ROOT_PID,
+  pid: CHILD_PID,
+  startTime: CHILD_START,
+};
+
+test("Host Windows Stop: injected platform issues graceful taskkill then force after recheck", async () => {
+  const child = createFakeChild(ROOT_PID);
+  const commands: WindowsTaskkillRequest[] = [];
+  const verified: number[] = [];
+
+  const resultPromise = terminateProcessTreeAndWait(child, {
+    platform: "win32",
+    forceAfterMs: 800,
+    waitAfterForceMs: 20,
+    windowsTaskkillTimeoutMs: 50,
+    snapshot: ownedSnapshot([rootIdentity, childIdentity]),
+    async windowsTaskkillRunner(request) {
+      commands.push({ ...request });
+      if (request.force) {
+        queueMicrotask(() => child.emitExit());
+      }
+      return {};
+    },
+    async windowsProcessIdentityVerifier(identity) {
+      verified.push(identity.pid);
+      return true;
+    },
+  });
+
+  const result = await resultPromise;
+  assert.deepEqual(result.remainingPids, []);
+  assert.ok(commands.some((entry) => entry.force === false && entry.pid === ROOT_PID));
+  assert.ok(commands.some((entry) => entry.force === true && entry.pid === ROOT_PID));
+  assert.ok(commands.some((entry) => entry.force === true && entry.pid === CHILD_PID));
+  assert.deepEqual(new Set(verified), new Set([ROOT_PID, CHILD_PID]));
+});
+
+test("Host Windows Stop: recheck fail-closed skips force taskkill for unmatched CreationDate", async () => {
+  const child = createFakeChild(ROOT_PID);
+  const commands: WindowsTaskkillRequest[] = [];
+
+  const resultPromise = terminateProcessTreeAndWait(child, {
+    platform: "win32",
+    forceAfterMs: 800,
+    waitAfterForceMs: 20,
+    windowsTaskkillTimeoutMs: 50,
+    snapshot: ownedSnapshot([rootIdentity, childIdentity]),
+    async windowsTaskkillRunner(request) {
+      commands.push({ ...request });
+      return {};
+    },
+    async windowsProcessIdentityVerifier() {
+      return false;
+    },
+  });
+
+  // Fake PIDs are not alive; after force flight with empty targets, waiter still needs exit/deadline.
+  setTimeout(() => child.emitExit(), 850);
+  const result = await resultPromise;
+  assert.deepEqual(result.remainingPids, []);
+  assert.ok(commands.some((entry) => entry.force === false && entry.pid === ROOT_PID));
+  assert.equal(
+    commands.filter((entry) => entry.force === true).length,
+    0,
+    "fail-closed recheck must not force-kill unmatched identities",
+  );
+});
+
+test("Host Windows Stop: identityVerification unavailable keeps unverified root observation only", async () => {
+  const child = createFakeChild(ROOT_PID);
+  const commands: WindowsTaskkillRequest[] = [];
+
+  const resultPromise = terminateProcessTreeAndWait(child, {
+    platform: "win32",
+    forceAfterMs: 100,
+    waitAfterForceMs: 20,
+    windowsTaskkillTimeoutMs: 50,
+    snapshot: {
+      rootPid: ROOT_PID,
+      descendantPids: [],
+      identities: [],
+      identityVerification: "unavailable",
+    },
+    async windowsTaskkillRunner(request) {
+      commands.push({ ...request });
+      return {};
+    },
+  });
+
+  setTimeout(() => child.emitExit(), 120);
+  const result = await resultPromise;
+  assert.deepEqual(result.remainingPids, []);
+  assert.equal(
+    commands.length,
+    0,
+    "unverified-root-only must not taskkill bare PIDs without CreationDate proof",
+  );
+});
+
+test("Host POSIX Stop path remains selected when platform is injected as linux", async () => {
+  const child = createFakeChild(ROOT_PID);
+  let windowsRunnerCalls = 0;
+
+  // Owned group id matching root lets POSIX terminator signal -pid; fake pid is not alive so
+  // force path and waiter settle once exit is observed / deadline hits.
+  const resultPromise = terminateProcessTreeAndWait(child, {
+    platform: "linux",
+    forceAfterMs: 50,
+    waitAfterForceMs: 10,
+    ownedProcessGroupId: ROOT_PID,
+    snapshot: {
+      rootPid: ROOT_PID,
+      descendantPids: [],
+      identities: [{ ...rootIdentity, processGroupId: ROOT_PID }],
+    },
+    async windowsTaskkillRunner() {
+      windowsRunnerCalls += 1;
+      return {};
+    },
+  });
+
+  setTimeout(() => child.emitExit(), 30);
+  const result = await resultPromise;
+  assert.deepEqual(result.remainingPids, []);
+  assert.equal(windowsRunnerCalls, 0);
+});
+
+test("Host Windows Stop does not taskkill PIDs outside the owned snapshot (escapee honesty)", async () => {
+  const child = createFakeChild(ROOT_PID);
+  const commands: WindowsTaskkillRequest[] = [];
+  const escapeePid = 910_099;
+
+  const resultPromise = terminateProcessTreeAndWait(child, {
+    platform: "win32",
+    forceAfterMs: 100,
+    waitAfterForceMs: 20,
+    windowsTaskkillTimeoutMs: 50,
+    // Escapee is alive in the OS sense only if we probe it; terminator must not invent
+    // ownership for PIDs absent from the owned CreationDate snapshot / Job Object tree.
+    snapshot: ownedSnapshot([rootIdentity]),
+    async windowsTaskkillRunner(request) {
+      commands.push({ ...request });
+      if (request.force && request.pid === ROOT_PID) {
+        queueMicrotask(() => child.emitExit());
+      }
+      return {};
+    },
+    async windowsProcessIdentityVerifier(identity) {
+      return identity.pid === ROOT_PID;
+    },
+  });
+
+  const result = await resultPromise;
+  assert.deepEqual(result.remainingPids, []);
+  assert.ok(commands.every((entry) => entry.pid !== escapeePid));
+  assert.ok(commands.every((entry) => entry.pid === ROOT_PID));
+  assert.equal(
+    result.remainingPids.includes(escapeePid),
+    false,
+    "escapees outside the owned snapshot stay outside Stop remainingPids honesty",
+  );
+});
