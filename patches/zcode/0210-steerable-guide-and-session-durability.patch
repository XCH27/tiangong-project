@@ -0,0 +1,262 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "node:child_process";
+import { createClaudeNativeAgentPort } from "../src/native-agent/claude.js";
+import { resolveClaudeNativeExecutable } from "../src/native-agent/claude-executable.js";
+import type { Model, NativeAgentTurnRequest } from "@zcode/contracts";
+
+const nativeExecutable = resolveClaudeNativeExecutable(process.env.FLEET_CLAUDE_TEST_CLI);
+execFileSync(nativeExecutable, ["--version"], { stdio: "ignore", timeout: 15000 });
+
+/**
+ * Prove vendor_claude_stdin_priority_next: while a live Claude Query owns an
+ * outstanding Host tool callback, deliverGuideAtToolBoundary enqueues a stdin
+ * user message with priority "next". Does not invent Host Ready / steerable.
+ */
+test(
+  "Claude deliverGuideAtToolBoundary writes stdin priority next at a live tool-boundary",
+  { timeout: 30000 },
+  async () => {
+    const profile = await mkdtemp(join(tmpdir(), "fleet-claude-steer-"));
+    const stdinChunks: string[] = [];
+    let failure: unknown;
+    let requests = 0;
+
+    const server = createServer(async (req, res) => {
+      try {
+        if (!req.url?.split("?")[0]?.endsWith("/messages")) {
+          res.writeHead(200, { "content-type": "application/json" });
+          res.end("{}");
+          return;
+        }
+        const chunks: Buffer[] = [];
+        for await (const chunk of req) chunks.push(chunk as Buffer);
+        const body = JSON.parse(Buffer.concat(chunks).toString());
+        assert.equal(req.headers["x-api-key"], "synthetic-native-steer-test");
+        requests++;
+        assert.ok(requests <= 2, "Unexpected native model request");
+        const hasResult =
+          JSON.stringify(body.messages).includes("native-approved") ||
+          body.messages.some(
+            (message: any) =>
+              Array.isArray(message.content) &&
+              message.content.some((block: any) => block.type === "tool_result"),
+          );
+        res.writeHead(200, { "content-type": "text/event-stream" });
+        const send = (type: string, data: Record<string, unknown>) =>
+          res.write(`event: ${type}\ndata: ${JSON.stringify({ type, ...data })}\n\n`);
+        send("message_start", {
