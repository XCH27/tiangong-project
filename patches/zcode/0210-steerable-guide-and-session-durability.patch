+      {
+        type: SUBAGENT_STOP_SESSION_ENTRY,
+        data: stopped,
+        time: { created: Date.now() },
+      },
+    ],
+    sessionId,
+    memoryEvents: [memoryCompleted],
+  });
+  assert.equal(events.length, 0);
