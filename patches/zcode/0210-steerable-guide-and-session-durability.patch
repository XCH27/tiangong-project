@@ -0,0 +1,91 @@
+/**
+ * Native Guide tool-boundary honesty.
+ *
+ * `activeTurn.steerable` for nativeExecutor turns follows `nativeGuideSteerAllowed()`
+ * — true only when every checklist path below is `proved`. That opens steerable
+ * Host Guide admission; it does **not** invent product Ready / usable.
+ *
+ * Pi drains Guide at Host tool-batch boundaries via `drainInlineGuideForNextRequest`.
+ * Native mid-turn drains via vendor `deliverGuideAtToolBoundary` after Host tool
+ * batches (`drainNativeGuideAtHostToolBatch`). While a Host tool callback is
+ * outstanding, `steerTurn(guide)` may also immediate-deliver to that vendor API
+ * (`tryImmediateNativeGuideVendorDeliver`) so Claude priority-next / Codex
+ * turn/steer land before batch settle. Text-only settle shares
+ * `fallbackPendingGuidesToQueue(guide.noToolBoundary)`.
+ */
+
+export type NativeGuideToolBoundaryPathId =
+  | "host_tool_batch_drain"
+  | "vendor_claude_stdin_priority_next"
+  | "vendor_codex_turn_steer"
+  | "acp_permission_wait_boundary"
+  | "text_only_no_tool_fallback"
+  | "native_continuation_same_session"
+  | "refuse_durable_ghost_on_reject";
+
+export type NativeGuideToolBoundaryPathStatus =
+  /** Path exists for Pi / Host-model turns only; native cannot queue Guide yet. */
+  | "pi_only"
+  /** Required for native Guide; not implemented / not proved. */
+  | "required_missing"
+  /** Implemented and proved for native. */
+  | "proved";
+
+export type NativeGuideToolBoundaryPath = {
+  readonly id: NativeGuideToolBoundaryPathId;
+  readonly status: NativeGuideToolBoundaryPathStatus;
+  /** Plain-language role (no product Ready claim). */
+  readonly role: string;
+};
+
+/**
+ * Checklist authority: every `required_missing` / `pi_only` entry must become
+ * `proved` before `nativeGuideSteerAllowed` may return true.
+ */
+export const NATIVE_GUIDE_TOOL_BOUNDARY_PATHS: readonly NativeGuideToolBoundaryPath[] = [
+  {
+    id: "host_tool_batch_drain",
+    status: "proved",
+    role: "After Host tool batch on native, drain at most one inline Guide via vendor deliverGuideAtToolBoundary (drainNativeGuideAtHostToolBatch); Pi keeps Host history inject",
+  },
+  {
+    id: "vendor_claude_stdin_priority_next",
+    status: "proved",
+    role: "Claude native: deliver Guide to vendor stdin at next tool boundary (priority next) via deliverGuideAtToolBoundary — not as a post-turn follow-up invent",
+  },
+  {
+    id: "vendor_codex_turn_steer",
+    status: "proved",
+    role: "Codex native: deliver Guide through vendor turn/steer mid-turn API while the live turn is identified (see deliverGuideAtToolBoundary)",
+  },
+  {
+    id: "acp_permission_wait_boundary",
+    status: "proved",
+    role: "While ACP permission waits, accept Guide at that wait boundary (hold → flush after settle) or keep explicit refuse — never silent drop (see deliverGuideAtToolBoundary)",
+  },
+  {
+    id: "text_only_no_tool_fallback",
+    status: "proved",
+    role: "When no tool boundary remains (text-only settle / stop), fall back Guide to ordinary queue (guide.noToolBoundary) instead of inventing mid-turn inject — shared turn-stop/turn-tools path on native",
+  },
+  {
+    id: "native_continuation_same_session",
+    status: "proved",
+    role: "After a native terminal step, continue Guide/Stop only through the same validated vendor session once (see native-agent-turn settle → create resume; proved via Stop-hook continue)",
+  },
+  {
+    id: "refuse_durable_ghost_on_reject",
+    status: "proved",
+    role: "A refused native Guide must not leave a durable Session queue/guide ghost for cold recovery",
+  },
+] as const;
+
+/** True only when every checklist path is `proved`. Steerable paths proved — not product Ready. */
+export function nativeGuideSteerAllowed(
+  paths: readonly NativeGuideToolBoundaryPath[] = NATIVE_GUIDE_TOOL_BOUNDARY_PATHS,
+): boolean {
+  return paths.length > 0 && paths.every((path) => path.status === "proved");
+}
+
+/** Native kinds whose steerable bit is gated by `nativeGuideSteerAllowed()`. */
+export const NATIVE_GUIDE_REFUSED_EXECUTOR_KINDS = ["claude", "codex"] as const;
