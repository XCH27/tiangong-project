+    // Empty linkedTasks receipt must not invent running works.
+    await persistRemoteHostAttachmentStopReceipt({
+      sessionStore: store,
+      sessionId,
+      receipt: receipt({
+        remoteSessionId: "remote-session-empty",
+        reason: "idle_dispose",
+        targetKind: "wsl",
+        attachmentIds: [],
+        stoppedAt: Date.parse("2026-10-10T23:01:00.000Z"),
