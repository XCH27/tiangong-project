+
+test("empty memory without subagent_stop does not invent running backgroundWorks", () => {
+  const events = synthesizeBackgroundTaskEventsFromSubagentStopEntries({
+    entries: [],
+    sessionId,
+    memoryEvents: [],
+  });
+  assert.equal(events.length, 0);
+  const merged = mergeColdConversationEvents({
+    memoryEvents: [],
+    messages: [],
