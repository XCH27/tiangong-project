+    assert.equal(byId.get("bash-natural-1")?.status, "completed");
+    assert.equal(byId.get("bash-natural-1")?.taskKind, "bash");
+    assert.equal(byId.get("bash-stop-1")?.status, "cancelled");
+    assert.equal(byId.get("bash-stop-1")?.taskKind, "bash");
+    assert.equal(byId.get("agent-stop-1")?.status, "cancelled");
+    assert.equal(byId.get("agent-stop-1")?.taskKind, "subagent");
+    assert.equal(byId.get("bash-orphan-1")?.status, "lost");
+    assert.equal(byId.get("bash-orphan-1")?.taskKind, "bash");
+    assert.equal(byId.get("agent-natural-1")?.status, "completed");
+    assert.equal(byId.get("agent-natural-1")?.taskKind, "subagent");
+    assert.equal(byId.get("agent-orphan-1")?.status, "lost");
