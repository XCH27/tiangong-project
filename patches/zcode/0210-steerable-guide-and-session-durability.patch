+import {
+  SessionEventType,
+  createSessionEvent,
+  type SessionEvent,
+  type SessionId,
+  type SessionStorePort,
+} from "../deps.js";
+import { isColdNonDurableBackgroundToolName } from "./cold-runtime-task-durability.js";
+
+/**
+ * Durable live BackgroundTaskUpdated transcript writes (bash + local_agent) —
+ * event-driven first toehold (NOT 1s poll).
+ *
+ * Emit path still publishes BackgroundTaskUpdated into the memory eventStore for UI
+ * (including the 1s snapshot poll). This module additionally persists Session entries
+ * **only** when the payload carries a meaningful status/progress control change:
+ * `cancelRequestedAt`, `blocked`, or `blockedReason`. Pure byte/tail/pid poll chatter
+ * is refused — that is the poll-noise non-claim that previously blocked all Updated
+ * durability.
+ *
+ * Cold honesty (OSS-aligned): Session `background_task_updated` **never** invents
+ * `backgroundWorks` / **never** invents `running` on cold reopen (empty warm memory).
+ * Poller + child are gone after restart; Started orphan→lost and Completed /
+ * bash_stop / subagent_stop remain cold panel authority. Updated is **not** in
+ * `COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER`.
+ *
+ * Warm Session Updated read (optional follow-up toehold): when memory already has
+ * warm running evidence for the same taskId (Started / Updated status=running) and
+ * no Completed, `synthesizeBackgroundTaskEventsFromUpdatedEntries` overlays
+ * blocked / cancelRequestedAt / blockedReason / cancellable from Session — never
+ * invents a running row from Updated alone.
+ *
+ * Explicitly not claimed: inventing running from Updated, using Updated as a cold
+ * panel projector, workflow Updated durability, byte/tail poll Session writes,
+ * full MEMORY_ONLY removal, Ready invent, monitor_mcp invent, local_workflow promote.
+ */
+export const BACKGROUND_TASK_UPDATED_SESSION_ENTRY = "background_task_updated" as const;
+
+export type DurableBackgroundTaskUpdatedKind = "bash" | "subagent";
+
+export interface DurableBackgroundTaskUpdatedPayload {
+  taskId: string;
+  toolCallId?: string;
+  toolName: string;
+  taskKind: DurableBackgroundTaskUpdatedKind;
+  childSessionId?: string;
+  blocked?: boolean;
+  blockedReason?: string;
+  cancellable?: boolean;
+  cancelRequestedAt?: string;
+  command?: string;
+  description?: string;
+  status: "running";
+  pid?: number;
+  startedAt?: string;
+  outputPath?: string;
+  terminalId?: string;
+  eventId?: string;
+  sequenceNumber?: number;
+  traceId?: string;
+  turnId?: string;
+}
+
+export function backgroundTaskUpdatedKey(taskId: string): string {
+  return `background-task-updated:${taskId}`;
+}
+
+function stringField(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function numberField(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function dateIso(value: unknown): string | undefined {
+  if (value instanceof Date && Number.isFinite(value.getTime())) return value.toISOString();
+  if (typeof value === "string" && value.length > 0) {
+    const parsed = new Date(value);
+    if (Number.isFinite(parsed.getTime())) return parsed.toISOString();
+  }
+  return undefined;
+}
+
+function resolveUpdatedKind(
+  _taskKind: unknown,
+  toolName: string | undefined,
+): DurableBackgroundTaskUpdatedKind | undefined {
+  if (isColdNonDurableBackgroundToolName(toolName)) return undefined;
+  // taskKind is panel decoration only; Session durability keys on real toolName —
+  // never invent Bash/Agent from taskKind alone / missing toolName.
+  if (toolName === "Bash") return "bash";
+  if (toolName === "Agent" || toolName === "Task") return "subagent";
+  return undefined;
+}
+
+/**
+ * Meaningful status/progress control change — NOT 1s poll byte/tail/pid chatter.
+ *
+ * Mid-flight control fields that change panel honesty while the task is still live:
+ * cancel requested, blocked flag, or blockedReason (incl. no_output_progress /
+ * interactive_prompt_detected). Terminal statuses are Completed's job.
+ */
+export function isMeaningfulBackgroundTaskUpdate(payload: unknown): boolean {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) return false;
+  const record = payload as Record<string, unknown>;
+  if (record.status !== undefined && record.status !== "running") return false;
+  if (dateIso(record.cancelRequestedAt)) return true;
+  if (record.blocked === true) return true;
+  if (stringField(record.blockedReason)) return true;
+  return false;
+}
+
+/**
+ * Real Bash + Agent/Task (subagent) mid-flight control Updates are durable when
+ * meaningful. Kind resolution keys on toolName only. Legacy Workflow / Monitor stay
+ * non_durable. Workflow Updated stays non-durable. Poll byte/tail-only payloads refuse.
+ */
+export function durableBackgroundTaskUpdatedPayload(
+  payload: unknown,
+): DurableBackgroundTaskUpdatedPayload | undefined {
+  if (!isMeaningfulBackgroundTaskUpdate(payload)) return undefined;
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) return undefined;
+  const record = payload as Record<string, unknown>;
+  const taskId = stringField(record.taskId);
+  const toolName = stringField(record.toolName);
+  const kind = resolveUpdatedKind(record.taskKind, toolName);
+  if (!taskId || !toolName || !kind) return undefined;
+  return {
+    taskId,
+    ...(stringField(record.toolCallId) ? { toolCallId: stringField(record.toolCallId) } : {}),
+    toolName,
+    taskKind: kind,
+    ...(kind === "subagent" && stringField(record.childSessionId)
+      ? { childSessionId: stringField(record.childSessionId) }
+      : {}),
+    ...(record.blocked === true ? { blocked: true } : {}),
+    ...(stringField(record.blockedReason)
+      ? { blockedReason: stringField(record.blockedReason) }
+      : {}),
+    ...(typeof record.cancellable === "boolean" ? { cancellable: record.cancellable } : {}),
+    ...(dateIso(record.cancelRequestedAt)
+      ? { cancelRequestedAt: dateIso(record.cancelRequestedAt) }
+      : {}),
+    ...(kind === "bash" && stringField(record.command)
+      ? { command: stringField(record.command) }
+      : {}),
+    ...(stringField(record.description) ? { description: stringField(record.description) } : {}),
+    status: "running",
+    ...(kind === "bash" && numberField(record.pid) !== undefined
+      ? { pid: numberField(record.pid) }
+      : {}),
+    ...(dateIso(record.startedAt) ? { startedAt: dateIso(record.startedAt) } : {}),
+    ...(stringField(record.outputPath) ? { outputPath: stringField(record.outputPath) } : {}),
+    ...(stringField(record.terminalId)
+      ? { terminalId: stringField(record.terminalId) }
+      : { terminalId: taskId }),
+  };
+}
+
+/** @deprecated Prefer durableBackgroundTaskUpdatedPayload (bash + subagent). */
+export function durableBashBackgroundTaskUpdatedPayload(
+  payload: unknown,
+): DurableBackgroundTaskUpdatedPayload | undefined {
+  const durable = durableBackgroundTaskUpdatedPayload(payload);
+  return durable?.taskKind === "bash" ? durable : undefined;
+}
+
+export function restoreDurableBackgroundTaskUpdatedPayload(
+  value: unknown,
+): DurableBackgroundTaskUpdatedPayload | undefined {
+  return durableBackgroundTaskUpdatedPayload(value);
+}
+
+/**
+ * Stable signature of the meaningful control fields (for tests / overwrite identity).
+ * Returns undefined when the payload is not Session-durable Updated.
+ */
+export function backgroundTaskUpdatedMeaningfulSignature(payload: unknown): string | undefined {
+  const durable = durableBackgroundTaskUpdatedPayload(payload);
+  if (!durable) return undefined;
+  return JSON.stringify({
+    taskId: durable.taskId,
+    taskKind: durable.taskKind,
+    blocked: durable.blocked === true,
+    blockedReason: durable.blockedReason ?? null,
+    cancelRequestedAt: durable.cancelRequestedAt ?? null,
+    cancellable: durable.cancellable ?? null,
+  });
+}
+
+export async function persistBackgroundTaskUpdatedEntry(input: {
+  sessionStore?: Pick<SessionStorePort, "saveSessionEntry">;
+  sessionId: SessionId;
+  event: SessionEvent;
+}): Promise<boolean> {
+  const store = input.sessionStore;
+  if (!store?.saveSessionEntry) return false;
+  if (input.event.type !== SessionEventType.BackgroundTaskUpdated) return false;
+  const durable = durableBackgroundTaskUpdatedPayload(input.event.payload);
+  if (!durable) return false;
+  const updatedMs = input.event.timestamp?.getTime?.() ?? Date.now();
+  const now = Date.now();
+  await store.saveSessionEntry({
+    id: backgroundTaskUpdatedKey(durable.taskId),
+    sessionID: input.sessionId,
+    type: BACKGROUND_TASK_UPDATED_SESSION_ENTRY,
+    touchSession: false,
+    time: {
+      created: Number.isFinite(updatedMs) ? updatedMs : now,
+      updated: now,
+    },
+    data: {
+      ...durable,
+      eventId: String(input.event.id),
+      sequenceNumber: input.event.sequenceNumber,
+      traceId: String(input.event.traceId),
+      ...(input.event.turnId ? { turnId: String(input.event.turnId) } : {}),
+    },
+  });
+  return true;
+}
+
+function backgroundTaskCompletedTaskIds(events: readonly SessionEvent[] | undefined): Set<string> {
+  const ids = new Set<string>();
+  for (const event of events ?? []) {
+    if (event.type !== SessionEventType.BackgroundTaskCompleted) continue;
+    const taskId =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown }).taskId
+        : undefined;
+    if (typeof taskId === "string" && taskId.length > 0) {
+      ids.add(taskId);
+    }
+  }
+  return ids;
+}
+
+/**
+ * Warm running evidence for a taskId: live Started, or Updated with status running.
+ * Completed (including cold orphan→lost) is not warm running.
+ */
+function warmRunningBackgroundTaskIds(events: readonly SessionEvent[] | undefined): Set<string> {
+  const ids = new Set<string>();
+  for (const event of events ?? []) {
+    if (
+      event.type !== SessionEventType.BackgroundTaskStarted &&
+      event.type !== SessionEventType.BackgroundTaskUpdated
+    ) {
+      continue;
+    }
+    const payload =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown; status?: unknown })
+        : undefined;
+    const taskId = payload?.taskId;
+    if (typeof taskId !== "string" || taskId.length === 0) continue;
+    if (event.type === SessionEventType.BackgroundTaskUpdated && payload?.status !== "running") {
+      continue;
+    }
+    ids.add(taskId);
+  }
+  return ids;
+}
+
+/**
+ * Warm Session Updated control overlay — blocked / cancelRequested only.
+ *
+ * Emits BackgroundTaskUpdated from Session `background_task_updated` **only** when
+ * memory already has warm running evidence for the same taskId and no Completed.
+ * Cold empty memory → [] (never invents running / panel works). Not a cold projector
+ * and not in `COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER`.
+ */
+export function synthesizeBackgroundTaskEventsFromUpdatedEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+}): SessionEvent[] {
+  const sessionId = String(input.sessionId);
+  const completedTaskIds = backgroundTaskCompletedTaskIds(input.memoryEvents);
+  const warmRunningTaskIds = warmRunningBackgroundTaskIds(input.memoryEvents);
+  if (warmRunningTaskIds.size === 0) return [];
+
+  const byTaskId = new Map<
+    string,
+    { durable: DurableBackgroundTaskUpdatedPayload; created: number; traceId?: string }
+  >();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== BACKGROUND_TASK_UPDATED_SESSION_ENTRY) continue;
+    const durable = restoreDurableBackgroundTaskUpdatedPayload(entry.data);
+    if (!durable) continue;
+    if (!warmRunningTaskIds.has(durable.taskId)) continue;
+    if (completedTaskIds.has(durable.taskId)) continue;
+    const existing = byTaskId.get(durable.taskId);
+    const created = entry.time.created;
+    if (!existing || created >= existing.created) {
+      const data =
+        entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
+          ? (entry.data as Record<string, unknown>)
+          : {};
+      byTaskId.set(durable.taskId, {
+        durable,
+        created,
+        traceId: stringField(data.traceId),
+      });
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { durable, created, traceId } of byTaskId.values()) {
+    const updatedAt = new Date(created);
+    const cancelRequestedAt = durable.cancelRequestedAt
+      ? new Date(durable.cancelRequestedAt)
+      : undefined;
+    const startedAt = durable.startedAt ? new Date(durable.startedAt) : undefined;
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskUpdated,
+      sessionId as SessionId,
+      {
+        taskId: durable.taskId,
+        ...(durable.toolCallId ? { toolCallId: durable.toolCallId } : {}),
+        toolName: durable.toolName,
+        taskKind: durable.taskKind,
+        ...(durable.childSessionId ? { childSessionId: durable.childSessionId } : {}),
+        ...(durable.blocked === true ? { blocked: true } : {}),
+        ...(durable.blockedReason ? { blockedReason: durable.blockedReason } : {}),
+        ...(typeof durable.cancellable === "boolean" ? { cancellable: durable.cancellable } : {}),
+        ...(cancelRequestedAt && Number.isFinite(cancelRequestedAt.getTime())
+          ? { cancelRequestedAt }
+          : {}),
+        ...(durable.command ? { command: durable.command } : {}),
+        ...(durable.description ? { description: durable.description } : {}),
+        status: "running" as const,
+        ...(durable.pid !== undefined ? { pid: durable.pid } : {}),
+        ...(startedAt && Number.isFinite(startedAt.getTime()) ? { startedAt } : {}),
+        ...(durable.outputPath ? { outputPath: durable.outputPath } : {}),
+        terminalId: durable.terminalId ?? durable.taskId,
+      },
+      {
+        traceId: (traceId ?? durable.traceId ?? "trace-background-task-updated-warm") as never,
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = Number.isFinite(updatedAt.getTime()) ? updatedAt : new Date();
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
