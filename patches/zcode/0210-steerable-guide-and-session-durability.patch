+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  NATIVE_GUIDE_FORBIDDEN_PRODUCT_LABELS,
+  classifyNativeGuideHonestyFromInputRouting,
+  classifyNativeGuideHonestyFromSnapshotControl,
+  classifyNativeGuideSurfaceHonesty,
+  isForbiddenNativeGuideProductLabel,
+  isNativeGuideSteerableHonesty,
+  nativeGuideHonestyAllowsProductUsable,
+  nativeGuidePendingStatusMessageId,
+  type NativeGuideSurfaceHonesty,
+} from "../src/v4/nativeGuideSurfaceHonesty.js";
+import { projectPendingGuideQueue } from "../src/v4/pendingGuideProjection.js";
+import type { QueueItem, QueueState } from "@zcode/shared/zcode-protocol-v4";
+
+const ALL_HONESTY: NativeGuideSurfaceHonesty[] = [
+  "steerable",
+  "not_steerable",
+  "pi_steerable",
+  "no_active_turn",
+  "queue_path",
+];
+
+function guideItem(id: string, seq: number): QueueItem {
+  return {
+    queueItemId: id,
+    text: "steer please",
+    clientId: `client-${id}`,
+    sourceCommandId: `cmd-${id}`,
+    admittedAt: 1,
+    attachments: [],
+    order: { admissionSeq: seq },
+    delivery: { admitted: "guide" },
+    dispatch: { state: "queued" },
+  } as QueueItem;
+}
+
+function queueItem(id: string, seq: number): QueueItem {
+  return {
+    ...guideItem(id, seq),
+    delivery: { admitted: "queue" },
+  } as QueueItem;
+}
+
+test("classify: native + steerAllowed is steerable, never Ready/usable", () => {
+  const honesty = classifyNativeGuideSurfaceHonesty({
+    hasActiveTurn: true,
+    nativeExecutor: true,
+    steerAllowed: true,
+  });
+  assert.equal(honesty, "steerable");
+  assert.equal(isNativeGuideSteerableHonesty(honesty), true);
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+  assert.equal(isForbiddenNativeGuideProductLabel(honesty), false);
+});
+
+test("classify: native + !steerAllowed is not_steerable (gate closed)", () => {
+  const honesty = classifyNativeGuideSurfaceHonesty({
+    hasActiveTurn: true,
