+  assert.equal(honesty, "not_steerable");
+  assert.equal(isNativeGuideSteerableHonesty(honesty), false);
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+  assert.equal(nativeGuidePendingStatusMessageId(honesty), "chat.message.turnSteer.pending");
