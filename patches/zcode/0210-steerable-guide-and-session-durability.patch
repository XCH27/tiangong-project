+  type RemoteHostStopSessionReceipt,
+} from "../src/host/remoteHostAttachmentStopSessionGlue.js";
+import {
+  createRemoteHostAttachmentStopProductWiring,
+  createSessionStoreRemoteHostStopPersist,
+  type RemoteHostStopBindableSessionService,
+} from "../src/host/remoteHostAttachmentStopProductWiring.js";
+import {
+  createMessagePortShapedAttachmentPort,
+  remoteHostAttachmentStopFixture,
+} from "./helpers/remote-host-attachment-stop-fixture.js";
+
+/**
+ * MessagePort-shaped fixture e2e (no live Electron MessagePort / SSH invent).
+ *
+ * Composes MessagePortMain-shaped attach ports + product bindSession/setPersist +
+ * Host Stop detach ordering → Session `remote_host_attachment_stop`. Port close
+ * disposes the expose handle; Session write stays Host Stop-owned.
+ */
+
+function memorySessionStore() {
+  const entries: Array<{
+    id: string;
+    sessionID: string;
+    type: string;
+    data: RemoteHostStopSessionReceipt;
+  }> = [];
+  return {
+    entries,
+    saveSessionEntry: async (entry: {
+      id: string;
+      sessionID: string;
+      type: string;
+      touchSession: boolean;
+      time: { created: number; updated: number };
+      data: RemoteHostStopSessionReceipt;
+    }) => {
+      entries.push({
+        id: entry.id,
+        sessionID: entry.sessionID,
+        type: entry.type,
+        data: entry.data,
+      });
+    },
+  };
+}
+
+function fakeSessionService(): RemoteHostStopBindableSessionService {
+  return {
+    async createSession(params) {
+      return {
+        session: {
+          sessionId: params.sessionId?.trim() || `sess-${params.remoteSessionId ?? "local"}`,
+        },
+      };
+    },
+    async resumeSession(params) {
+      return { session: { sessionId: params.sessionId } };
+    },
+    async closeSession() {},
+  };
+}
+
+test("MessagePort-shaped close disposes expose handle exactly once (no Session invent)", async () => {
+  const store = memorySessionStore();
+  const glue = createRemoteHostAttachmentStopSessionGlue({ now: () => 1_700_000_400_000 });
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  wiring.installPersistRouter();
+  const service = wiring.wrapSessionService(fakeSessionService(), {
+    persistViaAgent: createSessionStoreRemoteHostStopPersist(store),
+  });
+
+  const fx = remoteHostAttachmentStopFixture();
+  try {
+    const session = await fx.connectSsh();
+    await service.createSession({
+      workspacePath: "/remote/mp",
+      remoteSessionId: session.remoteSessionId,
+      sessionId: "sess-mp-close-only",
+    });
+    const port = createMessagePortShapedAttachmentPort();
+    fx.attachRemote({
+      attachmentId: "renderer-mp-close",
+      remoteSessionId: session.remoteSessionId,
+      port,
+    });
+    assert.equal(fx.attachmentRegistry.size(), 1);
+    assert.equal(port.closed, false);
+
+    port.close();
+    assert.equal(port.closed, true);
+    assert.deepEqual(fx.disposedHandles, ["renderer-mp-close"]);
+    assert.equal(fx.attachmentRegistry.size(), 0);
+    // MessagePort close alone must not invent Session stop write — Host Stop owns that.
+    assert.deepEqual(store.entries, []);
+    assert.deepEqual(glue.listBoundSessionIds(session.remoteSessionId), ["sess-mp-close-only"]);
+
+    port.close();
+    port.emitClose();
+    assert.deepEqual(fx.disposedHandles, ["renderer-mp-close"]);
+    assert.deepEqual(store.entries, []);
+  } finally {
+    await fx.close();
+    wiring.clear();
+  }
+});
