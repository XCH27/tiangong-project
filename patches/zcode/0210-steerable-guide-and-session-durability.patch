+test("persist + synthesize workflow Completed restores panel without inventing running", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-wf-btc-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const persisted = await persistBackgroundTaskCompletedEntry({
+      sessionStore: store,
+      sessionId,
+      event: workflowCompletedEvent(),
+    });
+    assert.equal(persisted, true);
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const entries = await store.sessionEntries({
+      sessionID: sessionId,
+      type: BACKGROUND_TASK_COMPLETED_SESSION_ENTRY,
+    });
+    assert.equal(entries.length, 1);
