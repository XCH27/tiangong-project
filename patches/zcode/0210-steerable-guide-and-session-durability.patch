@@ -0,0 +1,224 @@
+/**
+ * Product bindSession + agent SessionStore setPersist registration.
+ *
+ * Host glue alone cannot invent SessionIds or reach agent SQLite. This module:
+ * 1. Wraps IZCodeSessionService create/resume/close so remoteSessionId → SessionId
+ *    binds land on the Host glue map (product callers).
+ * 2. Registers setPersist as a SessionId-routed writer table: at bind time the wrap
+ *    captures an agent-reachable persist writer so live detach can land
+ *    `remote_host_attachment_stop` even after the connection drops out of "online"
+ *    resolveScopedServices (best-effort; dead MessagePort → honest fail logged by Host).
+ *
+ * Never invents linkedTasks / live process-tree / Ready.
+ */
+
+import type {
+  PersistRemoteHostStopSessionReceipt,
+  RemoteHostAttachmentStopSessionGlue,
+  RemoteHostStopSessionReceipt,
+} from "./remoteHostAttachmentStopSessionGlue.js";
+import { getRemoteHostAttachmentStopSessionGlue } from "./remoteHostAttachmentStopSessionGlue.js";
+
+/** Minimal session-service surface the product wrap needs (avoids importing full service types into Host). */
+export interface RemoteHostStopBindableSessionService {
+  createSession(params: {
+    remoteSessionId?: string;
+    workspacePath: string;
+    workspaceIdentity?: string;
+    sessionId?: string;
+    [key: string]: unknown;
+  }): Promise<{ session: { sessionId: string } }>;
+  resumeSession(params: {
+    remoteSessionId?: string;
+    sessionId: string;
+    workspacePath: string;
+    workspaceIdentity?: string;
+    [key: string]: unknown;
+  }): Promise<{ session: { sessionId: string } }>;
+  closeSession(params: {
+    remoteSessionId?: string;
+    sessionId: string;
+    workspacePath: string;
+    workspaceIdentity?: string;
+    [key: string]: unknown;
+  }): Promise<void>;
+}
+
+export type AgentRemoteHostAttachmentStopPersist = (input: {
+  sessionId: string;
+  receipt: RemoteHostStopSessionReceipt;
+  /** Captured at bind (create/resume) so transport_close can route without resolveScopedServices. */
+  workspacePath: string;
+  workspaceIdentity?: string;
+}) => void | Promise<void>;
+
+export interface RemoteHostAttachmentStopProductWiring {
+  /** Wrap a session service so create/resume bind and close unbinds. */
+  wrapSessionService<T extends RemoteHostStopBindableSessionService>(
+    service: T,
+    options: {
+      /** Agent SessionStore writer for sessions created through this service. */
+      persistViaAgent: AgentRemoteHostAttachmentStopPersist;
+    },
+  ): T;
+  /** Install glue.setPersist router (idempotent). Returns uninstall. */
+  installPersistRouter(): () => void;
+  /** Test/inspect: which SessionIds currently have an agent writer. */
+  listPersistSessionIds(): string[];
+  clear(): void;
+}
+
+/**
+ * Create product wiring bound to a Host glue instance.
+ * Call installPersistRouter once per Host lifetime; wrap each local/remote session service.
+ */
+export function createRemoteHostAttachmentStopProductWiring(options?: {
+  glue?: RemoteHostAttachmentStopSessionGlue;
+}): RemoteHostAttachmentStopProductWiring {
+  const glue = options?.glue ?? getRemoteHostAttachmentStopSessionGlue();
+  /** Per-SessionId writers already close over workspace from bind time. */
+  type BoundSessionPersistWriter = PersistRemoteHostStopSessionReceipt;
+  const writers = new Map<string, BoundSessionPersistWriter>();
+  let persistInstalled = false;
+
+  const routerPersist: PersistRemoteHostStopSessionReceipt = async (input) => {
+    const writer = writers.get(input.sessionId);
+    if (!writer) return;
+    await writer(input);
+  };
+
+  function rememberWriter(sessionId: string, writer: BoundSessionPersistWriter) {
+    const id = sessionId.trim();
+    if (!id) return;
+    writers.set(id, writer);
+  }
+
+  function forgetWriter(sessionId: string) {
+    writers.delete(sessionId.trim());
+  }
+
+  return {
+    wrapSessionService(service, wrapOptions) {
+      // Proxy (not object spread): ProxyChannel / attachment wrappers are not plain
+      // enumerables; spread would drop methods and break Host RPC.
+      return new Proxy(service, {
+        get(target, property, receiver) {
+          const value = Reflect.get(target, property, receiver);
+          if (property === "createSession" && typeof value === "function") {
+            return async (params: Parameters<RemoteHostStopBindableSessionService["createSession"]>[0]) => {
+              const snapshot = await value.call(target, params);
+              const remote = params.remoteSessionId?.trim();
+              const sessionId = snapshot.session.sessionId;
+              if (remote && sessionId) {
+                glue.bindSession(remote, sessionId);
+                const workspacePath = params.workspacePath;
+                const workspaceIdentity = params.workspaceIdentity;
+                rememberWriter(sessionId, async (input) => {
+                  await wrapOptions.persistViaAgent({
+                    ...input,
+                    workspacePath,
+                    ...(workspaceIdentity !== undefined ? { workspaceIdentity } : {}),
+                  });
+                });
+              }
+              return snapshot;
+            };
+          }
+          if (property === "resumeSession" && typeof value === "function") {
+            return async (params: Parameters<RemoteHostStopBindableSessionService["resumeSession"]>[0]) => {
+              const snapshot = await value.call(target, params);
+              const remote = params.remoteSessionId?.trim();
+              const sessionId = snapshot.session.sessionId || params.sessionId;
+              if (remote && sessionId) {
+                glue.bindSession(remote, sessionId);
+                const workspacePath = params.workspacePath;
+                const workspaceIdentity = params.workspaceIdentity;
+                rememberWriter(sessionId, async (input) => {
+                  await wrapOptions.persistViaAgent({
+                    ...input,
+                    workspacePath,
+                    ...(workspaceIdentity !== undefined ? { workspaceIdentity } : {}),
+                  });
+                });
+              }
+              return snapshot;
+            };
+          }
+          if (property === "closeSession" && typeof value === "function") {
+            return async (params: Parameters<RemoteHostStopBindableSessionService["closeSession"]>[0]) => {
+              try {
+                await value.call(target, params);
+              } finally {
+                const remote = params.remoteSessionId?.trim();
+                if (remote) {
+                  glue.unbindSession(remote, params.sessionId);
+                }
+                forgetWriter(params.sessionId);
+              }
+            };
+          }
+          return value;
+        },
+      }) as typeof service;
+    },
+
+    installPersistRouter() {
+      if (!persistInstalled) {
+        glue.setPersist(routerPersist);
+        persistInstalled = true;
+      }
+      return () => {
+        if (persistInstalled) {
+          glue.setPersist(undefined);
+          persistInstalled = false;
+        }
+      };
+    },
+
+    listPersistSessionIds() {
+      return Array.from(writers.keys());
+    },
+
+    clear() {
+      writers.clear();
+      if (persistInstalled) {
+        glue.setPersist(undefined);
+        persistInstalled = false;
+      }
+    },
+  };
+}
+
+/**
+ * Build an agent persist adapter from a SessionStore-shaped saveSessionEntry.
+ * Mirrors core `persistRemoteHostAttachmentStopReceipt` entry shape — never adds linkedTasks.
+ */
+export function createSessionStoreRemoteHostStopPersist(input: {
+  saveSessionEntry: (entry: {
+    id: string;
+    sessionID: string;
+    type: string;
+    touchSession: boolean;
+    time: { created: number; updated: number };
+    data: RemoteHostStopSessionReceipt;
+  }) => void | Promise<void>;
+}): AgentRemoteHostAttachmentStopPersist {
+  return async ({ sessionId, receipt }) => {
+    // workspacePath is Host routing only; SessionStore adapter ignores it.
+    const now = Date.now();
+    const id = `remote-host-attachment-stop:${receipt.remoteSessionId}:${receipt.reason}:${receipt.stoppedAt}`;
+    // Strip any accidental linkedTasks — production Host path must not invent them.
+    const { linkedTasks: _ignored, ...honest } = receipt as RemoteHostStopSessionReceipt & {
+      linkedTasks?: unknown;
+    };
+    void _ignored;
+    await input.saveSessionEntry({
+      id,
+      sessionID: sessionId,
+      type: "remote_host_attachment_stop",
+      touchSession: false,
+      time: { created: receipt.stoppedAt, updated: now },
+      data: honest,
+    });
+  };
+}
