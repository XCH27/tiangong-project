+    assert.equal(works.length, 1);
+    assert.equal(works[0]?.workId, "wf-btc-1");
+    assert.equal(works[0]?.kind, "workflow");
+    assert.equal(works[0]?.status, "resultPending");
+    assert.notEqual(works[0]?.status, "running");
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
