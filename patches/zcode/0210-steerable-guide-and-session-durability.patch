+import assert from "node:assert/strict";
+import test from "node:test";
+import { HookEventName } from "@zcode/contracts";
+import type { NativeAgentContinuation, NativeAgentTurnRequest } from "@zcode/contracts";
+import {
+  NATIVE_GUIDE_TOOL_BOUNDARY_PATHS,
+  nativeGuideSteerAllowed,
+} from "../src/runtime/methods/native-guide-tool-boundary-honesty.js";
+import { fixture, reply, selection } from "./helpers/pi-runtime-fixture.js";
+
+/**
+ * Prove native_continuation_same_session: after a native terminal step, Guide/Stop
+ * continuation must reopen only through the same validated vendor session (resume +
+ * continuationMessageOffset), not a fresh full-history invent. Stop-hook continue is
+ * the Host path that returns "continue" today while mid-turn Guide stays refused by
+ * the honesty gate. Does not invent Host Ready / steerable.
+ */
+const VENDOR_SESSION: NativeAgentContinuation = {
+  sessionId: "vendor-sess-same",
+  cachePath: "/tmp/native-continuation-same-session-cache",
+  cacheFingerprint: "fingerprint-same",
+  executorVersion: "fixture-1",
+};
+
+test("native terminal Stop continues once through the same validated vendor session", async () => {
+  let stopContinues = 0;
+  const createRequests: NativeAgentTurnRequest[] = [];
+  const canResumeCalls: NativeAgentContinuation[] = [];
+
+  const f = await fixture(undefined, false, {
+    nativeExecutor: { kind: "claude", accountId: "fixture-continuation" } as never,
+    deps: {
+      hookRunner: {
+        async run(input) {
+          if (input.hookEventName !== HookEventName.Stop) {
+            return { additionalContexts: [] };
+          }
+          stopContinues += 1;
+          // One Stop continuation only — proves the native-agent-turn reopen path once.
+          if (stopContinues === 1) {
+            return {
+              additionalContexts: ["Stop says continue with the same vendor session"],
+              stopShouldContinue: true,
+            };
+          }
+          return { additionalContexts: [] };
+        },
+      },
+    },
+  });
+
+  try {
+    const runtime = f.runtime as any;
+    runtime.nativeAgentPort = {
+      async canResume(continuation: NativeAgentContinuation) {
+        canResumeCalls.push(continuation);
+        return continuation.sessionId === VENDOR_SESSION.sessionId;
+      },
+      createTurn(request: NativeAgentTurnRequest) {
+        createRequests.push(request);
+        return {
+          model: request.model,
+          async admitNextStep() {},
+          retainToolReceipts() {},
+          async checkpoint() {
+            return VENDOR_SESSION;
+          },
+          async close() {},
+        };
+      },
+    };
+
+    f.steps.push(
+      () => reply("native terminal before Stop continue"),
+      () => reply("native resumed after Stop continue"),
+    );
+
+    const result = await runtime.executeTurn("Original native input", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+
+    assert.equal(result.response, "native resumed after Stop continue");
+    assert.equal(stopContinues, 2, "Stop hook runs after each terminal; only first continues");
+    assert.equal(createRequests.length, 2, "terminal settle must reopen native turn once for Stop");
+
+    const [first, second] = createRequests;
+    assert.equal(first.continuation, undefined, "first native query starts fresh");
+    assert.equal(first.continuationMessageOffset, undefined);
+    assert.equal(first.persistContinuation, true);
+
+    assert.ok(second.continuation, "Stop continue must resume a validated vendor continuation");
+    assert.equal(second.continuation?.sessionId, VENDOR_SESSION.sessionId);
+    assert.equal(typeof second.continuationMessageOffset, "number");
+    assert.ok(
+      (second.continuationMessageOffset as number) > 0,
+      "resume must skip history already covered by the settled vendor session",
+    );
+    assert.equal(canResumeCalls.length, 1);
+    assert.equal(canResumeCalls[0]?.sessionId, VENDOR_SESSION.sessionId);
+
+    const resumedVisible = (second.messages ?? []).filter((message) => message.role !== "system");
+    const newSlice = resumedVisible.slice(second.continuationMessageOffset as number);
+    assert.ok(newSlice.length >= 1, "resume must carry the Stop-hook input that never reached the SDK");
+    assert.ok(
+      JSON.stringify(newSlice).includes("Stop says continue with the same vendor session"),
+      "same-session resume must include Stop additional context, not re-invent full history only",
+    );
+    assert.equal(
+      JSON.stringify(newSlice).includes("Original native input"),
+      false,
+      "covered original user input must not be re-submitted after continuationMessageOffset",
+    );
+
+    // Gate may be open (steerable paths proved); still not product Ready invent.
+    assert.equal(nativeGuideSteerAllowed(), true);
+    assert.equal(runtime.activeTurn, undefined);
+  } finally {
+    await f.close();
+  }
+});
+
+test("native continuation without a vendor checkpoint cannot claim same-session resume", async () => {
+  let stopContinues = 0;
+  const createRequests: NativeAgentTurnRequest[] = [];
+
+  const f = await fixture(undefined, false, {
+    nativeExecutor: { kind: "codex", accountId: "fixture-no-checkpoint" } as never,
+    deps: {
+      hookRunner: {
+        async run(input) {
+          if (input.hookEventName !== HookEventName.Stop) {
+            return { additionalContexts: [] };
+          }
+          stopContinues += 1;
+          if (stopContinues === 1) {
+            return {
+              additionalContexts: ["Stop continue without checkpoint"],
+              stopShouldContinue: true,
+            };
+          }
+          return { additionalContexts: [] };
+        },
+      },
+    },
+  });
+
+  try {
+    const runtime = f.runtime as any;
+    runtime.nativeAgentPort = {
+      async canResume() {
+        return true;
+      },
+      createTurn(request: NativeAgentTurnRequest) {
+        createRequests.push(request);
+        return {
+          model: request.model,
+          async admitNextStep() {},
+          retainToolReceipts() {},
+          // No checkpoint — settle is a no-op; next create must not invent resume.
+          async close() {},
+        };
+      },
+    };
+
+    f.steps.push(
+      () => reply("terminal without checkpoint"),
+      () => reply("fresh after missing checkpoint"),
+    );
+
+    await runtime.executeTurn("No checkpoint native input", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+
+    assert.equal(createRequests.length, 2);
+    assert.equal(createRequests[0]?.continuation, undefined);
+    assert.equal(
+      createRequests[1]?.continuation,
+      undefined,
+      "missing vendor checkpoint must not invent same-session resume",
+    );
+    assert.equal(nativeGuideSteerAllowed(), true);
+  } finally {
+    await f.close();
+  }
+});
+
+test("checklist marks native_continuation_same_session proved with gate open", () => {
+  const byId = new Map(NATIVE_GUIDE_TOOL_BOUNDARY_PATHS.map((path) => [path.id, path]));
+  assert.equal(byId.get("native_continuation_same_session")?.status, "proved");
+  assert.equal(byId.get("host_tool_batch_drain")?.status, "proved");
+  assert.equal(byId.get("text_only_no_tool_fallback")?.status, "proved");
+  assert.equal(nativeGuideSteerAllowed(), true);
+});
