+      memoryEvents: source.memoryEvents,
+      messages: source.messages,
+      sessionId,
+    });
+    const projection = new ProductProjection(sessionId, "remote-host-stop-cold");
+    for (const event of merged.events) {
+      projection.applyEventAtomically(event, () => true);
+    }
+    const works = projection.getSnapshot().backgroundWorks;
+    assert.equal(works.length, 1);
+    assert.equal(works[0]?.workId, "bash-cold-1");
+    assert.equal(works[0]?.kind, "bash");
+    assert.equal(works[0]?.status, "cancelled");
+    assert.notEqual(works[0]?.status, "running");
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
