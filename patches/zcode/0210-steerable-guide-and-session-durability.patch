+test("multi-source cold SQLite reopen keeps bash+agent+workflow terminals honest without inventing running", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-host-cold-honesty-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+
+    // 1) natural Bash Completed
+    assert.equal(
+      await persistBackgroundTaskCompletedEntry({
+        sessionStore: store,
+        sessionId,
+        event: bashCompletedEvent("bash-natural-1"),
+      }),
+      true,
+    );
+    // 2) bash_stop only
+    await persistStoppedBashBackgroundTask({
+      sessionStore: store,
+      sessionId,
+      stopped: bashStop("bash-stop-1", "killed"),
+    });
+    // 3) subagent_stop only
+    const stoppedAgent = agentStop("agent-stop-1", true);
+    await store.saveSessionEntry({
+      id: backgroundStopKey(stoppedAgent.task),
+      sessionID: sessionId,
+      type: SUBAGENT_STOP_SESSION_ENTRY,
+      touchSession: false,
+      time: {
+        created: stoppedAgent.task.completedAt!.getTime(),
+        updated: Date.now(),
+      },
+      data: stoppedAgent,
+    });
+    // 4) orphan Bash Started (no Completed)
+    assert.equal(
+      await persistBackgroundTaskStartedEntry({
+        sessionStore: store,
+        sessionId,
+        event: bashStartedEvent("bash-orphan-1"),
+      }),
+      true,
+    );
+    // 5) natural Agent Completed (live emit-path)
+    assert.equal(
+      await persistBackgroundTaskCompletedEntry({
+        sessionStore: store,
+        sessionId,
+        event: agentCompletedEvent("agent-natural-1"),
+      }),
+      true,
+    );
+    // 6) orphan Agent Started (no Completed)
+    assert.equal(
+      await persistBackgroundTaskStartedEntry({
+        sessionStore: store,
+        sessionId,
+        event: agentStartedEvent("agent-orphan-1"),
+      }),
+      true,
+    );
+    // 7) natural workflow Completed (Started journal-gated / cold suppress)
+    assert.equal(
+      await persistBackgroundTaskCompletedEntry({
+        sessionStore: store,
+        sessionId,
+        event: workflowCompletedEvent("workflow-natural-1"),
+      }),
+      true,
+    );
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const source = await loadPersistedConversationMaterialization({
+      memoryEvents: [],
+      sessionId,
+      store: {
+        getSession: (id) => store.getSession(id),
+        messages: (input) => store.messages(input),
+        readTarget: (input) => store.readTarget(input),
+        sessionEntries: (input) => store.sessionEntries(input),
+      },
+    });
+
+    const completed = source.memoryEvents.filter(
+      (event) => event.type === SessionEventType.BackgroundTaskCompleted,
+    );
+    assert.equal(completed.length, 7);
+    assert.equal(
+      source.memoryEvents.some((event) => event.type === SessionEventType.BackgroundTaskStarted),
+      false,
+      "orphan Started must synthesize lost Completed, not surface live Started",
