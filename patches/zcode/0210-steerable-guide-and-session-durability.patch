diff --git a/packages/ui/src/settings/pluginMcpSurfaceHonesty.ts b/packages/ui/src/settings/pluginMcpSurfaceHonesty.ts
new file mode 100644
index 00000000..7b30001c
--- /dev/null
+++ b/packages/ui/src/settings/pluginMcpSurfaceHonesty.ts
@@ -0,0 +1,108 @@
+/**
+ * Plugin / MCP surface honesty (wired vs usable).
+ *
+ * Horizontal compare:
+ * - VS Code `McpConnectionState`: configured ≠ Running; Stopped/Starting/Running/Error.
+ *   Live tools require a connected server — cache "Live" is not invented from mcp.json alone.
+ * - Claude Code / ACP: capability flags report truth; discovery does not invent Ready.
+ * - Fleet AGENTS.md: only `usable` | `wired but not visually checked` | `display-only` |
+ *   `not implemented`. Agents must never invent Ready/usable for a wired-only surface.
+ *
+ * ZCode already separates `declaredMcpServerNames` (manifest / grant surface) from
+ * `mcpServerNames` (runtime injection). This module labels that distinction so UI/tests
+ * cannot treat declaration or injection alone as product `usable` or invent `Ready`.
+ */
+
+import type { McpServerStatus } from "@zcode/shared";
+
+/** Forbidden product / invent labels for Plugin MCP runtime projection. */
+export const PLUGIN_MCP_FORBIDDEN_PRODUCT_LABELS = ["usable", "Ready", "ready"] as const;
+
+export type PluginMcpForbiddenProductLabel =
+  (typeof PLUGIN_MCP_FORBIDDEN_PRODUCT_LABELS)[number];
+
+/**
+ * Runtime honesty for one Plugin MCP row. Deliberately excludes product `usable`
+ * and invent `Ready` — connection alone never promotes those (owner visual acceptance
+ * lives in the capability register, not in MCP status dots).
+ */
+export type PluginMcpSurfaceHonesty =
+  | "declared_wired"
+  | "runtime_wired"
+  | "connecting"
+  | "connected"
+  | "disconnected"
+  | "error"
+  | "plugin_disabled"
+  | "unknown";
+
+export type PluginMcpSurfaceHonestyInput = {
+  /** Manifest / grant declaration (may exist while runtime withholds injection). */
+  declared: boolean;
+  /** Runtime has injected the server (`mcpServerNames` / hostProvided active). */
+  active: boolean;
+  pluginEnabled: boolean;
+  status?: McpServerStatus;
+};
+
+/**
+ * Classify one Plugin MCP surface. Declared-only and runtime-injected-without-live
+ * connection stay `*_wired`. Never returns a forbidden product label.
+ */
+export function classifyPluginMcpSurfaceHonesty(
+  input: PluginMcpSurfaceHonestyInput,
+): PluginMcpSurfaceHonesty {
+  if (!input.pluginEnabled && !input.active) {
+    // Disabled plugin: declaration may still list the server for provenance.
+    return "plugin_disabled";
+  }
+  if (!input.active) {
+    // Enabled (or host row) but not injected — grant pending / withheld / unload.
+    return "declared_wired";
+  }
+  switch (input.status) {
+    case "connecting":
+      return "connecting";
+    case "connected":
+      return "connected";
+    case "disconnected":
+      return "disconnected";
+    case "error":
+      return "error";
+    case "unknown":
+      return "unknown";
+    case undefined:
+      // Injected into runtime inventory without a live snapshot — wired, not usable.
+      return "runtime_wired";
+    default: {
+      const _exhaustive: never = input.status;
+      void _exhaustive;
+      return "unknown";
+    }
+  }
+}
+
