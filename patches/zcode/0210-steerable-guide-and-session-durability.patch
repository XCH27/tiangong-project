--- /dev/null
+++ b/packages/desktop/scripts/desktop-product-identity.test.mjs
@@ -0,0 +1,102 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  FLEET_PRODUCT_IDENTITY_ENV,
+  ZCODE_PREVIEW_IDENTITY_ENV,
+  isFleetProductIdentityRequested,
+  resolveDesktopArtifactSuffix,
+  resolveDesktopProductBrand,
+  resolveDesktopProductIdentity,
+  resolveDesktopRuntimeApplicationName,
+  resolveWindowsAppUserModelIdForFlavor,
+} from "./desktop-product-identity.mjs";
+
+test("default brand stays zcode so existing signed paths remain stable", () => {
+  const identity = resolveDesktopProductIdentity({ ZCODE_ENV: "production" });
+  assert.equal(identity.brand, "zcode");
+  assert.equal(identity.appId, "dev.zcode.app");
+  assert.equal(identity.productName, "ZCode");
+  assert.equal(identity.packaging.homepage, "https://zcode.z.ai");
+  assert.equal(resolveDesktopProductBrand({}), "zcode");
+  assert.equal(isFleetProductIdentityRequested({}), false);
+});
+
+test("FLEET_PRODUCT_IDENTITY=1 overlays Fleet packaging identity without z.ai commerce metadata", () => {
+  const identity = resolveDesktopProductIdentity({
+    ZCODE_ENV: "production",
+    [FLEET_PRODUCT_IDENTITY_ENV]: "1",
+  });
+  assert.equal(identity.brand, "fleet");
+  assert.equal(identity.flavor, "production");
+  assert.equal(identity.appId, "dev.fleet.app");
+  assert.equal(identity.productName, "Fleet");
+  assert.equal(identity.linuxExecutableName, "fleet");
+  assert.equal(identity.linuxPackageName, "fleet");
+  assert.equal(identity.packaging.homepage, "https://fleet.invalid");
+  assert.equal(identity.packaging.author.name, "Fleet");
+  assert.match(identity.packaging.maintainer, /^Fleet </);
+  assert.doesNotMatch(identity.packaging.homepage, /z\.ai/);
+  assert.doesNotMatch(identity.packaging.author.email, /z\.ai/);
+});
+
+test("Fleet preview keeps parallel-install flavor axis", () => {
+  const identity = resolveDesktopProductIdentity({
+    ZCODE_ENV: "production",
+    [ZCODE_PREVIEW_IDENTITY_ENV]: "1",
+    [FLEET_PRODUCT_IDENTITY_ENV]: "1",
+  });
+  assert.equal(identity.brand, "fleet");
+  assert.equal(identity.flavor, "preview");
+  assert.equal(identity.appId, "dev.fleet.app.preview");
+  assert.equal(identity.productName, "Fleet Preview");
+  assert.equal(identity.linuxPackageName, "fleet-preview");
+  assert.equal(identity.cuaHelperInstallVariant, "preview");
+});
+
+test("invalid FLEET_PRODUCT_IDENTITY spellings fail closed", () => {
+  assert.throws(
+    () => resolveDesktopProductIdentity({ [FLEET_PRODUCT_IDENTITY_ENV]: "true" }),
+    /expected 1 or 0/,
+  );
+});
+
+test("artifact suffix still tracks backend env, not brand", () => {
+  assert.equal(resolveDesktopArtifactSuffix({ ZCODE_ENV: "test" }), "_TEST");
+  assert.equal(
+    resolveDesktopArtifactSuffix({ ZCODE_ENV: "production", [FLEET_PRODUCT_IDENTITY_ENV]: "1" }),
+    "",
+  );
+});
+
+test("runtime application name follows brand + packaged bit", () => {
+  const fleet = resolveDesktopProductIdentity({
+    ZCODE_ENV: "production",
+    [FLEET_PRODUCT_IDENTITY_ENV]: "1",
+  });
+  assert.equal(
+    resolveDesktopRuntimeApplicationName({}, { isPackaged: true }, fleet),
+    "Fleet",
+  );
+  assert.equal(
+    resolveDesktopRuntimeApplicationName({}, { isPackaged: false }, fleet),
+    "Fleet Dev",
+  );
+});
+
+test("Windows AUMID uses compile-time brand for packaged builds", () => {
+  assert.equal(
+    resolveWindowsAppUserModelIdForFlavor("production", {
+      isPackaged: true,
+      brand: "fleet",
+    }),
+    "dev.fleet.app",
+  );
+  assert.equal(
+    resolveWindowsAppUserModelIdForFlavor("preview", { isPackaged: true, brand: "fleet" }),
+    "dev.fleet.app.preview",
+  );
+  assert.equal(
+    resolveWindowsAppUserModelIdForFlavor("production", { isPackaged: false, brand: "fleet" }),
+    "cn.aminer.zcode",
+  );
+});
