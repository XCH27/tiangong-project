diff --git a/apps/zcode-cli/packages/adapters/test/acp-permission-guide.test.ts b/apps/zcode-cli/packages/adapters/test/acp-permission-guide.test.ts
new file mode 100644
index 00000000..acb65f0d
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/acp-permission-guide.test.ts
@@ -0,0 +1,242 @@
+import assert from "node:assert/strict";
+import { chmodSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { createAcpNativeAgentPort } from "../src/native-agent/acp-turn.js";
+import type { Model, NativeAgentTurnRequest } from "@zcode/contracts";
+
+/**
+ * Prove acp_permission_wait_boundary: while Host approval waits on
+ * session/request_permission, deliverGuideAtToolBoundary accepts Guide (hold)
+ * and flushes it after the wait settles — whether the permission is accepted or
+ * refused. Outside that wait, Guide is an explicit refuse (unavailable). Never
+ * silent drop. Does not invent Host Ready / steerable.
+ */
+function permissionAgent() {
+  const dir = mkdtempSync(join(tmpdir(), "acp-permission-guide-"));
+  const script = join(dir, "kimi");
+  const log = join(dir, "log.jsonl");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs = require("node:fs");
+if (process.argv.includes("--version")) { console.log("9.9.9"); process.exit(0); }
+const log = (entry) => fs.appendFileSync(${JSON.stringify(log)}, JSON.stringify(entry) + "\\n");
+const send = (message) => process.stdout.write(JSON.stringify(message) + "\\n");
+const config = (model, mode) => [
+  { id: "model", category: "model", type: "select", currentValue: model, options: [{ value: "k3", name: "K3" }] },
+  { id: "mode", category: "mode", type: "select", currentValue: mode, options: [{ value: "default" }, { value: "plan" }] },
+];
+let model = "k3", mode = "default", nextId = 1000;
+const waiting = new Map();
+let buffer = "";
+process.stdin.on("data", (chunk) => {
+  buffer += chunk;
+  let index;
+  while ((index = buffer.indexOf("\\n")) >= 0) {
+    const line = buffer.slice(0, index); buffer = buffer.slice(index + 1);
+    if (!line.trim()) continue;
+    const message = JSON.parse(line);
+    log(message);
+    if (message.method === undefined && waiting.has(message.id)) {
+      waiting.get(message.id)(message.result);
+      waiting.delete(message.id);
+      continue;
+    }
+    if (message.method === "session/steer" || message.method === "_session/steering") {
+      log({ steer: message.params });
+      continue;
+    }
+    const reply = (result) => send({ jsonrpc: "2.0", id: message.id, result });
+    switch (message.method) {
+      case "initialize":
+        reply({
+          protocolVersion: 1,
+          agentCapabilities: {
+            loadSession: true,
+            promptCapabilities: { image: false },
+            sessionCapabilities: { resume: {}, delete: {} },
+          },
+          agentInfo: { version: "9.9.9" },
+        });
+        break;
+      case "session/new":
+        reply({ sessionId: "sess-guide", configOptions: config(model, mode) });
+        break;
+      case "session/set_config_option":
+        if (message.params.configId === "model") model = message.params.value;
+        else mode = message.params.value;
+        reply({ configOptions: config(model, mode) });
+        break;
+      case "session/prompt": {
+        const id = nextId++;
+        waiting.set(id, (result) => {
+          log({ permissionOutcome: result.outcome });
+          send({
+            jsonrpc: "2.0",
+            method: "session/update",
+            params: {
+              sessionId: "sess-guide",
+              update: {
+                sessionUpdate: "agent_message_chunk",
+                content: { type: "text", text: "done" },
+              },
+            },
+          });
+          reply({ stopReason: "end_turn", usage: { inputTokens: 3, outputTokens: 1, totalTokens: 4 } });
+        });
+        send({
+          jsonrpc: "2.0",
+          id,
+          method: "session/request_permission",
+          params: {
+            sessionId: "sess-guide",
+            toolCall: {
+              toolCallId: "t1",
+              title: "Write file",
+              kind: "edit",
+              rawInput: { path: "a.txt" },
+            },
+            options: [
+              { optionId: "yes", kind: "allow_once", name: "Allow" },
+              { optionId: "no", kind: "reject_once", name: "Reject" },
+            ],
+          },
+        });
+        break;
+      }
+      case "session/cancel":
+        break;
+      default:
+        if (message.id !== undefined)
+          send({ jsonrpc: "2.0", id: message.id, error: { code: -32601, message: "not found" } });
+    }
+  }
+});
+`,
+  );
+  chmodSync(script, 0o755);
+  return {
+    dir,
+    script,
+    log: () =>
+      readFileSync(log, "utf8")
+        .trim()
+        .split("\n")
+        .filter(Boolean)
+        .map((line) => JSON.parse(line) as Record<string, any>),
+  };
+}
+
+function turnRequest(
+  executable: string,
+  extras: Partial<NativeAgentTurnRequest> & {
+    requestApproval?: NativeAgentTurnRequest["requestApproval"];
+  } = {},
+): NativeAgentTurnRequest {
+  return {
+    model: {
+      modelId: "k3",
+      options: {},
+      nativeExecutor: { kind: "kimi", executable, accountId: "kimi-local" },
+    } as unknown as Model,
+    messages: [{ role: "user", content: "write a file" }],
+    tools: [],
+    sessionId: "s1",
+    turnId: "t1",
+    workingDirectory: tmpdir(),
+    signal: new AbortController().signal,
+    collaborationMode: "build",
+    ...extras,
+  };
+}
+
+async function withPermissionWait(
+  allow: boolean,
+  guideText: string,
+): Promise<{ delivered: "delivered" | "unavailable" | undefined; steers: unknown[]; outcome: unknown }> {
+  const agent = permissionAgent();
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const turn = createAcpNativeAgentPort("kimi").createTurn(
+    turnRequest(agent.script, {
+      requestApproval: async () => {
+        entered.resolve();
+        await release.promise;
+        return allow;
+      },
+    }),
+  );
+  turn.admitNextStep();
+  const streaming = (async () => {
+    for await (const event of turn.model.streamText({
+      messages: turnRequest(agent.script).messages,
+    } as never)) {
+      if (event.type === "finish") break;
+    }
+  })();
+  await entered.promise;
+  const delivered = await turn.deliverGuideAtToolBoundary?.(guideText);
+  release.resolve();
+  await streaming.catch(() => {});
+  await turn.close().catch(() => {});
+  const log = agent.log();
+  return {
+    delivered,
+    steers: log.filter((entry) => entry.steer).map((entry) => entry.steer),
+    outcome: log.find((entry) => entry.permissionOutcome)?.permissionOutcome,
+  };
+}
+
+test(
+  "ACP permission-wait accepts Guide and flushes after permission accept",
+  { timeout: 10000 },
+  async () => {
+    const result = await withPermissionWait(true, "  Mid-turn Guide: change direction  ");
+    assert.equal(result.delivered, "delivered");
+    assert.deepEqual(result.outcome, { outcome: "selected", optionId: "yes" });
+    assert.equal(result.steers.length, 1);
+    assert.deepEqual(result.steers[0], {
+      sessionId: "sess-guide",
+      prompt: [{ type: "text", text: "Mid-turn Guide: change direction" }],
+    });
+  },
+);
+
+test(
+  "ACP permission-wait accepts Guide and flushes after permission refuse",
+  { timeout: 10000 },
+  async () => {
+    const result = await withPermissionWait(false, "Guide while denying the tool");
+    assert.equal(result.delivered, "delivered");
+    assert.deepEqual(result.outcome, { outcome: "selected", optionId: "no" });
+    assert.equal(result.steers.length, 1);
+    assert.deepEqual(result.steers[0], {
+      sessionId: "sess-guide",
+      prompt: [{ type: "text", text: "Guide while denying the tool" }],
+    });
+  },
+);
+
+test(
+  "ACP deliverGuideAtToolBoundary is unavailable outside a permission wait",
+  { timeout: 10000 },
+  async () => {
+    const agent = permissionAgent();
+    const controller = new AbortController();
+    const turn = createAcpNativeAgentPort("kimi").createTurn(
+      turnRequest(agent.script, {
+        signal: controller.signal,
+        collaborationMode: "yolo",
+      }),
+    );
+    try {
+      assert.equal(await turn.deliverGuideAtToolBoundary?.("too early"), "unavailable");
+      assert.equal(await turn.deliverGuideAtToolBoundary?.("   "), "unavailable");
+    } finally {
+      controller.abort();
+      await turn.close().catch(() => {});
+    }
+  },
+);
