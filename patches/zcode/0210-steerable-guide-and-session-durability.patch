+
+test("cold SQLite subagent_stop materialization restores terminal backgroundWorks after eventStore loss", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-subagent-stop-proj-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const stopped = stoppedAgent({ complete: true });
+    await store.saveSessionEntry({
+      id: backgroundStopKey(stopped.task),
+      sessionID: sessionId,
+      type: SUBAGENT_STOP_SESSION_ENTRY,
+      touchSession: false,
+      time: {
+        created: stopped.task.completedAt!.getTime(),
+        updated: Date.now(),
+      },
+      data: stopped,
+    });
+    store.close();
+
+    // Cold reopen: empty memory eventStore, durable subagent_stop only.
+    store = new SqliteSessionStore({ dbPath });
+    const source = await loadPersistedConversationMaterialization({
+      memoryEvents: [],
