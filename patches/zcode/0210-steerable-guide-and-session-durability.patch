diff --git a/packages/ui/test/cuaComposerEntryState.test.ts b/packages/ui/test/cuaComposerEntryState.test.ts
new file mode 100644
index 00000000..f2fa0de6
--- /dev/null
+++ b/packages/ui/test/cuaComposerEntryState.test.ts
@@ -0,0 +1,172 @@
+/**
+ * CU composer entry — pure visibility / UI-state honesty (≠ product Ready invent).
+ *
+ * `resolveCuaComposerEntryView` is the zero-dependency cartesian over
+ * platform × settings × plugin × permission × sessionBusy. Prove gates and
+ * Mac/Windows paths without mounting React, without live Helper, and without
+ * inventing Ready when TCC is incomplete or the entry is not visible.
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { CuaPermissionStatusResult } from "@zcode/services";
+import { resolveCuaComposerEntryView } from "../src/lib/cuaComposerEntryState.js";
+
+type Inputs = Parameters<typeof resolveCuaComposerEntryView>[0];
+
+function base(overrides: Partial<Inputs> = {}): Inputs {
+  return {
+    macLocalDesktop: true,
+    windowsLocalDesktop: false,
+    hiddenBySettings: false,
+    permissionServiceAvailable: true,
+    pluginEnabled: true,
+    pluginToggling: false,
+    pluginError: false,
+    permissionStatus: null,
+    sessionBusy: false,
+    ...overrides,
+  };
+}
+
+function availableStatus(
+  accessibility: "granted" | "denied" | "stale" | "unknown",
+  screenRecording: "granted" | "denied" | "stale" | "unknown",
+): CuaPermissionStatusResult {
+  return {
+    available: true,
+    grantOwner: null,
+    accessibility,
+    screenRecording,
+  };
+}
+
+function unavailableStatus(idle?: true): CuaPermissionStatusResult {
+  return idle
+    ? { available: false, reason: "helper_idle", idle: true }
+    : { available: false, reason: "helper_failed" };
+}
+
+test("visibility gates: platform / settings / mac service / plugin hide the entry", () => {
+  assert.deepEqual(resolveCuaComposerEntryView(base({ macLocalDesktop: false, windowsLocalDesktop: false })), {
+    visible: false,
+  });
+  assert.deepEqual(resolveCuaComposerEntryView(base({ hiddenBySettings: true })), { visible: false });
+  assert.deepEqual(
+    resolveCuaComposerEntryView(base({ permissionServiceAvailable: false })),
+    { visible: false },
+  );
+  assert.deepEqual(
+    resolveCuaComposerEntryView(base({ pluginEnabled: false, pluginToggling: false })),
+    { visible: false },
+  );
+});
+
+test("plugin toggling keeps entry visible as starting (no empty gap)", () => {
+  const view = resolveCuaComposerEntryView(
+    base({ pluginEnabled: false, pluginToggling: true }),
+  );
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.uiState, "starting");
+  assert.equal(view.spinning, true);
+  assert.equal(view.clickAction, "open-settings");
+  assert.equal(view.interactionDisabled, false);
+  assert.equal(view.tooltipMessageId, "chat.toolbar.computerUse.tooltip.starting");
+});
+
+test("Mac: null permissionStatus is idle (lazy Helper; ≠ Ready invent)", () => {
+  const view = resolveCuaComposerEntryView(base({ permissionStatus: null }));
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.uiState, "idle");
+  assert.equal(view.spinning, false);
+  assert.equal(view.tone, "subtle");
+  assert.equal(view.clickAction, "open-settings");
+  assert.equal(view.tooltipMessageId, "chat.toolbar.computerUse.tooltip.idle");
+});
+
+test("Mac: unavailable helper is error; idle unavailable stays idle", () => {
+  const failed = resolveCuaComposerEntryView(base({ permissionStatus: unavailableStatus() }));
+  assert.equal(failed.visible, true);
+  if (!failed.visible) return;
+  assert.equal(failed.uiState, "error");
+  assert.equal(failed.tooltipMessageId, "chat.toolbar.computerUse.tooltip.error");
+
+  const idle = resolveCuaComposerEntryView(base({ permissionStatus: unavailableStatus(true) }));
+  assert.equal(idle.visible, true);
+  if (!idle.visible) return;
+  assert.equal(idle.uiState, "idle");
+});
+
+test("Mac: TCC incomplete stays permission-required (never Ready invent)", () => {
+  const view = resolveCuaComposerEntryView(
+    base({ permissionStatus: availableStatus("granted", "denied") }),
+  );
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.uiState, "permission-required");
+  assert.equal(view.tooltipMessageId, "chat.toolbar.computerUse.tooltip.permissionRequired");
+  assert.equal(view.clickAction, "open-settings");
+});
+
+test("Mac: TCC dual granted projects ready UI state (admission bit only)", () => {
+  const view = resolveCuaComposerEntryView(
+    base({ permissionStatus: availableStatus("granted", "granted") }),
+  );
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.uiState, "ready");
+  assert.equal(view.tooltipMessageId, "chat.toolbar.computerUse.tooltip.ready");
+  // Visible entry always opens settings — ready is not a product "usable" invent.
+  assert.equal(view.clickAction, "open-settings");
+  assert.equal(view.interactionDisabled, false);
+});
+
+test("Windows: plugin enabled → ready without TCC; Windows ignores mac service gate", () => {
+  const view = resolveCuaComposerEntryView(
+    base({
+      macLocalDesktop: false,
+      windowsLocalDesktop: true,
+      permissionServiceAvailable: false,
+      permissionStatus: null,
+    }),
+  );
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.uiState, "ready");
+});
+
+test("pluginError wins over permission status; toggling wins over error", () => {
+  const errored = resolveCuaComposerEntryView(
+    base({
+      pluginError: true,
+      permissionStatus: availableStatus("granted", "granted"),
+    }),
+  );
+  assert.equal(errored.visible, true);
+  if (!errored.visible) return;
+  assert.equal(errored.uiState, "error");
+
+  const toggling = resolveCuaComposerEntryView(
+    base({
+      pluginToggling: true,
+      pluginError: true,
+      permissionStatus: availableStatus("granted", "granted"),
+    }),
+  );
+  assert.equal(toggling.visible, true);
+  if (!toggling.visible) return;
+  assert.equal(toggling.uiState, "starting");
+});
+
+test("sessionBusy does not invent interactionDisabled / does not block settings jump", () => {
+  // Product simplification: entry no longer carries status-dot disable-on-busy;
+  // sessionBusy remains an input for callers but must not invent a disabled Ready gate.
+  const view = resolveCuaComposerEntryView(base({ sessionBusy: true, permissionStatus: null }));
+  assert.equal(view.visible, true);
+  if (!view.visible) return;
+  assert.equal(view.interactionDisabled, false);
+  assert.equal(view.clickAction, "open-settings");
+  assert.equal(view.uiState, "idle");
+  assert.notEqual(view.tooltipMessageId, "chat.toolbar.computerUse.tooltip.sessionBusy");
+});
