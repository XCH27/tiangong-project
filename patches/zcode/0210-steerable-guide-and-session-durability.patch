+}
+
+function bashStop(taskId: string, status: "killed" | "lost" = "killed") {
+  const startedAt = new Date("2026-10-10T20:02:00.000Z");
+  const completedAt = new Date("2026-10-10T20:02:05.000Z");
+  const traceContext = createRootTraceContext({ sessionId });
+  return {
+    task: {
+      agentId: taskId,
+      agentType: "local_bash" as const,
+      branchGeneration: 0,
+      completedAt,
+      description: "bash stop fixture",
