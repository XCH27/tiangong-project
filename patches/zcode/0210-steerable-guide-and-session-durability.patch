+test("RuntimeTaskType durability registry matches Host cold claims", () => {
+  assert.equal(COLD_RUNTIME_TASK_DURABILITY.local_bash, "session_completed_and_started");
+  assert.equal(COLD_RUNTIME_TASK_DURABILITY.local_agent, "session_completed_and_started");
+  assert.equal(COLD_RUNTIME_TASK_DURABILITY.local_dynamic_workflow, "session_completed_and_started_journal_gated");
+  assert.equal(COLD_RUNTIME_TASK_DURABILITY.local_workflow, "non_durable");
+  assert.equal(COLD_RUNTIME_TASK_DURABILITY.monitor_mcp, "non_durable");
+  assert.equal(coldRuntimeTaskDurabilityPolicy("local_bash"), "session_completed_and_started");
+  assert.equal(isColdDurableRuntimeTaskType("local_bash"), true);
+  assert.equal(isColdDurableRuntimeTaskType("monitor_mcp"), false);
+  assert.equal(isColdDurableRuntimeTaskType("local_workflow"), false);
+});
+
+test("local_workflow has live BackgroundTask emit but stays Session non_durable", () => {
+  assert.equal(coldRuntimeTaskTypeHasLiveBackgroundTaskEmit("local_workflow"), true);
+  assert.equal(hasColdLiveBackgroundTaskEmitPath("Workflow"), true);
+  assert.equal(isColdNonDurableBackgroundToolName("Workflow"), true);
+  assert.deepEqual([...COLD_NON_DURABLE_BACKGROUND_TOOL_NAMES], ["Workflow", "Monitor"]);
+  // Live alias taskKind bash must not piggyback bash Session durability.
+  assert.equal(
+    durableBackgroundTaskCompletedPayload({
+      taskId: "legacy-wf",
+      toolName: "Workflow",
+      taskKind: "bash",
+      status: "completed",
+    }),
+    undefined,
+  );
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "legacy-wf",
+      toolName: "Workflow",
+      taskKind: "bash",
+      status: "running",
+    }),
