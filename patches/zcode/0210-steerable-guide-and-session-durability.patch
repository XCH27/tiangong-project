diff --git a/packages/ui/test/pluginMcpSurfaceHonesty.test.ts b/packages/ui/test/pluginMcpSurfaceHonesty.test.ts
new file mode 100644
index 00000000..3262287e
--- /dev/null
+++ b/packages/ui/test/pluginMcpSurfaceHonesty.test.ts
@@ -0,0 +1,175 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ZCodePluginInfo } from "@zcode/shared";
+import { buildPluginMcpServerItems } from "../src/settings/pluginManagedResourceGroups.js";
+import {
+  PLUGIN_MCP_FORBIDDEN_PRODUCT_LABELS,
+  classifyPluginMcpSurfaceHonesty,
+  isForbiddenPluginMcpProductLabel,
+  isPluginMcpWiredOnly,
+  pluginMcpHonestyAllowsProductUsable,
+  type PluginMcpSurfaceHonesty,
+} from "../src/settings/pluginMcpSurfaceHonesty.js";
+import { partitionPluginsForSettings } from "../src/settings/pluginCapabilityProjection.js";
+
+function plugin(partial: Partial<ZCodePluginInfo> & Pick<ZCodePluginInfo, "id" | "name">): ZCodePluginInfo {
+  return {
+    marketplace: "third-party",
+    enabled: true,
+    source: "cache",
+    skillCount: 0,
+    skillRootCount: 0,
+    commandRootCount: 0,
+    components: [],
+    declaredMcpServerNames: [],
+    mcpServerNames: [],
+    rootPath: "/tmp/plugin",
+    ...partial,
+  } as ZCodePluginInfo;
+}
+
+test("classify: declared-only is wired, never usable/Ready", () => {
+  const honesty = classifyPluginMcpSurfaceHonesty({
+    declared: true,
+    active: false,
+    pluginEnabled: true,
+  });
+  assert.equal(honesty, "declared_wired");
+  assert.equal(isPluginMcpWiredOnly(honesty), true);
+  assert.equal(pluginMcpHonestyAllowsProductUsable(honesty), false);
+  assert.equal(isForbiddenPluginMcpProductLabel(honesty), false);
+});
+
+test("classify: runtime injection without status stays runtime_wired", () => {
+  const honesty = classifyPluginMcpSurfaceHonesty({
+    declared: true,
+    active: true,
+    pluginEnabled: true,
+  });
+  assert.equal(honesty, "runtime_wired");
+  assert.equal(isPluginMcpWiredOnly(honesty), true);
+  assert.equal(pluginMcpHonestyAllowsProductUsable(honesty), false);
+});
+
+test("classify: connected is live transport, still refuses product usable", () => {
+  const honesty = classifyPluginMcpSurfaceHonesty({
+    declared: true,
+    active: true,
+    pluginEnabled: true,
+    status: "connected",
+  });
+  assert.equal(honesty, "connected");
+  assert.equal(isPluginMcpWiredOnly(honesty), false);
+  assert.equal(pluginMcpHonestyAllowsProductUsable(honesty), false);
+});
+
+test("classify: disabled plugin is plugin_disabled wired-only", () => {
+  const honesty = classifyPluginMcpSurfaceHonesty({
+    declared: true,
+    active: false,
+    pluginEnabled: false,
+  });
+  assert.equal(honesty, "plugin_disabled");
+  assert.equal(isPluginMcpWiredOnly(honesty), true);
+});
+
+test("forbidden product labels cannot appear as honesty values", () => {
+  const honestyValues: PluginMcpSurfaceHonesty[] = [
+    "declared_wired",
+    "runtime_wired",
+    "connecting",
+    "connected",
+    "disconnected",
+    "error",
+    "plugin_disabled",
+    "unknown",
+  ];
+  for (const label of PLUGIN_MCP_FORBIDDEN_PRODUCT_LABELS) {
+    assert.equal(honestyValues.includes(label as PluginMcpSurfaceHonesty), false);
+    assert.equal(isForbiddenPluginMcpProductLabel(label), true);
+  }
+  for (const honesty of honestyValues) {
+    assert.equal(pluginMcpHonestyAllowsProductUsable(honesty), false);
+  }
+});
+
+test("buildPluginMcpServerItems: grant-pending declared MCP is declared_wired not active", () => {
+  const items = buildPluginMcpServerItems(
+    [
+      plugin({
+        id: "runner@third-party",
+        name: "runner",
+        enabled: true,
+        declaredMcpServerNames: ["tool"],
+        mcpServerNames: [], // grant pending — runtime withholds injection
+      }),
+    ],
+    "",
+  );
+  assert.equal(items.length, 1);
+  assert.equal(items[0]!.active, false);
+  assert.equal(items[0]!.honesty, "declared_wired");
+  assert.equal(pluginMcpHonestyAllowsProductUsable(items[0]!.honesty), false);
+  assert.equal(isForbiddenPluginMcpProductLabel(items[0]!.honesty), false);
+});
+
+test("buildPluginMcpServerItems: injected without snapshot is runtime_wired", () => {
+  const items = buildPluginMcpServerItems(
+    [
+      plugin({
+        id: "runner@third-party",
+        name: "runner",
+        enabled: true,
+        declaredMcpServerNames: ["tool"],
+        mcpServerNames: ["plugin:runner:tool"],
+      }),
+    ],
+    "",
+  );
+  assert.equal(items.length, 1);
+  assert.equal(items[0]!.active, true);
+  assert.equal(items[0]!.honesty, "runtime_wired");
+  assert.equal(pluginMcpHonestyAllowsProductUsable(items[0]!.honesty), false);
+});
+
+test("buildPluginMcpServerItems: connected snapshot is connected, still not product usable", () => {
+  const items = buildPluginMcpServerItems(
+    [
+      plugin({
+        id: "runner@third-party",
+        name: "runner",
+        enabled: true,
+        declaredMcpServerNames: ["tool"],
+        mcpServerNames: ["plugin:runner:tool"],
+      }),
+    ],
+    "",
+    {
+      "plugin:runner:tool": {
+        status: "connected",
+        transport: "stdio",
+        updatedAt: "2026-10-10T00:00:00.000Z",
+        toolCount: 2,
+      },
+    },
+  );
+  assert.equal(items[0]!.honesty, "connected");
+  assert.equal(items[0]!.status, "connected");
+  assert.equal(items[0]!.toolCount, 2);
+  assert.equal(pluginMcpHonestyAllowsProductUsable(items[0]!.honesty), false);
+});
+
+test("missing package projection never invents packageStatus available/Ready", () => {
+  // Schema only admits packageStatus: "missing" | undefined — never invent "available"/Ready.
+  const missing = plugin({
+    id: "gone@third-party",
+    name: "gone",
+    packageStatus: "missing",
+    source: "missing",
+  });
+  const settings = partitionPluginsForSettings([missing], new Set());
+  assert.deepEqual(settings.installed, []);
+  assert.deepEqual(settings.builtIn, []);
+  assert.notEqual((missing as { packageStatus?: string }).packageStatus, "available");
+  assert.notEqual((missing as { packageStatus?: string }).packageStatus, "Ready");
+});
