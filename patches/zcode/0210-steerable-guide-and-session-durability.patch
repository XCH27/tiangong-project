+
+test("linked bash/subagent tasks project terminal BackgroundTaskCompleted only", () => {
+  const events = synthesizeBackgroundTaskEventsFromRemoteHostAttachmentStopEntries({
+    entries: [
+      {
+        type: REMOTE_HOST_ATTACHMENT_STOP_SESSION_ENTRY,
