+import assert from "node:assert/strict";
+import test from "node:test";
+import { attachProcessToWindowsJobObject } from "../src/mcp/windows-job-object.js";
+
+function createFakeApi(hooks: {
+  assign?: boolean | ((pid: number) => boolean);
+  create?: object | undefined | (() => object | undefined);
+  onClose?: () => void;
+  onTerminate?: () => void;
+  throwOnCreate?: boolean;
+  throwOnAssign?: boolean;
+}) {
+  const job = { id: "job" };
+  return {
+    create() {
+      if (hooks.throwOnCreate) throw new Error("create failed");
+      if (typeof hooks.create === "function") return hooks.create();
+      if (hooks.create === undefined && "create" in hooks) return undefined;
+      return (hooks.create as object | undefined) ?? job;
+    },
+    assign(_job: object, pid: number) {
+      if (hooks.throwOnAssign) throw new Error("assign failed");
+      if (typeof hooks.assign === "function") return hooks.assign(pid);
+      return hooks.assign ?? true;
+    },
+    terminate() {
+      hooks.onTerminate?.();
+    },
+    close() {
+      hooks.onClose?.();
+    },
+  };
+}
+
+test("Job Object attach is a no-op outside win32 (ACP/MCP escapee boundary stays taskkill-only there)", async () => {
+  let createCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(4242, {
+    platform: "darwin",
+    api: createFakeApi({
+      create() {
+        createCalls += 1;
+        return { id: "job" };
+      },
+    }),
+  });
+  assert.equal(controller, undefined);
+  assert.equal(createCalls, 0);
+});
+
+test("Job Object attach refuses non-positive PIDs without touching the native API", async () => {
+  let createCalls = 0;
+  for (const pid of [0, -1, 1.5, Number.NaN]) {
+    const controller = await attachProcessToWindowsJobObject(pid as number, {
+      platform: "win32",
+      api: createFakeApi({
+        create() {
+          createCalls += 1;
+          return { id: "job" };
+        },
+      }),
+    });
+    assert.equal(controller, undefined, `pid=${String(pid)}`);
+  }
+  assert.equal(createCalls, 0);
+});
+
+test("Job Object attach fail-closed when create returns undefined (taskkill remains the Stop claim)", async () => {
+  let closeCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(77, {
+    platform: "win32",
+    api: createFakeApi({
+      create: () => undefined,
+      onClose: () => {
+        closeCalls += 1;
+      },
+    }),
+  });
+  assert.equal(controller, undefined);
+  assert.equal(closeCalls, 0);
+});
+
+test("Job Object attach closes the job and returns undefined when assign fails", async () => {
+  let closeCalls = 0;
+  let terminateCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(88, {
+    platform: "win32",
+    api: createFakeApi({
+      assign: false,
+      onClose: () => {
+        closeCalls += 1;
+      },
+      onTerminate: () => {
+        terminateCalls += 1;
+      },
+    }),
+  });
+  assert.equal(controller, undefined);
+  assert.equal(closeCalls, 1);
+  assert.equal(terminateCalls, 0);
+});
+
+test("Job Object attach fail-closed when assign throws after create", async () => {
+  let closeCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(89, {
+    platform: "win32",
+    api: createFakeApi({
+      throwOnAssign: true,
+      onClose: () => {
+        closeCalls += 1;
+      },
+    }),
+  });
+  assert.equal(controller, undefined);
+  assert.equal(closeCalls, 1);
+});
+
+test("Job Object controller terminate/close is idempotent for owned MCP stdio roots", async () => {
+  let closeCalls = 0;
+  let terminateCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(910_001, {
+    platform: "win32",
+    api: createFakeApi({
+      onClose: () => {
+        closeCalls += 1;
+      },
+      onTerminate: () => {
+        terminateCalls += 1;
+      },
+    }),
+  });
+  assert.ok(controller);
+  controller!.terminate();
+  controller!.terminate();
+  controller!.close();
+  controller!.close();
+  // Second terminate after close must not re-enter native terminate.
+  controller!.terminate();
+  assert.equal(terminateCalls, 1);
+  assert.equal(closeCalls, 1);
+});
+
+test("Job Object create throwing fail-closes without leaving a live controller", async () => {
+  let closeCalls = 0;
+  const controller = await attachProcessToWindowsJobObject(55, {
+    platform: "win32",
+    api: createFakeApi({
+      throwOnCreate: true,
+      onClose: () => {
+        closeCalls += 1;
+      },
+    }),
+  });
+  assert.equal(controller, undefined);
+  assert.equal(closeCalls, 0);
+});
