+  void runtime;
+  const deliver = activeTurn.deliverNativeGuideAtToolBoundary;
+  const outstanding = activeTurn.hostToolCallbacksOutstanding ?? 0;
+  if (!deliver || outstanding <= 0) return "skipped";
+  const delivery = pendingInput.delivery ?? pendingInput.intent?.admittedDelivery;
+  if (delivery !== "guide") return "skipped";
+  if (activeTurn.nativeGuideVendorDeliveredIds?.has(pendingInput.id)) return "delivered";
