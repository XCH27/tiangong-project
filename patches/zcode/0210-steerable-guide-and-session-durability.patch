diff --git a/packages/ui/src/lib/codePreviewLinePrefsSettings.ts b/packages/ui/src/lib/codePreviewLinePrefsSettings.ts
new file mode 100644
index 00000000..b4fefda3
--- /dev/null
+++ b/packages/ui/src/lib/codePreviewLinePrefsSettings.ts
@@ -0,0 +1,35 @@
+/**
+ * Appearance code-preview line prefs bridge: AppSettings is the durable owner;
+ * Zustand/localStorage remains a UI cache synchronized from settings.
+ */
+import type { AppSettings } from "@zcode/shared";
+import type { CodePreviewSettings } from "@/lib/codePreviewSettings.js";
+import { readSafeLocalStorage, writeSafeLocalStorage } from "@/lib/browserEnvironment.js";
+
+export const CODE_PREVIEW_LINE_PREFS_MIGRATED_KEY = "zcode-code-preview-line-prefs-to-settings";
+
+export function codePreviewLinePrefsFromSettings(
+  settings: Pick<AppSettings, "showLineNumbers" | "wrapLongLines">,
+): Pick<CodePreviewSettings, "showLineNumbers" | "wrapLongLines"> {
+  return {
+    showLineNumbers: settings.showLineNumbers !== false,
+    wrapLongLines: settings.wrapLongLines === true,
+  };
+}
+
+export function shouldMigrateCodePreviewLinePrefsToSettings(): boolean {
+  return readSafeLocalStorage(CODE_PREVIEW_LINE_PREFS_MIGRATED_KEY) !== "1";
+}
+
+export function markCodePreviewLinePrefsMigratedToSettings(): void {
+  writeSafeLocalStorage(CODE_PREVIEW_LINE_PREFS_MIGRATED_KEY, "1");
+}
+
+export function codePreviewLinePrefsPatchFromLocal(
+  local: Pick<CodePreviewSettings, "showLineNumbers" | "wrapLongLines">,
+): Pick<AppSettings, "showLineNumbers" | "wrapLongLines"> {
+  return {
+    showLineNumbers: local.showLineNumbers,
+    wrapLongLines: local.wrapLongLines,
+  };
+}
