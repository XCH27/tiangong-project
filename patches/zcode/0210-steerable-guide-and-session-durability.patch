diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/background-task-completed-settlement.ts b/apps/zcode-cli/packages/core/src/runtime/methods/background-task-completed-settlement.ts
new file mode 100644
index 00000000..cb4b6601
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/background-task-completed-settlement.ts
@@ -0,0 +1,273 @@
+import {
+  SessionEventType,
+  createSessionEvent,
+  type SessionEvent,
+  type SessionId,
+  type SessionStorePort,
+} from "../deps.js";
+import { isColdNonDurableBackgroundToolName } from "./cold-runtime-task-durability.js";
+
+/**
+ * Durable live BackgroundTaskCompleted transcript writes (bash + local_agent + workflow).
+ *
+ * Emit path still publishes BackgroundTask* into the memory eventStore (MEMORY_ONLY
+ * for cold-merge of live memory events). This module additionally persists terminal
+ * Bash, Agent (taskKind=subagent), and workflow (CreateWorkflow / ResumeWorkflowRun /
+ * AmendWorkflow) BackgroundTaskCompleted payloads as Session entries so cold
+ * materialization can restore backgroundWorks honesty after eventStore loss —
+ * including natural completed/failed settlement that never went through Stop /
+ * bash_stop / subagent_stop.
+ *
+ * Workflow Completed complements dwf journal (workflowRuns). Workflow Started is
+ * journal-gated in started-settlement (persist only when listNonTerminalRuns can
+ * gate; cold suppresses orphan→lost / never invents running).
+ *
+ * Explicitly not claimed here: inventing running from Updated / Updated as cold
+ * panel projector (Updated Session write is event-driven elsewhere), inventing running
+ * works, workflow orphan→lost, dedicated local_workflow / monitor_mcp Session
+ * reconstruct (non_durable; legacy Workflow toolName refused even when taskKind bash;
+ * monitor_mcp has empty emit-path), full generic reconstruct beyond the ordered
+ * registry toehold, full removal of BackgroundTaskCompleted from MEMORY_ONLY, or
+ * preferring Session Completed over live memory Completed. Bounded MEMORY_ONLY
+ * narrowing (durable Started ≺ Completed) lives in cold-event-merge. Bash/Agent
+ * Started durability lives in background-task-started-settlement.ts (orphan → lost).
+ */
+export const BACKGROUND_TASK_COMPLETED_SESSION_ENTRY = "background_task_completed" as const;
+
+export type DurableBackgroundTaskCompletedKind = "bash" | "subagent" | "workflow";
+
+export interface DurableBackgroundTaskCompletedPayload {
+  taskId: string;
+  toolCallId?: string;
+  toolName: string;
+  taskKind: DurableBackgroundTaskCompletedKind;
+  childSessionId?: string;
+  cancellable: false;
+  command?: string;
+  description?: string;
+  status: string;
+  pid?: number;
+  startedAt?: string;
+  completedAt?: string;
+  outputPath?: string;
+  terminalId?: string;
+  eventId?: string;
+  sequenceNumber?: number;
+  traceId?: string;
+  turnId?: string;
+}
+
+export function backgroundTaskCompletedKey(taskId: string): string {
+  return `background-task-completed:${taskId}`;
+}
+
+function stringField(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function numberField(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function dateIso(value: unknown): string | undefined {
+  if (value instanceof Date && Number.isFinite(value.getTime())) return value.toISOString();
+  if (typeof value === "string" && value.length > 0) {
+    const parsed = new Date(value);
+    if (Number.isFinite(parsed.getTime())) return parsed.toISOString();
+  }
+  return undefined;
+}
+
+function isWorkflowCompletedToolName(toolName: string | undefined): boolean {
+  return (
+    toolName === "CreateWorkflow" ||
+    toolName === "ResumeWorkflowRun" ||
+    toolName === "AmendWorkflow"
+  );
+}
+
+function resolveCompletedKind(
+  _taskKind: unknown,
+  toolName: string | undefined,
+): DurableBackgroundTaskCompletedKind | undefined {
+  // Registry non_durable rows: refuse Session persist even when live emit aliases bash.
+  if (isColdNonDurableBackgroundToolName(toolName)) return undefined;
+  // taskKind is panel decoration only; Session durability keys on real toolName —
+  // never invent Bash/Agent/CreateWorkflow from taskKind alone / missing toolName.
+  if (toolName === "Bash") return "bash";
+  if (toolName === "Agent" || toolName === "Task") return "subagent";
+  // dwf dispatch names only — legacy "Workflow" is non_durable (refused above).
+  if (isWorkflowCompletedToolName(toolName)) return "workflow";
+  return undefined;
+}
+
+/**
+ * Real Bash + Agent/Task (subagent) + dwf workflow terminals are durable. Updated is
+ * separate (event-driven meaningful control only). Kind resolution keys on toolName
+ * only (taskKind is decorative). Legacy
+ * Workflow / Monitor stay non_durable (registry). Workflow Started persist lives in
+ * started-settlement (journal-gated; cold suppresses orphan→lost).
+ */
+export function durableBackgroundTaskCompletedPayload(
+  payload: unknown,
+): DurableBackgroundTaskCompletedPayload | undefined {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) return undefined;
+  const record = payload as Record<string, unknown>;
+  const taskId = stringField(record.taskId);
+  const toolName = stringField(record.toolName);
+  const status = stringField(record.status);
+  const kind = resolveCompletedKind(record.taskKind, toolName);
+  if (!taskId || !toolName || !status || !kind) return undefined;
+  return {
+    taskId,
+    ...(stringField(record.toolCallId) ? { toolCallId: stringField(record.toolCallId) } : {}),
+    toolName, // required by resolveCompletedKind — never invent Bash/Agent/CreateWorkflow
+    taskKind: kind,
+    ...(kind === "subagent" && stringField(record.childSessionId)
+      ? { childSessionId: stringField(record.childSessionId) }
+      : {}),
+    cancellable: false,
+    ...(kind === "bash" && stringField(record.command)
+      ? { command: stringField(record.command) }
+      : {}),
+    ...(stringField(record.description) ? { description: stringField(record.description) } : {}),
+    status,
+    ...(kind === "bash" && numberField(record.pid) !== undefined
+      ? { pid: numberField(record.pid) }
+      : {}),
+    ...(dateIso(record.startedAt) ? { startedAt: dateIso(record.startedAt) } : {}),
+    ...(dateIso(record.completedAt) ? { completedAt: dateIso(record.completedAt) } : {}),
+    ...(stringField(record.outputPath) ? { outputPath: stringField(record.outputPath) } : {}),
+    ...(stringField(record.terminalId)
+      ? { terminalId: stringField(record.terminalId) }
+      : { terminalId: taskId }),
+  };
+}
+
+/** @deprecated Prefer durableBackgroundTaskCompletedPayload (bash + subagent + workflow). */
+export function durableBashBackgroundTaskCompletedPayload(
+  payload: unknown,
+): DurableBackgroundTaskCompletedPayload | undefined {
+  const durable = durableBackgroundTaskCompletedPayload(payload);
+  return durable?.taskKind === "bash" ? durable : undefined;
+}
+
+export function restoreDurableBackgroundTaskCompletedPayload(
+  value: unknown,
+): DurableBackgroundTaskCompletedPayload | undefined {
+  return durableBackgroundTaskCompletedPayload(value);
+}
+
+export async function persistBackgroundTaskCompletedEntry(input: {
+  sessionStore?: Pick<SessionStorePort, "saveSessionEntry">;
+  sessionId: SessionId;
+  event: SessionEvent;
+}): Promise<boolean> {
+  const store = input.sessionStore;
+  if (!store?.saveSessionEntry) return false;
+  if (input.event.type !== SessionEventType.BackgroundTaskCompleted) return false;
+  const durable = durableBackgroundTaskCompletedPayload(input.event.payload);
+  if (!durable) return false;
+  const completedMs = input.event.timestamp?.getTime?.() ?? Date.now();
+  const now = Date.now();
+  await store.saveSessionEntry({
+    id: backgroundTaskCompletedKey(durable.taskId),
+    sessionID: input.sessionId,
+    type: BACKGROUND_TASK_COMPLETED_SESSION_ENTRY,
+    touchSession: false,
+    time: {
+      created: Number.isFinite(completedMs) ? completedMs : now,
+      updated: now,
+    },
+    data: {
+      ...durable,
+      eventId: String(input.event.id),
+      sequenceNumber: input.event.sequenceNumber,
+      traceId: String(input.event.traceId),
+      ...(input.event.turnId ? { turnId: String(input.event.turnId) } : {}),
+    },
+  });
+  return true;
+}
+
+/**
+ * Cold projection honesty: Session background_task_completed → BackgroundTaskCompleted.
+ * Skips taskIds that already have a memory BackgroundTaskCompleted (live authority).
+ * Never invents running works and never starts a child.
+ */
+export function synthesizeBackgroundTaskEventsFromCompletedEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+}): SessionEvent[] {
+  const sessionId = String(input.sessionId);
+  const memoryTerminalTaskIds = new Set<string>();
+  for (const event of input.memoryEvents ?? []) {
+    if (event.type !== SessionEventType.BackgroundTaskCompleted) continue;
+    const taskId =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown }).taskId
+        : undefined;
+    if (typeof taskId === "string" && taskId.length > 0) {
+      memoryTerminalTaskIds.add(taskId);
+    }
+  }
+
+  const byTaskId = new Map<
+    string,
+    { durable: DurableBackgroundTaskCompletedPayload; created: number; traceId?: string }
+  >();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== BACKGROUND_TASK_COMPLETED_SESSION_ENTRY) continue;
+    const durable = restoreDurableBackgroundTaskCompletedPayload(entry.data);
+    if (!durable) continue;
+    const existing = byTaskId.get(durable.taskId);
+    const created = entry.time.created;
+    if (!existing || created >= existing.created) {
+      const data =
+        entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
+          ? (entry.data as Record<string, unknown>)
+          : {};
+      byTaskId.set(durable.taskId, {
+        durable,
+        created,
+        traceId: stringField(data.traceId),
+      });
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { durable, created, traceId } of byTaskId.values()) {
+    if (memoryTerminalTaskIds.has(durable.taskId)) continue;
+    const completedAt = durable.completedAt ? new Date(durable.completedAt) : new Date(created);
+    const startedAt = durable.startedAt ? new Date(durable.startedAt) : undefined;
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskCompleted,
+      sessionId as SessionId,
+      {
+        taskId: durable.taskId,
+        ...(durable.toolCallId ? { toolCallId: durable.toolCallId } : {}),
+        toolName: durable.toolName,
+        taskKind: durable.taskKind,
+        ...(durable.childSessionId ? { childSessionId: durable.childSessionId } : {}),
+        cancellable: false,
+        ...(durable.command ? { command: durable.command } : {}),
+        ...(durable.description ? { description: durable.description } : {}),
+        status: durable.status,
+        ...(durable.pid !== undefined ? { pid: durable.pid } : {}),
+        ...(startedAt && Number.isFinite(startedAt.getTime()) ? { startedAt } : {}),
+        completedAt,
+        ...(durable.outputPath ? { outputPath: durable.outputPath } : {}),
+        terminalId: durable.terminalId ?? durable.taskId,
+      },
+      {
+        traceId: (traceId ?? durable.traceId ?? "trace-background-task-completed") as never,
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = completedAt;
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
