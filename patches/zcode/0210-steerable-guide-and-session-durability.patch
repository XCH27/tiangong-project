+test("SQLite reopen: persist remote host stop receipt → cold backgroundWorks honesty", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-remote-host-stop-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+
+    await persistRemoteHostAttachmentStopReceipt({
+      sessionStore: store,
+      sessionId,
+      receipt: receipt({
+        reason: "transport_close",
+        targetKind: "docker",
+        linkedTasks: [
+          {
+            taskId: "bash-cold-1",
+            toolName: "Bash",
+            taskKind: "bash",
+            status: "cancelled",
+            description: "stopped when remote host detached",
+          },
+        ],
+      }),
