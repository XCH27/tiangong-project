+
+test("control.steerable omitted falls back to routing-only guide classify", () => {
+  const honesty = classifyNativeGuideHonestyFromSnapshotControl({
+    inputRouting: { mode: "guide" },
+  });
+  assert.equal(honesty, "steerable");
