+      source.memoryEvents.some((event) => event.type === SessionEventType.BackgroundTaskCompleted),
+      true,
+    );
+    const completed = source.memoryEvents.find(
+      (event) => event.type === SessionEventType.BackgroundTaskCompleted,
+    ) as SessionEvent;
+    assert.equal((completed.payload as { status: string }).status, "lost");
+    assert.equal(
+      restoreStoppedBashBackgroundTask(
+        (
+          await store.sessionEntries({
+            sessionID: sessionId,
+            type: BASH_STOP_SESSION_ENTRY,
+          })
+        )[0]?.data,
+      )?.task.status,
+      "lost",
+    );
+
+    const merged = mergeColdConversationEvents({
+      memoryEvents: source.memoryEvents,
+      messages: source.messages,
+      sessionId,
+    });
+    const projection = new ProductProjection(sessionId, "sqlite-cold");
+    for (const event of merged.events) {
+      projection.applyEventAtomically(event, () => true);
+    }
+    const works = projection.getSnapshot().backgroundWorks;
+    assert.equal(works.length, 1);
+    assert.equal(works[0]?.workId, "bash-proj-1");
+    assert.equal(works[0]?.kind, "bash");
+    // lost → projection failed bucket
+    assert.equal(works[0]?.status, "failed");
+    assert.notEqual(works[0]?.status, "running");
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
