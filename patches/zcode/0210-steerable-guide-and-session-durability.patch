+import {
+  SessionEventType,
+  createSessionEvent,
+  type SessionEvent,
+  type SessionId,
+  type SessionStorePort,
+} from "../deps.js";
+import { isColdNonDurableBackgroundToolName } from "./cold-runtime-task-durability.js";
+
+/**
+ * Durable live BackgroundTaskStarted transcript writes (bash + local_agent +
+ * journal-gated workflow).
+ *
+ * Emit path still publishes BackgroundTask* into the memory eventStore (MEMORY_ONLY
+ * for cold-merge of live memory events). This module additionally persists Bash and
+ * Agent (taskKind=subagent) BackgroundTaskStarted payloads as Session entries so cold
+ * materialization can keep backgroundWorks honest after eventStore loss when a task
+ * launched but never reached a durable terminal (Completed / bash_stop / subagent_stop).
+ *
+ * Workflow Started is Session-durable **only** when cold can gate on dwf journal
+ * non-terminal for the same runId (`listNonTerminalRuns` capability on the session
+ * store journal — pending/running after TERMINAL filter, same authority as orphan
+ * reconcile). Without that gate, persist is suppressed. Cold never synthesizes
+ * orphan→lost for workflow and never invents running (journal / workflowRuns owns
+ * non-terminal; Completed remains the Session terminal for backgroundWorks).
+ *
+ * Cold honesty (bash/subagent): orphan Started entries synthesize BackgroundTaskCompleted
+ * with status "lost" — never BackgroundTaskStarted / never invent running works
+ * (poller + child are gone after restart). BackgroundTaskUpdated Session persist is
+ * event-driven (cancelRequestedAt / blocked / blockedReason only — NOT 1s poll); cold
+ * never invents running from Updated (see background-task-updated-settlement.ts).
+ *
+ * Warm journal-gated workflow Started read (parallel to warm Updated overlay):
+ * when Session has journal-gated workflow Started and listNonTerminalRuns still
+ * reports the runId pending/running, synthesize BackgroundTaskStarted for panel —
+ * never invent when journal is absent/terminal/unavailable; never orphan→lost.
+ * Not a cold projector (absent from COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER).
+ *
+ * Explicitly not claimed: inventing running from Updated / using Updated as cold
+ * panel projector, inventing running works from Session Started alone (no journal
+ * non-terminal), multi-type reconstruct beyond registry, workflow orphan→lost,
+ * dedicated local_workflow / monitor_mcp Session reconstruct (non_durable; legacy
+ * Workflow toolName refused even when taskKind bash), Workflow Updated durability,
+ * or full removal of BackgroundTaskCompleted from MEMORY_ONLY. Bounded MEMORY_ONLY
+ * narrowing for durable Started ≺ Completed lives in cold-event-merge.
+ */
+export const BACKGROUND_TASK_STARTED_SESSION_ENTRY = "background_task_started" as const;
+
+/** Statuses listNonTerminalRuns may still return that are NOT true non-terminals. */
+export const WORKFLOW_JOURNAL_TERMINAL_STATUSES = new Set<string>([
+  "completed",
+  "errored",
+  "stopped",
+  // Physical encodings of errored/stopped that SQL prefilter may still surface.
+  "failed",
+  "cancelled",
+]);
+
+export type DurableBackgroundTaskStartedKind = "bash" | "subagent" | "workflow";
+
+export interface DurableBackgroundTaskStartedPayload {
+  taskId: string;
+  toolCallId?: string;
+  toolName: string;
+  taskKind: DurableBackgroundTaskStartedKind;
+  childSessionId?: string;
+  cancellable?: boolean;
+  command?: string;
+  description?: string;
+  status: "running";
+  pid?: number;
+  startedAt?: string;
+  outputPath?: string;
+  terminalId?: string;
+  eventId?: string;
+  sequenceNumber?: number;
+  traceId?: string;
+  turnId?: string;
+}
+
+export function backgroundTaskStartedKey(taskId: string): string {
+  return `background-task-started:${taskId}`;
+}
+
+function stringField(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function numberField(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function dateIso(value: unknown): string | undefined {
+  if (value instanceof Date && Number.isFinite(value.getTime())) return value.toISOString();
+  if (typeof value === "string" && value.length > 0) {
+    const parsed = new Date(value);
+    if (Number.isFinite(parsed.getTime())) return parsed.toISOString();
+  }
+  return undefined;
+}
+
+function isWorkflowStartedToolName(toolName: string | undefined): boolean {
+  return (
+    toolName === "CreateWorkflow" ||
+    toolName === "ResumeWorkflowRun" ||
+    toolName === "AmendWorkflow"
+  );
+}
+
+function resolveStartedKind(
+  _taskKind: unknown,
+  toolName: string | undefined,
+): DurableBackgroundTaskStartedKind | undefined {
+  // Registry non_durable rows: refuse Session persist even when live emit aliases bash.
+  if (isColdNonDurableBackgroundToolName(toolName)) return undefined;
+  // taskKind is panel decoration only (backgroundTaskKind); Session durability keys
+  // on real toolName — never invent Bash/Agent/CreateWorkflow from taskKind alone / missing toolName.
+  if (toolName === "Bash") return "bash";
+  if (toolName === "Agent" || toolName === "Task") return "subagent";
+  if (isWorkflowStartedToolName(toolName)) return "workflow";
+  return undefined;
+}
+
+/**
+ * Duck-type: session store journal exposes listNonTerminalRuns (SQLite host journal).
+ * Memory engine journals do not — workflow Started persist stays suppressed there.
+ */
+export function sessionStoreSupportsWorkflowStartedJournalGate(
+  sessionStore: unknown,
+): boolean {
+  const candidate = sessionStore as
+    | { workflowJournalStore?: () => unknown }
+    | null
+    | undefined;
+  if (typeof candidate?.workflowJournalStore !== "function") return false;
+  let journal: unknown;
+  try {
+    journal = candidate.workflowJournalStore();
+  } catch {
+    return false;
+  }
+  return (
+    typeof (journal as { listNonTerminalRuns?: unknown } | undefined)?.listNonTerminalRuns ===
+    "function"
+  );
+}
+
+/**
+ * True non-terminal runIds for parentSessionId — same semantics as host orphan
+ * reconcile: listNonTerminalRuns SQL is a prefilter; authority is pending/running
+ * (not completed/errored/stopped/failed/cancelled).
+ *
+ * Returns undefined when the journal gate is unavailable (caller must suppress persist).
+ */
+export function nonTerminalWorkflowRunIdsFromJournal(
+  sessionStore: unknown,
+  parentSessionId: string,
+): Set<string> | undefined {
+  if (!sessionStoreSupportsWorkflowStartedJournalGate(sessionStore)) return undefined;
+  const journal = (
+    sessionStore as { workflowJournalStore: () => { listNonTerminalRuns: (id: string) => unknown } }
+  ).workflowJournalStore();
+  let rows: unknown;
+  try {
+    rows = journal.listNonTerminalRuns(parentSessionId);
+  } catch {
+    return new Set();
+  }
+  const ids = new Set<string>();
+  if (!Array.isArray(rows)) return ids;
+  for (const row of rows) {
+    if (!row || typeof row !== "object" || Array.isArray(row)) continue;
+    const record = row as { runId?: unknown; status?: unknown };
+    const runId = stringField(record.runId);
+    const status = stringField(record.status);
+    if (!runId || !status) continue;
+    if (WORKFLOW_JOURNAL_TERMINAL_STATUSES.has(status)) continue;
+    // Align with listNonTerminalRuns + TERMINAL_RUN_STATUSES: only pending/running.
+    if (status !== "pending" && status !== "running") continue;
+    ids.add(runId);
+  }
+  return ids;
+}
+
+/**
+ * Real Bash + Agent/Task (subagent) + journal-gated dwf workflow launches are durable.
+ * Updated is separate (event-driven meaningful control only — see updated-settlement).
+ * Kind resolution keys on toolName only (taskKind is decorative). Legacy Workflow /
+ * Monitor stay non_durable (registry). Workflow Started persist still requires
+ * listNonTerminalRuns journal gate at write time; cold suppresses orphan→lost.
+ */
+export function durableBackgroundTaskStartedPayload(
+  payload: unknown,
+): DurableBackgroundTaskStartedPayload | undefined {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) return undefined;
+  const record = payload as Record<string, unknown>;
+  const taskId = stringField(record.taskId);
+  const toolName = stringField(record.toolName);
+  const kind = resolveStartedKind(record.taskKind, toolName);
+  if (!taskId || !toolName || !kind) return undefined;
+  // Live Started is always running; reject terminal masqueraders.
+  if (record.status !== undefined && record.status !== "running") return undefined;
+  return {
+    taskId,
+    ...(stringField(record.toolCallId) ? { toolCallId: stringField(record.toolCallId) } : {}),
+    toolName, // required by resolveStartedKind — never invent Bash/Agent/CreateWorkflow
+    taskKind: kind,
+    ...(kind === "subagent" && stringField(record.childSessionId)
+      ? { childSessionId: stringField(record.childSessionId) }
+      : {}),
+    ...(typeof record.cancellable === "boolean" ? { cancellable: record.cancellable } : {}),
+    ...(kind === "bash" && stringField(record.command)
+      ? { command: stringField(record.command) }
+      : {}),
+    ...(stringField(record.description) ? { description: stringField(record.description) } : {}),
+    status: "running",
+    ...(kind === "bash" && numberField(record.pid) !== undefined
+      ? { pid: numberField(record.pid) }
+      : {}),
+    ...(dateIso(record.startedAt) ? { startedAt: dateIso(record.startedAt) } : {}),
+    ...(stringField(record.outputPath) ? { outputPath: stringField(record.outputPath) } : {}),
+    ...(stringField(record.terminalId)
+      ? { terminalId: stringField(record.terminalId) }
+      : { terminalId: taskId }),
+  };
+}
+
+/** @deprecated Prefer durableBackgroundTaskStartedPayload (bash + subagent + workflow). */
+export function durableBashBackgroundTaskStartedPayload(
+  payload: unknown,
+): DurableBackgroundTaskStartedPayload | undefined {
+  const durable = durableBackgroundTaskStartedPayload(payload);
+  return durable?.taskKind === "bash" ? durable : undefined;
+}
+
+export function restoreDurableBackgroundTaskStartedPayload(
+  value: unknown,
+): DurableBackgroundTaskStartedPayload | undefined {
+  return durableBackgroundTaskStartedPayload(value);
+}
+
+export async function persistBackgroundTaskStartedEntry(input: {
+  sessionStore?: Pick<SessionStorePort, "saveSessionEntry"> & {
+    workflowJournalStore?: () => unknown;
+  };
+  sessionId: SessionId;
+  event: SessionEvent;
+}): Promise<boolean> {
+  const store = input.sessionStore;
+  if (!store?.saveSessionEntry) return false;
+  if (input.event.type !== SessionEventType.BackgroundTaskStarted) return false;
+  const durable = durableBackgroundTaskStartedPayload(input.event.payload);
+  if (!durable) return false;
+  // Workflow Started: persist only when cold can gate on journal non-terminal
+  // (listNonTerminalRuns). Else suppress — never write an entry that would tempt
+  // orphan→lost or invent running without journal authority.
+  if (
+    durable.taskKind === "workflow" &&
+    !sessionStoreSupportsWorkflowStartedJournalGate(store)
+  ) {
+    return false;
+  }
+  const startedMs = input.event.timestamp?.getTime?.() ?? Date.now();
+  const now = Date.now();
+  await store.saveSessionEntry({
+    id: backgroundTaskStartedKey(durable.taskId),
+    sessionID: input.sessionId,
+    type: BACKGROUND_TASK_STARTED_SESSION_ENTRY,
+    touchSession: false,
+    time: {
+      created: Number.isFinite(startedMs) ? startedMs : now,
+      updated: now,
+    },
+    data: {
+      ...durable,
+      eventId: String(input.event.id),
+      sequenceNumber: input.event.sequenceNumber,
+      traceId: String(input.event.traceId),
+      ...(input.event.turnId ? { turnId: String(input.event.turnId) } : {}),
+    },
+  });
+  return true;
+}
+
+function backgroundTaskIdsFromMemory(events: readonly SessionEvent[] | undefined): Set<string> {
+  const ids = new Set<string>();
+  for (const event of events ?? []) {
+    if (
+      event.type !== SessionEventType.BackgroundTaskStarted &&
+      event.type !== SessionEventType.BackgroundTaskUpdated &&
+      event.type !== SessionEventType.BackgroundTaskCompleted
+    ) {
+      continue;
+    }
+    const taskId =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown }).taskId
+        : undefined;
+    if (typeof taskId === "string" && taskId.length > 0) {
+      ids.add(taskId);
+    }
+  }
+  return ids;
+}
+
+/**
+ * Cold projection honesty: orphan Session background_task_started → lost Completed
+ * for bash/subagent only.
+ *
+ * Workflow Started orphans are **suppressed** (never lost / never invent running),
+ * aligned with listNonTerminalRuns semantics: when `nonTerminalWorkflowRunIds` contains
+ * the runId, journal still owns non-terminal; when absent/terminal, Completed or
+ * journal reconcile owns terminal — still never synthesize lost that would disagree.
+ */
+export function synthesizeLostBackgroundTaskEventsFromStartedEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+  /** True non-terminal runIds (pending/running) from listNonTerminalRuns semantics. */
+  nonTerminalWorkflowRunIds?: ReadonlySet<string>;
+}): SessionEvent[] {
+  const sessionId = String(input.sessionId);
+  const coveredTaskIds = backgroundTaskIdsFromMemory(input.memoryEvents);
+  // nonTerminalWorkflowRunIds is consulted for workflow suppress proof; absence still
+  // suppresses workflow orphans (never lost). Presence of runId documents journal gate.
+  const nonTerminalWorkflowRunIds = input.nonTerminalWorkflowRunIds;
+
+  const byTaskId = new Map<
+    string,
+    { durable: DurableBackgroundTaskStartedPayload; created: number; traceId?: string }
+  >();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== BACKGROUND_TASK_STARTED_SESSION_ENTRY) continue;
+    const durable = restoreDurableBackgroundTaskStartedPayload(entry.data);
+    if (!durable) continue;
+    const existing = byTaskId.get(durable.taskId);
+    const created = entry.time.created;
+    if (!existing || created >= existing.created) {
+      const data =
+        entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
+          ? (entry.data as Record<string, unknown>)
+          : {};
+      byTaskId.set(durable.taskId, {
+        durable,
+        created,
+        traceId: stringField(data.traceId),
+      });
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { durable, created, traceId } of byTaskId.values()) {
+    if (coveredTaskIds.has(durable.taskId)) continue;
+    // Journal-aligned workflow Started: never orphan→lost, never invent running.
+    // listNonTerminalRuns semantics: non-terminal runId → journal owns running;
+    // terminal/absent → Completed / reconcile owns terminal. Both paths suppress.
+    if (durable.taskKind === "workflow") {
+      const _journalOwnsNonTerminal = nonTerminalWorkflowRunIds?.has(durable.taskId) === true;
+      void _journalOwnsNonTerminal;
+      continue;
+    }
+    const startedAt = durable.startedAt ? new Date(durable.startedAt) : new Date(created);
+    const completedAt = new Date(created);
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskCompleted,
+      sessionId as SessionId,
+      {
+        taskId: durable.taskId,
+        ...(durable.toolCallId ? { toolCallId: durable.toolCallId } : {}),
+        toolName: durable.toolName,
+        taskKind: durable.taskKind,
+        ...(durable.childSessionId ? { childSessionId: durable.childSessionId } : {}),
+        cancellable: false,
+        ...(durable.command ? { command: durable.command } : {}),
+        ...(durable.description ? { description: durable.description } : {}),
+        status: "lost" as const,
+        ...(durable.pid !== undefined ? { pid: durable.pid } : {}),
+        ...(Number.isFinite(startedAt.getTime()) ? { startedAt } : {}),
+        completedAt,
+        ...(durable.outputPath ? { outputPath: durable.outputPath } : {}),
+        terminalId: durable.terminalId ?? durable.taskId,
+      },
+      {
+        traceId: (traceId ?? durable.traceId ?? "trace-background-task-started-lost") as never,
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = completedAt;
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
+
+/**
+ * Warm journal-gated workflow Started read — parallel to warm Updated overlay.
+ *
+ * Emits BackgroundTaskStarted from Session `background_task_started` **only** when
+ * `nonTerminalWorkflowRunIds` (listNonTerminalRuns pending|running semantics) contains
+ * the workflow runId and memory has no Started/Updated/Completed for that taskId.
+ * Journal absent / terminal / empty set → [] (never invents running / panel works).
+ * Bash/subagent Started stay on the cold orphan→lost path; this synthesizer is
+ * workflow-only. Not in `COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER`.
+ */
+export function synthesizeBackgroundTaskEventsFromJournalGatedWorkflowStartedEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+  /** True non-terminal runIds (pending/running) from listNonTerminalRuns semantics. */
+  nonTerminalWorkflowRunIds?: ReadonlySet<string>;
+}): SessionEvent[] {
+  const nonTerminal = input.nonTerminalWorkflowRunIds;
+  if (!nonTerminal || nonTerminal.size === 0) return [];
+
+  const sessionId = String(input.sessionId);
+  const coveredTaskIds = backgroundTaskIdsFromMemory(input.memoryEvents);
+
+  const byTaskId = new Map<
+    string,
+    { durable: DurableBackgroundTaskStartedPayload; created: number; traceId?: string }
+  >();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== BACKGROUND_TASK_STARTED_SESSION_ENTRY) continue;
+    const durable = restoreDurableBackgroundTaskStartedPayload(entry.data);
+    if (!durable || durable.taskKind !== "workflow") continue;
+    if (!nonTerminal.has(durable.taskId)) continue;
+    if (coveredTaskIds.has(durable.taskId)) continue;
+    const existing = byTaskId.get(durable.taskId);
+    const created = entry.time.created;
+    if (!existing || created >= existing.created) {
+      const data =
+        entry.data && typeof entry.data === "object" && !Array.isArray(entry.data)
+          ? (entry.data as Record<string, unknown>)
+          : {};
+      byTaskId.set(durable.taskId, {
+        durable,
+        created,
+        traceId: stringField(data.traceId),
+      });
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { durable, created, traceId } of byTaskId.values()) {
+    const startedAt = durable.startedAt ? new Date(durable.startedAt) : new Date(created);
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskStarted,
+      sessionId as SessionId,
+      {
+        taskId: durable.taskId,
+        ...(durable.toolCallId ? { toolCallId: durable.toolCallId } : {}),
+        toolName: durable.toolName,
+        taskKind: durable.taskKind,
+        ...(typeof durable.cancellable === "boolean" ? { cancellable: durable.cancellable } : {}),
+        ...(durable.description ? { description: durable.description } : {}),
+        status: "running" as const,
+        ...(Number.isFinite(startedAt.getTime()) ? { startedAt } : {}),
+        ...(durable.outputPath ? { outputPath: durable.outputPath } : {}),
+        terminalId: durable.terminalId ?? durable.taskId,
+      },
+      {
+        traceId: (traceId ?? durable.traceId ?? "trace-background-task-started-warm-journal") as never,
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = Number.isFinite(startedAt.getTime()) ? startedAt : new Date(created);
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
