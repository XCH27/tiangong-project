+      parentSessionId: sessionId,
+      parentToolCallId: `tool-${taskId}`,
+      prompt: "sleep 30",
+      startedAt,
+      status,
+      taskId,
+      taskType: "local_bash" as const,
+      type: "local_bash" as const,
+      traceContext,
+    },
+    totalDurationMs: 5000,
+    traceContext,
+  };
+}
+
+function agentStop(taskId: string, complete = true): StoppedBackgroundAgentTask {
+  const startedAt = new Date("2026-10-10T20:03:00.000Z");
+  const completedAt = new Date("2026-10-10T20:03:08.000Z");
+  const traceContext = createRootTraceContext({ sessionId });
+  return {
+    task: {
+      agentId: taskId,
+      agentType: "general-purpose",
+      branchGeneration: 0,
+      childSessionId: `child-${taskId}` as never,
