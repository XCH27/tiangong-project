diff --git a/apps/zcode-cli/packages/bootstrap/test/session-control-steerable.test.ts b/apps/zcode-cli/packages/bootstrap/test/session-control-steerable.test.ts
new file mode 100644
index 00000000..072d045a
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/session-control-steerable.test.ts
@@ -0,0 +1,257 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { sessionControlSchema } from "@zcode/shared/zcode-protocol-v4";
+import {
+  computeInputRouting,
+  createInitialConversationSnapshot,
+} from "../src/zcode-protocol-v4/projection-state.js";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+
+test("initial snapshot control.steerable is false (no Ready invent)", () => {
+  const snapshot = createInitialConversationSnapshot("session-1", "epoch-1");
+  assert.equal(snapshot.control.steerable, false);
+  assert.equal(snapshot.control.canStop, false);
+  assert.equal(snapshot.control.phase, "draft");
+});
+
+test("sessionControlSchema requires steerable boolean (composer honesty contract)", () => {
+  const parsed = sessionControlSchema.parse({
+    phase: "running",
+    sessionEnded: false,
+    canStop: true,
+    stopState: "stoppable",
+    stopTargetKind: "assistant",
+    steerable: true,
+    activeWorks: [{ kind: "primaryTurn", startedAt: 1 }],
+    lastError: null,
+    apiRetry: null,
+  });
+  assert.equal(parsed.steerable, true);
+
+  assert.throws(() =>
+    sessionControlSchema.parse({
+      phase: "running",
+      sessionEnded: false,
+      canStop: true,
+      stopState: "stoppable",
+      stopTargetKind: "assistant",
+      // steerable omitted — required for composer-facing honesty
+      activeWorks: [],
+      lastError: null,
+      apiRetry: null,
+    }),
+  );
+});
+
+test("steerable true is not product Ready — schema is a boolean gate only", () => {
+  const parsed = sessionControlSchema.parse({
+    phase: "running",
+    sessionEnded: false,
+    canStop: true,
+    stopState: "stoppable",
+    stopTargetKind: "assistant",
+    steerable: true,
+    activeWorks: [],
+    lastError: null,
+    apiRetry: null,
+  });
+  // Contract: field name is steerable, never Ready/usable.
+  assert.equal("steerable" in parsed, true);
+  assert.equal("Ready" in parsed, false);
+  assert.equal("usable" in parsed, false);
+});
+
+function projectionFixture() {
+  const projection = new ProductProjection("steer-session", "steer-epoch");
+  let sequence = 0;
+  const send = (type: SessionEvent["type"], payload: unknown) => {
+    const event = {
+      id: `event-${++sequence}`,
+      sessionId: "steer-session",
+      turnId: "turn-1",
+      traceId: "steer-trace",
+      sequenceNumber: sequence,
+      timestamp: new Date(1000 + sequence),
+      type,
+      payload,
+    } as SessionEvent;
+    projection.applyEventAtomically(event, () => true);
+    return event;
+  };
+  return { projection, send };
+}
+
+test("TurnStarted steerable:true projects control.steerable (≠ Ready)", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: true,
+  });
+  const snap = projection.getSnapshot();
+  assert.equal(snap.control.steerable, true);
+  assert.equal(snap.control.phase, "running");
+  assert.equal(snap.control.activeWorks.length > 0, true);
+  assert.equal("Ready" in snap.control, false);
+  assert.equal("usable" in snap.control, false);
+});
+
+test("live mid-turn TurnSteerableChanged clears control.steerable before TurnComplete", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: true,
+  });
+  assert.equal(projection.getSnapshot().control.steerable, true);
+
+  // Mid-turn clear (emit path from clearActiveTurnSteerable) — turn still running.
+  send(SessionEventType.TurnSteerableChanged, { steerable: false });
+  const mid = projection.getSnapshot();
+  assert.equal(mid.control.steerable, false);
+  assert.equal(mid.control.phase, "running");
+  assert.equal(mid.control.activeWorks.length > 0, true);
+  assert.equal("Ready" in mid.control, false);
+  assert.equal("usable" in mid.control, false);
+
+  // TurnComplete still settles; steerable stays false (no Ready invent).
+  send(SessionEventType.TurnComplete, {
+    response: "done",
+    tokenCount: 0,
+    toolCallCount: 0,
+    duration: 1,
+    resultType: "success",
+  });
+  const terminal = projection.getSnapshot();
+  assert.equal(terminal.control.steerable, false);
+});
+
+test("TurnSteerableChanged cannot invent steerable true / Ready mid-turn", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: false,
+  });
+  assert.equal(projection.getSnapshot().control.steerable, false);
+
+  // Malicious / mistaken true mid-turn must not open Guide honesty bit.
+  send(SessionEventType.TurnSteerableChanged, { steerable: true });
+  const snap = projection.getSnapshot();
+  assert.equal(snap.control.steerable, false);
+  assert.equal("Ready" in snap.control, false);
+  assert.equal("usable" in snap.control, false);
+});
+
+
+function routingContext(
+  overrides: Partial<{
+    phase: "draft" | "prewarming" | "running" | "completedSuccess" | "completedInterrupted";
+    steerable: boolean;
+    compacting: boolean;
+    goalVerifying: boolean;
+    queueLength: number;
+    autoDrain: boolean;
+  }> = {},
+) {
+  return {
+    phase: "running" as const,
+    goalStatus: null,
+    compacting: false,
+    goalVerifying: false,
+    queueLength: 0,
+    autoDrain: true,
+    steerable: false,
+    ...overrides,
+  };
+}
+
+test("computeInputRouting: guide + steerable true → guide (≠ Ready)", () => {
+  const routing = computeInputRouting(routingContext({ steerable: true }), "guide");
+  assert.equal(routing.mode, "guide");
+  assert.equal(routing.reasonCode, undefined);
+  assert.equal("Ready" in routing, false);
+});
+
+test("computeInputRouting: guide + steerable false → enqueue turn_not_steerable (no Ready invent)", () => {
+  const routing = computeInputRouting(routingContext({ steerable: false }), "guide");
+  assert.equal(routing.mode, "enqueue");
+  assert.equal(routing.reasonCode, "turn_not_steerable");
+  assert.equal("Ready" in routing, false);
+  assert.equal("usable" in routing, false);
+});
+
+test("computeInputRouting: queue followup ignores steerable (stays enqueue)", () => {
+  assert.equal(
+    computeInputRouting(routingContext({ steerable: true }), "queue").mode,
+    "enqueue",
+  );
+  assert.equal(
+    computeInputRouting(routingContext({ steerable: false }), "queue").mode,
+    "enqueue",
+  );
+});
+
+test("computeInputRouting: prewarming + guide prefers steerable bit", () => {
+  assert.equal(
+    computeInputRouting(routingContext({ phase: "prewarming", steerable: true }), "guide").mode,
+    "guide",
+  );
+  const closed = computeInputRouting(
+    routingContext({ phase: "prewarming", steerable: false }),
+    "guide",
+  );
+  assert.equal(closed.mode, "enqueue");
+  assert.equal(closed.reasonCode, "turn_not_steerable");
+});
+
+test("TurnStarted steerable + followup guide projects inputRouting.guide", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.FollowupModeChanged, { mode: "guide" });
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: true,
+  });
+  const snap = projection.getSnapshot();
+  assert.equal(snap.config.followupMode, "guide");
+  assert.equal(snap.control.steerable, true);
+  assert.equal(snap.inputRouting.mode, "guide");
+  assert.equal("Ready" in snap.control, false);
+});
+
+test("mid-turn steerable clear flips inputRouting guide → enqueue (prefer control.steerable)", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.FollowupModeChanged, { mode: "guide" });
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: true,
+  });
+  assert.equal(projection.getSnapshot().inputRouting.mode, "guide");
+
+  send(SessionEventType.TurnSteerableChanged, { steerable: false });
+  const mid = projection.getSnapshot();
+  assert.equal(mid.control.steerable, false);
+  assert.equal(mid.control.phase, "running");
+  assert.equal(mid.config.followupMode, "guide");
+  assert.equal(mid.inputRouting.mode, "enqueue");
+  assert.equal(mid.inputRouting.reasonCode, "turn_not_steerable");
+  assert.equal("Ready" in mid.control, false);
+  assert.equal("usable" in mid.control, false);
+});
+
+test("TurnStarted steerable false + followup guide does not advertise guide routing", () => {
+  const { projection, send } = projectionFixture();
+  send(SessionEventType.FollowupModeChanged, { mode: "guide" });
+  send(SessionEventType.TurnStarted, {
+    input: "hello",
+    messageId: "user-1",
+    steerable: false,
+  });
+  const snap = projection.getSnapshot();
+  assert.equal(snap.control.steerable, false);
+  assert.equal(snap.inputRouting.mode, "enqueue");
+  assert.equal(snap.inputRouting.reasonCode, "turn_not_steerable");
+});
diff --git a/apps/zcode-cli/packages/bootstrap/test/session-shutdown.test.ts b/apps/zcode-cli/packages/bootstrap/test/session-shutdown.test.ts
new file mode 100644
index 00000000..f295526b
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/session-shutdown.test.ts
@@ -0,0 +1,180 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { DatabaseSync } from "node:sqlite";
+import { join } from "node:path";
+import { readFile, rm } from "node:fs/promises";
+import { fixture, reply, selection } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { lateReceiptFixture } from "../../core/test/helpers/late-tool-receipt-fixture.js";
+import { createSessionFacade, DEFAULT_SESSION_RESOURCE_CLOSE_TIMEOUT_MS } from "../src/app/session-facade.js";
+import { createInputFacade } from "../src/app/input-facade.js";
+import { ProtocolRuntimeResources } from "../src/zcode-protocol/runtime-resources.js";
+import { cleanupProtocolRuntime } from "../src/zcode-protocol/runtime-cleanup.js";
+
+const logger = { info() {}, warn() {}, debug() {} };
+function publicHost(f: Awaited<ReturnType<typeof fixture>>, ownsStore = true) {
+  let closes = 0;
+  const closeStore = f.store.close.bind(f.store);
+  f.store.close = () => { closes++; closeStore(); };
+  const facade = createSessionFacade({
+    runtime: f.runtime, sessionId: "session", sessionStore: f.store, ownsSessionStore: ownsStore,
+    configResult: {config:{ui:{locale:"en-US"}}}, traceContext: (f.runtime as any).rootTraceContext, logger,
+  } as never);
+  const input = createInputFacade({
+    runtime: f.runtime, sessionId: "session", prepareUserExecutionBoundary: async () => {},
+    traceContext: (f.runtime as any).rootTraceContext, logger,
+  } as never);
+  return { app: {...facade, ...input, runtime:f.runtime, sessionId:"session"} as any, input, get closes() {return closes;} };
+}
+async function dispose(f: Awaited<ReturnType<typeof fixture>>, closed: boolean) {
+  if (closed) await rm(f.dir,{recursive:true,force:true});
+  else await f.close();
+}
+const nextTick = () => new Promise<void>(resolve => setImmediate(resolve));
+function rows(f: Awaited<ReturnType<typeof fixture>>, query: string) {
+  const db = new DatabaseSync(join(f.dir,"session.sqlite"),{readOnly:true});
+  try {return db.prepare(query).all();} finally {db.close();}
+}
+
+test("protocol close joins the original foreground response and retains returned usage before SQLite close", async () => {
+  const f = await fixture("pi"); const h = publicHost(f);
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const resources = new ProtocolRuntimeResources(async () => h.app);
+  await resources.create({} as never);
+  let turn: Promise<unknown> | undefined;
+  try {
+    f.steps.push(async () => {entered.resolve(); await release.promise; return {...reply("received at shutdown"),usage:{inputTokens:321,outputTokens:12,totalTokens:333}};});
+    const admission = await h.input.sendInput({text:"Slow request"},{inputId:"first"});
+    assert.equal(admission.kind,"started_turn"); if (admission.kind !== "started_turn") return;
+    turn = admission.completion;
+    const outcome = turn.catch(e => e.message);
+    await entered.promise;
+    const a = resources.close(), b = resources.close();
+    assert.equal(a,b);
+    await nextTick();
+    assert.equal(h.closes,0);
+    assert.ok(f.runtime.getActiveForegroundExecutionId());
+    release.resolve();
+    assert.equal(await outcome,"Turn was cancelled.");
+    await a;
+    assert.equal(h.closes,1);
+    assert.deepEqual(rows(f,"select status,input_tokens,output_tokens from model_usage").map(row => ({...row})),[{status:"cancelled",input_tokens:321,output_tokens:12}]);
+    await h.app.close();
+    assert.equal(h.closes,1);
+  } finally {release.resolve(); await turn?.catch(()=>{}); await dispose(f,h.closes>0);}
+});
+
+for (const mode of ["build", "auto"] as const) test(`shutdown preserves accepted FIFO ${mode} binding without dispatch or cold replay`, async () => {
+  const f = await fixture("pi",false,{config:{mode}}), h = publicHost(f,false);
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  let first: Promise<unknown> | undefined, queued: Promise<unknown> | undefined;
+  try {
+    f.steps.push(async () => {entered.resolve(); await release.promise; return reply("first late response");});
+    first = h.input.submitPrompt("first"); const firstOutcome = first.catch(e => e.message);
+    await entered.promise;
+    queued = h.input.submitPrompt({text:"queued original",attachments:[{type:"file",path:"/fixture/original.txt",filename:"original.txt"}]} as never,{inputId:"queued-original"});
+    const queuedOutcome = queued.catch(e => e.message);
+    await nextTick();
+    f.runtime.setSessionModelSelection(selection("later-model"));
+    f.runtime.beginShutdown();
+    await assert.rejects(h.input.sendInput({text:"new after shutdown"}), /cancelled/);
+    await assert.rejects(h.input.submitPrompt("new ordinary command"), /cancelled/);
+    await assert.rejects(f.runtime.steerTurn("new Guide"), /cancelled/);
+    await assert.rejects(f.runtime.enqueueDeferredInput("new queue"), /cancelled/);
+    assert.equal(await queuedOutcome,"Turn was cancelled.");
+    const saved = await f.store.getSessionInputById("queued-original");
+    assert.equal(saved?.status,"admitted");
+    const payload = saved!.payload as any;
+    assert.equal(payload.text,"queued original");
+    assert.equal(payload.intent.modelSelection.modelId,"model-a");
+    assert.equal(payload.intent.mode,mode === "auto" ? undefined : mode);
+    assert.equal(payload.executionState.mode,mode);
+    assert.equal(payload.attachments[0].path,"/fixture/original.txt");
+    release.resolve();
+    assert.equal(await firstOutcome,"Turn was cancelled.");
+    await h.app.close();
+    assert.equal(f.requests.length,1);
+    await f.reopen();
+    const restored = await f.store.getSessionInputById("queued-original");
+    assert.equal(restored?.status,"discarded");
+    assert.deepEqual(restored?.payload,saved?.payload);
+    assert.equal(f.requests.length,1,"cold recovery never infers from the preserved input");
+  } finally {release.resolve(); await first?.catch(()=>{}); await queued?.catch(()=>{}); await f.close();}
+});
+
+test("App close joins a late tool after foreground ends and records its known result exactly once", async () => {
+  const f = await lateReceiptFixture(); const h = publicHost(f);
+  try {
+    assert.equal(f.runtime.getActiveForegroundExecutionId(),undefined);
+    assert.equal(f.runtime.hasResidencyBlockingWork(),true);
+    const close = h.app.close(); const actual = h.app.waitForClose();
+    assert.equal(actual,h.app.waitForClose());
+    await nextTick();
+    assert.equal(h.closes,0);
+    assert.equal(await readFile(join(f.dir,"late-effect.txt"),"utf8"),"committed exactly once");
+    await f.settled();
+    await close;
+    assert.equal(h.closes,1);
+    assert.deepEqual(f.failures,[]);
+    assert.equal(f.facts()[0].status,"completed");
+    assert.equal(f.effects,1);
+    assert.equal(rows(f,"select count(*) as count from session_entry where type = 'runtime/late_tool_settlement'")[0]!.count,1);
+    await h.app.close();
+    assert.equal(h.closes,1);
+  } finally {
+    f.finish.resolve();
+    if (h.closes>0) f.store.close = () => {};
+    await f.close();
+  }
+});
+
+test("the existing close deadline rejects incomplete acknowledgement while the same cleanup remains owned", async () => {
+  const f = await fixture("pi"), h = publicHost(f);
+  const release = Promise.withResolvers<void>();
+  const owned = f.runtime.trackResidencyBlockingWork(release.promise);
+  try {
+    assert.equal(DEFAULT_SESSION_RESOURCE_CLOSE_TIMEOUT_MS,6000);
+    const closing = h.app.close();
+    const actual = h.app.waitForClose();
+    await assert.rejects(closing, (error:any) => error.code === "session_close_incomplete");
+    assert.equal(h.closes,0);
+    await f.store.getSession("session" as never); // still an open database
+    release.resolve(); await owned; await actual;
+    await h.app.close(); assert.equal(h.closes,1);
+  } finally {release.resolve(); await dispose(f,h.closes>0);}
+});
+
+test("outer cleanup keeps shared SQLite and dependent resources through a delayed App factory", async () => {
+  const f = await fixture("pi"), h = publicHost(f,false);
+  const factoryEntered = Promise.withResolvers<void>(), factoryRelease = Promise.withResolvers<void>();
+  const workRelease = Promise.withResolvers<void>();
+  const owned = f.runtime.trackResidencyBlockingWork(workRelease.promise);
+  const resources = new ProtocolRuntimeResources(async () => {factoryEntered.resolve(); await factoryRelease.promise; return h.app;});
+  const creating = resources.create({} as never);
+  const createOutcome = creating.catch(e => e.message);
+  let sharedCloses = 0, mcpCloses = 0, projections = 0;
+  const original = f.store.close.bind(f.store);
+  f.store.close = () => {sharedCloses++; original();};
+  const server = {shutdown:()=>resources.close(),disposeProjections:()=>{projections++;}};
+  try {
+    await factoryEntered.promise;
+    await assert.rejects(cleanupProtocolRuntime({logger,server,sessionStore:f.store,mcpPort:{close:async()=>{mcpCloses++;}},deadlineAt:Date.now()+30}),/incomplete/);
+    assert.equal(sharedCloses,0); assert.equal(mcpCloses,0); assert.equal(projections,0);
+    const actual = resources.close(); assert.equal(actual,resources.close());
+    factoryRelease.resolve(); await nextTick();
+    assert.equal(sharedCloses,0,"a returned late App still owns its receipt work");
+    workRelease.resolve(); await owned;
+    assert.match(await createOutcome,/stopping/);
+    await actual;
+    for (let i=0;i<50 && sharedCloses===0;i++) await nextTick();
+    assert.equal(sharedCloses,1); assert.equal(mcpCloses,1); assert.equal(projections,1);
+    await resources.close(); assert.equal(sharedCloses,1);
+  } finally {factoryRelease.resolve(); workRelease.resolve(); await createOutcome; await dispose(f,sharedCloses>0);}
+});
+
+test("a failed cleanup owner reports failure and preserves the shared database", async () => {
+  const f = await fixture("pi");
+  try {
+    await assert.rejects(cleanupProtocolRuntime({logger,sessionStore:f.store,server:{shutdown:async()=>{throw Error("termination unconfirmed");},disposeProjections(){}},deadlineAt:Date.now()+100}),/incomplete/);
+    await f.store.getSession("session" as never);
+  } finally {await f.close();}
+});
