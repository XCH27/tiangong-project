+} from "../src/runtime/methods/remote-host-attachment-stop-settlement.js";
+
+const sessionId = "remote-host-stop-parent" as never;
+
+function receipt(
+  overrides?: Partial<RemoteHostAttachmentStopReceipt>,
+): RemoteHostAttachmentStopReceipt {
+  return {
+    remoteSessionId: "remote-session-1",
+    reason: "session_detach",
+    targetKind: "wsl",
+    attachmentIds: ["renderer-a"],
+    stoppedAt: Date.parse("2026-10-10T23:00:00.000Z"),
