--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/mcp-process-tree.test.ts
@@ -0,0 +1,109 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { terminateMcpStdioProcessTree } from "../src/mcp/process-tree.js";
+
+test("Windows Stop issues taskkill /T /F against the owned root when it is alive", async () => {
+  const commands: Array<{ file: string; args: readonly string[] }> = [];
+  const alive = new Set([4242]);
+  await terminateMcpStdioProcessTree(4242, {
+    platform: "win32",
+    kill(pid, signal) {
+      if (signal === 0) {
+        if (!alive.has(pid)) {
+          const error = new Error("ESRCH") as NodeJS.ErrnoException;
+          error.code = "ESRCH";
+          throw error;
+        }
+        return true;
+      }
+      throw new Error(`unexpected kill signal ${String(signal)}`);
+    },
+    async execFile(file, args) {
+      commands.push({ file, args: [...args] });
+      assert.equal(file, "taskkill");
+      assert.deepEqual(args, ["/PID", "4242", "/T", "/F"]);
+      alive.delete(4242);
+      return { status: 0, stdout: "", stderr: "" };
+    },
+  });
+  assert.deepEqual(commands, [{ file: "taskkill", args: ["/PID", "4242", "/T", "/F"] }]);
+});
+
+test("Windows Stop skips taskkill when the owned root has already exited", async () => {
+  let execCalls = 0;
+  await terminateMcpStdioProcessTree(77, {
+    platform: "win32",
+    kill() {
+      const error = new Error("ESRCH") as NodeJS.ErrnoException;
+      error.code = "ESRCH";
+      throw error;
+    },
+    async execFile() {
+      execCalls += 1;
+      return { status: 0, stdout: "", stderr: "" };
+    },
+  });
+  assert.equal(execCalls, 0);
+});
+
+test("Windows Stop fails closed when taskkill errors and the root remains alive", async () => {
+  await assert.rejects(
+    () =>
+      terminateMcpStdioProcessTree(9, {
+        platform: "win32",
+        kill() {
+          return true;
+        },
+        async execFile() {
+          return {
+            error: new Error("taskkill denied"),
+            status: 1,
+            stdout: "",
+            stderr: "Access denied",
+          };
+        },
+      }),
+    /taskkill failed for MCP stdio process tree pid=9/,
+  );
+});
+
+test("POSIX Stop escalates SIGINT → SIGTERM → SIGKILL across the owned tree", async () => {
+  const signals: Array<{ pid: number; signal: NodeJS.Signals | number }> = [];
+  const alive = new Set([100, 101]);
+  let now = 0;
+  await terminateMcpStdioProcessTree(100, {
+    platform: "linux",
+    now: () => now,
+    async sleep(ms) {
+      now += ms;
+    },
+    kill(pid, signal) {
+      if (signal === 0) {
+        if (!alive.has(Math.abs(pid))) {
+          const error = new Error("ESRCH") as NodeJS.ErrnoException;
+          error.code = "ESRCH";
+          throw error;
+        }
+        return true;
+      }
+      signals.push({ pid, signal: signal as NodeJS.Signals });
+      if (signal === "SIGKILL") alive.delete(Math.abs(pid));
+      return true;
+    },
+    async execFile(file, args) {
+      if (file === "pgrep" && args[0] === "-P" && args[1] === "100") {
+        return { status: 0, stdout: "101\n", stderr: "" };
+      }
+      if (file === "pgrep") {
+        return { status: 1, stdout: "", stderr: "" };
+      }
+      return { status: 0, stdout: "", stderr: "" };
+    },
+  });
+  assert.ok(signals.some((entry) => entry.pid === -100 && entry.signal === "SIGINT"));
+  assert.ok(signals.some((entry) => entry.pid === 101 && entry.signal === "SIGINT"));
+  assert.ok(signals.some((entry) => entry.pid === 100 && entry.signal === "SIGINT"));
+  assert.ok(signals.some((entry) => entry.signal === "SIGTERM"));
+  assert.ok(signals.some((entry) => entry.signal === "SIGKILL"));
+  assert.equal(alive.size, 0);
+});
