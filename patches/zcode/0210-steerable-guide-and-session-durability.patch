+test("Pi HTTP-attempt admission holds the ticket until the durable request finishes", { timeout: 10000 }, async () => {
+  const gate = Promise.withResolvers<void>();
+  let admitted = 0;
+  let released = 0;
+  let heldDuringRequest = false;
+  const f = await fixture("pi", true, {
+    deps: {
+      modelRequestAdmission: {
+        tryAcquire() {
+          return undefined;
+        },
+        async acquire() {
+          await gate.promise;
+          admitted++;
+          return {
+            publish: async () => {},
+            release() {
+              released++;
+            },
+          };
+        },
+      },
+    },
+  });
+  try {
+    f.steps.push(() => {
+      heldDuringRequest = admitted === 1 && released === 0;
+      return reply("Admitted durable answer");
+    });
+    const running = f.runtime.executeTurn("Admit before the physical request");
+    await Promise.resolve();
+    assert.equal(f.requests.length, 0, "Physical inference started before the admission ticket");
+    assert.equal(admitted, 0);
+    gate.resolve();
+    assert.equal((await running).response, "Admitted durable answer");
+    assert.equal(admitted, 1);
+    assert.equal(released, 1, "Admission ticket survived past the durable request");
+    assert.equal(heldDuringRequest, true, "Ticket was released before the physical request finished");
+    assert.equal(f.requests.length, 1);
+    const db = new DatabaseSync(join(f.dir, "session.sqlite"), { readOnly: true });
+    try {
+      const row = db.prepare("select status, input_tokens, output_tokens from model_usage").get() as any;
+      assert.equal(row.status, "completed");
+      assert.equal(row.input_tokens, 100);
+      assert.equal(row.output_tokens, 10);
+    } finally {
+      db.close();
+    }
+  } finally {
+    gate.resolve();
+    await f.close();
+  }
+});
+
+test("native-style observer-only admission never blocks Pi, while enforced gates still hold", { timeout: 10000 }, async () => {
+  let observerAcquires = 0;
+  const f = await fixture("pi", false, {
+    deps: {
+      modelRequestAdmission: {
+        observerOnly: true as const,
+        tryAcquire({ model }) {
+          observerAcquires++;
+          assert.equal(model.providerId, "fixture");
+          return {
+            publish: async () => {},
+            release() {},
+          };
+        },
+        async acquire() {
+          throw new Error("observer-only must not queue");
+        },
+      },
+    },
+  });
+  try {
+    f.steps.push(() => reply("observer path"));
+    assert.equal((await f.runtime.executeTurn("Observer does not enforce HTTP slots")).response, "observer path");
+    assert.equal(observerAcquires, 1);
+    assert.equal(f.requests.length, 1);
+  } finally {
+    await f.close();
+  }
+});
