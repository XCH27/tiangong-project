+      taskId: "bash-1",
+      toolName: "Bash",
+      taskKind: "bash",
+      status: "completed",
+    })?.taskKind,
+    "bash",
+  );
+});
+
+test("bash-kind alias honesty: only real Bash/Agent|Task/dwf toolNames are Session-durable", () => {
+  // Decorative taskKind alone must not invent Bash durability.
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "alias-1",
+      taskKind: "bash",
+      status: "running",
+    }),
+    undefined,
+  );
+  assert.equal(
+    durableBackgroundTaskCompletedPayload({
+      taskId: "alias-2",
+      taskKind: "bash",
+      status: "completed",
+    }),
+    undefined,
+  );
+  // Foreign toolName + bash decoration must not piggyback.
+  assert.equal(
+    durableBackgroundTaskCompletedPayload({
+      taskId: "alias-3",
+      toolName: "Shell",
+      taskKind: "bash",
+      status: "completed",
+    }),
+    undefined,
+  );
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "alias-4",
+      toolName: "Echo",
+      taskKind: "bash",
+      status: "running",
+    }),
+    undefined,
+  );
+  // taskKind subagent / workflow alone must not invent Agent / CreateWorkflow.
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "alias-5",
+      taskKind: "subagent",
+      status: "running",
+    }),
+    undefined,
+  );
+  assert.equal(
+    durableBackgroundTaskCompletedPayload({
+      taskId: "alias-6",
+      taskKind: "workflow",
+      status: "completed",
+    }),
+    undefined,
+  );
+  // Real Bash toolName still durable (taskKind optional).
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "bash-real",
+      toolName: "Bash",
+      status: "running",
+    })?.taskKind,
+    "bash",
+  );
+  assert.equal(
+    durableBackgroundTaskCompletedPayload({
+      taskId: "bash-real-c",
+      toolName: "Bash",
+      status: "completed",
+    })?.toolName,
+    "Bash",
+  );
+  // Agent + Claude Code Task alias are real subagent dispatch names.
+  assert.equal(
+    durableBackgroundTaskStartedPayload({
+      taskId: "agent-real",
+      toolName: "Agent",
+      status: "running",
+      childSessionId: "child-a",
+    })?.taskKind,
+    "subagent",
