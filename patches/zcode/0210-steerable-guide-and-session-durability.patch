+/**
+ * Live mid-turn clear of `activeTurn.steerable` onto v4 `control.steerable`
+ * before TurnComplete (composer honesty; steerable ≠ Ready).
+ *
+ * Admission already reads the in-memory bit; without this event the snapshot
+ * control lag stays true until TurnComplete / empty activeWorks. Clear-only:
+ * inventing `steerable: true` mid-turn via this path is refused — TurnStarted
+ * remains the sole open signal.
+ */
+import { SessionEventType } from "../deps.js";
+import type { TraceContext } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import type { ActiveTurnSteeringState } from "../types.js";
+
+export async function clearActiveTurnSteerable(
+  runtime: AgentRuntimeInternal,
+  activeTurn: ActiveTurnSteeringState | undefined,
+  traceContext: TraceContext,
+): Promise<void> {
+  if (!activeTurn || activeTurn.steerable !== true) {
+    if (activeTurn) activeTurn.steerable = false;
+    return;
+  }
+  activeTurn.steerable = false;
+  const event = runtime.createEvent(
+    SessionEventType.TurnSteerableChanged,
+    // Clear-only: never invent steerable open / Ready from this event.
+    { steerable: false },
+    traceContext,
+  );
+  await runtime.appendEvent(event, traceContext);
+}
