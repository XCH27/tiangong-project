+/**
+ * Project Setting-owner values onto Settings/page-Agent UI controls.
+ * Memory enablement, Appearance code-preview line prefs, and General leaves
+ * that page-Agent already writes share this mapping so the UI reflects writer results.
+ */
+import type { AppSettings, ZCodeInteractionBehavior } from "@zcode/shared";
+import { codePreviewLinePrefsFromSettings } from "./codePreviewLinePrefsSettings.js";
+
+export type PageAssistantSettingUiReflection = {
+  memoryEnabled: boolean;
+  nativeSearchEnhancementsEnabled: boolean;
+  askUserQuestionAutoResolutionEnabled: boolean;
+  showLineNumbers: boolean;
+  wrapLongLines: boolean;
+  terminalInheritSystemProfile: boolean;
+  taskAutoArchiveEnabled: boolean;
+  taskAutoArchiveOlderThanDays: number;
+  closeToTrayOnWindows: boolean;
+  keepAwakeWhileRunning: boolean;
+  messageStreamShowReasoning: boolean;
+  messageStreamShowTodos: boolean;
+  toolGroupingExploreEnabled: boolean;
+  toolGroupingTerminalEnabled: boolean;
+  toolGroupingChangesEnabled: boolean;
+  zcodeInteractionBehavior: ZCodeInteractionBehavior;
+};
+
+export type PageAssistantSettingUiSource = Pick<
+  AppSettings,
+  | "memoryEnabled"
+  | "showLineNumbers"
+  | "wrapLongLines"
+  | "askUserQuestionAutoResolutionEnabled"
+  | "nativeSearchEnhancementsEnabled"
+  | "taskAutoArchiveEnabled"
+  | "taskAutoArchiveOlderThanDays"
+  | "terminalInheritSystemProfile"
+  | "closeToTrayOnWindows"
+  | "keepAwakeWhileRunning"
+  | "messageStreamShowReasoning"
+  | "messageStreamShowTodos"
+  | "toolGroupingExploreEnabled"
+  | "toolGroupingTerminalEnabled"
+  | "toolGroupingChangesEnabled"
+  | "zcodeInteractionBehavior"
+>;
+
+/** Map durable Setting writer results to the control values Settings pages bind. */
+export function pageAssistantSettingUiFromWriter(
+  settings: PageAssistantSettingUiSource,
+): PageAssistantSettingUiReflection {
+  const codePreview = codePreviewLinePrefsFromSettings(settings);
+  return {
+    memoryEnabled: settings.memoryEnabled === true,
+    nativeSearchEnhancementsEnabled: settings.nativeSearchEnhancementsEnabled !== false,
+    askUserQuestionAutoResolutionEnabled:
+      settings.askUserQuestionAutoResolutionEnabled !== false,
+    showLineNumbers: codePreview.showLineNumbers,
+    wrapLongLines: codePreview.wrapLongLines,
+    terminalInheritSystemProfile: settings.terminalInheritSystemProfile ?? true,
+    taskAutoArchiveEnabled: settings.taskAutoArchiveEnabled ?? false,
+    taskAutoArchiveOlderThanDays: settings.taskAutoArchiveOlderThanDays ?? 7,
+    closeToTrayOnWindows: settings.closeToTrayOnWindows ?? true,
+    keepAwakeWhileRunning: settings.keepAwakeWhileRunning === true,
+    messageStreamShowReasoning: settings.messageStreamShowReasoning ?? true,
+    messageStreamShowTodos: settings.messageStreamShowTodos ?? false,
+    toolGroupingExploreEnabled: settings.toolGroupingExploreEnabled ?? true,
+    toolGroupingTerminalEnabled: settings.toolGroupingTerminalEnabled ?? true,
+    toolGroupingChangesEnabled: settings.toolGroupingChangesEnabled ?? false,
+    zcodeInteractionBehavior: settings.zcodeInteractionBehavior ?? "queue",
+  };
+}
