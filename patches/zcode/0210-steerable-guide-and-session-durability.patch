+test("product setPersist lands idle_dispose after session_detach via sessionIds snapshot", async () => {
+  const glue = createRemoteHostAttachmentStopSessionGlue({ now: () => 1_700_000_300_000 });
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  const store = memorySessionStore();
+  wiring.installPersistRouter();
+  const service = wiring.wrapSessionService(fakeSessionService(), {
+    persistViaAgent: createSessionStoreRemoteHostStopPersist(store),
+  });
+
+  await service.createSession({
+    workspacePath: "/remote/wsl",
+    remoteSessionId: "remote-wsl-idle",
+    sessionId: "sess-wsl-idle",
+  });
+  const snapshotIds = glue.listBoundSessionIds("remote-wsl-idle");
+  assert.deepEqual(snapshotIds, ["sess-wsl-idle"]);
+
+  await writeRemoteHostAttachmentStopOnHostClose({
+    glue,
+    remoteSessionId: "remote-wsl-idle",
+    reason: "session_detach",
+    attachmentIds: ["renderer-wsl"],
+    targetKind: "wsl",
+  });
+  assert.deepEqual(glue.listBoundSessionIds("remote-wsl-idle"), []);
+  assert.equal(store.entries.length, 1);
+  assert.equal(store.entries[0]?.data.reason, "session_detach");
+
+  // Writers table still holds SessionId (closeSession not called) — idle uses snapshot.
+  assert.deepEqual(wiring.listPersistSessionIds(), ["sess-wsl-idle"]);
+  await writeRemoteHostAttachmentStopOnHostClose({
+    glue,
+    remoteSessionId: "remote-wsl-idle",
+    reason: "idle_dispose",
+    attachmentIds: [],
+    targetKind: "wsl",
+    sessionIds: snapshotIds,
+  });
+  assert.equal(store.entries.length, 2);
+  assert.equal(store.entries[1]?.type, "remote_host_attachment_stop");
+  assert.equal(store.entries[1]?.data.reason, "idle_dispose");
+  assert.equal(store.entries[1]?.data.targetKind, "wsl");
+  assert.deepEqual(store.entries[1]?.data.attachmentIds, []);
+  assert.equal(
+    Object.prototype.hasOwnProperty.call(store.entries[1]?.data ?? {}, "linkedTasks"),
+    false,
+  );
+  wiring.clear();
+});
