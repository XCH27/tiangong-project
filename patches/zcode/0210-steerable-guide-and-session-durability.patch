@@ -0,0 +1,263 @@
+import {
+  SessionEventType,
+  createSessionEvent,
+  type SessionEvent,
+  type SessionId,
+  type SessionStorePort,
+  type TraceContext,
+} from "../deps.js";
+import {
+  isTerminalRuntimeTask,
+  type RuntimeTaskRegistry,
+  type RuntimeTaskSnapshot,
+} from "../../runtime-task/registry.js";
+
+/**
+ * First durable toehold for local_bash cold reconstruction.
+ *
+ * Agent Stop already persists Session `subagent_stop` entries and recovers into the
+ * registry without re-executing a child. Bash previously only held a process-local
+ * executionPort map + memory-only BackgroundTask* events, so after restart Stop
+ * could not find settlement evidence.
+ *
+ * This module writes a Session `bash_stop` entry at Stop settlement and restores a
+ * terminal registry snapshot on cold reopen. It also synthesizes terminal
+ * BackgroundTaskCompleted events from those entries so cold projection can keep
+ * backgroundWorks honest after memory eventStore loss. It does not make live
+ * BackgroundTask* writes durable, does not cover multi-type reconstruct, and
+ * never restarts a bash child.
+ */
+export const BASH_STOP_SESSION_ENTRY = "bash_stop" as const;
+
+export interface StoppedBashBackgroundTask {
+  task: RuntimeTaskSnapshot;
+  totalDurationMs: number;
+  traceContext: TraceContext;
+  cold?: boolean;
+}
+
+export function bashStopKey(task: RuntimeTaskSnapshot): string {
+  return `bash-stop:${task.taskId}:${task.traceContext?.spanId ?? task.startedAt.toISOString()}:${task.branchGeneration ?? 0}`;
+}
+
+const TERMINAL_BASH_STATUSES = new Set<RuntimeTaskSnapshot["status"]>([
+  "killed",
+  "lost",
+  "cancelled",
+  "stopped",
+  "completed",
+  "failed",
+]);
+
+export function restoreStoppedBashBackgroundTask(
+  value: unknown,
+): StoppedBashBackgroundTask | undefined {
+  if (!value || typeof value !== "object") return undefined;
+  const data = value as StoppedBashBackgroundTask;
+  const task = data.task;
+  if (
+    !task ||
+    task.type !== "local_bash" ||
+    !TERMINAL_BASH_STATUSES.has(task.status) ||
+    typeof task.taskId !== "string" ||
+    typeof data.totalDurationMs !== "number" ||
+    !Number.isFinite(data.totalDurationMs) ||
+    data.totalDurationMs < 0 ||
+    !data.traceContext?.traceId ||
+    typeof task.parentSessionId !== "string" ||
+    (task.branchGeneration !== undefined &&
+      (!Number.isInteger(task.branchGeneration) || task.branchGeneration < 0))
+  ) {
+    return undefined;
+  }
+  const startedAt = new Date(task.startedAt);
+  const completedAt = task.completedAt ? new Date(task.completedAt) : undefined;
+  if (!Number.isFinite(startedAt.getTime())) return undefined;
+  if (completedAt && !Number.isFinite(completedAt.getTime())) return undefined;
+  // Strip non-serializable live handles if a stale writer left them behind.
+  const { messageSink: _messageSink, pendingMessages: _pendingMessages, ...safeTask } = task;
+  return {
+    ...data,
+    task: { ...safeTask, startedAt, ...(completedAt ? { completedAt } : {}) },
+    cold: true,
+  };
+}
+
+export function serializeBashStopTask(task: RuntimeTaskSnapshot): RuntimeTaskSnapshot {
+  const { messageSink: _messageSink, pendingMessages: _pendingMessages, ...safeTask } = task;
+  return safeTask;
+}
+
+export async function persistStoppedBashBackgroundTask(input: {
+  sessionStore?: Pick<SessionStorePort, "saveSessionEntry">;
+  sessionId: SessionId;
+  stopped: StoppedBashBackgroundTask;
+}): Promise<void> {
+  const store = input.sessionStore;
+  if (!store?.saveSessionEntry) return;
+  const completedAt = input.stopped.task.completedAt ?? new Date();
+  const now = Date.now();
+  await store.saveSessionEntry({
+    id: bashStopKey(input.stopped.task),
+    sessionID: input.sessionId,
+    type: BASH_STOP_SESSION_ENTRY,
+    touchSession: false,
+    time: { created: completedAt.getTime(), updated: now },
+    data: {
+      task: serializeBashStopTask(input.stopped.task),
+      totalDurationMs: input.stopped.totalDurationMs,
+      traceContext: input.stopped.traceContext,
+    },
+  });
+}
+
+export async function loadStoppedBashBackgroundTask(input: {
+  sessionStore?: Pick<SessionStorePort, "sessionEntries">;
+  sessionId: SessionId;
+  branchGeneration: number;
+  taskId: string;
+}): Promise<StoppedBashBackgroundTask | undefined> {
+  const store = input.sessionStore;
+  if (!store?.sessionEntries) return undefined;
+  const entries = await store.sessionEntries({
+    sessionID: input.sessionId,
+    type: BASH_STOP_SESSION_ENTRY,
+  });
+  return entries
+    .sort((a, b) => b.time.created - a.time.created)
+    .map((entry) => restoreStoppedBashBackgroundTask(entry.data))
+    .find(
+      (stopped) =>
+        stopped?.task.taskId === input.taskId &&
+        stopped.task.parentSessionId === input.sessionId &&
+        stopped.task.branchGeneration === input.branchGeneration,
+    );
+}
+
+/**
+ * Cold reopen only: register terminal settlement evidence. Never starts a child.
+ */
+export async function recoverStoppedBashBackgroundTask(input: {
+  sessionStore?: Pick<SessionStorePort, "sessionEntries">;
+  sessionId: SessionId;
+  branchGeneration: number;
+  runtimeTaskRegistry: RuntimeTaskRegistry;
+  taskId: string;
+}): Promise<RuntimeTaskSnapshot | undefined> {
+  if (input.runtimeTaskRegistry.get(input.taskId)) {
+    return input.runtimeTaskRegistry.get(input.taskId);
+  }
+  const stopped = await loadStoppedBashBackgroundTask(input);
+  if (!stopped) return undefined;
+  const task: RuntimeTaskSnapshot = {
+    ...stopped.task,
+    type: "local_bash",
+    isBackgrounded: true,
+    status: stopped.task.status === "cancelled" ? "killed" : stopped.task.status,
+    error:
+      stopped.task.error ??
+      (stopped.task.status === "lost"
+        ? "Bash background task was marked lost; child execution is not running."
+        : undefined),
+  };
+  if (!isTerminalRuntimeTask(task)) return undefined;
+  input.runtimeTaskRegistry.register(task);
+  return task;
+}
+
+/**
+ * Map durable bash_stop registry status onto BackgroundTaskCompleted payload status.
+ * killed/cancelled/stopped → cancelled (Stop settlement); lost stays lost.
+ */
+export function backgroundTaskStatusFromBashStop(
+  status: RuntimeTaskSnapshot["status"],
+): "completed" | "failed" | "timed_out" | "cancelled" | "spawn_error" | "lost" | undefined {
+  switch (status) {
+    case "killed":
+    case "cancelled":
+    case "stopped":
+      return "cancelled";
+    case "lost":
+      return "lost";
+    case "completed":
+      return "completed";
+    case "failed":
+      return "failed";
+    default:
+      return undefined;
+  }
+}
+
+/**
+ * Cold projection honesty: Session bash_stop → BackgroundTaskCompleted supplements.
+ * Skips taskIds that already have a memory BackgroundTaskCompleted (live authority).
+ * Never invents running works and never starts a child.
+ */
+export function synthesizeBackgroundTaskEventsFromBashStopEntries(input: {
+  entries: readonly { type?: string; data: unknown; time: { created: number } }[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+}): SessionEvent[] {
+  const sessionId = String(input.sessionId);
+  const memoryTerminalTaskIds = new Set<string>();
+  for (const event of input.memoryEvents ?? []) {
+    if (event.type !== SessionEventType.BackgroundTaskCompleted) continue;
+    const taskId =
+      event.payload && typeof event.payload === "object" && !Array.isArray(event.payload)
+        ? (event.payload as { taskId?: unknown }).taskId
+        : undefined;
+    if (typeof taskId === "string" && taskId.length > 0) {
+      memoryTerminalTaskIds.add(taskId);
+    }
+  }
+
+  const byTaskId = new Map<string, { stopped: StoppedBashBackgroundTask; created: number }>();
+  for (const entry of input.entries) {
+    if (entry.type !== undefined && entry.type !== BASH_STOP_SESSION_ENTRY) continue;
+    const stopped = restoreStoppedBashBackgroundTask(entry.data);
+    if (!stopped) continue;
+    if (String(stopped.task.parentSessionId) !== sessionId) continue;
+    const existing = byTaskId.get(stopped.task.taskId);
+    const completedMs = stopped.task.completedAt?.getTime() ?? entry.time.created;
+    if (!existing || completedMs >= (existing.stopped.task.completedAt?.getTime() ?? existing.created)) {
+      byTaskId.set(stopped.task.taskId, { stopped, created: entry.time.created });
+    }
+  }
+
+  const events: SessionEvent[] = [];
+  for (const { stopped } of byTaskId.values()) {
+    if (memoryTerminalTaskIds.has(stopped.task.taskId)) continue;
+    const status = backgroundTaskStatusFromBashStop(stopped.task.status);
+    if (!status) continue;
+    const completedAt =
+      stopped.task.completedAt ??
+      new Date(stopped.task.startedAt.getTime() + stopped.totalDurationMs);
+    const event = createSessionEvent(
+      SessionEventType.BackgroundTaskCompleted,
+      sessionId as SessionId,
+      {
+        taskId: stopped.task.taskId,
+        ...(stopped.task.parentToolCallId ? { toolCallId: stopped.task.parentToolCallId } : {}),
+        toolName: "Bash",
+        taskKind: "bash" as const,
+        cancellable: false,
+        ...(stopped.task.prompt ? { command: stopped.task.prompt } : {}),
+        description: stopped.task.description,
+        status,
+        ...(stopped.task.pid !== undefined ? { pid: stopped.task.pid } : {}),
+        startedAt: stopped.task.startedAt,
+        completedAt,
+        ...(stopped.task.outputFile ? { outputPath: stopped.task.outputFile } : {}),
+        terminalId: stopped.task.taskId,
+      },
+      {
+        traceId: stopped.traceContext.traceId,
+        sequenceNumber: 0,
+      },
+    );
+    event.timestamp = completedAt;
+    events.push(event);
+  }
+  events.sort((left, right) => left.timestamp.getTime() - right.timestamp.getTime());
+  return events;
+}
