+test("without product bind, Host close remains honest no-write even with persist router", async () => {
+  const glue = createRemoteHostAttachmentStopSessionGlue();
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  const store = memorySessionStore();
+  wiring.installPersistRouter();
+  // Router installed but no SessionId writer / bind → skip.
+  const result = await glue.notifyStopped({
+    remoteSessionId: "unbound-remote",
+    reason: "transport_close",
+    attachmentIds: [],
+  });
+  assert.equal(result.skippedNoBinding, true);
+  assert.deepEqual(store.entries, []);
+  // createSessionStore persist alone does not invent bindings.
+  void createSessionStoreRemoteHostStopPersist(store);
+  wiring.clear();
+});
