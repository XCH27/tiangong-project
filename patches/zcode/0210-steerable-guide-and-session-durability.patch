+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  NATIVE_GUIDE_REFUSED_EXECUTOR_KINDS,
+  NATIVE_GUIDE_TOOL_BOUNDARY_PATHS,
+  nativeGuideSteerAllowed,
+  type NativeGuideToolBoundaryPathId,
+} from "../src/runtime/methods/native-guide-tool-boundary-honesty.js";
+import { fixture, reply, selection } from "./helpers/pi-runtime-fixture.js";
+
+/** Stable checklist — shrinking this list without Lead review is an honesty regression. */
+const REQUIRED_PATH_IDS: readonly NativeGuideToolBoundaryPathId[] = [
+  "host_tool_batch_drain",
+  "vendor_claude_stdin_priority_next",
+  "vendor_codex_turn_steer",
+  "acp_permission_wait_boundary",
+  "text_only_no_tool_fallback",
+  "native_continuation_same_session",
+  "refuse_durable_ghost_on_reject",
+];
+
+test("native Guide honesty gate opens only when every tool-boundary path is proved", () => {
+  assert.equal(nativeGuideSteerAllowed(), true);
+  assert.deepEqual(
+    NATIVE_GUIDE_TOOL_BOUNDARY_PATHS.map((path) => path.id).sort(),
+    [...REQUIRED_PATH_IDS].sort(),
+  );
+  const byId = new Map(NATIVE_GUIDE_TOOL_BOUNDARY_PATHS.map((path) => [path.id, path]));
+  for (const id of REQUIRED_PATH_IDS) {
+    assert.equal(byId.get(id)?.status, "proved", `${id} must be proved`);
+  }
+  // Inventing Ready: a partial checklist must not open the gate.
+  assert.equal(
+    nativeGuideSteerAllowed([
+      { id: "refuse_durable_ghost_on_reject", status: "proved", role: "ghost" },
+      { id: "host_tool_batch_drain", status: "pi_only", role: "pi" },
+    ]),
+    false,
+  );
+});
+
+for (const kind of NATIVE_GUIDE_REFUSED_EXECUTOR_KINDS) {
+  test(`native ${kind} mid-turn Guide queues when gate is open (steerable paths proved)`, async () => {
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const f = await fixture(undefined, false, {
+      nativeExecutor: { kind, accountId: `fixture-${kind}` } as never,
+    });
+    try {
+      const runtime = f.runtime as any;
+      let first = true;
+      runtime.nativeAgentPort = {
+        createTurn(request: any) {
+          assert.equal(
+            runtime.activeTurn?.steerable,
+            true,
+            "native Guide steerable when every checklist path is proved",
+          );
+          return {
+            model: request.model,
+            async admitNextStep() {
+              if (!first) return;
+              first = false;
+              entered.resolve();
+              await release.promise;
+            },
+            retainToolReceipts() {},
+            async close() {},
+          };
+        },
+      };
+      f.steps.push(
+        () => reply("native fixture first"),
+        () => reply("native fixture after guide continue"),
+      );
+      const running = runtime.executeTurn("Original native input", [], {
+        intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+      });
+      await entered.promise;
+      assert.equal(runtime.activeTurn?.steerable, true);
+      const guide = await runtime.steerTurn({
+        input: "New instruction during native turn",
+        delivery: "guide",
+      });
+      assert.equal(guide.kind, "queued");
+      release.resolve();
+      const result = await running;
+      assert.equal(result.response, "native fixture after guide continue");
+    } finally {
+      release.resolve();
+      await f.close();
+    }
+  });
+}
+
+test("non-native Pi Guide remains steerable (honesty gate is native-only)", async () => {
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const f = await fixture();
+  let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+  try {
+    f.steps.push(
+      async () => {
+        entered.resolve();
+        await release.promise;
+        return reply("first");
+      },
+      () => reply("guided"),
+    );
+    running = f.runtime.executeTurn("Pi original", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+    await entered.promise;
+    assert.equal((f.runtime as any).activeTurn?.steerable, true);
+    const guide = await f.runtime.steerTurn({
+      input: "Pi mid-turn guide",
+      delivery: "guide",
+    });
+    assert.equal(guide.kind, "queued");
+    release.resolve();
+    assert.equal((await running).response, "guided");
+  } finally {
+    release.resolve();
+    await running?.catch(() => {});
+    await f.close();
+  }
+});
