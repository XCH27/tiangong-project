index 00000000..cb39e3de
--- /dev/null
+++ b/packages/desktop/src/host/remoteHostAttachmentStopSessionGlue.ts
@@ -0,0 +1,202 @@
+/**
+ * Production Host→SessionStore glue for remote Host attachment Stop.
+ *
+ * Maps remoteSessionId → SessionId so Host `onSessionClosed` / dispose detach /
+ * WSL idle_dispose can persist `remote_host_attachment_stop` without fixture-only DI.
+ *
+ * Persist is injected: SessionStore lives in the agent runtime; Host never invents
+ * a SessionId, linked tasks, live process-tree, or Ready. Empty bindings → honest
+ * no-write. Persist absent → still resolves mapped SessionIds but skips I/O.
+ */
+
+export type RemoteHostStopSessionReason =
+  | "session_detach"
+  | "transport_close"
+  | "idle_dispose"
+  | "dispose_remote";
+
+export type RemoteHostStopSessionTargetKind = "docker" | "ssh" | "wsl";
+
+/**
+ * Production receipt shape mirrors core `RemoteHostAttachmentStopReceipt` but
+ * intentionally omits `linkedTasks` — discovering those needs live remote
+ * process-tree (still non-claim). Cold projector then records the durable stop
+ * with zero backgroundWorks rows unless a future honest linked-task source lands.
+ */
+export interface RemoteHostStopSessionReceipt {
+  remoteSessionId: string;
+  reason: RemoteHostStopSessionReason;
+  targetKind?: RemoteHostStopSessionTargetKind;
+  attachmentIds: string[];
+  stoppedAt: number;
+}
+
+export type PersistRemoteHostStopSessionReceipt = (input: {
+  sessionId: string;
+  receipt: RemoteHostStopSessionReceipt;
+}) => void | Promise<void>;
+
+export interface RemoteHostAttachmentStopSessionGlue {
+  /** Product/tests register which ZCode SessionId owns work on this remote Host session. */
+  bindSession(remoteSessionId: string, sessionId: string): void;
+  unbindSession(remoteSessionId: string, sessionId: string): void;
+  clearRemoteSession(remoteSessionId: string): void;
+  listBoundSessionIds(remoteSessionId: string): string[];
+  setPersist(persist: PersistRemoteHostStopSessionReceipt | undefined): void;
+  /**
+   * Host close/detach entry: for each bound SessionId, persist an honest stop
+   * receipt (no linkedTasks). Returns which SessionIds were written.
+   */
+  notifyStopped(input: {
+    remoteSessionId: string;
+    reason: RemoteHostStopSessionReason;
+    attachmentIds: string[];
+    targetKind?: RemoteHostStopSessionTargetKind;
+    stoppedAt?: number;
+    /**
+     * Optional explicit SessionIds (WSL idle after session_detach cleared live
+     * bindings). When set, these are written instead of the live bind map.
+     * Never invents SessionIds — caller must snapshot honest bindings earlier.
+     */
+    sessionIds?: string[];
+  }): Promise<{
+    receipt: RemoteHostStopSessionReceipt;
+    writtenSessionIds: string[];
+    /** True when no SessionId was bound — detach still happened; Session write skipped honestly. */
+    skippedNoBinding: boolean;
+    /** True when bindings existed but no persist writer was registered. */
+    skippedNoPersist: boolean;
+  }>;
+}
+
+export function createRemoteHostAttachmentStopSessionGlue(options?: {
+  persist?: PersistRemoteHostStopSessionReceipt;
+  now?: () => number;
+}): RemoteHostAttachmentStopSessionGlue {
+  const bindings = new Map<string, Set<string>>();
+  let persist = options?.persist;
+  const now = options?.now ?? Date.now;
+
+  function boundSet(remoteSessionId: string): Set<string> {
+    let set = bindings.get(remoteSessionId);
+    if (!set) {
+      set = new Set();
+      bindings.set(remoteSessionId, set);
+    }
+    return set;
+  }
+
+  return {
+    bindSession(remoteSessionId, sessionId) {
+      const remote = remoteSessionId.trim();
+      const session = sessionId.trim();
+      if (!remote || !session) return;
+      boundSet(remote).add(session);
+    },
+    unbindSession(remoteSessionId, sessionId) {
+      const set = bindings.get(remoteSessionId);
+      if (!set) return;
+      set.delete(sessionId);
+      if (set.size === 0) bindings.delete(remoteSessionId);
+    },
+    clearRemoteSession(remoteSessionId) {
+      bindings.delete(remoteSessionId);
+    },
+    listBoundSessionIds(remoteSessionId) {
+      return Array.from(bindings.get(remoteSessionId) ?? []);
+    },
+    setPersist(next) {
+      persist = next;
+    },
+    async notifyStopped(input) {
+      const receipt: RemoteHostStopSessionReceipt = {
+        remoteSessionId: input.remoteSessionId,
+        reason: input.reason,
+        ...(input.targetKind !== undefined ? { targetKind: input.targetKind } : {}),
+        attachmentIds: [...input.attachmentIds],
+        stoppedAt: input.stoppedAt ?? now(),
+      };
+      const fromBindings = Array.from(bindings.get(input.remoteSessionId) ?? []);
+      const sessionIds =
+        input.sessionIds !== undefined
+          ? Array.from(
+              new Set(
+                input.sessionIds
+                  .map((id) => id.trim())
+                  .filter((id) => id.length > 0),
+              ),
+            )
+          : fromBindings;
+      if (sessionIds.length === 0) {
+        return {
+          receipt,
+          writtenSessionIds: [],
+          skippedNoBinding: true,
+          skippedNoPersist: persist === undefined,
+        };
+      }
+      if (!persist) {
+        return {
+          receipt,
+          writtenSessionIds: [],
+          skippedNoBinding: false,
+          skippedNoPersist: true,
+        };
+      }
+      const writer = persist;
+      const writtenSessionIds: string[] = [];
+      for (const sessionId of sessionIds) {
+        await writer({ sessionId, receipt });
+        writtenSessionIds.push(sessionId);
+      }
+      // Remote logical session is gone — drop bindings so a reconnect id cannot reuse them.
+      bindings.delete(input.remoteSessionId);
+      return {
+        receipt,
+        writtenSessionIds,
+        skippedNoBinding: false,
+        skippedNoPersist: false,
+      };
+    },
+  };
+}
+
+/** Host-process singleton — tests may replace via reset helper. */
+let hostRemoteHostAttachmentStopSessionGlue = createRemoteHostAttachmentStopSessionGlue();
+
+export function getRemoteHostAttachmentStopSessionGlue(): RemoteHostAttachmentStopSessionGlue {
+  return hostRemoteHostAttachmentStopSessionGlue;
+}
+
+/** Test-only: replace Host singleton (and optionally seed persist). */
+export function resetRemoteHostAttachmentStopSessionGlueForTests(
+  options?: Parameters<typeof createRemoteHostAttachmentStopSessionGlue>[0],
+): RemoteHostAttachmentStopSessionGlue {
+  hostRemoteHostAttachmentStopSessionGlue = createRemoteHostAttachmentStopSessionGlue(options);
+  return hostRemoteHostAttachmentStopSessionGlue;
+}
+
+/**
+ * Shared Host close helper used by production `onSessionClosed` / dispose and by
+ * unit tests — proves glue without fixture-only onStopReceipt DI.
+ */
+export async function writeRemoteHostAttachmentStopOnHostClose(input: {
+  glue?: RemoteHostAttachmentStopSessionGlue;
+  remoteSessionId: string;
+  reason: RemoteHostStopSessionReason;
+  attachmentIds: string[];
+  targetKind?: RemoteHostStopSessionTargetKind;
+  stoppedAt?: number;
+  /** Snapshot from DisposeRemote before session_detach cleared live bindings (WSL idle). */
+  sessionIds?: string[];
+}): Promise<ReturnType<RemoteHostAttachmentStopSessionGlue["notifyStopped"]>> {
+  const glue = input.glue ?? getRemoteHostAttachmentStopSessionGlue();
+  return glue.notifyStopped({
+    remoteSessionId: input.remoteSessionId,
+    reason: input.reason,
+    attachmentIds: input.attachmentIds,
+    ...(input.targetKind !== undefined ? { targetKind: input.targetKind } : {}),
+    ...(input.stoppedAt !== undefined ? { stoppedAt: input.stoppedAt } : {}),
+    ...(input.sessionIds !== undefined ? { sessionIds: input.sessionIds } : {}),
+  });
+}
