+      id: msg.id,
+      result: { thread: { id: threadId }, model: msg.params.model, modelProvider: "openai" },
+    });
+    return;
+  }
+  if (msg.method === "turn/start") {
+    send({ id: msg.id, result: { turn: { id: turnId } } });
+    send({ method: "turn/started", params: { threadId, turnId, turn: { id: turnId } } });
