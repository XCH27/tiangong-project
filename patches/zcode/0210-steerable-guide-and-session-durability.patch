+import assert from "node:assert/strict";
+import test from "node:test";
+import { remoteHostAttachmentStopFixture } from "./helpers/remote-host-attachment-stop-fixture.js";
+
+
+async function waitFor(
+  predicate: () => boolean,
+  label: string,
+  timeoutMs = 200,
+): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (predicate()) return;
+    await new Promise<void>((resolve) => setTimeout(resolve, 5));
+  }
+  throw new Error(`timed out waiting for ${label}`);
+}
+
+
+test("attachment port close disposes the exposed handle exactly once", async () => {
+  const fx = remoteHostAttachmentStopFixture();
+  try {
+    const session = await fx.connectDocker();
+    const port = fx.attachRemote({
+      attachmentId: "renderer-a",
+      remoteSessionId: session.remoteSessionId,
+    });
+    assert.equal(fx.attachmentRegistry.size(), 1);
+    port.emitClose();
+    assert.deepEqual(fx.disposedHandles, ["renderer-a"]);
+    assert.equal(fx.attachmentRegistry.size(), 0);
+    port.emitClose();
+    assert.deepEqual(fx.disposedHandles, ["renderer-a"]);
+  } finally {
+    await fx.close();
+  }
+});
+
+test("detach(attachmentId) disposes without waiting for port close", async () => {
+  const fx = remoteHostAttachmentStopFixture();
+  try {
+    const session = await fx.connectDocker();
+    fx.attachRemote({
+      attachmentId: "phone-a",
+      remoteSessionId: session.remoteSessionId,
+    });
+    fx.attachmentRegistry.detach("phone-a");
+    assert.deepEqual(fx.disposedHandles, ["phone-a"]);
+    assert.equal(fx.attachmentRegistry.size(), 0);
+  } finally {
+    await fx.close();
+  }
+});
+
