@@ -0,0 +1,152 @@
+/**
+ * Native Guide surface honesty (steerable ≠ Ready / usable).
+ *
+ * Horizontal compare:
+ * - Plugin MCP honesty (`pluginMcpSurfaceHonesty.ts`): wired / connected ≠
+ *   product `usable` / invent `Ready`.
+ * - Core `nativeGuideSteerAllowed()`: every tool-boundary path `proved` opens
+ *   steerable Host Guide admission — still not product Ready.
+ * - Fleet AGENTS.md: only usable · wired-but-not-visually-checked · display-only ·
+ *   not implemented. Agents must never invent Ready.
+ *
+ * Product UI may label a turn `steerable` when Guide admission is allowed
+ * (mirrors `activeTurn.steerable` / `nativeGuideSteerAllowed()` for native).
+ * That opens mid-turn Guide — it does **not** invent product Ready / usable.
+ */
+
+import type { InputRouting } from "@zcode/shared/zcode-protocol-v4";
+
+/** Forbidden product / invent labels for native Guide runtime projection. */
+export const NATIVE_GUIDE_FORBIDDEN_PRODUCT_LABELS = ["usable", "Ready", "ready"] as const;
+
+export type NativeGuideForbiddenProductLabel =
+  (typeof NATIVE_GUIDE_FORBIDDEN_PRODUCT_LABELS)[number];
+
+/**
+ * Runtime honesty for native / Pi Guide admission. Deliberately excludes product
+ * `usable` and invent `Ready` — steerable paths proved ≠ owner-accepted Ready.
+ */
+export type NativeGuideSurfaceHonesty =
+  /** Native gate open / turn steerable — Guide may admit; NOT Ready. */
+  | "steerable"
+  /** Native gate closed or Host rejected with turn_not_steerable. */
+  | "not_steerable"
+  /** Non-native Pi / Host-model path is steerable (honesty gate is native-only). */
+  | "pi_steerable"
+  /** No live turn to steer. */
+  | "no_active_turn"
+  /** Routing to ordinary queue — not mid-turn Guide Ready invent. */
+  | "queue_path";
+
+export type NativeGuideSurfaceHonestyInput = {
+  hasActiveTurn: boolean;
+  /** Live model uses a native executor (claude / codex / …). */
+  nativeExecutor: boolean;
+  /**
+   * Mirrors core `nativeGuideSteerAllowed()` / `activeTurn.steerable` when known.
+   * True opens steerable Guide admission — never product Ready.
+   */
+  steerAllowed: boolean;
+};
+
+/**
+ * Classify native Guide honesty from explicit steer facts.
+ * Never returns a forbidden product label.
+ */
+export function classifyNativeGuideSurfaceHonesty(
+  input: NativeGuideSurfaceHonestyInput,
+): NativeGuideSurfaceHonesty {
+  if (!input.hasActiveTurn) {
+    return "no_active_turn";
+  }
+  if (!input.nativeExecutor) {
+    return input.steerAllowed ? "pi_steerable" : "not_steerable";
+  }
+  return input.steerAllowed ? "steerable" : "not_steerable";
+}
+
+/**
+ * Classify from v4 `inputRouting` (already on ConversationSnapshot).
+ * `mode === "guide"` means Host prefers Guide delivery — not by itself product Ready.
+ * Prefer `classifyNativeGuideHonestyFromSnapshotControl` when `control.steerable`
+ * is available so composer honesty mirrors `activeTurn.steerable`.
+ */
+export function classifyNativeGuideHonestyFromInputRouting(
+  routing: Pick<InputRouting, "mode"> & { reasonCode?: string },
+): NativeGuideSurfaceHonesty {
+  switch (routing.mode) {
+    case "guide":
+      return "steerable";
+    case "enqueue":
+    case "choice":
+      return "queue_path";
+    case "startNow":
+      return "no_active_turn";
+    case "reject": {
+      if (routing.reasonCode === "no_active_turn") {
+        return "no_active_turn";
+      }
+      // turn_not_steerable and other reject codes stay not_steerable — never Ready.
+      return "not_steerable";
+    }
+    default: {
+      const _exhaustive: never = routing.mode;
+      void _exhaustive;
+      return "not_steerable";
+    }
+  }
+}
+
+export type NativeGuideHonestyFromControlInput = {
+  inputRouting: Pick<InputRouting, "mode"> & { reasonCode?: string };
+  /**
+   * `snapshot.control.steerable` — projection of core `activeTurn.steerable`.
+   * When routing is `guide`, this bit decides steerable vs not_steerable.
+   * Omitted (legacy UI path) falls back to routing-only classify.
+   */
+  steerable?: boolean;
+};
+
+/**
+ * Composer-facing honesty: project `control.steerable` onto Guide labels.
+ * `inputRouting.mode === "guide"` alone must not invent steerable when the
+ * live turn bit is false (gate closed / turn_not_steerable). Never Ready.
+ */
+export function classifyNativeGuideHonestyFromSnapshotControl(
+  input: NativeGuideHonestyFromControlInput,
+): NativeGuideSurfaceHonesty {
+  if (input.inputRouting.mode === "guide" && input.steerable !== undefined) {
+    return input.steerable ? "steerable" : "not_steerable";
+  }
+  return classifyNativeGuideHonestyFromInputRouting(input.inputRouting);
+}
+
+/** True when honesty means mid-turn Guide admission is open (still not Ready). */
+export function isNativeGuideSteerableHonesty(honesty: NativeGuideSurfaceHonesty): boolean {
+  return honesty === "steerable" || honesty === "pi_steerable";
+}
+
+/**
+ * Product `usable` / invent `Ready` are impossible for every native Guide honesty label.
+ * Steerable proves Guide admission paths — not owner-accepted product Ready (AGENTS.md).
+ */
+export function nativeGuideHonestyAllowsProductUsable(
+  _honesty: NativeGuideSurfaceHonesty,
+): false {
+  return false;
+}
+
+export function isForbiddenNativeGuideProductLabel(
+  label: string,
+): label is NativeGuideForbiddenProductLabel {
+  return (NATIVE_GUIDE_FORBIDDEN_PRODUCT_LABELS as readonly string[]).includes(label);
+}
+
+/** i18n id for pending Guide status — steerable copy never says Ready / available. */
+export function nativeGuidePendingStatusMessageId(
+  honesty: NativeGuideSurfaceHonesty,
+): "chat.message.turnSteer.pendingSteerable" | "chat.message.turnSteer.pending" {
+  return isNativeGuideSteerableHonesty(honesty)
+    ? "chat.message.turnSteer.pendingSteerable"
+    : "chat.message.turnSteer.pending";
+}
