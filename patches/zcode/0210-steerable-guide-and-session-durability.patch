+test("persist + synthesize orphan Agent Started as lost Completed (never running)", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-agent-bts-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const persisted = await persistBackgroundTaskStartedEntry({
+      sessionStore: store,
+      sessionId,
+      event: agentStartedEvent(),
+    });
+    assert.equal(persisted, true);
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const entries = await store.sessionEntries({
+      sessionID: sessionId,
+      type: BACKGROUND_TASK_STARTED_SESSION_ENTRY,
+    });
+    assert.equal(entries.length, 1);
+    assert.equal((entries[0]?.data as { taskKind: string }).taskKind, "subagent");
+
+    const synthesized = synthesizeLostBackgroundTaskEventsFromStartedEntries({
+      entries,
+      sessionId,
+      memoryEvents: [],
+    });
+    assert.equal(synthesized.length, 1);
+    assert.equal(synthesized[0]?.type, SessionEventType.BackgroundTaskCompleted);
+    const payload = synthesized[0]?.payload as {
+      status: string;
+      taskKind: string;
+      childSessionId?: string;
+    };
+    assert.equal(payload.status, "lost");
+    assert.equal(payload.taskKind, "subagent");
+    assert.equal(payload.childSessionId, "child-agent-bt-1");
+
+    const projection = new ProductProjection(sessionId, "agent-bts-synth");
+    for (const item of synthesized) {
+      projection.applyEventAtomically(item, () => true);
+    }
+    const works = projection.getSnapshot().backgroundWorks;
+    assert.equal(works.length, 1);
+    assert.equal(works[0]?.workId, "agent-bt-1");
+    assert.equal(works[0]?.kind, "subagent");
+    assert.equal(works[0]?.status, "failed");
+    assert.notEqual(works[0]?.status, "running");
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
