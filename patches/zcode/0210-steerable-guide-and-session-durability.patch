+import type { RuntimeTaskType } from "../../runtime-task/registry.js";
+
+/**
+ * Per-RuntimeTaskType cold Session → backgroundWorks durability (registry authority).
+ *
+ * Winning pattern: Craft typed task registry + ACP capability flags + OpenCode
+ * never-invent-running across process death. Settlement writers key durability on
+ * real toolName (Bash / Agent|Task / dwf), not decorative taskKind — so live emit
+ * aliases (legacy Workflow → taskKind bash) and missing-toolName invent cannot
+ * piggyback bash Session durability. `isColdNonDurableBackgroundToolName` is the
+ * explicit non_durable deny list (defense in depth).
+ *
+ * Explicitly not claimed: inventing running from Updated / Updated as cold panel
+ * projector (Updated Session write is event-driven meaningful-control only),
+ * workflow orphan→lost / inventing running from Session Started alone without
+ * journal non-terminal, inventing Ready/usable.
+ * Remote Host attachment Stop Session writer is a separate projector
+ * (remote_host_attachment_stop) — not a RuntimeTaskType row.
+ */
+export type ColdRuntimeTaskDurabilityPolicy =
+  | "session_completed_and_started"
+  | "session_completed_and_started_journal_gated"
+  | "session_completed_only"
+  | "non_durable";
+
+/**
+ * Claimed cold durability by RuntimeTaskType.
+ *
+ * - session_completed_and_started: live Completed + Started durable; orphan Started → lost
+ * - session_completed_and_started_journal_gated: Completed durable; Started durable only
+ *   when cold can gate on dwf journal non-terminal (listNonTerminalRuns); cold suppresses
+ *   orphan Started (never lost); warm journal-gated Started read when journal still
+ *   non-terminal; never invent without journal
+ * - session_completed_only: live Completed durable; Started refused
+ * - non_durable: no dedicated cold Session reconstruct claimed
+ */
+export const COLD_RUNTIME_TASK_DURABILITY: Readonly<
+  Record<RuntimeTaskType, ColdRuntimeTaskDurabilityPolicy>
+> = {
+  local_bash: "session_completed_and_started",
+  local_agent: "session_completed_and_started",
+  local_dynamic_workflow: "session_completed_and_started_journal_gated",
+  // Legacy Workflow tool emits BackgroundTask* with taskKind bash for panel grouping;
+  // dedicated local_workflow Session reconstruct is not claimed. Persist path keys on
+  // toolName Bash only (taskKind decorative) + refuses toolName Workflow.
+  local_workflow: "non_durable",
+  // Placeholder type only — no live BackgroundTask* emit tool maps here today.
+  monitor_mcp: "non_durable",
+};
+
+/**
+ * Live BackgroundTask* toolName values that stay Session non_durable.
+ * Keep in sync with COLD_RUNTIME_TASK_DURABILITY non_durable rows.
+ */
+export const COLD_NON_DURABLE_BACKGROUND_TOOL_NAMES = ["Workflow", "Monitor"] as const;
+
+/**
+ * Tool names with a real live BackgroundTask* emit path (trackBackgroundTask /
+ * subagent runner / dwf). Monitor is intentionally absent (empty emit-path proof
+ * for monitor_mcp → keep non_durable).
+ */
+export const COLD_LIVE_BACKGROUND_TASK_EMIT_TOOL_NAMES = [
+  "Bash",
+  "Agent",
+  "Task", // Claude Code-compatible Agent alias; trackBackgroundTask uses toolCall.name
+  "Workflow",
+  "CreateWorkflow",
+  "ResumeWorkflowRun",
+  "AmendWorkflow",
+] as const;
+
+export function coldRuntimeTaskDurabilityPolicy(
+  type: RuntimeTaskType,
+): ColdRuntimeTaskDurabilityPolicy {
+  return COLD_RUNTIME_TASK_DURABILITY[type];
+}
+
+export function isColdDurableRuntimeTaskType(type: RuntimeTaskType): boolean {
+  return COLD_RUNTIME_TASK_DURABILITY[type] !== "non_durable";
+}
+
+export function isColdNonDurableBackgroundToolName(toolName: string | undefined): boolean {
+  if (!toolName) return false;
+  return (COLD_NON_DURABLE_BACKGROUND_TOOL_NAMES as readonly string[]).includes(toolName);
+}
+
+export function hasColdLiveBackgroundTaskEmitPath(toolName: string): boolean {
+  return (COLD_LIVE_BACKGROUND_TASK_EMIT_TOOL_NAMES as readonly string[]).includes(toolName);
+}
+
+/** Whether this RuntimeTaskType has any live BackgroundTask* emit tool today. */
+export function coldRuntimeTaskTypeHasLiveBackgroundTaskEmit(type: RuntimeTaskType): boolean {
+  switch (type) {
+    case "local_bash":
+    case "local_agent":
+    case "local_workflow":
+    case "local_dynamic_workflow":
+      return true;
+    case "monitor_mcp":
+      return false;
+  }
+}
