+test("cold SQLite materialization settles orphan Agent Started as lost after eventStore loss", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-agent-bts-cold-"));
+  const dbPath = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  try {
+    await store.createSession({
+      id: sessionId,
+      projectID: "fixture" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    await persistBackgroundTaskStartedEntry({
+      sessionStore: store,
+      sessionId,
+      event: agentStartedEvent(),
+    });
+    store.close();
+
+    store = new SqliteSessionStore({ dbPath });
+    const source = await loadPersistedConversationMaterialization({
+      memoryEvents: [],
+      sessionId,
+      store: {
+        getSession: (id) => store.getSession(id),
+        messages: (input) => store.messages(input),
+        readTarget: (input) => store.readTarget(input),
+        sessionEntries: (input) => store.sessionEntries(input),
+      },
+    });
+    const completed = source.memoryEvents.filter(
+      (event) => event.type === SessionEventType.BackgroundTaskCompleted,
+    );
+    assert.equal(completed.length, 1);
+    assert.equal((completed[0]?.payload as { status: string }).status, "lost");
+    assert.equal((completed[0]?.payload as { taskKind: string }).taskKind, "subagent");
+
+    const merged = mergeColdConversationEvents({
+      memoryEvents: source.memoryEvents,
+      messages: source.messages,
+      sessionId,
+    });
+    const projection = new ProductProjection(sessionId, "agent-bts-sqlite-cold");
+    for (const event of merged.events) {
+      projection.applyEventAtomically(event, () => true);
+    }
+    const works = projection.getSnapshot().backgroundWorks;
+    assert.equal(works.length, 1);
+    assert.equal(works[0]?.workId, "agent-bt-1");
+    assert.equal(works[0]?.kind, "subagent");
+    assert.equal(works[0]?.status, "failed");
+    assert.notEqual(works[0]?.status, "running");
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
