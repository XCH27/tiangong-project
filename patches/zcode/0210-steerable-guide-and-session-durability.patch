@@ -0,0 +1,129 @@
+import type { SessionEvent, SessionId } from "../deps.js";
+import {
+  synthesizeBackgroundTaskEventsFromBashStopEntries,
+} from "./bash-stop-settlement.js";
+import {
+  synthesizeBackgroundTaskEventsFromCompletedEntries,
+} from "./background-task-completed-settlement.js";
+import {
+  synthesizeLostBackgroundTaskEventsFromStartedEntries,
+} from "./background-task-started-settlement.js";
+import {
+  synthesizeBackgroundTaskEventsFromSubagentStopEntries,
+} from "../../subagent/background-agent-settlement.js";
+import {
+  synthesizeBackgroundTaskEventsFromRemoteHostAttachmentStopEntries,
+} from "./remote-host-attachment-stop-settlement.js";
+
+export {
+  COLD_LIVE_BACKGROUND_TASK_EMIT_TOOL_NAMES,
+  COLD_NON_DURABLE_BACKGROUND_TOOL_NAMES,
+  COLD_RUNTIME_TASK_DURABILITY,
+  coldRuntimeTaskDurabilityPolicy,
+  coldRuntimeTaskTypeHasLiveBackgroundTaskEmit,
+  hasColdLiveBackgroundTaskEmitPath,
+  isColdDurableRuntimeTaskType,
+  isColdNonDurableBackgroundToolName,
+  type ColdRuntimeTaskDurabilityPolicy,
+} from "./cold-runtime-task-durability.js";
+
+/**
+ * Ordered cold backgroundWorks materialization registry (generic reconstruct toehold).
+ *
+ * Winning pattern (see agent-tools compare note): Codex/OpenCode ordered durable
+ * projection + ACP/Cursor never-invent-running across process death + Craft-style
+ * typed orphan honesty. Projector order lives here; per-RuntimeTaskType durability
+ * policy lives in cold-runtime-task-durability.ts so settlement writers share one table.
+ *
+ * Never invents running works. Never restarts a child. Updated Session evidence is
+ * event-driven elsewhere and is intentionally absent from this projector order
+ * (never invents running from Updated). Warm overlays applied after this registry:
+ * (1) journal-gated workflow Started read
+ * (`synthesizeBackgroundTaskEventsFromJournalGatedWorkflowStartedEntries`) only when
+ * listNonTerminalRuns still shows pending/running; (2) Session Updated control overlay
+ * (`synthesizeBackgroundTaskEventsFromUpdatedEntries`) only when warm running evidence
+ * already exists. Neither invents cold running without its gate.
+ *
+ * Explicitly not claimed: dedicated local_workflow / monitor_mcp Session reconstruct
+ * (both non_durable; Session durability is toolName-gated so decorative taskKind bash
+ * cannot piggyback; monitor_mcp has empty emit-path), workflow orphan→lost / inventing
+ * running from Session workflow Started alone (no journal non-terminal),
+ * using Updated as a cold panel projector / inventing running from Updated,
+ * Workflow Updated durability, full MEMORY_ONLY removal, inventing Ready/usable,
+ * live SSH/WSL/Docker/MessagePort (remote stop receipts come from DI fixture / Host
+ * registry events — never invent transport).
+ */
+
+export type ColdBackgroundWorksProjectorId =
+  | "background_task_completed"
+  | "bash_stop"
+  | "subagent_stop"
+  | "remote_host_attachment_stop"
+  | "background_task_started_orphan_lost";
+
+/**
+ * Terminal evidence first; orphan Started → lost Completed last.
+ * Same order previously inlined in loadPersistedConversationMaterialization.
+ */
+export const COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER: readonly ColdBackgroundWorksProjectorId[] =
+  [
+    "background_task_completed",
+    "bash_stop",
+    "subagent_stop",
+    "remote_host_attachment_stop",
+    "background_task_started_orphan_lost",
+  ] as const;
+
+export interface ColdBackgroundWorksSessionEntry {
+  type?: string;
+  data: unknown;
+  time: { created: number };
+}
+
+export interface ColdBackgroundWorksMaterializationInput {
+  entries: readonly ColdBackgroundWorksSessionEntry[];
+  sessionId: SessionId | string;
+  memoryEvents?: readonly SessionEvent[];
+  /** True non-terminal workflow runIds (pending/running; listNonTerminalRuns semantics). */
+  nonTerminalWorkflowRunIds?: ReadonlySet<string>;
+}
+
+type ColdProjector = (input: {
+  entries: readonly ColdBackgroundWorksSessionEntry[];
+  sessionId: SessionId | string;
+  memoryEvents: readonly SessionEvent[];
+  nonTerminalWorkflowRunIds?: ReadonlySet<string>;
+}) => SessionEvent[];
+
+const PROJECTORS: Readonly<Record<ColdBackgroundWorksProjectorId, ColdProjector>> = {
+  background_task_completed: synthesizeBackgroundTaskEventsFromCompletedEntries,
+  bash_stop: synthesizeBackgroundTaskEventsFromBashStopEntries,
+  subagent_stop: synthesizeBackgroundTaskEventsFromSubagentStopEntries,
+  remote_host_attachment_stop: synthesizeBackgroundTaskEventsFromRemoteHostAttachmentStopEntries,
+  background_task_started_orphan_lost: synthesizeLostBackgroundTaskEventsFromStartedEntries,
+};
+
+/**
+ * Run cold backgroundWorks projectors in registry order.
+ * Each step sees prior supplements so covered taskIds win (terminal evidence ≻ orphan).
+ */
+export function projectColdBackgroundWorksEvents(
+  input: ColdBackgroundWorksMaterializationInput,
+): SessionEvent[] {
+  let memoryEvents: SessionEvent[] = [...(input.memoryEvents ?? [])];
+  const projected: SessionEvent[] = [];
+  for (const id of COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER) {
+    const batch = PROJECTORS[id]({
+      entries: input.entries,
+      sessionId: input.sessionId,
+      memoryEvents,
+      ...(input.nonTerminalWorkflowRunIds
+        ? { nonTerminalWorkflowRunIds: input.nonTerminalWorkflowRunIds }
+        : {}),
+    });
+    if (batch.length === 0) continue;
+    projected.push(...batch);
+    memoryEvents = [...memoryEvents, ...batch];
+  }
+  return projected;
+}
