+import assert from "node:assert/strict";
+import test from "node:test";
+import { appSettingsSchema } from "@zcode/shared";
+import { codePreviewLinePrefsFromSettings } from "../src/lib/codePreviewLinePrefsSettings.js";
+import { pageAssistantSettingUiFromWriter } from "../src/lib/pageAssistantSettingUiReflection.js";
+
+test("Appearance code-preview UI cache mirrors Setting writer line prefs", () => {
+  assert.deepEqual(
+    codePreviewLinePrefsFromSettings({ showLineNumbers: false, wrapLongLines: true }),
+    { showLineNumbers: false, wrapLongLines: true },
+  );
+  assert.deepEqual(
+    codePreviewLinePrefsFromSettings({ showLineNumbers: true, wrapLongLines: false }),
+    { showLineNumbers: true, wrapLongLines: false },
+  );
+  // Setting defaults: line numbers on unless explicitly false; wrap off unless explicitly true.
+  assert.deepEqual(
+    codePreviewLinePrefsFromSettings({
+      showLineNumbers: undefined as never,
+      wrapLongLines: undefined as never,
+    }),
+    { showLineNumbers: true, wrapLongLines: false },
+  );
+});
+
+test("Memory / Appearance / General Setting writer results project onto Settings UI controls", () => {
+  const settings = appSettingsSchema.parse({
+    memoryEnabled: true,
+    showLineNumbers: false,
+    wrapLongLines: true,
+    askUserQuestionAutoResolutionEnabled: false,
+    nativeSearchEnhancementsEnabled: false,
+    taskAutoArchiveEnabled: true,
+    taskAutoArchiveOlderThanDays: 14,
+    terminalInheritSystemProfile: false,
+    // Migration markers keep explicit false writer results (one-shot default flips otherwise).
+    closeToTrayOnWindows: false,
+    closeToTrayOnWindowsMigrationInitialized: true,
+    keepAwakeWhileRunning: true,
+    messageStreamShowReasoning: false,
+    messageStreamShowReasoningMigrationInitialized: true,
+    messageStreamShowTodos: true,
+    toolGroupingExploreEnabled: false,
+    toolGroupingTerminalEnabled: false,
+    toolGroupingChangesEnabled: true,
+    zcodeInteractionBehavior: "guide",
+  });
+  assert.deepEqual(pageAssistantSettingUiFromWriter(settings), {
+    memoryEnabled: true,
+    nativeSearchEnhancementsEnabled: false,
+    askUserQuestionAutoResolutionEnabled: false,
+    showLineNumbers: false,
+    wrapLongLines: true,
+    terminalInheritSystemProfile: false,
+    taskAutoArchiveEnabled: true,
+    taskAutoArchiveOlderThanDays: 14,
+    closeToTrayOnWindows: false,
+    keepAwakeWhileRunning: true,
+    messageStreamShowReasoning: false,
+    messageStreamShowTodos: true,
+    toolGroupingExploreEnabled: false,
+    toolGroupingTerminalEnabled: false,
+    toolGroupingChangesEnabled: true,
+    zcodeInteractionBehavior: "guide",
+  });
+});
+
+test("writer defaults keep Memory off and General search/auto-ask/terminal inherits on", () => {
+  const settings = appSettingsSchema.parse({});
+  const ui = pageAssistantSettingUiFromWriter(settings);
+  assert.equal(ui.memoryEnabled, false);
+  assert.equal(ui.nativeSearchEnhancementsEnabled, true);
+  assert.equal(ui.askUserQuestionAutoResolutionEnabled, true);
+  assert.equal(ui.showLineNumbers, true);
+  assert.equal(ui.wrapLongLines, false);
+  assert.equal(ui.terminalInheritSystemProfile, true);
+  assert.equal(ui.taskAutoArchiveEnabled, false);
+  assert.equal(ui.taskAutoArchiveOlderThanDays, 7);
+  assert.equal(ui.closeToTrayOnWindows, true);
+  assert.equal(ui.keepAwakeWhileRunning, false);
+  assert.equal(ui.messageStreamShowReasoning, true);
+  assert.equal(ui.messageStreamShowTodos, false);
+  assert.equal(ui.toolGroupingExploreEnabled, true);
+  assert.equal(ui.toolGroupingTerminalEnabled, true);
+  assert.equal(ui.toolGroupingChangesEnabled, false);
+  assert.equal(ui.zcodeInteractionBehavior, "queue");
+});
