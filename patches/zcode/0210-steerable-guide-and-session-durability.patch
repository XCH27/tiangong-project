+
+function completeSubagentStop(taskId: string): StoppedBackgroundAgentTask {
+  const startedAt = new Date("2026-10-10T21:10:00.000Z");
+  const completedAt = new Date("2026-10-10T21:10:08.000Z");
+  const traceContext = createRootTraceContext({ sessionId });
+  return {
+    task: {
+      agentId: taskId,
+      agentType: "general-purpose",
+      branchGeneration: 0,
+      childSessionId: `child-${taskId}` as never,
+      completedAt,
+      description: "stop settle",
+      isBackgrounded: true,
+      parentSessionId: sessionId,
+      parentToolCallId: `tool-${taskId}`,
+      prompt: "no model",
+      startedAt,
+      status: "killed",
+      taskId,
+      taskType: "local_agent",
+      type: "local_agent",
+      traceContext,
+      turnId: "turn-1" as never,
+    },
+    totalDurationMs: 8000,
+    traceContext,
+    artifactsWritten: true,
+    notificationAttempted: true,
+    backgroundEventEmitted: true,
+    subagentEventEmitted: true,
+    notificationEnqueued: true,
+  };
+}
