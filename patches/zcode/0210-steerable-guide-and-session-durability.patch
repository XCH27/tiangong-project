+import type { TurnInputIntentMetadata } from "../deps.js";
+import type { PromptRuntimeCommand } from "../command-queue.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { createTurnCancelledError } from "../helpers/index.js";
+import { preserveDeferredInputForShutdown } from "./steering.js";
+import { readRuntimeExecutionState } from "../execution-state.js";
+
+/** Legacy FIFO callers have no intent; capture the same facts before later configuration edits. */
+export function captureShutdownIntent(runtime: AgentRuntimeInternal, command: PromptRuntimeCommand): TurnInputIntentMetadata {
+  const id = command.options?.inputId ?? String(command.id);
+  const execution = readRuntimeExecutionState(runtime);
+  return structuredClone(command.options?.intent ?? {
+    sourceCommandId: id, queueItemId: id, clientId: "runtime", kind: "sendText",
+    text: command.options?.displayInput ?? command.input,
+    modelSelection: command.modelSelection,
+    mode: execution.mode === "auto" ? undefined : execution.mode, planEnabled: execution.planEnabled,
+    sharedContextRefs: command.options?.sharedContextRefs,
+    admissionSeq: command.createdAt.getTime(), admittedAt: command.createdAt.getTime(),
+    requestedDelivery: "startNow", admittedDelivery: "startNow",
+  });
+}
+
+/** Retain accepted inputs through the existing durable queue; never infer or replay from shutdown. */
+export async function preserveShutdownQueue(this: AgentRuntimeInternal): Promise<void> {
+  for (const command of this.runtimeCommandQueue.snapshot()) {
+    try {
+      if (command.mode === "prompt") {
+        await this.ensureSessionPersistedForExternalActivity(command.input, { traceContext: command.traceContext });
+        const intent = { ...command.shutdownIntent!, admittedDelivery: "queue" as const };
+        const preserved = await preserveDeferredInputForShutdown.call(this, {
+          input: command.options?.displayInput ?? command.input,
+          inputId: command.options?.inputId, pendingInputId: intent.queueItemId,
+          attachments: command.attachments, intent, delivery: "queue",
+          executionState: command.shutdownExecutionState,
+          commandKind: intent.kind,
+          toolDisallowlist: command.options?.toolDisallowlist,
+          traceContext: command.traceContext,
+        });
+        if (preserved.kind !== "queued") throw new Error("Accepted shutdown input could not be preserved in its Session queue");
+        if (command.startReservation) this.releaseTurnStart(command.startReservation.turnId);
+      }
+      this.runtimeCommandQueue.removeById(command.id);
+      this.runtimeCommandQueue.clearCancelPending(command.id);
+      if ("reject" in command) command.reject(createTurnCancelledError("Session shutting down; accepted input retained"));
+    } catch (error) {
+      if ("reject" in command) command.reject(error);
+      throw error; // Keep the command and store owned when its durable preservation is unknown.
+    }
+  }
+}
