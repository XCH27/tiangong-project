+    steerAllowed: false,
+  });
+  assert.equal(honesty, "not_steerable");
+  assert.equal(isNativeGuideSteerableHonesty(honesty), false);
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+});
+
+test("classify: non-native Pi steerable remains pi_steerable", () => {
+  const honesty = classifyNativeGuideSurfaceHonesty({
+    hasActiveTurn: true,
+    nativeExecutor: false,
+    steerAllowed: true,
+  });
+  assert.equal(honesty, "pi_steerable");
+  assert.equal(isNativeGuideSteerableHonesty(honesty), true);
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+});
+
+test("classify: no active turn", () => {
+  const honesty = classifyNativeGuideSurfaceHonesty({
+    hasActiveTurn: false,
+    nativeExecutor: true,
+    steerAllowed: true,
+  });
+  assert.equal(honesty, "no_active_turn");
+});
+
+test("inputRouting guide mode is steerable, not Ready", () => {
+  const honesty = classifyNativeGuideHonestyFromInputRouting({ mode: "guide" });
+  assert.equal(honesty, "steerable");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+  assert.equal(nativeGuidePendingStatusMessageId(honesty), "chat.message.turnSteer.pendingSteerable");
+});
+
+test("inputRouting reject turn_not_steerable is not_steerable", () => {
+  const honesty = classifyNativeGuideHonestyFromInputRouting({
+    mode: "reject",
+    reasonCode: "turn_not_steerable",
+  });
+  assert.equal(honesty, "not_steerable");
+  assert.equal(nativeGuidePendingStatusMessageId(honesty), "chat.message.turnSteer.pending");
+});
+
+test("inputRouting enqueue/choice are queue_path (no Ready invent)", () => {
+  assert.equal(classifyNativeGuideHonestyFromInputRouting({ mode: "enqueue" }), "queue_path");
+  assert.equal(classifyNativeGuideHonestyFromInputRouting({ mode: "choice" }), "queue_path");
+  assert.equal(classifyNativeGuideHonestyFromInputRouting({ mode: "startNow" }), "no_active_turn");
+});
+
+test("forbidden product labels cannot appear as honesty values", () => {
+  for (const label of NATIVE_GUIDE_FORBIDDEN_PRODUCT_LABELS) {
+    assert.equal(ALL_HONESTY.includes(label as NativeGuideSurfaceHonesty), false);
+    assert.equal(isForbiddenNativeGuideProductLabel(label), true);
+  }
+  for (const honesty of ALL_HONESTY) {
+    assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
+  }
+});
+
+test("projectPendingGuideQueue: guide routing attaches steerable honesty", () => {
+  const queue: QueueState = {
+    items: [guideItem("g1", 1), queueItem("q1", 2)],
+  } as QueueState;
+  const projected = projectPendingGuideQueue(queue, { inputRouting: { mode: "guide" } });
+  assert.equal(projected.pendingGuides.length, 1);
+  assert.equal(projected.visibleQueue.items.length, 1);
+  assert.equal(projected.honesty, "steerable");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(projected.honesty), false);
+  assert.notEqual(projected.honesty, "Ready");
+  assert.notEqual(projected.honesty, "usable");
+});
+
+test("projectPendingGuideQueue: admitted guides without routing still steerable (not Ready)", () => {
+  const queue: QueueState = { items: [guideItem("g1", 1)] } as QueueState;
+  const projected = projectPendingGuideQueue(queue);
+  assert.equal(projected.honesty, "steerable");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(projected.honesty), false);
+});
+
+test("projectPendingGuideQueue: empty queue without routing is no_active_turn", () => {
+  const queue: QueueState = { items: [] } as QueueState;
+  const projected = projectPendingGuideQueue(queue);
+  assert.equal(projected.honesty, "no_active_turn");
+});
+
+test("control.steerable true + guide routing is steerable, never Ready", () => {
+  const honesty = classifyNativeGuideHonestyFromSnapshotControl({
+    inputRouting: { mode: "guide" },
+    steerable: true,
+  });
+  assert.equal(honesty, "steerable");
+  assert.equal(nativeGuideHonestyAllowsProductUsable(honesty), false);
