+import assert from "node:assert/strict";
+import test from "node:test";
+import { nativeGuideSteerAllowed } from "../src/runtime/methods/native-guide-tool-boundary-honesty.js";
+import { call, fixture, reply, selection } from "./helpers/pi-runtime-fixture.js";
+
+/**
+ * Prove: while a Host tool callback is outstanding (permission / handler await),
+ * steerTurn(delivery: guide) immediately calls vendor deliverGuideAtToolBoundary
+ * — not only after the Host tool batch settles. Gate may be open (steerable paths
+ * proved); does not invent product Ready. No double-deliver on post-batch drain.
+ */
+
+test("steerTurn immediate vendor deliverGuideAtToolBoundary while Host tool callback outstanding", async () => {
+  assert.equal(nativeGuideSteerAllowed(), true, "checklist must be fully proved");
+
+  const delivered: string[] = [];
+  const deliverCalls: number[] = [];
+  const toolEntered = Promise.withResolvers<void>();
+  const releaseTool = Promise.withResolvers<void>();
+
+  const f = await fixture(undefined, false, {
+    nativeExecutor: { kind: "claude", accountId: "fixture-immediate-steer" } as never,
+  });
+  f.permissionWith(async () => {
+    toolEntered.resolve();
+    await releaseTool.promise;
+    return { decision: "allow" } as never;
+  });
+
+  try {
+    const runtime = f.runtime as any;
+    runtime.nativeAgentPort = {
+      createTurn(request: any) {
+        return {
+          model: request.model,
+          async admitNextStep() {},
+          retainToolReceipts() {},
+          async deliverGuideAtToolBoundary(text: string) {
+            const trimmed = text.trim();
+            if (!trimmed) return "unavailable" as const;
+            deliverCalls.push(Date.now());
+            delivered.push(trimmed);
+            return "delivered" as const;
+          },
+          async close() {},
+        };
+      },
+    };
+
+    f.steps.push(
+      () => reply("need probe", [call("probe-imm-1", "native-approved")]),
+      () => reply("after immediate guide"),
+    );
+
+    const running = runtime.executeTurn("Original native tool turn", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+
+    await toolEntered.promise;
+    assert.equal(runtime.activeTurn?.steerable, true);
+    assert.ok(
+      (runtime.activeTurn?.hostToolCallbacksOutstanding ?? 0) > 0,
+      "Host tool callback must be outstanding during permission wait",
+    );
+    assert.equal(
+      typeof runtime.activeTurn?.deliverNativeGuideAtToolBoundary,
+      "function",
+      "activeTurn must expose vendor deliver hook for steerTurn",
+    );
+
+    const guide = await runtime.steerTurn({
+      input: "Immediate Guide while tool outstanding",
+      delivery: "guide",
+    });
+    assert.equal(guide.kind, "queued");
+
+    // Preferred path: vendor sees Guide before the Host tool batch settles.
+    assert.deepEqual(
+      delivered,
+      ["Immediate Guide while tool outstanding"],
+      "steerTurn must immediate-deliver via vendor while tool callback outstanding",
+    );
+    assert.equal(deliverCalls.length, 1);
+    assert.ok(
+      runtime.activeTurn?.nativeGuideVendorDeliveredIds?.has(guide.pendingInputId),
+      "pending Guide id must be marked vendor-delivered to prevent double-deliver",
+    );
+
+    releaseTool.resolve();
+    const result = await running;
+
+    assert.equal(result.response, "after immediate guide");
+    // Post-batch drain must Host-account without calling vendor deliver again.
+    assert.deepEqual(delivered, ["Immediate Guide while tool outstanding"]);
+    assert.equal(deliverCalls.length, 1, "must not double-deliver on post-batch drain");
+    assert.equal(runtime.activeTurn, undefined);
+  } finally {
+    releaseTool.resolve();
+    await f.close();
+  }
+});
+
+test("steerTurn does not immediate-deliver when no Host tool callback is outstanding", async () => {
+  assert.equal(nativeGuideSteerAllowed(), true);
+
+  const delivered: string[] = [];
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+
+  const f = await fixture(undefined, false, {
+    nativeExecutor: { kind: "codex", accountId: "fixture-no-outstanding" } as never,
+  });
+
+  try {
+    const runtime = f.runtime as any;
+    let first = true;
+    runtime.nativeAgentPort = {
+      createTurn(request: any) {
+        return {
+          model: request.model,
+          async admitNextStep() {
+            if (!first) return;
+            first = false;
+            entered.resolve();
+            await release.promise;
+          },
+          retainToolReceipts() {},
+          async deliverGuideAtToolBoundary(text: string) {
+            delivered.push(text.trim());
+            return "delivered" as const;
+          },
+          async close() {},
+        };
+      },
+    };
+
+    f.steps.push(
+      () => reply("model step blocked before tools"),
+      () => reply("after queued guide"),
+    );
+
+    const running = runtime.executeTurn("Native pre-tool input", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+    await entered.promise;
+    assert.equal(runtime.activeTurn?.hostToolCallbacksOutstanding ?? 0, 0);
+
+    const guide = await runtime.steerTurn({
+      input: "Guide before any tool callback",
+      delivery: "guide",
+    });
+    assert.equal(guide.kind, "queued");
+    assert.deepEqual(
+      delivered,
+      [],
+      "without outstanding tool callback, steerTurn must not immediate-deliver",
+    );
+
+    release.resolve();
+    await running;
+    // No tool batch → text-only / continuation path; vendor may still be unused here.
+    // Immediate path must stay skipped; do not invent Ready.
+    assert.ok(delivered.length <= 1);
+  } finally {
+    release.resolve();
+    await f.close();
+  }
+});
