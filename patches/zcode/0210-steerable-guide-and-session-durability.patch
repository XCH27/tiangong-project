+import { ProductProjection } from "../../bootstrap/src/zcode-protocol-v4/product-projection.js";
+import {
+  loadPersistedConversationMaterialization,
+  mergeColdConversationEvents,
+} from "../../bootstrap/src/zcode-protocol-v4/cold-event-merge.js";
+import {
+  COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER,
+  COLD_LIVE_BACKGROUND_TASK_EMIT_TOOL_NAMES,
+  COLD_NON_DURABLE_BACKGROUND_TOOL_NAMES,
+  COLD_RUNTIME_TASK_DURABILITY,
+  coldRuntimeTaskDurabilityPolicy,
+  coldRuntimeTaskTypeHasLiveBackgroundTaskEmit,
+  hasColdLiveBackgroundTaskEmitPath,
+  isColdDurableRuntimeTaskType,
+  isColdNonDurableBackgroundToolName,
+  projectColdBackgroundWorksEvents,
+} from "../src/runtime/methods/cold-background-works-materialization.js";
+import {
+  durableBackgroundTaskCompletedPayload,
+  persistBackgroundTaskCompletedEntry,
+} from "../src/runtime/methods/background-task-completed-settlement.js";
+import {
+  durableBackgroundTaskStartedPayload,
+  persistBackgroundTaskStartedEntry,
+} from "../src/runtime/methods/background-task-started-settlement.js";
+import { persistStoppedBashBackgroundTask } from "../src/runtime/methods/bash-stop-settlement.js";
+import {
+  SUBAGENT_STOP_SESSION_ENTRY,
+  backgroundStopKey,
+  type StoppedBackgroundAgentTask,
+} from "../src/subagent/background-agent-settlement.js";
+
+const sessionId = "cold-materialization-registry" as never;
+
+test("materialization order is completed → bash_stop → subagent_stop → remote_host_attachment_stop → orphan Started lost", () => {
+  assert.deepEqual([...COLD_BACKGROUND_WORKS_MATERIALIZATION_ORDER], [
+    "background_task_completed",
