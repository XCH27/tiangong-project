+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import {
+  NATIVE_GUIDE_TOOL_BOUNDARY_PATHS,
+  nativeGuideSteerAllowed,
+} from "../src/runtime/methods/native-guide-tool-boundary-honesty.js";
+import { call, fixture, reply, selection } from "./helpers/pi-runtime-fixture.js";
+
+/**
+ * Prove host_tool_batch_drain + text_only_no_tool_fallback for native:
+ * - After a Host tool batch, pending Guide rides vendor deliverGuideAtToolBoundary
+ *   (drainNativeGuideAtHostToolBatch) — not Host-history inject into a once-started Query.
+ * - stop-turn after immediate vendor deliver Host-drains (no queue fallback);
+ *   when vendor deliver is unavailable, Guide falls back (guide.noToolBoundary).
+ * Gate may be open (steerable paths proved); does not invent product Ready.
+ */
+
+test("native Host tool-batch drains Guide via deliverGuideAtToolBoundary", async () => {
+  assert.equal(nativeGuideSteerAllowed(), true, "checklist must be fully proved");
+
+  const delivered: string[] = [];
+  const toolEntered = Promise.withResolvers<void>();
+  const releaseTool = Promise.withResolvers<void>();
+
+  const f = await fixture(undefined, false, {
+    nativeExecutor: { kind: "claude", accountId: "fixture-host-batch-drain" } as never,
+  });
+  f.permissionWith(async () => {
+    toolEntered.resolve();
+    await releaseTool.promise;
+    return { decision: "allow" } as never;
+  });
+
+  try {
+    const runtime = f.runtime as any;
+    runtime.nativeAgentPort = {
+      createTurn(request: any) {
+        return {
+          model: request.model,
+          async admitNextStep() {},
+          retainToolReceipts() {},
+          async deliverGuideAtToolBoundary(text: string) {
+            const trimmed = text.trim();
+            if (!trimmed) return "unavailable" as const;
+            delivered.push(trimmed);
+            return "delivered" as const;
+          },
+          async close() {},
+        };
+      },
+    };
+
+    f.steps.push(
+      () => reply("need probe", [call("probe-1", "native-approved")]),
+      () => reply("after guide drain"),
+    );
+
+    const running = runtime.executeTurn("Original native tool turn", [], {
+      intent: { modelSelection: selection(), allowAutomaticModelSelection: false },
+    });
+
+    await toolEntered.promise;
+    assert.equal(runtime.activeTurn?.steerable, true, "gate open: native steerable paths proved");
+
+    const guide = await runtime.steerTurn({
+      input: "Host-batch Guide for vendor",
+      delivery: "guide",
+    });
+    assert.equal(guide.kind, "queued");
+    assert.ok(
+      runtime.activeTurn?.pendingInputs.some(
+        (item: any) => item.delivery === "guide" && item.input.includes("Host-batch Guide"),
+      ),
+      "Guide must sit in pending until Host tool batch drain",
+    );
+
+    releaseTool.resolve();
+    const result = await running;
+
+    assert.equal(result.response, "after guide drain");
+    assert.deepEqual(delivered, ["Host-batch Guide for vendor"]);
+    assert.equal(runtime.activeTurn, undefined);
+    // Drained Guide is Host-accounted via persistUserPrompt; it must not remain
+    // as an undrained guide lane on a live turn.
+    assert.equal(
+      (runtime.activeTurn?.pendingInputs ?? []).filter((item: any) => item.delivery === "guide")
+        .length,
+      0,
+    );
+  } finally {
+    releaseTool.resolve();
+    await f.close();
+  }
+});
+
+test("native stop-turn after immediate vendor deliver Host-drains (no queue fallback / no double-deliver)", async () => {
+  assert.equal(nativeGuideSteerAllowed(), true);
+
+  const delivered: string[] = [];
+  const toolEntered = Promise.withResolvers<void>();
+  const releaseTool = Promise.withResolvers<void>();
+
+  const f = await fixture(undefined, false, {
