diff --git a/packages/desktop/test/helpers/remote-host-attachment-stop-fixture.ts b/packages/desktop/test/helpers/remote-host-attachment-stop-fixture.ts
new file mode 100644
index 00000000..4ac038f2
--- /dev/null
+++ b/packages/desktop/test/helpers/remote-host-attachment-stop-fixture.ts
@@ -0,0 +1,529 @@
+import { EventEmitter } from "node:events";
+import type { WindowHostAttachmentScope } from "@zcode/shared";
+import type { ZCodeAgentV4ClientMode } from "@zcode/services";
+import { createWindowHostAttachmentRegistry } from "../../src/host/windowHostAttachmentRegistry.js";
+import {
+  createWindowRemoteConnectionRegistry,
+  type WindowRemoteConnectionCloseEvent,
+  type WindowRemoteConnectionHandle,
+} from "../../src/host/windowRemoteConnectionRegistry.js";
+
+/**
+ * Injectable remote Host / attachment Stop lifetime fixture.
+ *
+ * Proves registry dispose/detach/close composition without a live SSH/WSL/Docker
+ * transport, Electron MessagePort, or real remote process tree. The Host wiring
+ * contract under test is: connection close → onSessionClosed → detach attachments.
+ * WSL idle TTL is short (wslIdleTtlMs) so unit proofs can observe scheduled dispose
+ * without inventing remote process-tree termination.
+ *
+ * MessagePort-shaped attachment ports mirror Electron MessagePortMain surface used by
+ * Host attach (once("close") / close() / start() / postMessage) without importing
+ * electron — MessagePort close disposes the expose handle; Host Stop
+ * (session_detach / transport_close / idle_dispose) owns Session writes via glue +
+ * product bind. Never invents live MessagePort RPC or remote process-tree discovery.
+ *
+ * Optional Session cold-writer DI: onStopReceipt fires honest detach / transport_close /
+ * idle_dispose receipts (same shape as core remote-host-attachment-stop-settlement).
+ * Production Host uses registry onIdleDispose → glue notifyStopped(idle_dispose);
+ * fixture handle.dispose DI remains for registry-only stopReceipt proofs.
+ * resolveLinkedTasks may attach bash/subagent task ids for cold backgroundWorks
+ * projection — never invents live remote process-tree discovery.
+ */
+export type FixtureServices = { id: string };
+export type FixtureCapabilities = { label: string };
+
+export type FixtureStopReason =
+  | "session_detach"
+  | "transport_close"
+  | "idle_dispose"
+  | "dispose_remote";
+
+export type FixtureStopTargetKind = "docker" | "ssh" | "wsl";
+
+export interface FixtureStopLinkedTask {
+  taskId: string;
+  toolName: "Bash" | "Agent" | "Task";
+  taskKind: "bash" | "subagent";
+  status: "cancelled" | "lost";
+  description?: string;
+  command?: string;
+  toolCallId?: string;
+  startedAt?: number;
+  completedAt?: number;
+  traceId?: string;
+}
+
+export interface FixtureStopReceipt {
+  remoteSessionId: string;
+  reason: FixtureStopReason;
+  targetKind?: FixtureStopTargetKind;
+  attachmentIds: string[];
+  stoppedAt: number;
+  linkedTasks?: FixtureStopLinkedTask[];
+}
+
+/**
+ * MessagePortMain-shaped attachment port for Host registry proofs.
+ * Matches the Host attach surface (EventEmitter once("close"), close/start/postMessage)
+ * without importing electron or inventing live MessagePort RPC.
+ */
+export interface MessagePortShapedAttachmentPort extends EventEmitter {
+  /** True after close(); further close()/emitClose() are no-ops (MessagePortMain honesty). */
+  readonly closed: boolean;
+  /** MessagePortMain.close — emits "close" once; Host registry dispose listens here. */
+  close(): void;
+  /** MessagePortMain.start — no-op in fixture (RPC handshake not invented). */
+  start(): void;
+  /** MessagePortMain.postMessage — records payloads; does not invent ChannelServer RPC. */
+  postMessage(data: unknown): void;
+  /** Test helper alias for close() (kept for older fixture callers). */
+  emitClose(): void;
+  /** Payloads passed to postMessage (fixture inspection only). */
+  readonly posted: unknown[];
+}
+
+/** @deprecated Prefer MessagePortShapedAttachmentPort — same shape. */
+export type FakeAttachmentPort = MessagePortShapedAttachmentPort;
+
+export function createMessagePortShapedAttachmentPort(): MessagePortShapedAttachmentPort {
+  const emitter = new EventEmitter() as MessagePortShapedAttachmentPort;
+  const posted: unknown[] = [];
+  let closed = false;
+  Object.defineProperty(emitter, "closed", {
+    get: () => closed,
+    enumerable: true,
+  });
+  Object.defineProperty(emitter, "posted", {
+    get: () => posted,
+    enumerable: true,
+  });
+  emitter.start = () => {
+    // MessagePortMain.start is required before message delivery; fixture has no RPC.
+  };
+  emitter.postMessage = (data: unknown) => {
+    if (closed) return;
+    posted.push(data);
+  };
+  emitter.close = () => {
+    if (closed) return;
+    closed = true;
+    emitter.emit("close");
+  };
+  emitter.emitClose = () => {
+    emitter.close();
+  };
+  return emitter;
+}
+
+/** Alias — MessagePort-shaped is the default fake attachment port. */
+export function createFakeAttachmentPort(): MessagePortShapedAttachmentPort {
+  return createMessagePortShapedAttachmentPort();
+}
+
+export function remoteScope(
+  remoteSessionId: string,
+  workspacePath = "/remote/ws",
+  workspaceIdentity = "remote-ws-id",
+): Extract<WindowHostAttachmentScope, { kind: "remote" }> {
+  return {
+    kind: "remote",
+    remoteSessionId,
+    workspacePath,
+    workspaceIdentity,
+  };
+}
+
+export function remoteHostAttachmentStopFixture(options?: {
+  /** When true, connect() hangs until abort/cancel (for late-success / cancel cases). */
+  hangConnect?: boolean;
+  clientMode?: ZCodeAgentV4ClientMode;
+  /** Session cold-writer DI: called with honest stop/detach/idle receipts. */
+  onStopReceipt?: (receipt: FixtureStopReceipt) => void;
+  /** Optional linked bash/subagent tasks for cold backgroundWorks projection. */
+  resolveLinkedTasks?: (remoteSessionId: string) => FixtureStopLinkedTask[] | undefined;
+  /**
+   * Production-shaped WSL idle reclaim hook (registry onIdleDispose). Prefer this over
+   * handle.dispose DI when proving Host→glue notifyStopped(idle_dispose).
+   */
+  onIdleDispose?: (event: {
+    remoteSessionIds: string[];
+    idleReason: string;
+    targetKind: "wsl";
+  }) => void;
+}) {
+  const clientMode = options?.clientMode ?? "desktop-continuous";
+  const disposedHandles: string[] = [];
+  const disposedConnections: string[] = [];
+  const sessionClosed: Array<WindowRemoteConnectionCloseEvent & { remoteSessionId: string }> = [];
+  const stopReceipts: FixtureStopReceipt[] = [];
+  const exposeCalls: Array<{
+    attachmentId: string;
+    remoteSessionId?: string;
+    generation: number;
+  }> = [];
+
+  let nextId = 1;
+  const createId = () => `remote-session-${nextId++}`;
+  const connectionIdBySession = new Map<string, string>();
+  const closeEmitters = new Map<string, EventEmitter>();
+  const targetKindBySession = new Map<string, FixtureStopTargetKind>();
+  const sessionByConnection = new Map<
+    string,
+    { remoteSessionId: string; targetKind: FixtureStopTargetKind; logicalSessionGone: boolean }
+  >();
+  let suppressDetachReceipt = false;
+
+  function emitStopReceipt(partial: {
+    remoteSessionId: string;
+    reason: FixtureStopReason;
+    attachmentIds: string[];
+    targetKind?: FixtureStopTargetKind;
+  }): void {
+    const linked = options?.resolveLinkedTasks?.(partial.remoteSessionId);
+    const receipt: FixtureStopReceipt = {
+      remoteSessionId: partial.remoteSessionId,
+      reason: partial.reason,
+      ...(partial.targetKind !== undefined ? { targetKind: partial.targetKind } : {}),
+      attachmentIds: [...partial.attachmentIds],
+      stoppedAt: Date.now(),
+      ...(linked && linked.length > 0 ? { linkedTasks: linked } : {}),
+    };
+    stopReceipts.push(receipt);
+    options?.onStopReceipt?.(receipt);
+  }
+
+  function attachmentIdsForRemoteSession(remoteSessionId: string): string[] {
+    return attachmentRegistry
+      .list()
+      .filter(
+        (row) =>
+          row.scope.kind === "remote" && row.scope.remoteSessionId === remoteSessionId,
+      )
+      .map((row) => row.attachmentId);
+  }
+
+  type PendingConnect = {
+    resolve: (handle: WindowRemoteConnectionHandle<FixtureServices, FixtureCapabilities>) => void;
+    reject: (error: unknown) => void;
+    signal: AbortSignal;
+    connectionId: string;
+  };
+  const pendingConnects: PendingConnect[] = [];
+
+  function buildHandle(
+    connectionId: string,
+  ): WindowRemoteConnectionHandle<FixtureServices, FixtureCapabilities> {
+    const closeEmitter = new EventEmitter();
+    closeEmitters.set(connectionId, closeEmitter);
+    return {
+      services: { id: connectionId },
+      capabilities: { label: connectionId },
+      dispose() {
+        disposedConnections.push(connectionId);
+        closeEmitters.delete(connectionId);
+        const meta = sessionByConnection.get(connectionId);
+        sessionByConnection.delete(connectionId);
+        // WSL idle reclaim after logical session leave — durable idle_dispose receipt.
+        if (meta?.logicalSessionGone && meta.targetKind === "wsl") {
+          emitStopReceipt({
+            remoteSessionId: meta.remoteSessionId,
+            reason: "idle_dispose",
+            targetKind: "wsl",
+            attachmentIds: [],
+          });
+        }
+      },
+      onDidClose(listener) {
+        const wrapped = (event: WindowRemoteConnectionCloseEvent) => listener(event);
+        closeEmitter.on("close", wrapped);
+        return {
+          dispose() {
+            closeEmitter.off("close", wrapped);
+          },
+        };
+      },
+    };
+  }
+
+  // Declaration order: attachment resolveScope calls connectionRegistry.
+  let connectionRegistry!: ReturnType<
+    typeof createWindowRemoteConnectionRegistry<FixtureServices, FixtureCapabilities>
+  >;
+
+  const attachmentRegistry = createWindowHostAttachmentRegistry<
+    FixtureServices,
+    FakeAttachmentPort,
+    FixtureCapabilities
+  >({
+    resolveScope(scope) {
+      if (scope.kind === "local") {
+        return {
+          services: { id: "local" },
+          generation: 0,
+          capabilities: { label: "local" },
+        };
+      }
+      const services = connectionRegistry.resolveScopedServices(scope);
+      const session = connectionRegistry.getSession(scope.remoteSessionId);
+      if (!session) {
+        throw new Error(`remote session missing for attachment resolve: ${scope.remoteSessionId}`);
+      }
+      return {
+        services,
+        generation: session.generation,
+        capabilities: connectionRegistry.resolveScopedCapabilities(scope),
+      };
+    },
+    expose(params) {
+      exposeCalls.push({
+        attachmentId: params.attachmentId,
+        remoteSessionId: params.scope.kind === "remote" ? params.scope.remoteSessionId : undefined,
+        generation: params.generation,
+      });
+      let disposed = false;
+      return {
+        dispose() {
+          if (disposed) return;
+          disposed = true;
+          disposedHandles.push(params.attachmentId);
+        },
+      };
+    },
+  });
+
+  connectionRegistry = createWindowRemoteConnectionRegistry<FixtureServices, FixtureCapabilities>({
+    createId,
+    wslIdleTtlMs: 5,
+    ...(options?.onIdleDispose ? { onIdleDispose: options.onIdleDispose } : {}),
+    async connect(request) {
+      const connectionId = `conn-${nextId++}`;
+      if (options?.hangConnect) {
+        return new Promise((resolve, reject) => {
+          const pending: PendingConnect = {
+            connectionId,
+            signal: request.signal,
+            resolve: (handle) => resolve(handle),
+            reject,
+          };
+          pendingConnects.push(pending);
+          const onAbort = () => {
+            const idx = pendingConnects.indexOf(pending);
+            if (idx >= 0) pendingConnects.splice(idx, 1);
+            reject(Object.assign(new Error("connect aborted"), { name: "AbortError" }));
+          };
+          if (request.signal.aborted) {
+            onAbort();
+            return;
+          }
+          request.signal.addEventListener("abort", onAbort, { once: true });
+        });
+      }
+      if (request.signal.aborted) {
+        throw Object.assign(new Error("connect aborted"), { name: "AbortError" });
+      }
+      return buildHandle(connectionId);
+    },
+    onSessionClosed(event) {
+      sessionClosed.push(event);
+      const attachmentIds = attachmentIdsForRemoteSession(event.remoteSessionId);
+      const targetKind = targetKindBySession.get(event.remoteSessionId);
+      // Host contract under test: logical session offline → detach all clientMode attachments.
+      // Emit transport_close before detach; suppress the wrapped session_detach duplicate.
+      suppressDetachReceipt = true;
+      try {
+        attachmentRegistry.detachRemoteSessionAttachments(event.remoteSessionId);
+      } finally {
+        suppressDetachReceipt = false;
+      }
+      emitStopReceipt({
+        remoteSessionId: event.remoteSessionId,
+        reason: "transport_close",
+        ...(targetKind !== undefined ? { targetKind } : {}),
+        attachmentIds,
+      });
+      const connectionId = connectionIdBySession.get(event.remoteSessionId);
+      if (connectionId) {
+        const meta = sessionByConnection.get(connectionId);
+        if (meta) meta.logicalSessionGone = true;
+      }
+    },
+  });
+
+  // Wrap detach so DisposeRemote / explicit detach persist session_detach receipts.
+  const rawDetachRemote = attachmentRegistry.detachRemoteSessionAttachments.bind(
+    attachmentRegistry,
+  );
+  attachmentRegistry.detachRemoteSessionAttachments = (remoteSessionId: string) => {
+    const attachmentIds = attachmentIdsForRemoteSession(remoteSessionId);
+    const targetKind = targetKindBySession.get(remoteSessionId);
+    rawDetachRemote(remoteSessionId);
+    if (!suppressDetachReceipt) {
+      emitStopReceipt({
+        remoteSessionId,
+        reason: "session_detach",
+        ...(targetKind !== undefined ? { targetKind } : {}),
+        attachmentIds,
+      });
+    }
+  };
+
+  const rawDisposeSession = connectionRegistry.disposeSession.bind(connectionRegistry);
+  connectionRegistry.disposeSession = async (remoteSessionId: string) => {
+    const connectionId = connectionIdBySession.get(remoteSessionId);
+    await rawDisposeSession(remoteSessionId);
+    if (connectionId) {
+      const meta = sessionByConnection.get(connectionId);
+      if (meta) meta.logicalSessionGone = true;
+    }
+    targetKindBySession.delete(remoteSessionId);
+  };
+
+  async function rememberSessionConnection<T extends { remoteSessionId: string }>(
+    descriptor: T,
+    targetKind: FixtureStopTargetKind,
+  ): Promise<T> {
+    const services = connectionRegistry.resolveScopedServices(
+      remoteScope(
+        descriptor.remoteSessionId,
+        (descriptor as { workspacePath?: string }).workspacePath ?? "/remote/ws",
+        (descriptor as { workspaceIdentity?: string }).workspaceIdentity ?? "remote-ws-id",
+      ),
+    );
+    connectionIdBySession.set(descriptor.remoteSessionId, services.id);
+    targetKindBySession.set(descriptor.remoteSessionId, targetKind);
+    sessionByConnection.set(services.id, {
+      remoteSessionId: descriptor.remoteSessionId,
+      targetKind,
+      logicalSessionGone: false,
+    });
+    return descriptor;
+  }
+
+  return {
+    clientMode,
+    attachmentRegistry,
+    connectionRegistry,
+    disposedHandles,
+    disposedConnections,
+    sessionClosed,
+    stopReceipts,
+    exposeCalls,
+    createFakeAttachmentPort,
+    createMessagePortShapedAttachmentPort,
+    remoteScope,
+    async connectDocker(params?: {
+      requestId?: string;
+      workspacePath?: string;
+      workspaceIdentity?: string;
+      container?: string;
+    }) {
+      const descriptor = await connectionRegistry.connect({
+        requestId: params?.requestId ?? `req-${nextId++}`,
+        target: { kind: "docker", container: params?.container ?? "fixture-container" },
+        remoteAssets: {},
+        workspacePath: params?.workspacePath ?? "/remote/ws",
+        workspaceIdentity: params?.workspaceIdentity ?? "remote-ws-id",
+      });
+      return rememberSessionConnection(descriptor, "docker");
+    },
+    async connectSsh(params?: {
+      requestId?: string;
+      workspacePath?: string;
+      workspaceIdentity?: string;
+    }) {
+      const descriptor = await connectionRegistry.connect({
+        requestId: params?.requestId ?? `req-${nextId++}`,
+        target: { kind: "ssh", host: "fixture.example", username: "fixture" },
+        remoteAssets: {},
+        workspacePath: params?.workspacePath ?? "/remote/ws",
+        workspaceIdentity: params?.workspaceIdentity ?? "remote-ws-id",
+      });
+      return rememberSessionConnection(descriptor, "ssh");
+    },
+    async connectWsl(params?: {
+      requestId?: string;
+      workspacePath?: string;
+      workspaceIdentity?: string;
+      distro?: string;
+      user?: string;
+    }) {
+      const descriptor = await connectionRegistry.connect({
+        requestId: params?.requestId ?? `req-${nextId++}`,
+        target: {
+          kind: "wsl",
+          distro: params?.distro ?? "Ubuntu",
+          ...(params?.user === undefined ? {} : { user: params.user }),
+        },
+        remoteAssets: {},
+        workspacePath: params?.workspacePath ?? "/remote/ws",
+        workspaceIdentity: params?.workspaceIdentity ?? "remote-ws-id",
+      });
+      return rememberSessionConnection(descriptor, "wsl");
+    },
+    attachRemote(params: {
+      attachmentId: string;
+      remoteSessionId: string;
+      workspacePath?: string;
+      workspaceIdentity?: string;
+      port?: FakeAttachmentPort;
+      requestId?: string;
+    }) {
+      const port = params.port ?? createFakeAttachmentPort();
+      attachmentRegistry.attach({
+        requestId: params.requestId ?? `attach-req-${nextId++}`,
+        attachmentId: params.attachmentId,
+        clientMode,
+        scope: remoteScope(
+          params.remoteSessionId,
+          params.workspacePath,
+          params.workspaceIdentity,
+        ),
+        port,
+      });
+      return port;
+    },
+    attachLocal(params: { attachmentId: string; port?: FakeAttachmentPort }) {
+      const port = params.port ?? createFakeAttachmentPort();
+      attachmentRegistry.attach({
+        requestId: `attach-req-${nextId++}`,
+        attachmentId: params.attachmentId,
+        clientMode,
+        scope: { kind: "local" },
+        port,
+      });
+      return port;
+    },
+    /** Complete a hung connect with success (late transport success after cancel). */
+    resolveHungConnect() {
+      const pending = pendingConnects.shift();
+      if (!pending) throw new Error("no hung connect to resolve");
+      pending.resolve(buildHandle(pending.connectionId));
+      return pending.connectionId;
+    },
+    emitTransportClose(
+      connectionId: string,
+      event: WindowRemoteConnectionCloseEvent = { exitCode: 1, signal: null },
+    ) {
+      const emitter = closeEmitters.get(connectionId);
+      if (!emitter) {
+        throw new Error(`no close emitter for ${connectionId}`);
+      }
+      emitter.emit("close", event);
+    },
+    emitTransportCloseForSession(
+      remoteSessionId: string,
+      event: WindowRemoteConnectionCloseEvent = { exitCode: 0, signal: "SIGTERM" },
+    ) {
+      const connectionId = connectionIdBySession.get(remoteSessionId);
+      if (!connectionId) {
+        throw new Error(`no connection id remembered for ${remoteSessionId}`);
+      }
+      this.emitTransportClose(connectionId, event);
+    },
+    async close() {
+      attachmentRegistry.dispose();
+      await connectionRegistry.dispose();
+    },
+  };
+}
