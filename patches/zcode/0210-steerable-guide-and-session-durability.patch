+      ...receipt(),
+      linkedTasks: [
+        {
+          taskId: "bash-1",
+          toolName: "Bash",
+          taskKind: "bash",
+          status: "running",
+        },
+      ],
+    }),
+    undefined,
+  );
+  const ok = restoreRemoteHostAttachmentStopReceipt(
+    receipt({
+      linkedTasks: [
+        {
+          taskId: "bash-1",
+          toolName: "Bash",
+          taskKind: "bash",
+          status: "cancelled",
+          description: "remote bash stopped with host detach",
+        },
