+const sessionId = "agent-bt-parent" as never;
+
+function agentStartedEvent(): SessionEvent {
+  return createSessionEvent(
+    SessionEventType.BackgroundTaskStarted,
+    sessionId,
+    {
+      taskId: "agent-bt-1",
+      toolCallId: "tool-agent-bt-1",
+      toolName: "Agent",
+      taskKind: "subagent" as const,
+      childSessionId: "child-agent-bt-1" as never,
+      cancellable: true,
+      description: "explore in background",
+      status: "running" as const,
+      startedAt: new Date("2026-10-10T21:10:00.000Z"),
+      outputPath: "/tmp/agent-bt-1.out",
+      terminalId: "agent-bt-1",
+    },
+    { traceId: "trace-agent-bt-1" as never, sequenceNumber: 4 },
+  );
+}
+
+function agentCompletedEvent(
+  status: "completed" | "failed" | "cancelled" = "completed",
+): SessionEvent {
+  return createSessionEvent(
+    SessionEventType.BackgroundTaskCompleted,
+    sessionId,
+    {
+      taskId: "agent-bt-1",
+      toolCallId: "tool-agent-bt-1",
+      toolName: "Agent",
+      taskKind: "subagent" as const,
+      childSessionId: "child-agent-bt-1" as never,
+      cancellable: false,
+      description: "explore in background",
+      status,
+      startedAt: new Date("2026-10-10T21:10:00.000Z"),
+      completedAt: new Date("2026-10-10T21:10:08.000Z"),
+      outputPath: "/tmp/agent-bt-1.out",
+      terminalId: "agent-bt-1",
+    },
+    { traceId: "trace-agent-bt-1" as never, sequenceNumber: 9 },
+  );
