+} from "../../bootstrap/src/zcode-protocol-v4/cold-event-merge.js";
+import {
+  SUBAGENT_STOP_SESSION_ENTRY,
+  backgroundStopKey,
+  backgroundTaskStatusFromSubagentStop,
+  isCompleteStoppedBackgroundAgentSettlement,
+  restoreStoppedBackgroundAgentTask,
+  synthesizeBackgroundTaskEventsFromSubagentStopEntries,
+  type StoppedBackgroundAgentTask,
+} from "../src/subagent/background-agent-settlement.js";
+
+const sessionId = "agent-proj-parent" as never;
+
+function stoppedAgent(
+  flags: {
+    complete?: boolean;
+    resumePending?: boolean;
+  } = {},
+): StoppedBackgroundAgentTask {
+  const startedAt = new Date("2026-10-10T19:00:00.000Z");
+  const completedAt = new Date("2026-10-10T19:00:08.000Z");
+  const traceContext = createRootTraceContext({ sessionId });
+  const complete = flags.complete !== false && !flags.resumePending;
+  return {
+    task: {
+      agentId: "agent-proj-1",
+      agentType: "general-purpose",
+      branchGeneration: 0,
+      childSessionId: "child-sess-1" as never,
+      completedAt,
+      description: "owned stop projection fixture",
+      isBackgrounded: true,
+      parentSessionId: sessionId,
+      parentToolCallId: "tool-agent-1",
+      prompt: "no model",
+      startedAt,
+      status: "killed",
+      taskId: "agent-proj-1",
+      taskType: "local_agent",
+      type: "local_agent",
+      traceContext,
+      turnId: "turn-1" as never,
+    },
+    totalDurationMs: 8000,
+    traceContext,
+    artifactsWritten: true,
+    notificationAttempted: true,
+    backgroundEventEmitted: complete,
+    subagentEventEmitted: complete,
+    notificationEnqueued: complete,
+    ...(flags.resumePending
+      ? { resumeIntent: { spanId: traceContext.spanId, state: "pending" as const } }
+      : {}),
+  };
+}
+
+test("backgroundTaskStatusFromSubagentStop maps complete Stop to cancelled and incomplete to lost", () => {
+  const complete = stoppedAgent({ complete: true });
+  const incomplete = stoppedAgent({ complete: false });
+  assert.equal(isCompleteStoppedBackgroundAgentSettlement(complete), true);
+  assert.equal(isCompleteStoppedBackgroundAgentSettlement(incomplete), false);
+  assert.equal(backgroundTaskStatusFromSubagentStop(complete), "cancelled");
+  assert.equal(backgroundTaskStatusFromSubagentStop(incomplete), "lost");
+  assert.equal(
+    backgroundTaskStatusFromSubagentStop(stoppedAgent({ resumePending: true })),
+    "lost",
+  );
+});
+
+test("subagent_stop synthesizes terminal BackgroundTaskCompleted and keeps backgroundWorks honest", () => {
+  const stopped = stoppedAgent({ complete: true });
+  const events = synthesizeBackgroundTaskEventsFromSubagentStopEntries({
+    entries: [
+      {
+        type: SUBAGENT_STOP_SESSION_ENTRY,
+        data: stopped,
+        time: { created: stopped.task.completedAt!.getTime() },
