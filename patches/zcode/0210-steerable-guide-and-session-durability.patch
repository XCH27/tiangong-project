+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createRemoteHostAttachmentStopSessionGlue,
+  writeRemoteHostAttachmentStopOnHostClose,
+  type RemoteHostStopSessionReceipt,
+} from "../src/host/remoteHostAttachmentStopSessionGlue.js";
+import {
+  createRemoteHostAttachmentStopProductWiring,
+  createSessionStoreRemoteHostStopPersist,
+  type RemoteHostStopBindableSessionService,
+} from "../src/host/remoteHostAttachmentStopProductWiring.js";
+
+function memorySessionStore() {
+  const entries: Array<{
+    id: string;
+    sessionID: string;
+    type: string;
+    data: RemoteHostStopSessionReceipt;
+  }> = [];
+  return {
+    entries,
+    saveSessionEntry: async (entry: {
+      id: string;
+      sessionID: string;
+      type: string;
+      touchSession: boolean;
+      time: { created: number; updated: number };
+      data: RemoteHostStopSessionReceipt;
+    }) => {
+      entries.push({
+        id: entry.id,
+        sessionID: entry.sessionID,
+        type: entry.type,
+        data: entry.data,
+      });
+    },
+  };
+}
+
+function fakeSessionService(): RemoteHostStopBindableSessionService & {
+  closed: string[];
+} {
+  const closed: string[] = [];
+  return {
+    closed,
+    async createSession(params) {
+      return {
+        session: {
+          sessionId: params.sessionId?.trim() || `sess-${params.remoteSessionId ?? "local"}`,
+        },
+      };
+    },
+    async resumeSession(params) {
+      return { session: { sessionId: params.sessionId } };
+    },
+    async closeSession(params) {
+      closed.push(params.sessionId);
+    },
+  };
+}
+
+test("product wrap bindSession on create; setPersist lands SQLite-shaped remote_host_attachment_stop", async () => {
+  const glue = createRemoteHostAttachmentStopSessionGlue({ now: () => 1_700_000_100_000 });
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  const store = memorySessionStore();
+  const uninstall = wiring.installPersistRouter();
+  const service = wiring.wrapSessionService(fakeSessionService(), {
+    persistViaAgent: createSessionStoreRemoteHostStopPersist(store),
+  });
+
+  const snapshot = await service.createSession({
+    workspacePath: "/remote/proj",
+    remoteSessionId: "remote-prod-1",
+  });
+  assert.equal(snapshot.session.sessionId, "sess-remote-prod-1");
+  assert.deepEqual(glue.listBoundSessionIds("remote-prod-1"), ["sess-remote-prod-1"]);
+  assert.deepEqual(wiring.listPersistSessionIds(), ["sess-remote-prod-1"]);
+
+  const result = await writeRemoteHostAttachmentStopOnHostClose({
+    glue,
+    remoteSessionId: "remote-prod-1",
+    reason: "session_detach",
+    attachmentIds: ["renderer-1"],
+    targetKind: "ssh",
+  });
+  assert.equal(result.skippedNoBinding, false);
+  assert.equal(result.skippedNoPersist, false);
+  assert.deepEqual(result.writtenSessionIds, ["sess-remote-prod-1"]);
+  assert.equal(store.entries.length, 1);
+  assert.equal(store.entries[0]?.type, "remote_host_attachment_stop");
+  assert.equal(store.entries[0]?.sessionID, "sess-remote-prod-1");
+  assert.equal(store.entries[0]?.data.reason, "session_detach");
+  assert.equal(store.entries[0]?.data.targetKind, "ssh");
+  assert.deepEqual(store.entries[0]?.data.attachmentIds, ["renderer-1"]);
+  assert.equal(
+    Object.prototype.hasOwnProperty.call(store.entries[0]?.data ?? {}, "linkedTasks"),
+    false,
+  );
+  // Bindings cleared after successful write.
+  assert.deepEqual(glue.listBoundSessionIds("remote-prod-1"), []);
+  uninstall();
+  wiring.clear();
+});
+
+test("product wrap resume re-binds; close unbinds without inventing writers", async () => {
+  const glue = createRemoteHostAttachmentStopSessionGlue();
+  const wiring = createRemoteHostAttachmentStopProductWiring({ glue });
+  wiring.installPersistRouter();
+  const store = memorySessionStore();
+  const base = fakeSessionService();
+  const service = wiring.wrapSessionService(base, {
+    persistViaAgent: createSessionStoreRemoteHostStopPersist(store),
+  });
+
+  await service.resumeSession({
+    sessionId: "sess-resume",
+    workspacePath: "/w",
+    remoteSessionId: "remote-r",
+  });
+  assert.deepEqual(glue.listBoundSessionIds("remote-r"), ["sess-resume"]);
+
+  await service.closeSession({
+    sessionId: "sess-resume",
+    workspacePath: "/w",
+    remoteSessionId: "remote-r",
+  });
+  assert.deepEqual(base.closed, ["sess-resume"]);
+  assert.deepEqual(glue.listBoundSessionIds("remote-r"), []);
+  assert.deepEqual(wiring.listPersistSessionIds(), []);
+
+  // Local (no remoteSessionId) create does not bind.
+  await service.createSession({ workspacePath: "/local" });
+  assert.deepEqual(glue.listBoundSessionIds("remote-r"), []);
+  wiring.clear();
+});
