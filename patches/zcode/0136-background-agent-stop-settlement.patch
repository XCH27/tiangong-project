+import type { TraceContext } from "@zcode/contracts";
+import { isTerminalRuntimeTask, type RuntimeTaskSnapshot } from "../runtime-task/registry.js";
+
+/** I/O coordination derived from a registry run, never another accepted task store. */
+interface BackgroundRunLifecycle {
+  agentId: string;
+  runTraceContext: TraceContext;
+  backgroundSettlement: BackgroundAgentSettlement;
+}
+
+export interface StoppedBackgroundAgentTask {
+  task: RuntimeTaskSnapshot;
+  totalDurationMs: number;
+  traceContext: TraceContext;
+  artifactsWritten?: boolean;
+  notificationEnqueued?: boolean;
+  backgroundEventEmitted?: boolean;
+  subagentEventEmitted?: boolean;
+}
+
+export interface BackgroundAgentSettlement {
+  tail: Promise<void>;
+  stopped?: StoppedBackgroundAgentTask;
+  stopFlight?: Promise<RuntimeTaskSnapshot | undefined>;
+}
+
+export function serializeBackgroundSettlement<T>(
+  settlement: BackgroundAgentSettlement,
+  work: () => Promise<T>,
+): Promise<T> {
+  const flight = settlement.tail.then(work);
+  settlement.tail = flight.then(
+    () => undefined,
+    () => undefined,
+  );
+  return flight;
+}
+
+export function releaseBackgroundSettlement(
+  settlements: Map<string, BackgroundAgentSettlement>,
+  lifecycle: BackgroundRunLifecycle,
+): void {
+  const settlement = lifecycle.backgroundSettlement;
+  if (!settlement.stopped && settlements.get(lifecycle.agentId) === settlement) {
+    settlements.delete(lifecycle.agentId);
+  }
+}
+
+export function ownsBackgroundRun(
+  lifecycle: BackgroundRunLifecycle,
+  task: RuntimeTaskSnapshot | undefined,
+): boolean {
+  return (
+    !lifecycle.backgroundSettlement.stopped &&
+    task?.traceContext?.spanId === lifecycle.runTraceContext.spanId
+  );
+}
+
+export function canFinalizeBackgroundRun(
+  lifecycle: BackgroundRunLifecycle,
+  task: RuntimeTaskSnapshot | undefined,
+): boolean {
+  return ownsBackgroundRun(lifecycle, task) && task !== undefined && !isTerminalRuntimeTask(task);
+}
