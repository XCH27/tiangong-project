+test("TaskStop cancels a real child before a failed artifact write; repair and retry settles once", { timeout: 10000 }, async () => {
+  const f = await fixture(true);
+  try {
+    const outputDir = dirname(f.outputFile);
+    await rm(outputDir, { recursive: true });
+    await writeFile(outputDir, "owned fault: blocks output directory");
+    let waiterResolved = false;
+    const waiter = f.port.waitForTask!("child").then((task) => { waiterResolved = true; return task; });
+    await assert.rejects(f.stop(), /EEXIST|ENOTDIR/);
+    assert.equal(f.runs[0]!.signal.aborted, true);
+    assert.deepEqual(await f.childExit, [null, "SIGTERM"]);
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(f.aborts, 1);
+    assert.equal(f.registry.get("child")!.status, "running", "failed settlement must not claim killed");
+    assert.equal(waiterResolved, false);
+    assert.equal(f.notifications.length, 0);
+    assert.equal(terminalEvents(f.events).length, 0);
+    assert.equal((await f.resume()).status, "failed", "no message is queued to a cancelled run awaiting settlement");
+    await rm(outputDir);
+    await f.stop();
+    assert.equal((await waiter)!.status, "killed");
+    assert.equal(f.notifications.length, 1);
+    assert.equal(terminalEvents(f.events).length, 2);
+    assert.match(await readFile(f.outputFile, "utf8"), /Background agent task stopped/);
+    await f.port.stopTask!("child");
+    assert.equal(f.notifications.length, 1);
+    assert.equal(f.aborts, 1);
+  } finally { await f.close(); }
+});
