+test("normal foreground, promoted and background settlements release their private run coordination", { concurrency: false }, async () => {
+  // Observe the private per-run Map without adding a production diagnostic API.
+  // This hook is limited to this test realm and restored before the next test.
+  const originalSet = Map.prototype.set;
+  const maps: Array<Map<unknown, unknown>> = [];
+  Map.prototype.set = function (key: unknown, value: unknown) {
+    if (
+      key === "child" && value && typeof value === "object" &&
+      "tail" in value && value.tail instanceof Promise && !maps.includes(this)
+    ) maps.push(this);
+    return originalSet.call(this, key, value);
+  };
+  try {
+    for (const mode of [false, true, "foreground", "foreground_failed"] as const) {
+      const f = await fixture(false, mode);
+      try {
+        const map = maps.at(-1)!;
+        if (mode === false || mode === true) {
+          assert.equal(map.size, 1, "a running child retains cancellation coordination");
+          f.finish(0, "normal completed output");
+          await f.port.waitForTask!("child");
+          await new Promise<void>((resolve) => setImmediate(resolve));
+        }
+        assert.equal(map.size, 0, `normal ${String(mode)} lifecycle leaves no retained entry`);
+      } finally { await f.close(); }
+    }
+    const failed = await fixture();
+    try {
+      const map = maps.at(-1)!;
+      failed.runs[0]!.finish.reject(new Error("synthetic background child failure"));
+      await failed.port.waitForTask!("child");
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      assert.equal(failed.registry.get("child")!.status, "failed");
+      assert.equal(map.size, 0, "a normally settled failure also releases its entry");
+    } finally { await failed.close(); }
+    const pendingStop = await fixture();
+    try {
+      const map = maps.at(-1)!;
+      pendingStop.failures.queue = true;
+      await assert.rejects(pendingStop.stop(), /notification was not enqueued/);
+      pendingStop.finish(0, "cancelled child settled after publication failure");
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      assert.equal(map.size, 1, "failed Stop retains its retry plan after child exit");
+      pendingStop.failures.queue = false;
+      await pendingStop.stop();
+      assert.equal(map.size, 0, "successful retry releases the same plan");
+    } finally { await pendingStop.close(); }
+  } finally { Map.prototype.set = originalSet; }
+});
