@@ -0,0 +1,404 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn, type ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { tmpdir } from "node:os";
+import {
+  EventReducer,
+  SessionEventType,
+  createRootTraceContext,
+  type SessionEvent,
+  type SubagentStartRequest,
+} from "@zcode/contracts";
+import {
+  createExploreSubagentPort,
+  type ExploreSubagentRuntimeRequest,
+  type ExploreSubagentRuntimeResult,
+} from "../src/subagent/runner.js";
+import { InMemoryRuntimeTaskRegistry } from "../src/runtime-task/registry.js";
+import { stopBackgroundTask } from "../src/runtime/methods/background.js";
+import { taskStopToolEntry } from "../src/tool/handlers/task-stop.js";
+
+async function fixture(realChild = false, foreground: boolean | "foreground" | "foreground_failed" = false) {
+  const root = await mkdtemp(join(tmpdir(), "fleet-background-stop-"));
+  const registry = new InMemoryRuntimeTaskRegistry();
+  const events: SessionEvent[] = [];
+  const notifications: unknown[] = [];
+  const runs: Array<{
+    request: ExploreSubagentRuntimeRequest;
+    signal: AbortSignal;
+    finish: ReturnType<typeof Promise.withResolvers<ExploreSubagentRuntimeResult>>;
+  }> = [];
+  const failures = { queue: false, event: undefined as SessionEventType | undefined };
+  const spawned = Promise.withResolvers<void>();
+  let eventGate: { type: SessionEventType; wait: () => Promise<void> } | undefined;
+  let aborts = 0;
+  let child: ChildProcess | undefined;
+  let childExit: Promise<unknown[]> | undefined;
+  const trace = createRootTraceContext({ sessionId: "parent" as never });
+  const request = {
+    agentType: "general-purpose",
+    sessionId: "parent",
+    turnId: "turn",
+    parentToolCallId: "agent-call",
+    description: "owned temporary stop fixture",
+    prompt: "no model or external effect",
+    workingDirectory: root,
+    workspaceRoot: root,
+    trace,
+  } as SubagentStartRequest;
+  const port = createExploreSubagentPort({
+    outputRootDir: root,
+    createAgentId: () => "child",
+    runtimeTaskRegistry: registry,
+    async emitParentEvent(event) {
+      if (eventGate && event.type === eventGate.type) await eventGate.wait();
+      if (failures.event === event.type) throw new Error("synthetic receipt write failed");
+      events.push(event);
+      if (event.type === SessionEventType.SubagentSpawned) spawned.resolve();
+    },
+    enqueueParentTaskNotification(notification) {
+      if (notification.text.includes("<status>stopped</status>")) {
+        assert.equal(runs.at(-1)?.signal.aborted, true, "Stop must precede notification I/O");
+      }
+      if (failures.queue) throw new Error("synthetic notification admission failed");
+      notifications.push(notification);
+      return undefined;
+    },
+    async runExploreAgent(childRequest, options) {
+      assert.ok(options?.signal);
+      const signal = options.signal;
+      const finish = Promise.withResolvers<ExploreSubagentRuntimeResult>();
+      runs.push({ request: childRequest, signal, finish });
+      if (realChild) {
+        // The disposable process only announces readiness and waits. No model/network/files.
+        child = spawn(process.execPath, ["-e", "process.stdout.write('ready'); setInterval(() => {}, 1000)"], {
+          stdio: ["ignore", "pipe", "pipe"],
+        });
+        childExit = once(child, "close");
+        signal.addEventListener("abort", () => { aborts++; child?.kill("SIGTERM"); }, { once: true });
+        await once(child.stdout!, "data");
+        await childRequest.onSessionReady?.();
+        await childExit;
+        return { response: "late child result after SIGTERM", traceId: trace.traceId, events: [] };
+      }
+      signal.addEventListener("abort", () => { aborts++; }, { once: true });
+      await childRequest.onSessionReady?.();
+      return finish.promise;
+    },
+  });
+  const runtime = {
+    runtimeTaskRegistry: registry,
+    subagentPort: port,
+    rootTraceContext: trace,
+    rebuildProjection: async () => new EventReducer().reduce(events),
+    stopBackgroundTask(taskId: string, options: unknown) {
+      return stopBackgroundTask.call(runtime as never, taskId, options as never);
+    },
+  };
+  if (foreground) {
+    const running = port.run(request);
+    await spawned.promise;
+    if (foreground === true) {
+      await port.backgroundTask!("child");
+      assert.equal((await running).status, "async_launched");
+    } else if (foreground === "foreground_failed") {
+      runs[0]!.finish.reject(new Error("synthetic foreground child failure"));
+      await assert.rejects(running, /Explore subagent failed/);
+    } else {
+      runs[0]!.finish.resolve({ response: "foreground completed output", traceId: trace.traceId, events: [] });
+      assert.equal((await running).status, "completed");
+    }
+  } else {
+    await port.start!(request);
+  }
+  const outputFile = registry.get("child")!.outputFile!;
+  return {
+    port, registry, events, notifications, failures, runs, root, outputFile, runtime,
+    get aborts() { return aborts; },
+    get childExit() { return childExit; },
+    gateEvent(gate: () => Promise<void>, type: SessionEventType = SessionEventType.SubagentStopped) {
+      eventGate = { type, wait: gate };
+    },
+    async stop() {
+      return taskStopToolEntry.handler({ task_id: "child" }, {
+        backgroundTaskControlPort: runtime,
+        traceContext: trace,
+        toolCallId: "stop-call",
+      } as never);
+    },
+    finish(index: number, response: string) {
+      runs[index]!.finish.resolve({ response, traceId: trace.traceId, events: [] });
+    },
+    async resume() {
+      return port.sendMessage!({
+        ...request,
+        to: "child",
+        message: "continue the same child with a new input",
+        parentToolCallId: "message-call",
+      } as never);
+    },
+    async close() {
+      failures.queue = false;
+      failures.event = undefined;
+      eventGate = undefined;
+      await port.stopTask!("child").catch(() => {});
+      child?.kill("SIGKILL");
+      await childExit?.catch(() => {});
+      for (const run of runs) run.finish.resolve({ response: "fixture cleanup", traceId: trace.traceId, events: [] });
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+const terminalEvents = (events: SessionEvent[]) => events.filter((event) =>
+  event.type === SessionEventType.BackgroundTaskCompleted || event.type === SessionEventType.SubagentStopped,
+);
