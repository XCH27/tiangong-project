+test("Stop preserves known completion while its receipt waits; resumed work starts after that writer", async () => {
+  const f = await fixture();
+  const entered = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  let resumed: ReturnType<typeof f.resume> | undefined;
+  try {
+    f.gateEvent(async () => { entered.resolve(); await release.promise; }, SessionEventType.BackgroundTaskCompleted);
+    f.finish(0, "known completed output");
+    await entered.promise;
+    assert.equal(f.registry.get("child")!.status, "completed");
+    assert.equal(await readFile(f.outputFile, "utf8"), "known completed output");
+    await assert.rejects(f.stop(), /not running/);
+    assert.equal((await f.port.stopTask!("child"))!.status, "completed");
+    assert.equal(f.aborts, 0);
+    resumed = f.resume();
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(f.runs.length, 1, "resume cannot reuse the task ID during old receipt publication");
+    assert.equal(f.registry.get("child")!.status, "completed");
+    release.resolve();
+    assert.equal((await resumed).delivery, "resumed_background");
+    assert.equal(f.registry.get("child")!.status, "running");
+    assert.equal(new EventReducer().reduce(f.events).backgroundTasks.at(-1)!.status, "running");
+    // The old run's cleanup must not remove the new run's failed-Stop retry fence.
+    f.failures.queue = true;
+    await assert.rejects(f.stop(), /notification was not enqueued/);
+    f.finish(1, "late result from new cancelled run");
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(f.registry.get("child")!.status, "running");
+    f.failures.queue = false;
+    await f.stop();
+    assert.equal(f.registry.get("child")!.status, "killed");
+    assert.equal(f.notifications.length, 2, "one completion and one later Stop notification");
+    assert.equal(terminalEvents(f.events).filter((event) =>
+      event.type === SessionEventType.BackgroundTaskCompleted &&
+      (event.payload as { status: string }).status === "completed",
+    ).length, 1);
+    assert.match(await readFile(f.outputFile, "utf8"), /Background agent task stopped/);
+  } finally {
+    release.resolve();
+    await resumed?.catch(() => {});
+    await f.close();
+  }
+});
