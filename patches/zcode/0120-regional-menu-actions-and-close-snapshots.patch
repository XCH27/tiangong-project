+          }
+        >
+          <Probe workspace={workspace} session={session} remote={remote} />
+        </ServiceProvider>,
+      ),
+    );
+  };
+  await render();
+  return {
+    path,
+    owner,
+    keepId,
+    pending,
+    render,
+    get latest() {
+      return latest;
+    },
+    get state() {
+      return latest.sidePaneState;
