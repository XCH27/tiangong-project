+          fetcher,
+          now,
+        );
         // 读取期间密钥被修改：迟到的结果不能发布到新密钥上。
         if (scope(id)?.revision !== active.revision || cache.get(id) !== active)
           return { status: "unavailable" as const, ...scoped };
diff --git a/packages/services/src/model-provider/apiKeyPlanUsageParsers.ts b/packages/services/src/model-provider/apiKeyPlanUsageParsers.ts
new file mode 100644
index 0000000..77c6bee
--- /dev/null
+++ b/packages/services/src/model-provider/apiKeyPlanUsageParsers.ts
@@ -0,0 +1,375 @@
+import type {
+  SubscriptionUsageBalance,
+  SubscriptionUsageResult,
+  SubscriptionUsageWindow,
+} from "./subscriptionUsage.js";
+
+// 将纯解析与请求/缓存分开，保留原入口导出和全部厂商字段语义。
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+function finite(value: unknown): number | undefined {
+  const parsed = typeof value === "string" && value.trim() ? Number(value) : value;
+  return typeof parsed === "number" && Number.isFinite(parsed) ? parsed : undefined;
+}
+function clampPercent(value: number): number {
+  return Math.min(100, Math.max(0, value));
+}
+
+const OPENCODE_GO_WINDOWS = [
+  ["rolling", 300],
+  ["weekly", 10_080],
+  ["monthly", 43_200],
+] as const;
+
+/** OpenCode Go `/zen/go/v1/usage`：usage.{rolling,weekly,monthly}.{percent,resetsAt}。 */
+export function parseOpenCodeGoUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const usage = record(record(payload)?.usage);
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const [key, windowMinutes] of OPENCODE_GO_WINDOWS) {
+    const row = record(usage?.[key]);
+    const percent = finite(row?.percent);
+    if (percent === undefined || percent < 0 || percent > 100) continue;
+    const reset = typeof row?.resetsAt === "string" ? Date.parse(row.resetsAt) : NaN;
+    windows.push({
+      id: `default:${key}`,
+      usedPercent: percent,
+      windowMinutes,
+      ...(Number.isFinite(reset) ? { resetAt: reset } : {}),
+    });
+  }
+  return windows.length
+    ? { status: "available", source: "OpenCode Go", observedAt, windows, plan: "Go" }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+/** MiniMax `/v1/token_plan/remains`：每个模型的 5 小时与每周窗口，优先使用剩余百分比。 */
+export function parseMiniMaxTokenPlanUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const body = record(payload);
+  const status = finite(record(body?.base_resp)?.status_code);
+  // 非 0 表示该密钥没有有效 Token Plan；这是"不支持"，不是额度为 0。
+  if (status !== undefined && status !== 0) return { status: "unsupported" };
+  const rows = Array.isArray(body?.model_remains) ? body.model_remains.slice(0, 32) : [];
+  const windows: SubscriptionUsageWindow[] = [];
+  const used = (remainingPercent: unknown, total: unknown, usedCount: unknown) => {
+    const remaining = finite(remainingPercent);
+    if (remaining !== undefined) return clampPercent(100 - remaining);
+    const all = finite(total);
+    const spent = finite(usedCount);
+    return all !== undefined && all > 0 && spent !== undefined
+      ? clampPercent((spent / all) * 100)
+      : undefined;
+  };
+  for (const raw of rows) {
+    const row = record(raw);
+    if (!row) continue;
+    const name =
+      typeof row.model_name === "string" && row.model_name.trim()
+        ? row.model_name.trim().slice(0, 64)
+        : "Token Plan";
+    const interval = used(
+      row.current_interval_remaining_percent,
+      row.current_interval_total_count,
+      row.current_interval_usage_count,
+    );
+    const intervalEnd = finite(row.end_time);
+    if (interval !== undefined)
+      windows.push({
+        id: `${name}:interval`,
+        usedPercent: interval,
+        windowMinutes: 300,
+        ...(intervalEnd && intervalEnd > 0 ? { resetAt: intervalEnd } : {}),
+      });
+    const weekly = used(
+      row.current_weekly_remaining_percent,
+      row.current_weekly_total_count,
+      row.current_weekly_usage_count,
+    );
+    const weeklyEnd = finite(row.weekly_end_time);
+    if (weekly !== undefined)
+      windows.push({
+        id: `${name}:weekly`,
+        usedPercent: weekly,
+        windowMinutes: 10_080,
+        ...(weeklyEnd && weeklyEnd > 0 ? { resetAt: weeklyEnd } : {}),
+      });
+  }
+  return windows.length
+    ? { status: "available", source: "MiniMax Token Plan", observedAt, windows }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+const KIMI_POOLS = [
+  ["limit_5h", "session", 300],
+  ["limit_7d", "weekly", 10_080],
+  ["limit_month_total", "monthly", 43_200],
+] as const;
+
+function kimiCounts(detail: Record<string, unknown> | undefined) {
+  const limit = finite(detail?.limit);
+  if (limit === undefined || limit <= 0) return undefined;
+  const used = finite(detail?.used);
+  if (used !== undefined && used >= 0) return { used, limit };
+  const remaining = finite(detail?.remaining);
+  return remaining !== undefined && remaining >= 0 && remaining <= limit
+    ? { used: limit - remaining, limit }
+    : undefined;
+}
+function kimiReset(value: unknown): number | undefined {
+  const parsed = typeof value === "string" ? Date.parse(value) : NaN;
+  return Number.isFinite(parsed) ? parsed : undefined;
+}
+function kimiWindowMinutes(window: Record<string, unknown> | undefined): number | undefined {
+  const duration = finite(window?.duration);
+  if (duration === undefined || duration <= 0) return undefined;
+  const unit = String(window?.timeUnit ?? "").toUpperCase();
+  return unit.includes("DAY")
+    ? duration * 1440
+    : unit.includes("HOUR")
+      ? duration * 60
+      : unit.includes("MINUTE")
+        ? duration
+        : undefined;
+}
+
+/**
+ * Kimi Code `/coding/v1/usages`（官方 kimi-code packages/oauth/src/managed-usage.ts、CodexBar）：
+ * 优先 usages.limit_5h/limit_7d/limit_month_total 的 used_ratio；旧响应的 usage（每周）与
+ * limits[]（短窗口）计数作回退。比例为 0 而计数显示已使用时，按 CodexBar 视为占位值、改用计数。
+ */
+export function parseKimiCodeUsage(payload: unknown, observedAt: number): SubscriptionUsageResult {
+  const body = record(payload);
+  const pools = record(body?.usages);
+  const weeklyDetail = record(body?.usage);
+  const firstLimit = record(Array.isArray(body?.limits) ? body.limits[0] : undefined);
+  const sessionDetail = record(firstLimit?.detail);
+  const counted = (detail: Record<string, unknown> | undefined) => {
+    const counts = kimiCounts(detail);
+    return counts ? clampPercent((counts.used / counts.limit) * 100) : undefined;
+  };
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const [key, name, minutes] of KIMI_POOLS) {
+    const pool = record(pools?.[key]);
+    const ratio = finite(pool?.used_ratio);
+    const detail =
+      name === "weekly" ? weeklyDetail : name === "session" ? sessionDetail : undefined;
+    const fallback = counted(detail);
+    const placeholder = ratio === 0 && !pools?.limit_month_total && (fallback ?? 0) > 0;
+    const fromRatio = ratio !== undefined && ratio >= 0 && !placeholder;
+    const usedPercent = fromRatio ? Math.min(1, ratio) * 100 : fallback;
+    if (usedPercent === undefined) continue;
+    const reset = kimiReset(
+      fromRatio ? pool?.reset_time : (detail?.resetTime ?? detail?.reset_time ?? detail?.resetAt),
+    );
+    // 计数回退时，短窗口的时长以响应里 limits[0].window 为准。
+    const windowMinutes =
+      !fromRatio && name === "session"
+        ? (kimiWindowMinutes(record(firstLimit?.window)) ?? minutes)
+        : minutes;
+    windows.push({
+      id: `default:${name}`,
+      usedPercent,
+      windowMinutes,
+      ...(reset ? { resetAt: reset } : {}),
+    });
+  }
+  return windows.length
+    ? { status: "available", source: "Kimi Code", observedAt, windows }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+const ZAI_UNIT_MINUTES: Readonly<Record<number, number>> = { 1: 1440, 3: 60, 5: 1, 6: 10_080 };
+
+function zaiWindowName(minutes: number): string {
+  return minutes === 300
+    ? "five_hour"
+    : minutes === 10_080
+      ? "weekly"
+      : minutes === 43_200
+        ? "monthly"
+        : `${minutes}m`;
+}
+
+/**
+ * Z.ai / BigModel Coding Plan `GET /api/monitor/usage/quota/limit`: data.limits[] of TOKENS_LIMIT /
+ * CREDIT_LIMIT (plan windows) and TIME_LIMIT (MCP). Field semantics follow CodexBar
+ * `Plugins/zai.js`: integer unit/number/percentage, unit 1=day 3=hour 5=minute 6=week, counts
+ * override the rounded percentage, `TIME_LIMIT` 1 minute marks the monthly MCP quota, and a
+ * five-hour reset further than five hours away is dropped rather than guessed.
+ */
+export function parseZaiCodingPlanUsage(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const data = record(record(payload)?.data);
+  const limits = Array.isArray(data?.limits) ? data.limits : [];
+  const windows: SubscriptionUsageWindow[] = [];
+  for (const raw of limits) {
+    const row = record(raw);
+    const type = row?.type;
+    if (type !== "TOKENS_LIMIT" && type !== "CREDIT_LIMIT" && type !== "TIME_LIMIT") continue;
+    const unit = row?.unit;
+    const number = row?.number;
+    const percentage = row?.percentage;
+    if (!Number.isInteger(unit) || !Number.isInteger(number) || !Number.isInteger(percentage))
+      return { status: "unavailable", unavailableReason: "no-provider-data" };
+    const usage = Number.isInteger(row?.usage) ? (row!.usage as number) : undefined;
+    const current = Number.isInteger(row?.currentValue) ? (row!.currentValue as number) : undefined;
+    const remaining = Number.isInteger(row?.remaining) ? (row!.remaining as number) : undefined;
+    let percent = percentage as number;
+    if (usage !== undefined && usage > 0) {
+      const used =
+        remaining !== undefined
+          ? Math.max(usage - remaining, current ?? usage - remaining)
+          : current;
+      if (used !== undefined) percent = (Math.max(0, Math.min(usage, used)) / usage) * 100;
+    }
+    const mcpMonthly = type === "TIME_LIMIT" && unit === 5 && number === 1;
+    const multiplier = ZAI_UNIT_MINUTES[unit as number];
+    const windowMinutes = mcpMonthly
+      ? 43_200
+      : (number as number) > 0 && multiplier
+        ? (number as number) * multiplier
+        : undefined;
+    if (windowMinutes === undefined) continue;
+    const reset = Number.isInteger(row?.nextResetTime) ? (row!.nextResetTime as number) : undefined;
+    const plausibleReset =
+      reset !== undefined &&
+      !(type !== "TIME_LIMIT" && windowMinutes === 300 && reset > observedAt + 301 * 60_000);
+    windows.push({
+      id:
+        type === "TIME_LIMIT"
+          ? `MCP:${zaiWindowName(windowMinutes)}`
+          : `default:${zaiWindowName(windowMinutes)}`,
+      usedPercent: clampPercent(percent),
+      windowMinutes,
+      ...(plausibleReset ? { resetAt: reset } : {}),
+    });
+  }
+  const plan = [data?.planName, data?.plan, data?.plan_type, data?.packageName, data?.level].find(
+    (value): value is string =>
+      typeof value === "string" && value.trim().length > 0 && value.length <= 128,
+  );
+  return windows.length
+    ? {
+        status: "available",
+        source: "Z.ai Coding Plan",
+        observedAt,
+        windows,
+        ...(plan ? { plan } : {}),
+      }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+}
+
+const balanceResult = (
+  source: string,
+  observedAt: number,
+  balances: SubscriptionUsageBalance[],
+  windows: SubscriptionUsageWindow[] = [],
+): SubscriptionUsageResult =>
+  balances.length || windows.length
+    ? { status: "available", source, observedAt, windows, balances }
+    : { status: "unavailable", unavailableReason: "no-provider-data" };
+
+/** DeepSeek `GET /user/balance`：balance_infos[].{currency,total_balance}（官方文档；CodexBar 同）。 */
+export function parseDeepSeekBalance(
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const rows = Array.isArray(record(payload)?.balance_infos)
+    ? (record(payload)!.balance_infos as unknown[])
+    : [];
+  const balances = rows.flatMap((raw): SubscriptionUsageBalance[] => {
+    const row = record(raw);
+    const amount = finite(row?.total_balance);
+    const currency = typeof row?.currency === "string" ? row.currency.toUpperCase() : undefined;
+    return amount === undefined || !currency
+      ? []
+      : [{ id: `balance:${currency}`, kind: "balance", amount, currency }];
+  });
+  return balanceResult("DeepSeek", observedAt, balances);
+}
+
+/** Moonshot `GET /v1/users/me/balance`：data.available_balance；.cn 为人民币，.ai 为美元（CodexBar moonshot 插件）。 */
+export function parseMoonshotBalance(
+  payload: unknown,
+  observedAt: number,
+  currency: string,
+): SubscriptionUsageResult {
+  const body = record(payload);
+  if (body?.status === false || (finite(body?.code) ?? 0) !== 0) return { status: "unavailable" };
+  const amount = finite(record(body?.data)?.available_balance);
+  return balanceResult(
+    "Moonshot",
+    observedAt,
+    amount === undefined ? [] : [{ id: "balance", kind: "balance", amount, currency }],
+  );
+}
+
+const OPENROUTER_RESET_MINUTES: Record<string, number> = {
+  daily: 1440,
+  weekly: 10_080,
+  monthly: 43_200,
+};
+
+/**
+ * OpenRouter `GET /api/v1/key`（当前密钥）：有上限时给出剩余额度与使用比例窗口；无上限时只给已用金额。
+ * 账户总余额 `/credits` 需要管理密钥，不在此读取。
+ */
+export function parseOpenRouterKey(payload: unknown, observedAt: number): SubscriptionUsageResult {
+  const data = record(record(payload)?.data);
+  const usage = finite(data?.usage);
+  const limit = finite(data?.limit);
+  const remaining = finite(data?.limit_remaining);
+  const balances: SubscriptionUsageBalance[] = [];
+  const windows: SubscriptionUsageWindow[] = [];
+  if (limit !== undefined && limit > 0) {
+    if (remaining !== undefined)
+      balances.push({
+        id: "key-remaining",
+        kind: "remaining",
+        amount: remaining,
+        currency: "USD",
+        limit,
+      });
+    if (remaining !== undefined || usage !== undefined) {
+      const minutes =
+        typeof data?.limit_reset === "string"
+          ? OPENROUTER_RESET_MINUTES[data.limit_reset]
+          : undefined;
+      windows.push({
+        id: "default:key-limit",
+        usedPercent: clampPercent(
+          (((remaining !== undefined ? limit - remaining : usage) ?? 0) / limit) * 100,
+        ),
+        ...(minutes ? { windowMinutes: minutes } : {}),
+      });
+    }
+  } else if (usage !== undefined) {
+    balances.push({ id: "key-spent", kind: "spent", amount: usage, currency: "USD" });
+  }
+  return balanceResult("OpenRouter", observedAt, balances, windows);
+}
+
+/** SiliconFlow `GET /v1/user/info`：data.totalBalance；.cn 为人民币，.com 为美元。 */
+export function parseSiliconFlowBalance(
+  payload: unknown,
+  observedAt: number,
+  currency: string,
+): SubscriptionUsageResult {
+  const data = record(record(payload)?.data);
+  const amount = finite(data?.totalBalance) ?? finite(data?.balance);
+  return balanceResult(
+    "SiliconFlow",
+    observedAt,
+    amount === undefined ? [] : [{ id: "balance", kind: "balance", amount, currency }],
+  );
+}
