diff --git a/packages/ui/src/store/pluginManagementStoreGrants.ts b/packages/ui/src/store/pluginManagementStoreGrants.ts
new file mode 100644
index 0000000..3023285
--- /dev/null
+++ b/packages/ui/src/store/pluginManagementStoreGrants.ts
@@ -0,0 +1,34 @@
+import type { PluginManagementState } from "@/store/pluginManagementStore.js";
+import { runWorkspaceOperation } from "@/store/pluginManagementStoreLoading.js";
+
+// 授权动作继续使用原 store 和操作生命周期，拆文件不新增状态或写入路径。
+export function createPluginGrantActions(
+  set: (partial: Partial<PluginManagementState>) => void,
+  get: () => PluginManagementState,
+): Pick<PluginManagementState, "grantPlugin" | "revokePluginGrant"> {
+  return {
+    async grantPlugin(pluginId, fingerprint, pluginService) {
+      return await runWorkspaceOperation(
+        set,
+        get,
+        pluginService,
+        `plugin:grant:${pluginId}`,
+        async (workspace) => {
+          await pluginService.grantPlugin({ ...workspace, pluginId, fingerprint });
+        },
+      );
+    },
+
+    async revokePluginGrant(pluginId, pluginService) {
+      return await runWorkspaceOperation(
+        set,
+        get,
+        pluginService,
+        `plugin:revoke-grant:${pluginId}`,
+        async (workspace) => {
+          await pluginService.revokePluginGrant({ ...workspace, pluginId });
+        },
+      );
+    },
+  };
+}
diff --git a/packages/ui/test/pluginManagementGrants.test.ts b/packages/ui/test/pluginManagementGrants.test.ts
new file mode 100644
index 0000000..6b938d0
--- /dev/null
+++ b/packages/ui/test/pluginManagementGrants.test.ts
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IPluginManagementService } from "@zcode/services";
+import { usePluginManagementStore } from "../src/store/pluginManagementStore.js";
+
+function fixture() {
+  const calls: Array<{ method: string; input: unknown }> = [];
+  const store = usePluginManagementStore;
+  store.setState(
+    {
+      ...store.getInitialState(),
+      workspacePath: "/fixture/project",
+      workspaceIdentity: "remote:fixture-host/project",
+      configScope: "workspace",
+    },
+    true,
+  );
+  const service = {
+    async grantPlugin(input: unknown) {
+      calls.push({ method: "grant", input });
+    },
+    async revokePluginGrant(input: unknown) {
+      calls.push({ method: "revoke", input });
+    },
+    async listPlugins(input: unknown) {
+      calls.push({ method: "list", input });
+      return { plugins: [], diagnostics: [] };
+    },
+    async getPluginsOverview() {
+      return {
+        marketplaces: [],
+        availablePlugins: [],
+        installedPlugins: [],
+        restorableBuiltins: [],
+        diagnostics: [],
+      };
+    },
+  } as unknown as IPluginManagementService;
+  return { store, service, calls };
+}
+
+test("public grant and revoke retain the Host identity and reload the selected scope", async () => {
+  const { store, service, calls } = fixture();
+  assert.equal(await store.getState().grantPlugin("plugin@source", "fingerprint", service), true);
+  assert.equal(await store.getState().revokePluginGrant("plugin@source", service), true);
+  const workspace = {
+    workspacePath: "/fixture/project",
+    workspaceIdentity: "remote:fixture-host/project",
+  };
+  assert.deepEqual(calls, [
+    {
+      method: "grant",
+      input: { ...workspace, pluginId: "plugin@source", fingerprint: "fingerprint" },
+    },
+    { method: "list", input: { ...workspace, configScope: "workspace" } },
+    { method: "revoke", input: { ...workspace, pluginId: "plugin@source" } },
+    { method: "list", input: { ...workspace, configScope: "workspace" } },
+  ]);
+  assert.equal(store.getState().operationId, null);
+  assert.equal(store.getState().error, null);
+});
+
+test("a late grant completion cannot reload a newly selected Host", async () => {
+  const { store, service, calls } = fixture();
+  let finish!: () => void;
+  service.grantPlugin = async () =>
+    new Promise<void>((resolve) => {
+      finish = resolve;
+    });
+  const pending = store.getState().grantPlugin("plugin@source", "fingerprint", service);
+  store.setState({ workspaceIdentity: "remote:another-host/project" });
+  finish();
+  assert.equal(await pending, false);
+  assert.deepEqual(calls, []);
+  assert.equal(store.getState().workspaceIdentity, "remote:another-host/project");
+  assert.equal(store.getState().operationId, null);
+});
+
+test("an unsuccessful revoke keeps the original failure result and releases the busy control", async () => {
+  const { store, service, calls } = fixture();
+  service.revokePluginGrant = async () => {
+    throw new Error("fixture refusal");
+  };
+  assert.equal(await store.getState().revokePluginGrant("plugin@source", service), false);
+  assert.deepEqual(calls, []);
+  assert.equal(store.getState().error, "fixture refusal");
+  assert.equal(store.getState().operationId, null);
+});
