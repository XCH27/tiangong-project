+          platform={
+            {
+              openExternal: async () => {
+                throw new Error("Unexpected external navigation");
+              },
+            } as never
+          }
+        >
+          <TabStoreProvider>
+            <ZCodeIntlProvider initialLocale={locale}>
+              <TooltipProvider>
+                <PluginStorePage
+                  key={key}
+                  workspacePath={workspacePath}
