+        "Refreshed page retained obsolete component details",
+      );
+      check(!node.textContent?.includes("generation-1"), "Stale detail remained after refresh");
+      check(detailReads === 2, "Current details were not read exactly once per catalog generation");
+      check(mutations === 0, "Read-only detail/retry unexpectedly installed a plugin");
+      results.push({
+        name: `${locale}: actual detail follows refreshed catalog without install or grant`,
+      });
+      requestPluginStoreOpen({ intent: "add-marketplace" });
+      await act(async () => root.render(page("add")));
+      const input = document.querySelector<HTMLInputElement>(
+        '[data-testid="plugin-store-add-source-input"]',
+      );
+      check(input, "Original add-source dialog did not open");
+      await act(async () => {
+        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(
+          input,
+          "https://authored.invalid/catalog.json",
+        );
+        input.dispatchEvent(new Event("input", { bubbles: true }));
+      });
+      await click('[data-testid="plugin-store-add-source-submit"]');
+      check(
+        adds.length === 1 && adds[0].operationId,
+        "Human add omitted its backend operation identity",
+      );
+      await act(async () => {
+        document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
+      });
+      check(
+        cancellations.length === 1 && cancellations[0].operationId === adds[0].operationId,
+        "Closing did not cancel the exact original request",
+      );
+      await settleClosedDialog();
+      // An already completed/late ACK remains the backend's fact; it must not reopen the closed UI.
+      await act(async () => {
+        releaseAdd?.();
+      });
+      check(
+        !document.querySelector('[data-testid="plugin-store-add-source-dialog"]'),
+        "Late add completion reopened the dialog",
+      );
+      results.push({
+        name: `${locale}: closing human add requests cancellation through its original operation id`,
+      });
+      requestPluginStoreOpen({ intent: "add-marketplace" });
+      await act(async () => root.render(page("context")));
+      const fillSource = async (value: string) => {
+        const field = document.querySelector<HTMLInputElement>(
+          '[data-testid="plugin-store-add-source-input"]',
+        );
+        check(field, "Context dialog did not open");
+        await act(async () => {
+          Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(
+            field,
+            value,
+          );
+          field.dispatchEvent(new Event("input", { bubbles: true }));
+        });
+      };
+      await fillSource("https://original-host.invalid/catalog.json");
+      await click('[data-testid="plugin-store-add-source-submit"]');
+      check(adds.length === 2, "Original Host add did not start");
+      const finishOriginal = releaseAdd;
+      const nextAdds: Array<{ operationId?: string }> = [];
+      const nextCancellations: Array<{ operationId: string }> = [];
+      let finishNext: (() => void) | undefined;
+      services.pluginManagementService = {
+        ...service,
+        addPluginMarketplace: async (input: { operationId?: string }) => {
+          nextAdds.push(input);
+          await new Promise<void>((resolve) => {
+            finishNext = resolve;
+          });
+        },
+        cancelPluginOperation: async (value: { operationId: string }) => {
+          nextCancellations.push(value);
+          return { ...value, cancelled: true };
+        },
+      };
+      // Same actual page instance, replaced Host service: both parent and dialog lifetime matter.
+      await act(async () => root.render(page("context")));
+      check(
+        document.querySelector<HTMLInputElement>('[data-testid="plugin-store-add-source-input"]')
+          ?.value === "",
+        "New Host retained the old pending dialog input",
+      );
+      await fillSource("https://next-host.invalid/catalog.json");
+      await click('[data-testid="plugin-store-add-source-submit"]');
+      check(
+        nextAdds.length === 1 && nextAdds[0].operationId !== adds[1].operationId,
+        "Pending original Host blocked the new Host or reused its operation identity",
+      );
+      await act(async () => {
+        finishOriginal?.();
+      });
+      check(
+        document.querySelector<HTMLInputElement>('[data-testid="plugin-store-add-source-input"]')
