+      );
+      await act(async () =>
+        document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true })),
+      );
+      check(
+        nextCancellations[0]?.operationId === nextAdds[0].operationId && cancellations.length === 1,
+        "Close cancelled an operation owned by the wrong Host",
+      );
+      await act(async () => {
+        finishNext?.();
+      });
+      results.push({
+        name: `${locale}: new Host add remains independent of a pending original dialog`,
+      });
+    } catch (error) {
+      results.push({ name: `${locale}: plugin market consistency`, error: String(error) });
+    } finally {
+      await act(async () => root.unmount());
+      node.remove();
+      store.setState({ ...store.getInitialState() }, true);
+    }
+  }
+}
+(window as unknown as Record<string, unknown>).__pluginMarketConsistencyTests = run().then(
+  () => results,
+);
