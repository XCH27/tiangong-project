new file mode 100644
index 00000000..a7365640
--- /dev/null
+++ b/packages/ui/src/store/pluginManagementStoreRequests.ts
@@ -0,0 +1,57 @@
+import type { IPluginManagementService } from "@zcode/services";
+import type { PluginManagementState } from "@/store/pluginManagementStore.js";
+
+type Get = () => PluginManagementState;
+type Set = (partial: Partial<PluginManagementState>) => void;
+interface RequestOwner {
+  key: string;
+  service: IPluginManagementService;
+  epoch: number;
+  generation: number;
+  load?: { generation: number; promise: Promise<void> };
+}
+export interface PluginRequestContext {
+  owner: RequestOwner;
+  epoch: number;
+  key: string;
+}
+// 原 store 是投影唯一所有者；弱引用只登记其异步请求，不存另一份插件事实。
+const owners = new WeakMap<Get, RequestOwner>();
+function contextKey(get: Get): string {
+  const { workspacePath, workspaceIdentity, configScope } = get();
+  return JSON.stringify([workspacePath, workspaceIdentity, configScope]);
+}
+export function capturePluginContext(
+  set: Set,
+  get: Get,
+  service: IPluginManagementService,
+): PluginRequestContext {
+  const key = contextKey(get);
+  let owner = owners.get(get);
+  if (!owner) {
+    owner = { key, service, epoch: 0, generation: 0 };
+    owners.set(get, owner);
+  } else if (owner.key !== key || owner.service !== service) {
+    // A→B→A 或同路径 Host 重连不能复用 A 的未完成读取/详情。
+    owner.key = key;
+    owner.service = service;
+    owner.epoch += 1;
+    owner.generation += 1;
+    owner.load = undefined;
+    set({ describeCache: {}, operationId: null, togglingPluginId: null });
+  }
+  return { owner, epoch: owner.epoch, key };
+}
+export function isPluginContextCurrent(get: Get, context: PluginRequestContext): boolean {
+  return context.owner.epoch === context.epoch && contextKey(get) === context.key;
+}
+export function invalidatePluginRead(
+  set: Set,
+  context: PluginRequestContext,
+  clearDetails = true,
+): number {
+  context.owner.generation += 1;
+  // 刷新已改变详情所依据的目录；旧请求只能被丢弃，不能重新填回缓存。
+  if (clearDetails) set({ describeCache: {} });
+  return context.owner.generation;
+}
