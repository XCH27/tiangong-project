+import { usePluginManagementStore as store } from "../src/store/pluginManagementStore.js";
+import { requestPluginStoreOpen } from "../src/lib/pluginStoreNavigation.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+// Renderer ports use authored data. Canonical filesystem/transport tests separately prove writes
+// and cancellation; this suite verifies the real page consumes failure and refreshed detail state.
+async function run() {
+  for (const locale of ["zh-CN", "en-US"] as const) {
+    const node = document.createElement("div");
+    node.style.width = "640px";
+    document.body.append(node);
+    const root = createRoot(node);
+    const workspacePath = `/plugin-market-render/${crypto.randomUUID()}`;
+    const id = `writer@${official}`;
+    let unavailable = true;
+    let version = 1;
+    let detailReads = 0;
+    let mutations = 0;
+    const adds: Array<{ operationId?: string }> = [];
+    const cancellations: Array<{ operationId: string }> = [];
+    let releaseAdd: (() => void) | undefined;
+    const plugin = {
+      id: `saved@${official}`,
+      name: "saved",
+      marketplace: official,
+      enabled: true,
+      source: "marketplace",
+      scope: "user",
+      components: [],
+      rootPath: "/authored/saved",
+      configuredOptions: { tone: "keep" },
+    };
+    const service = {
+      listPlugins: async () => ({ plugins: [plugin], diagnostics: [] }),
+      getPluginsOverview: async () => {
+        if (unavailable) throw new Error("Authored catalog unavailable");
+        return {
+          marketplaces: [{ id: official, name: "Official", source: { kind: "builtin" } }],
+          availablePlugins: [
+            {
+              id,
+              name: "writer",
+              marketplace: official,
+              version: `${version}.0.0`,
+              listing: {
+                displayName: "Authored Writer",
+                description: "Test catalog",
+                category: "productivity",
+              },
+            },
+          ],
+          installedPlugins: [],
+          restorableBuiltins: [],
+          diagnostics: [],
+        };
+      },
+      updatePluginMarketplace: async () => ({ diagnostics: [] }),
+      describePlugin: async () => {
+        detailReads += 1;
+        return {
+          metadata: { name: "writer", version: `${version}.0.0` },
+          components: [
+            { kind: "skill", items: [{ name: `generation-${version}`, description: "Authored" }] },
+          ],
+          diagnostics: [],
+        };
+      },
+      installPlugin: async () => {
+        mutations += 1;
+        throw new Error("Unexpected install");
+      },
+      addPluginMarketplace: async (input: { operationId?: string }) => {
+        adds.push(input);
+        await new Promise<void>((resolve) => {
+          releaseAdd = resolve;
+        });
+      },
+      cancelPluginOperation: async (input: { operationId: string }) => {
+        cancellations.push(input);
+        return { ...input, cancelled: true };
+      },
+    };
+    const services = {
+      pluginManagementService: service,
+      clientConfigService: { getSnapshot: async () => ({ pluginStoreOrder: null }) },
+      zcodeSessionService: {},
+      skillsService: {},
+    };
+    const click = async (selector: string) => {
+      const target =
+        node.querySelector<HTMLElement>(selector) ?? document.querySelector<HTMLElement>(selector);
+      check(target, `Missing ${selector}`);
+      await act(async () => target.click());
+    };
+    const settleClosedDialog = async () => {
+      const dialog = document.querySelector<HTMLElement>(
+        '[data-testid="plugin-store-add-source-dialog"]',
+      );
+      if (dialog) {
+        check(dialog.dataset.state === "closed", "Dialog did not enter its closed state");
+        // The shipped stylesheet keeps the closed Radix node for its exit animation.
+        await act(async () => {
