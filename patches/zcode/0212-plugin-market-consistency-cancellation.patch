@@ -0,0 +1,160 @@
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import os from "node:os";
+import { createPluginManagementService } from "../../services/src/plugins/pluginManagementService.js";
+import type { IPluginManagementService } from "@zcode/services";
+import * as handlers from "../../../apps/zcode-cli/packages/bootstrap/src/zcode-protocol/plugins.js";
+import { usePluginManagementStore as store } from "../src/store/pluginManagementStore.js";
+
+export function deferred<T = void>() {
+  let resolve!: (value: T | PromiseLike<T>) => void;
+  const promise = new Promise<T>((finish) => {
+    resolve = finish;
+  });
+  return { promise, resolve };
+}
+
+// Canonical service → production handlers → authored files, without running package contributions.
+export async function pluginMarketFixture() {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-plugin-market-consistency-"));
+  const home = join(root, "home");
+  const storage = join(root, "storage");
+  const workspace = join(root, "workspace");
+  const plugin = join(root, "plugin");
+  const market = join(root, "market");
+  const configPath = join(home, "cli", "config.json");
+  const previous = { home: process.env.ZCODE_HOME, storage: process.env.ZCODE_STORAGE_DIR };
+  process.env.ZCODE_HOME = home;
+  process.env.ZCODE_STORAGE_DIR = storage;
+  for (const dir of [
+    join(home, "cli"),
+    workspace,
+    join(plugin, ".zcode-plugin"),
+    join(market, ".claude-plugin"),
+  ]) {
+    await mkdir(dir, { recursive: true });
+  }
+  await writeFile(
+    join(plugin, ".zcode-plugin", "plugin.json"),
+    JSON.stringify({
+      name: "auditprobe",
+      version: "1.0.0",
+      userConfig: { tone: { type: "string", title: "Tone", default: "old" } },
+    }),
+  );
+  await writeFile(
+    configPath,
+    JSON.stringify({ storage: { dir: storage }, plugins: { dirs: [plugin] } }),
+  );
+  const logger = { debug() {}, info() {}, warn() {}, error() {} };
+  const context = { deps: { env: process.env }, logger } as Parameters<
+    typeof handlers.listPlugins
+  >[0];
+  const params = (input: Record<string, unknown>) => {
+    const { workspacePath, workspaceIdentity, ...rest } = input;
+    return {
+      ...rest,
+      workspace: {
+        workspacePath,
+        workspaceKey: workspaceIdentity || workspacePath,
+        ...(workspaceIdentity ? { workspaceIdentity } : {}),
+      },
+    };
+  };
+  const methods = [
+    "listPlugins",
+    "getPluginsOverview",
+    "configurePlugin",
+    "describePlugin",
+    "addPluginMarketplace",
+    "updatePluginMarketplace",
+    "setPluginEnabled",
+    "installPlugin",
+    "grantPlugin",
+    "revokePluginGrant",
+    "uninstallPlugin",
+    "resetPluginConfig",
+  ] as const;
+  const agent = Object.fromEntries(
+    methods.map((method) => [
+      method,
+      (input: Record<string, unknown>) => handlers[method](context, params(input)),
+    ]),
+  ) as unknown as IPluginManagementService;
+  const service = createPluginManagementService({ zcodeAgentService: agent as never });
+  const publish = async (version: string, skill: string) => {
+    const packageRoot = join(market, "plugins", "writer");
+    await mkdir(join(packageRoot, ".claude-plugin"), { recursive: true });
+    await mkdir(join(packageRoot, "skills", skill), { recursive: true });
+    await writeFile(
+      join(packageRoot, ".claude-plugin", "plugin.json"),
+      JSON.stringify({
+        name: "writer",
+        version,
+        mcpServers: { probe: { command: "not-executed-audit-fixture" } },
+      }),
+    );
+    await writeFile(
+      join(packageRoot, "skills", skill, "SKILL.md"),
+      `---\nname: ${skill}\ndescription: ${skill}\n---\nBody\n`,
+    );
+    await writeFile(
+      join(market, ".claude-plugin", "marketplace.json"),
+      JSON.stringify({
+        name: "audit-market",
+        plugins: [{ name: "writer", source: "./plugins/writer", version }],
+      }),
+    );
+  };
+  await publish("1.0.0", "first");
+  await service.addPluginMarketplace({ workspacePath: workspace, source: market });
+  store.setState({ ...store.getInitialState() }, true);
+  await store
+    .getState()
+    .initialize({ workspacePath: workspace, configScope: "user", pluginService: service });
+  const id = store.getState().plugins.find((entry) => entry.name === "auditprobe")!.id;
+  return {
+    root,
+    workspace,
+    configPath,
+    id,
+    service,
+    agent,
+    store,
+    publish,
+    async close() {
+      if (previous.home === undefined) delete process.env.ZCODE_HOME;
+      else process.env.ZCODE_HOME = previous.home;
+      if (previous.storage === undefined) delete process.env.ZCODE_STORAGE_DIR;
+      else process.env.ZCODE_STORAGE_DIR = previous.storage;
+      store.setState({ ...store.getInitialState() }, true);
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+export async function holdPluginReads(agent: IPluginManagementService) {
+  const ready = deferred();
+  const release = deferred();
+  const originals = {
+    listPlugins: agent.listPlugins,
+    getPluginsOverview: agent.getPluginsOverview,
+  };
+  let reads = 0;
+  for (const method of ["listPlugins", "getPluginsOverview"] as const) {
+    agent[method] = (async (input: never) => {
+      const result = await originals[method](input);
+      reads += 1;
+      if (reads <= 2) {
+        if (reads === 2) ready.resolve();
+        await release.promise;
+      }
+      return result;
+    }) as (typeof agent)[typeof method];
+  }
+  return {
+    ready: ready.promise,
+    release: () => release.resolve(),
+    restore: () => Object.assign(agent, originals),
+  };
+}
