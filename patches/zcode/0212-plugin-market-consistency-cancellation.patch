+  }
+});
+
+test("failed mutation retains already loaded details while invalidating old reads", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const id = "writer@audit-market";
+    await f.store.getState().describePlugin(id, "writer", "audit-market", f.service);
+    const detail = f.store.getState().describeCache[id];
