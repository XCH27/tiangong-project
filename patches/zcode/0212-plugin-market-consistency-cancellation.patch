+      results.push({
+        name: `${locale}: actual market exposes source failure and keeps installed configuration`,
+      });
+      unavailable = false;
+      await click('[data-testid="plugin-store-refresh"]');
+      check(
+        !node.querySelector('[data-testid="plugin-store-error"]'),
+        "Successful retry left stale failure",
+      );
+      await click(`[data-testid="plugin-store-card"][data-plugin-id="${id}"]`);
+      check(node.textContent?.includes("generation-1"), "Original component details missing");
+      version = 2;
+      await act(async () => {
+        await store.getState().updateMarketplace(null, service as never);
