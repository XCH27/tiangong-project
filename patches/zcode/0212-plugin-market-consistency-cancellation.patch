+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IPluginManagementService } from "@zcode/services";
+import { usePluginManagementStore } from "../src/store/pluginManagementStore.js";
+import { loadInto } from "../src/store/pluginManagementStoreLoading.js";
+import { deferred, pluginMarketFixture } from "./pluginMarketFixture.js";
+
+// Controlled response timing covers request ownership separately from the real handlers suite.
+function projection() {
+  let state = {
+    ...usePluginManagementStore.getInitialState(),
+    workspacePath: "/fixture",
+    configScope: "user" as const,
+  };
+  return {
+    get: () => state,
+    set: (value: Partial<typeof state>) => {
+      state = { ...state, ...value };
+    },
+  };
+}
+function pendingService() {
+  const pending: Array<{
+    list: ReturnType<typeof deferred<any>>;
+    overview: ReturnType<typeof deferred<any>>;
+  }> = [];
+  let lists = 0,
+    overviews = 0;
+  const service = {
+    listPlugins() {
+      const index = lists++;
+      pending[index] ??= { list: deferred(), overview: deferred() };
+      return pending[index].list.promise;
+    },
+    getPluginsOverview() {
+      const index = overviews++;
+      pending[index] ??= { list: deferred(), overview: deferred() };
+      return pending[index].overview.promise;
+    },
+  } as unknown as IPluginManagementService;
+  const complete = (index: number, label: string) => {
+    pending[index].list.resolve({ plugins: [], diagnostics: [] });
+    pending[index].overview.resolve({
+      marketplaces: [{ name: label }],
+      availablePlugins: [],
+      installedPlugins: [],
+      restorableBuiltins: [],
+      diagnostics: [],
+    });
+  };
+  return { service, pending, complete, reads: () => lists };
+}
+const request = (
+  p: ReturnType<typeof projection>,
+  service: IPluginManagementService,
+  forceFresh = false,
+) =>
+  loadInto(p.set, p.get, {
+    workspacePath: "/fixture",
+    workspaceIdentity: null,
+    configScope: "user",
+    pluginService: service,
+    forceFresh,
+  });
+
+test("loads deduplicate only inside the originating store and service", async () => {
+  const a = projection(),
+    b = projection(),
+    f = pendingService();
+  const a1 = request(a, f.service),
+    a2 = request(a, f.service),
+    b1 = request(b, f.service);
+  assert.equal(f.reads(), 2);
+  f.complete(0, "a");
+  f.complete(1, "b");
+  await Promise.all([a1, a2, b1]);
+  assert.equal(a.get().marketplaces[0].name, "a");
+  assert.equal(b.get().marketplaces[0].name, "b");
+});
+
+test("old load finally cannot release a newer generation's dedup registration", async () => {
+  const p = projection(),
+    f = pendingService();
+  const old = request(p, f.service);
+  const fresh = request(p, f.service, true);
+  f.complete(0, "old");
+  await old;
+  const joined = request(p, f.service);
+  assert.equal(f.reads(), 2);
+  f.complete(1, "fresh");
+  await Promise.all([fresh, joined]);
+  assert.equal(p.get().marketplaces[0].name, "fresh");
+});
+
+test("replaced service errors cannot start fallback or erase its successor snapshot", async () => {
+  const p = projection(),
+    oldService = pendingService(),
+    newService = pendingService();
+  const old = request(p, oldService.service);
+  const current = request(p, newService.service);
+  newService.complete(0, "current");
+  await current;
+  oldService.pending[0].list.resolve({ plugins: [], diagnostics: [] });
+  oldService.pending[0].overview.resolve(Promise.reject(new Error("stale failure")));
+  await old;
+  assert.equal(oldService.reads(), 1);
+  assert.equal(p.get().marketplaces[0].name, "current");
+  assert.equal(p.get().error, null);
+});
+
+test("older same-id mutation failure cannot set error or release its newer busy owner", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const original = f.agent.configurePlugin;
+    const first = deferred();
+    const second = deferred();
+    let calls = 0;
+    f.agent.configurePlugin = async (input) => {
+      calls++;
+      if (calls === 1) {
+        await first.promise;
+        throw new Error("old failure");
+      }
+      await second.promise;
+      return original(input);
+    };
+    const old = f.store.getState().configurePlugin(f.id, { tone: "old" }, f.service);
+    const current = f.store.getState().configurePlugin(f.id, { tone: "new" }, f.service);
+    const version = f.store.getState().operationVersion;
+    first.resolve();
+    assert.equal(await old, false);
+    assert.equal(f.store.getState().error, null);
+    assert.equal(f.store.getState().operationVersion, version);
+    assert.equal(f.store.getState().operationId, `plugin:configure:${f.id}`);
+    second.resolve();
+    assert.equal(await current, true);
+    assert.equal(f.store.getState().operationId, null);
+    assert.equal(
+      f.store.getState().plugins.find((entry) => entry.id === f.id)?.configuredOptions?.tone,
+      "new",
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("held read cannot clear a newer mutation failure", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const { holdPluginReads } = await import("./pluginMarketFixture.js");
+    const held = await holdPluginReads(f.agent);
