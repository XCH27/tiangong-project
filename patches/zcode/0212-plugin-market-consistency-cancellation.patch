+import { act } from "react";
+import { ZCODE_OFFICIAL_PLUGIN_MARKETPLACE_ID as official } from "@zcode/shared";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
