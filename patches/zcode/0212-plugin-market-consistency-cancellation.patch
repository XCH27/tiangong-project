index 00000000..d3e5f35d
--- /dev/null
+++ b/packages/ui/src/store/pluginManagementStoreDescriptions.ts
@@ -0,0 +1,49 @@
+import type { PluginDescribeEntry, PluginManagementState } from "@/store/pluginManagementStore.js";
+import {
+  capturePluginContext,
+  isPluginContextCurrent,
+} from "@/store/pluginManagementStoreRequests.js";
+import { logger } from "@/logger.js";
+
+export function createPluginDescriptionAction(
+  set: (partial: Partial<PluginManagementState>) => void,
+  get: () => PluginManagementState,
+): PluginManagementState["describePlugin"] {
+  return async (pluginId, pluginName, marketplace, pluginService, force = false) => {
+    const context = capturePluginContext(set, get, pluginService);
+    const { workspacePath, workspaceIdentity, describeCache } = get();
+    if (!workspacePath) return;
+    const cached = describeCache[pluginId];
+    if (!force && cached && cached.status !== "error") return;
+    const pending: PluginDescribeEntry = { status: "loading" };
+    set({ describeCache: { ...get().describeCache, [pluginId]: pending } });
+    // entry 身份同时挡住 force 重试、刷新、Host/scope 切换后的迟到响应。
+    const isCurrent = () =>
+      isPluginContextCurrent(get, context) && get().describeCache[pluginId] === pending;
+    const publish = (entry: PluginDescribeEntry) => {
+      if (isCurrent()) set({ describeCache: { ...get().describeCache, [pluginId]: entry } });
+    };
+    try {
+      const data = await pluginService.describePlugin({
+        workspacePath,
+        ...(workspaceIdentity ? { workspaceIdentity } : {}),
+        marketplace,
+        pluginName,
+      });
+      const blockingDiagnostic = data.diagnostics?.find(
+        (diagnostic) => diagnostic.severity === "error",
+      );
+      // 无组件的错误仍可重试；部分成功的组件与诊断保持原契约。
+      publish(
+        data.components.length === 0 && blockingDiagnostic
+          ? { status: "error", error: blockingDiagnostic.message }
+          : { status: "loaded", data },
+      );
+    } catch (error) {
+      if (!isCurrent()) return;
+      const message = error instanceof Error ? error.message : String(error);
+      logger.error("[plugins] describe failed", { pluginId, marketplace, error: message });
+      publish({ status: "error", error: message });
+    }
+  };
+}
