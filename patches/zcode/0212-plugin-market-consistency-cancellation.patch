diff --git a/apps/zcode-cli/packages/bootstrap/test/helpers/plugin-cancel-ndjson-process.ts b/apps/zcode-cli/packages/bootstrap/test/helpers/plugin-cancel-ndjson-process.ts
new file mode 100644
index 00000000..1a01dc7b
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/helpers/plugin-cancel-ndjson-process.ts
@@ -0,0 +1,19 @@
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { ZCodeProtocolNdjsonConnection } from "../../src/zcode-protocol/transport.js";
+
+// The parent supplies only isolated fixture paths; this process must never create a model App.
+const server = new ZCodeProtocolAgentServer({
+  env: process.env,
+  createZCodeApp: async () => {
+    throw new Error("Catalog cancellation must not start inference");
+  },
+});
+const connection = new ZCodeProtocolNdjsonConnection({
+  input: process.stdin,
+  output: process.stdout,
+  handleMessage: (message) => server.handleMessage(message),
+});
+server.setNotificationSink((message) => connection.send(message));
+connection.start();
+await connection.waitForClose();
+await server.shutdown();
diff --git a/apps/zcode-cli/packages/bootstrap/test/plugin-cancel-ndjson.test.ts b/apps/zcode-cli/packages/bootstrap/test/plugin-cancel-ndjson.test.ts
new file mode 100644
index 00000000..47e368c4
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/test/plugin-cancel-ndjson.test.ts
@@ -0,0 +1,291 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { spawn } from "node:child_process";
+import { createServer } from "node:http";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { loadKnownMarketplacesSync } from "@zcode/adapters/plugins";
+import { zcodeProtocolMethods } from "@zcode/shared";
+
+async function observed(promise: Promise<void>, label: string, timeoutMs: number) {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    await Promise.race([
+      promise,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`${label} blocked`)), timeoutMs);
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "zcode-plugin-cancel-"));
+  const home = join(root, "home");
+  const storage = join(root, "storage");
+  const workspace = join(root, "workspace");
+  await mkdir(join(home, "cli"), { recursive: true });
+  await mkdir(workspace);
+  await writeFile(join(home, "cli", "config.json"), JSON.stringify({ storage: { dir: storage } }));
+  const reached = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const socketClosed = Promise.withResolvers<void>();
+  let aborted = false;
+  const catalog = createServer(async (_request, response) => {
+    response.on("close", () => {
+      if (!response.writableEnded) {
+        aborted = true;
+        socketClosed.resolve();
+      }
+    });
+    reached.resolve();
+    await release.promise;
+    response.setHeader("Content-Type", "application/json");
+    response.end(JSON.stringify({ name: "cancel-fixture", plugins: [] }));
+  });
+  await new Promise<void>((resolve) => catalog.listen(0, "127.0.0.1", resolve));
+  const address = catalog.address();
+  assert.ok(address && typeof address !== "string");
+  const child = spawn(
+    process.execPath,
+    [
+      "--import",
+      import.meta.resolve("tsx"),
+      fileURLToPath(new URL("./helpers/plugin-cancel-ndjson-process.ts", import.meta.url)),
+    ],
+    {
+      cwd: workspace,
+      env: {
+        PATH: process.env.PATH,
+        TMPDIR: tmpdir(),
+        NODE_ENV: "test",
+        ZCODE_HOME: home,
+        ZCODE_STORAGE_DIR: storage,
+      },
+      stdio: ["pipe", "pipe", "pipe"],
+    },
+  );
+  const exit = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {
+    child.once("exit", (code, signal) => resolve({ code, signal }));
+  });
+  const responses = new Map<number, Record<string, any>>();
+  const waiters = new Map<number, (value: Record<string, any>) => void>();
+  const responseOrder: number[] = [];
+  let buffer = "";
+  let errors = "";
+  child.stderr.on("data", (chunk) => {
+    errors += chunk.toString();
+  });
+  child.stdout.on("data", (chunk) => {
+    buffer += chunk.toString();
+    for (let newline = buffer.indexOf("\n"); newline >= 0; newline = buffer.indexOf("\n")) {
+      const value = JSON.parse(buffer.slice(0, newline));
+      buffer = buffer.slice(newline + 1);
+      if (typeof value.id !== "number") continue;
+      responses.set(value.id, value);
+      responseOrder.push(value.id);
+      waiters.get(value.id)?.(value);
+      waiters.delete(value.id);
+    }
+  });
+  return {
+    get reached() {
+      return observed(reached.promise, "catalog admission", 5_000);
+    },
+    get socketClosed() {
+      return observed(socketClosed.promise, "catalog abort", 1_000);
+    },
+    get aborted() {
+      return aborted;
+    },
+    responses,
+    responseOrder,
+    workspace: { workspacePath: workspace, workspaceKey: workspace },
+    source: `http://127.0.0.1:${address.port}/catalog.json`,
+    send(id: number, method: string, params: unknown) {
+      child.stdin.write(`${JSON.stringify({ id, method, params })}\n`);
+    },
+    sendBatch(messages: Array<{ id: number; method: string; params: unknown }>) {
+      child.stdin.write(`${messages.map((message) => JSON.stringify(message)).join("\n")}\n`);
+    },
+    async response(id: number, timeoutMs = 1_000) {
+      if (responses.has(id)) return responses.get(id)!;
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      try {
+        return await Promise.race([
+          new Promise<Record<string, any>>((resolve) => waiters.set(id, resolve)),
+          new Promise<never>((_, reject) => {
+            timer = setTimeout(
+              () => reject(new Error(`Response ${id} blocked; ${errors}`)),
+              timeoutMs,
+            );
+          }),
+        ]);
+      } finally {
+        if (timer) clearTimeout(timer);
+        waiters.delete(id);
+      }
+    },
+    known: () => loadKnownMarketplacesSync(join(storage, "cli", "plugins")),
+    release: () => release.resolve(),
+    async close() {
+      release.resolve();
+      child.stdin.end();
+      const deadline = setTimeout(() => child.kill("SIGKILL"), 2_000);
+      const result = await exit;
+      clearTimeout(deadline);
+      await new Promise<void>((resolve) => {
+        catalog.close(() => resolve());
+        catalog.closeAllConnections();
+      });
+      await rm(root, { recursive: true, force: true });
+      assert.deepEqual(result, { code: 0, signal: null }, errors);
+    },
+  };
+}
+
+test(
+  "NDJSON cancellation reaches the original plugin operation while its catalog GET remains held",
+  { timeout: 8_000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.send(1, zcodeProtocolMethods.pluginsMarketplaceAdd, {
+        workspace: f.workspace,
+        source: f.source,
+        operationId: "held-catalog",
+      });
+      await f.reached;
+      f.send(2, zcodeProtocolMethods.pluginsCancelOperation, { operationId: "held-catalog" });
+      assert.deepEqual((await f.response(2)).result, {
+        operationId: "held-catalog",
+        cancelled: true,
+      });
+      const cancelled = await f.response(1);
+      assert.ok(cancelled.error);
+      assert.equal(cancelled.result, undefined);
+      await f.socketClosed;
+      assert.equal(f.aborted, true);
+      assert.deepEqual(
+        f.known(),
+        [],
+        "cancelled catalog must not persist a successful marketplace",
+      );
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "an unknown cancellation leaves the running operation and ordinary response order intact",
+  { timeout: 8_000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.send(1, zcodeProtocolMethods.pluginsMarketplaceAdd, {
+        workspace: f.workspace,
+        source: f.source,
+        operationId: "held-catalog",
+      });
+      await f.reached;
+      f.send(2, zcodeProtocolMethods.sessionList, { workspace: f.workspace });
+      f.send(3, zcodeProtocolMethods.pluginsCancelOperation, { operationId: "unrelated" });
+      assert.deepEqual((await f.response(3)).result, {
+        operationId: "unrelated",
+        cancelled: false,
+      });
+      assert.equal(f.aborted, false);
+      assert.equal(f.responses.has(1), false);
+      assert.equal(
+        f.responses.has(2),
+        false,
+        "ordinary request must still wait for the held catalog",
+      );
+      f.release();
+      assert.ok((await f.response(1)).result);
+      assert.ok((await f.response(2)).result);
+      assert.ok(f.responseOrder.indexOf(1) < f.responseOrder.indexOf(2));
+      assert.equal(f.known().length, 1);
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "one NDJSON input batch registers the original operation before cancellation bypasses queued work",
+  { timeout: 8_000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.send(0, zcodeProtocolMethods.sessionList, { workspace: f.workspace });
+      await f.response(0, 5_000);
+      f.sendBatch([
+        {
+          id: 1,
+          method: zcodeProtocolMethods.pluginsMarketplaceAdd,
+          params: {
+            workspace: f.workspace,
+            source: f.source,
+            operationId: "batch-catalog",
+          },
+        },
+        { id: 2, method: zcodeProtocolMethods.sessionList, params: { workspace: f.workspace } },
+        {
+          id: 3,
+          method: zcodeProtocolMethods.pluginsCancelOperation,
+          params: { operationId: "batch-catalog" },
+        },
+      ]);
+      assert.deepEqual((await f.response(3)).result, {
+        operationId: "batch-catalog",
+        cancelled: true,
+      });
+      assert.ok((await f.response(1)).error);
+      assert.ok((await f.response(2)).result);
+      assert.ok(f.responseOrder.indexOf(1) < f.responseOrder.indexOf(2));
+      assert.deepEqual(f.known(), []);
+      f.send(4, zcodeProtocolMethods.pluginsCancelOperation, { operationId: "batch-catalog" });
+      assert.deepEqual((await f.response(4)).result, {
+        operationId: "batch-catalog",
+        cancelled: false,
+      });
+    } finally {
+      await f.close();
+    }
+  },
+);
+
+test(
+  "an intervening ordinary request cannot delay cancellation of the running operation",
+  { timeout: 8_000 },
+  async () => {
+    const f = await fixture();
+    try {
+      f.send(1, zcodeProtocolMethods.pluginsMarketplaceAdd, {
+        workspace: f.workspace,
+        source: f.source,
+        operationId: "held-catalog",
+      });
+      await f.reached;
+      f.send(2, zcodeProtocolMethods.sessionList, { workspace: f.workspace });
+      f.send(3, zcodeProtocolMethods.pluginsCancelOperation, { operationId: "held-catalog" });
+      assert.deepEqual((await f.response(3)).result, {
+        operationId: "held-catalog",
+        cancelled: true,
+      });
+      assert.ok((await f.response(1)).error);
+      assert.ok((await f.response(2)).result);
+      assert.ok(f.responseOrder.indexOf(1) < f.responseOrder.indexOf(2));
+      await f.socketClosed;
+      assert.deepEqual(f.known(), []);
+    } finally {
+      await f.close();
+    }
+  },
+);
