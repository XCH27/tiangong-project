+    assert.equal(f.store.getState().error, "current mutation failure");
+  } finally {
+    await f.close();
+  }
+});
+
+test("a read started during mutation cannot replace its later failure with overview fallback", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const mutationReady = deferred();
+    const fail = deferred();
+    f.agent.configurePlugin = async () => {
