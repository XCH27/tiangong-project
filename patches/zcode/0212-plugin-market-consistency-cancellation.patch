+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import { pluginMarketFixture, holdPluginReads, deferred } from "./pluginMarketFixture.js";
+
+// ZP-FIX/U: successful writes must read after commit, not join the read they supersede.
+test("configuration save supersedes held reads and survives reopening the projection", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    await f.store.getState().configurePlugin(f.id, { tone: "old" }, f.service);
+    const held = await holdPluginReads(f.agent);
+    const oldRead = f.store.getState().refresh(f.service);
+    await held.ready;
+    const saved = f.store.getState().configurePlugin(f.id, { tone: "new" }, f.service);
+    // Mutation is actually persisted before the old read is released.
+    for (let i = 0; i < 100; i++) {
+      const disk = JSON.parse(await readFile(f.configPath, "utf8"));
+      if (disk.plugins.options[f.id].tone === "new") break;
+      await new Promise((resolve) => setTimeout(resolve, 5));
+    }
+    held.release();
+    assert.equal(await saved, true);
+    await oldRead;
+    assert.equal(
+      f.store.getState().plugins.find((entry) => entry.id === f.id)?.configuredOptions?.tone,
+      "new",
+    );
+    held.restore();
+    f.store.setState({ ...f.store.getInitialState() }, true);
+    await f.store
+      .getState()
+      .initialize({ workspacePath: f.workspace, configScope: "user", pluginService: f.service });
+    assert.equal(
+      f.store.getState().plugins.find((entry) => entry.id === f.id)?.configuredOptions?.tone,
+      "new",
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("catalog refresh replaces cached details and ignores a held old description", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const id = "writer@audit-market";
+    await f.store.getState().describePlugin(id, "writer", "audit-market", f.service);
+    assert.equal(f.store.getState().describeCache[id].data?.metadata?.version, "1.0.0");
+    const original = f.agent.describePlugin;
+    const ready = deferred();
+    const release = deferred();
+    f.agent.describePlugin = async (input) => {
+      const result = await original(input);
+      ready.resolve();
+      await release.promise;
+      return result;
+    };
+    const oldDetail = f.store
+      .getState()
+      .describePlugin(id, "writer", "audit-market", f.service, true);
+    await ready.promise;
+    await f.publish("2.0.0", "second");
+    assert.equal(await f.store.getState().updateMarketplace("audit-market", f.service), true);
+    f.agent.describePlugin = original;
+    await f.store.getState().describePlugin(id, "writer", "audit-market", f.service);
+    release.resolve();
+    await oldDetail;
+    const detail = f.store.getState().describeCache[id].data!;
+    assert.equal(detail.metadata?.version, "2.0.0");
+    assert.ok(
+      detail.components.some((group) => group.items.some((item) => item.name === "second")),
+    );
+    assert.equal(
+      f.store.getState().availablePlugins.find((entry) => entry.id === id)?.version,
+      "2.0.0",
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("overview failure preserves installed fallback and exposes an error until retry", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    const original = f.agent.getPluginsOverview;
+    f.agent.getPluginsOverview = async () => {
+      throw new Error("fixture catalog transport failure");
+    };
+    await f.store.getState().refresh(f.service);
+    assert.equal(f.store.getState().error, "fixture catalog transport failure");
+    assert.equal(f.store.getState().marketplaceAvailabilityKnown, false);
+    assert.ok(f.store.getState().plugins.some((entry) => entry.id === f.id));
+    f.agent.getPluginsOverview = original;
+    await f.store.getState().refresh(f.service);
+    assert.equal(f.store.getState().error, null);
+    assert.equal(f.store.getState().marketplaceAvailabilityKnown, true);
+    assert.ok(f.store.getState().marketplaces.some((entry) => entry.name === "audit-market"));
+  } finally {
+    await f.close();
+  }
+});
+
+test("enable and grant commits supersede held snapshots without changing grant ownership", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    await f.store.getState().installPlugin("writer", "audit-market", f.service);
+    const id = "writer@audit-market";
+    assert.equal(
+      f.store.getState().plugins.find((entry) => entry.id === id)?.grant?.granted,
+      false,
+    );
+    for (const mutation of [
+      () => f.store.getState().setEnabled(id, false, f.service),
+      () => f.store.getState().setEnabled(id, true, f.service),
+      () =>
+        f.store
+          .getState()
+          .grantPlugin(
+            id,
+            f.store.getState().plugins.find((entry) => entry.id === id)!.grant!.fingerprint,
+            f.service,
+          ),
+      () => f.store.getState().revokePluginGrant(id, f.service),
+    ]) {
+      const held = await holdPluginReads(f.agent);
+      const old = f.store.getState().refresh(f.service);
+      await held.ready;
+      assert.equal(await mutation(), true);
+      const current = await f.agent.listPlugins({
+        workspacePath: f.workspace,
+        configScope: "user",
+      });
+      held.release();
+      await old;
+      held.restore();
+      assert.deepEqual(
+        f.store.getState().plugins.find((entry) => entry.id === id),
+        current.plugins.find((entry) => entry.id === id),
+      );
+    }
+    f.store.setState({ ...f.store.getInitialState() }, true);
+    await f.store
+      .getState()
+      .initialize({ workspacePath: f.workspace, configScope: "user", pluginService: f.service });
+    const reopened = f.store.getState().plugins.find((entry) => entry.id === id)!;
+    assert.equal(reopened.enabled, true);
+    assert.equal(reopened.grant?.granted, false);
+    assert.deepEqual(reopened.mcpServerNames, []);
+  } finally {
+    await f.close();
+  }
+});
+
+test("scope A→B→A rejects late A snapshot and description", async () => {
+  const f = await pluginMarketFixture();
+  try {
+    await f.store.getState().configurePlugin(f.id, { tone: "old" }, f.service);
+    const held = await holdPluginReads(f.agent);
+    const old = f.store.getState().refresh(f.service);
+    await held.ready;
