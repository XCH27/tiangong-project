diff --git a/packages/ui/src/settings/pluginMarketplaceAddAttempt.ts b/packages/ui/src/settings/pluginMarketplaceAddAttempt.ts
new file mode 100644
index 00000000..c0bad84d
--- /dev/null
+++ b/packages/ui/src/settings/pluginMarketplaceAddAttempt.ts
@@ -0,0 +1,30 @@
+import type { IPluginManagementService } from "@zcode/services";
+
+/** UI lifetime only; the original backend operation/controller owns cancellation and writes. */
+export function createPluginMarketplaceAddAttempt(service: IPluginManagementService) {
+  const operationId = `plugin-market-add:${crypto.randomUUID()}`;
+  let closed = false;
+  let cancellation: Promise<void> | undefined;
+  return {
+    operationId,
+    get closed() {
+      return closed;
+    },
+    dismiss() {
+      closed = true;
+    },
+    async close() {
+      closed = true;
+      if (cancellation) return cancellation;
+      const pending = service.cancelPluginOperation({ operationId }).then(() => {});
+      cancellation = pending;
+      try {
+        await pending;
+      } catch (error) {
+        // A failed acknowledgement remains retryable against the same original operation.
+        if (cancellation === pending) cancellation = undefined;
+        throw error;
+      }
+    },
+  };
+}
