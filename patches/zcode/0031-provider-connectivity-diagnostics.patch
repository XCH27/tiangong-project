+import assert from "node:assert/strict";
+import test from "node:test";
+import { modelConnectivityFailure, modelConnectivityResultSchema } from "@zcode/shared";
+import { createProviderSettingsConnectivityTester } from "../src/model-provider/providerSettingsConnectivity.js";
+
+test("connectivity failures retain safe cause classes and never infer plan expiry from authorization", () => {
+  const check = (facts: unknown, kind: string) => {
+    const result = modelConnectivityFailure({ connectivityFailure: facts });
+    assert.equal(result.success, false);
+    if (!result.success) assert.equal(result.error.kind, kind);
+    assert.ok(modelConnectivityResultSchema.safeParse(result).success);
+    return result;
+  };
+  check({ statusCode: 403, reason: "auth_failed" }, "authentication");
+  check(
+    {
+      statusCode: 403,
+      providerErrorCode: "access_terminated_error",
+      providerErrorMessage:
+        "Your current subscription does not have access to Kimi Code right now.",
+    },
+    "subscription-access",
+  );
+  check({ statusCode: 403, providerErrorCode: "subscription_expired" }, "subscription-expired");
+  check({ statusCode: 429, providerErrorCode: "insufficient_quota" }, "quota");
+  check({ statusCode: 429, reason: "rate_limited" }, "rate-limit");
+  check({ statusCode: 404, errorCode: "model_not_found" }, "model");
+  check({ statusCode: 404 }, "endpoint");
+  check({ statusCode: 400, reason: "invalid_request" }, "request");
+  check({ reason: "tls_error" }, "network");
+  check({ reason: "timeout" }, "timeout");
+  check({ statusCode: 403, providerErrorCode: "unsupported_client" }, "client");
+  const secret = check(
+    { statusCode: 401, providerErrorMessage: "secret key sk-fixture-secret" },
+    "authentication",
+  );
+  assert.equal(JSON.stringify(secret).includes("sk-fixture-secret"), false);
+});
+test("the service preserves a typed failed probe instead of turning any returned RPC into success", async () => {
+  const result = modelConnectivityFailure({
+    connectivityFailure: { statusCode: 403, providerErrorCode: "unsupported_client" },
+  });
+  const tester = createProviderSettingsConnectivityTester({
+    testModelConnectivity: async () => result,
+  });
+  assert.deepEqual(
+    await tester({ workspacePath: "/fixture", providerId: "p", modelId: "m" }),
+    result,
+  );
+  const old = createProviderSettingsConnectivityTester({
+    testModelConnectivity: async () => {
+      throw Error("Provider authentication failed.");
+    },
+  });
+  const failed = await old({ workspacePath: "/fixture", providerId: "p", modelId: "m" });
+  assert.equal(failed.success, false);
+  if (!failed.success) assert.equal(failed.error.kind, "authentication");
+});
+
+test("formal runtime probe carries its network failure through the bounded result", async () => {
+  const { testModelConnectivity } =
+    await import("../../../apps/zcode-cli/packages/core/src/runtime/methods/workspace-generate-text.js");
+  const { getCurrentModelInvocationContext } =
+    await import("../../../apps/zcode-cli/packages/contracts/dist/index.js");
+  const model: any = {
+    providerId: "p",
+    modelId: "m",
+    properties: {},
+    optionSpecs: { reasoningLevel: { values: ["low"] } },
+    options: {},
+    bind() {
+      return this;
+    },
+    async *streamText() {
+      await getCurrentModelInvocationContext()?.statusSink?.publish({
+        type: "model_request_failed",
+        reason: "auth_failed",
+        errorCode: "provider_not_configured",
+        providerErrorCode: "unsupported_client",
+        providerErrorMessage: "unsupported client",
+        statusCode: 403,
+        retryable: false,
+        message: "Provider authentication failed.",
+      } as never);
+      yield { type: "error", error: Error("Provider authentication failed.") };
+    },
+  };
+  const runtime: any = {
+    config: {},
+    rootTraceContext: { traceId: "trace", spanId: "span", attributes: {} },
+    modelFactory: () => model,
+    createModelStatusSink: (_trace: unknown, _events: unknown, options: any) => ({
+      publish: async (event: unknown) => options.onStatus(event),
+    }),
+  };
+  let caught: unknown;
+  try {
+    await testModelConnectivity.call(runtime, {
+      selection: { providerId: "p", modelId: "m" } as never,
+    });
+  } catch (error) {
+    caught = error;
+  }
+  assert.ok(caught);
+  const result = modelConnectivityFailure(caught);
+  assert.equal(result.success, false);
+  if (!result.success) {
+    assert.equal(result.error.kind, "client");
+    assert.equal(result.error.statusCode, 403);
+  }
+});
