diff --git a/packages/shared/src/model-connectivity.ts b/packages/shared/src/model-connectivity.ts
new file mode 100644
index 0000000..4da2068
--- /dev/null
+++ b/packages/shared/src/model-connectivity.ts
@@ -0,0 +1,116 @@
+import { z } from "zod";
+
+export const modelConnectivityFailureKindSchema = z.enum([
+  "authentication",
+  "subscription-expired",
+  "subscription-access",
+  "quota",
+  "rate-limit",
+  "model",
+  "endpoint",
+  "request",
+  "context",
+  "client",
+  "timeout",
+  "network",
+  "provider",
+  "cancelled",
+  "changed",
+  "unsaved",
+  "environment",
+  "unknown",
+]);
+export const modelConnectivityResultSchema = z.discriminatedUnion("success", [
+  z.object({ success: z.literal(true) }),
+  z.object({
+    success: z.literal(false),
+    error: z.object({
+      message: z.string(),
+      code: z.enum(["provider-unavailable", "model-unavailable"]).optional(),
+      kind: modelConnectivityFailureKindSchema.optional(),
+      statusCode: z.number().int().min(100).max(599).optional(),
+    }),
+  }),
+]);
+export type ModelConnectivityResult = z.infer<typeof modelConnectivityResultSchema>;
+const record = (value: unknown): Record<string, unknown> =>
+  value && typeof value === "object" ? (value as Record<string, unknown>) : {};
+
+/** Consume classified transport facts; never expose provider bodies or infer subscription expiry from 403. */
+export function modelConnectivityFailure(error: unknown): ModelConnectivityResult {
+  const e = record(error);
+  const d = record(e.connectivityFailure ?? e.data ?? e.context);
+  const code = String(d.errorCode ?? d.code ?? e.code ?? "").toLowerCase();
+  const reason = String(d.reason ?? "").toLowerCase();
+  const providerCode = String(d.providerErrorCode ?? "").toLowerCase();
+  const message = String(d.providerErrorMessage ?? d.message ?? e.message ?? "").toLowerCase();
+  const status = typeof d.statusCode === "number" ? d.statusCode : undefined;
+  let kind: z.infer<typeof modelConnectivityFailureKindSchema> = "unknown";
+  if (reason === "cancelled" || code === "model_request_cancelled") kind = "cancelled";
+  else if (
+    /subscription_expired|plan_expired/.test(providerCode) ||
+    /subscription (?:has )?expired|订阅(?:已)?到期|套餐(?:已)?过期/.test(message)
+  )
+    kind = "subscription-expired";
+  else if (
+    providerCode === "access_terminated_error" ||
+    /subscription does not have access/.test(message)
+  )
+    kind = "subscription-access";
+  else if (
+    /insufficient_quota|quota_exceeded|insufficient_balance|balance_not_enough/.test(
+      providerCode,
+    ) ||
+    /quota (?:has been )?exceeded|insufficient (?:quota|balance)|余额不足|额度(?:已)?用尽/.test(
+      message,
+    )
+  )
+    kind = "quota";
+  else if (
+    /unsupported_client|client_not_allowed/.test(providerCode) ||
+    /unsupported client|only (?:available|accessible).*coding|user.agent.*(?:required|not allowed)/.test(
+      message,
+    )
+  )
+    kind = "client";
+  else if (code === "model_not_found" || /model_not_found|invalid_model/.test(providerCode))
+    kind = "model";
+  else if (reason === "context_exceeded" || code === "model_context_exceeded") kind = "context";
+  else if (
+    status === 401 ||
+    status === 403 ||
+    reason === "auth_failed" ||
+    code === "model_request_auth_missing" ||
+    /authentication failed/.test(message)
+  )
+    kind = "authentication";
+  else if (status === 404 || status === 405) kind = "endpoint";
+  else if (status === 429 || reason === "rate_limited") kind = "rate-limit";
+  else if (
+    reason === "timeout" ||
+    reason === "stream_idle_timeout" ||
+    code === "model_request_timeout"
+  )
+    kind = "timeout";
+  else if (
+    ["network_error", "tls_error", "proxy_error"].includes(reason) ||
+    /fetch failed|network|econnrefused|enotfound/.test(message)
+  )
+    kind = "network";
+  else if (
+    status === 400 ||
+    status === 422 ||
+    reason === "invalid_request" ||
+    code === "invalid_model_request"
+  )
+    kind = "request";
+  else if (status && status >= 500) kind = "provider";
+  return {
+    success: false,
+    error: {
+      message: "Model connectivity test failed.",
+      kind,
+      ...(status && status >= 100 && status <= 599 ? { statusCode: status } : {}),
+    },
+  };
+}
