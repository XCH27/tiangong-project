+++ b/apps/zcode-cli/packages/adapters/src/fs/native-boundary.ts
@@ -1,5 +1,5 @@
 import { lstat, realpath, stat } from "node:fs/promises";
-import { isAbsolute, join, relative, sep } from "node:path";
+import { dirname, isAbsolute, join, relative, sep } from "node:path";
 import { createFileSystemError } from "@zcode/contracts";
 import { throwIfAborted } from "./file-errors.js";
 import { resolveAbsoluteRequestPath } from "./file-values.js";
@@ -17,6 +17,31 @@ function descendantPath(root: string, path: string): string | undefined {
     : undefined;
 }
 
+/**
+ * The request may name the workspace through a different spelling than boundaryRoot, e.g. an
+ * ancestor symlink (macOS /var -> /private/var) or a workspace alias. Canonicalize only the
+ * ancestor that resolves to the workspace root itself; segments below it stay literal so
+ * assertNativeFileBoundary still rejects symlinks inside the workspace.
+ */
+async function descendantThroughCanonicalAncestor(
+  root: string,
+  path: string,
+): Promise<string | undefined> {
+  let ancestor = dirname(path);
+  while (ancestor !== dirname(ancestor)) {
+    try {
+      if ((await realpath(ancestor)) === root) {
+        const rest = descendantPath(ancestor, path);
+        return rest === undefined ? undefined : rest;
+      }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    }
+    ancestor = dirname(ancestor);
+  }
+  return undefined;
+}
+
 function denied(path: string) {
   return createFileSystemError({
     code: "permission_denied",
@@ -33,7 +58,10 @@ export async function resolveNativeFileBoundary(
   throwIfAborted(signal);
   const requestedRoot = resolveAbsoluteRequestPath(boundaryRoot);
   const root = await realpath(requestedRoot);
-  const child = descendantPath(requestedRoot, path) ?? descendantPath(root, path);
+  const child =
+    descendantPath(requestedRoot, path) ??
+    descendantPath(root, path) ??
+    (await descendantThroughCanonicalAncestor(root, path));
   if (child === undefined) throw denied(path);
   const boundary = { requestedRoot, root, path: join(root, child) };
   await assertNativeFileBoundary(boundary, signal);
