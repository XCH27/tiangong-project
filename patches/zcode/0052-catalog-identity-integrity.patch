+test("one xAI ID may advertise both chat and image output in different catalogs", async () => {
+  const f = await fixture();
+  try {
+    const provider = (await f.service.getView()).providers.find(
+      (row) => row.providerId === f.providerId,
+    )!;
+    await f.service.savePersonalProviderOverlay(f.providerId, {
+      ...provider.personalConfig,
+      api: { type: "openai-responses", baseUrl: "https://api.x.ai/v1" },
+      access: { type: "api-key", apiKey: "synthetic" },
+    });
+    f.setFetch(async (input) => {
+      const path = new URL(String(input)).pathname;
+      if (path === "/v1/language-models")
+        return Response.json({ models: [{ id: "grok-both", output_modalities: ["text"] }] });
+      if (path === "/v1/image-generation-models")
+        return Response.json({ models: [{ id: "grok-both", output_modalities: ["image"] }] });
+      if (path === "/v1/video-generation-models") return Response.json({ models: [] });
+      throw new Error(`Unexpected ${path}`);
+    });
+    await f.service.discoverModels(f.providerId);
+    const model = (await f.models()).find((row) => row.modelId === "grok-both")!;
+    assert.equal(model.effectiveConfig.properties?.outputFormat?.supportsText, true);
+    assert.equal(model.effectiveConfig.properties?.outputFormat?.supportsImage, true);
+  } finally {
+    await f.dispose();
+  }
+});
