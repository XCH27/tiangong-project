diff --git a/apps/zcode-cli/packages/core/test/stop-late-effect.test.ts b/apps/zcode-cli/packages/core/test/stop-late-effect.test.ts
new file mode 100644
index 0000000..09faba3
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/stop-late-effect.test.ts
@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import test from "node:test";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { readToolEntry } from "../src/tool/handlers/read.js";
+import { writeToolEntry } from "../src/tool/handlers/write.js";
+import { STOP_SETTLE_GRACE_MS } from "../src/tool/executor/timeout.js";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+// RECOVERY-01: Stop arrives while Write is inside its atomic rename. The file may still change, so
+// the record must report what happened, never "cancelled before the file operation completed".
+async function stopDuringRename(holdMs: number, streaming: boolean) {
+  const late: Array<Record<string, unknown>> = [];
+  const logger = {
+    info() {},
+    debug() {},
+    error() {},
+    warn(_message: string, data: any) {
+      if (data?.event === "tool.call.late_outcome") late.push(data);
+    },
+    child() {
+      return logger;
+    },
+  };
+  const f = await fixture(undefined, streaming, {
+    config: { toolAllowlist: ["Read", "Write"] },
+    deps: { fileSystemPort: new NodeFileSystemAdapter(), logger: logger as never },
+  });
+  const path = join(f.dir, "doc.txt");
+  await fs.writeFile(path, "original");
+  for (const entry of [readToolEntry, writeToolEntry]) f.runtime.getToolRegistry().register(entry);
+  f.runtime.invalidateToolCache();
+  const entered = Promise.withResolvers<void>();
+  const committed = Promise.withResolvers<void>();
+  const rename = fs.rename;
+  fs.rename = async (from, to) => {
+    if (to !== path) return rename(from, to);
+    entered.resolve();
+    await new Promise((resolve) => setTimeout(resolve, holdMs));
+    await rename(from, to);
+    committed.resolve();
+  };
+  syncBuiltinESMExports();
+  try {
+    f.steps.push(
+      () => reply("Read", [{ id: "read", name: "Read", input: { file_path: path } }]),
+      () => reply("Write", [{ id: "write", name: "Write", input: { file_path: path, content: "replacement" } }]),
+      () => reply("unexpected-after-stop"),
+    );
+    const turn = f.runtime.executeTurn("replace disposable document").then(
+      () => "completed",
+      (error: Error) => error.message,
+    );
+    await entered.promise;
+    f.runtime.stopActiveForegroundExecution();
+    const settled = await turn;
+    await committed.promise;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+    const messages = await f.store.messages({ sessionID: "session" as never });
+    const write = messages.flatMap((m: any) => m.parts).find((p: any) => p.type === "tool" && p.callID === "write");
+    return { settled, file: await fs.readFile(path, "utf8"), write, late, requests: f.requests.length };
+  } finally {
+    fs.rename = rename;
+    syncBuiltinESMExports();
+    await f.close();
+  }
+}
+
+for (const streaming of [false, true]) {
+  test(`a write that commits after Stop is recorded as completed (streaming=${streaming})`, async () => {
+    const r = await stopDuringRename(100, streaming);
+    assert.equal(r.settled, "Turn was cancelled.");
+    assert.equal(r.file, "replacement");
+    assert.equal(r.write.state.status, "completed");
+    assert.equal(r.requests, 2, "no model step after Stop");
+    assert.deepEqual(r.late, []);
+  });
+}
+
+test("a write still running past the grace is recorded as unknown, and its late outcome is logged", async () => {
+  const r = await stopDuringRename(STOP_SETTLE_GRACE_MS + 400, false);
+  assert.equal(r.settled, "Turn was cancelled.");
+  assert.equal(r.write.state.status, "error");
+  assert.match(r.write.state.error, /may still complete/);
+  assert.doesNotMatch(r.write.state.error, /before the file operation completed/);
+  assert.equal(r.file, "replacement");
+  assert.equal(r.requests, 2);
+  assert.deepEqual(
+    r.late.map((entry) => [entry.toolName, entry.status]),
+    [["Write", "completed"]],
+  );
+});
