+import assert from "node:assert/strict";
+import test from "node:test";
+import { fixture, reply, call } from "./helpers/pi-runtime-fixture.js";
+
+for (const revoked of [false, true]) {
+  test(
+    `a pending approval ${revoked ? "cannot override a later project denial" : "still executes once when its project rules allow it"}`,
+    { timeout: 10000 },
+    async () => {
+      const f = await fixture();
+      const waiting = Promise.withResolvers<void>();
+      const approval = Promise.withResolvers<{ decision: "allow" | "deny" }>();
+      let running: ReturnType<typeof f.runtime.executeTurn> | undefined;
+      try {
+        f.permissionWith(async () => {
+          waiting.resolve();
+          return approval.promise;
+        });
+        f.steps.push(
+          () => reply("Request a tool", [call("pending", "this exact effect")]),
+          () => reply("Finish"),
+        );
+        running = f.runtime.executeTurn("Wait for a permission decision");
+        await waiting.promise;
+        if (revoked) {
+          const session = await f.store.getSession("session" as never);
+          assert.ok(session);
+          await f.store.saveProjectPermission({
+            projectID: session.projectID,
+            permission: { version: 1, deny: [{ toolName: "Probe" }] },
+          });
+        }
+        approval.resolve({ decision: "allow" });
+        await running;
+        assert.equal(f.effects, revoked ? 0 : 1);
+        assert.equal(
+          f.permissionCalls,
+          1,
+          "Dispatch recheck must not create a second approval for unchanged Ask rules",
+        );
+        if (revoked) {
+          await f.reopen();
+          const session = await f.store.getSession("session" as never);
+          assert.ok(session);
+          assert.deepEqual((await f.store.getProjectPermission(session.projectID))?.deny, [
+            { toolName: "Probe" },
+          ]);
+          assert.equal(f.effects, 0, "Reopening must not replay a denied effect");
+        }
+      } finally {
+        approval.resolve({ decision: "deny" });
+        await running?.catch(() => {});
+        await f.close();
+      }
+    },
+  );
+}
+
+test(
+  "remembered approval cannot overwrite a denial committed after its rules read",
+  { timeout: 10000 },
+  async () => {
+    const f = await fixture();
+    const read = f.store.getProjectPermission.bind(f.store);
+    let reads = 0;
+    try {
+      f.store.getProjectPermission = async (projectID) => {
+        const observed = await read(projectID);
+        if (++reads === 2)
+          await f.store.saveProjectPermission({
+            projectID,
+            permission: { version: 1, deny: [{ toolName: "Probe" }] },
+          });
+        return observed;
+      };
+      f.permissionWith(async () => ({
+        decision: "allow",
+        permissionUpdates: [
+          { type: "addRules", behavior: "allow", rules: [{ toolName: "Probe" }] },
+        ],
+      }));
+      f.steps.push(
+        () => reply("Remember this permission", [call("remember", "must not run")]),
+        () => reply("Finish"),
+      );
+      await f.runtime.executeTurn("Remember an approval while project rules change");
+      assert.equal(f.effects, 0);
+      const session = await f.store.getSession("session" as never);
+      assert.ok(session);
+      assert.deepEqual(await read(session.projectID), {
+        version: 1,
+        deny: [{ toolName: "Probe" }],
+      });
+      await f.reopen();
+      assert.deepEqual(await f.store.getProjectPermission(session.projectID), {
+        version: 1,
+        deny: [{ toolName: "Probe" }],
+      });
+    } finally {
+      await f.close();
+    }
+  },
+);
