diff --git a/packages/ui/src/settings/model-provider-section/useModelConnectivityProbe.ts b/packages/ui/src/settings/model-provider-section/useModelConnectivityProbe.ts
new file mode 100644
index 0000000..9ce0b38
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/useModelConnectivityProbe.ts
@@ -0,0 +1,112 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { modelConnectivityFailure, type ModelConnectivityResult } from "@zcode/shared";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { useProviderDetailFeedback } from "./ProviderDetailFeedback.js";
+import { modelConnectivityErrorMessage } from "./providerStatus.js";
+
+/** One saved-model probe lifetime; drafts never enter a connectivity request. */
+export function useModelConnectivityProbe({
+  onTest,
+  modelId,
+  providerId,
+  providerName,
+  providerEnabled,
+}: {
+  onTest?: (model: string) => Promise<ModelConnectivityResult>;
+  modelId: string;
+  providerId: string;
+  providerName: string;
+  providerEnabled: boolean;
+}) {
+  const { intl } = useZCodeIntl();
+  const { showFeedback } = useProviderDetailFeedback();
+  const [isTesting, setIsTesting] = useState(false);
+  const testingRef = useRef(false);
+  const testGeneration = useRef(0);
+  useEffect(
+    () => () => {
+      testGeneration.current++;
+    },
+    [providerId, modelId],
+  );
+  const handleTest = useCallback(async () => {
+    if (!onTest || testingRef.current || !providerEnabled) {
+      return;
+    }
+
+    // 测试只能使用已保存的 ID，不能夹带编辑弹窗里尚未提交的重命名。
+    testingRef.current = true;
+    const version = ++testGeneration.current;
+    const dedupeKey = `model-test:${providerId}:${modelId}`;
+    showFeedback({
+      key: dedupeKey,
+      message: intl.formatMessage(
+        { id: "settings.modelProvider.testModel.connectingWithIdentity" },
+        { provider: providerName, model: modelId },
+      ),
+      state: "pending",
+      durationMs: 0,
+    });
+    setIsTesting(true);
+    try {
+      const result = await onTest(modelId);
+      if (version !== testGeneration.current) return;
+      if (result.success) {
+        showFeedback({
+          key: dedupeKey,
+          message: intl.formatMessage(
+            { id: "settings.modelProvider.testModel.successWithIdentity" },
+            { provider: providerName, model: modelId },
+          ),
+          state: "success",
+          successEmphasis: true,
+          dismissible: true,
+          dismissLabel: intl.formatMessage({ id: "common.close" }),
+        });
+      } else {
+        showFeedback({
+          key: dedupeKey,
+          state: "failure",
+          message: intl.formatMessage(
+            { id: "settings.modelProvider.testModel.failedWithIdentity" },
+            {
+              provider: providerName,
+              model: modelId,
+              reason: modelConnectivityErrorMessage(result.error, intl),
+            },
+          ),
+          durationMs: 0,
+          dismissible: true,
+          dismissLabel: intl.formatMessage({ id: "common.close" }),
+        });
+      }
+    } catch (error) {
+      if (version !== testGeneration.current) return;
+      const result = modelConnectivityFailure(error);
+      showFeedback({
+        key: dedupeKey,
+        state: "failure",
+        message: intl.formatMessage(
+          { id: "settings.modelProvider.testModel.failedWithIdentity" },
+          {
+            provider: providerName,
+            model: modelId,
+            reason: result.success
+              ? intl.formatMessage({ id: "settings.modelProvider.testFailure.unknown" })
+              : modelConnectivityErrorMessage(result.error, intl),
+          },
+        ),
+        durationMs: 0,
+        dismissible: true,
+        dismissLabel: intl.formatMessage({ id: "common.close" }),
+      });
+    } finally {
+      if (version === testGeneration.current) {
+        testingRef.current = false;
+        setIsTesting(false);
+      }
+    }
+  }, [onTest, modelId, intl, providerId, providerName, providerEnabled, showFeedback]);
+
+  return { isTesting, handleTest };
+}
