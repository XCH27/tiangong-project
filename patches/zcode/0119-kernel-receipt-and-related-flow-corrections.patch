@@ -0,0 +1,134 @@
+import type { DecisionModelSettings } from "@zcode/shared";
+import type { ModelSelectionView } from "@zcode/services";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { Switch } from "@/components/ui/switch.js";
+import { selectTriggerVariants } from "@/components/ui/select.js";
+import { SettingsRow, SettingsGroupCard } from "@/settings/SettingsPageParts.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { encodeCustomModelValue } from "@/lib/zcodeCustomModelValue.js";
+
+/** Separate operation family; all writes still go through the parent Personal writer. */
+export function DecisionModelDefaults({
+  view,
+  pending,
+  onChange,
+}: {
+  view: ModelSelectionView | null;
+  pending: boolean;
+  onChange(settings: DecisionModelSettings): void | Promise<void>;
+}) {
+  const { intl } = useZCodeIntl();
+  const decision = view?.decisionModelSettings ?? { enabled: false };
+  const classifiers = view?.classifierModels ?? [];
+  const decisionAvailable = classifiers.some(
+    (model) =>
+      model.providerId === decision.selection?.providerId &&
+      model.modelId === decision.selection?.modelId,
+  );
+  const decisionGroups = [...new Set(classifiers.map((model) => model.providerId))].map(
+    (providerId) => ({
+      key: providerId,
+      label: classifiers.find((model) => model.providerId === providerId)!.providerName,
+      directItems: true,
+      items: classifiers
+        .filter((model) => model.providerId === providerId)
+        .map((model) => ({
+          key: model.modelId,
+          name: model.modelId,
+          value: encodeCustomModelValue(providerId, model.modelId),
+        })),
+    }),
+  );
+  const saveDecision = onChange;
+  return (
+    <div data-decision-model-settings>
+      <SettingsGroupCard>
+        <SettingsRow
+          label={intl.formatMessage({ id: "settings.modelDefaults.decision" })}
+          control={
+            <Switch
+              aria-label={intl.formatMessage({ id: "settings.modelDefaults.decision" })}
+              checked={decision.enabled}
+              disabled={
+                pending || !view?.preferencesRevision || (!decision.enabled && !decisionAvailable)
+              }
+              onCheckedChange={(enabled) => void saveDecision({ ...decision, enabled })}
+            />
+          }
+        />
+        <SettingsRow
+          label={intl.formatMessage({ id: "settings.modelDefaults.decision.model" })}
+          control={
+            <ModelConfigSelect
+              modelGroups={decisionGroups}
+              normalizedValue={
+                decision.selection
+                  ? encodeCustomModelValue(
+                      decision.selection.providerId,
+                      decision.selection.modelId,
+                    )
+                  : "none"
+              }
+              triggerLabel={
+                decision.selection?.modelId ??
+                intl.formatMessage({
+                  id: classifiers.length
+                    ? "settings.modelDefaults.decision.choose"
+                    : "settings.modelDefaults.decision.addFirst",
+                })
+              }
+              tooltipTitle={intl.formatMessage({ id: "settings.modelDefaults.decision.model" })}
+              leadingItems={[
+                {
+                  key: "none",
+                  value: "none",
+                  name: intl.formatMessage({ id: "settings.modelDefaults.decision.none" }),
+                },
+              ]}
+              showManageModelsAction={false}
+              focusSelectorOnClose={null}
+              footerActions={[]}
+              labelVisibilityClassName="inline-flex"
+              disabled={pending || !view?.preferencesRevision}
+              lockReasonMessage=""
+              isItemLocked={() => false}
+              triggerIcon={<></>}
+              triggerClassName={selectTriggerVariants({
+                size: "lg",
+                className: "min-w-0 w-64 max-w-full",
+              })}
+              triggerBadge={
+                decision.selection && !decisionAvailable ? (
+                  <span className="text-ui-sm text-warning">
+                    {intl.formatMessage({ id: "settings.modelDefaults.unavailableBadge" })}
+                  </span>
+                ) : undefined
+              }
+              onValueChange={(value) => {
+                const selection =
+                  value === "none"
+                    ? undefined
+                    : classifiers.find(
+                        (model) =>
