diff --git a/apps/zcode-cli/packages/adapters/test/media-artifact-publication.test.ts b/apps/zcode-cli/packages/adapters/test/media-artifact-publication.test.ts
new file mode 100644
index 0000000..f659eab
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/media-artifact-publication.test.ts
@@ -0,0 +1,154 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import fs, { mkdtemp, readdir, readFile, mkdir, writeFile, rm } from "node:fs/promises";
+import { createHash } from "node:crypto";
+import { syncBuiltinESMExports } from "node:module";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { NodeToolArtifactStore } from "../src/storage/index.js";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-receipt-publication-"));
+  const paths = {
+    rootDir: join(root, "artifacts"),
+    imageCacheRootDir: join(root, "images"),
+    videoCacheRootDir: join(root, "videos"),
+  };
+  const request = {
+    sessionId: "session" as never,
+    toolCallId: "request",
+    toolName: "MediaJobReceipt",
+    idempotencyKey: "media-image:operation:intent",
+    content: JSON.stringify({ status: "unknown", jobId: "operation" }),
+    contentType: "application/json",
+  };
+  const id = `tool-result-media-${createHash("sha256")
+    .update(JSON.stringify([request.sessionId, request.idempotencyKey]))
+    .digest("hex")}`;
+  return {
+    root,
+    paths,
+    request,
+    final: join(paths.rootDir, "session", `${id}.json`),
+    close: () => rm(root, { recursive: true, force: true }),
+  };
+}
+
+test("a failed publication never exposes a partial receipt and reopens without a poisoned intent", async (t) => {
+  const f = await fixture();
+  const originalLink = fs.link;
+  let injected = false;
+  const replacement = t.mock.method(fs, "link", async (source: any, destination: any) => {
+    if (destination === f.final) {
+      injected = true;
+      assert.deepEqual(JSON.parse(await readFile(source, "utf8")), JSON.parse(f.request.content));
+      throw Object.assign(new Error("publication failed"), { code: "EIO" });
+    }
+    return originalLink(source, destination);
+  });
+  syncBuiltinESMExports();
+  try {
+    await assert.rejects(
+      new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(f.request),
+      /publication failed/,
+    );
+    assert.equal(injected, true);
+    await assert.rejects(readFile(f.final), { code: "ENOENT" });
+    assert.deepEqual(await readdir(join(f.paths.rootDir, "session", ".staging")), []);
+    replacement.mock.restore();
+    syncBuiltinESMExports();
+    const saved = await new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(f.request);
+    assert.equal(saved.created, true);
+    assert.equal(await readFile(f.final, "utf8"), f.request.content);
+  } finally {
+    replacement.mock.restore();
+    syncBuiltinESMExports();
+    await f.close();
+  }
+});
+
+test("legacy partial intent is rejected without overwriting or treating it as a new submission", async () => {
+  const f = await fixture();
+  try {
+    await mkdir(join(f.paths.rootDir, "session"), { recursive: true });
+    await writeFile(f.final, '{"status":');
+    for (let attempt = 0; attempt < 2; attempt++) {
+      await assert.rejects(
+        new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(f.request),
+        /incomplete or invalid.*preserved/,
+      );
+      assert.equal(await readFile(f.final, "utf8"), '{"status":');
+    }
+  } finally {
+    await f.close();
+  }
+});
+
+test("an interrupted staging write cannot poison the final intent and a reopened writer can publish", async (t) => {
+  const f = await fixture();
+  const originalOpen = fs.open;
+  let interrupted = false;
+  const replacement = t.mock.method(fs, "open", async (...args: Parameters<typeof fs.open>) => {
+    const handle = await originalOpen(...args);
+    if (String(args[0]).includes(`${join("session", ".staging")}`)) {
+      return new Proxy(handle, {
+        get(target, name) {
+          if (name === "writeFile")
+            return async (content: Buffer) => {
+              interrupted = true;
+              await target.write(content.subarray(0, 5));
+              throw Object.assign(new Error("interrupted write"), { code: "EIO" });
+            };
+          const value = target[name as keyof typeof target];
+          return typeof value === "function" ? value.bind(target) : value;
+        },
+      });
+    }
+    return handle;
+  });
+  syncBuiltinESMExports();
+  try {
+    await assert.rejects(
+      new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(f.request),
+      /interrupted write/,
+    );
+    assert.equal(interrupted, true);
+    await assert.rejects(readFile(f.final), { code: "ENOENT" });
+    assert.deepEqual(await readdir(join(f.paths.rootDir, "session", ".staging")), []);
+    replacement.mock.restore();
+    syncBuiltinESMExports();
+    assert.equal(
+      (await new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(f.request)).created,
+      true,
+    );
+    assert.equal(await readFile(f.final, "utf8"), f.request.content);
+  } finally {
+    replacement.mock.restore();
+    syncBuiltinESMExports();
+    await f.close();
+  }
+});
+
+test("concurrent publishers retain one complete original immutable receipt", async () => {
+  const f = await fixture();
+  try {
+    const writes = await Promise.all(
+      Array.from({ length: 12 }, (_, index) =>
+        new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce({
+          ...f.request,
+          content: JSON.stringify({ status: "unknown", index }),
+        }),
+      ),
+    );
+    assert.equal(writes.filter((value) => value.created).length, 1);
+    const first = await readFile(f.final, "utf8");
+    assert.ok(Number.isInteger(JSON.parse(first).index));
+    const duplicate = await new NodeToolArtifactStore(f.paths).writeToolResultArtifactOnce(
+      f.request,
+    );
+    assert.equal(duplicate.created, false);
+    assert.equal(await readFile(f.final, "utf8"), first);
+  } finally {
+    await f.close();
+  }
+});
