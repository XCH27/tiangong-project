diff --git a/apps/zcode-cli/packages/core/src/runtime/methods/usage-recovery.ts b/apps/zcode-cli/packages/core/src/runtime/methods/usage-recovery.ts
new file mode 100644
index 0000000..1bc7620
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/methods/usage-recovery.ts
@@ -0,0 +1,72 @@
+import type { ModelUsageRecord } from "@zcode/contracts";
+import { traceContextToLogContext } from "../deps.js";
+import type { AgentRuntimeInternal } from "../internal.js";
+
+const PENDING_MODEL_USAGE = "runtime/pending_model_usage";
+const entryId = (record: ModelUsageRecord) =>
+  `${record.sessionID}:pending-model-usage:${record.id}`;
+
+/** A failed write's recovery instruction in the existing Session journal, not another ledger. */
+export async function retainPendingModelUsage(
+  runtime: AgentRuntimeInternal,
+  record: ModelUsageRecord,
+): Promise<void> {
+  if (!runtime.sessionStore?.saveSessionEntry)
+    throw new Error("Model usage write failed and this Session cannot retain its receipt");
+  const now = Date.now();
+  await runtime.sessionStore.saveSessionEntry({
+    id: entryId(record),
+    sessionID: runtime.sessionId,
+    type: PENDING_MODEL_USAGE,
+    touchSession: false,
+    time: { created: now, updated: now },
+    data: { record },
+  });
+}
+
+/** Idempotent reconciliation uses the original receipt ID and already frozen request facts. */
+export async function recoverPendingModelUsage(runtime: AgentRuntimeInternal): Promise<void> {
+  const store = runtime.sessionStore;
+  const usageStore = store as Partial<import("@zcode/contracts").UsageStorePort> | undefined;
+  if (!store?.sessionEntries || !store.saveSessionEntry || !usageStore?.recordModelUsage) return;
+  const entries = await store.sessionEntries({
+    sessionID: runtime.sessionId,
+    type: PENDING_MODEL_USAGE,
+  });
+  for (const entry of entries) {
+    const record = (entry.data as { record?: ModelUsageRecord } | null)?.record;
+    if (!record) continue; // A consumed recovery instruction retains no duplicate usage payload.
+    if (
+      record.sessionID !== runtime.sessionId ||
+      typeof record.id !== "string" ||
+      entry.id !== entryId(record) ||
+      typeof record.logicalRequestId !== "string" ||
+      typeof record.providerId !== "string" ||
+      typeof record.modelId !== "string" ||
+      typeof record.querySource !== "string" ||
+      !Number.isFinite(record.startedAt) ||
+      !["completed", "error", "cancelled"].includes(record.status)
+    )
+      throw new Error("Invalid pending model usage receipt in this Session");
+    try {
+      await usageStore.recordModelUsage(record);
+      await store.saveSessionEntry({
+        ...entry,
+        touchSession: false,
+        time: { ...entry.time, updated: Date.now() },
+        data: { record: null },
+      });
+    } catch (error) {
+      // Keep the durable instruction. A write or its acknowledgement may have failed;
+      // the original ledger's receipt ID makes another reconciliation safe.
+      runtime.logger?.warn("Pending model usage receipt remains unreconciled", {
+        ...traceContextToLogContext(runtime.rootTraceContext),
+        errorMessage: error instanceof Error ? error.message : String(error),
+        event: "usage.model.recovery.failed",
+        module: "core.runtime",
+        receiptId: record.id,
+        status: "failed",
+      });
+    }
+  }
+}
