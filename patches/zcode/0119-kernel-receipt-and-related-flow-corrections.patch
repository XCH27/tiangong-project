diff --git a/packages/services/test/provider-purpose-provisioning.test.ts b/packages/services/test/provider-purpose-provisioning.test.ts
new file mode 100644
index 0000000..09a2bc3
--- /dev/null
+++ b/packages/services/test/provider-purpose-provisioning.test.ts
@@ -0,0 +1,132 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { MutableAccountProviderConfigSource } from "@zcode/provider";
+import {
+  NodePersonalProviderConfigRepository,
+  NodeProviderRegistryRuntime,
+} from "@zcode/provider-node";
+import { createProviderProvisioningSource } from "../src/model-provider/providerProvisioningSource.js";
+import { createProviderProvisioningTarget } from "../src/model-provider/providerProvisioningTarget.js";
+
+test("purpose defaults and startup policy survive real Personal source/target synchronization and failed-apply rollback", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-purpose-provisioning-"));
+  const sourcePath = join(root, "source.json");
+  const targetPath = join(root, "target.json");
+  const sourceRepository = new NodePersonalProviderConfigRepository({
+    filePath: sourcePath,
+    pollingIntervalMs: false,
+  });
+  const targetRepository = new NodePersonalProviderConfigRepository({
+    filePath: targetPath,
+    pollingIntervalMs: false,
+  });
+  const model = (modelId: string) => ({
+    providerId: "existing",
+    modelId,
+    options: { reasoningLevel: "auto" },
+  });
+  const initial = {
+    defaultModelSelection: model("ordinary"),
+    pageAssistantDefaultModelSelection: model("helper"),
+    visionBridgeDefaultModelSelection: model("vision"),
+    newConversationModelPolicy: "recent" as const,
+    decisionModelSettings: {
+      enabled: true,
+      selection: { providerId: "decision", modelId: "typed" },
+    },
+  };
+  let settings = {};
+  const settingService = {
+    get: async () => settings,
+    update: async (patch: object) => {
+      settings = { ...settings, ...patch };
+    },
+  };
+  const credentials = new Map<string, string>();
+  let failRefresh = false;
+  const targetRuntime = new NodeProviderRegistryRuntime({
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalFilePath: targetPath,
+    personalPollingIntervalMs: false,
+    watch: false,
+    accountSource: new MutableAccountProviderConfigSource(),
+  });
+  const refresh = targetRuntime.registryService.refresh.bind(targetRuntime.registryService);
+  targetRuntime.registryService.refresh = async (...args) => {
+    if (failRefresh) {
+      failRefresh = false;
+      throw new Error("Synthetic target refresh failure");
+    }
+    return refresh(...args);
+  };
+  const source = createProviderProvisioningSource({
+    personalRepository: sourceRepository,
+    personalConfigFilePath: sourcePath,
+    credentialFilePath: join(root, "absent-credentials.json"),
+    settingService: settingService as never,
+  });
+  const target = createProviderProvisioningTarget({
+    personalRepository: targetRepository,
+    personalConfigFilePath: targetPath,
+    stateFilePath: join(root, "state.json"),
+    settingService: settingService as never,
+    credentialService: {
+      load: async (key: string) => credentials.get(key) ?? null,
+      save: async (key: string, value: string) => {
+        credentials.set(key, value);
+      },
+      delete: async (key: string) => {
+        credentials.delete(key);
+      },
+    } as never,
+    accountProviderSource: { refresh: async () => {} } as never,
+    providerRuntime: targetRuntime,
+  });
+  try {
+    await sourceRepository.update((current) => ({ ...current, ...initial }));
+    const envelope = await source.read("first");
+    assert.deepEqual(
+      envelope.personalConfig.pageAssistantDefaultModelSelection,
+      initial.pageAssistantDefaultModelSelection,
+    );
+    assert.equal((await target.apply(envelope)).status, "applied");
+    const assertDefaults = async () => {
+      const saved = await targetRepository.read();
+      for (const key of Object.keys(initial) as Array<keyof typeof initial>)
+        assert.deepEqual(saved[key], initial[key]);
+    };
+    await assertDefaults();
+    const reopened = new NodePersonalProviderConfigRepository({
+      filePath: targetPath,
+      pollingIntervalMs: false,
+    });
+    try {
+      assert.equal((await reopened.read()).newConversationModelPolicy, "recent");
+    } finally {
+      reopened.dispose();
+    }
+    await sourceRepository.update((current) => ({
+      ...current,
+      newConversationModelPolicy: "automatic",
+      pageAssistantDefaultModelSelection: model("new-helper"),
+      decisionModelSettings: { enabled: false },
+    }));
+    failRefresh = true;
+    const failed = await target.apply(await source.read("second"));
+    assert.equal(failed.status, "failed");
+    assert.equal(failed.rolledBack, true);
+    await assertDefaults();
+    assert.equal(credentials.size, 0, "Default synchronization created credentials");
+  } finally {
+    targetRuntime.dispose();
+    sourceRepository.dispose();
+    targetRepository.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
