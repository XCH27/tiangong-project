+/** Sync complete bytes before exposing the immutable name. Existing files are never overwritten. */
+async function publishImmutableArtifact(
+  path: string,
+  content: Buffer,
+  sessionDir: string,
+  validateExisting: (content: Buffer) => void,
+): Promise<boolean> {
+  const stagingDir = join(sessionDir, ".staging");
+  await mkdir(stagingDir, { recursive: true });
+  const stagingPath = join(stagingDir, randomUUID());
+  const file = await open(stagingPath, "wx", 0o600);
+  let created = true;
+  try {
+    try {
+      await file.writeFile(content);
+      await file.sync();
+    } finally {
+      await file.close();
+    }
+    try {
+      await link(stagingPath, path);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+      validateExisting(await readFile(path));
+      created = false;
+    }
+    if (process.platform !== "win32") {
+      const directory = await open(sessionDir, "r");
+      try {
+        await directory.sync();
+      } finally {
+        await directory.close();
+      }
+    }
+    return created;
+  } finally {
+    await unlink(stagingPath).catch(() => undefined);
+  }
+}
