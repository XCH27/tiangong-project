diff --git a/packages/ui/test/ccSwitchDefaults.browser.tsx b/packages/ui/test/ccSwitchDefaults.browser.tsx
new file mode 100644
index 0000000..1002f42
--- /dev/null
+++ b/packages/ui/test/ccSwitchDefaults.browser.tsx
@@ -0,0 +1,104 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { CcSwitchImportSection } from "../src/settings/model-provider-section/CcSwitchImportSection.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+
+async function run() {
+  const results: Array<{ name: string; error?: string }> = [];
+  for (const locale of ["zh-CN", "en-US"] as const) {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = createRoot(container);
+    const imports: Array<{ ids: string[] }> = [];
+    const row = (id: string, eligible = true, extra = {}) => ({
+      id,
+      name: id,
+      eligible,
+      appType: "claude",
+      modelIds: [id],
+      baseUrl: "https://fixture.invalid/v1",
+      ...extra,
+    });
+    const rows = [
+      row("available"),
+      row("alias", true, { duplicateOf: "available", appType: "codex" }),
+      row("optional"),
+      row("bound", false, { reason: "already-imported", existingProviderName: "Saved connection" }),
+      row("subscription", false, { reason: "oauth-account-not-supported" }),
+    ];
+    try {
+      await act(async () => {
+        root.render(
+          <ServiceProvider
+            services={
+              {
+                providerSettingsService: {
+                  async previewCcSwitchImport() {
+                    return { path: "fixture.db", revision: "fixture", rows };
+                  },
+                  async importCcSwitchProviders(input: { ids: string[] }) {
+                    imports.push(input);
+                    return { results: input.ids.map((id) => ({ id, providerId: "saved" })) };
+                  },
+                },
+              } as never
+            }
+          >
+            <PlatformProvider platform={{ canSelectFilePath: false } as never}>
+              <ZCodeIntlProvider initialLocale={locale}>
+                <CcSwitchImportSection onBack={() => {}} onComplete={() => {}} />
+              </ZCodeIntlProvider>
+            </PlatformProvider>
+          </ServiceProvider>,
+        );
+      });
+      const boxes = [...container.querySelectorAll<HTMLButtonElement>('[role="checkbox"]')];
+      check(
+        boxes.filter((box) => box.dataset.state === "checked").length === 2,
+        "importable groups were not selected automatically",
+      );
+      check(
+        boxes.filter((box) => box.disabled).every((box) => box.dataset.state === "unchecked"),
+        "bound/unsupported rows were selected",
+      );
+      const optional = boxes.find((box) => box.getAttribute("aria-label") === "optional")!;
+      await act(async () => {
+        optional.click();
+      });
+      const submit = [...container.querySelectorAll<HTMLButtonElement>("button")].find((button) =>
+        /导入|Import/.test(button.textContent ?? ""),
+      )!;
+      check(!submit.disabled, "ready import still required manual selection");
+      await act(async () => {
+        submit.click();
+      });
+      check(
+        JSON.stringify(imports[0]?.ids) === JSON.stringify(["available", "alias"]),
+        "default import lost the model-union group or ignored an opt-out",
+      );
+      results.push({
+        name: `${locale}: automatically selects importable groups, excludes bound/unsupported rows and respects deselection`,
+      });
+    } catch (error) {
+      results.push({
+        name: `${locale}: CC Switch defaults`,
+        error: error instanceof Error ? error.stack : String(error),
+      });
+    } finally {
+      await act(async () => {
+        root.unmount();
+      });
+      container.remove();
+    }
+  }
+  return results;
+}
+(window as unknown as { __ccSwitchDefaultTests: ReturnType<typeof run> }).__ccSwitchDefaultTests =
+  run();
