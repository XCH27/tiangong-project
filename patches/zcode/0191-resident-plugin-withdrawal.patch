@@ -0,0 +1,35 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+
+// 只传播当前调用的 Host 检查，不保存授权或插件状态、不进入协议消息。
+const dispatchAvailability = new AsyncLocalStorage<() => void>();
+export function withMcpDispatchAvailability<T>(check: (() => void) | undefined, run: () => T): T {
+  return check ? dispatchAvailability.run(check, run) : run();
+}
+export function assertMcpDispatchAvailable(): void {
+  dispatchAvailability.getStore()?.();
+}
+export function withMcpDispatchFetch(fetch: typeof globalThis.fetch): typeof globalThis.fetch {
+  return (resource, options) => {
+    let body: unknown;
+    if (typeof options?.body === "string") {
+      try {
+        body = JSON.parse(options.body);
+      } catch {
+        /* SDK owns malformed payload errors. */
+      }
+    }
+    const messages = Array.isArray(body) ? body : [body];
+    if (
+      messages.some(
+        (message) =>
+          message &&
+          typeof message === "object" &&
+          "method" in message &&
+          (message.method === "tools/call" || message.method === "resources/read"),
+      )
+    ) {
+      assertMcpDispatchAvailable();
+    }
+    return fetch(resource, options);
+  };
+}
