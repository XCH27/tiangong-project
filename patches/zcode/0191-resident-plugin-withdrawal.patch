+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import test from "node:test";
+import { createMcpAdapter } from "@zcode/adapters/mcp";
+import { createNodeSkillAdapter } from "@zcode/adapters/skills";
+import { addMarketplace } from "@zcode/adapters/plugins";
+import { createRootTraceContext } from "@zcode/contracts";
+import { projectDeferredTools } from "../../core/src/runtime/methods/deferred-tools.js";
+import { fixture, reply } from "../../core/test/helpers/pi-runtime-fixture.js";
+import { createPluginAvailability } from "../src/app/plugin-availability.js";
+import {
+  withResidentPluginMcp,
+  withResidentPluginSkills,
+} from "../src/app/resident-plugin-ports.js";
+import {
+  grantZCodePlugin,
+  installZCodeMarketplacePlugin,
+  resolveZCodePlugins,
+  revokeZCodePluginGrant,
+  setZCodePluginEnabled,
+  uninstallZCodeMarketplacePlugin,
+} from "../src/plugins.js";
+
+test(
+  "resident Session withdraws MCP/Skill descriptions and queued calls through existing writers",
+  { timeout: 60000 },
+  async () => {
+    const root = await mkdtemp(join(tmpdir(), "fleet-resident-plugins-"));
+    const previous = Object.fromEntries(
+      ["ZCODE_HOME", "ZCODE_STORAGE_DIR"].map((key) => [key, process.env[key]]),
+    );
+    const transport = createMcpAdapter({ env: {} });
+    let f: Awaited<ReturnType<typeof fixture>> | undefined;
+    try {
+      process.env.ZCODE_HOME = join(root, "home");
+      process.env.ZCODE_STORAGE_DIR = join(root, "storage");
+      const workspace = join(root, "workspace");
+      const market = join(root, "market");
+      const plugin = join(market, "plugins", "counter");
+      const userConfigPath = join(root, "home", "config.json");
+      const pluginStorageRoot = join(root, "storage", "cli", "plugins");
+      for (const dir of [
+        workspace,
+        join(root, "home"),
+        join(market, ".claude-plugin"),
+        join(plugin, ".claude-plugin"),
+        join(plugin, "skills", "notes"),
+      ])
+        await mkdir(dir, { recursive: true });
+      await writeFile(userConfigPath, JSON.stringify({ storage: { dir: join(root, "storage") } }));
+      await writeFile(
+        join(market, ".claude-plugin", "marketplace.json"),
+        JSON.stringify({
+          name: "local-fixture",
+          plugins: [{ name: "counter", source: "./plugins/counter" }],
+        }),
+      );
+      await writeFile(
+        join(plugin, ".claude-plugin", "plugin.json"),
+        JSON.stringify({
+          name: "counter",
+          version: "1.0.0",
+          mcpServers: {
+            counter: {
+              command: process.execPath,
+              args: [resolve(import.meta.dirname, "fixtures/plugin-view/server.mjs")],
+            },
+          },
+        }),
+      );
+      await writeFile(
+        join(plugin, "skills", "notes", "SKILL.md"),
+        "---\nname: notes\ndescription: Resident notes fixture\n---\nRESIDENT_SKILL_BODY",
+      );
+      const paths = {
+        env: {
+          ZCODE_HOME: process.env.ZCODE_HOME!,
+          ZCODE_STORAGE_DIR: process.env.ZCODE_STORAGE_DIR!,
+        },
+        officialPluginRoots: [],
+        userConfigPath,
+        pluginStorageRoot,
+        workingDirectory: workspace,
+      };
+      resolveZCodePlugins(paths);
+      await addMarketplace({
+        source: { source: "directory", path: market },
+        storageRoot: pluginStorageRoot,
+      });
+      await installZCodeMarketplacePlugin({
+        ...paths,
+        marketplace: "local-fixture",
+        pluginName: "counter",
+      });
+      const id = "counter@local-fixture";
+      await setZCodePluginEnabled({ ...paths, plugin: id, enabled: true });
+      grantZCodePlugin({
+        ...paths,
+        plugin: id,
+        fingerprint: resolveZCodePlugins(paths).plugins.find((entry) => entry.id === id)!.grant!
+          .fingerprint,
+      });
+      const startup = resolveZCodePlugins(paths);
+      const availability = createPluginAvailability({
+        discover: () => resolveZCodePlugins(paths),
+        initialOutcome: startup,
+        pluginStorageRoot,
+        watchedConfigPaths: [userConfigPath, join(workspace, ".zcode", "config.json")],
+      });
+      const mcp = withResidentPluginMcp(transport, startup, availability, workspace);
+      const skills = withResidentPluginSkills(
+        createNodeSkillAdapter({
+          homeDirectory: join(root, "empty-home"),
+          extraResolvedRoots: startup.skillRoots,
+        }),
+        availability,
+        workspace,
+      );
+      f = await fixture("pi", false, {
+        config: {
+          workingDirectory: workspace,
+          toolAllowlist: ["Skill", "SearchTools", "mcp__plugin_counter_counter__increment"],
+          mcp: { servers: startup.mcpServers },
+        },
+        deps: { mcpPort: mcp, skillPort: skills },
+      });
+      const runtime = f.runtime;
+      const isolatedSkills = await skills.discoverSkills({ workingDirectory: workspace });
+      assert.ok(
+        isolatedSkills.skills.every((entry) => entry.path.startsWith(root)),
+        JSON.stringify(isolatedSkills.skills.map((entry) => entry.path)),
+      );
+      const tool = "mcp__plugin_counter_counter__increment";
+      const invoke = async (name: string, input: object = {}) => {
+        f!.steps.push(
+          () => reply("", [{ id: `call-${f!.requests.length}`, name, input }]),
+          () => reply("done"),
+        );
+        await runtime.executeTurn("Use fixture");
+        return (await f!.store.messages({ sessionID: runtime.sessionId }))
+          .flatMap((message) => message.parts)
+          .filter((part) => part.type === "tool")
+          .at(-1) as any;
+      };
+      assert.equal((await invoke(tool)).state.status, "completed");
+      assert.equal((await invoke("Skill", { skill: "counter:notes" })).state.status, "completed");
+      assert.match(JSON.stringify(f.requests.at(-1)?.messages), /RESIDENT_SKILL_BODY/);
+      assert.ok(
+        (
+          await runtime.getSkillCatalog(createRootTraceContext({ sessionId: runtime.sessionId }))
+        ).skills.some((entry) => entry.qualifiedName === "counter:notes"),
+      );
+
+      runtime.getToolRegistry().getMetadata(tool)!.description = "resident fixture ".repeat(800);
+      runtime.invalidateToolCache();
+      const discovery: any = {};
+      projectDeferredTools(runtime as any, discovery, runtime.getTools(), false);
+      assert.ok(
+        discovery
+          .searchAvailableTools("resident", 5)
+          .tools.some((entry: any) => entry.name === tool),
+      );
+      await setZCodePluginEnabled({ ...paths, plugin: id, enabled: false });
+      assert.deepEqual(
+        discovery.searchAvailableTools("resident", 5).tools,
+        [],
+        "a queued search cannot republish withdrawn descriptions",
+      );
+      assert.ok(
+        !runtime.getTools().some((entry) => entry.name === tool),
+        "cached Host tools withdraw immediately",
+      );
+      assert.ok(
+        !(
+          await runtime.getSkillCatalog(createRootTraceContext({ sessionId: runtime.sessionId }))
+        ).skills.some((entry) => entry.pluginId === id),
+      );
+      assert.equal((await invoke(tool)).state.status, "error", "a stale model tool call fails");
+      assert.equal((await invoke("Skill", { skill: "counter:notes" })).state.status, "error");
+      assert.ok(
+        !JSON.stringify(f.requests.at(-1)?.messages).includes("Resident notes fixture"),
+        "next request withdraws Skill catalog metadata",
+      );
+      assert.match(
+        JSON.stringify(f.requests.at(-1)?.messages),
+        /RESIDENT_SKILL_BODY/,
+        "loaded Skill history remains",
+      );
+      const counterData = startup.plugins.find((entry) => entry.id === id)!.dataPath!;
+      assert.equal(JSON.parse(await readFile(join(counterData, "counter.json"), "utf8")).value, 1);
+      runtime.getToolRegistry().getMetadata(tool)!.description = "Add one";
+      runtime.invalidateToolCache();
+      await setZCodePluginEnabled({ ...paths, plugin: id, enabled: true });
+      assert.ok(runtime.getTools().some((entry) => entry.name === tool));
+
+      const entered = Promise.withResolvers<void>();
+      const release = Promise.withResolvers<void>();
+      f.permissionWith(async () => {
+        entered.resolve();
+        await release.promise;
+        return { decision: "allow" };
+      });
+      const pending = invoke(tool);
+      await entered.promise;
+      revokeZCodePluginGrant({ ...paths, plugin: id });
+      release.resolve();
+      assert.equal(
+        (await pending).state.status,
+        "error",
+        "permission-waiting call cannot use revoked grant",
+      );
+      f.permissionWith(async () => ({ decision: "allow" }));
+      assert.ok(!runtime.getTools().some((entry) => entry.name === tool));
+      assert.equal(
+        (await invoke("Skill", { skill: "counter:notes" })).state.status,
+        "completed",
+        "grant does not govern Skill instructions",
+      );
+      grantZCodePlugin({
+        ...paths,
+        plugin: id,
+        fingerprint: resolveZCodePlugins(paths).plugins.find((entry) => entry.id === id)!.grant!
+          .fingerprint,
+      });
+      assert.equal((await invoke(tool)).state.status, "completed");
+      await f.reopen();
+      f.steps.push(() => reply("cold"));
+      await f.runtime.executeTurn("Cold reopen");
+      assert.ok(f.runtime.getTools().some((entry) => entry.name === tool));
+      assert.match(
+        JSON.stringify(await f.store.messages({ sessionID: f.runtime.sessionId })),
+        /RESIDENT_SKILL_BODY/,
+      );
+      await uninstallZCodeMarketplacePlugin({ ...paths, pluginId: id, keepData: true });
+      assert.ok(!f.runtime.getTools().some((entry) => entry.name === tool));
+      assert.ok(
+        !(
+          await f.runtime.getSkillCatalog(
+            createRootTraceContext({ sessionId: f.runtime.sessionId }),
+          )
+        ).skills.some((entry) => entry.pluginId === id),
+      );
+      await assert.rejects(
+        async () => mcp.callTool({ serverName: "plugin:counter:counter", toolName: "increment" }),
+        /unavailable|withdrawn/,
+      );
+      assert.equal(
+        JSON.parse(await readFile(join(counterData, "counter.json"), "utf8")).value,
+        2,
+        "data and executed effects survive uninstall",
+      );
+      await f.reopen();
+      f.steps.push(() => reply("cold after uninstall"));
+      await f.runtime.executeTurn("Reopen removed plugin");
+      assert.ok(!f.runtime.getTools().some((entry) => entry.name === tool));
+      assert.match(
+        JSON.stringify(await f.store.messages({ sessionID: f.runtime.sessionId })),
+        /RESIDENT_SKILL_BODY/,
+      );
+    } finally {
+      await transport.close();
+      await f?.close();
+      for (const [key, value] of Object.entries(previous)) {
+        if (value === undefined) delete process.env[key];
+        else process.env[key] = value;
+      }
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+);
+
+// Real stdio send waits for a synthetic Host identity provider. Withdrawal during that await
+// must refuse before the local server effect; withdrawal after send must retain its result.
+test(
+  "final stdio dispatch rechecks availability after async request metadata",
+  { timeout: 15000 },
+  async () => {
+    const root = await mkdtemp(join(tmpdir(), "fleet-resident-meta-"));
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    let blocked = false;
+    let available = true;
+    const port = createMcpAdapter({
+      officialMcpAuth: {
+        trustedOrigins: { isTrusted: async () => ({ trusted: true }) },
+        resolveZCodeApiOrigin: () => "https://fixture.invalid",
+        authHeadersPort: {
+          async resolveHeaders() {
+            if (blocked) {
+              entered.resolve();
+              await release.promise;
+            }
+            return { ok: true, headers: {} };
+          },
+        },
+      },
+    });
+    try {
+      await port.connectServer("fixture", {
+        type: "stdio",
+        command: process.execPath,
+        args: [resolve(import.meta.dirname, "fixtures/plugin-view/server.mjs")],
+        env: { ZCODE_PLUGIN_DATA: root },
+        auth: { type: "zcode_official", provider: "jwt_token" },
+        official: { pluginId: "fixture", mcpKey: "fixture", source: "plugin" },
+      });
+      blocked = true;
+      const pending = port.callTool(
+        { serverName: "fixture", toolName: "increment" },
+        {
+          assertAvailable: () => {
+            if (!available) throw new Error("withdrawn during metadata");
+          },
+        },
+      );
+      await entered.promise;
+      available = false;
+      release.resolve();
+      await assert.rejects(pending, /withdrawn during metadata/);
+      await assert.rejects(readFile(join(root, "counter.json")), { code: "ENOENT" });
+      blocked = false;
+      available = true;
+      const dispatched = port.callTool(
+        { serverName: "fixture", toolName: "increment", arguments: { delayMs: 100 } },
+        {
+          assertAvailable: () => {
+            if (!available) throw new Error("withdrawn");
+          },
+        },
+      );
+      // The server has written its effect but deliberately retains the response briefly.
+      for (let attempt = 0; attempt < 100; attempt++) {
+        if (
+          await readFile(join(root, "counter.json")).then(
+            () => true,
+            () => false,
+          )
+        )
+          break;
+        await new Promise((resolve) => setTimeout(resolve, 5));
+      }
+      assert.equal(JSON.parse(await readFile(join(root, "counter.json"), "utf8")).value, 1);
+      available = false;
+      const completed = await dispatched;
+      assert.deepEqual(completed.structuredContent, { value: 1 });
+      assert.equal(JSON.parse(await readFile(join(root, "counter.json"), "utf8")).value, 1);
+    } finally {
+      release.resolve();
+      await port.close();
+      await rm(root, { recursive: true, force: true });
+    }
+  },
+);
