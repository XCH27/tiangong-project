diff --git a/apps/zcode-cli/packages/bootstrap/src/app/resident-plugin-ports.ts b/apps/zcode-cli/packages/bootstrap/src/app/resident-plugin-ports.ts
new file mode 100644
index 0000000..0418c4e
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/resident-plugin-ports.ts
@@ -0,0 +1,104 @@
+import type { McpPort, PluginLoadOutcome, SkillPort } from "@zcode/contracts";
+import type { ResidentPluginAvailability } from "./plugin-availability.js";
+
+/** Read-only projections over the existing package owner; never activate a new contribution. */
+export function withResidentPluginMcp(
+  port: McpPort,
+  startup: PluginLoadOutcome,
+  availability: ResidentPluginAvailability,
+  _workingDirectory: string,
+): McpPort {
+  const owners = new Map(
+    startup.plugins.flatMap((plugin) =>
+      plugin.mcpServerNames.map((name) => [name, plugin.id] as const),
+    ),
+  );
+  const isServerAvailable = (name: string) => {
+    const owner = owners.get(name);
+    return (
+      (!owner || !availability.isMcpWithdrawn(owner, name)) &&
+      port.isServerAvailable?.(name) !== false
+    );
+  };
+  const assertAvailable = (name: string) => {
+    if (!isServerAvailable(name)) throw new Error(`Plugin MCP server is unavailable: ${name}`);
+  };
+  return {
+    isServerAvailable,
+    async connectConfiguredServers(servers, options) {
+      const filtered = Object.fromEntries(
+        Object.entries(servers).filter(([name]) => isServerAvailable(name)),
+      );
+      const snapshot = await port.connectConfiguredServers(filtered, options);
+      return {
+        ...snapshot,
+        tools: snapshot.tools.filter((tool) => isServerAvailable(tool.serverName)),
+      };
+    },
+    connectServer(name, config, options) {
+      assertAvailable(name);
+      return port.connectServer(name, config, options);
+    },
+    disconnectServer: (name) => port.disconnectServer(name),
+    ...(port.pingServer
+      ? {
+          pingServer: (name: string, options?: { timeoutMs?: number }) =>
+            port.pingServer!(name, options),
+        }
+      : {}),
+    status: () => port.status(),
+    async listTools() {
+      return (await port.listTools()).filter((tool) => isServerAvailable(tool.serverName));
+    },
+    callTool(request, options) {
+      const check = () => {
+        assertAvailable(request.serverName);
+        options?.assertAvailable?.();
+      };
+      check();
+      // 原因：旧描述和权限/重连等待不能冻结授权；adapter 在真正派发前重查同一 owner。
+      return port.callTool(request, { ...options, assertAvailable: check });
+    },
+    ...(port.readResource
+      ? {
+          readResource: (
+            name: string,
+            uri: string,
+            options?: Parameters<NonNullable<McpPort["readResource"]>>[2],
+          ) => {
+            const check = () => {
+              assertAvailable(name);
+              options?.assertAvailable?.();
+            };
+            check();
+            return port.readResource!(name, uri, { ...options, assertAvailable: check });
+          },
+        }
+      : {}),
+    close: () => port.close(),
+  };
+}
+
+export function withResidentPluginSkills(
+  port: SkillPort,
+  availability: ResidentPluginAvailability,
+  _workingDirectory: string,
+): SkillPort {
+  const isSkillAvailable: NonNullable<SkillPort["isSkillAvailable"]> = (skill) =>
+    (!skill.pluginId || !availability.isSkillWithdrawn(skill.pluginId)) &&
+    port.isSkillAvailable?.(skill) !== false;
+  return {
+    isSkillAvailable,
+    async discoverSkills(request, options) {
+      const outcome = await port.discoverSkills(request, options);
+      const skills = outcome.skills.filter(isSkillAvailable);
+      return { ...outcome, skills, totalDiscovered: skills.length };
+    },
+    async loadSkill(request, options) {
+      const loaded = await port.loadSkill(request, options);
+      if (!isSkillAvailable(loaded.metadata))
+        throw new Error(`Plugin Skill is unavailable: ${request.name}`);
+      return loaded;
+    },
+  };
+}
