+import { forwardRef, type ReactNode } from "react";
+import { Plus, Trash2 } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Input, type InputProps } from "@/components/ui/input.js";
+import { cn } from "@/components/lib/utils.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+// 从现有 API 密钥行提取；模型草稿和密钥草稿不能各自演化一套尺寸、图标和保存交互。
+export const ProviderDraftInput = forwardRef<HTMLInputElement, InputProps>(
+  function ProviderDraftInput({ className, ...props }, ref) {
+    return <Input {...props} ref={ref} size="lg" className={cn("h-9", className)} />;
+  },
+);
+
+export function ProviderDraftRow({
+  children,
+  actions,
+  removeLabel,
+  onRemove,
+  disabled,
+}: {
+  children: ReactNode;
+  actions?: ReactNode;
+  removeLabel: string;
+  onRemove: () => void;
+  disabled?: boolean;
+}) {
+  return (
+    <div className="flex items-center gap-2">
+      <div className="min-w-0 flex-1">{children}</div>
+      {actions}
+      <Button
+        type="button"
+        variant="ghost"
+        size="icon-sm"
+        disabled={disabled}
+        aria-label={removeLabel}
+        onClick={onRemove}
+      >
+        <Trash2 className="size-4" />
+      </Button>
+    </div>
+  );
+}
+
+export const ProviderDraftAdd = forwardRef<
+  HTMLButtonElement,
+  {
+    children: ReactNode;
+    disabled?: boolean;
+    onClick: () => void;
+    "data-testid"?: string;
+  }
+>(function ProviderDraftAdd({ children, ...props }, ref) {
+  return (
+    <Button {...props} type="button" variant="ghost" ref={ref}>
+      <Plus className="size-4" />
+      {children}
+    </Button>
+  );
+});
+
+export function ProviderDraftActions({
+  message,
+  saving,
+  disabled,
+  onCancel,
+  onSave,
+}: {
+  message: string;
+  saving?: boolean;
+  disabled?: boolean;
+  onCancel: () => void;
+  onSave: () => void;
+}) {
+  const { intl } = useZCodeIntl();
+  return (
+    <div className="flex flex-wrap items-center justify-between gap-2">
+      <p className="text-ui-sm text-foreground-subtle">{message}</p>
+      <div className="flex items-center gap-2">
+        <Button type="button" variant="ghost" disabled={saving} onClick={onCancel}>
+          {intl.formatMessage({ id: "common.cancel" })}
+        </Button>
+        <Button type="button" disabled={disabled || saving} onClick={onSave}>
+          {intl.formatMessage({ id: saving ? "common.saving" : "common.save" })}
+        </Button>
+      </div>
+    </div>
+  );
+}
