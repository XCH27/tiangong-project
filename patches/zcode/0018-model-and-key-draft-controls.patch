diff --git a/packages/ui/src/settings/model-provider-section/ModelDraftRows.tsx b/packages/ui/src/settings/model-provider-section/ModelDraftRows.tsx
new file mode 100644
index 0000000..9769c8e
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ModelDraftRows.tsx
@@ -0,0 +1,175 @@
+import { useEffect, useRef, useState } from "react";
+import { TID_MODEL_PROVIDER_ADD_MODEL_BUTTON } from "@zcode/shared";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { TECHNICAL_INPUT_ATTRIBUTES } from "@/lib/technicalInputAttributes.js";
+import { isImeComposingKeyEvent } from "@/lib/imeComposition.js";
+import {
+  ProviderDraftActions,
+  ProviderDraftAdd,
+  ProviderDraftInput,
+  ProviderDraftRow,
+} from "./ProviderDraftControls.js";
+
+type DraftRow = { id: number; value: string };
+
+export function ModelDraftRows({
+  modelIds,
+  onAddModel,
+  onBegin,
+}: {
+  modelIds: readonly string[];
+  onAddModel: (modelId: string) => Promise<void>;
+  onBegin: () => void;
+}) {
+  const { intl } = useZCodeIntl();
+  const [rows, setRows] = useState<DraftRow[]>([]);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string>();
+  const [focusTarget, setFocusTarget] = useState<number | "add">();
+  const inputs = useRef(new Map<number, HTMLInputElement>());
+  const addButton = useRef<HTMLButtonElement>(null);
+  const nextId = useRef(0);
+  const savingRef = useRef(false);
+  const generation = useRef(0);
+  const compositionActive = useRef(false);
+  const names = rows.map((row) => row.value.trim());
+  const duplicate = (name: string) =>
+    !!name && (modelIds.includes(name) || names.filter((id) => id === name).length > 1);
+  const invalid = names.some(duplicate);
+
+  useEffect(
+    () => () => {
+      generation.current++;
+    },
+    [],
+  );
+  useEffect(() => {
+    if (focusTarget === "add") addButton.current?.focus();
+    else if (focusTarget !== undefined) inputs.current.get(focusTarget)?.focus();
+  }, [focusTarget, rows.length]);
+
+  const cancel = () => {
+    if (savingRef.current) return;
+    setRows([]);
+    setError(undefined);
+    setFocusTarget("add");
+  };
+  const save = async () => {
+    if (savingRef.current || invalid || !names.some(Boolean)) return;
+    savingRef.current = true;
+    setSaving(true);
+    setError(undefined);
+    const version = generation.current;
+    try {
+      // 沿用现有逐模型命令；已成功的行立即退出草稿，重试不能重复提交它们。
+      for (const row of rows) {
+        if (version !== generation.current) return;
+        if (!row.value.trim()) continue;
+        await onAddModel(row.value.trim());
+        if (version !== generation.current) return;
+        setRows((current) => current.filter((item) => item.id !== row.id));
+      }
+      setRows([]);
+      setFocusTarget("add");
+    } catch (reason) {
+      if (version === generation.current)
+        setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      if (version === generation.current) {
+        savingRef.current = false;
+        setSaving(false);
+      }
+    }
+  };
+
+  return (
+    <div className="space-y-2" data-no-model-drag="true">
+      {rows.map((row, index) => (
+        <ProviderDraftRow
+          key={row.id}
+          disabled={saving}
+          removeLabel={intl.formatMessage(
+            { id: "settings.modelProvider.discovery.removeDraft" },
+            { number: index + 1 },
+          )}
+          onRemove={() => {
+            if (savingRef.current) return;
+            setRows((current) => current.filter((item) => item.id !== row.id));
+            setError(undefined);
+            setFocusTarget(rows[index + 1]?.id ?? rows[index - 1]?.id ?? "add");
+          }}
+        >
+          <ProviderDraftInput
+            {...TECHNICAL_INPUT_ATTRIBUTES}
+            ref={(node) => {
+              if (node) inputs.current.set(row.id, node);
+              else inputs.current.delete(row.id);
+            }}
+            value={row.value}
+            disabled={saving}
+            placeholder={intl.formatMessage({ id: "settings.modelProvider.modelId" })}
+            aria-label={intl.formatMessage({ id: "settings.modelProvider.modelId" })}
+            aria-invalid={duplicate(row.value.trim())}
+            onChange={(event) => {
+              const value = event.target.value;
+              setRows((current) =>
+                current.map((item) => (item.id === row.id ? { ...item, value } : item)),
+              );
+              setError(undefined);
+            }}
+            onCompositionStart={() => {
+              compositionActive.current = true;
+            }}
+            onCompositionEnd={() => {
+              compositionActive.current = false;
+            }}
+            onKeyDown={(event) => {
+              if (
+                isImeComposingKeyEvent({
+                  compositionActive: compositionActive.current,
+                  nativeEvent: event.nativeEvent,
+                })
+              )
+                return;
+              // 与 API 密钥一致：Enter 结束输入，显式“保存”才写入，不能把勾号混作提交。
+              if (event.key === "Enter") {
+                event.preventDefault();
+                event.currentTarget.blur();
+              }
+            }}
+          />
+        </ProviderDraftRow>
+      ))}
+      <ProviderDraftAdd
+        ref={addButton}
+        disabled={saving}
+        data-testid={TID_MODEL_PROVIDER_ADD_MODEL_BUTTON}
+        onClick={() => {
+          if (savingRef.current) return;
+          const id = nextId.current++;
+          onBegin();
+          setRows((current) => [...current, { id, value: "" }]);
+          setFocusTarget(id);
+        }}
+      >
+        {intl.formatMessage({ id: "settings.modelProvider.addModel" })}
+      </ProviderDraftAdd>
+      {invalid || error ? (
+        <p role="alert" className="text-ui-sm text-destructive">
+          {error ?? intl.formatMessage({ id: "settings.modelProvider.discovery.alreadyAdded" })}
+        </p>
+      ) : null}
+      {names.some(Boolean) ? (
+        <ProviderDraftActions
+          message={intl.formatMessage({ id: "settings.modelProvider.discovery.unsaved" })}
+          saving={saving}
+          disabled={invalid}
+          onCancel={cancel}
+          onSave={() => {
+            void save();
+          }}
+        />
+      ) : null}
+    </div>
+  );
+}
