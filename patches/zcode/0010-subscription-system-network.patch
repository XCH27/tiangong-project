diff --git a/packages/services/test/subscription-network.test.ts b/packages/services/test/subscription-network.test.ts
new file mode 100644
index 0000000..2c7ed99
--- /dev/null
+++ b/packages/services/test/subscription-network.test.ts
@@ -0,0 +1,116 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { connect } from "node:net";
+import { once } from "node:events";
+import test from "node:test";
+import {
+  createHostApiNetworkTransport,
+  parseHostSystemProxy,
+} from "../src/providers/api/nodeApiNetwork.js";
+import { createSubscriptionSystemProxyBridge } from "../../desktop/src/host/subscriptionSystemProxyBridge.js";
+
+test("OS/PAC routing respects its first route and never silently falls through", () => {
+  assert.equal(parseHostSystemProxy("PROXY localhost:7890; DIRECT"), "http://localhost:7890/");
+  assert.equal(parseHostSystemProxy("HTTPS enterprise.example:443"), "https://enterprise.example/");
+  assert.equal(parseHostSystemProxy("DIRECT; PROXY localhost:7890"), undefined);
+  for (const invalid of ["SOCKS5 localhost:7890; DIRECT", "", "PROXY user:secret@localhost:7890"])
+    assert.throws(() => parseHostSystemProxy(invalid), /proxy/i);
+});
+
+test("the existing transport applies OS proxy to subscriptions only, honors edits and cleans up", async () => {
+  const target = createServer((_req, response) => response.end("OK"));
+  target.listen(0, "127.0.0.1");
+  await once(target, "listening");
+  const targetPort = (target.address() as { port: number }).port;
+  let tunnels = 0;
+  const proxy = createServer();
+  proxy.on("connect", (_req, client, head) => {
+    tunnels++;
+    const upstream = connect(targetPort, "127.0.0.1", () => {
+      client.write("HTTP/1.1 200 Connection Established\r\n\r\n");
+      if (head.length) upstream.write(head);
+      client.pipe(upstream).pipe(client);
+    });
+    client.on("error", () => upstream.destroy());
+    upstream.on("error", () => client.destroy());
+    client.on("close", () => upstream.destroy());
+  });
+  proxy.listen(0, "127.0.0.1");
+  await once(proxy, "listening");
+  const proxyUrl = `http://127.0.0.1:${(proxy.address() as { port: number }).port}`;
+  const url = `http://127.0.0.1:${targetPort}/oauth/token`;
+  let settings: { httpProxy?: string; noProxy?: string } = {};
+  let resolutions = 0;
+  const transport = createHostApiNetworkTransport(async () => settings, {
+    resolveSystemProxy: async () => {
+      resolutions++;
+      return proxyUrl;
+    },
+  });
+  try {
+    assert.equal(await (await transport.fetchWithSystemProxy!(url)).text(), "OK");
+    assert.equal(tunnels, 1);
+    assert.equal(resolutions, 1);
+    // API-key/ordinary Host traffic retains its explicit configuration policy.
+    assert.equal(await (await transport.fetch(url)).text(), "OK");
+    assert.equal(resolutions, 1);
+    settings = { noProxy: "127.0.0.1" };
+    assert.equal(await (await transport.fetchWithSystemProxy!(url)).text(), "OK");
+    assert.equal(resolutions, 1);
+    settings = { httpProxy: proxyUrl };
+    assert.equal(await (await transport.fetchWithSystemProxy!(url)).text(), "OK");
+    assert.equal(resolutions, 1);
+    settings = { httpProxy: "socks://localhost:7890" };
+    await assert.rejects(transport.fetchWithSystemProxy!(url), /invalid/);
+  } finally {
+    transport.dispose();
+    await transport.disposeAndWait();
+    target.closeAllConnections();
+    target.close();
+    proxy.close();
+  }
+  await assert.rejects(transport.fetchWithSystemProxy!(url), /disposed/);
+});
+
+test("OS resolution failures fail before fetch and the next request can recover", async () => {
+  let failure = true;
+  const transport = createHostApiNetworkTransport(async () => ({}), {
+    resolveSystemProxy: async () => {
+      if (failure) throw new Error("System proxy unavailable");
+      return undefined;
+    },
+  });
+  await assert.rejects(
+    transport.fetchWithSystemProxy!("https://never-fetch.invalid"),
+    /System proxy unavailable/,
+  );
+  failure = false;
+  assert.deepEqual(await transport.resolveSystemNetwork!("https://auth.openai.com"), {
+    httpProxy: undefined,
+    noProxy: "*",
+  });
+  await transport.disposeAndWait();
+});
+
+test("Main bridge correlates concurrent requests, rejects errors and ignores late replies", async () => {
+  const messages: any[] = [];
+  const bridge = createSubscriptionSystemProxyBridge((message) => messages.push(message));
+  const first = bridge.resolve("https://auth.openai.com");
+  const second = bridge.resolve("https://chatgpt.com/backend-api");
+  const rejected = assert.rejects(first, /unsupported/);
+  bridge.accept({ requestId: messages[1].requestId, ok: true, proxy: "http://localhost:7890" });
+  bridge.accept({ requestId: messages[0].requestId, ok: false, error: "unsupported" });
+  assert.equal(await second, "http://localhost:7890");
+  await rejected;
+  const third = bridge.resolve("https://api.github.com");
+  const disposed = assert.rejects(third, /disposed/);
+  bridge.dispose();
+  bridge.accept({ requestId: messages[2].requestId, ok: true });
+  await disposed;
+});
+
+test("a non-desktop Host does not override the remote Agent network policy", async () => {
+  const transport = createHostApiNetworkTransport(async () => ({}));
+  assert.equal(transport.resolveSystemNetwork, undefined);
+  await transport.disposeAndWait();
+});
