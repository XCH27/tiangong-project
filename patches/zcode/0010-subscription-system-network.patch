diff --git a/packages/desktop/src/main/subscriptionSystemProxy.ts b/packages/desktop/src/main/subscriptionSystemProxy.ts
new file mode 100644
index 0000000..02bea1c
--- /dev/null
+++ b/packages/desktop/src/main/subscriptionSystemProxy.ts
@@ -0,0 +1,14 @@
+import { parseHostSystemProxy } from "@zcode/services/node";
+import { session } from "electron";
+
+/** Use Chromium's OS/PAC resolver without changing the app or browser session. */
+export async function resolveSubscriptionSystemProxy(url: string): Promise<string | undefined> {
+  const target = new URL(url);
+  if (!["https:", "http:"].includes(target.protocol) || target.username || target.password)
+    throw new Error("Invalid subscription network target");
+  // OAuth 的浏览器与 Node Host 曾走不同出口；复用 Craft 的独立内存 session，
+  // 只解析网络路由，不把凭据、请求正文或 cookie 交给 Main。
+  const resolver = session.fromPartition("fleet-subscription-network");
+  await resolver.setProxy({ mode: "system" });
+  return parseHostSystemProxy(await resolver.resolveProxy(target.href));
+}
