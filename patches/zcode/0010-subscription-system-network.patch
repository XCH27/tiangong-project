diff --git a/packages/desktop/src/host/subscriptionSystemProxyBridge.ts b/packages/desktop/src/host/subscriptionSystemProxyBridge.ts
new file mode 100644
index 0000000..1c7865d
--- /dev/null
+++ b/packages/desktop/src/host/subscriptionSystemProxyBridge.ts
@@ -0,0 +1,51 @@
+import { randomUUID } from "node:crypto";
+import { HostResponseTypes } from "@zcode/shared";
+
+export function createSubscriptionSystemProxyBridge(post: (message: unknown) => void) {
+  let disposed = false;
+  const pending = new Map<
+    string,
+    {
+      resolve: (proxy: string | undefined) => void;
+      reject: (error: Error) => void;
+      timer: ReturnType<typeof setTimeout>;
+    }
+  >();
+  return {
+    resolve(url: string): Promise<string | undefined> {
+      if (disposed) return Promise.reject(new Error("System proxy resolver disposed"));
+      const requestId = randomUUID();
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+          pending.delete(requestId);
+          reject(new Error("System proxy resolution timed out"));
+        }, 5000);
+        timer.unref?.();
+        pending.set(requestId, { resolve, reject, timer });
+        try {
+          post({ type: HostResponseTypes.SubscriptionSystemProxyRequest, requestId, url });
+        } catch (error) {
+          clearTimeout(timer);
+          pending.delete(requestId);
+          reject(error);
+        }
+      });
+    },
+    accept(result: { requestId: string; ok: boolean; proxy?: string; error?: string }) {
+      const entry = pending.get(result.requestId);
+      if (!entry) return;
+      pending.delete(result.requestId);
+      clearTimeout(entry.timer);
+      if (result.ok) entry.resolve(result.proxy);
+      else entry.reject(new Error(result.error ?? "System proxy resolution failed"));
+    },
+    dispose() {
+      disposed = true;
+      for (const entry of pending.values()) {
+        clearTimeout(entry.timer);
+        entry.reject(new Error("System proxy resolver disposed"));
+      }
+      pending.clear();
+    },
+  };
+}
