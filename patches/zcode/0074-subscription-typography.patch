diff --git a/packages/ui/test/settingsTypography.browser.test.tsx b/packages/ui/test/settingsTypography.browser.test.tsx
new file mode 100644
index 0000000..5321963
--- /dev/null
+++ b/packages/ui/test/settingsTypography.browser.test.tsx
@@ -0,0 +1,67 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { PlanStatusCardSurface } from "../src/settings/model-provider-section/PlanStatusCardSurface.js";
+import { CredentialDefaultControl } from "../src/settings/model-provider-section/ProviderDraftControls.js";
+import { SubscriptionAllowanceDetails } from "../src/settings/model-provider-section/SubscriptionAllowanceDetails.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+const font = (node: Element) => Number.parseFloat(getComputedStyle(node).fontSize);
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+async function run() {
+  for (const locale of ["zh-CN", "en-US"] as const) {
+    for (const size of [14, 20]) {
+      const node = document.createElement("div");
+      node.style.width = "320px";
+      document.body.append(node);
+      document.documentElement.style.setProperty("--ui-font-size", `${size}px`);
+      const root = createRoot(node);
+      const name = `${locale}: title, state and quota follow the same UI scale at ${size}px`;
+      try {
+        await act(async () => root.render(
+          <ZCodeIntlProvider initialLocale={locale}>
+            <div data-compact><PlanStatusCardSurface compact planTitle="Account" /></div>
+            <div data-full><PlanStatusCardSurface planTitle="Account" /></div>
+            <div data-default>
+              <CredentialDefaultControl selected onSelect={() => {}} />
+            </div>
+            <div data-action>
+              <CredentialDefaultControl selected={false} onSelect={() => {}} />
+            </div>
+            <div data-quota>
+              <SubscriptionAllowanceDetails
+                now={0}
+                result={{
+                  status: "available", source: "fixture", observedAt: 0,
+                  windows: [{ id: "default:primary", windowMinutes: 300, usedPercent: 15, resetAt: 86_400_000 }],
+                }}
+              />
+            </div>
+          </ZCodeIntlProvider>,
+        ));
+        const compact = node.querySelector("[data-compact] h3")!;
+        const full = node.querySelector("[data-full] h3")!;
+        const selected = node.querySelector("[data-default] span.self-center")!;
+        const action = node.querySelector("[data-action] button")!;
+        const quota = node.querySelector("[data-quota] [aria-valuenow]")!.previousElementSibling!;
+        const timestamp = node.querySelector("[data-quota] [aria-valuenow]")!.nextElementSibling!;
+        check(font(action) === size, "Built stylesheet did not load the actual UI size tokens");
+        check(font(compact) === font(full) && font(compact) > font(action), "Density changed account-title hierarchy");
+        check(font(selected) === font(action), "Default state changes font size when selected");
+        check(font(quota) === font(action), "Quota information is smaller than other primary text");
+        check(font(timestamp) < font(quota), "Reset timestamp lost its secondary hierarchy");
+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: String(error) });
+      } finally {
+        await act(async () => root.unmount());
+        node.remove();
+      }
+    }
+  }
+}
+(window as unknown as Record<string, unknown>).__settingsTypographyTests = run().then(() => results);
