diff --git a/packages/services/test/provider-protocol-policy.test.ts b/packages/services/test/provider-protocol-policy.test.ts
new file mode 100644
index 0000000..738f045
--- /dev/null
+++ b/packages/services/test/provider-protocol-policy.test.ts
@@ -0,0 +1,178 @@
+import assert from "node:assert/strict";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+import {
+  parseProviderConfig,
+  assertProviderProtocolChange,
+  resolveTemplateProtocolFormats,
+  parseProviderTemplateMap,
+  resolveProviderProtocolPolicy,
+} from "@zcode/provider";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+
+const preset = {
+  api: { type: "openai-responses" as const, baseUrl: "https://api.openai.com/v1" },
+  access: { type: "api-key" as const },
+};
+
+test("declared protocols share only the exact service/region/endpoint and survive host validation", async () => {
+  const json = JSON.parse(
+    await readFile(new URL("../../../config/provider/zcode-builtin.json", import.meta.url), "utf8"),
+  );
+  const templates = parseProviderTemplateMap(
+    json.config.providerConfigRules.templateRules,
+  ).toJSON();
+  assert.deepEqual(resolveTemplateProtocolFormats("openai", templates), ["openai-responses"]);
+  const declared = resolveTemplateProtocolFormats("opencode-go-chat", templates);
+  assert.equal(declared.length, 3);
+  const template = templates.find((t) => t.templateId === "opencode-go-chat")!.config;
+  for (const type of declared)
+    assert.doesNotThrow(() =>
+      assertProviderProtocolChange(
+        template,
+        {
+          ...template,
+          api: { ...template.api, type },
+        },
+        undefined,
+        declared,
+      ),
+    );
+  const f = await fixture();
+  try {
+    const service = f.runtime.configService;
+    const { providerId } = await service.createPersonalProvider({ templateId: "opencode-go-chat" });
+    await service.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig({ api: { type: "openai-responses" } }),
+    );
+    assert.equal(
+      (await service.read()).personalProviders.get(providerId)?.api?.type,
+      "openai-responses",
+    );
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("preset defaults are automatic; custom addresses retain explicit adapter choice", () => {
+  const native = resolveProviderProtocolPolicy(preset, preset);
+  assert.equal(native.mode, "preset");
+  assert.deepEqual(native.formats, ["openai-responses"]);
+  assert.equal(
+    resolveProviderProtocolPolicy(preset, {
+      ...preset,
+      api: { ...preset.api, baseUrl: "https://api.openai.com/v1/" },
+    }).mode,
+    "preset",
+  );
+  const custom = resolveProviderProtocolPolicy(preset, {
+    ...preset,
+    api: { ...preset.api, baseUrl: "https://proxy.example/v1" },
+  });
+  assert.equal(custom.mode, "custom");
+  assert.equal(custom.formats.length, 3);
+  assert.equal(resolveProviderProtocolPolicy(undefined, preset).mode, "custom");
+});
+
+test("a legacy override remains selected, never advertised as a recommended protocol", () => {
+  const legacy = resolveProviderProtocolPolicy(preset, {
+    ...preset,
+    api: { ...preset.api, type: "anthropic-messages" },
+  });
+  assert.equal(legacy.mode, "override");
+  assert.equal(legacy.recommended, "openai-responses");
+  assert.deepEqual(legacy.formats, ["openai-responses", "anthropic-messages"]);
+  const previous = { ...preset, api: { ...preset.api, type: "anthropic-messages" as const } };
+  assert.doesNotThrow(() =>
+    assertProviderProtocolChange(
+      preset,
+      {
+        ...previous,
+        access: { type: "api-key", apiKey: "replacement-key" },
+      },
+      previous,
+    ),
+  );
+  assert.doesNotThrow(() => assertProviderProtocolChange(preset, preset, previous));
+});
+
+async function fixture() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-protocol-"));
+  const personalFilePath = join(dir, "personal.json");
+  const runtime = createProviderConfigRuntime({
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalFilePath,
+    personalPollingIntervalMs: false,
+    watch: false,
+  });
+  await runtime.start();
+  return {
+    runtime,
+    personalFilePath,
+    dispose: async () => {
+      runtime.dispose();
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+test("host rejects a mismatched preset protocol before creating or modifying records", async () => {
+  const f = await fixture();
+  try {
+    const service = f.runtime.configService;
+    const { providerId } = await service.createPersonalProvider({ templateId: "openai" });
+    const before = await readFile(f.personalFilePath, "utf8");
+    const invalid = parseProviderConfig({ api: { type: "anthropic-messages" } });
