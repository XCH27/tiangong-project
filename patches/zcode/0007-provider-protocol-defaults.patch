diff --git a/packages/provider/src/protocol-policy.ts b/packages/provider/src/protocol-policy.ts
new file mode 100644
index 0000000..f63b3d2
--- /dev/null
+++ b/packages/provider/src/protocol-policy.ts
@@ -0,0 +1,101 @@
+import type {
+  ProviderApiType,
+  ProviderConfigObject,
+  ProviderTemplateObject,
+} from "./config/index.js";
+
+export const CUSTOM_PROVIDER_API_FORMATS: readonly ProviderApiType[] = [
+  "anthropic-messages",
+  "openai-chat-completions",
+  "openai-responses",
+];
+
+export interface ProviderProtocolPolicy {
+  readonly mode: "preset" | "custom" | "override" | "subscription";
+  readonly recommended?: ProviderApiType;
+  readonly formats: readonly ProviderApiType[];
+}
+
+/** 同一服务/区域/地址的显式变体可以共用格式；不能从同品牌其他套餐推断。 */
+export function resolveTemplateProtocolFormats(
+  templateId: string | null | undefined,
+  templates: readonly ProviderTemplateObject[],
+): ProviderApiType[] {
+  const template = templates.find((item) => item.templateId === templateId);
+  const catalog = template?.catalog;
+  const formats = templates
+    .filter(
+      (item) =>
+        item === template ||
+        (catalog &&
+          item.catalog?.vendorId === catalog.vendorId &&
+          item.catalog.serviceId === catalog.serviceId &&
+          item.catalog.region === catalog.region &&
+          endpoint(item.config.api?.baseUrl) === endpoint(template?.config.api?.baseUrl) &&
+          item.config.access?.type === template?.config.access?.type),
+    )
+    .map((item) => item.config.api?.type)
+    .filter((api): api is ProviderApiType => api != null);
+  return [...new Set(formats)];
+}
+
+function endpoint(value: string | null | undefined): string {
+  return value?.trim().replace(/\/+$/, "") ?? "";
+}
+
+/** 模板是推荐值的唯一来源；不按域名片段、模型名称或返回文本猜协议。 */
+export function resolveProviderProtocolPolicy(
+  template: ProviderConfigObject | undefined,
+  config: ProviderConfigObject,
+  declaredFormats?: readonly ProviderApiType[],
+): ProviderProtocolPolicy {
+  const recommended = template?.api?.type ?? undefined;
+  if (template?.access?.type === "subscription" || config.access?.type === "subscription") {
+    return { mode: "subscription", recommended, formats: [] };
+  }
+  if (
+    !recommended ||
+    !endpoint(template?.api?.baseUrl) ||
+    endpoint(template?.api?.baseUrl) !== endpoint(config.api?.baseUrl)
+  ) {
+    return { mode: "custom", formats: CUSTOM_PROVIDER_API_FORMATS };
+  }
+  const current = config.api?.type;
+  const formats = [...new Set([recommended, ...(declaredFormats ?? [])])];
+  return current && !formats.includes(current)
+    ? { mode: "override", recommended, formats: [...formats, current] }
+    : { mode: "preset", recommended, formats };
+}
+
+/** 公共写入边界也校验；旧覆盖不迁移，无关编辑不因旧格式而失败。 */
+export function assertProviderProtocolChange(
+  template: ProviderConfigObject | undefined,
+  next: ProviderConfigObject,
+  previous?: ProviderConfigObject,
+  declaredFormats?: readonly ProviderApiType[],
+): void {
+  if (!template) return;
+  if (template.access?.type === "subscription") {
+    if (
+      next.access?.type !== "subscription" ||
+      next.access.provider !== template.access.provider ||
+      next.api?.type !== template.api?.type ||
+      endpoint(next.api?.baseUrl) !== endpoint(template.api?.baseUrl) ||
+      JSON.stringify(next.api?.headers) !== JSON.stringify(template.api?.headers)
+    ) {
+      throw new Error("Subscription connection transport and authentication are adapter-owned");
+    }
+    return;
+  }
+  const policy = resolveProviderProtocolPolicy(template, next, declaredFormats);
+  if (policy.mode !== "override") return;
+  if (
+    previous &&
+    previous.api?.type === next.api?.type &&
+    endpoint(previous.api?.baseUrl) === endpoint(next.api?.baseUrl)
+  )
+    return;
+  throw new Error(
+    "Protocol is not declared for this preset endpoint; use its preset or a custom connection",
+  );
+}
