+test("unreported capability fields never become provider facts through the runtime fallback", async () => {
+  const f = await fixture();
+  try {
+    await f.service.addPersonalModel(f.providerId, "unknown-model", {});
+    let model = (await f.models()).find((item) => item.modelId === "unknown-model")!;
+    assert.equal(model.effectiveConfig.properties?.contextWindow, 200_000);
+    assert.equal(model.evidenceConfig?.properties?.contextWindow, undefined);
+    assert.equal(model.contextEvidenceSource, "unknown");
+    f.setFetch(async () =>
+      Response.json({ data: [{ id: "unknown-model", context_window: 480_000 }] }),
+    );
+    await f.service.discoverModels(f.providerId);
+    model = (await f.models()).find((item) => item.modelId === "unknown-model")!;
+    assert.equal(model.evidenceConfig?.properties?.contextWindow, 480_000);
+    assert.equal(model.contextEvidenceSource, "provider");
+    f.setFetch(async () => Response.json({ data: [{ id: "unknown-model" }] }));
+    await f.service.discoverModels(f.providerId);
+    await f.restart();
+    model = (await f.models()).find((item) => item.modelId === "unknown-model")!;
+    assert.equal(model.evidenceConfig?.properties?.contextWindow, undefined);
+    assert.equal(model.contextEvidenceSource, "unknown");
+    assert.equal(model.effectiveConfig.properties?.contextWindow, 200_000);
+  } finally {
+    await f.dispose();
+  }
+});
