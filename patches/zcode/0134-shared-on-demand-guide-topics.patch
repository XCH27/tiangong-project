diff --git a/packages/services/src/documentation/localGuide.ts b/packages/services/src/documentation/localGuide.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa2646c688b47a04756b141755749a687a219785
--- /dev/null
+++ b/packages/services/src/documentation/localGuide.ts
@@ -0,0 +1,76 @@
+import { readFile, open } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import {
+  localGuideExcerptSchema,
+  type AppPageAssistantTarget,
+  type LocalGuideExcerpt,
+} from "@zcode/shared";
+import { findZCodeAgentRuntimeNodeBundle } from "../runtime-tools/providerRuntimeResolver.js";
+
+// These select sections of the existing human/Agent Markdown asset. They are
+// not a second copy of the instructions or permission rules for these pages.
+const topics = {
+  connections: ["Model connections", "模型连接"],
+  defaults: ["Default models and page assistance", "默认模型与页面助手"],
+  context: ["Permissions and context", "权限与上下文"],
+  extensions: ["Plugins, Skills, MCP and hooks", "插件、技能、MCP 与钩子"],
+  profile: ["Local profile and GitHub tools", "个人资料与 GitHub 工具"],
+  diagnostics: ["Local diagnostics", "本地诊断"],
+} as const;
+const pageTopics: Partial<Record<AppPageAssistantTarget["pageId"], keyof typeof topics>> = {
+  modelProvider: "connections",
+  modelDefaults: "defaults",
+  usage: "context",
+  conversation: "context",
+  general: "profile",
+  appearance: "profile",
+  "plugin-store": "extensions",
+  plugin: "extensions",
+  mcp: "extensions",
+  skill: "extensions",
+  commands: "extensions",
+  hooks: "extensions",
+  onboarding: "diagnostics",
+};
+const unavailable = (reason: "topic-not-covered" | "asset-unavailable"): LocalGuideExcerpt => ({
+  status: "unavailable",
+  source: "fleet-local-guide",
+  reason,
+});
+
+/** Read only a shipped topic beside the selected runtime; no user path or hosted fetch. */
+export async function readLocalGuideExcerpt(
+  pageId: AppPageAssistantTarget["pageId"],
+  locale: string,
+  bundlePath = findZCodeAgentRuntimeNodeBundle(),
+): Promise<LocalGuideExcerpt> {
+  const topic = pageTopics[pageId];
+  if (!topic) return unavailable("topic-not-covered");
+  if (!bundlePath) return unavailable("asset-unavailable");
+  const language = locale === "zh-CN" ? "zh-CN" : "en-US";
+  const root = join(dirname(bundlePath), "packages", "zcode-guide-plugin");
+  let file: Awaited<ReturnType<typeof open>> | undefined;
+  try {
+    const manifest = JSON.parse(await readFile(join(root, ".zcode-plugin/plugin.json"), "utf8"));
+    if (manifest.name !== "zcode-guide") return unavailable("asset-unavailable");
+    file = await open(join(root, "docs", language === "zh-CN" ? "guide.zh-CN.md" : "guide.en.md"));
+    const stat = await file.stat();
+    if (!stat.isFile() || stat.size > 65_536) return unavailable("asset-unavailable");
+    const markdown = await file.readFile("utf8");
+    const heading = topics[topic][language === "zh-CN" ? 1 : 0];
+    const section = markdown.split(/^## /m).find((value) => value.startsWith(`${heading}\n`));
+    if (!section) return unavailable("asset-unavailable");
+    return localGuideExcerptSchema.parse({
+      status: "available",
+      source: "fleet-local-guide",
+      version: manifest.version,
+      locale: language,
+      topic,
+      content: `## ${section.trim()}`,
+    });
+  } catch {
+    return unavailable("asset-unavailable");
+  } finally {
+    await file?.close();
+  }
+}
