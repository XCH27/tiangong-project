diff --git a/packages/services/src/model-provider/subscriptionRecovery.ts b/packages/services/src/model-provider/subscriptionRecovery.ts
new file mode 100644
index 0000000..7434165
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionRecovery.ts
@@ -0,0 +1,68 @@
+import { credentialIsBlocked, recordCredentialRejection } from "@zcode/shared";
+import type { SavedConnection, SubscriptionRecovery } from "./subscriptionConnectionTypes.js";
+
+/** Called only under SubscriptionConnection's existing lock. No new store or credentials owner. */
+export function recordSubscriptionRejection(
+  saved: SavedConnection,
+  modelId: string | undefined,
+  recovery: SubscriptionRecovery,
+  now: number,
+): boolean {
+  const visited = recovery.attemptedAccountIds;
+  if (
+    saved.revision !== recovery.revision ||
+    ![401, 403, 429].includes(recovery.status) ||
+    !visited.length ||
+    visited.length > 10 ||
+    !modelId
+  )
+    throw new Error("No eligible subscription recovery account");
+  if (
+    new Set(visited).size !== visited.length ||
+    visited.some((id) => !saved.accounts?.some((a) => a.id === id))
+  )
+    throw new Error("Subscription recovery account list is invalid");
+  const failed = saved.accounts!.find((a) => a.id === visited.at(-1))!;
+  const rejection = recovery.rejection ?? {
+    reason:
+      recovery.status === 401
+        ? ("auth" as const)
+        : recovery.status === 403
+          ? ("policy" as const)
+          : ("throttle" as const),
+    scope: recovery.status === 401 ? ("credential" as const) : ("provider" as const),
+  };
+  const failureKey = rejection.reason === "auth" || rejection.reason === "policy" ? "*" : modelId;
+  failed.failures ??= {};
+  failed.failures[failureKey] = recordCredentialRejection(
+    failed.failures[failureKey],
+    rejection,
+    now,
+  );
+  if (rejection.scope === "provider")
+    saved.failure = recordCredentialRejection(saved.failure, rejection, now);
+  return !!saved.autoSwitch && visited.length < 10 && rejection.scope !== "provider";
+}
+
+export function selectSubscriptionAccount(
+  saved: SavedConnection,
+  modelId: string | undefined,
+  recovery: SubscriptionRecovery | undefined,
+  now: number,
+  eligible: (credential: NonNullable<SavedConnection["accounts"]>[number]["credential"]) => boolean,
+) {
+  const available = (account: NonNullable<SavedConnection["accounts"]>[number]) =>
+    !modelId ||
+    (!credentialIsBlocked(saved.failure, now) &&
+      !credentialIsBlocked(account.failures?.["*"], now) &&
+      !credentialIsBlocked(account.failures?.[modelId], now));
+  return recovery
+    ? saved.accounts?.find(
+        (a) =>
+          !recovery.attemptedAccountIds.includes(a.id) && available(a) && eligible(a.credential),
+      )
+    : (saved.accounts?.find((a) => a.id === saved.activeAccountId && available(a)) ??
+        (saved.autoSwitch
+          ? saved.accounts?.find((a) => available(a) && eligible(a.credential))
+          : undefined));
+}
