diff --git a/packages/shared/src/credential-health.ts b/packages/shared/src/credential-health.ts
new file mode 100644
index 0000000..1d45153
--- /dev/null
+++ b/packages/shared/src/credential-health.ts
@@ -0,0 +1,47 @@
+/** Failure facts only; credentials remain owned by the existing connection/transport. */
+export interface CredentialRejection {
+  reason: "auth" | "quota" | "throttle" | "policy";
+  retryAt?: number;
+  scope: "credential" | "provider";
+}
+
+export interface CredentialHealth extends CredentialRejection {
+  failures: number;
+  failedAt: number;
+}
+
+const MIN_COOLDOWN_MS = 60_000;
+const MAX_COOLDOWN_MS = 30 * MIN_COOLDOWN_MS;
+
+export function recordCredentialRejection(
+  previous: CredentialHealth | undefined,
+  rejection: CredentialRejection,
+  now: number,
+): CredentialHealth {
+  // 并发的旧响应不能缩短已知失效窗口，也不能在同一窗口内重复放大退避。
+  if (previous && (previous.retryAt === undefined || previous.retryAt > now)) {
+    if (rejection.reason === "auth" || rejection.reason === "policy")
+      return { ...rejection, retryAt: undefined, failedAt: now, failures: previous.failures };
+    if (previous.retryAt === undefined) return previous;
+    if (rejection.reason === "quota" && rejection.retryAt === undefined)
+      return { ...rejection, failedAt: now, failures: previous.failures };
+    return {
+      ...previous,
+      scope: previous.scope === "provider" ? "provider" : rejection.scope,
+      retryAt: Math.max(previous.retryAt, rejection.retryAt ?? previous.retryAt),
+    };
+  }
+  const failures = Math.min((previous?.failures ?? 0) + 1, 16);
+  const retryAt =
+    rejection.reason === "auth" || rejection.reason === "policy"
+      ? undefined
+      : (rejection.retryAt ??
+        (rejection.reason === "throttle"
+          ? now + Math.min(MAX_COOLDOWN_MS, MIN_COOLDOWN_MS * 2 ** (failures - 1))
+          : undefined));
+  return { ...rejection, retryAt, failures, failedAt: now };
+}
+
+export function credentialIsBlocked(health: CredentialHealth | undefined, now: number): boolean {
+  return !!health && (health.retryAt === undefined || health.retryAt > now);
+}
