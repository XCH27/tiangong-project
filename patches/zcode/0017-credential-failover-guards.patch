--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/credential-rejection.ts
@@ -0,0 +1,70 @@
+import type { CredentialRejection } from "@zcode/shared";
+
+export const CREDENTIAL_POOL_STOPPED = "FLEET_CREDENTIAL_POOL_STOPPED";
+export class CredentialPoolStoppedError extends Error {
+  readonly code = CREDENTIAL_POOL_STOPPED;
+  constructor(message: string, readonly statusCode?: number, readonly retryAt?: number) {
+    super(message);
+    this.name = "CredentialPoolStoppedError";
+  }
+}
+
+const MAX_ERROR_BYTES = 16_384;
+const ERROR_READ_TIMEOUT_MS = 1_000;
+
+/** Inspect only bounded, rejected HTTP bodies. Never consume a returned success stream. */
+export async function readCredentialRejection(response: Response, now: number): Promise<CredentialRejection> {
+  let body: Record<string, unknown> = {};
+  const clone = response.clone();
+  const reader = clone.body?.getReader();
+  if (reader) {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      const text = await Promise.race([
+        (async () => {
+          const decoder = new TextDecoder();
+          let content = "";
+          let bytes = 0;
+          while (bytes <= MAX_ERROR_BYTES) {
+            const part = await reader.read();
+            if (part.done) return content;
+            bytes += part.value.byteLength;
+            if (bytes > MAX_ERROR_BYTES) return "";
+            content += decoder.decode(part.value, { stream: true });
+          }
+          return "";
+        })(),
+        new Promise<string>((resolve) => { timer = setTimeout(() => resolve(""), ERROR_READ_TIMEOUT_MS); }),
+      ]);
+      const value: unknown = JSON.parse(text);
+      if (value && typeof value === "object") body = value as Record<string, unknown>;
+    } catch { /* 非 JSON 错误保持按 HTTP 状态保守处理。 */ }
+    finally {
+      clearTimeout(timer);
+      void reader.cancel().catch(() => {});
+    }
+  }
+  const error = body.error && typeof body.error === "object" ? body.error as Record<string, unknown> : body;
+  const details = error.details && typeof error.details === "object" ? error.details as Record<string, unknown> : {};
+  const code = String(details.error_code ?? error.code ?? error.type ?? "").toLowerCase();
+  const hint = response.headers.get("retry-after");
+  const seconds = hint?.trim() ? Number(hint) : NaN;
+  const date = hint ? Date.parse(hint) : NaN;
+  const milliseconds = Number(response.headers.get("retry-after-ms"));
+  const reset = typeof error.resets_at === "number" ? error.resets_at * 1_000 : NaN;
+  const resetSeconds = typeof error.resets_in_seconds === "number" ? error.resets_in_seconds : NaN;
+  const candidates = [Number.isFinite(seconds) && seconds >= 0 ? now + seconds * 1_000 : date,
+    milliseconds > 0 ? now + milliseconds : NaN, reset,
+    resetSeconds > 0 ? now + resetSeconds * 1_000 : NaN].filter((n) => Number.isFinite(n) && n > now);
+  const retryAt = candidates.length ? Math.max(...candidates) : undefined;
+  if (response.status === 403 || /deactivated|banned|suspended|policy/.test(code))
+    return { reason: "policy", scope: "provider" };
+  if (response.status === 401) return { reason: "auth", scope: "credential" };
+  // Anthropic 的月消费上限也返回 rate_limit_error，但不能按一分钟限流恢复。
+  if (code === "enforced_spend_limit_reached") return { reason: "quota", scope: "provider", retryAt };
+  const shared = /organization|project|ip_limit|concurrency|rate_limit/.test(code) && code !== "usage_limit_reached";
+  if (/quota|balance|credit|usage_limit_reached/.test(code))
+    return { reason: "quota", scope: shared ? "provider" : "credential", retryAt };
+  // 未知 429 通常是共享吞吐限流，不能假设每把密钥有独立额度并立即轮询。
+  return { reason: "throttle", scope: "provider", retryAt };
+}
