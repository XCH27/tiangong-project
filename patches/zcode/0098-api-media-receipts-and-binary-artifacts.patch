+        .update(
+          JSON.stringify([
+            selected.binding,
+            images?.map((image) => createHash("sha256").update(image.bytes).digest("hex")),
+          ]),
+        )
+        .digest("hex");
+      const retainedBytes = () =>
+        [...imageBindings.values()].reduce(
+          (sum, value) =>
+            sum + (value.images?.reduce((bytes, image) => bytes + image.bytes.byteLength, 0) ?? 0),
+          0,
+        );
