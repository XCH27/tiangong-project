+import { z } from "zod";
+import type { ToolExecutionContext, ToolInputResolutionContext } from "../types.js";
+import {
+  createRootTraceContext,
+  type MediaGenerationPort,
+  type UsageStorePort,
+} from "@zcode/contracts";
+
+export async function readSessionImage(context: ToolInputResolutionContext, uri: string) {
+  if (
+    !context.sessionId ||
+    !uri.startsWith(`zcode-artifact://${encodeURIComponent(context.sessionId)}/`) ||
+    !context.artifactStore?.readToolResultBinaryArtifact
+  )
+    throw new Error("Image reference is not owned by this conversation");
+  const image = await context.artifactStore.readToolResultBinaryArtifact({ uri });
+  if (
+    !["image/png", "image/jpeg", "image/webp"].includes(image.contentType) ||
+    image.bytes.length === 0 ||
+    image.bytes.length > 16 * 1024 * 1024
+  )
+    throw new Error("Image reference is not a supported image");
+  return { mediaType: image.contentType, bytes: image.bytes };
+}
+
+const receiptSchema = z
+  .object({
+    version: z.literal(1),
+    jobId: z.string(),
+    kind: z.enum(["image", "video"]),
+    providerId: z.string(),
+    modelId: z.string(),
+    startedAt: z.number(),
+    updatedAt: z.number(),
+    status: z.enum(["pending", "unknown", "failed", "expired", "completed"]),
+    requestId: z.string().optional(),
+    credentialReference: z.string().optional(),
+    artifactUri: z.string().startsWith("zcode-artifact://").optional(),
+    mimeType: z.string().optional(),
+    reportedModelId: z.string().optional(),
+    reportedCostUsd: z.number().nonnegative().optional(),
+    billingProvider: z.string().optional(),
+    authKind: z.enum(["api-key", "subscription"]).optional(),
+    accountId: z.string().optional(),
+    providerUsage: z.record(z.string(), z.unknown()).optional(),
+  })
+  .strict();
+export type MediaJobReceipt = z.infer<typeof receiptSchema>;
+
+export async function writeMediaReceipt(
+  context: ToolExecutionContext,
+  receipt: MediaJobReceipt,
+  phase: string,
+) {
+  if (!context.artifactStore?.writeToolResultArtifactOnce)
+    throw new Error("Durable media receipt storage is unavailable; no paid request was made");
+  return context.artifactStore.writeToolResultArtifactOnce({
+    sessionId: context.sessionId,
+    toolCallId: context.toolCallId,
+    toolName: "MediaJobReceipt",
+    idempotencyKey: `${receipt.jobId}:${phase}`,
+    content: JSON.stringify(receiptSchema.parse(receipt)),
+    contentType: "application/json",
+    retention: "session",
+    trace: context.traceContext,
+  });
+}
+
+export async function readMediaReceipt(
+  context: ToolExecutionContext,
+  uri: string,
+): Promise<MediaJobReceipt> {
+  if (!uri.startsWith(`zcode-artifact://${encodeURIComponent(context.sessionId)}/`))
+    throw new Error("Media receipt belongs to another conversation");
+  if (!context.artifactStore) throw new Error("Media receipt storage is unavailable");
+  const record = await context.artifactStore.readToolResultArtifact({
+    uri,
+    trace: context.traceContext,
+  });
+  if (record.bytes > 64000) throw new Error("Invalid media receipt size");
+  return receiptSchema.parse(JSON.parse(record.content));
+}
+
+export async function listMediaReceipts(context: ToolExecutionContext) {
+  const files =
+    (await context.artifactStore?.listMediaJobArtifacts?.({ sessionId: context.sessionId })) ?? [];
+  const latest = new Map<string, { receipt: MediaJobReceipt; uri: string }>();
+  for (const file of files) {
+    if (file.bytes > 64000) continue;
+    try {
+      const receipt = await readMediaReceipt(context, file.uri);
+      const previous = latest.get(receipt.jobId);
+      if (!previous || newerReceipt(receipt, previous.receipt))
+        latest.set(receipt.jobId, { receipt, uri: file.uri });
+    } catch {
+      /* Other or damaged artifacts never authorize a submission. */
+    }
+  }
+  return [...latest.values()].sort((a, b) => b.receipt.updatedAt - a.receipt.updatedAt);
+}
+
+function newerReceipt(a: MediaJobReceipt, b: MediaJobReceipt): boolean {
+  const rank = { unknown: 0, pending: 1, failed: 2, expired: 2, completed: 3 };
+  return (
+    a.updatedAt > b.updatedAt || (a.updatedAt === b.updatedAt && rank[a.status] >= rank[b.status])
+  );
+}
+
+export async function latestMediaReceipt(
+  context: ToolExecutionContext,
+  original: MediaJobReceipt,
+  uri: string,
+) {
+  for (const phase of ["completed", "failed", "expired", "accepted"] as const) {
+    const file = await context.artifactStore?.findToolResultArtifactOnce?.({
+      sessionId: context.sessionId,
+      idempotencyKey: `${original.jobId}:${phase}`,
+    });
+    if (file) {
+      const receipt = await readMediaReceipt(context, file.uri);
+      if (newerReceipt(receipt, original)) return { receipt, uri: file.uri };
+    }
+  }
+  return { receipt: original, uri };
+}
+
+export function mediaJobOutput(receipt: MediaJobReceipt, uri: string) {
+  return {
+    jobId: receipt.jobId,
+    receiptUri: uri,
+    status: receipt.status,
+    providerId: receipt.providerId,
+    requestedModelId: receipt.modelId,
+    ...(receipt.artifactUri ? { artifactUri: receipt.artifactUri } : {}),
+    ...(receipt.mimeType ? { mimeType: receipt.mimeType } : {}),
+    ...(receipt.reportedModelId ? { reportedModelId: receipt.reportedModelId } : {}),
+    ...(receipt.reportedCostUsd === undefined ? {} : { reportedCostUsd: receipt.reportedCostUsd }),
+  };
+}
+
+/** Reconcile one physical request into the existing ledger after restart or a failed ledger write. */
+export async function recordMediaReceiptUsage(
+  context: ToolExecutionContext,
+  receipt: MediaJobReceipt,
+  uri: string,
+): Promise<boolean> {
+  const store = context.sessionStore as Partial<UsageStorePort> | undefined;
+  if (!store?.recordModelUsage) return false;
+  try {
+    await store.recordModelUsage({
+      id: receipt.jobId,
+      logicalRequestId: receipt.jobId,
+      sessionID: context.sessionId,
+      querySource: receipt.kind === "video" ? "media_video" : "media_image",
+      providerId: receipt.providerId,
+      modelId: receipt.reportedModelId ?? receipt.modelId,
+      startedAt: receipt.startedAt,
+      completedAt: receipt.updatedAt,
+      rawUsage: receipt.providerUsage,
+      status: receipt.status === "completed" ? "completed" : "error",
+      ...(receipt.status !== "completed" ? { errorMessage: `Media ${receipt.status}` } : {}),
+      providerMetadata: {
+        fleetAccounting: {
+          billingProvider:
+            receipt.billingProvider ?? (receipt.kind === "video" ? "xai" : undefined),
+          authKind: receipt.authKind ?? "api-key",
+          accountId: receipt.accountId,
+          workspacePath: context.workspaceRoot,
+          mediaReceiptUri: uri,
+          mediaStatus: receipt.status,
+          artifactUri: receipt.artifactUri,
+          requestedModelId: receipt.modelId,
+          ...(receipt.reportedCostUsd === undefined
+            ? {}
+            : { reportedMediaUsd: receipt.reportedCostUsd }),
+        },
+      },
+    });
+    return true;
+  } catch {
+    return false;
+  } // Saved provider results survive an unavailable statistics writer.
+}
+
+export async function waitForMediaJob(
+  port: MediaGenerationPort,
+  context: ToolExecutionContext,
+  original: MediaJobReceipt,
+  uri: string,
+  waitSeconds: number,
+) {
+  const found = await latestMediaReceipt(context, original, uri);
+  let receipt = found.receipt;
+  uri = found.uri;
+  if (receipt.status === "completed" && receipt.artifactUri && receipt.kind === "video") {
+    try {
+      await context.artifactStore?.statToolResultArtifact?.({ uri: receipt.artifactUri });
+    } catch {
+      receipt = { ...receipt, status: "pending" };
+    } // Retrieve the original result; never POST.
+  }
+  if (receipt.status !== "pending" || !receipt.requestId || !receipt.credentialReference)
+    return {
+      ...mediaJobOutput(receipt, uri),
+      ...(receipt.status !== "pending"
+        ? { usageRecorded: await recordMediaReceiptUsage(context, receipt, uri) }
+        : {}),
+    };
+  if (!port.readVideo || !context.artifactStore?.writeToolResultBinaryArtifact)
+    throw new Error("This host cannot retrieve the saved video request");
+  const until = Date.now() + waitSeconds * 1000;
+  do {
+    if (context.abortSignal.aborted) break; // Waiting stopped; provider work may still finish.
+    const result = await port.readVideo({
+      providerId: receipt.providerId,
+      modelId: receipt.modelId,
+      requestId: receipt.requestId,
+      credentialReference: receipt.credentialReference,
+      signal: context.abortSignal,
+    });
+    if (result.status === "done") {
+      // Once downloaded, commit bytes even if the user stops the surrounding conversation.
+      const artifact = await context.artifactStore.writeToolResultBinaryArtifact({
+        content: result.bytes,
+        contentType: result.mimeType,
+        sessionId: context.sessionId,
+        toolCallId: receipt.jobId,
+        toolName: "GenerateVideo",
+        retention: "session",
+        idempotencyKey: receipt.jobId,
+        trace: context.traceContext ?? createRootTraceContext({ sessionId: context.sessionId }),
+      });
+      receipt = {
+        ...receipt,
+        status: "completed",
+        updatedAt: Date.now(),
+        artifactUri: artifact.uri,
+        mimeType: result.mimeType,
+        ...(result.reportedModelId ? { reportedModelId: result.reportedModelId } : {}),
+        ...(result.reportedCostUsd === undefined
+          ? {}
+          : { reportedCostUsd: result.reportedCostUsd }),
+        providerUsage: result.providerUsage,
+      };
+      const saved = await writeMediaReceipt(context, receipt, "completed");
+      receipt = await readMediaReceipt(context, saved.uri);
+      uri = saved.uri;
+      return {
+        ...mediaJobOutput(receipt, uri),
+        usageRecorded: await recordMediaReceiptUsage(context, receipt, uri),
+      };
+    }
+    if (result.status === "failed" || result.status === "expired") {
+      receipt = { ...receipt, status: result.status, updatedAt: Date.now() };
+      const saved = await writeMediaReceipt(context, receipt, result.status);
+      return {
+        ...mediaJobOutput(receipt, saved.uri),
+        usageRecorded: await recordMediaReceiptUsage(context, receipt, saved.uri),
+      };
+    }
+    if (Date.now() >= until) break;
+    await new Promise<void>((resolve) => {
+      const done = () => {
+        clearTimeout(timer);
+        context.abortSignal.removeEventListener("abort", done);
+        resolve();
+      };
+      const timer = setTimeout(done, Math.min(5000, Math.max(0, until - Date.now())));
+      context.abortSignal.addEventListener("abort", done, { once: true });
+    });
+  } while (Date.now() <= until);
+  return mediaJobOutput(receipt, uri);
+}
