+import {
+  GENERATE_VIDEO_TOOL_NAME,
+  RESUME_MEDIA_JOB_TOOL_NAME,
+  GenerateVideoInputSchema,
+  GenerateVideoExecutionInputSchema,
+  GenerateVideoInputJsonSchema,
+  ResumeMediaJobInputSchema,
+  ResumeMediaJobInputJsonSchema,
+  MediaJobOutputSchema,
+  MediaJobOutputJsonSchema,
+  type MediaGenerationPort,
+  type ModelMessageContent,
+  type UsageStorePort,
+} from "@zcode/contracts";
+import type { ToolEntry } from "../types.js";
+import { toolUsageId } from "../../runtime/usage-identity.js";
+import {
+  mediaJobOutput,
+  readMediaReceipt,
+  readSessionImage,
+  waitForMediaJob,
+  writeMediaReceipt,
+  type MediaJobReceipt,
+} from "./media-jobs.js";
+
+const formatOutput = (output: unknown): ModelMessageContent => {
+  const result = MediaJobOutputSchema.parse(output);
+  const text = `Media request ${result.status}. Receipt: ${result.receiptUri}. ${result.status === "unknown" ? "Never resubmit this paid request automatically." : result.status === "pending" ? "ResumeMediaJob retrieves this existing request without another generation." : ""}${result.usageRecorded === false ? " Usage ledger is unavailable; saved media remains available but statistics may undercount." : ""}`;
+  return result.artifactUri && result.mimeType
+    ? [
+        { type: "text", text },
+        {
+          type: "file",
+          mediaType: result.mimeType,
+          name: result.mimeType === "video/mp4" ? "generated-video.mp4" : "Generated image",
+          uri: result.artifactUri,
+          text: `Generated media saved as ${result.artifactUri}. Use an explicit read if analysis is needed.`,
+          source: {
+            id: result.artifactUri,
+            kind: "inline",
+            uri: result.artifactUri,
+            placeholder: "Generated media",
+          },
+        },
+      ]
+    : text;
+};
+
+export function createVideoGenerationTools(port: MediaGenerationPort): ToolEntry[] {
+  const common = {
+    readOnly: false,
+    destructive: false,
+    concurrentSafe: false,
+    maxOutputBytes: 16000,
+    sideEffectScope: "network" as const,
+    riskLevel: "high" as const,
+    needsApproval: true,
+  };
+  return [
+    {
+      capability:
+        "Generate a video using an admitted media model; retain the external request through stop/restart",
+      metadata: {
+        ...common,
+        name: GENERATE_VIDEO_TOOL_NAME,
+        description:
+          "Generate one video through a model returned by ListMediaModels. This is a paid request. Saves a durable receipt before submitting; returns a saved video or a receipt to ResumeMediaJob. imageArtifactUri may reuse a generated image in this conversation.",
+        timeoutMs: 150000,
+      },
+      inputSchema: GenerateVideoInputJsonSchema,
+      runtimeInputSchema: GenerateVideoExecutionInputSchema,
+      outputSchema: MediaJobOutputJsonSchema,
+      runtimeOutputSchema: MediaJobOutputSchema,
+      async resolveInput(input, context) {
+        try {
+          const request = GenerateVideoInputSchema.parse(input);
+          if (!port.prepareVideo || !port.submitVideo || !port.readVideo)
+            throw new Error("Video generation is unavailable");
+          let image: { mediaType: string; bytes: Uint8Array } | undefined;
+          if (request.imageArtifactUri) {
+            image = await readSessionImage(context, request.imageArtifactUri);
+          }
+          return {
+            result: true,
+            input: { ...request, ...(await port.prepareVideo({ ...request, image })) },
+          };
+        } catch (error) {
+          return {
+            result: false,
+            errorCode: 4102,
+            message: error instanceof Error ? error.message : "Video model check failed",
+          };
+        }
+      },
+      async handler(input, context) {
+        const request = GenerateVideoExecutionInputSchema.parse(input);
+        const store = context.sessionStore as Partial<UsageStorePort> | undefined;
+        if (
+          !context.artifactStore?.writeToolResultArtifactOnce ||
+          !context.artifactStore.writeToolResultBinaryArtifact ||
+          !store?.recordModelUsage ||
+          !port.submitVideo
+        )
+          throw new Error("Media recovery/storage is unavailable; no paid request was made");
+        const identity = context.traceContext?.attributes?.assistantMessageId;
+        const jobId = `media-video:${toolUsageId(context.sessionId, context.toolCallId, context.turnId, typeof identity === "string" ? identity : context.parentSpanId)}`;
+        const now = Date.now();
+        let receipt: MediaJobReceipt = {
+          version: 1,
+          jobId,
+          kind: "video",
+          providerId: request.providerId,
+          modelId: request.modelId,
+          startedAt: now,
+          updatedAt: now,
+          status: "unknown",
+          credentialReference: request.credentialReference,
+        };
+        const claim = await writeMediaReceipt(context, receipt, "intent");
+        if (!claim.created)
+          return waitForMediaJob(
+            port,
+            context,
+            await readMediaReceipt(context, claim.uri),
+            claim.uri,
+            0,
+          );
+        let submitted: { requestId: string };
+        try {
+          submitted = await port.submitVideo({ ...request, signal: context.abortSignal });
+        } catch {
+          await store.recordModelUsage({
+            id: jobId,
+            logicalRequestId: jobId,
+            sessionID: context.sessionId,
+            querySource: "media_video",
+            providerId: request.providerId,
+            modelId: request.modelId,
+            status: "error",
+            startedAt: now,
+            completedAt: Date.now(),
+            errorMessage:
+              "Video submission outcome is unknown; use its saved receipt, never resubmit automatically",
+            providerMetadata: {
+              fleetAccounting: {
+                billingProvider: "xai",
+                authKind: "api-key",
+                workspacePath: context.workspaceRoot,
+                mediaReceiptUri: claim.uri,
+                mediaSubmission: "unknown",
+              },
+            },
+          });
+          return mediaJobOutput(receipt, claim.uri);
+        } // An uncertain POST is never repeated.
+        receipt = {
+          ...receipt,
+          status: "pending",
+          requestId: submitted.requestId,
+          updatedAt: Date.now(),
+        };
+        const saved = await writeMediaReceipt(context, receipt, "accepted");
+        await store.recordModelUsage({
+          id: jobId,
+          logicalRequestId: jobId,
+          sessionID: context.sessionId,
+          querySource: "media_video",
+          providerId: request.providerId,
+          modelId: request.modelId,
+          status: "completed",
+          startedAt: now,
+          providerMetadata: {
+            fleetAccounting: {
+              billingProvider: "xai",
+              authKind: "api-key",
+              workspacePath: context.workspaceRoot,
+              mediaReceiptUri: saved.uri,
+            },
+          },
+        });
+        return waitForMediaJob(port, context, receipt, saved.uri, 90);
+      },
+      formatModelContent: formatOutput,
+      permission: {
+        permission: "media.generate.video",
+        reason:
+          "GenerateVideo submits one paid request and retains its result in this conversation",
+        riskLevel: "high",
+        sideEffectScope: "network",
+        needsApproval: true,
+        patternSources: ["toolName"],
+        alwaysAllowPatternSources: [],
+        denyPriority: "beforeAsk",
+      },
+      timeout: { kind: "timed", defaultMs: 150000, maxMs: 150000, allowCallOverride: false },
+      cancellation: {
+        supported: true,
+        cleanup: "bestEffort",
+        userVisibleMessage:
+          "Stopped waiting; the submitted video may continue. ResumeMediaJob retrieves it without submitting again.",
+      },
+      resultBudget: {
+        maxInlineBytes: 16000,
+        maxModelBytes: 16000,
+        strategy: "truncate",
+        preview: { maxBytes: 16000, direction: "head" },
+      },
+      trace: {
+        required: true,
+        propagateToAdapters: true,
+        recordInput: "summary",
+        recordOutput: "summary",
+      },
+    },
+    {
+      capability:
+        "Retrieve an existing media request or its saved artifact without another paid submission",
+      metadata: {
+        ...common,
+        name: RESUME_MEDIA_JOB_TOOL_NAME,
+        description:
+          "Read or wait for a saved media receipt in this conversation. Never starts generation. Pending videos are polled using their original request ID and credential. Unknown submissions cannot safely be recreated.",
+        timeoutMs: 650000,
+        riskLevel: "medium",
+        needsApproval: false,
+      },
+      inputSchema: ResumeMediaJobInputJsonSchema,
+      runtimeInputSchema: ResumeMediaJobInputSchema,
+      outputSchema: MediaJobOutputJsonSchema,
+      runtimeOutputSchema: MediaJobOutputSchema,
+      handler: async (input, context) => {
+        const request = ResumeMediaJobInputSchema.parse(input);
+        return waitForMediaJob(
+          port,
+          context,
+          await readMediaReceipt(context, request.receiptUri),
+          request.receiptUri,
+          request.waitSeconds ?? 60,
+        );
+      },
+      formatModelContent: formatOutput,
+      permission: {
+        permission: "media.job.retrieve",
+        reason: "Retrieve an existing paid result; no new generation",
+        riskLevel: "medium",
+        sideEffectScope: "network",
+        needsApproval: false,
+        patternSources: ["toolName"],
+        alwaysAllowPatternSources: ["toolName"],
+        denyPriority: "beforeAsk",
+      },
+      timeout: { kind: "timed", defaultMs: 650000, maxMs: 650000, allowCallOverride: false },
+      cancellation: {
+        supported: true,
+        cleanup: "bestEffort",
+        userVisibleMessage: "Stopped waiting; the original media receipt remains available.",
+      },
+      resultBudget: {
+        maxInlineBytes: 16000,
+        maxModelBytes: 16000,
+        strategy: "truncate",
+        preview: { maxBytes: 16000, direction: "head" },
+      },
+      trace: {
+        required: true,
+        propagateToAdapters: true,
+        recordInput: "summary",
+        recordOutput: "summary",
+      },
+    },
+  ];
+}
