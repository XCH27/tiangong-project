+
+test("xAI edits freeze every reference and use JSON, OpenAI edits use multipart without legacy response_format", async () => {
+  for (const vendor of ["xai", "openai"] as const) {
+    const f = fixture(vendor);
+    const original = new Uint8Array(image);
+    const binding = await f.port.prepareImage({
+      providerId: "connection",
+      modelId: f.modelId,
+      prompt: "combine",
+      images: [
+        { mediaType: "image/png", bytes: original },
+        { mediaType: "image/png", bytes: image },
+      ],
+    });
+    original.fill(0); // Caller mutations after approval cannot replace the reference.
+    const result = await f.port.generateImage({
+      providerId: "connection",
+      modelId: f.modelId,
+      prompt: "combine",
+      binding,
+      signal: new AbortController().signal,
+    });
+    const paid = f.requests[1]!;
+    assert.equal(new URL(paid.url).pathname, "/v1/images/edits");
+    assert.equal(paid.headers.Authorization, "Bearer original-synthetic-key");
+    if (vendor === "xai") {
+      assert.equal(paid.headers["Content-Type"], "application/json");
+      const body = JSON.parse(Buffer.from(paid.body).toString());
+      assert.equal(body.images.length, 2);
+      assert.equal(body.images[0].url, `data:image/png;base64,${image.toString("base64")}`);
+    } else {
+      assert.match(paid.headers["Content-Type"], /^multipart\/form-data; boundary=/);
+      const encoded = Buffer.from(paid.body).toString("latin1");
+      assert.equal((encoded.match(/name="image\[\]"/g) ?? []).length, 2);
+      assert.equal(encoded.includes("response_format"), false);
+    }
+    assert.equal(result.reportedModelId, undefined, "the requested model is not a reported model");
+    assert.equal(result.billingProvider, vendor);
+    assert.deepEqual(Buffer.from(result.bytes), image);
+  }
+});
+
+test("video checks membership, submits once, retrieves with the original key and downloads without credentials", async () => {
+  const f = fixture();
+  const input = {
+    providerId: "connection",
+    modelId: "grok-imagine-video-1.5",
+    prompt: "garden",
+    duration: 6,
+  };
+  const prepared = await f.port.prepareVideo!(input);
+  const submitted = await f.port.submitVideo!({
+    ...input,
+    ...prepared,
+    signal: new AbortController().signal,
+  });
+  f.provider.config.access.additionalApiKeys = [f.provider.config.access.apiKey];
+  f.provider.config.access.apiKey = "new-default-key";
+  const result = await f.port.readVideo!({
+    ...input,
+    ...prepared,
+    requestId: submitted.requestId,
+    signal: new AbortController().signal,
+  });
+  assert.equal(result.status, "done");
+  assert.equal(f.requests[2]!.headers.Authorization, "Bearer original-synthetic-key");
+  assert.deepEqual(f.requests[3]!.headers, {});
+  assert.equal(f.requests[3]!.redirect, "manual");
+  assert.equal(f.requests.filter((r) => r.method === "POST").length, 1);
+  f.provider.config.access.additionalApiKeys = [];
+  await assert.rejects(
+    f.port.readVideo!({
+      ...input,
+      ...prepared,
+      requestId: submitted.requestId,
+      signal: new AbortController().signal,
+    }),
+    /original video credential/,
+  );
+  assert.equal(f.requests.length, 4);
+});
