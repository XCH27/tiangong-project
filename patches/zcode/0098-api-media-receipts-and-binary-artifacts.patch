+
+function mediaApiOrigin(
+  value: string | null | undefined,
+): { origin: string; vendor: "xai" | "openai" } | undefined {
+  if (!value) return;
+  try {
+    const url = new URL(value);
+    if (
+      url.pathname.replace(/\/+$/, "") !== "/v1" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    )
+      return;
+    if (url.origin === "https://api.x.ai") return { origin: url.origin, vendor: "xai" };
+    if (url.origin === "https://api.openai.com") return { origin: url.origin, vendor: "openai" };
+  } catch {
+    return;
+  }
+}
