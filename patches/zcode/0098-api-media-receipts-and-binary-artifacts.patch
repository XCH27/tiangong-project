--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/api-media-generation-port.ts
@@ -0,0 +1,624 @@
+import { getEnabledApiKeys, isOfficialOpenaiImageModel } from "@zcode/provider";
+import type { HttpClientPort, MediaGenerationModel, MediaGenerationPort } from "@zcode/contracts";
+import { createHash } from "node:crypto";
+
+interface MediaRegistrySource {
+  getSnapshot(): {
+    sourceRevisions: { config: string };
+    resolution: {
+      resolvedProviders: readonly {
+        providerId: string;
+        providerName?: string | null;
+        enabled: boolean;
+        providerIssues: readonly unknown[];
+        config: {
+          api?: { baseUrl?: string | null } | null;
+          access?: {
+            type: string;
+            apiKey?: string | null;
+            additionalApiKeys?: readonly string[] | null;
+            apiKeyEnabledFlags?: readonly boolean[] | null;
+          } | null;
+        };
+        models: readonly {
+          modelId: string;
+          enabled: boolean;
+          issues: readonly unknown[];
+          config: {
+            properties?: {
+              outputFormat?: {
+                supportsText?: boolean | null;
+                supportsImage?: boolean | null;
+                supportsVideo?: boolean | null;
+              } | null;
+            } | null;
+          };
+        }[];
+      }[];
+    };
+  } | null;
+}
+
+const MAX_RESPONSE_BYTES = 24 * 1024 * 1024;
+const MAX_IMAGE_BYTES = 16 * 1024 * 1024;
+const MAX_REFERENCE_BYTES = 24 * 1024 * 1024;
+const MAX_RETAINED_REFERENCE_BYTES = 64 * 1024 * 1024;
+
+export function createApiMediaGenerationPort(input: {
+  registry: MediaRegistrySource;
+  http: Pick<HttpClientPort, "request">;
+}): MediaGenerationPort {
+  const imageBindings = new Map<
+    string,
+    {
+      key: string;
+      vendor: "xai" | "openai";
+      origin: string;
+      images?: readonly { mediaType: string; bytes: Uint8Array }[];
+    }
+  >();
+  const videoBindings = new Map<
+    string,
+    { key: string; body: Record<string, unknown>; reference: string; referenceBytes: number }
+  >();
+  const credential = (providerId: string, reference?: string) => {
+    const provider = input.registry
+      .getSnapshot()
+      ?.resolution.resolvedProviders.find((provider) => provider.providerId === providerId);
+    const access = provider?.config.access;
+    if (
+      !provider?.enabled ||
+      provider.providerIssues.length ||
+      !isGlobalXaiApi(provider.config.api?.baseUrl) ||
+      access?.type !== "api-key"
+    )
+      throw new Error("The original video connection is unavailable");
+    const keys = getEnabledApiKeys(access);
+    const key = reference
+      ? keys.find(
+          (key) =>
+            createHash("sha256")
+              .update(JSON.stringify([providerId, key]))
+              .digest("hex") === reference,
+        )
+      : keys[0];
+    if (!key)
+      throw new Error("The original video credential is unavailable; no new request was made");
+    return {
+      key,
+      reference: createHash("sha256")
+        .update(JSON.stringify([providerId, key]))
+        .digest("hex"),
+    };
+  };
+  const jsonRequest = async (
+    path: string,
+    key: string,
+    body?: Record<string, unknown>,
+    signal?: AbortSignal,
+  ) => {
+    const response = await input.http.request(
+      {
+        url: `https://api.x.ai/v1/${path}`,
+        method: body ? "POST" : "GET",
+        headers: {
+          Authorization: `Bearer ${key}`,
+          Accept: "application/json",
+          ...(body ? { "Content-Type": "application/json" } : {}),
+        },
+        ...(body ? { body: Buffer.from(JSON.stringify(body)) } : {}),
+        maxResponseBytes: 1024 * 1024,
+        timeoutMs: 30_000,
+        redirect: "manual",
+      },
+      { signal: signal ?? AbortSignal.timeout(30_000) },
+    );
+    if (response.status < 200 || response.status >= 300)
+      throw new Error(`Media request failed (HTTP ${response.status})`);
+    return JSON.parse(Buffer.from(response.body).toString("utf8")) as {
+      id?: unknown;
+      aliases?: unknown;
+      output_modalities?: unknown;
+      request_id?: unknown;
+      status?: unknown;
+      model?: unknown;
+      video?: { url?: string; duration?: unknown };
+      usage?: { cost_in_usd_ticks?: unknown };
+    };
+  };
+  const available = () =>
+    input.registry.getSnapshot()?.resolution.resolvedProviders.flatMap((provider) => {
+      if (
+        !provider.enabled ||
+        provider.providerIssues.length ||
+        !mediaApiOrigin(provider.config.api?.baseUrl)
+      ) {
+        return [];
+      }
+      const access = provider.config.access;
+      if (access?.type !== "api-key" || getEnabledApiKeys(access).length === 0) return [];
+      return provider.models.flatMap((model): MediaGenerationModel[] => {
+        if (!model.enabled || model.issues.length) return [];
+        const output = model.config.properties?.outputFormat;
+        return [
+          ...(output?.supportsImage === true &&
+          (isGlobalXaiApi(provider.config.api?.baseUrl) ||
+            isOfficialOpenaiImageModel(provider.config.api?.baseUrl, model.modelId))
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "image" as const,
+                  status: "requires-check" as const,
+                  billingProvider: mediaApiOrigin(provider.config.api?.baseUrl)!.vendor,
+                },
+              ]
+            : []),
+          ...(output?.supportsVideo === true && isGlobalXaiApi(provider.config.api?.baseUrl)
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "video" as const,
+                  status: "requires-check" as const,
+                  billingProvider: "xai",
+                },
+              ]
+            : []),
+        ];
+      });
+    }) ?? [];
+  const imageBinding = (providerId: string, modelId: string, prompt: string) => {
+    const snapshot = input.registry.getSnapshot();
+    const provider = snapshot?.resolution.resolvedProviders.find(
+      (candidate) => candidate.providerId === providerId,
+    );
+    const model = provider?.models.find((candidate) => candidate.modelId === modelId);
+    const access = provider?.config.access;
+    const key = access?.type === "api-key" ? getEnabledApiKeys(access)[0] : undefined;
+    if (
+      !snapshot ||
+      !provider?.enabled ||
+      provider.providerIssues.length ||
+      !mediaApiOrigin(provider.config.api?.baseUrl) ||
+      !model?.enabled ||
+      model.issues.length ||
+      model.config.properties?.outputFormat?.supportsImage !== true ||
+      !key
+    )
+      return null;
+    return {
+      key,
+      ...mediaApiOrigin(provider!.config.api?.baseUrl)!,
+      binding: createHash("sha256")
+        .update(JSON.stringify([snapshot.sourceRevisions.config, providerId, modelId, prompt, key]))
+        .digest("hex"),
+    };
+  };
+  return {
+    listModels: available,
+    async prepareVideo(request) {
+      if (
+        request.image &&
+        (!["image/png", "image/jpeg", "image/webp"].includes(request.image.mediaType) ||
+          request.image.bytes.length === 0 ||
+          request.image.bytes.length > MAX_IMAGE_BYTES)
+      )
+        throw new Error("Unsupported video image reference");
+      if (
+        request.duration !== undefined &&
+        (!Number.isInteger(request.duration) || request.duration < 1 || request.duration > 15)
+      )
+        throw new Error("Video duration must be between 1 and 15 seconds");
+      if (
+        !available().some(
+          (model) =>
+            model.kind === "video" &&
+            model.providerId === request.providerId &&
+            model.modelId === request.modelId,
+        )
+      )
+        throw new Error("Video model is unavailable");
+      const selected = credential(request.providerId);
+      const detail = await jsonRequest(
+        `video-generation-models/${encodeURIComponent(request.modelId)}`,
+        selected.key,
+      );
+      if (
+        (detail.id !== request.modelId &&
+          !(Array.isArray(detail.aliases) && detail.aliases.includes(request.modelId))) ||
+        (Array.isArray(detail.output_modalities) && !detail.output_modalities.includes("video"))
+      )
+        throw new Error("Provider did not confirm this video model");
+      const body = {
+        model: request.modelId,
+        prompt: request.prompt,
+        duration: request.duration ?? 6,
+        ...(request.image
+          ? {
+              image: {
+                url: `data:${request.image.mediaType};base64,${Buffer.from(request.image.bytes).toString("base64")}`,
+              },
+            }
+          : {}),
+      };
+      const binding = createHash("sha256")
+        .update(
+          JSON.stringify([
+            input.registry.getSnapshot()?.sourceRevisions.config,
+            request.providerId,
+            body,
+            selected.key,
+          ]),
+        )
+        .digest("hex");
+      const referenceBytes = request.image
+        ? Math.ceil(request.image.bytes.byteLength / 3) * 4 + 40
+        : 0;
+      const retainedBytes = () =>
+        [...videoBindings.values()].reduce((sum, value) => sum + value.referenceBytes, 0);
+      while (
+        videoBindings.size >= 64 ||
+        retainedBytes() + referenceBytes > MAX_RETAINED_REFERENCE_BYTES
+      )
+        videoBindings.delete(videoBindings.keys().next().value!);
+      videoBindings.set(binding, { ...selected, body, referenceBytes });
+      return { binding, credentialReference: selected.reference };
+    },
+    async submitVideo(request) {
+      const prepared = videoBindings.get(request.binding);
+      if (
+        !prepared ||
+        !available().some(
+          (model) =>
+            model.kind === "video" &&
+            model.providerId === request.providerId &&
+            model.modelId === request.modelId,
+        )
+      )
+        throw new Error("Video binding is no longer available");
+      const current = credential(request.providerId, prepared.reference);
+      const expected = createHash("sha256")
+        .update(
+          JSON.stringify([
+            input.registry.getSnapshot()?.sourceRevisions.config,
+            request.providerId,
+            prepared.body,
+            current.key,
+          ]),
+        )
+        .digest("hex");
+      if (
+        expected !== request.binding ||
+        prepared.body.model !== request.modelId ||
+        prepared.body.prompt !== request.prompt ||
+        prepared.body.duration !== (request.duration ?? 6)
+      )
+        throw new Error("Video request changed after confirmation");
+      request.signal.throwIfAborted();
+      videoBindings.delete(request.binding);
+      const payload = await jsonRequest(
+        "videos/generations",
+        current.key,
+        prepared.body,
+        request.signal,
+      );
+      if (
+        typeof payload.request_id !== "string" ||
+        !payload.request_id ||
+        payload.request_id.length > 200
+      )
+        throw new Error("Video submission was not confirmed; do not submit again automatically");
+      return { requestId: payload.request_id };
+    },
+    async readVideo(request) {
+      const selected = credential(request.providerId, request.credentialReference);
+      const payload = await jsonRequest(
+        `videos/${encodeURIComponent(request.requestId)}`,
+        selected.key,
+        undefined,
+        request.signal,
+      );
+      if (payload.status === "pending" || payload.status === "processing")
+        return { status: "pending" };
+      if (payload.status === "failed" || payload.status === "expired")
+        return { status: payload.status };
+      if (payload.status !== "done")
+        throw new Error("Unknown video status; the original request was retained");
+      if (typeof payload.video?.url !== "string")
+        throw new Error("Video result has no download URL; the original request was retained");
+      const url = new URL(payload.video.url);
+      if (
+        url.protocol !== "https:" ||
+        url.hostname !== "vidgen.x.ai" ||
+        url.username ||
+        url.password ||
+        (url.port && url.port !== "443")
+      )
+        throw new Error("Untrusted video download URL");
+      const download = await input.http.request(
+        {
+          url: url.toString(),
+          method: "GET",
+          headers: {},
+          redirect: "manual",
+          timeoutMs: 60_000,
+          maxResponseBytes: 128 * 1024 * 1024,
+        },
+        { signal: request.signal },
+      );
+      const bytes = Buffer.from(download.body);
+      if (download.status !== 200 || bytes.length < 12 || bytes.toString("ascii", 4, 8) !== "ftyp")
+        throw new Error(
+          "Provider did not return a valid MP4; keep the original request for retrieval",
+        );
+      const ticks = payload.usage?.cost_in_usd_ticks;
+      return {
+        status: "done",
+        ...(payload.usage ? { providerUsage: payload.usage } : {}),
+        bytes,
