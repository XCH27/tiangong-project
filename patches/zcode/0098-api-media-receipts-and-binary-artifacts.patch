+        !Array.isArray(payload.usage) &&
+        JSON.stringify(payload.usage).length < 16000
+          ? { providerUsage: payload.usage as Record<string, unknown> }
+          : {}),
+        ...(typeof payload.model === "string" ? { reportedModelId: payload.model } : {}),
+        ...(typeof ticks === "number" && Number.isFinite(ticks) && ticks >= 0
