+/** Exact published Images API models; this is capability evidence, never account entitlement.
+ * Source: https://developers.openai.com/api/reference/resources/images/methods/generate
+ * Retired DALL-E models and future name variants are deliberately absent.
+ */
+const openaiImageModels = new Set([
+  "gpt-image-1",
+  "gpt-image-1-mini",
+  "gpt-image-1.5",
+  "gpt-image-2",
+  "gpt-image-2-2026-04-21",
+  "gpt-image-2.5-sunburst",
+  "gpt-image-2.5-sunburst-2026-09-08",
+  "gpt-image-2.5-flare",
+  "gpt-image-2.5-flare-2026-09-08",
+  "chatgpt-image-latest",
+]);
+
+export function isOfficialOpenaiImageModel(
+  baseUrl: string | null | undefined,
+  modelId: string,
+): boolean {
+  if (!baseUrl || !openaiImageModels.has(modelId)) return false;
+  try {
+    const url = new URL(baseUrl);
+    return (
+      url.origin === "https://api.openai.com" &&
+      url.pathname.replace(/\/+$/, "") === "/v1" &&
+      !url.username &&
+      !url.password &&
+      !url.search &&
+      !url.hash
+    );
+  } catch {
+    return false;
+  }
+}
