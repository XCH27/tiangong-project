+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { NodeToolArtifactStore } from "../../adapters/src/storage/index.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { createMediaGenerationToolEntries } from "../src/tool/handlers/media-generation.js";
+import { persistToolResultMediaAttachments } from "../src/runtime/helpers/tool-result-media-persistence.js";
+import type { MediaGenerationPort } from "@zcode/contracts";
+const mp4 = Buffer.from("000000186674797069736f6d0000020069736f6d69736f32", "hex");
+
+async function setup() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-video-recovery-"));
+  const db = join(root, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath: db });
+  await store.createSession({
+    id: "session" as never,
+    projectID: "project" as never,
+    slug: "fixture",
+    directory: root,
+    title: "fixture",
+    version: "fixture",
+  });
+  const paths = {
+    rootDir: join(root, "artifacts"),
+    imageCacheRootDir: join(root, "images"),
+    videoCacheRootDir: join(root, "videos"),
+  };
+  const context = (signal = new AbortController().signal) =>
+    ({
+      artifactStore: new NodeToolArtifactStore(paths),
+      sessionStore: store,
+      abortSignal: signal,
+      sessionId: "session",
+      toolCallId: "one",
+      turnId: "turn",
+      workspaceRoot: root,
+      traceContext: { traceId: "trace", attributes: { assistantMessageId: "assistant" } },
+    }) as any;
+  return {
+    root,
+    context,
+    get store() {
+      return store;
+    },
+    async reopen() {
+      store.close();
+      store = new SqliteSessionStore({ dbPath: db });
+    },
+    async close() {
+      store.close();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+const request = {
+  providerId: "xai",
+  modelId: "video",
+  prompt: "a garden",
+  duration: 6,
+  binding: "bound",
+  credentialReference: "original-key",
+};
+
+test("stop and reopen retrieve the original video exactly once with native bytes and a light model reference", async () => {
+  const f = await setup();
+  const controller = new AbortController();
+  let submissions = 0;
+  let polls = 0;
+  const port: MediaGenerationPort = {
+    listModels: () => [
+      {
+        providerId: "xai",
+        providerLabel: "xAI",
+        modelId: "video",
+        kind: "video",
+        status: "requires-check",
+      },
+    ],
+    prepareImage: async () => "unused",
+    generateImage: async () => {
+      throw new Error("unused");
+    },
+    prepareVideo: async () => ({ binding: "bound", credentialReference: "original-key" }),
+    submitVideo: async () => {
+      submissions++;
+      controller.abort();
+      return { requestId: "provider-request" };
+    },
+    readVideo: async (input) => {
+      polls++;
+      assert.equal(input.requestId, "provider-request");
+      assert.equal(input.credentialReference, "original-key");
+      return { status: "done", bytes: mp4, mimeType: "video/mp4", reportedCostUsd: 0.2 };
+    },
+  };
+  const tools = createMediaGenerationToolEntries(port);
+  const generate = tools.find((tool) => tool.metadata.name === "GenerateVideo")!;
+  const resume = tools.find((tool) => tool.metadata.name === "ResumeMediaJob")!;
+  try {
+    const pending = (await generate.handler(request, f.context(controller.signal))) as any;
+    assert.equal(pending.status, "pending");
+    assert.equal(polls, 0);
+    await f.reopen();
+    const result = (await resume.handler(
+      { receiptUri: pending.receiptUri, waitSeconds: 0 },
+      f.context(),
+    )) as any;
+    assert.equal(result.status, "completed");
+    assert.equal(submissions, 1);
+    assert.equal(polls, 1);
+    const bytes = await f
+      .context()
+      .artifactStore.readToolResultBinaryArtifact({ uri: result.artifactUri });
+    assert.deepEqual(Buffer.from(bytes.bytes), mp4);
+    assert.equal(bytes.contentType, "video/mp4");
+    const content = resume.formatModelContent!(result);
+    assert.equal(JSON.stringify(content).includes(mp4.toString("base64")), false);
+    const persisted = await persistToolResultMediaAttachments({
+      ...f.context(),
+      assistantMessageId: "assistant",
+      content,
+      signal: undefined,
+      toolName: "ResumeMediaJob",
+    } as never);
+    assert.equal(persisted?.attachments[0]?.mime, "video/mp4");
+    assert.ok(persisted?.modelContentLayout.every((entry) => entry.type === "text"));
+    const again = (await resume.handler(
+      { receiptUri: pending.receiptUri, waitSeconds: 0 },
+      f.context(),
+    )) as any;
+    assert.equal(again.artifactUri, result.artifactUri);
+    assert.equal(polls, 1);
+    assert.equal(submissions, 1);
+    const ledger = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+    assert.equal(ledger.accounting?.[0]?.requestCount, 1);
+    assert.equal(ledger.accounting?.[0]?.estimatedUsd, 0.2);
+  } finally {
+    await f.close();
+  }
+});
+
+test("an unconfirmed submission survives reopen and cannot be paid for again by tool replay", async () => {
+  const f = await setup();
+  let submissions = 0;
+  const port: MediaGenerationPort = {
+    listModels: () => [],
+    prepareImage: async () => "unused",
+    generateImage: async () => {
+      throw new Error("unused");
+    },
+    submitVideo: async () => {
+      submissions++;
+      throw new Error("connection closed before receipt");
+    },
+    readVideo: async () => {
+      throw new Error("No request ID to query");
+    },
+  };
+  const generate = createMediaGenerationToolEntries(port).find(
+    (tool) => tool.metadata.name === "GenerateVideo",
+  )!;
+  try {
+    const unknown = (await generate.handler(request, f.context())) as any;
+    assert.equal(unknown.status, "unknown");
+    await f.reopen();
+    const replay = (await generate.handler(request, f.context())) as any;
+    assert.equal(replay.status, "unknown");
+    assert.equal(submissions, 1);
+    const rows = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+    assert.equal(rows.accounting?.[0]?.requestCount, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("receipt lookup and image references cannot cross conversation scope", async () => {
+  const f = await setup();
+  const port: MediaGenerationPort = {
+    listModels: () => [],
+    prepareImage: async () => "unused",
+    generateImage: async () => {
+      throw new Error("unused");
+    },
+  };
+  try {
+    const resume = createMediaGenerationToolEntries(port).find(
+      (tool) => tool.metadata.name === "ResumeMediaJob",
+    )!;
+    await assert.rejects(
+      resume.handler(
