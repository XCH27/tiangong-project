+  const f = fixture(); const tooLarge = new Uint8Array(9 * 1024 * 1024);
+  await assert.rejects(f.port.prepareImage({ providerId: "connection", modelId: f.modelId, prompt: "too large", images: Array.from({ length: 3 }, () => ({ mediaType: "image/png", bytes: tooLarge })) }), /24 MiB/);
