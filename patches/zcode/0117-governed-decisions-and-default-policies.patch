diff --git a/apps/zcode-cli/packages/core/src/tool/handlers/decide.ts b/apps/zcode-cli/packages/core/src/tool/handlers/decide.ts
new file mode 100644
index 0000000..838184f
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/handlers/decide.ts
@@ -0,0 +1,212 @@
+import { z } from "zod";
+import { decisionInputSchema } from "@zcode/shared";
+import type { DecisionModelPort, DecisionModelResult, UsageStorePort } from "@zcode/contracts";
+import type { ToolEntry } from "../types.js";
+import { toolUsageId } from "../../runtime/usage-identity.js";
+
+const executionSchema = decisionInputSchema.safeExtend({
+  binding: z.string().uuid(),
+  model: z.object({ providerId: z.string(), modelId: z.string() }).strict(),
+  inputDigest: z.string().regex(/^[a-f0-9]{64}$/),
+});
+const outputSchema = z.object({
+  status: z.enum(["completed", "error", "cancelled", "stale"]),
+  requestedModel: z.object({ providerId: z.string(), modelId: z.string() }).strict(),
+  reportedModelId: z.string().optional(),
+  inputDigest: z.string(),
+  answers: z.record(z.string(), z.unknown()),
+  message: z.string().optional(),
+  usage: z
+    .object({ inputTokens: z.number().optional(), outputTokens: z.number().optional() })
+    .optional(),
+  reportedCostUsd: z.number().optional(),
+  billingProvider: z.string().optional(),
+  receiptUri: z.string(),
+  usageRecorded: z.boolean(),
+});
+
+/** Explicit, separately approved inference; normal tool receipts and the existing usage ledger remain owners. */
+export function createDecisionModelTool(port: DecisionModelPort): ToolEntry {
+  return {
+    deferLoading: true,
+    capability:
+      "Answer bounded classification, scoring and yes/no questions with the configured auxiliary decision model",
+    metadata: {
+      name: "Decide",
+      description:
+        "Ask the configured decision model typed questions about a SMALL evidence excerpt. This is a separate model request, may cost money and sends evidence to that configured connection. Never send credentials or the whole conversation. Results are advisory probabilities, not permission or profit predictions. Unknown, failed or stale answers must remain unknown.",
+      readOnly: false,
+      destructive: false,
+      concurrentSafe: false,
+      needsApproval: true,
+      sideEffectScope: "network",
+      riskLevel: "medium",
+      timeoutMs: 15000,
+      maxOutputBytes: 32000,
+    },
+    inputSchema: z.toJSONSchema(decisionInputSchema, {
+      unrepresentable: "any",
+    }) as unknown as ToolEntry["inputSchema"],
+    outputSchema: z.toJSONSchema(outputSchema, {
+      unrepresentable: "any",
+    }) as unknown as ToolEntry["inputSchema"],
+    runtimeInputSchema: decisionInputSchema,
+    runtimeOutputSchema: outputSchema,
+    async resolveInput(input, context) {
+      try {
+        const parsed = decisionInputSchema.parse(input);
+        return {
+          result: true,
+          input: { ...parsed, ...(await port.prepare(parsed, context.abortSignal)) },
+        };
+      } catch {
+        return {
+          result: false,
+          errorCode: 4110,
+          message:
+            "Decision model is disabled, unavailable or the evidence is too large; check its configuration",
+        };
+      }
+    },
+    async handler(input, context) {
+      const request = executionSchema.parse(input);
+      const artifacts = context.artifactStore;
+      const usage = context.sessionStore as Partial<UsageStorePort> | undefined;
+      if (!artifacts?.writeToolResultArtifactOnce || !usage?.recordModelUsage)
+        throw new Error(
+          "Decision receipt/accounting storage is unavailable; no inference was made",
+        );
+      const assistant = context.traceContext?.attributes?.assistantMessageId;
+      const id = `decision:${toolUsageId(context.sessionId, context.toolCallId, context.turnId, typeof assistant === "string" ? assistant : context.parentSpanId)}`;
+      const startedAt = Date.now();
+      const claim = await artifacts.writeToolResultArtifactOnce({
+        sessionId: context.sessionId,
+        toolCallId: context.toolCallId,
+        toolName: "DecisionReceipt",
+        idempotencyKey: `${id}:intent`,
+        content: JSON.stringify({
+          version: 1,
+          status: "unknown",
+          id,
+          model: request.model,
+          inputDigest: request.inputDigest,
+          startedAt,
+        }),
+        contentType: "application/json",
+        retention: "session",
+        trace: context.traceContext,
+      });
+      if (!claim.created)
+        throw new Error(
+          `Decision inference may already exist. Receipt ${claim.uri}; do not repeat it automatically`,
+        );
+      let result: DecisionModelResult;
+      try {
+        result = await port.classify({
+          state: request.state,
+          questions: request.questions,
+          binding: request.binding,
+          signal: context.abortSignal,
+          admission: context.modelRequestAdmission,
+          trace: context.traceContext,
+        });
+      } catch {
+        result = {
+          status: context.abortSignal.aborted ? "cancelled" : "error",
+          requestedModel: request.model,
+          inputDigest: request.inputDigest,
+          answers: {},
+          message: "Decision binding is unavailable; no replacement model was used",
+        };
+      }
+      const completedAt = Date.now();
+      // A provider charge survives local save/cancellation failures. The same ledger owns it.
+      let usageRecorded = true;
+      try {
+        await usage.recordModelUsage({
+          id,
+          logicalRequestId: id,
+          sessionID: context.sessionId,
+          turnID: context.turnId,
+          traceID: context.traceId,
+          querySource: "decision_classification",
+          providerId: result.requestedModel.providerId,
+          modelId: result.requestedModel.modelId,
+          startedAt,
+          completedAt,
+          status:
+            result.status === "completed"
+              ? "completed"
+              : result.status === "cancelled"
+                ? "cancelled"
+                : "error",
+          inputTokens: result.usage?.inputTokens,
+          outputTokens: result.usage?.outputTokens,
+          rawUsage: result.usage,
+          errorMessage: result.message,
+          providerMetadata: {
+            operation: "classifier",
+            reportedModelId: result.reportedModelId,
+            inputDigest: result.inputDigest,
+            fleetAccounting: {
+              billingProvider: result.billingProvider,
+              authKind: "api-key",
+              workspacePath: context.workspaceRoot,
+              reportedRequestUsd: result.reportedCostUsd,
+            },
+          },
+        });
+      } catch {
+        usageRecorded = false;
+      }
+      const receipt = await artifacts.writeToolResultArtifactOnce({
+        sessionId: context.sessionId,
+        toolCallId: context.toolCallId,
+        toolName: "DecisionReceipt",
+        idempotencyKey: `${id}:result`,
+        content: JSON.stringify({
+          version: 1,
+          id,
+          startedAt,
+          completedAt,
+          ...result,
+          usageRecorded,
+        }),
+        contentType: "application/json",
+        retention: "session",
+        trace: context.traceContext,
+      });
+      return outputSchema.parse({ ...result, usageRecorded, receiptUri: receipt.uri });
+    },
+    permission: {
+      permission: "model.decide",
+      alwaysAsk: true,
+      reason:
+        "Send this evidence excerpt to the configured auxiliary model for one billed decision request",
+      needsApproval: true,
+      riskLevel: "medium",
+      sideEffectScope: "network",
+      patternSources: ["toolName"],
+      alwaysAllowPatternSources: [],
+      denyPriority: "beforeAsk",
+    },
+    resultBudget: {
+      maxInlineBytes: 32000,
+      maxModelBytes: 32000,
+      strategy: "truncate",
+      preview: { maxBytes: 32000, direction: "head" },
+    },
+    timeout: { kind: "timed", defaultMs: 15000, maxMs: 15000, allowCallOverride: false },
+    cancellation: {
+      supported: true,
+      cleanup: "none",
+      userVisibleMessage: "Cancelling auxiliary decision inference",
+    },
+    trace: {
+      required: true,
+      propagateToAdapters: true,
+      recordInput: "summary",
+      recordOutput: "summary",
+    },
+  };
+}
