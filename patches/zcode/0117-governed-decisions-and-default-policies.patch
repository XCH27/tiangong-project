+test("Stop cancels the real HTTP adapter and releases admission without another request", async () => {
+  const f = await fixture();
+  try {
+    await f.save(true);
+    const received = Promise.withResolvers<void>();
+    f.setReply(async () => {
+      received.resolve();
+      return await new Promise(() => {});
+    });
+    const b = await f.port.prepare(request);
+    const controller = new AbortController();
+    let released = false;
+    const pending = f.port.classify({
+      ...request,
+      ...b,
+      signal: controller.signal,
+      admission: {
+        async acquire() {
+          return {
+            release() {
+              released = true;
+            },
+            publish() {},
+          };
+        },
+      } as any,
+    });
+    await received.promise;
+    controller.abort();
+    const result = await pending;
+    assert.equal(result.status, "cancelled");
+    assert.equal(released, true);
+    assert.equal(f.calls.length, 1);
+  } finally {
+    await f.close();
+  }
+});
