diff --git a/apps/zcode-cli/packages/core/test/decision-tool.test.ts b/apps/zcode-cli/packages/core/test/decision-tool.test.ts
new file mode 100644
index 0000000..d962caa
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/decision-tool.test.ts
@@ -0,0 +1,206 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { DecisionModelPort } from "@zcode/contracts";
+import { NodeToolArtifactStore } from "../../adapters/src/storage/index.js";
+import { SqliteSessionStore } from "../../adapters/src/storage/session-store/sqlite-session-store.js";
+import { createDecisionModelTool } from "../src/tool/handlers/decide.js";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+const evidence = {
+  state: "Synthetic evidence",
+  questions: {
+    usable: {
+      type: "bool" as const,
+      instructions: "Is it useful?",
+      criteria: { true: "Useful", false: "Unrelated" },
+    },
+  },
+};
+function modelPort() {
+  let available = true;
+  let calls = 0;
+  const port: DecisionModelPort = {
+    isAvailable: () => available,
+    listModels: () => [],
+    prepare: async () => ({
+      binding: randomUUID(),
+      model: { providerId: "decision", modelId: "classifier" },
+      inputDigest: "a".repeat(64),
+    }),
+    async classify() {
+      calls++;
+      return {
+        status: "completed",
+        requestedModel: { providerId: "decision", modelId: "classifier" },
+        inputDigest: "a".repeat(64),
+        reportedModelId: "served",
+        answers: { usable: { type: "bool", probability: 0.8 } },
+        usage: { inputTokens: 37, outputTokens: 0 },
+        reportedCostUsd: 0.005,
+      };
+    },
+  };
+  return {
+    port,
+    get calls() {
+      return calls;
+    },
+    setAvailable(value: boolean) {
+      available = value;
+    },
+  };
+}
+test("off means absent from the model's tool context; explicit discovery uses the existing confirmation owner", async () => {
+  const p = modelPort();
+  p.setAvailable(false);
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: ["SearchTools", "Decide"] },
+    deps: { decisionModelPort: p.port },
+  });
+  try {
+    assert.equal(
+      f.runtime.getTools().some((tool) => tool.name === "Decide"),
+      false,
+    );
+    p.setAvailable(true);
+    assert.ok(f.runtime.getTools().some((tool) => tool.name === "Decide"));
+    f.steps.push(
+      () =>
+        reply("find", [
+          { id: "lookup", name: "SearchTools", input: { query: "decision classify" } },
+        ]),
+      () => reply("judge", [{ id: "decision", name: "Decide", input: evidence }]),
+      () => reply("done"),
+    );
+    await f.runtime.executeTurn("Classify synthetic evidence");
+    assert.equal(p.calls, 1);
+    assert.equal(f.permissionCalls, 1);
+    const used = await f.store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+    assert.ok(
+      used.accounting?.some((row) => row.modelId === "classifier" && row.estimatedUsd === 0.005),
+    );
+    const contextUsage = await f.store.queryTaskUsage({ sessionID: "session" as never });
+    assert.equal(
+      contextUsage.lastRequest?.modelId,
+      "model-a",
+      "The classifier replaced the main model context/account source",
+    );
+    await f.reopen();
+    assert.equal(p.calls, 1);
+  } finally {
+    await f.close();
+  }
+});
+test("declining the separate decision request never reaches inference or billing", async () => {
+  const p = modelPort();
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: ["Decide"] },
+    deps: { decisionModelPort: p.port },
+  });
+  try {
+    f.deny();
+    f.steps.push(
+      () => reply("judge", [{ id: "decision", name: "Decide", input: evidence }]),
+      () => reply("declined"),
+    );
+    await f.runtime.executeTurn("Synthetic decision");
+    assert.equal(p.calls, 0);
+    assert.equal(f.permissionCalls, 1);
+  } finally {
+    await f.close();
+  }
+});
+test("durable intent prevents duplicate charges on replay; separately identified requests survive SQLite reopen", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-decision-receipts-"));
+  const path = join(root, "sessions.sqlite");
+  let store = new SqliteSessionStore({ dbPath: path });
+  const artifacts = new NodeToolArtifactStore({
+    rootDir: join(root, "artifacts"),
+    imageCacheRootDir: join(root, "images"),
+    videoCacheRootDir: join(root, "videos"),
+  });
+  const p = modelPort();
+  const tool = createDecisionModelTool(p.port);
+  const ctx = {
+    sessionId: "session",
+    toolCallId: "decision",
+    turnId: "turn",
+    traceId: "trace",
+    traceContext: { traceId: "trace", attributes: { assistantMessageId: "assistant" } },
+    abortSignal: new AbortController().signal,
+    workspaceRoot: root,
+    artifactStore: artifacts,
+    sessionStore: store,
+  } as any;
+  try {
+    await store.createSession({
+      id: "session" as never,
+      projectID: "project" as never,
+      slug: "fixture",
+      directory: root,
+      title: "fixture",
+      version: "fixture",
+    });
+    const resolved = await tool.resolveInput!(evidence, {} as never);
+    assert.equal(resolved.result, true);
+    const prepared = (resolved as { input: unknown }).input;
+    const result = (await tool.handler(prepared, ctx)) as any;
+    assert.equal(result.usageRecorded, true);
+    assert.ok(result.receiptUri);
+    await assert.rejects(tool.handler(prepared, ctx), /already exist/);
+    assert.equal(p.calls, 1);
+    store.close();
+    store = new SqliteSessionStore({ dbPath: path });
+    ctx.sessionStore = store;
+    await assert.rejects(tool.handler(prepared, ctx), /already exist/);
+    assert.equal(p.calls, 1);
+    await tool.handler(((await tool.resolveInput!(evidence, {} as never)) as any).input, {
+      ...ctx,
+      traceContext: { traceId: "trace", attributes: { assistantMessageId: "next-assistant" } },
+    });
+    const used = await store.queryAppUsage({ since: 0, until: Date.now() + 1, tzOffsetMs: 0 });
+    const row = used.accounting?.find((row) => row.modelId === "classifier");
+    assert.equal(p.calls, 2);
+    assert.equal(row?.requestCount, 2);
+    assert.equal(row?.estimatedUsd, 0.01);
+  } finally {
+    store.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+test("local result-save failure retains the provider charge; ledger failure is visible in its receipt", async () => {
+  for (const fault of ["result", "ledger"] as const) {
+    const p = modelPort();
+    const tool = createDecisionModelTool(p.port);
+    const records: any[] = [];
+    let writes = 0;
+    const context = {
+      abortSignal: new AbortController().signal,
+      sessionId: "s",
+      toolCallId: "t",
+      artifactStore: {
+        async writeToolResultArtifactOnce(input: any) {
+          writes++;
+          if (fault === "result" && writes === 2) throw new Error("save failure");
+          return { uri: `artifact://${writes}`, created: true };
+        },
+      },
+      sessionStore: {
+        async recordModelUsage(record: any) {
+          records.push(record);
+          if (fault === "ledger") throw new Error("ledger failure");
+        },
+      },
+    } as any;
+    const prepared = ((await tool.resolveInput!(evidence, {} as never)) as any).input;
+    if (fault === "result") await assert.rejects(tool.handler(prepared, context), /save failure/);
+    else assert.equal(((await tool.handler(prepared, context)) as any).usageRecorded, false);
+    assert.equal(p.calls, 1);
+    assert.equal(records.length, 1);
+    assert.equal(records[0]?.providerMetadata?.fleetAccounting?.reportedRequestUsd, 0.005);
+  }
+});
