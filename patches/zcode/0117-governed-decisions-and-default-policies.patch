+import { createHash, randomUUID } from "node:crypto";
+import { classify } from "@earendil-works/pi-ai/api/typesafe-system-one";
+import type { ClassifierContext, ClassifierModel } from "@earendil-works/pi-ai";
+import {
+  classifierModels,
+  getEnabledApiKeys,
+  isLocalClassifierEndpoint,
+  type ProviderRegistryServiceSnapshot,
+} from "@zcode/provider";
+import { decisionInputSchema, type DecisionInput } from "@zcode/shared";
+import {
+  createRootTraceContext,
+  createModelId,
+  createModelProviderId,
+  type DecisionModelPort,
+  type DecisionModelResult,
+  type HttpClientPort,
+  type ModelRequestAdmissionTicket,
+} from "@zcode/contracts";
+
+const digest = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+const count = (value: unknown) =>
+  typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+
+function reportedFacts(wire?: Record<string, any>) {
+  const usage =
+    wire?.usage && typeof wire.usage === "object"
+      ? {
+          ...(count(wire.usage.input_tokens) === undefined
+            ? {}
+            : { inputTokens: count(wire.usage.input_tokens) }),
+          ...(count(wire.usage.output_tokens) === undefined
+            ? {}
+            : { outputTokens: count(wire.usage.output_tokens) }),
+        }
+      : undefined;
+  const model =
+    typeof wire?.model === "string" && wire.model.length <= 256 ? wire.model : undefined;
+  const cost =
+    typeof wire?.usage?.cost === "number" &&
+    Number.isFinite(wire.usage.cost) &&
+    wire.usage.cost >= 0
+      ? wire.usage.cost
+      : undefined;
+  return {
+    ...(usage && Object.keys(usage).length ? { usage } : {}),
+    ...(model ? { reportedModelId: model } : {}),
+    ...(cost === undefined ? {} : { reportedCostUsd: cost }),
+  };
+}
+
+export function createDecisionModelPort(input: {
+  registry: {
+    getSnapshot(): ProviderRegistryServiceSnapshot | null;
+    refresh?(reason: string): Promise<unknown>;
+  };
+  http: Pick<HttpClientPort, "request">;
+}): DecisionModelPort {
+  const pending = new Map<string, { at: number; fingerprint: string; requestDigest: string }>();
+  const resolve = () => {
+    if (!input.registry.refresh) throw new Error("Decision configuration refresh is unavailable");
+    const snapshot = input.registry.getSnapshot();
+    const settings = snapshot?.config.decisionModelSettings;
+    const selected = settings?.selection;
+    const member = classifierModels(snapshot).find(
+      (model) => model.providerId === selected?.providerId && model.modelId === selected?.modelId,
+    );
+    if (!settings?.enabled || !selected || !member || !snapshot)
+      throw new Error("Decision model is disabled or unavailable");
+    const provider = snapshot.resolution.resolvedProviders.find(
+      (provider) => provider.providerId === selected.providerId,
+    )!;
+    const api = provider.config.api!;
+    const access = provider.config.access;
+    if (access?.type !== "api-key")
+      throw new Error("This decision credential route is unsupported");
+    const key = getEnabledApiKeys(access)[0];
+    const local = api.type === "typesafe-system-one" && isLocalClassifierEndpoint(api.baseUrl);
+    if (!key && !local) throw new Error("The decision credential is unavailable");
+    const base = new URL(api.baseUrl!);
+    if (
+      !["http:", "https:"].includes(base.protocol) ||
+      base.username ||
+      base.password ||
+      base.search ||
+      base.hash
+    )
+      throw new Error("Invalid decision endpoint");
+    const headers = Object.fromEntries(
+      Object.entries(api.headers ?? {}).filter(
+        ([name]) => !["authorization", "content-type", "accept"].includes(name.toLowerCase()),
+      ),
+    );
+    // Bind this operation's actual route/evidence. Another page's preference edit is not a revocation.
+    const fingerprint = digest([
+      settings,
+      api.toJSON(),
+      key ?? null,
+      provider.models.find((model) => model.modelId === selected.modelId)?.config.toJSON(),
+      provider.models.find((model) => model.modelId === selected.modelId)?.evidenceConfig.toJSON(),
+    ]);
+    return {
+      selected,
+      member,
+      baseUrl: base.href.replace(/\/+$/, ""),
+      headers,
+      key,
+      local,
+      fingerprint,
+    };
+  };
+  const fresh = async (signal?: AbortSignal) => {
+    signal?.throwIfAborted();
+    if (!signal) await input.registry.refresh?.("decision-binding");
+    else
+      await new Promise<void>((resolve, reject) => {
+        const abort = () => reject(signal.reason);
+        signal.addEventListener("abort", abort, { once: true });
+        Promise.resolve()
+          .then(() => {
+            signal.throwIfAborted();
+            return input.registry.refresh?.("decision-binding");
+          })
+          .then(() => resolve(), reject)
+          .finally(() => signal.removeEventListener("abort", abort));
+      });
+    signal?.throwIfAborted();
+    return resolve();
+  };
+
+  return {
+    listModels: () => classifierModels(input.registry.getSnapshot()),
+    isAvailable() {
+      try {
+        resolve();
+        return true;
+      } catch {
+        return false;
+      }
+    },
+    async prepare(value, callerSignal) {
+      const request = decisionInputSchema.parse(value);
+      const signal = AbortSignal.any([
+        AbortSignal.timeout(10000),
+        ...(callerSignal ? [callerSignal] : []),
+      ]);
+      const current = await fresh(signal);
+      const now = Date.now();
+      for (const [key, binding] of pending) if (now - binding.at > 300000) pending.delete(key);
+      if (pending.size >= 64) pending.delete(pending.keys().next().value!);
+      const binding = randomUUID();
+      const inputDigest = digest(request);
+      pending.set(binding, {
+        at: now,
+        fingerprint: current.fingerprint,
+        requestDigest: inputDigest,
+      });
+      return { binding, model: { ...current.selected }, inputDigest };
+    },
+    async classify(value) {
+      const request = decisionInputSchema.parse({ state: value.state, questions: value.questions });
+      const binding = pending.get(value.binding);
+      pending.delete(value.binding);
+      if (!binding || Date.now() - binding.at > 300000 || binding.requestDigest !== digest(request))
+        throw new Error("Decision request binding expired or changed; no request was made");
+      const signal = AbortSignal.any([value.signal, AbortSignal.timeout(10000)]);
+      signal.throwIfAborted();
+      let current = await fresh(signal);
+      if (current.fingerprint !== binding.fingerprint)
+        throw new Error("Decision configuration changed; no request was made");
+      const trace = value.trace ?? createRootTraceContext();
+      const startedAt = Date.now();
+      const statusBase = {
+        timestamp: new Date().toISOString(),
+        traceId: trace.traceId,
+        sessionId: trace.sessionId,
+        turnId: trace.turnId,
+        requestId: value.binding,
+        providerId: createModelProviderId(current.selected.providerId),
+        modelId: createModelId(current.selected.modelId),
+        querySource: "decision_classification",
+        transport: "http" as const,
+        attempt: 1,
+        maxAttempts: 1,
+      };
+      let ticket: ModelRequestAdmissionTicket | undefined;
+      let wire: Record<string, any> | undefined;
+      let httpStatus: number | undefined;
+      const resultBase = {
+        requestedModel: { ...current.selected },
+        inputDigest: binding.requestDigest,
+        billingProvider: new URL(current.baseUrl).hostname,
+      };
+      try {
+        ticket =
+          value.admission?.tryAcquire?.({ model: current.selected }) ??
+          (await value.admission?.acquire({ model: current.selected, signal }));
+        signal.throwIfAborted();
+        current = await fresh(signal);
+        if (current.fingerprint !== binding.fingerprint)
+          throw new Error("Decision configuration changed during admission");
+        await ticket?.publish({ ...statusBase, type: "model_request_started" });
+        const model: ClassifierModel<"typesafe-system-one"> = {
+          type: "classifier",
+          id: current.selected.modelId,
+          name: current.selected.modelId,
+          provider: "typesafe",
+          api: "typesafe-system-one",
+          baseUrl: current.baseUrl,
+          input: ["text"],
+          contextWindow: current.member.contextWindow ?? 0,
+          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+        };
+        const response = await classify(
+          model,
+          {
+            state: typeof request.state === "string" ? { text: request.state } : request.state,
+            questions: request.questions,
+          } as ClassifierContext,
+          {
+            apiKey: current.key ?? "local",
+            headers: { ...current.headers, ...(current.key ? {} : { authorization: null }) },
+            signal,
+            timeoutMs: 10000,
+            maxRetries: 0,
+            fetch: async (url, init) => {
+              signal.throwIfAborted();
+              const latest = await fresh(signal);
+              if (latest.fingerprint !== binding.fingerprint)
+                throw new Error("Decision route changed before dispatch");
+              const http = await input.http.request(
+                {
+                  url: String(url),
+                  method: "POST",
+                  headers: Object.fromEntries(new Headers(init?.headers)),
+                  body: Buffer.from(String(init?.body)),
+                  redirect: "manual",
+                  timeoutMs: 10000,
+                  maxResponseBytes: 1024 * 1024,
+                  trace,
+                },
+                { signal },
+              );
+              httpStatus = http.status;
+              if (http.status >= 200 && http.status < 300) {
+                const raw = JSON.parse(Buffer.from(http.body).toString("utf8"));
+                if (raw && typeof raw === "object" && !Array.isArray(raw)) wire = raw;
+              }
+              return new Response(Buffer.from(http.body), {
+                status: http.status,
+                headers: http.headers,
+              });
+            },
+          },
+        );
+        const base = { ...resultBase, ...reportedFacts(wire) };
+        const incomplete =
+          wire?.usage?.truncated === true ||
+          (typeof wire?.usage?.truncated === "number" && wire.usage.truncated > 0) ||
+          wire?.usage?.state_tokens_dropped > 0 ||
+          (wire?.usage?.options &&
+            typeof wire.usage.options === "object" &&
+            Object.keys(wire.usage.options).length > 0) ||
+          (Array.isArray(wire?.usage?.truncated_questions) &&
+            wire.usage.truncated_questions.length > 0);
+        let status: DecisionModelResult["status"] = signal.aborted
+          ? "cancelled"
+          : response.stopReason !== "stop" || incomplete
+            ? "error"
+            : "completed";
+        try {
+          if ((await fresh(signal)).fingerprint !== binding.fingerprint) status = "stale";
+        } catch {
+          status = signal.aborted ? "cancelled" : "stale";
+        }
+        await ticket?.publish(
+          status === "completed"
+            ? {
+                ...statusBase,
+                type: "model_request_completed",
+                durationMs: Date.now() - startedAt,
+                finishReason: "classified",
+              }
+            : {
+                ...statusBase,
+                type: "model_request_failed",
+                durationMs: Date.now() - startedAt,
+                reason: status === "cancelled" ? "cancelled" : "unknown",
+                retryable: false,
+                message: "Decision request did not produce a current, complete answer",
+              },
+        );
+        return {
+          ...base,
+          status,
+          answers: status === "completed" ? response.answers : {},
+          ...(status === "completed"
+            ? {}
+            : {
+                message: incomplete
+                  ? "Evidence was truncated; the decision is unavailable"
+                  : `Decision request unavailable${httpStatus ? ` (HTTP ${httpStatus})` : ""}`,
+              }),
+        };
+      } catch {
+        try {
+          await ticket?.publish({
+            ...statusBase,
+            type: "model_request_failed",
+            durationMs: Date.now() - startedAt,
+            reason: signal.aborted ? "cancelled" : "unknown",
+            retryable: false,
+            message: "Decision request failed or changed",
+          });
+        } catch {
+          /* Keep observed usage even if the observer is unavailable. */
+        }
+        return {
+          ...resultBase,
+          ...reportedFacts(wire),
+          status: signal.aborted ? "cancelled" : "error",
+          answers: {},
+          message: "Decision request failed or its scope changed",
+        };
+      } finally {
+        ticket?.release();
+      }
+    },
+  };
+}
