diff --git a/packages/shared/src/decision-model.ts b/packages/shared/src/decision-model.ts
new file mode 100644
index 0000000..5152ee8
--- /dev/null
+++ b/packages/shared/src/decision-model.ts
@@ -0,0 +1,75 @@
+import { z } from "zod";
+
+export const decisionModelRefSchema = z
+  .object({
+    providerId: z.string().trim().min(1).max(256),
+    modelId: z.string().trim().min(1).max(256),
+  })
+  .strict();
+export const decisionModelSettingsSchema = z
+  .object({
+    enabled: z.boolean(),
+    selection: decisionModelRefSchema.optional(),
+  })
+  .strict()
+  .superRefine((value, context) => {
+    if (value.enabled && !value.selection)
+      context.addIssue({
+        code: "custom",
+        path: ["selection"],
+        message: "Select a decision model before enabling it",
+      });
+  });
+export type DecisionModelRef = z.infer<typeof decisionModelRefSchema>;
+export type DecisionModelSettings = z.infer<typeof decisionModelSettingsSchema>;
+export interface DecisionModelCandidate extends DecisionModelRef {
+  providerName: string;
+  contextWindow?: number;
+}
+const instructions = z.string().trim().min(1).max(1500);
+const description = z.string().max(500);
+export const decisionQuestionSchema = z.discriminatedUnion("type", [
+  z
+    .object({
+      type: z.literal("choice"),
+      instructions,
+      criteria: z
+        .record(z.string().min(1).max(100), description)
+        .refine(
+          (criteria) => Object.keys(criteria).length >= 2 && Object.keys(criteria).length <= 32,
+        ),
+    })
+    .strict(),
+  z
+    .object({
+      type: z.literal("score"),
+      instructions,
+      criteria: z.array(description.min(1)).min(2).max(10),
+    })
+    .strict(),
+  z
+    .object({
+      type: z.literal("bool"),
+      instructions,
+      criteria: z.object({ true: description, false: description }).strict(),
+    })
+    .strict(),
+]);
+export const decisionInputSchema = z
+  .object({
+    state: z.union([z.string().min(1).max(8192), z.record(z.string(), z.json())]),
+    questions: z
+      .record(z.string().min(1).max(100), decisionQuestionSchema)
+      .refine(
+        (questions) => Object.keys(questions).length >= 1 && Object.keys(questions).length <= 16,
+      ),
+  })
+  .strict()
+  .superRefine((value, context) => {
+    if (new TextEncoder().encode(JSON.stringify(value)).byteLength > 8192)
+      context.addIssue({
+        code: "custom",
+        message: "Decision input exceeds the 8 KiB limit; choose a smaller evidence excerpt",
+      });
+  });
+export type DecisionInput = z.infer<typeof decisionInputSchema>;
