+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseModelConfig, parseProviderConfig, classifierModels } from "@zcode/provider";
+import {
+  NodeProviderRegistryRuntime,
+  NodeModelSelectionConfigRepository,
+  createNodeModelSelectionFacade,
+} from "../../../../../packages/provider-node/src/index.js";
+import { createModelSelectionService } from "../../../../../packages/services/src/model-provider/modelSelectionService.js";
+import { createDecisionModelPort } from "../src/model/decision-model.js";
+import { NodeHttpClientAdapter } from "../src/http/index.js";
+import { decisionInputSchema } from "@zcode/shared";
+
+const request = {
+  state: "Synthetic evidence in English / 中文测试，不含用户数据",
+  questions: {
+    kind: {
+      type: "choice" as const,
+      instructions: "Choose a category",
+      criteria: { useful: "Useful", other: "Other" },
+    },
+  },
+};
+const response = () => ({
+  model: "actually-served-classifier",
+  answers: {
+    kind: {
+      type: "choice",
+      choice: "useful",
+      probabilities: { useful: 0.8, other: 0.2 },
+      confidence: 0.6,
+    },
+  },
+  usage: { input_tokens: 123, output_tokens: 0, cost: 0.002 },
+});
+async function fixture(key = "synthetic-only") {
+  const root = await mkdtemp(join(tmpdir(), "fleet-decisions-"));
+  const calls: { body: any; authorization?: string }[] = [];
+  let reply: (body: any) => unknown | Promise<unknown> = response;
+  let status = 200;
+  const server = createServer(async (req, res) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) chunks.push(Buffer.from(chunk));
+    const body = JSON.parse(Buffer.concat(chunks).toString());
+    calls.push({ body, authorization: req.headers.authorization });
+    const result = await reply(body);
+    res.writeHead(status, { "content-type": "application/json" });
+    res.end(JSON.stringify(result));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address !== "string");
+  const url = `http://127.0.0.1:${address.port}/v1`;
+  const options = {
+    personalFilePath: join(root, "personal.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let runtime = new NodeProviderRegistryRuntime(options);
+  await runtime.start();
+  const { providerId } = await runtime.configService.createPersonalProvider({
+    initialConfig: parseProviderConfig({
+      api: { type: "typesafe-system-one", baseUrl: url },
+      access: { type: "api-key", apiKey: key },
+    }),
+    providerName: "Decision fixture",
+  });
+  await runtime.configService.addPersonalModel(
+    providerId,
+    "fixture-decision",
+    parseModelConfig({}),
+    undefined,
+    true,
+  );
+  await runtime.registryService.refresh();
+  const service = () =>
+    createModelSelectionService(
+      createNodeModelSelectionFacade(runtime.registryService),
+      async () => {},
+      new NodeModelSelectionConfigRepository({ personalRepository: runtime.personalRepository }),
+      async () => {
+        await runtime.registryService.refresh();
+      },
+    );
+  const port = createDecisionModelPort({
+    registry: {
+      getSnapshot: () => runtime.registryService.getSnapshot(),
+      refresh: (reason) => runtime.registryService.refresh(reason),
+    },
+    http: new NodeHttpClientAdapter({ env: {}, noProxy: "*" }),
+  });
+  const save = async (enabled: boolean) => {
+    const s = service();
+    try {
+      const view = await s.getView();
+      await s.savePreferences({
+        expectedRevision: view.preferencesRevision,
+        decisionModelSettings: { enabled, selection: { providerId, modelId: "fixture-decision" } },
+      });
+    } finally {
+      s.dispose();
+    }
+  };
+  return {
+    root,
+    providerId,
+    port,
+    calls,
+    url,
+    get runtime() {
+      return runtime;
+    },
+    service,
+    save,
+    setReply(value: typeof reply, code = 200) {
+      reply = value;
+      status = code;
+    },
+    async reopen() {
+      runtime.dispose();
+      runtime = new NodeProviderRegistryRuntime(options);
+      await runtime.start();
+    },
+    async close() {
+      runtime.dispose();
+      server.closeAllConnections();
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
