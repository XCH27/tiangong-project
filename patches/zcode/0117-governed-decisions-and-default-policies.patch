diff --git a/packages/provider/src/classifier-models.ts b/packages/provider/src/classifier-models.ts
new file mode 100644
index 0000000..5821442
--- /dev/null
+++ b/packages/provider/src/classifier-models.ts
@@ -0,0 +1,105 @@
+import type { DecisionModelCandidate } from "@zcode/shared";
+import { getEnabledApiKeys } from "./api-key-credentials.js";
+import type { ProviderRegistryServiceSnapshot } from "./registry-service.js";
+
+export function isLocalClassifierEndpoint(value?: string | null): boolean {
+  try {
+    const url = new URL(value ?? "");
+    return (
+      ["http:", "https:"].includes(url.protocol) &&
+      ["127.0.0.1", "[::1]", "localhost"].includes(url.hostname) &&
+      !url.username &&
+      !url.password &&
+      !url.search &&
+      !url.hash
+    );
+  } catch {
+    return false;
+  }
+}
+export function classifierGateway(value?: string | null): string | undefined {
+  try {
+    const url = new URL(value ?? "");
+    if (url.protocol !== "https:" || url.username || url.password || url.search || url.hash) return;
+    const bases: Record<string, string[]> = {
+      "api.typesafe.ai": ["/v1"],
+      "openrouter.ai": ["/api/v1"],
+      "ai-gateway.vercel.sh": ["/typesafe/v1"],
+      "opencode.ai": ["/zen/v1"],
+    };
+    return bases[url.hostname]?.includes(url.pathname.replace(/\/+$/, ""))
+      ? url.hostname
+      : undefined;
+  } catch {
+    return;
+  }
+}
+/** Public choices from the existing applied Provider snapshot; no credential projection. */
+export function classifierModels(
+  snapshot: ProviderRegistryServiceSnapshot | null,
+): DecisionModelCandidate[] {
+  return (
+    snapshot?.resolution.resolvedProviders.flatMap((provider) => {
+      const api = provider.config.api;
+      const access = provider.config.access;
+      if (
+        !provider.enabled ||
+        provider.providerIssues.length ||
+        access?.type !== "api-key" ||
+        !api?.baseUrl
+      )
+        return [];
+      const nativeProtocol = api.type === "typesafe-system-one";
+      if (!nativeProtocol && !classifierGateway(api.baseUrl)) return [];
+      if (
+        !getEnabledApiKeys(access).length &&
+        !(nativeProtocol && isLocalClassifierEndpoint(api.baseUrl))
+      )
+        return [];
+      return provider.models.flatMap((model) => {
+        if (
+          !model.enabled ||
+          (!nativeProtocol &&
+            model.config.properties?.outputFormat?.supportsClassification !== true)
+        )
+          return [];
+        const contextWindow = model.evidenceConfig?.properties?.contextWindow;
+        return [
+          {
+            providerId: provider.providerId,
+            providerName: provider.providerName?.trim() || provider.providerId,
+            modelId: model.modelId,
+            ...(typeof contextWindow === "number" ? { contextWindow } : {}),
+          },
+        ];
+      });
+    }) ?? []
+  );
+}
+/** IDs are published by the installed Pi 1.0.1 catalog; an arbitrary proxy/name establishes no protocol. */
+export function isPublishedClassifier(value: string | null | undefined, id: string): boolean {
+  const gateway = classifierGateway(value);
+  const ids: Record<string, readonly string[]> = {
+    "api.typesafe.ai": ["jev-latest"],
+    "openrouter.ai": [
+      "typesafe/jev-1.13",
+      "~typesafe/jev-latest",
+      "inception/mercury-decide:free",
+      "jaredpalmer/kev-4b",
+      "liquid/d1",
+      "respan/span-01",
+      "respan/span-01-lite",
+      "respan/span-01-lite:free",
+      "togethercomputer/tev1-4b-experimental",
+      "upstage/solar-decide",
+    ],
+    "ai-gateway.vercel.sh": [
+      "typesafe-ai/jev",
+      "convaiinnovations/laya",
+      "convaiinnovations/laya-free",
+      "liquid/d1",
+    ],
+    "opencode.ai": ["jev-1.13", "jev-1.13-free"],
+  };
+  return Boolean(gateway && ids[gateway]?.includes(id));
+}
