@@ -0,0 +1,93 @@
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import type { PluginLoadOutcome } from "@zcode/contracts";
+
+/**
+ * Per-plugin grants for third-party packages (OV-100 phase 3).
+ *
+ * A package installed from a third-party marketplace runs its MCP servers and hooks only after the
+ * person allows exactly the declared surface (fingerprint). The record lives beside the install
+ * record so the management process and resident Sessions read the same file. The first discovery
+ * after this store existed records every enabled third-party package as already allowed, so
+ * upgrading never silently stops something that worked; later installs and changed surfaces ask.
+ */
+
+const GRANTS_FILE = "plugin-grants.json";
+
+interface PluginGrantRecord {
+  fingerprint: string;
+  grantedAt: string;
+  origin: "person" | "existing-install";
+}
+
+interface PluginGrantFile {
+  version: 1;
+  grants: Record<string, PluginGrantRecord>;
+}
+
+export function pluginGrantsPath(pluginStorageRoot: string): string {
+  return join(pluginStorageRoot, GRANTS_FILE);
+}
+
+/** Granted fingerprints by plugin id, or undefined when no grant store exists yet. */
+export function readPluginGrantsSync(pluginStorageRoot: string): Record<string, string> | undefined {
+  const file = readGrantFile(pluginStorageRoot);
+  if (!file) return undefined;
+  return Object.fromEntries(
+    Object.entries(file.grants).map(([pluginId, record]) => [pluginId, record.fingerprint]),
+  );
+}
+
+/**
+ * Called after a discovery that ran without a grant store: records currently enabled third-party
+ * packages as allowed (their behaviour before this boundary existed) and creates the store.
+ */
+export function seedPluginGrantsIfMissing(
+  pluginStorageRoot: string,
+  outcome: Pick<PluginLoadOutcome, "plugins">,
+): void {
+  if (existsSync(pluginGrantsPath(pluginStorageRoot))) return;
+  const now = new Date().toISOString();
+  const grants: Record<string, PluginGrantRecord> = {};
+  for (const plugin of outcome.plugins) {
+    if (!plugin.grant?.required || !plugin.enabled) continue;
+    grants[plugin.id] = { fingerprint: plugin.grant.fingerprint, grantedAt: now, origin: "existing-install" };
+  }
+  writeGrantFile(pluginStorageRoot, { version: 1, grants });
+}
+
+export function grantPluginSync(pluginStorageRoot: string, pluginId: string, fingerprint: string): void {
+  const file = readGrantFile(pluginStorageRoot) ?? { version: 1, grants: {} };
+  file.grants[pluginId] = { fingerprint, grantedAt: new Date().toISOString(), origin: "person" };
+  writeGrantFile(pluginStorageRoot, file);
+}
+
+export function revokePluginGrantSync(pluginStorageRoot: string, pluginId: string): void {
+  const file = readGrantFile(pluginStorageRoot) ?? { version: 1, grants: {} };
+  delete file.grants[pluginId];
+  writeGrantFile(pluginStorageRoot, file);
+}
+
+function readGrantFile(pluginStorageRoot: string): PluginGrantFile | undefined {
+  const path = pluginGrantsPath(pluginStorageRoot);
+  if (!existsSync(path)) return undefined;
+  try {
+    const parsed = JSON.parse(readFileSync(path, "utf8")) as Partial<PluginGrantFile>;
+    const grants: Record<string, PluginGrantRecord> = {};
+    for (const [pluginId, record] of Object.entries(parsed.grants ?? {})) {
+      if (record && typeof record.fingerprint === "string") grants[pluginId] = record;
+    }
+    return { version: 1, grants };
+  } catch {
+    // An unreadable store grants nothing: failing closed keeps unapproved code from running.
+    return { version: 1, grants: {} };
+  }
+}
+
+function writeGrantFile(pluginStorageRoot: string, file: PluginGrantFile): void {
+  const path = pluginGrantsPath(pluginStorageRoot);
+  mkdirSync(dirname(path), { recursive: true });
+  const temporary = `${path}.${process.pid}.${Date.now()}.tmp`;
+  writeFileSync(temporary, `${JSON.stringify(file, null, 2)}\n`, { mode: 0o600 });
+  renameSync(temporary, path);
+}
