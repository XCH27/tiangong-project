+/**
+ * Allows a third-party plugin's MCP servers and hooks (OV-100 phase 3). The fingerprint must be the
+ * surface the person was shown, so an update that changed it between display and approval asks again.
+ */
+export function grantZCodePlugin(
+  options: ResolveZCodePluginsOptions & { fingerprint: string; plugin: string },
+): void {
+  const { pluginStorageRoot } = resolvePluginContext(options);
+  const plugin = resolveZCodePlugins(options).plugins.find((candidate) => candidate.id === options.plugin);
+  if (!plugin?.grant?.required) throw new Error(`Plugin does not need approval: ${options.plugin}`);
+  if (plugin.grant.fingerprint !== options.fingerprint) {
+    throw new Error(`Plugin ${options.plugin} changed what it runs; review it again before allowing.`);
+  }
+  grantPluginSync(pluginStorageRoot, plugin.id, plugin.grant.fingerprint);
+}
