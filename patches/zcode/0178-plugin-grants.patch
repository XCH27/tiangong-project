+/**
+ * Grant state for a plugin that can run host code. Packages installed from a third-party
+ * marketplace need a grant; built-in, official and person-declared folders do not. Undefined when
+ * the plugin declares neither MCP servers nor hooks.
+ */
+function resolvePluginGrant(input: {
+  candidate: PluginCandidate;
+  grants: PluginDiscoverRequest["pluginGrants"];
+  hookDetails: PluginHookDetail[];
+  loaded: LoadedPlugin;
+  mcpServerDefinitions: Record<string, unknown>;
+}): PluginMetadata["grant"] | undefined {
+  if (Object.keys(input.mcpServerDefinitions).length === 0 && input.hookDetails.length === 0) {
+    return undefined;
+  }
+  const fingerprint = pluginSurfaceFingerprint(input.mcpServerDefinitions, input.hookDetails);
+  const required =
+    input.candidate.source === "cache" && !isOfficialMarketplaceId(input.loaded.marketplace);
+  const granted = !required || input.grants === undefined || input.grants[input.loaded.id] === fingerprint;
+  return { fingerprint, granted, required };
+}
+
+/** Stable hash of what the plugin would execute: MCP launch definitions and hook commands. */
+export function pluginSurfaceFingerprint(
+  mcpServerDefinitions: Record<string, unknown>,
+  hookDetails: readonly PluginHookDetail[],
+): string {
+  const hooks = hookDetails
+    .map((hook) => ({
+      args: hook.args ?? [],
+      command: hook.command,
+      event: hook.event,
+      matcher: hook.matcher ?? "",
+      shell: hook.shell ?? false,
+    }))
+    .sort((left, right) => JSON.stringify(left).localeCompare(JSON.stringify(right)));
+  return createHash("sha256")
+    .update(canonicalJson({ hooks, mcp: mcpServerDefinitions }))
+    .digest("hex")
+    .slice(0, 32);
+}
+
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+  if (isRecord(value)) {
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalJson(value[key])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(value ?? null);
+}
+
 function canRunPluginHooks(candidate: PluginCandidate): boolean {
   // 用户安装/声明的插件 hook 默认放行（与内置/官方一致）。只由 Project 配置声明的 inline 根
   // 不放行：Project 直写的 hook 要过工作区 hook 信任审查，插件声明不能成为绕过它的通道（DOM-01）。
