+  const market = join(root, "market");
+  const plugin = join(market, "plugins", "runner");
+  for (const dir of [workspace, join(root, "user"), join(market, ".claude-plugin"), join(plugin, ".claude-plugin"), join(plugin, "skills", "notes")]) {
+    await mkdir(dir, { recursive: true });
+  }
+  await writeFile(userConfigPath, JSON.stringify({ storage: { dir: join(root, "storage") } }));
+  await writeFile(
+    join(market, ".claude-plugin", "marketplace.json"),
+    JSON.stringify({ name: "third-party", plugins: [{ name: "runner", source: "./plugins/runner" }] }),
+  );
+  await writeFile(
+    join(plugin, ".claude-plugin", "plugin.json"),
+    JSON.stringify({
+      name: "runner",
+      version: "1.0.0",
+      mcpServers: { tool: { command: "node", args: ["server.js"] } },
+      hooks: { PreToolUse: [{ hooks: [{ type: "command", command: "echo checked" }] }] },
+    }),
+  );
+  await writeFile(join(plugin, "skills", "notes", "SKILL.md"), "---\nname: notes\ndescription: Take notes\n---\n");
+  const paths = { env: {}, officialPluginRoots: [], pluginStorageRoot, userConfigPath, workingDirectory: workspace };
+  return { root, market, paths, pluginStorageRoot };
+}
+
+const find = (paths: object) => resolveZCodePlugins(paths).plugins.find((entry) => entry.name === "runner")!;
+
+test("a third-party package waits for approval, and a changed surface asks again", async () => {
+  const f = await fixture();
+  try {
+    resolveZCodePlugins(f.paths); // creates the grant store before anything is installed
+    await addMarketplace({ source: { source: "directory", path: f.market }, storageRoot: f.pluginStorageRoot });
+    const installed = await installMarketplacePlugin({ marketplace: "third-party", name: "runner", storageRoot: f.pluginStorageRoot });
+    await setZCodePluginEnabled({ ...f.paths, enabled: true, plugin: "runner@third-party" });
+
+    let outcome = resolveZCodePlugins(f.paths);
+    let runner = outcome.plugins.find((entry) => entry.name === "runner")!;
+    assert.equal(runner.grant?.required, true);
+    assert.equal(runner.grant?.granted, false);
+    assert.deepEqual(runner.mcpServerNames, [], "MCP servers wait for approval");
+    assert.ok(runner.hookDetails.every((hook) => !hook.runnable), "hooks wait for approval");
+    assert.ok(runner.skillCount > 0, "skills work without approval");
+    assert.ok(outcome.diagnostics.some((diagnostic) => diagnostic.code === "plugin_grant_required"));
+
+    assert.throws(() => grantZCodePlugin({ ...f.paths, fingerprint: "stale", plugin: runner.id }), /changed what it runs/);
+    grantZCodePlugin({ ...f.paths, fingerprint: runner.grant!.fingerprint, plugin: runner.id });
+    runner = find(f.paths);
+    assert.equal(runner.grant?.granted, true);
+    assert.equal(runner.mcpServerNames.length, 1);
+    assert.ok(runner.hookDetails.every((hook) => hook.runnable));
+
+    // An update that changes what runs needs a new approval.
+    const manifestPath = join(installed.installed[0]!.installPath, ".claude-plugin", "plugin.json");
+    const manifest = JSON.parse(await readFile(manifestPath, "utf8"));
+    manifest.mcpServers.tool.args = ["other.js"];
+    await writeFile(manifestPath, JSON.stringify(manifest));
+    assert.equal(find(f.paths).grant?.granted, false);
+
+    grantZCodePlugin({ ...f.paths, fingerprint: find(f.paths).grant!.fingerprint, plugin: runner.id });
+    revokeZCodePluginGrant({ ...f.paths, plugin: runner.id });
+    assert.equal(find(f.paths).grant?.granted, false, "revoking withholds it again");
+  } finally {
+    await rm(f.root, { recursive: true, force: true });
+  }
+});
+
+test("packages installed before grants existed keep working after the upgrade", async () => {
+  const f = await fixture();
+  try {
+    await addMarketplace({ source: { source: "directory", path: f.market }, storageRoot: f.pluginStorageRoot });
+    await installMarketplacePlugin({ marketplace: "third-party", name: "runner", storageRoot: f.pluginStorageRoot });
+    await setZCodePluginEnabled({ ...f.paths, enabled: true, plugin: "runner@third-party" });
+    await unlink(join(f.pluginStorageRoot, "plugin-grants.json")).catch(() => undefined);
+
+    assert.equal(find(f.paths).grant?.granted, true, "first discovery records the existing install");
+    const store = JSON.parse(await readFile(join(f.pluginStorageRoot, "plugin-grants.json"), "utf8"));
+    assert.equal(store.grants["runner@third-party"].origin, "existing-install");
+    assert.equal(find(f.paths).grant?.granted, true);
+  } finally {
+    await rm(f.root, { recursive: true, force: true });
+  }
+});
