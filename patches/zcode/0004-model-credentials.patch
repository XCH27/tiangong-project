@@ -0,0 +1,104 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createApiKeyFailoverFetch,
+  createCredentialFailoverFetch,
+} from "../src/model/credential-failover.js";
+const baseUrl = "https://same-provider.example/v1";
+const input = () =>
+  new Request(`${baseUrl}/responses`, {
+    method: "POST",
+    headers: { authorization: "Bearer first" },
+    body: '{"model":"unchanged"}',
+  });
+test("network failures and broken successful streams cannot replay on a backup", async () => {
+  let calls = 0;
+  const failing = createApiKeyFailoverFetch({
+    baseUrl,
+    apiKey: "first",
+    additionalApiKeys: ["backup"],
+    fetch: async () => {
+      calls++;
+      throw new Error("offline");
+    },
+  });
+  await assert.rejects(failing(input()), /offline/);
+  assert.equal(calls, 1);
+  const stream = createApiKeyFailoverFetch({
+    baseUrl,
+    apiKey: "first",
+    additionalApiKeys: ["backup"],
+    fetch: async () => {
+      calls++;
+      return new Response(
+        new ReadableStream({
+          start(controller) {
+            controller.error(new Error("stream interrupted"));
+          },
+        }),
+      );
+    },
+  });
+  await assert.rejects((await stream(input())).text(), /stream interrupted/);
+  assert.equal(calls, 2);
+});
+test("abort during credential resolution prevents replay and cancels rejected response", async () => {
+  const abort = new AbortController();
+  let calls = 0;
+  let cancelled = false;
+  const transport = createCredentialFailoverFetch({
+    baseUrl,
+    fetch: async () => {
+      calls++;
+      return new Response(
+        new ReadableStream({
+          cancel() {
+            cancelled = true;
+          },
+        }),
+        { status: 401 },
+      );
+    },
+    async next() {
+      abort.abort();
+      return { apiKey: "backup" };
+    },
+  });
+  await assert.rejects(transport(input(), { signal: abort.signal }), { name: "AbortError" });
+  assert.equal(calls, 1);
+  assert.equal(cancelled, true);
+});
+test("account-specific endpoint changes and unrelated paths cannot receive backup credentials", async () => {
+  let calls = 0;
+  let selections = 0;
+  const transport = createCredentialFailoverFetch({
+    baseUrl,
+    fetch: async () => {
+      calls++;
+      return new Response("rejected", { status: 401 });
+    },
+    async next() {
+      selections++;
+      return { apiKey: "backup", baseUrl: "https://another.example/v1" };
+    },
+  });
+  assert.equal((await transport(input())).status, 401);
+  assert.equal(calls, 1);
+  await transport("https://same-provider.example/unrelated");
+  assert.equal(selections, 1);
+});
+test("duplicate keys are skipped, pools are bounded, concurrent requests have independent cursors", async () => {
+  const keys: string[] = [];
+  const transport = createApiKeyFailoverFetch({
+    baseUrl,
+    apiKey: "first",
+    additionalApiKeys: ["first", "backup", "backup"],
+    fetch: async (request, init) => {
+      keys.push(new Request(request, init).headers.get("authorization")!);
+      return new Response("no", { status: 429 });
+    },
+  });
+  await Promise.all([transport(input()), transport(input())]);
+  assert.equal(keys.filter((k) => k === "Bearer first").length, 2);
+  assert.equal(keys.filter((k) => k === "Bearer backup").length, 2);
+});
