new file mode 100644
index 0000000..3757973
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionAccountLabel.ts
@@ -0,0 +1,23 @@
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+
+/** 只投影同一凭据里的展示邮箱；JWT 内容不参与鉴权、套餐或额度判断。 */
+export function subscriptionAccountLabel(credential: OAuthCredential): string | undefined {
+  for (const token of [credential.idToken, credential.access]) {
+    if (typeof token !== "string" || token.length > 64 * 1024) continue;
+    try {
+      const payload = JSON.parse(
+        Buffer.from(token.split(".")[1] ?? "", "base64url").toString("utf8"),
+      );
+      const email: unknown = payload?.email ?? payload?.["https://api.openai.com/profile"]?.email;
+      if (
+        typeof email === "string" &&
+        email.length <= 254 &&
+        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
+      )
+        return email;
+    } catch {
+      /* 不透明令牌保持账号编号，不展示令牌片段。 */
+    }
+  }
+  return undefined;
+}
