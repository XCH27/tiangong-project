@@ -0,0 +1,78 @@
+/** Only rejected HTTP requests may change credentials. A returned success stream is never replayed. */
+export function createCredentialFailoverFetch(options: {
+  fetch: typeof globalThis.fetch;
+  baseUrl: string;
+  next(
+    status: 401 | 429,
+  ): Promise<{ apiKey: string; headers?: Record<string, string>; baseUrl?: string } | undefined>;
+  anthropic?: boolean;
+}): typeof globalThis.fetch {
+  return async (input, init) => {
+    const request = new Request(input, init);
+    const target = new URL(request.url);
+    const base = new URL(options.baseUrl);
+    // The wrapper is bound to one model factory. Never send a backup to another origin/route.
+    if (
+      target.origin !== base.origin ||
+      !target.pathname.startsWith(base.pathname.replace(/\/$/, "") + "/")
+    )
+      return options.fetch(input, init);
+    const headers = new Headers(request.headers);
+    for (let attempt = 0; attempt < 10; attempt++) {
+      request.signal.throwIfAborted();
+      const response = await options.fetch(
+        new Request(request.clone(), { headers, redirect: "error" }),
+      );
+      if ((response.status !== 401 && response.status !== 429) || attempt === 9) return response;
+      let next;
+      try {
+        next = await options.next(response.status);
+        request.signal.throwIfAborted();
+      } catch (error) {
+        await response.body?.cancel();
+        throw error;
+      }
+      if (!next) return response;
+      // Account-specific endpoints cannot be crossed by credential recovery.
+      if (next.baseUrl && next.baseUrl.replace(/\/$/, "") !== options.baseUrl.replace(/\/$/, ""))
+        return response;
+      await response.body?.cancel();
+      headers.delete("authorization");
+      headers.delete("x-api-key");
+      headers.delete("chatgpt-account-id");
+      if (options.anthropic) {
+        headers.set("x-api-key", next.apiKey);
+        headers.set("authorization", `Bearer ${next.apiKey}`);
+      } else headers.set("authorization", `Bearer ${next.apiKey}`);
+      for (const [name, value] of Object.entries(next.headers ?? {})) headers.set(name, value);
+    }
+    throw new Error("Credential attempt limit reached");
+  };
+}
+
+export function createApiKeyFailoverFetch(options: {
+  fetch: typeof globalThis.fetch;
+  baseUrl: string;
+  apiKey: string;
+  additionalApiKeys?: readonly string[] | null;
+  anthropic?: boolean;
+}): typeof globalThis.fetch {
+  const keys = [
+    ...new Set(
+      [options.apiKey, ...(options.additionalApiKeys ?? [])]
+        .map((key) => key.trim())
+        .filter(Boolean),
+    ),
+  ].slice(0, 10);
+  // Each physical request owns its attempt cursor. Concurrent tasks never share one.
+  return (input, init) => {
+    let index = 0;
+    return createCredentialFailoverFetch({
+      ...options,
+      async next() {
+        const apiKey = keys[++index];
+        return apiKey ? { apiKey } : undefined;
+      },
+    })(input, init);
+  };
+}
