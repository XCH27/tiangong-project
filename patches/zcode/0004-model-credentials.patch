@@ -0,0 +1,175 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  parseSubscriptionUsage,
+  readSubscriptionUsage,
+} from "../src/model-provider/subscriptionUsage.js";
+const credential = {
+  type: "oauth" as const,
+  access: "fixture-access",
+  refresh: "fixture-refresh",
+  expires: 100000,
+  accountId: "account-a",
+};
+
+test("Codex allowance preserves independent windows and model buckets, including real zero", () => {
+  assert.deepEqual(
+    parseSubscriptionUsage(
+      "openai-codex",
+      {
+        plan_type: "plus",
+        rate_limit: {
+          primary_window: { used_percent: 25, limit_window_seconds: 18000 },
+          secondary_window: { used_percent: 100 },
+        },
+        additional_rate_limits: [
+          {
+            limit_name: "image",
+            rate_limit: { primary_window: { used_percent: 0, reset_at: 2000000000 } },
+          },
+        ],
+      },
+      99,
+    ),
+    {
+      status: "available",
+      source: "ChatGPT / WHAM",
+      plan: "plus",
+      observedAt: 99,
+      windows: [
+        { id: "default:primary_window", usedPercent: 25, windowMinutes: 300 },
+        { id: "default:secondary_window", usedPercent: 100 },
+        { id: "image:primary_window", usedPercent: 0, resetAt: 2000000000000 },
+      ],
+    },
+  );
+});
+test("invalid or absent quota is not converted to zero or unlimited", () => {
+  for (const value of [undefined, null, "0", NaN, -1, 101]) {
+    assert.deepEqual(
+      parseSubscriptionUsage(
+        "openai-codex",
+        { rate_limit: { primary_window: { used_percent: value } } },
+        99,
+      ),
+      { status: "unavailable" },
+    );
+    assert.deepEqual(
+      parseSubscriptionUsage(
+        "github-copilot",
+        { quota_snapshots: { premium: { percent_remaining: value } } },
+        99,
+      ),
+      { status: "unavailable" },
+    );
+  }
+});
+test("Copilot retains new buckets and explicit unlimited, uses remaining-to-used convention", () => {
+  const result = parseSubscriptionUsage(
+    "github-copilot",
+    {
+      copilot_plan: "individual",
+      quota_snapshots: {
+        premium_interactions: { percent_remaining: 76 },
+        completion: { unlimited: true },
+        future_bucket: { percent_remaining: 0 },
+      },
+    },
+    99,
+  );
+  assert.equal(result.status, "available");
+  if (result.status === "available")
+    assert.deepEqual(result.windows, [
+      { id: "premium_interactions", usedPercent: 24 },
+      { id: "completion", unlimited: true },
+      { id: "future_bucket", usedPercent: 100 },
+    ]);
+});
+test("usage reads have fixed origins, credential roles, deadline and reject redirects", async () => {
+  for (const kind of ["openai-codex", "github-copilot"] as const) {
+    let calls = 0;
+    const result = await readSubscriptionUsage(
+      kind,
+      credential,
+      async (url, init) => {
+        calls++;
+        assert.equal(
+          url,
+          kind === "openai-codex"
+            ? "https://chatgpt.com/backend-api/wham/usage"
+            : "https://api.github.com/copilot_internal/user",
+        );
+        assert.equal(init?.redirect, "error");
+        assert.equal(init?.method, "GET");
+        assert.ok(init?.signal);
+        const headers = new Headers(init?.headers);
+        assert.equal(
+          headers.get("authorization"),
+          kind === "openai-codex" ? "Bearer fixture-access" : "Bearer fixture-refresh",
+        );
+        if (kind === "openai-codex") assert.equal(headers.get("chatgpt-account-id"), "account-a");
+        return Response.json(
+          kind === "openai-codex"
+            ? { rate_limit: { primary_window: { used_percent: 20 } } }
+            : { quota_snapshots: { premium: { percent_remaining: 80 } } },
+        );
+      },
+      () => 99,
+    );
+    assert.equal(result.status, "available");
+    assert.equal(calls, 1);
+  }
+});
+test("mismatched account, oversized payload and unsupported host do not publish readings", async () => {
+  assert.deepEqual(
+    await readSubscriptionUsage("openai-codex", credential, async () =>
+      Response.json({ account_id: "other", rate_limit: { primary_window: { used_percent: 20 } } }),
+    ),
+    { status: "unavailable" },
+  );
+  assert.deepEqual(
+    await readSubscriptionUsage(
+      "openai-codex",
+      credential,
+      async () => new Response("x".repeat(256 * 1024 + 1)),
+    ),
+    { status: "unavailable" },
+  );
+  const forbidden: typeof fetch = async () => {
+    throw new Error("Must not query github.com with enterprise credentials");
+  };
+  assert.deepEqual(
+    await readSubscriptionUsage(
+      "github-copilot",
+      { ...credential, enterpriseUrl: "company.example" },
+      forbidden,
+    ),
+    { status: "unsupported" },
+  );
+});
+test("authorization, throttling and network failures remain distinct with no recovery side effect", async () => {
+  for (const [http, status] of [
+    [401, "auth-required"],
+    [403, "auth-required"],
+    [429, "rate-limited"],
+    [500, "unavailable"],
+  ] as const) {
+    let calls = 0;
+    assert.deepEqual(
+      await readSubscriptionUsage("openai-codex", credential, async () => {
+        calls++;
+        return new Response(null, { status: http });
+      }),
+      { status },
+    );
+    assert.equal(calls, 1);
+  }
+});
+
+test("account display metadata contains the email only, never opaque tokens or plan claims", async () => {
+  const { subscriptionAccountLabel } =
+    await import("../src/model-provider/subscriptionAccountLabel.js");
+  const access = `header.${Buffer.from(JSON.stringify({ "https://api.openai.com/profile": { email: "fixture@example.test" }, plan: "untrusted" })).toString("base64url")}.signature`;
+  assert.equal(subscriptionAccountLabel({ ...credential, access }), "fixture@example.test");
+  assert.equal(subscriptionAccountLabel(credential), undefined);
+});
