diff --git a/packages/services/src/model-provider/subscriptionUsage.ts b/packages/services/src/model-provider/subscriptionUsage.ts
new file mode 100644
index 0000000..112198e
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionUsage.ts
@@ -0,0 +1,162 @@
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+import type { SubscriptionKind } from "./subscriptionConnectionTypes.js";
+
+export interface SubscriptionUsageWindow {
+  id: string;
+  usedPercent?: number;
+  unlimited?: boolean;
+  windowMinutes?: number;
+  resetAt?: number;
+}
+export type SubscriptionUsageResult =
+  | {
+      status: "available";
+      source: string;
+      observedAt: number;
+      plan?: string;
+      windows: SubscriptionUsageWindow[];
+    }
+  | { status: "auth-required" | "rate-limited" | "unavailable" | "unsupported" };
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+function percent(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0 && value <= 100;
+}
+function text(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 && value.length <= 128 ? value : undefined;
+}
+
+// 移植既有 Craft 候选解析器，并保留原始窗口；缺失值不能显示成满额或零用量。
+export function parseSubscriptionUsage(
+  kind: SubscriptionKind,
+  payload: unknown,
+  observedAt: number,
+): SubscriptionUsageResult {
+  const body = record(payload);
+  if (!body) return { status: "unavailable" };
+  const windows: SubscriptionUsageWindow[] = [];
+  if (kind === "openai-codex") {
+    const limits = [{ id: "default", value: body.rate_limit }];
+    if (Array.isArray(body.additional_rate_limits)) {
+      for (const raw of body.additional_rate_limits.slice(0, 32)) {
+        const item = record(raw);
+        const id = text(item?.limit_name ?? item?.metered_feature);
+        if (id && !limits.some((limit) => limit.id === id))
+          limits.push({ id, value: item?.rate_limit });
+      }
+    }
+    for (const { id, value } of limits) {
+      for (const key of ["primary_window", "secondary_window"]) {
+        const window = record(record(value)?.[key]);
+        if (!percent(window?.used_percent)) continue;
+        const seconds = window.limit_window_seconds;
+        const reset = window.reset_at;
+        windows.push({
+          id: `${id}:${key}`,
+          usedPercent: window.used_percent,
+          ...(typeof seconds === "number" && Number.isSafeInteger(seconds) && seconds >= 60
+            ? { windowMinutes: seconds / 60 }
+            : {}),
+          ...(typeof reset === "number" &&
+          Number.isSafeInteger(reset) &&
+          reset > 0 &&
+          reset <= 8640000000000
+            ? { resetAt: reset * 1000 }
+            : {}),
+        });
+      }
+    }
+  } else {
+    const reset =
+      typeof body.quota_reset_date === "string" ? Date.parse(body.quota_reset_date) : NaN;
+    for (const [id, value] of Object.entries(record(body.quota_snapshots) ?? {}).slice(0, 32)) {
+      const window = record(value);
+      if (!text(id) || !window || (!percent(window.percent_remaining) && window.unlimited !== true))
+        continue;
+      windows.push({
+        id,
+        ...(window.unlimited === true
+          ? { unlimited: true }
+          : { usedPercent: 100 - (window.percent_remaining as number) }),
+        ...(Number.isFinite(reset) ? { resetAt: reset } : {}),
+      });
+    }
+  }
+  return windows.length
+    ? {
+        status: "available",
+        observedAt,
+        windows,
+        source: kind === "openai-codex" ? "ChatGPT / WHAM" : "GitHub Copilot",
+        plan: text(kind === "openai-codex" ? body.plan_type : body.copilot_plan),
+      }
+    : { status: "unavailable" };
+}
+
+export async function readSubscriptionUsage(
+  kind: SubscriptionKind,
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+  now = Date.now,
+): Promise<SubscriptionUsageResult> {
+  if (kind === "openai-codex" && !text(credential.accountId)) return { status: "auth-required" };
+  // 企业实例的目标域名须单独核实，不能把其凭据发给 github.com。
+  if (kind === "github-copilot" && credential.enterpriseUrl) return { status: "unsupported" };
+  const codex = kind === "openai-codex";
+  const url = codex
+    ? "https://chatgpt.com/backend-api/wham/usage"
+    : "https://api.github.com/copilot_internal/user";
+  try {
+    const response = await fetcher(url, {
+      method: "GET",
+      redirect: "error",
+      signal: AbortSignal.timeout(10_000),
+      headers: {
+        Accept: "application/json",
+        Authorization: `Bearer ${codex ? credential.access : credential.refresh}`,
+        ...(codex
+          ? { "ChatGPT-Account-Id": credential.accountId as string }
+          : { "User-Agent": "Fleet", "X-GitHub-Api-Version": "2022-11-28" }),
+      },
+    });
+    if (!response.ok) {
+      await response.body?.cancel();
+      return {
+        status: [401, 403].includes(response.status)
+          ? "auth-required"
+          : response.status === 429
+            ? "rate-limited"
+            : "unavailable",
+      };
+    }
+    const reader = response.body?.getReader();
+    if (!reader) return { status: "unavailable" };
+    const chunks: Uint8Array[] = [];
+    let bytes = 0;
+    try {
+      for (;;) {
+        const part = await reader.read();
+        if (part.done) break;
+        bytes += part.value.byteLength;
+        if (bytes > 256 * 1024) {
+          await reader.cancel();
+          return { status: "unavailable" };
+        }
+        chunks.push(part.value);
+      }
+    } finally {
+      reader.releaseLock();
+    }
+    const payload: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    const accountId = record(payload)?.account_id;
+    if (codex && typeof accountId === "string" && accountId !== credential.accountId)
+      return { status: "unavailable" };
+    return parseSubscriptionUsage(kind, payload, now());
+  } catch {
+    return { status: "unavailable" };
+  }
+}
