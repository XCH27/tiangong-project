diff --git a/packages/ui/src/settings/model-provider-section/CredentialAutoSwitchSection.tsx b/packages/ui/src/settings/model-provider-section/CredentialAutoSwitchSection.tsx
new file mode 100644
index 0000000..7fdb191
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/CredentialAutoSwitchSection.tsx
@@ -0,0 +1,48 @@
+import { useId } from "react";
+import { Switch } from "@/components/ui/switch.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+// NewMax 的账号切换区块独立于添加操作；复用 ZCode 的表面、字号和开关。
+export function CredentialAutoSwitchSection({
+  kind,
+  count,
+  checked,
+  disabled,
+  onCheckedChange,
+}: {
+  kind: "keys" | "accounts";
+  count: number;
+  checked: boolean;
+  disabled?: boolean;
+  onCheckedChange: (checked: boolean) => void;
+}) {
+  const { intl } = useZCodeIntl();
+  const id = useId();
+  const eligible = count >= 2;
+  return (
+    <div className="flex items-center justify-between gap-3 rounded-xl bg-surface px-3 py-2">
+      <div className="min-w-0">
+        <label id={`${id}-title`} htmlFor={id} className="text-ui-base font-medium text-foreground">
+          {intl.formatMessage({ id: `settings.modelProvider.credentials.${kind}.autoSwitch` })}
+        </label>
+        <p
+          id={`${id}-hint`}
+          className="mt-0.5 text-ui-caption leading-relaxed text-foreground-subtle"
+        >
+          {intl.formatMessage({
+            id: `settings.modelProvider.credentials.${kind}.${eligible ? "switchHint" : "switchRequiresTwo"}`,
+          })}
+        </p>
+      </div>
+      <Switch
+        id={id}
+        className="shrink-0"
+        aria-labelledby={`${id}-title`}
+        aria-describedby={`${id}-hint`}
+        checked={eligible && checked}
+        disabled={disabled || !eligible}
+        onCheckedChange={onCheckedChange}
+      />
+    </div>
+  );
+}
