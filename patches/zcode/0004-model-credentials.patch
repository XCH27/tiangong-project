diff --git a/packages/ui/src/settings/model-provider-section/SubscriptionUsageSection.tsx b/packages/ui/src/settings/model-provider-section/SubscriptionUsageSection.tsx
new file mode 100644
index 0000000..768bcee
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/SubscriptionUsageSection.tsx
@@ -0,0 +1,122 @@
+import { useEffect, useRef, useState } from "react";
+import { LoaderCircleIcon, RefreshCwIcon } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Progress } from "@/components/ui/progress.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+// 沿用 ZCode 状态卡的标题/动作/内容布局，额度属于账号，不属于上下文 Token 环。
+export function SubscriptionUsageSection({
+  providerId,
+  revision,
+}: {
+  providerId: string;
+  revision: string;
+}) {
+  const { providerSettingsService } = useServices();
+  const { intl, locale } = useZCodeIntl();
+  const numberFormat = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
+  const dateFormat = new Intl.DateTimeFormat(locale, {
+    month: "short",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+  });
+  const [result, setResult] =
+    useState<Awaited<ReturnType<typeof providerSettingsService.getSubscriptionUsage>>>();
+  const [busy, setBusy] = useState(false);
+  const generation = useRef(0);
+  const pending = useRef(false);
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.allowance.${key}` });
+  useEffect(() => {
+    generation.current++;
+    pending.current = false;
+    setResult(undefined);
+    setBusy(false);
+    return () => {
+      generation.current++;
+    };
+  }, [providerId, revision]);
+  const refresh = async () => {
+    if (pending.current) return;
+    pending.current = true;
+    const version = ++generation.current;
+    setBusy(true);
+    setResult(undefined);
+    try {
+      const value = await providerSettingsService.getSubscriptionUsage(providerId);
+      if (version === generation.current) setResult(value);
+    } catch {
+      if (version === generation.current) setResult({ status: "unavailable" });
+    } finally {
+      if (version === generation.current) {
+        setBusy(false);
+        pending.current = false;
+      }
+    }
+  };
+  return (
+    <div className="space-y-3 rounded-xl border border-border bg-surface p-4">
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-ui-base font-medium">
+          {t("title")}
+          {result?.status === "available" && result.plan ? ` · ${result.plan}` : ""}
+        </span>
+        <Button
+          variant="ghost"
+          size="icon-sm"
+          disabled={busy}
+          aria-label={t("refresh")}
+          onClick={() => void refresh()}
+        >
+          {busy ? (
+            <LoaderCircleIcon className="size-4 animate-spin" />
+          ) : (
+            <RefreshCwIcon className="size-4" />
+          )}
+        </Button>
+      </div>
+      {result?.status === "available" ? (
+        <>
+          {result.windows.map((window) => (
+            <div key={window.id} className="space-y-1">
+              <div className="flex items-center justify-between gap-3 text-ui-base">
+                <span>
+                  {window.id.startsWith("default:") ? t("window") : window.id}
+                  {window.windowMinutes
+                    ? ` · ${numberFormat.format(window.windowMinutes / 60)} ${t("hours")}`
+                    : ""}
+                </span>
+                <span>
+                  {window.unlimited
+                    ? t("unlimited")
+                    : intl.formatMessage(
+                        { id: "settings.modelProvider.allowance.used" },
+                        {
+                          percent: numberFormat.format(window.usedPercent!),
+                        },
+                      )}
+                </span>
+              </div>
+              {window.usedPercent !== undefined ? (
+                <Progress value={window.usedPercent} aria-label={window.id} />
+              ) : null}
+              {window.resetAt ? (
+                <p className="text-ui-caption text-foreground-subtle">
+                  {t("resets")} {dateFormat.format(window.resetAt)}
+                </p>
+              ) : null}
+            </div>
+          ))}
+          <p className="text-ui-caption text-foreground-subtle">
+            {result.source} · {t("observed")} {dateFormat.format(result.observedAt)}
+          </p>
+        </>
+      ) : (
+        <p className="text-ui-base text-foreground-subtle" role="status">
+          {t(busy ? "loading" : (result?.status ?? "not-read"))}
+        </p>
+      )}
+    </div>
+  );
+}
