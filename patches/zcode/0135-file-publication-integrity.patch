index 0000000..a2deb5f
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/file-write-concurrency.test.ts
@@ -0,0 +1,282 @@
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import { fork } from "node:child_process";
+import { test } from "node:test";
+import { NodeFileSystemAdapter } from "../src/fs/index.js";
+import { fileWriteFixture as fixture } from "./helpers/file-write-fixture.js";
+
+test("bounded text revision does not mistake its prefix digest for the whole file", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "shared.txt");
+    await fs.writeFile(path, "original sixteen");
+    const adapter = new NodeFileSystemAdapter();
+    const partial = await adapter.readTextFile({ path, maxBytes: 4 });
+    assert.equal(partial.content, "orig");
+    assert.equal(partial.truncated, true);
+    assert.equal(partial.revision.hash, undefined);
+    await adapter.writeTextFile({
+      path,
+      content: "replacement",
+      expectedRevision: partial.revision,
+    });
+    assert.equal(await fs.readFile(path, "utf8"), "replacement");
+    assert.ok((await adapter.readTextFile({ path })).revision.hash);
+    assert.ok((await adapter.readBinaryFile({ path })).revision.hash);
+  });
+});
+
+test("two adapter owners cannot both overwrite the same observed revision", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "shared.txt");
+    await fs.writeFile(path, "original");
+    const a = new NodeFileSystemAdapter(),
+      b = new NodeFileSystemAdapter();
+    const { revision } = await a.readTextFile({ path });
+    const outcomes = await Promise.allSettled([
+      a.writeTextFile({ path, content: "writer-A", expectedRevision: revision }),
+      b.writeTextFile({ path, content: "writer-B", expectedRevision: revision }),
+    ]);
+    assert.equal(outcomes.filter((value) => value.status === "fulfilled").length, 1);
+    const failure = outcomes.find((value) => value.status === "rejected") as PromiseRejectedResult;
+    assert.equal(failure.reason.code, "stale_write");
+    assert.deepEqual(await fs.readdir(root), ["shared.txt"]);
+  });
+});
+
+test("supplied hash catches a same-size edit with the original mtime restored", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "shared.txt");
+    await fs.writeFile(path, "original");
+    const adapter = new NodeFileSystemAdapter();
+    const { revision } = await adapter.readTextFile({ path });
+    await fs.writeFile(path, "external");
+    const timestamp = new Date(revision.mtimeMs!);
+    await fs.utimes(path, timestamp, timestamp);
+    await assert.rejects(
+      adapter.writeTextFile({ path, content: "changed!", expectedRevision: revision }),
+      (error: any) => error.code === "stale_write",
+    );
+    assert.equal(await fs.readFile(path, "utf8"), "external");
+  });
+});
+
+test("an external edit observed while staging is not overwritten", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "shared.txt");
+    await fs.writeFile(path, "original");
+    const adapter = new NodeFileSystemAdapter();
+    const { revision } = await adapter.readTextFile({ path });
+    const originalOpen = fs.open;
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(`${path}.tmp.`)) {
+        const sync = handle.sync.bind(handle);
+        handle.sync = async () => {
+          await sync();
+          await fs.writeFile(path, "external editor");
+        };
+      }
+      return handle;
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        adapter.writeTextFile({ path, content: "replacement", expectedRevision: revision }),
+        (error: any) => error.code === "stale_write",
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "external editor");
+      assert.deepEqual(await fs.readdir(root), ["shared.txt"]);
+    } finally {
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test(
+  "a cancelled waiting writer cannot publish or release its predecessor",
+  { timeout: 10000 },
+  async () => {
+    await fixture(async (root) => {
+      const path = join(root, "shared.txt");
+      await fs.writeFile(path, "original");
+      const adapter = new NodeFileSystemAdapter();
+      const entered = Promise.withResolvers<void>(),
+        release = Promise.withResolvers<void>();
+      const originalOpen = fs.open;
+      let writes = 0;
+      fs.open = async (value, flags, ...rest) => {
+        const handle = await originalOpen(value, flags, ...rest);
+        if (String(value).startsWith(`${path}.tmp.`)) {
+          const write = handle.writeFile.bind(handle);
+          handle.writeFile = async (...args) => {
+            writes++;
+            if (writes === 1) {
+              entered.resolve();
+              await release.promise;
+            }
+            return write(...args);
+          };
+        }
+        return handle;
+      };
+      syncBuiltinESMExports();
+      const first = adapter.writeTextFile({ path, content: "first" });
+      try {
+        await entered.promise;
+        const controller = new AbortController();
+        const waiting = new NodeFileSystemAdapter().writeTextFile(
+          { path, content: "cancelled" },
+          { signal: controller.signal },
+        );
+        const rejected = assert.rejects(waiting, (error: any) => error.code === "cancelled");
+        controller.abort(new Error("Owner stopped"));
+        await rejected;
+        const next = adapter.writeTextFile({ path, content: "next" });
+        await new Promise((resolve) => setTimeout(resolve, 25));
+        assert.equal(writes, 1, "later writer must not pass the still-active predecessor");
+        assert.equal(await fs.readFile(path, "utf8"), "original");
+        release.resolve();
+        await first;
+        await next;
+        assert.equal(writes, 2);
+        assert.equal(await fs.readFile(path, "utf8"), "next");
+      } finally {
+        release.resolve();
+        await first.catch(() => {});
+        fs.open = originalOpen;
+        syncBuiltinESMExports();
+      }
+    });
+  },
+);
+
+test("committed rename is not rolled back or reported as a pre-publication cancellation", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "shared.txt");
+    await fs.writeFile(path, "original");
+    const controller = new AbortController();
+    const originalRename = fs.rename;
+    fs.rename = async (from, to) => {
+      await originalRename(from, to);
+      if (to === path) controller.abort();
+    };
+    syncBuiltinESMExports();
+    try {
+      const result = await new NodeFileSystemAdapter().writeTextFile(
+        { path, content: "committed" },
+        { signal: controller.signal },
+      );
+      assert.equal(result.bytesWritten, Buffer.byteLength("committed"));
+      assert.equal(await fs.readFile(path, "utf8"), "committed");
+    } finally {
