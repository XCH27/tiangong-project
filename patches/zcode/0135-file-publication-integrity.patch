index 0000000..6a0316f
--- /dev/null
+++ b/apps/zcode-cli/docs/file-write-integrity.md
@@ -0,0 +1,46 @@
+# Native file write integrity
+
+The existing FileSystemPort/NodeFileSystemAdapter owns native file publication. Human/domain
+callers and Write/Edit use that owner; this adds no document database or migration.
+
+```text
+permission-approved request → canonical file lock → check observed revision
+  → stage bytes beside target → flush/close → recheck revision and Stop → rename
+  → existing result/checkpoint path → release lock
+failure before rename → remove only this writer's temp → original unchanged + original cause
+```
+
+- `atomic:true` (including the default) never degrades to an in-place truncating write. Temporary
+  rename locks may retry with a bounded delay; persistent failure preserves the original.
+- Preserve existing encoding, line endings, executable mode and symlink refusal. Cancellation
+  before publication removes staged bytes; cancellation after rename cannot undo a committed file.
+- Fleet writers in different Sessions/processes serialize the same canonical file using the
+  existing PID-owned file-lock mechanism. Lock metadata is transient, outside project artifacts.
+  Rendezvous uses the OS-reported user's private cache, independent of HOME/TMPDIR/profile overrides;
+  an unavailable/unwritable rendezvous refuses before writing rather than bypassing coordination.
+  Waiting cancellation cannot release another writer's lock or let its successor overtake it.
+- Check a supplied revision within that lock and immediately before atomic publication. Compare
+  the supplied content hash as well as legacy mtime/size identity, so equal-size/equal-mtime edits
+  remain stale. Unconditional writes retain their explicit contract.
+- Write/Edit compare the model's complete cached Read with current content before accepting their
+  fresh internal revision. Equal metadata cannot erase an unseen external change; identical logical
+  content and existing bounded-view rules retain their original compatibility.
+- Truncated reads omit an entire-file hash; their bounded prefix must not masquerade as a full
+  content digest. They retain the existing metadata revision; complete reads keep hash protection.
+- This is coordination among participating Fleet writers, not an OS compare-and-swap against
+  arbitrary external editors. A crashed writer's existing PID-lock reclamation remains authoritative.
+  No power-loss, network-filesystem, cross-user or unverified OS guarantee is implied.
+- Once a native rename has been entered, Stop cannot promise absence of a file effect. The generic
+  executor's immediate cancellation/late-result reconciliation remains a separate kernel gap;
+  this correction does not claim a committed late file result is already journaled after Stop.
+
+Acceptance: real disposable files preserve original bytes on temporary-write/flush/rename failures;
+bounded transient rename succeeds once; Stop before rename publishes nothing; permission/encoding
+and symlink cases remain correct. Concurrent adapters and independent local processes with one
+observed revision produce one successful write and one `stale_write`, with lock cleanup/recovery.
+
+Comparison: original ZCode `29628c9` stages then falls back to O_TRUNC on every failure. Current
+GenOffice retries rename but still uses direct fallback; Kun supplies a before-commit/Stop guard
+and optional fallback refusal. Adapt their bounded retry/fence ideas through Fleet's existing
+adapter and shared lock, and reject direct fallback. Exact source locks/evidence live in the root
+reference registry; no third-party implementation is copied or dependency added.
diff --git a/apps/zcode-cli/packages/adapters/src/fs/atomic-text-write.ts b/apps/zcode-cli/packages/adapters/src/fs/atomic-text-write.ts
new file mode 100644
index 0000000..fdcd4a2
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/fs/atomic-text-write.ts
@@ -0,0 +1,97 @@
+import { randomBytes } from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, open, rename, unlink } from "node:fs/promises";
+import { setTimeout as sleep } from "node:timers/promises";
+import { maybeThrowStorageFsFault } from "../storage/fs-fault-injection.js";
+
+const RENAME_RETRY_DELAYS_MS = [50, 100, 200, 400] as const;
+const RETRYABLE_RENAME_CODES = new Set(["EPERM", "EACCES", "EBUSY"]);
+
+async function targetMode(path: string): Promise<number | undefined> {
+  try {
+    const info = await lstat(path);
+    if (info.isSymbolicLink()) {
+      throw new Error(
+        `Refusing to write through symlink: ${path}. Resolve its real target explicitly.`,
+      );
+    }
+    return info.mode;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    return undefined;
+  }
+}
+
+/** Staging/publication only; the FileSystemPort caller owns revision checks and the file lock. */
+export async function atomicWriteTextBytes(
+  path: string,
+  content: Buffer,
+  options: { signal?: AbortSignal; beforeCommit?: () => Promise<void> } = {},
+): Promise<void> {
+  const mode = await targetMode(path);
+  const temporary = `${path}.tmp.${process.pid}.${randomBytes(6).toString("hex")}`;
+  let created = false;
+  try {
+    options.signal?.throwIfAborted();
+    const handle = await open(
+      temporary,
+      constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW,
+    );
+    created = true;
+    let stagingFailed = false;
+    let stagingError: unknown;
+    try {
+      maybeThrowStorageFsFault({ operation: "writeFile", path });
+      await handle.writeFile(content, { signal: options.signal });
+      if (mode !== undefined) await handle.chmod(mode);
+      await handle.sync();
+    } catch (error) {
+      stagingFailed = true;
+      stagingError = error;
+      throw error;
+    } finally {
+      try {
+        await handle.close();
+      } catch (error) {
+        if (!stagingFailed) throw error;
+        // close 的次要失败不能遮掉磁盘满等首因；既有 errno 分类继续看首因的 code。
+        const code =
+          stagingError && typeof stagingError === "object" && "code" in stagingError
+            ? stagingError.code
+            : undefined;
+        throw Object.assign(
+          new AggregateError(
+            [stagingError, error],
+            stagingError instanceof Error ? stagingError.message : String(stagingError),
+            { cause: stagingError },
+          ),
+          { code },
+        );
+      }
+    }
+    for (let attempt = 0; ; attempt += 1) {
+      options.signal?.throwIfAborted();
+      await options.beforeCommit?.();
+      await targetMode(path);
+      options.signal?.throwIfAborted();
+      try {
+        maybeThrowStorageFsFault({ operation: "rename", path });
+        await rename(temporary, path);
+        return;
+      } catch (error) {
+        const delay = RENAME_RETRY_DELAYS_MS[attempt];
+        if (
+          delay === undefined ||
+          !RETRYABLE_RENAME_CODES.has((error as NodeJS.ErrnoException).code ?? "")
+        )
+          throw error;
+        // Windows 的短暂占用可以重试，但不能把 atomic 请求降级成截断原文件。
+        await sleep(delay, undefined, { signal: options.signal });
+      }
+    }
+  } catch (error) {
+    // 原实现在任何失败后 O_TRUNC 重写，第二次写入失败会毁掉原件；只清本 writer 的暂存。
+    if (created) await unlink(temporary).catch(() => undefined);
+    throw error;
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/fs/file-write-lock.ts b/apps/zcode-cli/packages/adapters/src/fs/file-write-lock.ts
new file mode 100644
index 0000000..0c440f5
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/fs/file-write-lock.ts
@@ -0,0 +1,28 @@
+import { createHash } from "node:crypto";
+import { mkdir, realpath } from "node:fs/promises";
+import { userInfo } from "node:os";
+import { basename, dirname, join } from "node:path";
+import { withFileLock } from "@zcode/shared/node";
+
+/** Reuse transient PID-owned locks across Fleet processes; these are not document records. */
+export async function withNativeFileWriteLock<T>(
+  path: string,
+  operation: () => Promise<T>,
+  signal?: AbortSignal,
+): Promise<T> {
+  signal?.throwIfAborted();
+  let canonical: string;
+  try {
+    canonical = await realpath(path);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    canonical = join(await realpath(dirname(path)), basename(path));
+  }
+  // Windows 的同名大小写入口必须竞争同一把锁；目标路径和权限仍用原请求，不改写。
+  if (process.platform === "win32") canonical = canonical.toLowerCase();
+  const key = createHash("sha256").update(canonical).digest("hex");
+  // HOME/TMPDIR 不能分裂同一文件的锁；OS 用户信息只在写入时读，失败不影响普通读取。
+  const directory = join(userInfo().homedir, ".cache", "fleet", "file-write-locks");
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  return withFileLock(join(directory, key), operation, { signal });
+}
