+++ b/apps/zcode-cli/packages/adapters/test/file-write-integrity.test.ts
@@ -0,0 +1,196 @@
+import assert from "node:assert/strict";
+import { constants } from "node:fs";
+import fs from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import { test } from "node:test";
+import { NodeFileSystemAdapter } from "../src/fs/index.js";
+import { fileWriteFixture as fixture } from "./helpers/file-write-fixture.js";
+
+const fault = (code: string) => Object.assign(new Error(`Injected ${code}`), { code });
+
+test("atomic publication failure preserves original bytes and the rename cause", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "original.txt");
+    await fs.writeFile(path, "original must survive");
+    const adapter = new NodeFileSystemAdapter();
+    const originalRename = fs.rename;
+    const originalOpen = fs.open;
+    let directOpened = false;
+    fs.rename = async (from, to) => {
+      if (to === path) throw fault("EIO");
+      return originalRename(from, to);
+    };
+    fs.open = async (value, flags, ...rest) => {
+      if (value === path && typeof flags === "number" && flags & constants.O_TRUNC)
+        directOpened = true;
+      return originalOpen(value, flags, ...rest);
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        adapter.writeTextFile({ path, content: "replacement", atomic: true }),
+        (error: any) => error.code === "io_error" && error.cause.code === "EIO",
+      );
+      assert.equal(directOpened, false);
+      assert.equal(await fs.readFile(path, "utf8"), "original must survive");
+      assert.deepEqual(await fs.readdir(root), ["original.txt"]);
+    } finally {
+      fs.rename = originalRename;
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test("exclusive temporary creation failure cannot remove another writer's file", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "original.txt");
+    await fs.writeFile(path, "original");
+    const originalOpen = fs.open;
+    let otherFile: string | undefined;
+    fs.open = async (value, flags, ...rest) => {
+      if (String(value).startsWith(`${path}.tmp.`)) {
+        otherFile = String(value);
+        await fs.writeFile(otherFile, "another writer", { flag: "wx" });
+      }
+      return originalOpen(value, flags, ...rest);
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        new NodeFileSystemAdapter().writeTextFile({ path, content: "replacement" }),
+      );
+      assert.ok(otherFile);
+      assert.equal(await fs.readFile(otherFile, "utf8"), "another writer");
+      assert.equal(await fs.readFile(path, "utf8"), "original");
+    } finally {
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test("temporary flush failure leaves the original and cleans its own temporary file", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "original.txt");
+    await fs.writeFile(path, "original");
+    const originalOpen = fs.open;
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(`${path}.tmp.`))
+        handle.sync = async () => {
+          throw fault("ENOSPC");
+        };
+      return handle;
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        new NodeFileSystemAdapter().writeTextFile({ path, content: "replacement" }),
+        (error: any) => error.code === "io_error" && error.cause.code === "ENOSPC",
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "original");
+      assert.deepEqual(await fs.readdir(root), ["original.txt"]);
+    } finally {
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test("secondary close failure retains staging ENOSPC as the primary cause", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "original.txt");
+    await fs.writeFile(path, "original");
+    const originalOpen = fs.open;
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(`${path}.tmp.`)) {
+        const close = handle.close.bind(handle);
+        handle.writeFile = async () => {
+          throw fault("ENOSPC");
+        };
+        handle.close = async () => {
+          await close();
+          throw fault("EIO");
+        };
+      }
+      return handle;
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        new NodeFileSystemAdapter().writeTextFile({ path, content: "replacement" }),
+        (error: any) =>
+          error.cause.code === "ENOSPC" &&
+          error.cause.cause.code === "ENOSPC" &&
+          error.cause.errors[1].code === "EIO",
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "original");
+      assert.deepEqual(await fs.readdir(root), ["original.txt"]);
+    } finally {
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test("transient rename locks retry without opening the original for overwrite", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "script.sh");
+    await fs.writeFile(path, "old", { mode: 0o755 });
+    const originalRename = fs.rename;
+    let attempts = 0;
+    fs.rename = async (from, to) => {
+      if (to === path && ++attempts < 3) throw fault("EBUSY");
+      return originalRename(from, to);
+    };
+    syncBuiltinESMExports();
+    try {
+      await new NodeFileSystemAdapter().writeTextFile({ path, content: "new" });
+      assert.equal(attempts, 3);
+      assert.equal(await fs.readFile(path, "utf8"), "new");
+      if (process.platform !== "win32") assert.equal((await fs.stat(path)).mode & 0o777, 0o755);
+      assert.deepEqual(await fs.readdir(root), ["script.sh"]);
+    } finally {
+      fs.rename = originalRename;
+      syncBuiltinESMExports();
+    }
+  });
+});
+
+test("Stop after staging but before rename preserves the original", async () => {
+  await fixture(async (root) => {
+    const path = join(root, "original.txt");
+    await fs.writeFile(path, "original");
+    const controller = new AbortController();
+    const originalOpen = fs.open;
+    fs.open = async (value, flags, ...rest) => {
+      const handle = await originalOpen(value, flags, ...rest);
+      if (String(value).startsWith(`${path}.tmp.`)) {
+        const sync = handle.sync.bind(handle);
+        handle.sync = async () => {
+          await sync();
+          controller.abort();
+        };
+      }
+      return handle;
+    };
+    syncBuiltinESMExports();
+    try {
+      await assert.rejects(
+        new NodeFileSystemAdapter().writeTextFile(
+          { path, content: "replacement" },
+          { signal: controller.signal },
+        ),
+        (error: any) => error.code === "cancelled",
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "original");
+      assert.deepEqual(await fs.readdir(root), ["original.txt"]);
+    } finally {
+      fs.open = originalOpen;
+      syncBuiltinESMExports();
+    }
+  });
+});
