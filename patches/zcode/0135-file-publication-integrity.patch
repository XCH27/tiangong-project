+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import test from "node:test";
+import { SessionEventType } from "@zcode/contracts";
+import { NodeFileSystemAdapter } from "../../adapters/src/fs/index.js";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+for (const streaming of [false, true]) {
+  test(`failed file publication remains an error through Host/Pi/SQLite ${streaming ? "stream" : "generate"}`, async () => {
+    const f = await fixture(undefined, streaming, {
+      config: { toolAllowlist: ["Read", "Write"] },
+      deps: { fileSystemPort: new NodeFileSystemAdapter() },
+    });
+    const path = join(f.dir, "document.txt");
+    await fs.writeFile(path, "original file");
+    const originalRename = fs.rename;
+    fs.rename = async (from, to) => {
+      if (to === path)
+        throw Object.assign(new Error("Injected publication failure"), { code: "EIO" });
+      return originalRename(from, to);
+    };
+    syncBuiltinESMExports();
+    try {
+      f.steps.push(
+        () =>
+          reply("Read original", [{ id: "read-source", name: "Read", input: { file_path: path } }]),
+        () =>
+          reply("Replace document", [
+            {
+              id: "write-source",
+              name: "Write",
+              input: { file_path: path, content: "replacement file" },
+            },
+          ]),
+        (request) => {
+          const tool = request.messages.find(
+            (message: any) => message.role === "tool" && message.toolCallId === "write-source",
+          );
+          assert.equal(tool?.isError, true);
+          return reply("The write failed");
+        },
+      );
+      assert.equal(
+        (await f.runtime.executeTurn("Replace the read document")).response,
+        "The write failed",
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "original file");
+      const events = await f.runtime.getSessionEventStore().getEvents("session" as never);
+      assert.equal(
+        events.filter((event) => event.type === SessionEventType.CheckpointCreated).length,
+        0,
+      );
+      const messages = await f.store.messages({ sessionID: "session" as never });
+      assert.ok(
+        messages.some((message) =>
+          message.parts.some(
+            (part) =>
+              part.type === "tool" &&
+              part.callID === "write-source" &&
+              part.state.status === "error",
+          ),
+        ),
+      );
+      await f.reopen();
+      const reopened = await f.store.messages({ sessionID: "session" as never });
+      assert.ok(
+        reopened.some((message) =>
+          message.parts.some(
+            (part) =>
+              part.type === "tool" &&
+              part.callID === "write-source" &&
+              part.state.status === "error",
+          ),
+        ),
+      );
+      assert.equal(await fs.readFile(path, "utf8"), "original file");
+    } finally {
+      fs.rename = originalRename;
+      syncBuiltinESMExports();
+      await f.close();
+    }
+  });
+}
+
+for (const streaming of [false, true]) {
+  for (const tool of ["Write", "Edit"] as const) {
+    test(`${tool} keeps complete Read freshness with restored metadata, ${streaming ? "stream" : "generate"}`, async () => {
+      const f = await fixture(undefined, streaming, {
+        config: { toolAllowlist: ["Read", tool] },
+        deps: { fileSystemPort: new NodeFileSystemAdapter() },
+      });
+      const path = join(f.dir, "document.txt");
+      await fs.writeFile(path, "line-a\nline-b");
+      const original = await fs.stat(path);
+      const timestamp = new Date(original.mtimeMs);
+      try {
+        f.steps.push(
+          () =>
+            reply("Read original", [
+              { id: "read-source", name: "Read", input: { file_path: path } },
+            ]),
+          async () => {
+            await fs.writeFile(path, "line-c\nline-b");
+            await fs.utimes(path, timestamp, timestamp);
+            return reply("Try old-context mutation", [
+              {
+                id: "mutate-source",
+                name: tool,
+                input:
+                  tool === "Write"
+                    ? { file_path: path, content: "replacement" }
+                    : { file_path: path, old_string: "line-b", new_string: "line-d" },
+              },
+            ]);
+          },
+          (request) => {
+            assert.ok(
+              request.messages.some(
+                (message: any) =>
+                  message.role === "tool" &&
+                  message.toolCallId === "mutate-source" &&
+                  message.isError,
+              ),
+            );
+            return reply("Read the current file first");
+          },
+        );
+        await f.runtime.executeTurn("Mutate only the document already read");
+        assert.equal(await fs.readFile(path, "utf8"), "line-c\nline-b");
+        const events = await f.runtime.getSessionEventStore().getEvents("session" as never);
+        assert.equal(
+          events.filter((event) => event.type === SessionEventType.CheckpointCreated).length,
+          0,
+        );
+        await f.reopen();
+        assert.equal(await fs.readFile(path, "utf8"), "line-c\nline-b");
+        const messages = await f.store.messages({ sessionID: "session" as never });
+        assert.ok(
+          messages.some((message) =>
+            message.parts.some(
+              (part) =>
+                part.type === "tool" &&
+                part.callID === "mutate-source" &&
+                part.state.status === "error",
+            ),
+          ),
+        );
+      } finally {
+        await f.close();
+      }
+    });
+  }
+}
