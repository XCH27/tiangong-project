+});
+
+test(
+  "independent native writer processes share revision admission",
+  { timeout: 20000 },
+  async () => {
+    await fixture(async (root) => {
+      const path = join(root, "shared.txt");
+      await fs.writeFile(path, "original");
+      const worker = join(root, "worker.mts");
+      const adapterUrl = new URL("../src/fs/index.ts", import.meta.url).href;
+      await fs.writeFile(
+        worker,
+        `
+      import { NodeFileSystemAdapter } from ${JSON.stringify(adapterUrl)};
+      const adapter = new NodeFileSystemAdapter();
+      const path = process.argv[2];
+      const { revision } = await adapter.readTextFile({ path });
+      process.on('message', async () => {
+        try {
+          await adapter.writeTextFile({ path, content: process.argv[3], expectedRevision: revision });
+          process.send({ status: 'fulfilled' });
+        } catch (error) { process.send({ status: 'rejected', code: error.code }); }
+        process.disconnect();
+      });
+      process.send({ status: 'ready', hash: revision.hash });
+    `,
+      );
+      const children = ["writer-A", "writer-B"].map((value) =>
+        fork(worker, [path, value], {
+          execArgv: ["--import", import.meta.resolve("tsx")],
+          stdio: ["ignore", "pipe", "pipe", "ipc"],
+        }),
+      );
+      try {
+        const outcomes = children.map(
+          (child) =>
+            new Promise<any>((resolve, reject) => {
+              child.on("message", (value: any) => {
+                if (value.status !== "ready") resolve(value);
+              });
+              child.on("error", reject);
+            }),
+        );
+        const ready = await Promise.all(
+          children.map(
+            (child) =>
+              new Promise<any>((resolve, reject) => {
+                child.on("message", (value: any) => {
+                  if (value.status === "ready") resolve(value);
+                });
+                child.on("error", reject);
+              }),
+          ),
+        );
+        assert.equal(ready[0].hash, ready[1].hash);
+        children.forEach((child) => child.send({ go: true }));
+        const result = await Promise.all(outcomes);
+        assert.equal(result.filter((value) => value.status === "fulfilled").length, 1);
+        assert.deepEqual(
+          result.filter((value) => value.status === "rejected").map((value) => value.code),
+          ["stale_write"],
+        );
+        assert.ok(["writer-A", "writer-B"].includes(await fs.readFile(path, "utf8")));
+      } finally {
+        children.forEach((child) => child.kill());
+      }
+    });
+  },
+);
