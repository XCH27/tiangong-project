+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+export async function fileWriteFixture(run: (root: string) => Promise<void>) {
+  const root = await mkdtemp(join(tmpdir(), "zcode-file-integrity-"));
+  try {
+    await run(root);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+}
