+    const { revision } = await adapter.readTextFile({ path });
+    const outcomes = await Promise.allSettled([
+      adapter.writeTextFile({ path, content: "writer-A", expectedRevision: revision }),
+      new NodeFileSystemAdapter().writeTextFile({
+        path: viaAlias,
+        content: "writer-B",
