+const VIEW_ID_PATTERN = /^[a-z0-9][a-z0-9-]{0,63}$/;
+
+/** `fleet.views[]` → validated view contributions; an invalid entry is dropped with a diagnostic. */
+function parsePluginViews(
+  loaded: LoadedPlugin,
+  mcpServerDefinitions: Record<string, unknown>,
+  diagnostics: PluginDiagnostic[],
+): NonNullable<PluginMetadata["views"]> {
+  const fleet = loaded.manifest.fleet;
+  const declared = isRecord(fleet) && Array.isArray(fleet.views) ? fleet.views : [];
+  const views: NonNullable<PluginMetadata["views"]> = [];
+  const invalid = (message: string) =>
+    diagnostics.push({
+      code: "plugin_view_invalid",
+      message: `${loaded.id}: ${message}`,
+      path: loaded.manifestPath,
+      pluginId: loaded.id,
+      severity: "warning",
+    });
+  for (const view of declared) {
+    if (!isRecord(view)) continue;
+    const id = typeof view.id === "string" ? view.id : "";
+    if (!VIEW_ID_PATTERN.test(id) || views.some((existing) => existing.id === id)) {
+      invalid(`view id must be unique lowercase words joined by hyphens: ${String(view.id)}`);
+      continue;
+    }
+    if (typeof view.server !== "string" || !(view.server in mcpServerDefinitions)) {
+      invalid(`view ${id} must name one of this plugin's MCP servers`);
+      continue;
+    }
+    if (typeof view.resource !== "string" || !view.resource.startsWith("ui://")) {
+      invalid(`view ${id} must name a ui:// resource`);
+      continue;
+    }
+    const titleI18n = isRecord(view.title_i18n)
+      ? Object.fromEntries(
+          Object.entries(view.title_i18n).filter((entry): entry is [string, string] => typeof entry[1] === "string"),
+        )
+      : undefined;
+    views.push({
+      id,
+      title: typeof view.title === "string" && view.title.trim() ? view.title.trim() : id,
+      ...(titleI18n && Object.keys(titleI18n).length > 0 ? { titleI18n } : {}),
+      ...(typeof view.description === "string" ? { description: view.description } : {}),
+      server: view.server,
+      resource: view.resource,
+      placement: "side-pane",
+    });
+  }
+  return views;
+}
