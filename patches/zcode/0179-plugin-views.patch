@@ -0,0 +1,50 @@
+// Minimal MCP Apps server over stdio for plugin-view tests: one ui:// view and one tool that both
+// the view and an Agent call. State lives in the plugin data folder, so every caller sees one owner.
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { createInterface } from "node:readline";
+
+const dataDir = process.env.ZCODE_PLUGIN_DATA ?? process.cwd();
+mkdirSync(dataDir, { recursive: true });
+const counterPath = join(dataDir, "counter.json");
+const read = () => {
+  try {
+    return JSON.parse(readFileSync(counterPath, "utf8")).value;
+  } catch {
+    return 0;
+  }
+};
+const send = (message) => process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", ...message })}\n`);
+const html = `<!doctype html><html><head><style>body{font:14px var(--font-sans,sans-serif);background:var(--color-background-primary);color:var(--color-text-primary);padding:16px}</style></head><body><button id="add">Add</button> <span id="value">-</span><script>
+let id = 0; const pending = new Map();
+addEventListener("message", (event) => { const m = event.data; if (m && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); } });
+const request = (method, params) => new Promise((resolve) => { const i = ++id; pending.set(i, resolve); parent.postMessage({ jsonrpc: "2.0", id: i, method, params }, "*"); });
+request("ui/initialize", { appCapabilities: {}, protocolVersion: "2026-01-26" }).then((reply) => {
+  for (const [name, value] of Object.entries(reply.result?.hostContext?.styles?.variables ?? {})) document.documentElement.style.setProperty(name, value);
+  document.body.dataset.theme = reply.result?.hostContext?.theme ?? "";
+  parent.postMessage({ jsonrpc: "2.0", method: "ui/notifications/initialized" }, "*");
+});
+document.getElementById("add").onclick = () => request("tools/call", { name: "increment", arguments: {} }).then((reply) => { document.getElementById("value").textContent = String(reply.result?.structuredContent?.value ?? reply.error?.message); });
+</script></body></html>`;
+
+createInterface({ input: process.stdin }).on("line", (line) => {
+  const message = JSON.parse(line);
+  if (message.id === undefined) return;
+  switch (message.method) {
+    case "initialize":
+      return send({ id: message.id, result: { protocolVersion: message.params.protocolVersion, capabilities: { tools: {}, resources: {} }, serverInfo: { name: "counter", version: "1.0.0" } } });
+    case "tools/list":
+      return send({ id: message.id, result: { tools: [{ name: "increment", description: "Add one", inputSchema: { type: "object", properties: {} } }] } });
+    case "resources/list":
+      return send({ id: message.id, result: { resources: [{ uri: "ui://counter/main", name: "Counter", mimeType: "text/html;profile=mcp-app" }] } });
+    case "resources/read":
+      return send({ id: message.id, result: { contents: [{ uri: message.params.uri, mimeType: "text/html;profile=mcp-app", text: html, _meta: { ui: { prefersBorder: false } } }] } });
+    case "tools/call": {
+      const value = read() + 1;
+      writeFileSync(counterPath, JSON.stringify({ value }));
+      return send({ id: message.id, result: { content: [{ type: "text", text: String(value) }], structuredContent: { value } } });
+    }
+    default:
+      return send({ id: message.id, error: { code: -32601, message: `Unknown method ${message.method}` } });
+  }
+});
