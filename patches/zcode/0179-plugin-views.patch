diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/plugin-views.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/plugin-views.ts
new file mode 100644
index 0000000..33581e2
