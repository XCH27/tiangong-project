+++ b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/plugin-views.ts
@@ -0,0 +1,147 @@
+import { createConfig, resolvePath } from "@zcode/adapters/config";
+import type { Logger, McpServerConfig, PluginLoadOutcome } from "@zcode/contracts";
+import {
+  zcodePluginViewCallToolParamsSchema,
+  zcodePluginViewCallToolResultSchema,
+  zcodePluginViewReadParamsSchema,
+  zcodePluginViewReadResultSchema,
+  type ZCodePluginViewCallToolResult,
+  type ZCodePluginViewReadResult,
+} from "@zcode/shared";
+import { getCliStorageRoot } from "../app/paths.js";
+import { resolveStartupPlugins } from "../app/startup-marks.js";
+import { StartupTimer, startupNow } from "../startup-logging.js";
+import { parseParams, type ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+/**
+ * Host side of plugin views (OV-100 phase 4). A view is an MCP Apps `ui://` resource served by one
+ * of the plugin's own MCP servers. The renderer reaches that server only through these two calls,
+ * which resolve the server from the current discovery: a disabled plugin or one whose MCP servers
+ * still wait for approval (phase 3) has no runnable server, so its view cannot run either.
+ */
+
+const MCP_APP_MIME = "text/html;profile=mcp-app";
+
+const noopLogger: Logger = {
+  debug: () => undefined,
+  info: () => undefined,
+  warn: () => undefined,
+  error: () => undefined,
+  child: () => noopLogger,
+};
+
+export async function readPluginView(
+  context: ZCodeProtocolAgentServerContext,
+  rawParams: unknown,
+): Promise<ZCodePluginViewReadResult> {
+  const params = parseParams(zcodePluginViewReadParamsSchema, rawParams);
+  const target = await connectViewServer(context, params.workspace, params.pluginId, params.viewId);
+  const readResource = target.port.readResource;
+  if (!readResource) throw new Error("This Fleet runtime cannot read MCP resources.");
+  const result = await readResource.call(target.port, target.serverName, target.resource);
+  const content = result.contents.find((item) => item.uri === target.resource) ?? result.contents[0];
+  if (!content) throw new Error(`The plugin returned no view for ${target.resource}.`);
+  if (content.mimeType && !content.mimeType.startsWith("text/html")) {
+    throw new Error(`The plugin view is ${content.mimeType}, not ${MCP_APP_MIME}.`);
+  }
+  const html =
+    typeof content.text === "string"
+      ? content.text
+      : typeof content.blob === "string"
+        ? Buffer.from(content.blob, "base64").toString("utf8")
+        : "";
+  if (!html) throw new Error(`The plugin view ${target.resource} is empty.`);
+  const ui = isRecord(content._meta) && isRecord(content._meta.ui) ? content._meta.ui : undefined;
+  const csp = ui && isRecord(ui.csp) ? ui.csp : undefined;
+  return zcodePluginViewReadResultSchema.parse({
+    html,
+    ...(csp
+      ? {
+          csp: {
+            ...(stringList(csp.connectDomains) ? { connectDomains: stringList(csp.connectDomains) } : {}),
+            ...(stringList(csp.resourceDomains) ? { resourceDomains: stringList(csp.resourceDomains) } : {}),
+          },
+        }
+      : {}),
+    ...(typeof ui?.prefersBorder === "boolean" ? { prefersBorder: ui.prefersBorder } : {}),
+  });
+}
+
+export async function callPluginViewTool(
+  context: ZCodeProtocolAgentServerContext,
+  rawParams: unknown,
+): Promise<ZCodePluginViewCallToolResult> {
+  const params = parseParams(zcodePluginViewCallToolParamsSchema, rawParams);
+  const target = await connectViewServer(context, params.workspace, params.pluginId, params.viewId);
+  const result = await target.port.callTool({
+    serverName: target.serverName,
+    toolName: params.tool,
+    arguments: params.arguments ?? {},
+    workspacePath: params.workspace.workspacePath,
+    ...(params.workspace.workspaceIdentity ? { workspaceIdentity: params.workspace.workspaceIdentity } : {}),
+  });
+  return zcodePluginViewCallToolResultSchema.parse({
+    content: result.content,
+    ...(result.structuredContent !== undefined ? { structuredContent: result.structuredContent } : {}),
+    ...(result.isError !== undefined ? { isError: result.isError } : {}),
+  });
+}
+
+async function connectViewServer(
+  context: ZCodeProtocolAgentServerContext,
+  workspace: { workspacePath: string; workspaceKey?: string },
+  pluginId: string,
+  viewId: string,
+) {
+  const port = context.deps.mcpPort;
+  if (!port) throw new Error("Plugin views need the MCP runtime, which is not available here.");
+  const outcome = discover(context, workspace);
+  const plugin = outcome.plugins.find((candidate) => candidate.id === pluginId);
+  if (!plugin) throw new Error(`Plugin not found: ${pluginId}`);
+  const view = plugin.views?.find((candidate) => candidate.id === viewId);
+  if (!view) throw new Error(`Plugin ${pluginId} has no view ${viewId}.`);
+  if (!plugin.enabled) throw new Error(`Enable ${plugin.name} in Settings → Plugins to open this view.`);
+  if (plugin.grant && !plugin.grant.granted) {
+    throw new Error(`Allow ${plugin.name} in Settings → Plugins to open this view.`);
+  }
+  const serverName = `plugin:${plugin.name}:${view.server}`;
+  const config: McpServerConfig | undefined = outcome.mcpServers[serverName];
+  if (!config) throw new Error(`The view's server ${view.server} could not be started; see the plugin's diagnostics.`);
+  const status = (await port.status())[serverName];
+  if (status?.status !== "connected") {
+    const connected = await port.connectServer(serverName, config, { workingDirectory: workspace.workspacePath });
+    if (connected.status !== "connected") {
+      throw new Error(connected.error ?? `The view's server ${view.server} did not connect.`);
+    }
+  }
+  return { port, resource: view.resource, serverName };
+}
+
+function discover(
+  context: ZCodeProtocolAgentServerContext,
+  workspace: { workspacePath: string; workspaceKey?: string },
+): PluginLoadOutcome {
+  const configResult = createConfig({ env: context.deps.env, workingDirectory: workspace.workspacePath });
+  const cliStorageRoot = getCliStorageRoot(resolvePath(configResult.config.storage.dir));
+  return resolveStartupPlugins({
+    cliStorageRoot,
+    configResult,
+    env: context.deps.env,
+    logger: context.logger,
+    options: {},
+    startupTimer: new StartupTimer(
+      context.logger ?? noopLogger,
+      { module: "bootstrap.zcode_protocol.plugin_views", workspacePath: workspace.workspacePath },
+      startupNow(),
+    ),
+    workingDirectory: workspace.workspacePath,
+  });
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function stringList(value: unknown): string[] | undefined {
+  return Array.isArray(value) && value.every((item) => typeof item === "string") ? value : undefined;
+}
