+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import { join, resolve } from "node:path";
+import test from "node:test";
+import { createMcpAdapter } from "@zcode/adapters/mcp";
+import { callPluginViewTool, readPluginView } from "../src/zcode-protocol/plugin-views.js";
+import { resolveZCodePlugins, setZCodePluginEnabled } from "../src/plugins.js";
+
+// OV-100 phase 4: a plugin view is an MCP Apps ui:// resource of the plugin's own server; the view
+// reaches that server only through the host, and a disabled plugin's view does not run.
+test("a plugin view is read from its own MCP server and calls that server's tools", { timeout: 60000 }, async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-plugin-view-"));
+  const previousHome = process.env.HOME;
+  const mcpPort = createMcpAdapter();
+  try {
+    const home = join(root, "home");
+    const workspace = join(root, "workspace");
+    const plugin = join(root, "counter-plugin");
+    for (const dir of [workspace, join(home, ".zcode", "cli"), join(plugin, ".zcode-plugin")]) await mkdir(dir, { recursive: true });
+    const server = resolve(import.meta.dirname, "fixtures/plugin-view/server.mjs");
+    await writeFile(
+      join(plugin, ".zcode-plugin", "plugin.json"),
+      JSON.stringify({
+        name: "counter",
+        version: "1.0.0",
+        mcpServers: { counter: { command: process.execPath, args: [server] } },
+        fleet: { views: [{ id: "main", title: "Counter", server: "counter", resource: "ui://counter/main" }, { id: "Bad View", server: "missing", resource: "x" }] },
+      }),
+    );
+    const userConfigPath = join(home, ".zcode", "cli", "config.json");
+    await writeFile(userConfigPath, JSON.stringify({ storage: { dir: join(root, "storage") }, plugins: { dirs: [plugin] } }));
+    process.env.HOME = home;
+
+    const paths = { env: {}, officialPluginRoots: [], userConfigPath, workingDirectory: workspace };
+    const discovered = resolveZCodePlugins(paths);
+    const info = discovered.plugins.find((entry) => entry.name === "counter")!;
+    assert.deepEqual(info.views?.map((view) => view.id), ["main"], "invalid views are dropped");
+    assert.ok(discovered.diagnostics.some((diagnostic) => diagnostic.code === "plugin_view_invalid"));
+
+    const context = { deps: { env: process.env, mcpPort }, logger: undefined } as never;
+    const ref = { workspacePath: workspace, workspaceKey: workspace };
+    const view = await readPluginView(context, { workspace: ref, pluginId: info.id, viewId: "main" });
+    assert.match(view.html, /ui\/initialize/);
+    assert.equal(view.prefersBorder, false);
+
+    const first = await callPluginViewTool(context, { workspace: ref, pluginId: info.id, viewId: "main", tool: "increment" });
+    const second = await callPluginViewTool(context, { workspace: ref, pluginId: info.id, viewId: "main", tool: "increment" });
+    assert.deepEqual([first.structuredContent, second.structuredContent], [{ value: 1 }, { value: 2 }]);
+
+    await setZCodePluginEnabled({ ...paths, enabled: false, plugin: info.id });
+    await assert.rejects(
+      readPluginView(context, { workspace: ref, pluginId: info.id, viewId: "main" }),
+      /Enable counter/,
+    );
+  } finally {
+    process.env.HOME = previousHome;
+    await mcpPort.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
