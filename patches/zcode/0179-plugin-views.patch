diff --git a/packages/ui/src/app-shell/PluginViewPane.tsx b/packages/ui/src/app-shell/PluginViewPane.tsx
new file mode 100644
index 0000000..c0e6912
--- /dev/null
+++ b/packages/ui/src/app-shell/PluginViewPane.tsx
@@ -0,0 +1,300 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Loader2, RotateCcw } from "lucide-react";
+import type { ZCodePluginViewReadResult } from "@zcode/shared";
+import { Button } from "@/components/ui/button.js";
+import { useWorkspaceServicesResolution } from "@/hooks/useWorkspaceServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { logger } from "@/logger.js";
+
+/**
+ * Host surface for a plugin view (OV-100 phase 4).
+ *
+ * The view is an MCP Apps `ui://` HTML resource (SEP-1865, `mcp-apps` 2026-01-26) from the plugin's
+ * own MCP server. It runs in an opaque-origin iframe (`sandbox="allow-scripts"`, no same-origin)
+ * under a CSP built from the resource's declared domains, and talks JSON-RPC over postMessage.
+ * Fleet answers `ui/initialize` with its theme tokens and proxies `tools/call` only to that plugin's
+ * server, through the same runtime the workspace's conversations use.
+ */
+
+const PROTOCOL_VERSION = "2026-01-26";
+const DOMAIN_PATTERN = /^https?:\/\/[A-Za-z0-9.*:-]+$/;
+
+// MCP Apps standardized theme variables ← Fleet design tokens (DESIGN.md plugin UI contract).
+const THEME_VARIABLES: Record<string, string> = {
+  "--color-background-primary": "--color-background",
+  "--color-background-secondary": "--color-panel",
+  "--color-background-tertiary": "--color-card",
+  "--color-background-ghost": "--color-hover",
+  "--color-background-danger": "--color-destructive",
+  "--color-text-primary": "--color-foreground",
+  "--color-text-secondary": "--color-foreground-subtle",
+  "--color-text-tertiary": "--color-foreground-subtlest",
+  "--color-text-inverse": "--color-foreground-inverse",
+  "--color-text-danger": "--color-destructive",
+  "--color-border-primary": "--color-border",
+  "--color-border-secondary": "--color-border-hover",
+};
+
+interface JsonRpcMessage {
+  jsonrpc?: string;
+  id?: string | number;
+  method?: string;
+  params?: Record<string, unknown>;
+}
+
+function domainList(values: readonly string[] | undefined): string {
+  return (values ?? []).filter((value) => DOMAIN_PATTERN.test(value)).join(" ");
+}
+
+/** The view's CSP: the MCP Apps restrictive default plus only the domains the resource declared. */
+export function buildPluginViewDocument(view: ZCodePluginViewReadResult): string {
+  const resources = domainList(view.csp?.resourceDomains);
+  const connect = domainList(view.csp?.connectDomains);
+  const policy = [
+    "default-src 'none'",
+    `script-src 'unsafe-inline' ${resources}`.trim(),
+    `style-src 'unsafe-inline' ${resources}`.trim(),
+    `img-src data: blob: ${resources}`.trim(),
+    `font-src data: ${resources}`.trim(),
+    `media-src data: blob: ${resources}`.trim(),
+    `connect-src ${connect || "'none'"}`,
+    "frame-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "form-action 'none'",
+  ].join("; ");
+  const meta = `<meta http-equiv="Content-Security-Policy" content="${policy}">`;
+  return /<head[^>]*>/i.test(view.html)
+    ? view.html.replace(/<head[^>]*>/i, (head) => `${head}${meta}`)
+    : `${meta}${view.html}`;
+}
+
+function themeVariables(): Record<string, string> {
+  const style = getComputedStyle(document.documentElement);
+  const variables: Record<string, string> = {};
+  for (const [appVariable, fleetVariable] of Object.entries(THEME_VARIABLES)) {
+    const value = style.getPropertyValue(fleetVariable).trim();
+    if (value) variables[appVariable] = value;
+  }
+  const font = getComputedStyle(document.body).fontFamily;
+  if (font) variables["--font-sans"] = font;
+  return variables;
+}
+
+function currentTheme(): "light" | "dark" {
+  return document.documentElement.classList.contains("dark") ? "dark" : "light";
+}
+
+export function PluginViewPane({
+  workspacePath,
+  workspaceIdentity,
+  pluginId,
+  viewId,
+  title,
+  onOpenBrowserUrl,
+}: {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  pluginId: string;
+  viewId: string;
+  title: string;
+  onOpenBrowserUrl: (url: string) => void;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const resolution = useWorkspaceServicesResolution(workspacePath, null, workspaceIdentity);
+  const { pluginManagementService } = resolution.services;
+  const frameRef = useRef<HTMLIFrameElement | null>(null);
+  const [view, setView] = useState<ZCodePluginViewReadResult | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  const target = useMemo(
+    () => ({ workspacePath, ...(workspaceIdentity ? { workspaceIdentity } : {}), pluginId, viewId }),
+    [pluginId, viewId, workspaceIdentity, workspacePath],
+  );
+
+  useEffect(() => {
+    if (!resolution.rpcReady) return;
+    let cancelled = false;
+    setView(null);
+    setError(null);
+    pluginManagementService
+      .readPluginView(target)
+      .then((result) => {
+        if (!cancelled) setView(result);
+      })
+      .catch((reason: unknown) => {
+        if (!cancelled) setError(reason instanceof Error ? reason.message : String(reason));
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [attempt, pluginManagementService, resolution.rpcReady, target]);
+
+  const post = useCallback((message: Record<string, unknown>) => {
+    frameRef.current?.contentWindow?.postMessage({ jsonrpc: "2.0", ...message }, "*");
+  }, []);
+
+  useEffect(() => {
+    if (!view) return;
+    const respond = (id: string | number, result: unknown) => post({ id, result });
+    const fail = (id: string | number, message: string, code = -32603) =>
+      post({ id, error: { code, message } });
+    const handle = async (message: JsonRpcMessage) => {
+      const { id, method, params = {} } = message;
+      if (!method) return;
+      if (id === undefined) {
+        if (method === "notifications/message") logger.info("[plugin-view]", { pluginId, viewId, params });
+        return;
+      }
+      switch (method) {
+        case "ui/initialize":
+          return respond(id, {
+            protocolVersion: typeof params.protocolVersion === "string" ? params.protocolVersion : PROTOCOL_VERSION,
+            hostInfo: { name: "Fleet", version: "1" },
+            hostCapabilities: { openLinks: {}, serverTools: {}, logging: {} },
+            hostContext: {
+              theme: currentTheme(),
+              styles: { variables: themeVariables() },
+              displayMode: "inline",
+              availableDisplayModes: ["inline"],
+              locale,
+              timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
+              platform: "desktop",
+            },
+          });
+        case "ping":
+          return respond(id, {});
+        case "tools/call": {
+          const name = typeof params.name === "string" ? params.name : "";
+          if (!name) return fail(id, "tools/call needs a tool name", -32602);
+          try {
+            const args =
+              params.arguments && typeof params.arguments === "object"
+                ? (params.arguments as Record<string, unknown>)
+                : undefined;
+            return respond(
+              id,
+              await pluginManagementService.callPluginViewTool({ ...target, tool: name, ...(args ? { arguments: args } : {}) }),
+            );
+          } catch (reason) {
+            return fail(id, reason instanceof Error ? reason.message : String(reason));
+          }
+        }
+        case "ui/open-link": {
+          const url = typeof params.url === "string" ? params.url : "";
+          if (!/^https?:\/\//.test(url)) return fail(id, "Only http(s) links can be opened", -32602);
+          onOpenBrowserUrl(url);
+          return respond(id, {});
+        }
+        default:
+          return fail(id, `${method} is not supported by Fleet yet`, -32601);
+      }
+    };
+    const listener = (event: MessageEvent) => {
+      // Only the view's own frame may talk to the host bridge.
+      if (event.source !== frameRef.current?.contentWindow) return;
+      const data = event.data as JsonRpcMessage;
+      if (!data || typeof data !== "object" || data.jsonrpc !== "2.0") return;
+      void handle(data);
+    };
+    window.addEventListener("message", listener);
+    // Keep the view's theme in step with Fleet's.
+    const observer = new MutationObserver(() =>
+      post({
+        method: "ui/notifications/host-context-changed",
+        params: { theme: currentTheme(), styles: { variables: themeVariables() } },
+      }),
+    );
+    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
+    return () => {
+      window.removeEventListener("message", listener);
+      observer.disconnect();
+    };
+  }, [locale, onOpenBrowserUrl, pluginId, pluginManagementService, post, target, view, viewId]);
+
+  if (error) {
+    return (
+      <div className="flex h-full flex-col items-center justify-center gap-3 p-6 text-center" data-testid="plugin-view-error">
+        <p className="max-w-sm text-ui-base text-foreground-subtle">{error}</p>
+        <Button type="button" variant="outline" size="sm" onClick={() => setAttempt((value) => value + 1)}>
+          <RotateCcw data-icon="inline-start" aria-hidden="true" />
+          {intl.formatMessage({ id: "common.retry" })}
+        </Button>
+      </div>
+    );
+  }
+  if (!view) {
+    return (
+      <div className="flex h-full items-center justify-center text-foreground-subtle" data-testid="plugin-view-loading">
+        <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+      </div>
+    );
+  }
+  return (
+    <iframe
+      ref={frameRef}
+      title={title}
+      data-testid="plugin-view-frame"
+      data-plugin-id={pluginId}
+      sandbox="allow-scripts"
+      srcDoc={buildPluginViewDocument(view)}
+      className="h-full w-full border-0 bg-background"
+    />
+  );
+}
+
+/**
+ * "+" menu entries for views of enabled plugins whose servers may run. Loaded when the menu opens,
+ * so the side pane does not query plugins on every render.
+ */
+export function PluginViewMenuItems({
+  workspacePath,
+  workspaceIdentity,
+  onOpenPluginView,
+  renderItem,
+}: {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  onOpenPluginView: (view: { pluginId: string; viewId: string; title: string }) => void;
+  renderItem: (item: { key: string; title: string; onSelect: () => void }) => React.ReactNode;
+}) {
+  const { locale } = useZCodeIntl();
+  const resolution = useWorkspaceServicesResolution(workspacePath, null, workspaceIdentity);
+  const { pluginManagementService } = resolution.services;
+  const [views, setViews] = useState<Array<{ pluginId: string; viewId: string; title: string }>>([]);
+  useEffect(() => {
+    if (!resolution.rpcReady) return;
+    let cancelled = false;
+    pluginManagementService
+      .listPlugins({ workspacePath, ...(workspaceIdentity ? { workspaceIdentity } : {}) })
+      .then((result) => {
+        if (cancelled) return;
+        setViews(
+          result.plugins
+            .filter((plugin) => plugin.enabled && plugin.grant?.granted !== false)
+            .flatMap((plugin) =>
+              (plugin.views ?? []).map((view) => ({
+                pluginId: plugin.id,
+                viewId: view.id,
+                title: view.titleI18n?.[locale] ?? view.title,
+              })),
+            ),
+        );
+      })
+      .catch((reason: unknown) => logger.warn("[plugin-view] listing views failed", { reason: String(reason) }));
+    return () => {
+      cancelled = true;
+    };
+  }, [locale, pluginManagementService, resolution.rpcReady, workspaceIdentity, workspacePath]);
+  return (
+    <>
+      {views.map((view) =>
+        renderItem({
+          key: `${view.pluginId}:${view.viewId}`,
+          title: view.title,
+          onSelect: () => onOpenPluginView(view),
+        }),
+      )}
+    </>
+  );
+}
