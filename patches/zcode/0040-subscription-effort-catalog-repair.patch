+  /** Retire an early Codex catalog snapshot only when a newer account read proves its lone
+   * synthetic off level was stale. Explicit manual rules and changed smart overrides survive. */
+  withoutLegacySubscriptionOffSnapshots(
+    providerId: string,
+    models: readonly { modelId: string; config: ModelConfig }[],
+  ): ModelConfigRules {
+    const observed = new Map(models.map((model) => [model.modelId, model.config.toJSON()]));
+    return new ModelConfigRules(this.#rules.filter((rule) => {
+      if (rule.type !== "provider-model" || rule.providerId !== providerId) return true;
+      const current = rule.config.toJSON();
+      const latest = observed.get(rule.modelId);
+      if (!latest || current.enabled !== true || !current.properties?.contextWindow) return true;
+      const oldReasoning = current.optionSpecs?.reasoningLevel;
+      const newReasoning = latest.optionSpecs?.reasoningLevel;
+      if (
+        oldReasoning?.map !== "{}" ||
+        oldReasoning.values?.length !== 1 || oldReasoning.values[0] !== "off" ||
+        oldReasoning.defaultValue !== undefined ||
+        !newReasoning?.values?.some((level) => level !== "off") ||
+        Object.keys(current.optionSpecs ?? {}).length !== 1 ||
+        JSON.stringify(current.properties) !== JSON.stringify(latest.properties)
+      ) return true;
+      return false;
+    }));
+  }
+
