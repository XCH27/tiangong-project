+test("a legacy synthetic Off snapshot yields to the verified account's effort catalog", async () => {
+  const f = await fixture();
+  try {
+    const properties = { contextWindow: 272000, inputFormat: {
+      supportsText: true, supportsImage: true, supportsVideo: false,
+      supportsAudio: false, supportsPdf: false,
+    } };
+    await f.service.addPersonalModel(f.providerId, "gpt-6-sol", {
+      enabled: true, properties,
+      optionSpecs: { reasoningLevel: { values: ["off"], map: "{}" } },
+    });
+    f.setCatalog(async () => ({
+      source: "provider", models: [{ id: "gpt-6-sol", name: "gpt-6-sol", config: {
+        properties,
+        optionSpecs: { reasoningLevel: {
+          values: ["low", "medium", "high", "xhigh", "max"],
+          defaultValue: "medium", map: "{}",
+        }, speedMode: "openai-priority" },
+      } }],
+    }));
+    await f.service.discoverModels(f.providerId);
+    assert.equal((await f.stored()).providerModelRules.some(
+      (row: { modelId: string }) => row.modelId === "gpt-6-sol",
+    ), false);
+    const model = (await f.models()).find((row) => row.modelId === "gpt-6-sol")!;
+    assert.deepEqual(model.effectiveConfig.optionSpecs?.reasoningLevel?.values,
+      ["low", "medium", "high", "xhigh", "max"]);
+    assert.equal(completeNewModelSelection(await f.selection(), {
+      providerId: f.providerId, modelId: "gpt-6-sol",
+    })?.options?.reasoningLevel, "medium");
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("subscription refresh preserves disabled or materially edited exact settings", () => {
+  const observed = [{ modelId: "m", config: parseModelConfig({
+    properties: { contextWindow: 272000 },
+    optionSpecs: { reasoningLevel: { values: ["low", "high"], map: "{}" } },
+  }) }];
+  for (const legacy of [
+    { enabled: false, properties: { contextWindow: 272000 } },
+    { enabled: true, properties: { contextWindow: 128000 } },
+  ]) {
+    const exact = parseModelConfig({ ...legacy,
+      optionSpecs: { reasoningLevel: { values: ["off"], map: "{}" } },
+    });
+    const rules = ModelConfigRules.empty().setExact("provider", "m", exact);
+    assert.deepEqual(rules.withoutLegacySubscriptionOffSnapshots("provider", observed)
+      .getExact("provider", "m")?.toJSON(), exact.toJSON());
+  }
+});
