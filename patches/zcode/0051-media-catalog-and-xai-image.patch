diff --git a/apps/zcode-cli/packages/core/src/tool/handlers/media-generation.ts b/apps/zcode-cli/packages/core/src/tool/handlers/media-generation.ts
new file mode 100644
index 0000000..b19ce5c
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/handlers/media-generation.ts
@@ -0,0 +1,285 @@
+import {
+  GENERATE_IMAGE_TOOL_NAME,
+  GenerateImageInputJsonSchema,
+  GenerateImageInputSchema,
+  GenerateImageExecutionInputSchema,
+  GenerateImageOutputJsonSchema,
+  GenerateImageOutputSchema,
+  LIST_MEDIA_MODELS_TOOL_NAME,
+  ListMediaModelsInputJsonSchema,
+  ListMediaModelsInputSchema,
+  ListMediaModelsOutputJsonSchema,
+  ListMediaModelsOutputSchema,
+  createRootTraceContext,
+  type MediaGenerationPort,
+  type ModelMessageContent,
+  type UsageStorePort,
+} from "@zcode/contracts";
+import type { ToolEntry, ToolHandler } from "../types.js";
+
+const imageData = Symbol("generated-image-data");
+
+type PrivateImageOutput = ReturnType<typeof GenerateImageOutputSchema.parse> & {
+  [imageData]: string;
+};
+
+function imageModelContent(output: unknown): ModelMessageContent {
+  const result = output as PrivateImageOutput;
+  if (!result || typeof result !== "object" || typeof result[imageData] !== "string") {
+    return JSON.stringify(output);
+  }
+  return [
+    {
+      type: "text",
+      text: `Generated image saved as ${result.artifactUri} with ${result.reportedModelId}. ${result.reportedCostUsd === undefined ? "The provider did not report a cost." : `Provider-reported cost: US$${result.reportedCostUsd.toFixed(4)}.`}${result.usageRecorded ? "" : " Usage ledger write failed; tell the user that the Usage page may undercount this request."}`,
+    },
+    {
+      type: "image",
+      mediaType: result.mimeType,
+      dataUrl: result[imageData],
+      source: {
+        id: result.artifactUri,
+        kind: "inline",
+        uri: result.artifactUri,
+        mimeType: result.mimeType,
+        placeholder: "Generated image",
+      },
+    },
+  ];
+}
+
+export function createMediaGenerationToolEntries(
+  port: MediaGenerationPort,
+): [ToolEntry, ToolEntry] {
+  const listHandler: ToolHandler = async (input) => {
+    const { kind } = ListMediaModelsInputSchema.parse(input);
+    return ListMediaModelsOutputSchema.parse({
+      models: port.listModels().filter((model) => !kind || model.kind === kind),
+    });
+  };
+  const generateHandler: ToolHandler = async (input, context) => {
+    const request = GenerateImageExecutionInputSchema.parse(input);
+    if (!context.artifactStore) {
+      throw new Error("Generated image storage is unavailable; no provider request was made");
+    }
+    const usageStore = context.sessionStore as Partial<UsageStorePort> | undefined;
+    if (typeof usageStore?.recordModelUsage !== "function") {
+      throw new Error("Media usage ledger is unavailable; no paid provider request was made");
+    }
+    const startedAt = Date.now();
+    const usageBase = {
+      id: `media-image:${context.sessionId}:${context.toolCallId}`,
+      logicalRequestId: context.toolCallId,
+      sessionID: context.sessionId,
+      ...(context.turnId ? { turnID: context.turnId } : {}),
+      traceID: context.traceId,
+      querySource: "media_image",
+      providerId: request.providerId,
+      modelId: request.modelId,
+      startedAt,
+      providerMetadata: {
+        fleetAccounting: {
+          billingProvider: "xai",
+          workspacePath: context.workspaceRoot,
+        },
+      },
+    } as const;
+    let generated: Awaited<ReturnType<MediaGenerationPort["generateImage"]>>;
+    try {
+      generated = await port.generateImage({
+        ...request,
+        signal: context.abortSignal,
+      });
+    } catch (error) {
+      await usageStore
+        .recordModelUsage({
+          ...usageBase,
+          status: context.abortSignal.aborted ? "cancelled" : "error",
+          completedAt: Date.now(),
+          errorMessage: error instanceof Error ? error.message : String(error),
+        })
+        .catch(() => undefined);
+      throw error;
+    }
+    const completedAt = Date.now();
+    let usageRecorded = true;
+    try {
+      await usageStore.recordModelUsage({
+        ...usageBase,
+        modelId: generated.reportedModelId,
+        status: "completed",
+        completedAt,
+        durationMs: completedAt - startedAt,
+        providerMetadata: {
+          fleetAccounting: {
+            billingProvider: "xai",
+            workspacePath: context.workspaceRoot,
+            requestedModelId: request.modelId,
+            ...(generated.reportedCostUsd === undefined
+              ? {}
+              : { reportedMediaUsd: generated.reportedCostUsd }),
+          },
+        },
+      });
+    } catch {
+      usageRecorded = false;
+    }
+    const dataUrl = `data:${generated.mimeType};base64,${Buffer.from(generated.bytes).toString("base64")}`;
+    const artifact = await context.artifactStore.writeToolResultArtifact(
+      {
+        content: dataUrl,
+        contentType: "text/plain",
+        retention: "session",
+        sessionId: context.sessionId,
+        toolCallId: context.toolCallId,
+        toolName: GENERATE_IMAGE_TOOL_NAME,
+        trace: context.traceContext ?? createRootTraceContext({ sessionId: context.sessionId }),
+        ...(context.turnId ? { turnId: context.turnId } : {}),
+      },
+      { signal: context.abortSignal },
+    );
+    const publicOutput = GenerateImageOutputSchema.parse({
+      artifactUri: artifact.uri,
+      providerId: request.providerId,
+      requestedModelId: request.modelId,
+      reportedModelId: generated.reportedModelId,
+      mimeType: generated.mimeType,
+      ...(generated.reportedCostUsd === undefined
+        ? {}
+        : { reportedCostUsd: generated.reportedCostUsd }),
+      usageRecorded,
+    });
+    // 原图只走 modelContent + Session artifact；工具 JSON 不复制一份 base64。
+    return Object.defineProperty(publicOutput, imageData, { value: dataUrl });
+  };
+  return [
+    {
+      capability: "List image/video generation models reported for connected API credentials",
+      metadata: {
+        name: LIST_MEDIA_MODELS_TOOL_NAME,
+        description:
+          "List media models reported for this host, separately from conversation models. Image status=requires-check means GenerateImage verifies the current key before payment. Video status=catalog-only means video generation is not yet executable in Fleet.",
+        readOnly: true,
+        destructive: false,
+        concurrentSafe: true,
+        timeoutMs: 10000,
+        maxOutputBytes: 16000,
+        sideEffectScope: "none",
+        riskLevel: "low",
+        needsApproval: false,
+      },
+      handler: listHandler,
+      inputSchema: ListMediaModelsInputJsonSchema,
+      outputSchema: ListMediaModelsOutputJsonSchema,
+      runtimeInputSchema: ListMediaModelsInputSchema,
+      runtimeOutputSchema: ListMediaModelsOutputSchema,
+      permission: {
+        permission: "media.models.read",
+        reason: "List only the connected media models on this host",
+        riskLevel: "low",
+        sideEffectScope: "none",
+        needsApproval: false,
+        patternSources: ["toolName"],
+        alwaysAllowPatternSources: ["toolName"],
+        denyPriority: "beforeAsk",
+      },
+      resultBudget: {
+        maxInlineBytes: 16000,
+        maxModelBytes: 16000,
+        strategy: "truncate",
+        preview: { maxBytes: 16000, direction: "head" },
+      },
+      timeout: { kind: "timed", defaultMs: 10000, maxMs: 10000, allowCallOverride: false },
+      cancellation: {
+        supported: false,
+        cleanup: "none",
+        userVisibleMessage: "Listing connected media models",
+      },
+      trace: {
+        required: true,
+        propagateToAdapters: false,
+        recordInput: "summary",
+        recordOutput: "summary",
+      },
+    },
+    {
+      capability:
+        "Generate one image using a selected paid API media model and save the result in this Session",
+      metadata: {
+        name: GENERATE_IMAGE_TOOL_NAME,
+        description:
+          "Generate one image from a text prompt using an exact providerId/modelId returned by ListMediaModels. This makes a paid provider request. It saves the image in this Session and reports provider cost when available. Never use a conversation-only model ID.",
+        readOnly: false,
+        destructive: false,
+        concurrentSafe: false,
+        timeoutMs: 150000,
+        maxOutputBytes: 16000,
+        sideEffectScope: "network",
+        riskLevel: "high",
+        needsApproval: true,
+      },
+      handler: generateHandler,
+      async resolveInput(input) {
+        const parsed = GenerateImageInputSchema.safeParse(input);
+        if (!parsed.success) {
+          return { result: false, errorCode: 4101, message: "Invalid image generation request" };
+        }
+        try {
+          return {
+            result: true,
+            input: {
+              ...parsed.data,
+              binding: await port.prepareImage({
+                providerId: parsed.data.providerId,
+                modelId: parsed.data.modelId,
+                prompt: parsed.data.prompt,
+              }),
+            },
+          };
+        } catch (error) {
+          return {
+            result: false,
+            errorCode: 4102,
+            message:
+              error instanceof Error
+                ? `Image model check failed: ${error.message}`
+                : "Image model check failed; refresh the model list",
+          };
+        }
+      },
+      formatModelContent: imageModelContent,
+      inputSchema: GenerateImageInputJsonSchema,
+      outputSchema: GenerateImageOutputJsonSchema,
+      runtimeInputSchema: GenerateImageExecutionInputSchema,
+      runtimeOutputSchema: GenerateImageOutputSchema,
+      permission: {
+        permission: "media.generate.image",
+        reason: "GenerateImage makes a paid API request and stores its output in this Session",
+        riskLevel: "high",
+        sideEffectScope: "network",
+        needsApproval: true,
+        patternSources: ["toolName"],
+        alwaysAllowPatternSources: [],
+        denyPriority: "beforeAsk",
+      },
+      resultBudget: {
+        maxInlineBytes: 16000,
+        maxModelBytes: 16000,
+        strategy: "truncate",
+        preview: { maxBytes: 16000, direction: "head" },
+      },
+      timeout: { kind: "timed", defaultMs: 150000, maxMs: 150000, allowCallOverride: false },
+      cancellation: {
+        supported: true,
+        cleanup: "none",
+        userVisibleMessage: "Image generation was cancelled",
+      },
+      trace: {
+        required: true,
+        propagateToAdapters: true,
+        recordInput: "summary",
+        recordOutput: "summary",
+      },
+    },
+  ];
+}
diff --git a/apps/zcode-cli/packages/core/test/media-generation-tool.test.ts b/apps/zcode-cli/packages/core/test/media-generation-tool.test.ts
new file mode 100644
index 0000000..b96b4a0
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/media-generation-tool.test.ts
@@ -0,0 +1,135 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { MediaGenerationPort } from "@zcode/contracts";
+import type { ToolExecutionContext } from "../src/tool/types.js";
+import { createMediaGenerationToolEntries } from "../src/tool/handlers/media-generation.js";
+import { registerBuiltInTools } from "../src/tool/handlers/index.js";
+import { createToolRegistry } from "../src/tool/registry.js";
+import { persistToolResultMediaAttachments } from "../src/runtime/helpers/tool-result-media-persistence.js";
+
+test("image generation uses the Session artifact store and asks approval before a paid call", async () => {
+  const calls: string[] = [];
+  const port: MediaGenerationPort = {
+    listModels: () => [
+      {
+        providerId: "xai",
+        providerLabel: "xAI",
+        modelId: "grok-image",
+        kind: "image",
+        status: "requires-check",
+      },
+    ],
+    prepareImage: async () => "bound-connection",
+    async generateImage(input) {
+      calls.push(`${input.providerId}/${input.modelId}:${input.prompt}:${input.binding}`);
+      return {
+        bytes: Buffer.from([0xff, 0xd8, 0xff, 0xe0]),
+        mimeType: "image/jpeg",
+        reportedModelId: "grok-image",
+        reportedCostUsd: 0.04,
+      };
+    },
+  };
+  const writes: Array<{ content: string; toolCallId: string }> = [];
+  const usage: Array<{ querySource: string; modelId: string; providerMetadata?: unknown }> = [];
+  const context = {
+    abortSignal: new AbortController().signal,
+    sessionId: "session-1",
+    toolCallId: "call-1",
+    workspaceRoot: "/project",
+    sessionStore: {
+      recordModelUsage: async (value: (typeof usage)[number]) => {
+        usage.push(value);
+      },
+    },
+    artifactStore: {
+      async writeToolResultArtifact(input: { content: string; toolCallId: string }) {
+        writes.push(input);
+        return { uri: "zcode-artifact://session-1/generated-image" };
+      },
+    },
+  } as unknown as ToolExecutionContext;
+  const [list, generate] = createMediaGenerationToolEntries(port);
+  assert.equal(generate.metadata.needsApproval, true);
+  assert.deepEqual(await list.handler({}, context), { models: port.listModels() });
+  const submitted = {
+    providerId: "xai",
+    modelId: "grok-image",
+    prompt: "A blue square",
+  };
+  const resolved = await generate.resolveInput?.(submitted, {} as never);
+  assert.deepEqual(resolved, {
+    result: true,
+    input: { ...submitted, binding: "bound-connection" },
+  });
+  const result = await generate.handler((resolved as { input: unknown }).input, context);
+  assert.deepEqual(calls, ["xai/grok-image:A blue square:bound-connection"]);
+  assert.equal(writes.length, 1);
+  assert.equal(usage[0]?.querySource, "media_image");
+  assert.equal(usage[0]?.modelId, "grok-image");
+  assert.match(JSON.stringify(usage[0]?.providerMetadata), /reportedMediaUsd/);
+  assert.match(writes[0]!.content, /^data:image\/jpeg;base64,/);
+  assert.equal(JSON.stringify(result).includes("/9j/"), false);
+  const content = generate.formatModelContent?.(result);
+  assert.equal(Array.isArray(content), true);
+  assert.match(JSON.stringify(content), /zcode-artifact:\/\/session-1\/generated-image/);
+  assert.match(JSON.stringify(content), /data:image\/jpeg;base64,/);
+  const persisted = await persistToolResultMediaAttachments({
