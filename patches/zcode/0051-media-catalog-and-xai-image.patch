+/** xAI's generic /models has no output class; these key-scoped catalogs are the route authority. */
+async function discoverXaiModels(
+  origin: string,
+  headers: Headers,
+  fetch: typeof globalThis.fetch,
+): Promise<ModelDiscoveryResult> {
+  const models = new Map<string, DiscoveredModel>();
+  const warnings: NonNullable<ModelDiscoveryResult["warnings"]> = [];
+  const deadline = AbortSignal.timeout(20_000);
+  for (const [route, output, kind] of [
+    ["language-models", "text", "text"],
+    ["image-generation-models", "image", "image"],
+    ["video-generation-models", "video", "video"],
+  ] as const) {
+    const response = await fetch(`${origin}/v1/${route}`, {
+      headers,
+      signal: deadline,
+      redirect: "error",
+    });
+    if (!response.ok) {
+      await response.body?.cancel();
+      if (response.status === 403 || response.status === 404) {
+        warnings.push({ kind, status: response.status });
+        continue;
+      }
+      throw new Error(`Model list request failed (${response.status}) for ${route}`);
+    }
+    const body = (await readModelListPage(response)) as { models?: unknown };
+    if (!Array.isArray(body.models)) {
+      throw new Error(`The provider returned an unsupported ${route} catalog`);
+    }
+    for (const value of body.models) {
+      if (!value || typeof value !== "object" || Array.isArray(value)) continue;
+      const item = value as Record<string, unknown>;
+      const id = typeof item.id === "string" ? item.id.trim() : "";
+      if (!id) continue;
+      const reportedOutputs = item.output_modalities;
+      if (Array.isArray(reportedOutputs) && !reportedOutputs.includes(output)) {
+        throw new Error(`The provider returned a conflicting ${route} output for ${id}`);
+      }
+      const config = readDiscoveredModelMetadata({
+        ...item,
+        output_modalities: reportedOutputs ?? [output],
+      });
+      const name =
+        typeof item.name === "string" && item.name.trim()
+          ? item.name
+          : typeof item.display_name === "string" && item.display_name.trim()
+            ? item.display_name
+            : id;
+      const existing = models.get(id);
+      models.set(
+        id,
+        existing ? mergeDiscoveredOutput(existing, { id, name, config }) : { id, name, config },
+      );
+      if (models.size > MAX_MODEL_LIST_ENTRIES) {
+        throw new Error("The model list exceeds the supported entry limit");
+      }
+    }
+  }
+  if (warnings.length === 3) {
+    throw new Error(
+      `Model list request failed (${warnings[0]!.status}) for all xAI media catalogs`,
+    );
+  }
+  return {
+    source: "provider",
+    models: [...models.values()],
+    ...(warnings.length ? { warnings } : {}),
+  };
+}
+
+function mergeDiscoveredOutput(existing: DiscoveredModel, next: DiscoveredModel): DiscoveredModel {
+  const earlier = existing.config.properties?.outputFormat;
+  const later = next.config.properties?.outputFormat;
+  return {
+    ...existing,
+    config: {
+      ...existing.config,
+      properties: {
+        ...existing.config.properties,
+        ...next.config.properties,
+        outputFormat: {
+          supportsText: earlier?.supportsText === true || later?.supportsText === true,
+          supportsImage: earlier?.supportsImage === true || later?.supportsImage === true,
+          supportsVideo: earlier?.supportsVideo === true || later?.supportsVideo === true,
+        },
+      },
+      optionSpecs: existing.config.optionSpecs ?? next.config.optionSpecs,
+    },
+  };
+}
