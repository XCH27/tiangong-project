+import { z } from "zod";
+import { toToolJsonSchema } from "./json-schema.js";
+
+export const LIST_MEDIA_MODELS_TOOL_NAME = "ListMediaModels";
+export const GENERATE_IMAGE_TOOL_NAME = "GenerateImage";
