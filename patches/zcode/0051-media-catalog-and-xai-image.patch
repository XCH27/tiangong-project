+export const GenerateImageInputSchema = z
+  .object({
+    providerId: z.string().trim().min(1),
+    modelId: z.string().trim().min(1),
+    prompt: z.string().trim().min(1).max(32_000),
+  })
+  .strict();
+export const GenerateImageInputJsonSchema = toToolJsonSchema(GenerateImageInputSchema);
+export const GenerateImageExecutionInputSchema = GenerateImageInputSchema.extend({
+  binding: z.string().min(1),
+}).strict();
+
+export const GenerateImageOutputSchema = z
+  .object({
+    artifactUri: z.string().startsWith("zcode-artifact://"),
+    providerId: z.string(),
+    requestedModelId: z.string(),
+    reportedModelId: z.string(),
+    mimeType: z.enum(["image/jpeg", "image/png", "image/webp"]),
+    reportedCostUsd: z.number().nonnegative().optional(),
+    usageRecorded: z.boolean(),
+  })
+  .strict();
+export const GenerateImageOutputJsonSchema = toToolJsonSchema(GenerateImageOutputSchema);
