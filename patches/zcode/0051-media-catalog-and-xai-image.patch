+/** The Provider owner supplies only key-scoped, executable media models. */
+export interface MediaGenerationModel {
+  providerId: string;
+  providerLabel: string;
+  modelId: string;
+  kind: "image" | "video";
+  status: "requires-check" | "catalog-only";
+}
+
+export interface MediaGenerationPort {
+  listModels(): MediaGenerationModel[];
+  /** Opaque connection/model/key revision frozen before tool approval; never contains a credential. */
+  prepareImage(input: { providerId: string; modelId: string; prompt: string }): Promise<string>;
+  generateImage(input: {
+    providerId: string;
+    modelId: string;
+    prompt: string;
+    binding: string;
+    signal: AbortSignal;
+  }): Promise<{
+    bytes: Uint8Array;
+    mimeType: "image/jpeg" | "image/png" | "image/webp";
+    reportedModelId: string;
+    reportedCostUsd?: number;
+  }>;
+}
