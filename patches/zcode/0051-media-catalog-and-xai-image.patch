index 0000000..cde4609
--- /dev/null
+++ b/apps/zcode-cli/packages/bootstrap/src/app/xai-media-generation-port.ts
@@ -0,0 +1,248 @@
+import { getEnabledApiKeys } from "@zcode/provider";
+import type { HttpClientPort, MediaGenerationModel, MediaGenerationPort } from "@zcode/contracts";
+import { createHash } from "node:crypto";
+
+interface MediaRegistrySource {
+  getSnapshot(): {
+    sourceRevisions: { config: string };
+    resolution: {
+      resolvedProviders: readonly {
+        providerId: string;
+        providerName?: string | null;
+        enabled: boolean;
+        providerIssues: readonly unknown[];
+        config: {
+          api?: { baseUrl?: string | null } | null;
+          access?: {
+            type: string;
+            apiKey?: string | null;
+            additionalApiKeys?: readonly string[] | null;
+            apiKeyEnabledFlags?: readonly boolean[] | null;
+          } | null;
+        };
+        models: readonly {
+          modelId: string;
+          enabled: boolean;
+          issues: readonly unknown[];
+          config: {
+            properties?: {
+              outputFormat?: {
+                supportsText?: boolean | null;
+                supportsImage?: boolean | null;
+                supportsVideo?: boolean | null;
+              } | null;
+            } | null;
+          };
+        }[];
+      }[];
+    };
+  } | null;
+}
+
+const MAX_RESPONSE_BYTES = 24 * 1024 * 1024;
+const MAX_IMAGE_BYTES = 16 * 1024 * 1024;
+
+export function createXaiMediaGenerationPort(input: {
+  registry: MediaRegistrySource;
+  http: Pick<HttpClientPort, "request">;
+}): MediaGenerationPort {
+  const available = () =>
+    input.registry.getSnapshot()?.resolution.resolvedProviders.flatMap((provider) => {
+      if (
+        !provider.enabled ||
+        provider.providerIssues.length ||
+        !isGlobalXaiApi(provider.config.api?.baseUrl)
+      ) {
+        return [];
+      }
+      const access = provider.config.access;
+      if (access?.type !== "api-key" || getEnabledApiKeys(access).length === 0) return [];
+      return provider.models.flatMap((model): MediaGenerationModel[] => {
+        if (!model.enabled || model.issues.length) return [];
+        const output = model.config.properties?.outputFormat;
+        return [
+          ...(output?.supportsImage === true
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "image" as const,
+                  status: "requires-check" as const,
+                },
+              ]
+            : []),
+          ...(output?.supportsVideo === true
+            ? [
+                {
+                  providerId: provider.providerId,
+                  providerLabel: provider.providerName?.trim() || provider.providerId,
+                  modelId: model.modelId,
+                  kind: "video" as const,
+                  status: "catalog-only" as const,
+                },
+              ]
+            : []),
+        ];
+      });
+    }) ?? [];
+  const imageBinding = (providerId: string, modelId: string, prompt: string) => {
+    const snapshot = input.registry.getSnapshot();
+    const provider = snapshot?.resolution.resolvedProviders.find(
+      (candidate) => candidate.providerId === providerId,
+    );
+    const model = provider?.models.find((candidate) => candidate.modelId === modelId);
+    const access = provider?.config.access;
+    const key = access?.type === "api-key" ? getEnabledApiKeys(access)[0] : undefined;
+    if (
+      !snapshot ||
+      !provider?.enabled ||
+      provider.providerIssues.length ||
+      !isGlobalXaiApi(provider.config.api?.baseUrl) ||
+      !model?.enabled ||
+      model.issues.length ||
+      model.config.properties?.outputFormat?.supportsImage !== true ||
+      !key
+    )
+      return null;
+    return {
+      key,
+      binding: createHash("sha256")
+        .update(JSON.stringify([snapshot.sourceRevisions.config, providerId, modelId, prompt, key]))
+        .digest("hex"),
+    };
+  };
+  return {
+    listModels: available,
+    async prepareImage({ providerId, modelId, prompt }) {
+      const selected = imageBinding(providerId, modelId, prompt);
+      if (!selected) throw new Error("Image generation model or connection is unavailable");
+      const response = await input.http.request(
+        {
+          url: `https://api.x.ai/v1/image-generation-models/${encodeURIComponent(modelId)}`,
+          method: "GET",
+          headers: { Authorization: `Bearer ${selected.key}`, Accept: "application/json" },
+          maxResponseBytes: 1024 * 1024,
+          timeoutMs: 10_000,
+          redirect: "manual",
+        },
+        { signal: AbortSignal.timeout(10_000) },
+      );
+      if (response.status !== 200) {
+        throw new Error(
+          `Image generation model is unavailable for this API key (HTTP ${response.status})`,
+        );
+      }
+      const detail = JSON.parse(Buffer.from(response.body).toString("utf8")) as Record<
+        string,
+        unknown
+      >;
+      const matchesId =
+        detail.id === modelId ||
+        (Array.isArray(detail.aliases) && detail.aliases.includes(modelId));
+      if (
+        !matchesId ||
+        (Array.isArray(detail.output_modalities) && !detail.output_modalities.includes("image"))
+      ) {
+        throw new Error("Provider did not confirm image generation for this model");
+      }
+      return selected.binding;
+    },
+    async generateImage(request) {
+      // 每次执行重新读取同一 Provider owner；设置页停用或删掉模型后不能沿用旧目录。
+      if (
+        !available().some(
+          (model) =>
+            model.kind === "image" &&
+            model.status === "requires-check" &&
+            model.providerId === request.providerId &&
+            model.modelId === request.modelId,
+        )
+      ) {
+        throw new Error("Image generation model or connection is unavailable");
+      }
+      const selected = imageBinding(request.providerId, request.modelId, request.prompt);
+      if (!selected) throw new Error("Image generation connection is unavailable");
+      if (selected.binding !== request.binding) {
+        throw new Error("Image generation connection changed after confirmation");
+      }
+      const response = await input.http.request(
+        {
+          url: "https://api.x.ai/v1/images/generations",
+          method: "POST",
+          headers: {
+            Authorization: `Bearer ${selected.key}`,
+            "Content-Type": "application/json",
+            Accept: "application/json",
+          },
+          body: Buffer.from(
+            JSON.stringify({
+              model: request.modelId,
+              prompt: request.prompt,
+              response_format: "b64_json",
+            }),
+          ),
+          maxResponseBytes: MAX_RESPONSE_BYTES,
+          timeoutMs: 120_000,
+          redirect: "manual",
+        },
+        { signal: request.signal },
+      );
+      if (response.status !== 200) {
+        throw new Error(`Image generation request failed (HTTP ${response.status})`);
+      }
+      const payload = JSON.parse(Buffer.from(response.body).toString("utf8")) as Record<
+        string,
+        unknown
+      >;
+      const image = Array.isArray(payload.data)
+        ? (payload.data[0] as Record<string, unknown> | undefined)
+        : undefined;
+      const encoded = typeof image?.b64_json === "string" ? image.b64_json : "";
+      if (
+        !encoded ||
+        encoded.length > MAX_IMAGE_BYTES * 2 ||
+        !/^[A-Za-z0-9+/]+={0,2}$/u.test(encoded)
+      ) {
+        throw new Error("Image generation returned no valid base64 image");
+      }
+      const bytes = Buffer.from(encoded, "base64");
+      if (bytes.length === 0 || bytes.length > MAX_IMAGE_BYTES) {
+        throw new Error("Image generation returned an invalid image size");
+      }
+      const mimeType = sniffImageMime(bytes);
+      if (!mimeType) throw new Error("Image generation returned an unsupported image format");
+      const ticks = (payload.usage as Record<string, unknown> | undefined)?.cost_in_usd_ticks;
+      return {
+        bytes,
+        mimeType,
+        reportedModelId: typeof payload.model === "string" ? payload.model : request.modelId,
+        ...(typeof ticks === "number" && Number.isFinite(ticks) && ticks >= 0
+          ? { reportedCostUsd: ticks / 10_000_000_000 }
+          : {}),
+      };
+    },
+  };
+}
+
+function isGlobalXaiApi(value: string | null | undefined): boolean {
+  if (!value) return false;
+  try {
+    const url = new URL(value);
+    return url.origin === "https://api.x.ai" && url.pathname.replace(/\/+$/, "") === "/v1";
+  } catch {
+    return false;
+  }
+}
+
+function sniffImageMime(bytes: Uint8Array): "image/jpeg" | "image/png" | "image/webp" | null {
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return "image/jpeg";
+  if (Buffer.from(bytes.subarray(0, 8)).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])))
+    return "image/png";
+  if (
+    Buffer.from(bytes.subarray(0, 4)).toString("ascii") === "RIFF" &&
+    Buffer.from(bytes.subarray(8, 12)).toString("ascii") === "WEBP"
+  )
+    return "image/webp";
+  return null;
+}
