+import assert from "node:assert/strict";
+import test from "node:test";
+import { createXaiMediaGenerationPort } from "../src/app/xai-media-generation-port.js";
+
+const imageBytes = Buffer.from("/9j/4AAQSkZJRg==", "base64");
+
+function fixture() {
+  const requests: Array<{
+    url: string;
+    method?: string;
+    headers?: Record<string, string>;
+    body?: Uint8Array;
+  }> = [];
+  let imageDetailStatus = 200;
+  const provider = {
+    providerId: "xai-account",
+    providerName: "xAI API",
+    enabled: true,
+    providerIssues: [],
+    config: {
+      api: { baseUrl: "https://api.x.ai/v1", type: "openai-responses" },
+      access: { type: "api-key", apiKey: "synthetic-key" },
+    },
+    models: [
+      {
+        modelId: "grok-text",
+        enabled: true,
+        issues: [],
+        config: { properties: { outputFormat: { supportsText: true } } },
+      },
+      {
+        modelId: "grok-image",
+        enabled: true,
+        issues: [],
+        config: { properties: { outputFormat: { supportsText: false, supportsImage: true } } },
+      },
+      {
+        modelId: "grok-video",
+        enabled: true,
+        issues: [],
+        config: { properties: { outputFormat: { supportsText: false, supportsVideo: true } } },
+      },
+    ],
+  };
+  const registry = {
+    getSnapshot: () => ({
+      sourceRevisions: { config: "revision-1" },
+      resolution: { resolvedProviders: [provider] },
+    }),
+  };
+  const http = {
+    async request(request: {
+      url: string;
+      method?: string;
+      headers?: Record<string, string>;
+      body?: Uint8Array;
+    }) {
+      requests.push(request);
+      if (request.method === "GET") {
+        return {
+          url: request.url,
+          status: imageDetailStatus,
+          statusText: imageDetailStatus === 200 ? "OK" : "Forbidden",
+          headers: {},
+          body: Buffer.from(JSON.stringify({ id: "grok-image", output_modalities: ["image"] })),
+          bytes: 70,
+          durationMs: 1,
+        };
+      }
+      return {
+        url: request.url,
+        status: 200,
+        statusText: "OK",
+        headers: {},
+        body: Buffer.from(
+          JSON.stringify({
+            data: [{ b64_json: imageBytes.toString("base64") }],
+            model: "grok-image",
+            usage: { cost_in_usd_ticks: 400000000 },
+          }),
+        ),
+        bytes: 100,
+        durationMs: 1,
+      };
+    },
+  };
+  return {
+    provider,
+    requests,
+    port: createXaiMediaGenerationPort({ registry, http }),
+    setImageDetailStatus(value: number) {
+      imageDetailStatus = value;
+    },
+  };
+}
+
+test("media model list follows the saved connection and excludes chat-only models", () => {
+  const { port } = fixture();
+  assert.deepEqual(
+    port.listModels().map((item) => [item.modelId, item.kind, item.status]),
+    [
+      ["grok-image", "image", "requires-check"],
+      ["grok-video", "video", "catalog-only"],
+    ],
+  );
+});
+
+test("image generation uses the bound API key, exact model and official endpoint", async () => {
+  const { port, requests } = fixture();
+  const binding = await port.prepareImage({
+    providerId: "xai-account",
+    modelId: "grok-image",
+    prompt: "A blue square",
+  });
+  const result = await port.generateImage({
+    providerId: "xai-account",
+    modelId: "grok-image",
+    prompt: "A blue square",
+    binding,
+    signal: new AbortController().signal,
+  });
+  assert.equal(requests.length, 2);
+  assert.equal(requests[0]?.url, "https://api.x.ai/v1/image-generation-models/grok-image");
+  assert.equal(requests[1]?.url, "https://api.x.ai/v1/images/generations");
+  assert.equal(requests[1]?.headers?.Authorization, "Bearer synthetic-key");
+  assert.deepEqual(JSON.parse(Buffer.from(requests[1]!.body!).toString()), {
+    model: "grok-image",
+    prompt: "A blue square",
+    response_format: "b64_json",
+  });
+  assert.deepEqual(result.bytes, imageBytes);
+  assert.equal(result.mimeType, "image/jpeg");
+  assert.equal(result.reportedCostUsd, 0.04);
+});
+
+test("a removed media model rejects before making a paid request", async () => {
+  const { provider, port, requests } = fixture();
+  provider.models[1]!.enabled = false;
+  await assert.rejects(
+    port.generateImage({
+      providerId: "xai-account",
+      modelId: "grok-image",
+      prompt: "A blue square",
+      binding: "stale-binding",
+      signal: new AbortController().signal,
+    }),
+    /unavailable/,
+  );
+  assert.equal(requests.length, 0);
+});
+
+test("a key change after confirmation cannot spend against another credential", async () => {
+  const { provider, port, requests } = fixture();
+  const binding = await port.prepareImage({
+    providerId: "xai-account",
+    modelId: "grok-image",
+    prompt: "A blue square",
+  });
+  provider.config.access.apiKey = "another-key";
+  await assert.rejects(
+    port.generateImage({
+      providerId: "xai-account",
+      modelId: "grok-image",
+      prompt: "A blue square",
+      binding,
+      signal: new AbortController().signal,
+    }),
+    /changed/,
+  );
+  assert.equal(requests.length, 1, "the prior read-only model check was the only request");
+});
+
+test("a changed prompt after confirmation is rejected before the paid endpoint", async () => {
+  const { port, requests } = fixture();
+  const binding = await port.prepareImage({
+    providerId: "xai-account",
+    modelId: "grok-image",
+    prompt: "A blue square",
+  });
+  await assert.rejects(
+    port.generateImage({
+      providerId: "xai-account",
+      modelId: "grok-image",
+      prompt: "A red square",
+      binding,
+      signal: new AbortController().signal,
+    }),
+    /changed/,
+  );
+  assert.equal(requests.length, 1);
+});
+
+test("an unentitled image model fails the read-only check before approval or payment", async () => {
+  const { port, requests, setImageDetailStatus } = fixture();
+  setImageDetailStatus(403);
+  await assert.rejects(
+    port.prepareImage({
+      providerId: "xai-account",
+      modelId: "grok-image",
+      prompt: "A blue square",
+    }),
+    /403/,
+  );
+  assert.equal(requests.length, 1);
+  assert.equal(requests[0]?.method, "GET");
+});
