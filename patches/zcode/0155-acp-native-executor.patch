+import type { ModelInputMessage } from "@zcode/contracts";
+
+const IMAGE_PLACEHOLDER = "[An attached image is not available to this executor in this turn]";
+
+function text(content: ModelInputMessage["content"], images: boolean): string {
+  if (typeof content === "string") return content;
+  return content
+    .map((block) =>
+      block.type === "text" ? block.text : block.type === "image" ? (images ? "" : IMAGE_PLACEHOLDER) : "",
+    )
+    .filter(Boolean)
+    .join("\n");
+}
+
+/**
+ * One prompt per Fleet turn for executors that own their conversation (agy, ACP CLIs). A resumed
+ * vendor session already holds its history, so only messages after the covered offset are sent;
+ * a fresh one receives Fleet instructions and the visible transcript once.
+ */
+export function nativeTranscriptPrompt(
+  messages: readonly ModelInputMessage[],
+  resumed: boolean,
+  offset = 0,
+  options: { images?: boolean } = {},
+): string {
+  const images = options.images === true;
+  const system = messages.filter((message) => message.role === "system").map((m) => text(m.content, images));
+  const visible = messages.filter((message) => message.role !== "system");
+  const pending = resumed ? visible.slice(offset) : visible;
+  const last = pending.at(-1);
+  const prior = pending.slice(0, -1);
+  const parts: string[] = [];
+  if (!resumed && system.length) parts.push(system.join("\n\n"));
+  if (prior.length)
+    parts.push(
+      prior
+        .map((message) => `${message.role === "assistant" ? "Assistant" : "User"}: ${text(message.content, images)}`)
+        .join("\n\n"),
+    );
+  if (last) parts.push(text(last.content, images));
+  return parts.join("\n\n").trim();
+}
+
+/** ACP image blocks for the newest user message, when the agent declared image prompts. */
+export function latestImageBlocks(messages: readonly ModelInputMessage[]): { type: "image"; mimeType: string; data: string }[] {
+  const last = [...messages].reverse().find((message) => message.role === "user");
+  if (!last || typeof last.content === "string") return [];
+  return last.content.flatMap((block) => {
+    if (block.type !== "image") return [];
+    const match = /^data:([^;,]+);base64,(.*)$/su.exec(block.dataUrl);
+    return match ? [{ type: "image" as const, mimeType: match[1]!, data: match[2]! }] : [];
+  });
+}
