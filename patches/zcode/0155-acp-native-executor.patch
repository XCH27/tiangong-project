@@ -0,0 +1,172 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { StringDecoder } from "node:string_decoder";
+
+/**
+ * Agent Client Protocol v1 over stdio (newline-delimited JSON-RPC 2.0), hand-written like the
+ * Codex app-server client so no ACP SDK dependency is added. Fleet is the client: it never
+ * advertises fs/terminal capabilities, so the agent keeps its own tools.
+ */
+export interface AcpNotification {
+  method: string;
+  params?: Record<string, unknown>;
+}
+export interface AcpIncomingRequest extends AcpNotification {
+  id: number | string;
+}
+export class AcpRpcError extends Error {
+  constructor(
+    message: string,
+    readonly code?: number,
+    readonly data?: unknown,
+  ) {
+    super(message);
+  }
+}
+
+export interface AcpClientOptions {
+  executable: string;
+  args: string[];
+  cwd: string;
+  env: NodeJS.ProcessEnv;
+  onNotification(notification: AcpNotification): void;
+  /** Agent → client requests (permission). Unknown methods are answered "method not found". */
+  onRequest(request: AcpIncomingRequest): Promise<unknown>;
+  onExit(code: number | null, stderr: string): void;
+}
+
+export class AcpClient {
+  private readonly child: ChildProcessWithoutNullStreams;
+  private readonly pending = new Map<
+    number,
+    { resolve(value: unknown): void; reject(error: Error): void }
+  >();
+  private nextId = 0;
+  private buffer = "";
+  private stderr = "";
+  private exited = false;
+
+  constructor(private readonly options: AcpClientOptions) {
+    this.child = spawn(options.executable, options.args, {
+      cwd: options.cwd,
+      env: options.env,
+      stdio: "pipe",
+      detached: process.platform !== "win32",
+      windowsHide: true,
+    });
+    const decoder = new StringDecoder("utf8");
+    this.child.stdout.on("data", (chunk: Buffer) => this.consume(decoder.write(chunk)));
+    this.child.stderr.on("data", (chunk: Buffer) => {
+      this.stderr = (this.stderr + chunk.toString()).slice(-4096);
+    });
+    this.child.on("error", (error) => this.terminate(error));
+    this.child.on("close", (code) => {
+      this.exited = true;
+      this.terminate(new Error(`ACP agent exited (${code ?? "signal"})`));
+      options.onExit(code, this.stderr);
+    });
+  }
+
+  get diagnostics(): string {
+    return this.stderr;
+  }
+
+  /** `timeoutMs` bounds setup calls; a prompt turn is unbounded and ends via cancel or exit. */
+  request<T = Record<string, unknown>>(method: string, params: unknown, timeoutMs?: number): Promise<T> {
+    if (this.exited) return Promise.reject(new Error("ACP agent is not running"));
+    const id = ++this.nextId;
+    return new Promise<T>((resolve, reject) => {
+      const timer = timeoutMs
+        ? setTimeout(() => {
+            if (!this.pending.delete(id)) return;
+            reject(new AcpRpcError(`ACP ${method} timed out`, -32001));
+          }, timeoutMs)
+        : undefined;
+      timer?.unref();
+      this.pending.set(id, {
+        resolve: (value) => {
+          clearTimeout(timer);
+          (resolve as (value: unknown) => void)(value);
+        },
+        reject: (error) => {
+          clearTimeout(timer);
+          reject(error);
+        },
+      });
+      this.write({ jsonrpc: "2.0", id, method, params });
+    });
+  }
+
+  notify(method: string, params: unknown): void {
+    if (!this.exited) this.write({ jsonrpc: "2.0", method, params });
+  }
+
+  close(): void {
+    if (this.exited) return;
+    this.child.stdin.end();
+    const pid = this.child.pid;
+    const kill = (signal: NodeJS.Signals) => {
+      if (this.exited || !pid) return;
+      try {
+        if (process.platform === "win32") this.child.kill(signal);
+        else process.kill(-pid, signal);
+      } catch {
+        this.child.kill(signal);
+      }
+    };
+    kill("SIGTERM");
+    setTimeout(() => kill("SIGKILL"), 2000).unref();
+  }
+
+  private write(message: unknown) {
+    this.child.stdin.write(`${JSON.stringify(message)}\n`);
+  }
+
+  private terminate(error: Error) {
+    for (const entry of this.pending.values()) entry.reject(error);
+    this.pending.clear();
+  }
+
+  private consume(text: string) {
+    this.buffer += text;
+    for (let index = this.buffer.indexOf("\n"); index >= 0; index = this.buffer.indexOf("\n")) {
+      const line = this.buffer.slice(0, index).trim();
+      this.buffer = this.buffer.slice(index + 1);
+      if (!line) continue;
+      let message: Record<string, unknown>;
+      try {
+        message = JSON.parse(line) as Record<string, unknown>;
+      } catch {
+        continue; // Agents may log non-protocol lines; only JSON-RPC frames are meaningful.
+      }
+      const id = message.id;
+      if (typeof message.method === "string") {
+        const params = (message.params ?? undefined) as Record<string, unknown> | undefined;
+        if (id === undefined || id === null) {
+          this.options.onNotification({ method: message.method, params });
+          continue;
+        }
+        const request = { id: id as number | string, method: message.method, params };
+        void this.options.onRequest(request).then(
+          (result) => this.write({ jsonrpc: "2.0", id, result: result ?? null }),
+          (error: unknown) =>
+            this.write({
+              jsonrpc: "2.0",
+              id,
+              error:
+                error instanceof AcpRpcError
+                  ? { code: error.code ?? -32603, message: error.message }
+                  : { code: -32603, message: error instanceof Error ? error.message : "Request failed" },
+            }),
+        );
+        continue;
+      }
+      if (typeof id !== "number") continue;
+      const entry = this.pending.get(id);
+      if (!entry) continue;
+      this.pending.delete(id);
+      const error = message.error as { code?: number; message?: string; data?: unknown } | undefined;
+      if (error) entry.reject(new AcpRpcError(error.message ?? "ACP request failed", error.code, error.data));
+      else entry.resolve(message.result ?? {});
+    }
+  }
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/acp-inspect.ts b/apps/zcode-cli/packages/adapters/src/native-agent/acp-inspect.ts
