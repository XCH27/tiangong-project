+import { accessSync, constants } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { CollaborationMode } from "@zcode/contracts";
+
+export type AcpExecutorKind = "cursor" | "kimi" | "opencode";
+
+/**
+ * Per-CLI facts for the shared ACP executor, each verified against the installed binary with an
+ * initialize + session/new handshake (2026-10-06): Kimi Code CLI 0.37.2, OpenCode 1.18.32,
+ * Cursor Agent 2026.08.04. Fleet keeps the vendor's own login; it never reads their tokens.
+ */
+export interface AcpProfile {
+  kind: AcpExecutorKind;
+  /** Name for diagnostics and the local account identity when the CLI exposes no account. */
+  label: string;
+  binary: string;
+  /** Default install locations; desktop apps do not inherit the shell PATH. */
+  candidates: string[];
+  args: string[];
+  /** ACP authenticate method to call before sessions (Cursor requires it after `agent login`). */
+  authMethodId?: string;
+  /** Vendor mode option values: plan uses the vendor's read-only plan; others stay on manual approval. */
+  planMode: string;
+  manualMode: string;
+  /** Extra environment for a Fleet permission mode (e.g. make OpenCode ask instead of auto-allow). */
+  environment(mode: CollaborationMode | undefined): Record<string, string>;
+  billingProvider: string;
+  loginCommand: string;
+}
+
+const home = homedir();
+const bin = (name: string) => (process.platform === "win32" ? `${name}.exe` : name);
+
+export const ACP_PROFILES: Record<AcpExecutorKind, AcpProfile> = {
+  kimi: {
+    kind: "kimi",
+    label: "Kimi Code",
+    binary: bin("kimi"),
+    candidates: [join(home, ".kimi-code", "bin", bin("kimi")), join(home, ".local", "bin", bin("kimi"))],
+    args: ["acp"],
+    planMode: "plan",
+    manualMode: "default",
+    environment: () => ({}),
+    billingProvider: "moonshot",
+    loginCommand: "kimi login",
+  },
+  opencode: {
+    kind: "opencode",
+    label: "OpenCode",
+    binary: bin("opencode"),
+    candidates: [
+      join(home, ".opencode", "bin", bin("opencode")),
+      "/opt/homebrew/bin/opencode",
+      "/usr/local/bin/opencode",
+      join(home, ".local", "bin", bin("opencode")),
+    ],
+    args: ["acp"],
+    planMode: "plan",
+    manualMode: "build",
+    // OpenCode 默认放行编辑与命令；Fleet 的确认档需要它把这些操作作为 ACP 权限请求发回来。
+    environment: (mode): Record<string, string> =>
+      mode === "yolo"
+        ? {}
+        : { OPENCODE_CONFIG_CONTENT: JSON.stringify({ permission: { edit: "ask", bash: "ask", webfetch: "ask" } }) },
+    billingProvider: "opencode",
+    loginCommand: "opencode auth login",
+  },
+  cursor: {
+    kind: "cursor",
+    label: "Cursor",
+    binary: bin("cursor-agent"),
+    candidates: [join(home, ".local", "bin", bin("cursor-agent")), join(home, ".local", "bin", bin("agent"))],
+    args: ["acp"],
+    authMethodId: "cursor_login",
+    planMode: "plan",
+    manualMode: "agent",
+    environment: () => ({}),
+    billingProvider: "cursor",
+    loginCommand: "cursor-agent login",
+  },
+};
+
+export function resolveAcpExecutable(kind: AcpExecutorKind, override?: string): string {
+  if (override) return override;
+  const profile = ACP_PROFILES[kind];
+  for (const candidate of profile.candidates) {
+    try {
+      accessSync(candidate, constants.X_OK);
+      return candidate;
+    } catch {
+      /* try the next location, then PATH */
+    }
+  }
+  return profile.binary;
+}
+
+export const acpLocalAccount = (kind: AcpExecutorKind) => `${kind}-local`;
+export const isAcpExecutorKind = (value: unknown): value is AcpExecutorKind =>
+  value === "cursor" || value === "kimi" || value === "opencode";
