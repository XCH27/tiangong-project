@@ -0,0 +1,181 @@
+import { AcpClient, AcpRpcError, type AcpIncomingRequest, type AcpNotification } from "./acp-client.js";
+import { ACP_PROFILES, type AcpExecutorKind } from "./acp-profiles.js";
+
+export interface AcpConfigOption {
+  id: string;
+  category?: string;
+  currentValue?: unknown;
+  options?: { value?: string; name?: string; options?: { value?: string; name?: string }[] }[];
+}
+export interface AcpSession {
+  client: AcpClient;
+  sessionId: string;
+  version: string;
+  configOptions: AcpConfigOption[];
+  canClose: boolean;
+  canDelete: boolean;
+  /** promptCapabilities.image: the agent accepts image content blocks. */
+  images: boolean;
+}
+
+const SET_MODEL_OPTION = "__acp_session_model";
+const SETUP_TIMEOUT_MS = 60_000;
+const AUTH_TIMEOUT_MS = 20_000;
+const SIGN_IN = (kind: AcpExecutorKind) =>
+  `Sign in to the official ${ACP_PROFILES[kind].label} CLI first: run \`${ACP_PROFILES[kind].loginCommand}\` in a terminal`;
+
+/** Flattens grouped select options (ACP allows one level of groups). */
+export function acpOptionValues(option: AcpConfigOption | undefined): { value: string; name: string }[] {
+  const values: { value: string; name: string }[] = [];
+  for (const entry of option?.options ?? []) {
+    if (entry.options) {
+      for (const nested of entry.options)
+        if (typeof nested.value === "string") values.push({ value: nested.value, name: nested.name ?? nested.value });
+    } else if (typeof entry.value === "string") values.push({ value: entry.value, name: entry.name ?? entry.value });
+  }
+  return values;
+}
+
+export const acpOption = (options: readonly AcpConfigOption[], category: string) =>
+  options.find((option) => option.category === category || option.id === category);
+
+function authFailure(kind: AcpExecutorKind, error: unknown): Error {
+  const message = error instanceof Error ? error.message : String(error);
+  return /auth|sign.?in|log.?in/iu.test(message) ? new Error(SIGN_IN(kind)) : error instanceof Error ? error : new Error(message);
+}
+
+/**
+ * Opens one ACP session. A continuation prefers `session/resume` (no replay), then
+ * `session/load` (replayed history is ignored); otherwise a new session is created.
+ */
+export async function openAcpSession(input: {
+  kind: AcpExecutorKind;
+  executable: string;
+  cwd: string;
+  env: NodeJS.ProcessEnv;
+  resumeSessionId?: string;
+  onNotification(notification: AcpNotification): void;
+  onRequest(request: AcpIncomingRequest): Promise<unknown>;
+  onExit(code: number | null, stderr: string): void;
+}): Promise<AcpSession> {
+  const profile = ACP_PROFILES[input.kind];
+  let replaying = false;
+  const client = new AcpClient({
+    executable: input.executable,
+    args: profile.args,
+    cwd: input.cwd,
+    env: input.env,
+    onNotification: (notification) => {
+      if (!replaying) input.onNotification(notification);
+    },
+    onRequest: (request) => input.onRequest(request),
+    onExit: input.onExit,
+  });
+  try {
+    const initialized = await client.request<{
+      protocolVersion?: number;
+      agentCapabilities?: {
+        loadSession?: boolean;
+        sessionCapabilities?: Record<string, unknown>;
+        promptCapabilities?: { image?: boolean };
+      };
+      agentInfo?: { version?: string };
+    }>(
+      "initialize",
+      {
+        protocolVersion: 1,
+        clientCapabilities: { fs: { readTextFile: false, writeTextFile: false }, terminal: false },
+        clientInfo: { name: "Fleet", version: "1" },
+      },
+      SETUP_TIMEOUT_MS,
+    );
+    if (initialized.protocolVersion !== 1) throw new Error("This CLI does not speak ACP protocol version 1");
+    if (profile.authMethodId)
+      // 未登录时 Cursor 的 authenticate 不返回；超时按未登录处理。
+      await client.request("authenticate", { methodId: profile.authMethodId }, AUTH_TIMEOUT_MS).catch(() => {
+        throw new Error(SIGN_IN(input.kind));
+      });
+    const capabilities = initialized.agentCapabilities?.sessionCapabilities ?? {};
+    const common = { cwd: input.cwd, mcpServers: [] };
+    let sessionId = input.resumeSessionId;
+    let result: {
+      sessionId?: string;
+      configOptions?: AcpConfigOption[];
+      models?: { currentModelId?: string; availableModels?: { modelId?: string; name?: string }[] };
+    };
+    if (sessionId && capabilities.resume) {
+      result = await client.request("session/resume", { sessionId, ...common }, SETUP_TIMEOUT_MS);
+    } else if (sessionId && initialized.agentCapabilities?.loadSession) {
+      replaying = true;
+      try {
+        result = await client.request("session/load", { sessionId, ...common }, SETUP_TIMEOUT_MS);
+      } finally {
+        replaying = false;
+      }
+    } else if (sessionId) {
+      throw new Error(`${profile.label} cannot resume this conversation`);
+    } else {
+      result = await client.request("session/new", common, SETUP_TIMEOUT_MS).catch((error: unknown) => {
+        throw authFailure(input.kind, error);
+      });
+      sessionId = result.sessionId;
+    }
+    if (!sessionId) throw new Error(`${profile.label} did not return a session`);
+    const configOptions = Array.isArray(result.configOptions) ? [...result.configOptions] : [];
+    // 未提供 model 配置项的 agent（ACP unstable `models`）改用 session/set_model 选择。
+    if (!acpOption(configOptions, "model") && result.models?.availableModels?.length)
+      configOptions.push({
+        id: SET_MODEL_OPTION,
+        category: "model",
+        currentValue: result.models.currentModelId,
+        options: result.models.availableModels.map((model) => ({ value: model.modelId, name: model.name })),
+      });
+    // Cursor 通过扩展方法列出可用模型（Paseo cursor-acp-agent.ts）；只读，不切换 CLI 偏好。
+    if (!acpOption(configOptions, "model") && input.kind === "cursor") {
+      const listed = await client
+        .request<{ models?: { value?: string; name?: string }[] }>("cursor/list_available_models", {}, SETUP_TIMEOUT_MS)
+        .catch(() => ({ models: [] }));
+      if (listed.models?.length)
+        configOptions.push({
+          id: SET_MODEL_OPTION,
+          category: "model",
+          options: listed.models.map((model) => ({ value: model.value, name: model.name })),
+        });
+    }
+    return {
+      client,
+      sessionId,
+      version: initialized.agentInfo?.version ?? "acp",
+      configOptions,
+      canClose: Boolean(capabilities.close),
+      canDelete: Boolean(capabilities.delete),
+      images: initialized.agentCapabilities?.promptCapabilities?.image === true,
+    };
+  } catch (error) {
+    client.close();
+    throw error instanceof AcpRpcError ? authFailure(input.kind, error) : error;
+  }
+}
+
+/** Sets a select option only when the agent offers that value; returns whether it was applied. */
+export async function setAcpOption(
+  session: AcpSession,
+  category: string,
+  value: string | undefined,
+): Promise<boolean> {
+  const option = acpOption(session.configOptions, category);
+  if (!option || !value || option.currentValue === value) return Boolean(option && value && option.currentValue === value);
+  if (!acpOptionValues(option).some((entry) => entry.value === value)) return false;
+  if (option.id === SET_MODEL_OPTION) {
+    await session.client.request("session/set_model", { sessionId: session.sessionId, modelId: value });
+    option.currentValue = value;
+    return true;
+  }
+  const response = await session.client.request<{ configOptions?: AcpConfigOption[] }>(
+    "session/set_config_option",
+    { sessionId: session.sessionId, configId: option.id, value },
+    SETUP_TIMEOUT_MS,
+  );
+  if (Array.isArray(response.configOptions)) session.configOptions = response.configOptions;
+  return true;
+}
