index 0000000..1d785df
--- /dev/null
+++ b/packages/services/test/acp-native.test.ts
@@ -0,0 +1,213 @@
+import assert from "node:assert/strict";
+import { chmodSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import {
+  acpApprovalDecision,
+  createAcpNativeAgentPort,
+} from "../../../apps/zcode-cli/packages/adapters/src/native-agent/acp-turn.js";
+import { inspectAcpConnection } from "../../../apps/zcode-cli/packages/adapters/src/native-agent/acp-inspect.js";
+
+test("Fleet's permission choice answers vendor permission requests (OV-094)", () => {
+  assert.equal(acpApprovalDecision("yolo", "execute"), "allow");
+  assert.equal(acpApprovalDecision("plan", "edit"), "deny");
+  assert.equal(acpApprovalDecision("edit", "edit"), "allow");
+  assert.equal(acpApprovalDecision("edit", "execute"), "ask");
+  assert.equal(acpApprovalDecision("build", "edit"), "ask");
+});
+
+/**
+ * A stand-in ACP agent modelled on the Kimi Code CLI handshake captured on 2026-10-06: config
+ * options for model/mode, resume support, one permission request per prompt.
+ */
+function fakeAgent() {
+  const dir = mkdtempSync(join(tmpdir(), "fake-acp-"));
+  const script = join(dir, "kimi");
+  const log = join(dir, "log.jsonl");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs = require("node:fs");
+if (process.argv[2] === "--version") { console.log("9.9.9"); process.exit(0); }
+const log = (entry) => fs.appendFileSync(${JSON.stringify(log)}, JSON.stringify(entry) + "\\n");
+const send = (message) => process.stdout.write(JSON.stringify(message) + "\\n");
+const config = (model, mode) => [
+  { id: "model", category: "model", type: "select", currentValue: model, options: [{ value: "k3", name: "K3" }, { value: "k2", name: "K2" }] },
+  { id: "mode", category: "mode", type: "select", currentValue: mode, options: [{ value: "default" }, { value: "plan" }] },
+];
+let model = "k2", mode = "default", nextId = 1000; const waiting = new Map();
+let buffer = "";
+process.stdin.on("data", (chunk) => {
+  buffer += chunk;
+  let index;
+  while ((index = buffer.indexOf("\\n")) >= 0) {
+    const line = buffer.slice(0, index); buffer = buffer.slice(index + 1);
+    if (!line.trim()) continue;
+    const message = JSON.parse(line);
+    log(message);
+    if (message.method === undefined && waiting.has(message.id)) { waiting.get(message.id)(message.result); waiting.delete(message.id); continue; }
+    const reply = (result) => send({ jsonrpc: "2.0", id: message.id, result });
+    switch (message.method) {
+      case "initialize": reply({ protocolVersion: 1, agentCapabilities: { loadSession: true, promptCapabilities: { image: false }, sessionCapabilities: { resume: {}, delete: {} } }, agentInfo: { version: "9.9.9" } }); break;
+      case "session/new": reply({ sessionId: "sess-1", configOptions: config(model, mode) }); break;
+      case "session/resume": reply({ configOptions: config(model, mode) }); break;
+      case "session/delete": reply({}); break;
+      case "session/set_config_option": if (message.params.configId === "model") model = message.params.value; else mode = message.params.value; reply({ configOptions: config(model, mode) }); break;
+      case "session/prompt": {
+        send({ jsonrpc: "2.0", method: "session/update", params: { sessionId: "sess-1", update: { sessionUpdate: "agent_thought_chunk", content: { type: "text", text: "thinking" } } } });
+        const id = nextId++;
+        waiting.set(id, (result) => {
+          log({ permissionOutcome: result.outcome });
+          send({ jsonrpc: "2.0", method: "session/update", params: { sessionId: "sess-1", update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: "你好，" } } } });
+          send({ jsonrpc: "2.0", method: "session/update", params: { sessionId: "sess-1", update: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: "完成" } } } });
+          reply({ stopReason: "end_turn", usage: { inputTokens: 11, outputTokens: 4, totalTokens: 15 } });
+        });
+        send({ jsonrpc: "2.0", id, method: "session/request_permission", params: { sessionId: "sess-1", toolCall: { toolCallId: "t1", title: "Write file", kind: "edit", rawInput: { path: "a.txt" } }, options: [{ optionId: "yes", kind: "allow_once", name: "Allow" }, { optionId: "no", kind: "reject_once", name: "Reject" }] } });
+        break;
+      }
+      default: send({ jsonrpc: "2.0", id: message.id, error: { code: -32601, message: "not found" } });
+    }
+  }
+});
+`,
+  );
+  chmodSync(script, 0o755);
+  return {
+    script,
+    log: () =>
+      readFileSync(log, "utf8")
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line) as Record<string, any>),
+  };
+}
+
+function request(executable: string, extra: Record<string, unknown> = {}) {
+  return {
+    model: { modelId: "k3", options: {}, nativeExecutor: { kind: "kimi" as const, executable, accountId: "kimi-local" } } as never,
+    messages: [{ role: "user" as const, content: "写个文件" }],
+    tools: [],
+    sessionId: "s1",
+    turnId: "t1",
+    workingDirectory: tmpdir(),
+    signal: new AbortController().signal,
+    ...extra,
+  };
+}
+
+async function drain(turn: ReturnType<ReturnType<typeof createAcpNativeAgentPort>["createTurn"]>) {
+  turn.admitNextStep();
+  const events = [];
+  for await (const event of turn.model.streamText({ messages: request("").messages } as never)) events.push(event);
+  return events;
+}
+
+test("connection inspection lists the account's models from the ACP session and deletes the probe", async () => {
+  const agent = fakeAgent();
+  const inspected = await inspectAcpConnection({ kind: "kimi", executable: agent.script, cwd: tmpdir() });
+  assert.deepEqual(inspected.models, [
+    { id: "k3", name: "K3" },
+    { id: "k2", name: "K2" },
+  ]);
+  assert.equal(inspected.accountId, "kimi-local");
+  assert.ok(agent.log().some((entry) => entry.method === "session/delete"));
+});
+
+test("a turn selects the model, asks the Host to approve the vendor's edit, streams text and checkpoints", async () => {
+  const agent = fakeAgent();
+  const approvals: unknown[] = [];
+  const turn = createAcpNativeAgentPort("kimi").createTurn(
+    request(agent.script, {
+      collaborationMode: "build",
+      requestApproval: async (input: unknown) => {
+        approvals.push(input);
+        return true;
+      },
+    }),
+  );
+  const events = await drain(turn);
+  const text = events.flatMap((event) => (event.type === "text_delta" ? [event.text] : [])).join("");
+  assert.equal(text, "你好，完成");
+  assert.ok(events.some((event) => event.type === "reasoning_delta"));
+  const finish = events.at(-1);
+  assert.equal(finish?.type, "finish");
+  if (finish?.type === "finish") assert.equal(finish.usage?.inputTokens, 11);
+  assert.equal(approvals.length, 1);
+  const log = agent.log();
+  assert.ok(log.some((entry) => entry.method === "session/set_config_option" && entry.params.value === "k3"));
+  assert.deepEqual(log.find((entry) => entry.permissionOutcome)?.permissionOutcome, { outcome: "selected", optionId: "yes" });
+  const checkpoint = await turn.checkpoint?.();
+  assert.equal(checkpoint?.sessionId, "sess-1");
+  await turn.close();
+  assert.equal(await createAcpNativeAgentPort("kimi").canResume!(checkpoint!, request(agent.script)), true);
+});
+
+test("plan mode selects the vendor's plan mode and refuses changes without asking", async () => {
+  const agent = fakeAgent();
+  let asked = false;
+  const turn = createAcpNativeAgentPort("kimi").createTurn(
+    request(agent.script, {
+      collaborationMode: "plan",
+      requestApproval: async () => {
+        asked = true;
+        return true;
+      },
+    }),
+  );
+  const events = await drain(turn);
+  await turn.close();
+  assert.equal(asked, false);
+  const log = agent.log();
+  assert.ok(log.some((entry) => entry.method === "session/set_config_option" && entry.params.value === "plan"));
+  assert.deepEqual(log.find((entry) => entry.permissionOutcome)?.permissionOutcome, { outcome: "selected", optionId: "no" });
+  assert.match(events.flatMap((event) => (event.type === "text_delta" ? [event.text] : [])).join(""), /计划模式/u);
+});
+
+test("a resumed turn uses session/resume and sends only the uncovered tail", async () => {
+  const agent = fakeAgent();
+  const turn = createAcpNativeAgentPort("kimi").createTurn(
+    request(agent.script, {
+      collaborationMode: "yolo",
+      continuation: { sessionId: "sess-1", cachePath: "acp:kimi:sess-1", cacheFingerprint: "x", executorVersion: "9.9.9" },
+      continuationMessageOffset: 0,
+    }),
+  );
+  await drain(turn);
+  await turn.close();
+  const log = agent.log();
+  assert.ok(log.some((entry) => entry.method === "session/resume" && entry.params.sessionId === "sess-1"));
+  assert.ok(!log.some((entry) => entry.method === "session/new"));
+});
+
+test("an unoffered model fails the turn instead of silently using the CLI default", async () => {
+  const agent = fakeAgent();
+  const turn = createAcpNativeAgentPort("kimi").createTurn({
+    ...request(agent.script),
+    model: { modelId: "missing", options: {}, nativeExecutor: { kind: "kimi", executable: agent.script } } as never,
+  });
+  await assert.rejects(drain(turn), /does not offer model missing/u);
+  await turn.close();
+});
+
+test("an ACP setup request that never answers fails after its timeout instead of hanging", async () => {
+  const { AcpClient } = await import("../../../apps/zcode-cli/packages/adapters/src/native-agent/acp-client.js");
+  const dir = mkdtempSync(join(tmpdir(), "silent-acp-"));
+  const script = join(dir, "silent");
+  writeFileSync(script, "#!/usr/bin/env node\nprocess.stdin.resume();\n");
+  chmodSync(script, 0o755);
+  const client = new AcpClient({
+    executable: script,
+    args: [],
+    cwd: dir,
+    env: process.env,
+    onNotification: () => {},
+    onRequest: async () => ({}),
+    onExit: () => {},
+  });
+  try {
+    await assert.rejects(client.request("authenticate", {}, 200), /timed out/u);
+  } finally {
+    client.close();
+  }
+});
