+import { execFile } from "node:child_process";
+import { ACP_PROFILES, acpLocalAccount, resolveAcpExecutable, type AcpExecutorKind } from "./acp-profiles.js";
+import { acpOption, acpOptionValues, openAcpSession } from "./acp-session.js";
+import { acpCliVersion } from "./acp-turn.js";
+import { withNativeExecutorNetwork } from "./native-network.js";
+
+export interface AcpInspection {
+  version: string;
+  accountId: string;
+  accountName: string;
+  models: { id: string; name: string }[];
+  /** Session-level thinking levels (ACP `thought_level` option), when the CLI offers them. */
+  thoughtLevels: string[];
+  images: boolean;
+}
+
+/** Cursor reports its signed-in email through the public `about` command. */
+function cursorAccount(executable: string, env: NodeJS.ProcessEnv): Promise<string | undefined> {
+  return new Promise((resolve) => {
+    execFile(executable, ["about"], { env, timeout: 15_000 }, (error, stdout) => {
+      const email = /User Email\s+(\S+@\S+)/u.exec(stdout ?? "")?.[1];
+      resolve(error ? undefined : email);
+    });
+  });
+}
+
+/**
+ * Connection check through the CLI's own ACP server: one throwaway session lists the models this
+ * account can use. No prompt is sent; the probe session is deleted when the CLI supports it.
+ */
+export async function inspectAcpConnection(input: {
+  kind: AcpExecutorKind;
+  executable?: string;
+  cwd: string;
+  env?: Record<string, string | undefined>;
+}): Promise<AcpInspection> {
+  const profile = ACP_PROFILES[input.kind];
+  const executable = resolveAcpExecutable(input.kind, input.executable);
+  const env = withNativeExecutorNetwork({ ...process.env, ...input.env, NO_BROWSER: "true" }, input.kind);
+  const version = await acpCliVersion(executable, env);
+  const session = await openAcpSession({
+    kind: input.kind,
+    executable,
+    cwd: input.cwd,
+    env,
+    onNotification: () => {},
+    onRequest: async () => ({ outcome: { outcome: "cancelled" } }),
+    onExit: () => {},
+  });
+  try {
+    const models = acpOptionValues(acpOption(session.configOptions, "model")).map((entry) => ({
+      id: entry.value,
+      name: entry.name,
+    }));
+    if (!models.length) throw new Error(`${profile.label} returned no models for this account`);
+    const thoughtLevels = acpOptionValues(acpOption(session.configOptions, "thought_level"))
+      .map((entry) => entry.value)
+      .filter((value) => value !== "none" && value !== "default");
+    const email = input.kind === "cursor" ? await cursorAccount(executable, env) : undefined;
+    if (session.canDelete)
+      await session.client.request("session/delete", { sessionId: session.sessionId }, 10_000).catch(() => undefined);
+    return {
+      version,
+      accountId: email ?? acpLocalAccount(input.kind),
+      accountName: email ?? profile.label,
+      models,
+      thoughtLevels,
+      images: session.images,
+    };
+  } finally {
+    session.client.close();
+  }
+}
