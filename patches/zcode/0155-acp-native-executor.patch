+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import type {
+  CollaborationMode,
+  Model,
+  ModelResult,
+  ModelUsage,
+  NativeAgentContinuation,
+  NativeAgentPort,
+} from "@zcode/contracts";
+import { NativeEvents } from "./native-events.js";
+import { AcpRpcError, type AcpIncomingRequest, type AcpNotification } from "./acp-client.js";
+import { ACP_PROFILES, isAcpExecutorKind, resolveAcpExecutable, type AcpExecutorKind } from "./acp-profiles.js";
+import { openAcpSession, setAcpOption, type AcpSession } from "./acp-session.js";
+import { latestImageBlocks, nativeTranscriptPrompt } from "./native-prompt.js";
+import { withNativeExecutorNetwork } from "./native-network.js";
+
+const cachePath = (kind: string, sessionId: string) => `acp:${kind}:${sessionId}`;
+const fingerprint = (kind: string, sessionId: string, version: string) =>
+  createHash("sha256").update(JSON.stringify([kind, sessionId, version])).digest("hex");
+
+/** `<cli> --version` first line; fences resumption to the build that owns the vendor session. */
+export function acpCliVersion(executable: string, env: NodeJS.ProcessEnv): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFile(executable, ["--version"], { env, timeout: 15_000 }, (error, stdout) => {
+      if (error) reject(new Error("The official CLI is not installed or cannot start"));
+      else resolve(stdout.trim().split(/\r?\n/u)[0] || "acp");
+    });
+  });
+}
+
+export type AcpApproval = "allow" | "deny" | "ask";
+
+/**
+ * Fleet's permission choice answers the vendor's own permission requests (OV-094): plan refuses
+ * changes, ask-before-changes asks the user, auto-edit allows file edits and asks for the rest,
+ * full access allows everything. The vendor's plan mode is also selected for plan.
+ */
+export function acpApprovalDecision(mode: CollaborationMode | undefined, toolKind: unknown): AcpApproval {
+  if (mode === "yolo") return "allow";
+  if (mode === "plan") return "deny";
+  if (mode === "edit" && (toolKind === "edit" || toolKind === "delete" || toolKind === "move")) return "allow";
+  return "ask";
+}
+
+interface PermissionOption {
+  optionId?: string;
+  kind?: string;
+}
+function pickOption(options: readonly PermissionOption[], allow: boolean): string | undefined {
+  const order = allow ? ["allow_once", "allow_always"] : ["reject_once", "reject_always"];
+  for (const kind of order) {
+    const option = options.find((entry) => entry.kind === kind && typeof entry.optionId === "string");
+    if (option) return option.optionId;
+  }
+  return undefined;
+}
+
+function acpUsage(value: unknown): ModelUsage {
+  const usage = (value ?? {}) as Record<string, unknown>;
+  const count = (entry: unknown) =>
+    typeof entry === "number" && Number.isSafeInteger(entry) && entry >= 0 ? entry : undefined;
+  return {
+    inputTokens: count(usage.inputTokens),
+    outputTokens: count(usage.outputTokens),
+    reasoningTokens: count(usage.thoughtTokens),
+    cacheReadTokens: count(usage.cachedReadTokens),
+    cacheWriteTokens: count(usage.cachedWriteTokens),
+    totalTokens: count(usage.totalTokens),
+  };
+}
+
+/** One shared executor for every CLI that offers ACP (decision H6); per-CLI facts live in profiles. */
+export function createAcpNativeAgentPort(
+  kind: AcpExecutorKind,
+  options: { env?: Record<string, string | undefined> } = {},
+): NativeAgentPort {
+  const profile = ACP_PROFILES[kind];
+  const environment = (mode: CollaborationMode | undefined) =>
+    withNativeExecutorNetwork({ ...process.env, ...options.env, ...profile.environment(mode) }, kind);
+  return {
+    async canResume(continuation, request) {
+      if (!continuation.sessionId || continuation.cachePath !== cachePath(kind, continuation.sessionId)) return false;
+      try {
+        const version = await acpCliVersion(
+          resolveAcpExecutable(kind, request.model.nativeExecutor?.executable),
+          environment(request.collaborationMode),
+        );
+        return (
+          version === continuation.executorVersion &&
+          continuation.cacheFingerprint === fingerprint(kind, continuation.sessionId, version)
+        );
+      } catch {
+        return false;
+      }
+    },
+    createTurn(request) {
+      if (!isAcpExecutorKind(request.model.nativeExecutor?.kind) || request.model.nativeExecutor.kind !== kind)
+        throw new Error("Unsupported native Agent executor");
+      const events = new NativeEvents();
+      const executable = resolveAcpExecutable(kind, request.model.nativeExecutor.executable);
+      const mode = request.collaborationMode;
+      let session: AcpSession | undefined;
+      let started = false;
+      let closed = false;
+      let completed = false;
+      let version: string | undefined;
+      let text = "";
+      const refused: string[] = [];
+      const fail = (error: unknown) => {
+        if (closed) return;
+        closed = true;
+        events.push(error instanceof Error ? error : new Error(`${profile.label} execution failed`));
+        session?.client.close();
+      };
+      const onNotification = (notification: AcpNotification) => {
+        if (notification.method !== "session/update" || closed) return;
+        const update = (notification.params?.update ?? {}) as Record<string, unknown>;
+        const content = update.content as { type?: string; text?: string } | undefined;
+        if (content?.type !== "text" || !content.text) return;
+        if (update.sessionUpdate === "agent_message_chunk") {
+          text += content.text;
+          events.push({ type: "text_delta", text: content.text });
+        } else if (update.sessionUpdate === "agent_thought_chunk") {
+          events.push({ type: "reasoning_delta", text: content.text });
+        }
+      };
+      const onRequest = async (incoming: AcpIncomingRequest): Promise<unknown> => {
+        if (incoming.method !== "session/request_permission")
+          throw new AcpRpcError("Method not found", -32601);
+        const params = incoming.params ?? {};
+        const toolCall = (params.toolCall ?? {}) as Record<string, unknown>;
+        const choices = (Array.isArray(params.options) ? params.options : []) as PermissionOption[];
+        const title = typeof toolCall.title === "string" && toolCall.title ? toolCall.title : String(toolCall.kind ?? "tool");
+        let allow = false;
+        const decision = acpApprovalDecision(mode, toolCall.kind);
+        if (decision === "allow") allow = true;
+        else if (decision === "ask" && request.requestApproval && !closed && !request.signal.aborted)
+          allow = await request.requestApproval({
+            toolCallId: `${kind}:${String(toolCall.toolCallId ?? incoming.id)}`,
+            toolName: `${profile.label}: ${title}`,
+            input: toolCall.rawInput ?? toolCall.content ?? {},
+            reason: `${profile.label} wants to run ${title}`,
+            riskLevel: toolCall.kind === "execute" || toolCall.kind === "delete" ? "high" : "medium",
+          });
+        if (!allow && decision === "deny") refused.push(title);
+        const optionId = closed ? undefined : pickOption(choices, allow);
+        return { outcome: optionId ? { outcome: "selected", optionId } : { outcome: "cancelled" } };
+      };
+      const finish = (stopReason: unknown, usage: ModelUsage, sessionId: string) => {
+        completed = true;
+        if (refused.length) {
+          const note = `\n\n> ${profile.label} 未执行计划模式下的改动：${refused.join("、")}。如需执行，请切换权限后重试。`;
+          text += note;
+          events.push({ type: "text_delta", text: note });
+        }
+        const result: ModelResult = {
+          text,
+          usage,
+          finishReason: stopReason === "max_tokens" ? "length" : stopReason === "refusal" ? "content-filter" : "stop",
+          providerMetadata: {
+            nativeExecutor: kind,
+            nativeSessionId: sessionId,
+            nativeContinuationMode: request.continuation ? "resume" : "fresh",
+            fleetAccounting: {
+              billingProvider: profile.billingProvider,
+              authKind: "subscription",
+              accountId: request.model.nativeExecutor?.accountId,
+            },
+          },
+        };
+        events.push({
+          type: "finish",
+          finishReason: result.finishReason,
+          usage: result.usage,
+          providerMetadata: result.providerMetadata,
+        });
+      };
+      const launch = (messages: Parameters<Model["streamText"]>[0]["messages"]) => {
+        if (started) return;
+        started = true;
+        void (async () => {
+          if (request.signal.aborted) throw new Error(`${profile.label} turn stopped`);
+          const env = environment(mode);
+          version = await acpCliVersion(executable, env);
+          session = await openAcpSession({
+            kind,
+            executable,
+            cwd: request.workingDirectory,
+            env,
+            resumeSessionId: request.continuation?.sessionId,
+            onNotification,
+            onRequest,
+            onExit: (code, stderr) => {
+              if (!completed && !closed)
+                fail(new Error(stderr.trim().split("\n").at(-1) || `${profile.label} exited (${code ?? "signal"})`));
+            },
+          });
+          if (closed) {
+            session.client.close();
+            return;
+          }
+          const modelId = String(request.model.modelId);
+          if (!(await setAcpOption(session, "model", modelId)))
+            throw new Error(`${profile.label} does not offer model ${modelId} for this account`);
+          await setAcpOption(session, "mode", mode === "plan" ? profile.planMode : profile.manualMode);
+          const effort = request.model.options.reasoningLevel;
+          if (effort && effort !== "auto") await setAcpOption(session, "thought_level", effort);
+          const resumed = Boolean(request.continuation);
+          const images = session.images ? latestImageBlocks(messages) : [];
+          const prompt = nativeTranscriptPrompt(messages, resumed, request.continuationMessageOffset, {
+            images: images.length > 0,
+          });
+          if (!prompt && !images.length) throw new Error(`${profile.label} received an empty prompt`);
+          const response = await session.client.request<{ stopReason?: string; usage?: unknown }>("session/prompt", {
+            sessionId: session.sessionId,
+            prompt: [{ type: "text", text: prompt }, ...images],
+          });
+          if (response.stopReason === "cancelled") throw new Error(`${profile.label} turn stopped`);
+          finish(response.stopReason, acpUsage(response.usage), session.sessionId);
+        })().catch(fail);
+      };
+      const model: Model = {
+        ...request.model,
+        bind() {
+          return model;
+        },
+        async generateText(input) {
+          let body = "";
+          for await (const event of model.streamText(input)) {
+            if (event.type === "text_delta") body += event.text;
+            if (event.type === "finish")
+              return { text: body, finishReason: event.finishReason, usage: event.usage, providerMetadata: event.providerMetadata };
+          }
+          throw new Error(`${profile.label} ended without a result`);
+        },
+        async *streamText(input) {
+          launch(input.messages);
+          for (;;) {
+            const event = await events.next();
+            yield event;
+            if (event.type === "finish") return;
+          }
+        },
+      };
+      const stop = () => {
+        // ACP cancellation: notify, then the agent answers the prompt with stopReason "cancelled".
+        if (session && !completed) session.client.notify("session/cancel", { sessionId: session.sessionId });
+        setTimeout(() => fail(new Error(`${profile.label} turn stopped`)), 3000).unref();
+      };
+      request.signal.addEventListener("abort", stop, { once: true });
+      return {
+        model,
+        async checkpoint(): Promise<NativeAgentContinuation | undefined> {
+          if (!completed || !session || !version) return undefined;
+          return {
+            sessionId: session.sessionId,
+            cachePath: cachePath(kind, session.sessionId),
+            cacheFingerprint: fingerprint(kind, session.sessionId, version),
+            executorVersion: version,
+          };
+        },
+        admitNextStep() {
+          if (closed || request.signal.aborted) throw new Error(`${profile.label} turn stopped`);
+          events.push({ type: "start" });
+        },
+        // 工具在厂商进程内执行；需要确认的操作经 requestApproval 走 Host 的审批卡片，没有回执需回传。
+        retainToolReceipts() {},
+        async close() {
+          request.signal.removeEventListener("abort", stop);
+          closed = true;
+          session?.client.close();
+        },
+      };
+    },
+  };
+}
