@@ -0,0 +1,98 @@
+import { accessSync, constants } from "node:fs";
+import { execFile } from "node:child_process";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { withNativeExecutorNetwork } from "./native-network.js";
+
+/**
+ * agy 的默认安装位置是 ~/.local/bin/agy；桌面应用的 PATH 通常不含该目录，所以先找它再回退 PATH。
+ */
+export function resolveAntigravityExecutable(override?: string): string {
+  if (override) return override;
+  const name = process.platform === "win32" ? "agy.exe" : "agy";
+  for (const candidate of [join(homedir(), ".local", "bin", name)]) {
+    try {
+      accessSync(candidate, constants.X_OK);
+      return candidate;
+    } catch {
+      /* fall back to PATH */
+    }
+  }
+  return name;
+}
+
+/** agy has no account query; one local sign-in is bound to this fixed identity. */
+export const ANTIGRAVITY_LOCAL_ACCOUNT = "antigravity-local";
+
+function run(
+  executable: string,
+  args: string[],
+  env: NodeJS.ProcessEnv,
+  timeout = 30_000,
+): Promise<{ stdout: string; stderr: string }> {
+  return new Promise((resolve, reject) => {
+    execFile(executable, args, { env, timeout, maxBuffer: 1024 * 1024 }, (error, stdout, stderr) => {
+      if (error) reject(Object.assign(error, { stdout, stderr }));
+      else resolve({ stdout, stderr });
+    });
+  });
+}
+
+export interface AntigravityModel {
+  id: string;
+  name: string;
+}
+
+/** `agy models` prints `id<TAB>label` rows after an optional progress line. */
+export function parseAgyModels(stdout: string): AntigravityModel[] {
+  const models: AntigravityModel[] = [];
+  for (const line of stdout.split(/\r?\n/u)) {
+    const [id, name] = line.split("\t");
+    if (!id || !name || !/^[a-z0-9][a-z0-9._-]{0,127}$/iu.test(id.trim())) continue;
+    if (!models.some((model) => model.id === id.trim()))
+      models.push({ id: id.trim(), name: name.trim() });
+  }
+  return models;
+}
+
+export function antigravityEnvironment(overrides: Record<string, string | undefined> = {}) {
+  const env: NodeJS.ProcessEnv = { ...process.env, ...overrides };
+  // agy 使用自身的 Google 登录；继承的 Gemini API 变量会把它切到另一条计费路线。
+  delete env.GEMINI_API_KEY;
+  delete env.GOOGLE_GEMINI_BASE_URL;
+  return withNativeExecutorNetwork(env, "antigravity");
+}
+
+type Options = { executable?: string; env?: Record<string, string | undefined> };
+
+/** Local only: identifies the executor build that owns a resumable conversation. */
+export async function antigravityVersion(options: Options = {}): Promise<string> {
+  const executable = resolveAntigravityExecutable(options.executable);
+  try {
+    const { stdout } = await run(executable, ["--version"], antigravityEnvironment(options.env), 10_000);
+    return stdout.trim() || "agy";
+  } catch {
+    throw new Error("Antigravity CLI (agy) is not installed or cannot start");
+  }
+}
+
+/** Public CLI controls only: version and authenticated model catalog. No prompt is sent. */
+export async function inspectAntigravityConnection(
+  options: Options = {},
+): Promise<{ version: string; models: AntigravityModel[] }> {
+  const version = await antigravityVersion(options);
+  let stdout = "";
+  try {
+    stdout = (await run(resolveAntigravityExecutable(options.executable), ["models"], antigravityEnvironment(options.env))).stdout;
+  } catch (error) {
+    const failure = error as { killed?: boolean; stderr?: string };
+    // 超时多为无法连到 Google（终端代理不会被图形应用继承），不能误报成未登录。
+    if (failure.killed || !/sign in/iu.test(failure.stderr ?? ""))
+      throw new Error("Antigravity CLI failed: network (check the network or proxy)");
+    throw new Error("Sign in to the official Antigravity CLI first: run `agy` in a terminal");
+  }
+  const models = parseAgyModels(stdout);
+  if (!models.length)
+    throw new Error("Sign in to the official Antigravity CLI first: run `agy` in a terminal");
+  return { version, models };
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-turn.ts b/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-turn.ts
new file mode 100644
index 0000000..85112ff
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-turn.ts
@@ -0,0 +1,241 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { createHash } from "node:crypto";
+import { createInterface } from "node:readline";
+import type {
+  Model,
+  ModelResult,
+  ModelUsage,
+  NativeAgentContinuation,
+  NativeAgentPort,
+} from "@zcode/contracts";
+import { NativeEvents } from "./native-events.js";
+import {
+  addAgyUsage,
+  agyPermissionArgs,
+  agyPrompt,
+  decodeAgyFrame,
+  isAgyConversationId,
+} from "./antigravity-wire.js";
+import {
+  antigravityEnvironment,
+  antigravityVersion,
+  resolveAntigravityExecutable,
+} from "./antigravity-inspect.js";
+
+const SIGN_IN = "Sign in to the official Antigravity CLI first: run `agy` in a terminal";
+const cachePath = (conversationId: string) => `agy-conversation:${conversationId}`;
+const fingerprint = (conversationId: string, version: string) =>
+  createHash("sha256").update(JSON.stringify([conversationId, version])).digest("hex");
+
+/**
+ * Official Antigravity CLI as one complete executor per turn (Paseo antigravity-provider and
+ * AionCore backend/antigravity mechanisms). agy keeps its own conversation; Fleet resumes it with
+ * `--conversation` and owns canonical history, usage and the permission choice (OV-094).
+ */
+export function createAntigravityNativeAgentPort(
+  options: { env?: Record<string, string | undefined> } = {},
+): NativeAgentPort {
+  return {
+    async canResume(continuation, request) {
+      if (
+        !isAgyConversationId(continuation.sessionId) ||
+        continuation.cachePath !== cachePath(continuation.sessionId)
+      )
+        return false;
+      try {
+        const version = await antigravityVersion({
+          executable: request.model.nativeExecutor?.executable,
+          env: options.env,
+        });
+        return (
+          version === continuation.executorVersion &&
+          continuation.cacheFingerprint === fingerprint(continuation.sessionId, version)
+        );
+      } catch {
+        return false;
+      }
+    },
+    createTurn(request) {
+      if (request.model.nativeExecutor?.kind !== "antigravity")
+        throw new Error("Unsupported native Agent executor");
+      const events = new NativeEvents();
+      const executable = resolveAntigravityExecutable(request.model.nativeExecutor.executable);
+      let child: ChildProcessWithoutNullStreams | undefined;
+      let started = false;
+      let closed = false;
+      let completed = false;
+      let conversationId = request.continuation?.sessionId;
+      let version: string | undefined;
+      let usage: ModelUsage = {};
+      let stderr = "";
+      const fail = (error: unknown) => {
+        if (closed) return;
+        closed = true;
+        events.push(error instanceof Error ? error : new Error("Antigravity execution failed"));
+        child?.kill("SIGINT");
+      };
+      const finish = (text: string) => {
+        completed = true;
+        // agy 的流式增量按字节切分，会把跨块的中文截成乱码；与 AionCore 一致只采用 result.response。
+        if (text) events.push({ type: "text_delta", text });
+        const result: ModelResult = {
+          text,
+          usage,
+          finishReason: "stop",
+          providerMetadata: {
+            nativeExecutor: "antigravity",
+            nativeSessionId: conversationId,
+            nativeContinuationMode: request.continuation ? "resume" : "fresh",
+            fleetAccounting: {
+              billingProvider: "google",
+              authKind: "subscription",
+              accountId: request.model.nativeExecutor?.accountId,
+            },
+          },
+        };
+        events.push({
+          type: "finish",
+          finishReason: result.finishReason,
+          usage: result.usage,
+          providerMetadata: result.providerMetadata,
+        });
+      };
+      const launch = (messages: Parameters<Model["streamText"]>[0]["messages"]) => {
+        if (started) return;
+        started = true;
+        void (async () => {
+          if (request.signal.aborted) throw new Error("Antigravity turn stopped");
+          version = await antigravityVersion({ executable, env: options.env });
+          const resumed = Boolean(request.continuation);
+          const prompt = agyPrompt(messages, resumed, request.continuationMessageOffset);
+          if (!prompt) throw new Error("Antigravity received an empty prompt");
+          const args = [
+            "--input-format",
+            "stream-json",
+            "--output-format",
+            "stream-json",
+            "--add-dir",
+            request.workingDirectory,
+            "--disable-slash-commands",
+            ...agyPermissionArgs(request.collaborationMode),
+            "--model",
+            String(request.model.modelId),
+            ...(resumed && conversationId ? ["--conversation", conversationId] : []),
+          ];
+          child = spawn(executable, args, {
+            cwd: request.workingDirectory,
+            env: antigravityEnvironment(options.env),
+            stdio: "pipe",
+          });
+          child.stderr.on("data", (chunk: Buffer) => {
+            stderr = (stderr + chunk.toString()).slice(-4096);
+          });
+          child.on("error", fail);
+          child.on("close", (code) => {
+            if (!completed && !closed)
+              fail(
+                new Error(
+                  /authentication|sign.?in|log.?in/iu.test(stderr)
+                    ? SIGN_IN
+                    : `Antigravity exited before finishing (${code ?? "signal"})`,
+                ),
+              );
+          });
+          const lines = createInterface({ input: child.stdout });
+          lines.on("line", (line) => {
+            if (!line.trim() || closed) return;
+            try {
+              const frame = decodeAgyFrame(line);
+              if (!frame) return;
+              if (frame.event === "init") {
+                if (resumed && conversationId && frame.conversation_id !== conversationId)
+                  throw new Error("Antigravity resumed a different conversation");
+                conversationId = frame.conversation_id;
+                return;
+              }
+              if (frame.event === "step_update") {
+                const step = frame.step_update;
+                if (step.step_type === "agent_response" && step.state === "DONE")
+                  usage = addAgyUsage(usage, step.usage);
+                return;
+              }
+              const result = frame.result;
+              if (result.status !== "SUCCESS")
+                throw new Error(
+                  /authentication/iu.test(result.error ?? "")
+                    ? SIGN_IN
+                    : result.error?.trim() || "Antigravity turn failed",
+                );
+              const denied = (result.denied_actions ?? [])
+                .map((item) => item.display_name || item.action)
+                .filter(Boolean);
+              const note = denied.length
+                ? `\n\n> Antigravity 未执行需要确认的操作：${denied.join("、")}。如需执行，请在输入框切换到“自动编辑”或“完全访问”。`
+                : "";
+              finish(`${result.response ?? ""}${note}`);
+              child?.stdin.end();
+            } catch (error) {
+              fail(error);
+            }
+          });
+          child.stdin.write(
+            `${JSON.stringify({ event: "user", message: { role: "user", content: prompt } })}\n`,
+          );
+        })().catch(fail);
+      };
+      const model: Model = {
+        ...request.model,
+        bind() {
+          return model;
+        },
+        async generateText(input) {
+          let body = "";
+          for await (const event of model.streamText(input)) {
+            if (event.type === "text_delta") body += event.text;
+            if (event.type === "finish")
+              return {
+                text: body,
+                finishReason: event.finishReason,
+                usage: event.usage,
+                providerMetadata: event.providerMetadata,
+              };
+          }
+          throw new Error("Antigravity ended without a result");
+        },
+        async *streamText(input) {
+          launch(input.messages);
+          for (;;) {
+            const event = await events.next();
+            yield event;
+            if (event.type === "finish") return;
+          }
+        },
+      };
+      const stop = () => fail(new Error("Antigravity turn stopped"));
+      request.signal.addEventListener("abort", stop, { once: true });
+      return {
+        model,
+        async checkpoint(): Promise<NativeAgentContinuation | undefined> {
+          if (!completed || !conversationId || !version) return undefined;
+          return {
+            sessionId: conversationId,
+            cachePath: cachePath(conversationId),
+            cacheFingerprint: fingerprint(conversationId, version),
+            executorVersion: version,
+          };
+        },
+        admitNextStep() {
+          if (closed || request.signal.aborted) throw new Error("Antigravity turn stopped");
+          events.push({ type: "start" });
+        },
+        // agy 的工具在其自身进程内执行，没有需要 Host 回传的工具回执。
+        retainToolReceipts() {},
+        async close() {
+          request.signal.removeEventListener("abort", stop);
+          if (child && child.exitCode === null && !completed) child.kill("SIGINT");
+          closed = true;
+        },
+      };
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-wire.ts b/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-wire.ts
