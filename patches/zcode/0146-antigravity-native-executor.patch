@@ -0,0 +1,170 @@
+import assert from "node:assert/strict";
+import { chmodSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import {
+  addAgyUsage,
+  agyPermissionArgs,
+  agyPrompt,
+  decodeAgyFrame,
+} from "../../../apps/zcode-cli/packages/adapters/src/native-agent/antigravity-wire.js";
+import { parseAgyModels } from "../../../apps/zcode-cli/packages/adapters/src/native-agent/antigravity-inspect.js";
+import { createAntigravityNativeAgentPort } from "../../../apps/zcode-cli/packages/adapters/src/native-agent/antigravity-turn.js";
+
+const CONVERSATION = "b966b16a-caf4-448a-bb24-0e34956022b0";
+
+test("agy models rows keep id/label pairs and skip the progress line", () => {
+  assert.deepEqual(
+    parseAgyModels("Fetching available models...\ngemini-3-pro\tGemini 3 Pro\nclaude-sonnet-4-6\tClaude Sonnet 4.6\ngemini-3-pro\tdup\n"),
+    [
+      { id: "gemini-3-pro", name: "Gemini 3 Pro" },
+      { id: "claude-sonnet-4-6", name: "Claude Sonnet 4.6" },
+    ],
+  );
+});
+
+test("frames follow the agy 1.2.13 capture shape; unknown kinds are ignored", () => {
+  assert.equal(decodeAgyFrame(JSON.stringify({ event: "init", conversation_id: CONVERSATION }))?.event, "init");
+  assert.throws(() => decodeAgyFrame(JSON.stringify({ event: "init", conversation_id: "" })));
+  assert.throws(() => decodeAgyFrame(JSON.stringify({ event: "result", result: { status: "MAYBE" } })));
+  assert.equal(decodeAgyFrame(JSON.stringify({ event: "heartbeat" })), undefined);
+});
+
+test("usage sums per-step counters and leaves unreported counters absent", () => {
+  const once = addAgyUsage({}, { input_tokens: 10, output_tokens: 2, total_tokens: 12 });
+  assert.deepEqual(addAgyUsage(once, { input_tokens: 5, output_tokens: 1, total_tokens: 6 }), {
+    inputTokens: 15,
+    outputTokens: 3,
+    reasoningTokens: undefined,
+    cacheReadTokens: undefined,
+    totalTokens: 18,
+  });
+});
+
+test("the composer permission choice maps onto agy's own modes (OV-094)", () => {
+  assert.deepEqual(agyPermissionArgs("plan"), ["--mode", "plan"]);
+  assert.deepEqual(agyPermissionArgs("build"), []);
+  assert.deepEqual(agyPermissionArgs("edit"), ["--mode", "accept-edits"]);
+  assert.deepEqual(agyPermissionArgs("yolo"), ["--dangerously-skip-permissions"]);
+});
+
+test("a fresh prompt carries instructions and transcript; a resumed one only the uncovered tail", () => {
+  const messages = [
+    { role: "system" as const, content: "Fleet rules" },
+    { role: "user" as const, content: "first" },
+    { role: "assistant" as const, content: [{ type: "text" as const, text: "answer" }] },
+    { role: "user" as const, content: "second" },
+  ];
+  assert.equal(agyPrompt(messages, false), "Fleet rules\n\nUser: first\n\nAssistant: answer\n\nsecond");
+  assert.equal(agyPrompt(messages, true, 2), "second");
+});
+
+/** A stand-in agy that records its argv and stdin, then replays captured frames. */
+function fakeAgy(frames: object[], exitCode = 0) {
+  const dir = mkdtempSync(join(tmpdir(), "fake-agy-"));
+  const script = join(dir, "agy");
+  writeFileSync(
+    script,
+    `#!/usr/bin/env node
+const fs = require("node:fs");
+const args = process.argv.slice(2);
+if (args[0] === "--version") { console.log("1.2.14"); process.exit(0); }
+if (args[0] === "models") { console.log("gemini-3-pro\\tGemini 3 Pro"); process.exit(0); }
+fs.writeFileSync(${JSON.stringify(join(dir, "argv.json"))}, JSON.stringify(args));
+let input = "";
+process.stdin.on("data", (chunk) => {
+  input += chunk;
+  if (!input.includes("\\n")) return;
+  fs.writeFileSync(${JSON.stringify(join(dir, "stdin.json"))}, input);
+  for (const frame of ${JSON.stringify(frames)}) process.stdout.write(JSON.stringify(frame) + "\\n");
+  if (${exitCode}) process.exit(${exitCode});
+});
+process.stdin.on("end", () => process.exit(0));
+`,
+  );
+  chmodSync(script, 0o755);
+  return {
+    script,
+    argv: () => JSON.parse(readFileSync(join(dir, "argv.json"), "utf8")) as string[],
+    stdin: () => JSON.parse(readFileSync(join(dir, "stdin.json"), "utf8")),
+  };
+}
+
+function request(executable: string, extra: Record<string, unknown> = {}) {
+  return {
+    model: {
+      modelId: "gemini-3-pro",
+      nativeExecutor: { kind: "antigravity" as const, executable, accountId: "antigravity-local" },
+    } as never,
+    messages: [{ role: "user" as const, content: "你好" }],
+    tools: [],
+    sessionId: "s1",
+    turnId: "t1",
+    workingDirectory: tmpdir(),
+    signal: new AbortController().signal,
+    ...extra,
+  };
+}
+
+async function drain(turn: ReturnType<ReturnType<typeof createAntigravityNativeAgentPort>["createTurn"]>) {
+  turn.admitNextStep();
+  const events = [];
+  for await (const event of turn.model.streamText({ messages: request("").messages } as never))
+    events.push(event);
+  return events;
+}
+
+test("a real child process turn uses result.response, sums step usage and checkpoints the conversation", async () => {
+  const agy = fakeAgy([
+    { event: "init", conversation_id: CONVERSATION },
+    { event: "step_update", step_update: { step_index: 1, state: "ACTIVE", step_type: "agent_response", text_delta: "�" } },
+    {
+      event: "step_update",
+      step_update: { step_index: 1, state: "DONE", step_type: "agent_response", usage: { input_tokens: 7, output_tokens: 3, total_tokens: 10 } },
+    },
+    { event: "result", result: { status: "SUCCESS", response: "你好！", denied_actions: [{ action: "command", display_name: "RunCommand" }] } },
+  ]);
+  const turn = createAntigravityNativeAgentPort().createTurn(request(agy.script, { collaborationMode: "edit" }));
+  const events = await drain(turn);
+  const text = events.flatMap((event) => (event.type === "text_delta" ? [event.text] : [])).join("");
+  assert.match(text, /^你好！/u);
+  assert.match(text, /RunCommand/u);
+  const finish = events.at(-1);
+  assert.equal(finish?.type, "finish");
+  if (finish?.type === "finish") assert.deepEqual(finish.usage, { inputTokens: 7, outputTokens: 3, reasoningTokens: undefined, cacheReadTokens: undefined, totalTokens: 10 });
+  assert.deepEqual(agy.argv().slice(-4), ["--mode", "accept-edits", "--model", "gemini-3-pro"]);
