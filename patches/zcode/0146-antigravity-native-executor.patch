+import { FLEET_NATIVE_EXECUTOR_NETWORK_ENV_KEY } from "@zcode/shared";
+import { applyNetworkEgressEnv, type NetworkEgressEnvPolicy } from "../network/subprocess-env.js";
+
+export type NativeExecutorKind = "claude" | "codex" | "antigravity";
+
+const PROXY_KEYS = ["HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy"];
+
+function routes(value: string | undefined): Partial<Record<NativeExecutorKind, NetworkEgressEnvPolicy>> {
+  if (!value) return {};
+  try {
+    const parsed = JSON.parse(value) as unknown;
+    return parsed && typeof parsed === "object" ? (parsed as Record<string, NetworkEgressEnvPolicy>) : {};
+  } catch {
+    return {};
+  }
+}
+
+/**
+ * GUI 启动的应用不继承终端代理变量。Host 在 Agent 启动时按各官方端点解析系统路由，这里只把对应
+ * 执行器的那一条应用到其子进程；已有显式代理（应用设置或继承的环境）时保持不变，Bash/MCP 不受影响。
+ */
+export function withNativeExecutorNetwork(env: NodeJS.ProcessEnv, kind: NativeExecutorKind): NodeJS.ProcessEnv {
+  const route = routes(env[FLEET_NATIVE_EXECUTOR_NETWORK_ENV_KEY])[kind];
+  delete env[FLEET_NATIVE_EXECUTOR_NETWORK_ENV_KEY];
+  if (!route?.httpProxy || PROXY_KEYS.some((key) => env[key]?.trim())) return env;
+  return applyNetworkEgressEnv(env as Record<string, string>, {
+    network: route,
+    sourceEnv: {},
+    toolEnvPassthrough: false,
+  });
+}
