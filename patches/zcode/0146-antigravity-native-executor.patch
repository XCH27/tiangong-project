+++ b/apps/zcode-cli/packages/adapters/src/native-agent/antigravity-wire.ts
@@ -0,0 +1,143 @@
+import type { CollaborationMode, ModelInputMessage, ModelUsage } from "@zcode/contracts";
+
+/**
+ * Antigravity CLI (`agy`) stream-json contract, as captured from agy 1.2.13 by Paseo
+ * (plugins/antigravity-provider/test/fixtures) and used by AionCore backend/antigravity.
+ * Frames: init{conversation_id} → step_update{step_type,state,text_delta,usage} → result{status,response}.
+ */
+export interface AgyInit {
+  event: "init";
+  conversation_id: string;
+}
+export interface AgyStep {
+  event: "step_update";
+  step_update: {
+    step_index: number;
+    state: "ACTIVE" | "DONE" | "ERROR";
+    step_type: string;
+    text_delta?: string;
+    tool_name?: string;
+    usage?: AgyUsage | null;
+  };
+}
+export interface AgyResult {
+  event: "result";
+  result: {
+    conversation_id?: string;
+    status: "SUCCESS" | "ERROR";
+    response?: string;
+    error?: string;
+    denied_actions?: { action: string; display_name: string }[];
+  };
+}
+export type AgyFrame = AgyInit | AgyStep | AgyResult;
+interface AgyUsage {
+  input_tokens?: number;
+  output_tokens?: number;
+  thinking_tokens?: number;
+  cache_read_tokens?: number;
+  total_tokens?: number;
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/iu;
+export const isAgyConversationId = (value: unknown): value is string =>
+  typeof value === "string" && UUID.test(value);
+
+/** Unknown frame kinds are ignored; malformed known frames fail the turn. */
+export function decodeAgyFrame(line: string): AgyFrame | undefined {
+  const value = JSON.parse(line) as Record<string, unknown>;
+  if (!value || typeof value !== "object") throw new Error("Invalid Antigravity frame");
+  if (value.event === "init") {
+    if (!isAgyConversationId(value.conversation_id)) throw new Error("Invalid Antigravity conversation");
+    return value as unknown as AgyInit;
+  }
+  if (value.event === "step_update") {
+    const step = value.step_update as Record<string, unknown> | undefined;
+    if (!step || typeof step.step_type !== "string" || typeof step.state !== "string")
+      throw new Error("Invalid Antigravity step");
+    return value as unknown as AgyStep;
+  }
+  if (value.event === "result") {
+    const result = value.result as Record<string, unknown> | undefined;
+    if (!result || (result.status !== "SUCCESS" && result.status !== "ERROR"))
+      throw new Error("Invalid Antigravity result");
+    return value as unknown as AgyResult;
+  }
+  return undefined;
+}
+
+const count = (value: unknown) =>
+  typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined;
+
+/** Sum the per-step usage agy reports on DONE agent steps; unknown counters stay absent. */
+export function addAgyUsage(total: ModelUsage, usage: AgyUsage | null | undefined): ModelUsage {
+  if (!usage) return total;
+  const add = (left: number | undefined, right: unknown) => {
+    const value = count(right);
+    return value === undefined ? left : (left ?? 0) + value;
+  };
+  return {
+    ...total,
+    inputTokens: add(total.inputTokens, usage.input_tokens),
+    outputTokens: add(total.outputTokens, usage.output_tokens),
+    reasoningTokens: add(total.reasoningTokens, usage.thinking_tokens),
+    cacheReadTokens: add(total.cacheReadTokens, usage.cache_read_tokens),
+    totalTokens: add(total.totalTokens, usage.total_tokens),
+  };
+}
+
+/**
+ * Fleet 权限选择 → agy 参数（OV-094）。agy 无法在 stream-json 中转发确认请求：
+ * plan（计划模式）→ --mode plan；build（变更前确认）与未暴露的 auto → 默认（agy 需确认的工具被拒绝并在
+ * result.denied_actions 中报告）；edit（自动编辑）→ --mode accept-edits；yolo（完全访问）→
+ * --dangerously-skip-permissions。
+ */
+export function agyPermissionArgs(mode: CollaborationMode | undefined): string[] {
+  if (mode === "plan") return ["--mode", "plan"];
+  if (mode === "edit") return ["--mode", "accept-edits"];
+  if (mode === "yolo") return ["--dangerously-skip-permissions"];
+  return [];
+}
+
+function text(content: ModelInputMessage["content"]): string {
+  if (typeof content === "string") return content;
+  return content
+    .map((block) =>
+      block.type === "text"
+        ? block.text
+        : block.type === "image"
+          ? "[An attached image is not available to Antigravity in this turn]"
+          : block.type === "reasoning"
+            ? ""
+            : "",
+    )
+    .filter(Boolean)
+    .join("\n");
+}
+
+/**
+ * One user event per Fleet turn. A resumed agy conversation already holds its history, so only
+ * messages after the covered offset are sent; a fresh one receives Fleet instructions and the
+ * visible transcript once.
+ */
+export function agyPrompt(
+  messages: readonly ModelInputMessage[],
+  resumed: boolean,
+  offset = 0,
+): string {
+  const system = messages.filter((message) => message.role === "system").map((m) => text(m.content));
+  const visible = messages.filter((message) => message.role !== "system");
+  const pending = resumed ? visible.slice(offset) : visible;
+  const last = pending.at(-1);
+  const prior = pending.slice(0, -1);
+  const parts: string[] = [];
+  if (!resumed && system.length) parts.push(system.join("\n\n"));
+  if (prior.length)
+    parts.push(
+      prior
+        .map((message) => `${message.role === "assistant" ? "Assistant" : "User"}: ${text(message.content)}`)
+        .join("\n\n"),
+    );
+  if (last) parts.push(text(last.content));
+  return parts.join("\n\n").trim();
+}
