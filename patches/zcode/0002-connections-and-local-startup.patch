-    (
-      nextTarget: CodingPlanUpgradeDialogTarget,
-      observation?: { signal: AbortSignal; onResult: (opened: boolean) => void },
-    ) => {
-      // 所有入口统一守卫；查询完成后不自动重放之前被拦截的点击。
-      const { status, entryPlanList } = inventoryRef.current;
