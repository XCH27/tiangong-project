diff --git a/apps/zcode-cli/packages/adapters/src/model/pi-subscription.ts b/apps/zcode-cli/packages/adapters/src/model/pi-subscription.ts
new file mode 100644
index 0000000..31aa4e3
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/pi-subscription.ts
@@ -0,0 +1,388 @@
+import { createStatusContext, publishModelStatus } from "./runner-status.js";
+import {
+  createLinkedAbortController,
+  readNextWithStreamIdleTimeout,
+  DEFAULT_MODEL_STREAM_IDLE_TIMEOUT_MS,
+  isModelStreamIdleTimeoutError,
+} from "./stream-idle-timeout.js";
+import type {
+  AssistantMessage,
+  AssistantMessageEvent,
+  Message,
+  Model as PiModel,
+  Provider,
+  ThinkingLevel,
+  Tool,
+  Usage,
+} from "@earendil-works/pi-ai";
+import { openaiCodexProvider } from "@earendil-works/pi-ai/providers/openai-codex";
+import { githubCopilotProvider } from "@earendil-works/pi-ai/providers/github-copilot";
+import { normalizeContext } from "@earendil-works/pi-ai/utils/transcript";
+import {
+  ModelFailureReason,
+  ModelTransportKind,
+  getCurrentModelInvocationContext,
+  type ModelInputMessage,
+  type ModelStreamEvent,
+  type ModelTextResult,
+  type ModelUsage,
+  type ModelId,
+  type ModelProviderId,
+  type ModelRequestAdmissionTicket,
+} from "@zcode/contracts";
+import { createModel, type ModelExecutionRequest } from "./model.js";
+import type { CreateAiSdkModelOptions } from "./runner.js";
+
+const emptyUsage: Usage = {
+  input: 0,
+  output: 0,
+  cacheRead: 0,
+  cacheWrite: 0,
+  totalTokens: 0,
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+export function createPiSubscriptionModel(
+  options: CreateAiSdkModelOptions,
+  fetch: typeof globalThis.fetch,
+  providerOverride?: Provider,
+) {
+  const access = options.providerConfig.access;
+  if (access.type !== "subscription") throw new Error("Expected a subscription connection");
+  const subscriptionKind = access.provider;
+  const provider =
+    providerOverride ??
+    (access.provider === "openai-codex" ? openaiCodexProvider() : githubCopilotProvider());
+  const catalogModel = provider.getModels().find((model) => model.id === options.modelId);
+  if (!catalogModel)
+    throw new Error(`Model is not in this subscription catalog: ${options.modelId}`);
+  async function* events(request: ModelExecutionRequest): AsyncGenerator<AssistantMessageEvent> {
+    const linked = createLinkedAbortController(request.abortSignal);
+    const invocation = getCurrentModelInvocationContext();
+    const target = {
+      providerId: options.providerId as ModelProviderId,
+      modelId: options.modelId as ModelId,
+    };
+    const status = createStatusContext({
+      maxAttempts: 1,
+      transport: ModelTransportKind.Sse,
+      request: { ...request, ...invocation },
+      resolved: { ...target, baseURL: catalogModel?.baseUrl, providerKind: "openai-compatible" },
+    });
+    const startedAt = Date.now();
+    let ticket: ModelRequestAdmissionTicket | undefined;
+    const publishOptions: Parameters<typeof publishModelStatus>[1] = {
+      requestStatusSink: invocation?.statusSink,
+    };
+    try {
+      ticket = await invocation?.modelRequestAdmission?.acquire({
+        model: target,
+        signal: linked.signal,
+      });
+      publishOptions.admissionTicket = ticket;
+      await publishModelStatus(
+        {
+          ...status,
+          type: "model_request_started",
+          attempt: 1,
+          timestamp: new Date().toISOString(),
+        },
+        publishOptions,
+      );
+      request.abortSignal?.throwIfAborted();
+      const result = await invocation?.refreshRuntimeHeadersBeforeAttempt?.({
+        providerId: options.providerId,
+        modelId: options.modelId,
+        subscriptionAccess: { provider: subscriptionKind },
+        attempt: 0,
+        abortSignal: linked.signal,
+        reason: "model-request",
+      });
+      const auth = result?.requestAuth;
+      if (!result?.headersApplied || !auth?.apiKey)
+        throw new Error("Sign in to this subscription connection before using its models");
+      request.abortSignal?.throwIfAborted();
+      const model = {
+        ...catalogModel,
+        ...(auth.baseUrl ? { baseUrl: auth.baseUrl } : {}),
+      } as PiModel<string>;
+      if (request.responseJsonSchema)
+        throw new Error("Structured output is not available through this subscription adapter");
+      if (request.tools?.some((tool) => tool.providerNative))
+        throw new Error("Provider-native tools are not supported by this subscription adapter");
+      const messages = request.messages.map((message) =>
+        toPiMessage(message, model, options.providerId),
+      );
+      const tools = request.tools?.map((tool) => ({
+        name: tool.name,
+        description: tool.description ?? "",
+        parameters: tool.inputSchema as Tool["parameters"],
+      }));
+      // 工具声明和首条系统提示必须是同一个 transcript 起点，不能插入空 system 遮掉原提示。
+      if (messages[0]?.role === "system") messages[0] = { ...messages[0], toolsAdded: tools };
+      else if (tools?.length)
+        messages.unshift({ role: "system", content: "", toolsAdded: tools, timestamp: 0 });
+      const context = normalizeContext({ messages });
+      const reasoning = request.options.reasoningLevel;
+      if (!["off", "minimal", "low", "medium", "high", "xhigh", "max"].includes(reasoning))
+        throw new Error(`Unsupported reasoning level: ${reasoning}`);
+      const stream = provider.streamSimple(model, context, {
+        apiKey: auth.apiKey,
+        headers: auth.headers,
+        fetch,
+        signal: linked.signal,
+        transport: "sse",
+        maxRetries: 2,
+        maxTokens: request.options.maxOutputTokens,
+        reasoning: reasoning === "off" ? undefined : (reasoning as ThinkingLevel),
+        sessionId: invocation?.traceContext?.sessionId,
+      });
+      const iterator = stream[Symbol.asyncIterator]();
+      while (true) {
+        const next = await readNextWithStreamIdleTimeout(iterator, {
+          abortController: linked.controller,
+          timeoutMs: DEFAULT_MODEL_STREAM_IDLE_TIMEOUT_MS,
+        });
+        if (next.done) break;
+        if (next.value.type === "error")
+          throw new Error(next.value.error.errorMessage ?? next.value.reason);
+        if (next.value.type === "done")
+          await publishModelStatus(
+            {
+              ...status,
+              type: "model_request_completed",
+              attempt: 1,
+              timestamp: new Date().toISOString(),
+              durationMs: Date.now() - startedAt,
+              usage: toUsage(next.value.message.usage),
+              finishReason: finishReason(next.value.message),
+            },
+            publishOptions,
+          );
+        yield next.value;
+      }
+    } catch (error) {
+      await publishModelStatus(
+        {
+          ...status,
+          type: "model_request_failed",
+          attempt: 1,
+          timestamp: new Date().toISOString(),
+          durationMs: Date.now() - startedAt,
+          reason: isModelStreamIdleTimeoutError(error)
+            ? ModelFailureReason.Timeout
+            : linked.signal.aborted
+              ? ModelFailureReason.Cancelled
+              : ModelFailureReason.Unknown,
+          retryable: false,
+          message: error instanceof Error ? error.message : String(error),
+        },
+        publishOptions,
+      );
+      throw error;
+    } finally {
+      linked.controller.abort();
+      linked.cleanup();
+      ticket?.release();
+    }
+  }
+  return createModel({
+    ...options,
+    providerId: options.providerId as ModelProviderId,
+    modelId: options.modelId as ModelId,
+    properties: options.modelConfig.properties,
+    optionSpecs: options.modelConfig.optionSpecs,
+    executor: {
+      async generateText(request) {
+        for await (const event of events(request))
+          if (event.type === "done") return toResult(event.message);
+        throw new Error("Subscription stream ended without a completed response");
+      },
+      async *streamText(request): AsyncGenerator<ModelStreamEvent> {
+        for await (const event of events(request)) {
+          const id = "contentIndex" in event ? `pi-${event.contentIndex}` : "";
+          switch (event.type) {
+            case "start":
+              yield { type: "start" };
+              break;
+            case "text_start":
+              yield { type: "text_start", id };
+              break;
+            case "text_delta":
+              yield { type: "text_delta", id, text: event.delta };
+              break;
+            case "text_end":
+              yield { type: "text_end", id };
+              break;
+            case "thinking_start":
+              yield { type: "reasoning_start", id };
+              break;
+            case "thinking_delta":
+              yield { type: "reasoning_delta", id, text: event.delta };
+              break;
+            case "thinking_end": {
+              const block = event.partial.content[event.contentIndex];
+              yield {
+                type: "reasoning_end",
+                id,
+                providerMetadata:
+                  block?.type === "thinking"
+                    ? { pi: { signature: block.thinkingSignature, redacted: block.redacted } }
+                    : undefined,
+              };
+              break;
+            }
+            case "toolcall_start": {
+              const block = event.partial.content[event.contentIndex];
+              if (block?.type === "toolCall")
+                yield { type: "tool_input_start", id: block.id, toolName: block.name };
+              break;
+            }
+            case "toolcall_delta": {
+              const block = event.partial.content[event.contentIndex];
+              if (block?.type === "toolCall")
+                yield { type: "tool_input_delta", id: block.id, delta: event.delta };
+              break;
+            }
+            case "toolcall_end":
+              yield { type: "tool_input_end", id: event.toolCall.id };
+              yield {
+                type: "tool_call",
+                toolCall: {
+                  id: event.toolCall.id,
+                  name: event.toolCall.name,
+                  input: event.toolCall.arguments,
+                },
+              };
+              break;
+            case "done":
+              yield {
+                type: "finish",
+                finishReason: finishReason(event.message),
+                usage: toUsage(event.message.usage),
+              };
+              break;
+            case "error":
+              throw new Error(event.error.errorMessage ?? event.reason);
+          }
+        }
+      },
+    },
+  });
+}
+function finishReason(message: AssistantMessage) {
+  return message.stopReason === "toolUse" ? "tool-calls" : message.stopReason;
+}
+function toUsage(usage: Usage): ModelUsage {
+  // Pi reports uncached input separately; Fleet's context ring expects total input exactly once.
+  const inputTokens = usage.input + usage.cacheRead + usage.cacheWrite;
+  return {
+    inputTokens,
+    outputTokens: usage.output,
+    totalTokens: inputTokens + usage.output,
+    cacheReadTokens: usage.cacheRead,
+    cacheWriteTokens: usage.cacheWrite,
+  };
+}
+function toResult(message: AssistantMessage): ModelTextResult {
+  return {
+    text: message.content
+      .filter((block) => block.type === "text")
+      .map((block) => block.text)
+      .join(""),
+    finishReason: finishReason(message),
+    usage: toUsage(message.usage),
+    reasoning: message.content
+      .filter((block) => block.type === "thinking")
+      .map((block) => ({
+        type: "reasoning",
+        text: block.thinking,
+        providerOptions: { pi: { signature: block.thinkingSignature, redacted: block.redacted } },
+      })),
+    toolCalls: message.content
+      .filter((block) => block.type === "toolCall")
+      .map((block) => ({ id: block.id, name: block.name, input: block.arguments })),
+  };
+}
+function toPiMessage(
+  message: ModelInputMessage,
+  model: PiModel<string>,
+  connectionId: string,
+): Message {
+  const blocks =
+    typeof message.content === "string"
+      ? [{ type: "text" as const, text: message.content }]
+      : message.content;
+  const timestamp = 0; // Stable replay: history conversion must not change the cached prefix.
+  if (message.role === "assistant") {
+    const content: AssistantMessage["content"] = blocks.flatMap(
+      (block): AssistantMessage["content"] => {
+        if (block.type === "text") return [{ type: "text", text: block.text }];
+        if (block.type === "reasoning") {
+          const metadata = block.providerOptions?.pi as
+            | { signature?: string; redacted?: boolean }
+            | undefined;
+          return [
+            {
+              type: "thinking",
+              thinking: block.text,
+              thinkingSignature: metadata?.signature,
+              redacted: metadata?.redacted,
+            },
+          ];
+        }
+        throw new Error(`Unsupported assistant history block: ${block.type}`);
+      },
+    );
+    for (const tool of message.toolCalls ?? [])
+      content.push({
+        type: "toolCall",
+        id: tool.id,
+        name: tool.name,
+        arguments: tool.input as Extract<
+          AssistantMessage["content"][number],
+          { type: "toolCall" }
+        >["arguments"],
+      });
+    return {
+      role: "assistant",
+      content,
+      api: model.api,
+      provider:
+        message.providerId === undefined || message.providerId === connectionId
+          ? model.provider
+          : message.providerId,
+      model: message.modelId ?? model.id,
+      usage: emptyUsage,
+      stopReason: message.toolCalls?.length ? "toolUse" : "stop",
+      timestamp,
+    };
+  }
+  const content = blocks.map((block) => {
+    if (block.type === "text") return { type: "text" as const, text: block.text };
+    if (block.type === "file" && block.text !== undefined)
+      return { type: "text" as const, text: block.text };
+    if (block.type === "image") {
+      const match = /^data:([^;,]+);base64,([\s\S]+)$/.exec(block.dataUrl);
+      if (!match) throw new Error("Subscription image input requires a base64 data URL");
+      return { type: "image" as const, data: match[2]!, mimeType: match[1]! };
+    }
+    throw new Error(
+      `Unsupported subscription input: ${block.type}; use extracted text or a compatible API connection`,
+    );
+  });
+  if (message.role === "system") {
+    if (content.some((block) => block.type !== "text"))
+      throw new Error("System instructions must be text");
+    return { role: "system", content: content.filter((block) => block.type === "text"), timestamp };
+  }
+  if (message.role === "tool")
+    return {
+      role: "toolResult",
+      toolCallId: message.toolCallId ?? "",
+      toolName: message.toolName ?? "",
+      content,
+      isError: message.isError ?? false,
+      timestamp,
+    };
+  return { role: "user", content, timestamp };
+}
