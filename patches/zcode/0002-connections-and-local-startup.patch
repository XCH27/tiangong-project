diff --git a/packages/ui/src/hooks/useGitHubAccount.ts b/packages/ui/src/hooks/useGitHubAccount.ts
new file mode 100644
index 0000000..709478c
--- /dev/null
+++ b/packages/ui/src/hooks/useGitHubAccount.ts
@@ -0,0 +1,98 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useServices } from "./useServices.js";
+import type { IGitService } from "@zcode/services";
+type Status = Awaited<ReturnType<IGitService["githubAccountStatus"]>>;
+type Login = Awaited<ReturnType<IGitService["githubBeginLogin"]>>;
+
+export function useGitHubAccount(): {
+  status: Status | undefined;
+  login: Login | undefined;
+  busy: boolean;
+  error: boolean;
+  refresh(): Promise<void>;
+  connect(): Promise<void>;
+  cancel(): Promise<void>;
+  switchAccount(name: string): Promise<void>;
+  logout(name: string): Promise<void>;
+} {
+  const { gitService } = useServices();
+  const [status, setStatus] = useState<Status>();
+  const [login, setLogin] = useState<Login>();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState(false);
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  const run = useCallback(async (action: () => Promise<void>) => {
+    setBusy(true);
+    setError(false);
+    try {
+      await action();
+    } catch {
+      if (mounted.current) setError(true);
+    } finally {
+      if (mounted.current) setBusy(false);
+    }
+  }, []);
+  const refresh = useCallback(
+    () =>
+      run(async () => {
+        const next = await gitService.githubAccountStatus();
+        if (mounted.current) setStatus(next);
+      }),
+    [gitService, run],
+  );
+  useEffect(() => {
+    if (login?.state !== "pending") return;
+    let disposed = false;
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      try {
+        const next = await gitService.githubLoginState(login.id);
+        if (disposed) return;
+        setLogin(next);
+        if (next.state === "pending") timer = setTimeout(() => void poll(), 1000);
+        else if (next.state === "complete") await refresh();
+        else if (next.state === "failed") setError(true);
+      } catch {
+        if (!disposed) setError(true);
+      }
+    };
+    void poll();
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+    };
+  }, [gitService, login?.id, login?.state, refresh]);
+  return {
+    status,
+    login,
+    busy,
+    error,
+    refresh,
+    connect: () =>
+      run(async () => {
+        const next = await gitService.githubBeginLogin();
+        if (mounted.current) setLogin(next);
+      }),
+    cancel: () =>
+      run(async () => {
+        if (login) await gitService.githubCancelLogin(login.id);
+        if (mounted.current) setLogin(undefined);
+      }),
+    switchAccount: (name: string) =>
+      run(async () => {
+        const next = await gitService.githubSwitchAccount(name);
+        if (mounted.current) setStatus(next);
+      }),
+    logout: (name: string) =>
+      run(async () => {
+        const next = await gitService.githubLogout(name);
+        if (mounted.current) setStatus(next);
+      }),
+  };
+}
