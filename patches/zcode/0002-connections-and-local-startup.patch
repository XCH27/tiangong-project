@@ -0,0 +1,326 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createAssistantMessageEventStream } from "@earendil-works/pi-ai/utils/event-stream";
+import { openaiCodexProvider } from "@earendil-works/pi-ai/providers/openai-codex";
+import { getSupportedThinkingLevels, type Provider } from "@earendil-works/pi-ai";
+import { runWithModelInvocationContext } from "@zcode/contracts";
+import { createPiSubscriptionModel } from "../src/model/pi-subscription.js";
+const native = openaiCodexProvider()
+  .getModels()
+  .find((m) => m.id === "gpt-5.5")!;
+const config = {
+  properties: {
+    contextWindow: native.contextWindow,
+    requiresMfjsToolSchema: false,
+    inputFormat: {
+      supportsText: true,
+      supportsImage: true,
+      supportsVideo: false,
+      supportsAudio: false,
+      supportsPdf: false,
+    },
+    outputFormat: { supportsText: true },
+    supportsToolCall: true,
+    supportsJsonSchemaOutput: false,
+    supportsNativeWebSearch: false,
+    supportsMidConversationSystem: true,
+  },
+  optionSpecs: {
+    maxOutputTokens: { max: native.maxTokens, map: "{}" },
+    reasoningLevel: { values: getSupportedThinkingLevels(native), map: "{}" },
+  },
+};
+const binding = {
+  providerId: "instance-alice",
+  modelId: native.id,
+  providerConfig: {
+    access: { type: "subscription", provider: "openai-codex", connected: true },
+    api: { type: "openai-responses", baseUrl: "https://untrusted.example" },
+  },
+  modelConfig: config,
+  options: { maxOutputTokens: 256, reasoningLevel: "high" },
+} as any;
+const auth = {
+  async refreshRuntimeHeadersBeforeAttempt(input: any) {
+    assert.equal(input.providerId, "instance-alice");
+    assert.equal(input.subscriptionAccess.provider, "openai-codex");
+    return {
+      headersApplied: true,
+      requestAuth: { apiKey: "synthetic-key", baseUrl: "https://trusted-account.example" },
+    };
+  },
+};
+const usage = {
+  input: 10,
+  output: 5,
+  cacheRead: 90,
+  cacheWrite: 20,
+  totalTokens: 125,
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+const reply = {
+  role: "assistant",
+  content: [
+    { type: "thinking", thinking: "reason", thinkingSignature: "opaque-signature" },
+    { type: "text", text: "OK" },
+    { type: "toolCall", id: "call_one", name: "read_file", arguments: { path: "hello" } },
+  ],
+  api: native.api,
+  provider: native.provider,
+  model: native.id,
+  usage,
+  stopReason: "toolUse",
+  timestamp: 0,
+} as any;
+function fixture() {
+  let captured: any;
+  let released = 0;
+  const statuses: any[] = [];
+  const provider = {
+    ...openaiCodexProvider(),
+    streamSimple(model: any, context: any, options: any) {
+      captured = { model, context, options };
+      const s = createAssistantMessageEventStream();
+      queueMicrotask(() => {
+        s.push({ type: "start", partial: reply });
+        s.push({ type: "thinking_start", contentIndex: 0, partial: reply });
+        s.push({ type: "thinking_delta", contentIndex: 0, delta: "reason", partial: reply });
+        s.push({ type: "thinking_end", contentIndex: 0, content: "reason", partial: reply });
+        s.push({ type: "toolcall_start", contentIndex: 2, partial: reply });
+        s.push({
+          type: "toolcall_delta",
+          contentIndex: 2,
+          delta: '{"path":"hello"}',
+          partial: reply,
+        });
+        s.push({
+          type: "toolcall_end",
+          contentIndex: 2,
+          toolCall: reply.content[2],
+          partial: reply,
+        });
+        s.push({ type: "done", reason: "toolUse", message: reply });
+      });
+      return s;
+    },
+  } as Provider;
+  const model = createPiSubscriptionModel(
+    binding,
+    async () => {
+      throw new Error("No external network");
+    },
+    provider,
+  );
+  const context = {
+    ...auth,
+    modelRequestAdmission: {
+      async acquire() {
+        return {
+          async publish(e: any) {
+            statuses.push(e);
+          },
+          release() {
+            released++;
+          },
+        };
+      },
+    },
+  };
+  return {
+    model,
+    context,
+    get captured() {
+      return captured;
+    },
+    get released() {
+      return released;
+    },
+    statuses,
+  };
+}
+test("Pi adapter preserves signatures, tools, account endpoint, and cache usage exactly once", async () => {
+  const f = fixture();
+  const result = await runWithModelInvocationContext(f.context, () =>
+    f.model.generateText({ messages: [{ role: "user", content: "hello" }] }),
+  );
+  assert.equal(result.text, "OK");
+  assert.equal(result.usage.inputTokens, 120);
+  assert.equal(result.usage.totalTokens, 125);
+  assert.equal(result.usage.cacheReadTokens, 90);
+  assert.equal(result.toolCalls?.[0]?.id, "call_one");
+  assert.equal(f.captured.model.baseUrl, "https://trusted-account.example");
+  assert.equal(f.captured.options.apiKey, "synthetic-key");
+  assert.equal(f.captured.options.transport, "sse");
+  assert.equal(f.released, 1);
+  assert.equal(f.statuses.at(-1).type, "model_request_completed");
+  await runWithModelInvocationContext(f.context, () =>
+    f.model.generateText({
+      messages: [
+        {
+          role: "assistant",
+          providerId: "instance-alice" as any,
+          modelId: native.id as any,
+          content: result.reasoning!,
+          toolCalls: result.toolCalls,
+        },
+        { role: "tool", toolCallId: "call_one", toolName: "read_file", content: "file content" },
+      ],
+    }),
+  );
+  const history = f.captured.context.messages;
+  assert.equal(history[0].provider, native.provider);
+  assert.equal(history[0].content[0].thinkingSignature, "opaque-signature");
+  assert.equal(history[1].role, "toolResult");
+  assert.equal(history[1].toolCallId, "call_one");
+});
+test("stream tool ids and reasoning metadata survive conversion", async () => {
+  const f = fixture();
+  const events = [];
+  for await (const event of runWithModelInvocationContext(f.context, () =>
+    f.model.streamText({ messages: [{ role: "user", content: "hello" }] }),
+  ))
+    events.push(event);
+  assert.equal(events.find((e) => e.type === "tool_input_start")?.id, "call_one");
+  assert.equal(
+    events.find((e) => e.type === "reasoning_end")?.providerMetadata?.pi?.signature,
+    "opaque-signature",
+  );
+  assert.equal(events.at(-1)?.type, "finish");
+  assert.equal(f.released, 1);
+});
+test("missing runtime credentials and unsupported media fail before transport", async () => {
+  const f = fixture();
+  await assert.rejects(
+    f.model.generateText({ messages: [{ role: "user", content: "hi" }] }),
+    /Sign in/,
+  );
+  assert.equal(f.captured, undefined);
+  await assert.rejects(
+    runWithModelInvocationContext(f.context, () =>
+      f.model.generateText({
+        messages: [
+          {
+            role: "user",
+            content: [
+              {
+                type: "file",
+                mediaType: "application/pdf",
+                dataUrl: "data:application/pdf;base64,AA==",
+              },
+            ],
+          },
+        ],
+      }),
+    ),
+    /PDF|pdf/,
+  );
+});
+test("consumer cancellation aborts transport and releases admission", async () => {
+  const f = fixture();
+  for await (const event of runWithModelInvocationContext(f.context, () =>
+    f.model.streamText({ messages: [{ role: "user", content: "hi" }] }),
+  )) {
+    assert.equal(event.type, "start");
+    break;
+  }
+  assert.equal(f.captured.options.signal.aborted, true);
+  assert.equal(f.released, 1);
+});
+
+test("real Pi Codex transport encodes the selected route, tools, effort and cached usage", async () => {
+  const { zstdDecompressSync } = await import("node:zlib");
+  const token =
+    "synthetic." +
+    Buffer.from(
+      JSON.stringify({ "https://api.openai.com/auth": { chatgpt_account_id: "fixture-account" } }),
+    ).toString("base64url") +
+    ".signature";
+  let calls = 0;
+  const transport: typeof fetch = async (input, init) => {
+    calls++;
+    assert.equal(String(input), "https://chatgpt.com/backend-api/codex/responses");
+    const headers = new Headers(init?.headers);
+    assert.equal(headers.get("authorization"), `Bearer ${token}`);
+    assert.equal(headers.get("chatgpt-account-id"), "fixture-account");
+    const body = JSON.parse(
+      typeof init?.body === "string"
+        ? init.body
+        : Buffer.from(zstdDecompressSync(init?.body as Uint8Array)).toString("utf8"),
+    );
+    assert.equal(body.model, native.id);
+    assert.equal(body.reasoning.effort, "high");
+    assert.equal(body.store, false);
+    assert.equal(body.tools[0].name, "read_file");
+    assert.equal(body.instructions, "Keep the stable instruction");
+    const events = [
+      {
+        type: "response.output_item.added",
+        item: {
+          type: "message",
+          id: "msg_fixture",
+          role: "assistant",
+          status: "in_progress",
+          content: [],
+        },
+      },
+      { type: "response.content_part.added", part: { type: "output_text", text: "" } },
+      { type: "response.output_text.delta", delta: "Hello" },
+      {
+        type: "response.output_item.done",
+        item: {
+          type: "message",
+          id: "msg_fixture",
+          role: "assistant",
+          status: "completed",
+          content: [{ type: "output_text", text: "Hello" }],
+        },
+      },
+      {
+        type: "response.completed",
+        response: {
+          status: "completed",
+          usage: {
+            input_tokens: 100,
+            output_tokens: 3,
+            total_tokens: 103,
+            input_tokens_details: { cached_tokens: 90 },
+          },
+        },
+      },
+    ];
+    return new Response(events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""), {
+      headers: { "content-type": "text/event-stream" },
+    });
+  };
+  const model = createPiSubscriptionModel(binding, transport);
+  const result = await runWithModelInvocationContext(
+    {
+      async refreshRuntimeHeadersBeforeAttempt() {
+        return { headersApplied: true, requestAuth: { apiKey: token } };
+      },
+    },
+    () =>
+      model.generateText({
+        messages: [
+          { role: "system", content: "Keep the stable instruction" },
+          { role: "user", content: "Read hello" },
+        ],
+        tools: [
+          {
+            name: "read_file",
+            description: "Read one file",
+            inputSchema: {
+              type: "object",
+              properties: { path: { type: "string" } },
+              required: ["path"],
+            },
+          },
+        ],
+      }),
+  );
+  assert.equal(calls, 1);
+  assert.equal(result.text, "Hello");
+  assert.equal(result.usage.inputTokens, 100);
+  assert.equal(result.usage.cacheReadTokens, 90);
+  assert.equal(result.usage.totalTokens, 103);
+});
