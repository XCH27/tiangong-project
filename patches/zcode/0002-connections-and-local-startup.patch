index 0000000..f0531a5
--- /dev/null
+++ b/packages/services/test/fleet-local-startup.test.ts
@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { EventEmitter } from "node:events";
+import { PassThrough } from "node:stream";
+import type { ChildProcess } from "node:child_process";
+import { mkdtemp, readdir, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DEFAULT_ZCODE_ENDPOINT_ORIGIN, type TelemetryRendererContext } from "@zcode/shared";
+import { NodeApiClient } from "../src/providers/api/nodeApiClient.js";
+import { createTelemetryCore } from "../src/telemetry/telemetryCore.js";
+import { createClientScenesService } from "../src/client-scenes/clientScenesService.js";
+import { createGitHubAccountOperations } from "../src/git/githubAccount.js";
+import { createDesktopHelpConfigReader } from "../../desktop/src/main/desktopHelpConfig.js";
+
+test("retired default and overridden product endpoints fail before transport", async () => {
+  const seen: string[] = [];
+  const client = new NodeApiClient({
+    resolveZCodeEndpointOrigin: () => "https://retired.example",
+    fetchImpl: async (input) => {
+      seen.push(String(input));
+      return new Response("ok");
+    },
+  });
+  for (const origin of [DEFAULT_ZCODE_ENDPOINT_ORIGIN, "https://retired.example"]) {
+    await assert.rejects(
+      client.request(`${origin}/api/v1/client/configs`),
+      /not available in Fleet/,
+    );
+  }
+  assert.deepEqual(seen, []);
+  await client.request("https://vendor.example/v1/models");
+  assert.deepEqual(seen, ["https://vendor.example/v1/models"]);
+});
+
+test("disabled telemetry does not read identity, collect identifiers, write state or send", async () => {
+  const home = await mkdtemp(join(tmpdir(), "fleet-no-telemetry-"));
+  let calls = 0;
+  const core = createTelemetryCore({
+    homeDir: home,
+    loadUserId: async () => {
+      calls++;
+      return "fixture";
+    },
+    loadAuthorization: async () => {
+      calls++;
+      return "secret";
+    },
+    loadMarketingParams: async () => {
+      calls++;
+      return null;
+    },
+    randomUUID: () => {
+      calls++;
+      return "fixture-device";
+    },
+    fetchImpl: async () => {
+      calls++;
+      return new Response("ok");
+    },
+  });
+  try {
+    const context = { clientTimezone: "UTC" } as TelemetryRendererContext;
+    await Promise.all([
+      core.reportAppLaunch(context),
+      core.reportAppDailyActive(context),
+      core.reportEvent({
+        context,
+        elementName: "session_create",
+        eventRegion: "app",
+        eventType: "click",
+        eventExtraDetail: {},
+      }),
+    ]);
+    await core.flushPendingReports({ timeoutMs: 100 });
+    assert.equal(calls, 0);
+    assert.deepEqual(await readdir(home), []);
+    assert.deepEqual(await createDesktopHelpConfigReader()(), {});
+    const scenes = createClientScenesService({
+      apiClient: {
+        request: async () => {
+          throw new Error("No hosted template requests");
+        },
+      },
+    });
+    assert.deepEqual((await scenes.list()).data, []);
+  } finally {
+    await rm(home, { recursive: true, force: true });
+  }
+});
+
+function fakeChild() {
+  const child = Object.assign(new EventEmitter(), {
+    stdout: new PassThrough(),
+    stderr: new PassThrough(),
+    stdin: new PassThrough(),
+    killed: false,
+    kill() {
+      this.killed = true;
+      return true;
+    },
+  });
+  return child;
+}
+
+test("GitHub status returns only account identity and active state", async () => {
+  const ops = createGitHubAccountOperations({
+    run: async (args) => {
+      assert.deepEqual(args, ["auth", "status", "--hostname", "github.com", "--json", "hosts"]);
+      return JSON.stringify({
+        hosts: {
+          "github.com": [
+            { login: "fixture", active: true, token: "must-not-leak" },
+            { login: null },
+          ],
+        },
+      });
+    },
+  });
+  assert.deepEqual(await ops.githubAccountStatus(), {
+    installed: true,
+    accounts: [{ login: "fixture", active: true }],
+  });
+});
+
+test("missing GitHub CLI is a distinct unavailable state", async () => {
+  const ops = createGitHubAccountOperations({
+    run: async () => {
+      throw new Error("GITHUB_CLI_MISSING");
+    },
+  });
+  assert.deepEqual(await ops.githubAccountStatus(), { installed: false, accounts: [] });
+});
+
+test("GitHub login is single-flight, exposes the code, and cancellation wins late events", async () => {
+  const child = fakeChild();
+  let starts = 0;
+  const listeners = process.listenerCount("exit");
+  const ops = createGitHubAccountOperations({
+    start: () => {
+      starts++;
+      return child as unknown as ChildProcess;
+    },
+  });
+  const first = await ops.githubBeginLogin();
+  assert.equal((await ops.githubBeginLogin()).id, first.id);
+  assert.equal(starts, 1);
+  child.stderr.write("First copy your one-time code: ABCD-1234\n");
+  assert.equal((await ops.githubLoginState(first.id)).code, "ABCD-1234");
+  await ops.githubCancelLogin(first.id);
+  assert.equal(child.killed, true);
+  child.emit("error", new Error("late event"));
+  child.emit("close", 0);
+  assert.equal((await ops.githubLoginState(first.id)).state, "cancelled");
+  assert.equal(process.listenerCount("exit"), listeners);
+});
+
+test("GitHub login completion/failure is driven by the child process", async () => {
+  for (const code of [0, 1]) {
+    const child = fakeChild();
+    const ops = createGitHubAccountOperations({ start: () => child as unknown as ChildProcess });
+    const first = await ops.githubBeginLogin();
+    child.emit("close", code);
+    assert.equal((await ops.githubLoginState(first.id)).state, code === 0 ? "complete" : "failed");
+    await assert.rejects(ops.githubLoginState("stale"), /expired/);
+  }
+});
+
+test("account mutations validate the login and use a single explicit account argument", async () => {
+  const calls: string[][] = [];
+  const ops = createGitHubAccountOperations({
+    run: async (args) => {
+      calls.push(args);
+      return '{"hosts":{}}';
+    },
+  });
+  await assert.rejects(ops.githubSwitchAccount("--help"), /Invalid/);
+  await assert.rejects(ops.githubLogout("user; command"), /Invalid/);
+  assert.deepEqual(calls, []);
+  await ops.githubSwitchAccount("fixture");
+  await ops.githubLogout("fixture");
+  assert.deepEqual(
+    calls.filter((args) => args[1] !== "status"),
+    [
+      ["auth", "switch", "--hostname", "github.com", "--user", "fixture"],
+      ["auth", "logout", "--hostname", "github.com", "--user", "fixture"],
+    ],
+  );
+});
diff --git a/packages/services/test/subscription-connections.test.ts b/packages/services/test/subscription-connections.test.ts
new file mode 100644
index 0000000..640493c
--- /dev/null
+++ b/packages/services/test/subscription-connections.test.ts
@@ -0,0 +1,240 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { Provider, OAuthCredential } from "@earendil-works/pi-ai";
+import { createSubscriptionConnections } from "../src/model-provider/subscriptionConnections.js";
+import { discoverConnectionModels } from "../src/model-provider/modelDiscovery.js";
+
+const token = (account: string, expires = 100000) => ({
+  type: "oauth" as const,
+  access: account,
+  refresh: `${account}-refresh`,
+  expires,
+});
+function fixture(shared?: ReturnType<typeof fixture>) {
+  const credentials = shared?.credentials ?? new Map<string, string>();
+  const states =
+    shared?.states ??
+    new Map([
+      ["one", { type: "subscription", provider: "openai-codex", connected: false }],
+      ["two", { type: "subscription", provider: "openai-codex", connected: false }],
+    ]);
+  const pending: Array<ReturnType<typeof Promise.withResolvers<OAuthCredential>>> = [];
+  let refreshCount = 0;
+  let refresh = async (saved: OAuthCredential) => ({
+    ...saved,
+    access: saved.access + "-renewed",
+    expires: 100000,
+  });
+  const provider = {
+    auth: {
+      oauth: {
+        async login(interaction: any) {
+          const p = Promise.withResolvers<OAuthCredential>();
+          pending.push(p);
+          interaction.notify({
+            type: "device_code",
+            userCode: "ABCD",
+            verificationUri: "https://auth.example/device",
+          });
+          return p.promise;
+        },
+        async refresh(saved: OAuthCredential) {
+          refreshCount++;
+          return refresh(saved);
+        },
+        async toAuth(saved: OAuthCredential) {
+          return { apiKey: saved.access, baseUrl: "https://account.example" };
+        },
+      },
+    },
+    getModels: () => [],
+  } as unknown as Provider;
+  const queues = shared?.queues ?? new Map<string, Promise<unknown>>();
+  const owner = createSubscriptionConnections({
+    now: () => 100,
+    async withConnectionLock(id, operation) {
+      const p = (queues.get(id) ?? Promise.resolve()).catch(() => {}).then(operation);
+      queues.set(id, p);
+      try {
+        return await p;
+      } finally {
+        if (queues.get(id) === p) queues.delete(id);
+      }
+    },
+    providers: { "openai-codex": provider, "github-copilot": provider },
+    credentials: {
+      async load(k) {
+        return credentials.get(k) ?? null;
+      },
+      async save(k, v) {
+        credentials.set(k, v);
+      },
+      async delete(k) {
+        credentials.delete(k);
+      },
+    },
+    async getView() {
+      return {
+        providers: [...states].map(([providerId, access]) => ({
+          providerId,
+          effectiveConfig: { access },
+        })),
+      } as any;
+    },
+    async setConnected(id, connected) {
+      states.get(id)!.connected = connected;
+    },
+  });
+  return {
+    owner,
+    credentials,
+    pending,
+    states,
+    queues,
+    setRefresh(fn: typeof refresh) {
+      refresh = fn;
+    },
+    get refreshCount() {
+      return refreshCount;
+    },
+  };
+}
+test("two instances of one subscription retain separate tokens and endpoints", async () => {
+  const f = fixture();
+  const a = await f.owner.begin("one");
+  const b = await f.owner.begin("two");
+  f.pending[0]!.resolve(token("alice"));
+  f.pending[1]!.resolve(token("bob"));
+  await Promise.all([f.owner.finish("one", a.flowId), f.owner.finish("two", b.flowId)]);
+  assert.equal((await f.owner.resolve("one")).apiKey, "alice");
+  assert.equal((await f.owner.resolve("two")).apiKey, "bob");
+  assert.equal((await f.owner.resolve("one")).baseUrl, "https://account.example");
+  await f.owner.disconnect("one");
+  await assert.rejects(f.owner.resolve("one"), /Sign in/);
+  assert.equal((await f.owner.resolve("two")).apiKey, "bob");
+});
+test("disconnect prevents a late authorization response restoring credentials", async () => {
+  const f = fixture();
+  const flow = await f.owner.begin("one");
+  const finish = f.owner.finish("one", flow.flowId);
+  await f.owner.disconnect("one");
+  f.pending[0]!.resolve(token("late"));
+  await assert.rejects(finish, /cancelled/);
+  assert.equal(f.credentials.size, 0);
+  assert.equal(f.states.get("one")!.connected, false);
+});
+test("parallel requests coalesce refresh; disconnect wins over refresh completion", async () => {
+  const f = fixture();
+  f.credentials.set(
+    "model-subscription:one",
+    JSON.stringify({ kind: "openai-codex", credential: token("old", 0) }),
+  );
+  const pending = Promise.withResolvers<OAuthCredential>();
+  f.setRefresh(() => pending.promise);
+  const a = f.owner.resolve("one");
+  const b = f.owner.resolve("one");
+  await new Promise((r) => setImmediate(r));
+  assert.equal(f.refreshCount, 1);
+  const disconnected = f.owner.disconnect("one");
+  pending.resolve(token("renewed"));
+  await assert.rejects(a, /cancelled/);
+  await assert.rejects(b, /cancelled/);
+  await disconnected;
+  assert.equal(f.credentials.size, 0);
+});
+test("restarting login invalidates the old flow without cancelling the new owner", async () => {
+  const f = fixture();
+  const a = await f.owner.begin("one");
+  const old = f.owner.finish("one", a.flowId);
+  const b = await f.owner.begin("one");
+  await f.owner.cancel("one", a.flowId);
+  f.pending[0]!.resolve(token("stale"));
+  f.pending[1]!.resolve(token("new"));
+  await assert.rejects(old, /cancelled/);
+  await f.owner.finish("one", b.flowId);
+  assert.equal((await f.owner.resolve("one")).apiKey, "new");
+});
+test("model discovery uses selected endpoint/auth, pagination and no inferred capabilities", async () => {
+  const captured: Request[] = [];
+  const provider = {
+    providerId: "custom",
+    effectiveConfig: {
+      api: { type: "anthropic-messages", baseUrl: "https://provider.example/v1" },
+      access: { type: "api-key", apiKey: "synthetic" },
+    },
+  } as any;
+  const result = await discoverConnectionModels(provider, async (input, init) => {
+    const r = new Request(input, init);
+    captured.push(r);
+    return Response.json(
+      captured.length === 1
+        ? {
+            data: [{ id: "model/one", display_name: "Official One" }],
+            has_more: true,
+            last_id: "model/one",
+          }
+        : { data: [{ id: "model/two" }] },
+    );
+  });
+  assert.equal(captured[0]!.url, "https://provider.example/v1/models");
+  assert.equal(captured[0]!.headers.get("x-api-key"), "synthetic");
+  assert.equal(captured[0]!.redirect, "error");
+  assert.equal(new URL(captured[1]!.url).searchParams.get("after_id"), "model/one");
+  assert.equal(result.models[0]!.name, "Official One");
+  assert.deepEqual(result.models[0]!.config, {});
+});
+test("unsupported list API never silently falls back to invented models", async () => {
+  const provider = {
+    effectiveConfig: {
+      api: { type: "openai-responses", baseUrl: "https://provider.example/v1" },
+      access: { type: "api-key", apiKey: "synthetic" },
+    },
+  } as any;
+  await assert.rejects(
+    discoverConnectionModels(provider, async () => new Response("", { status: 404 })),
+    /404/,
+  );
+  await assert.rejects(
+    discoverConnectionModels(provider, async () =>
+      Response.json({ models: [{ id: "not-openai-shape" }] }),
+    ),
+    /unsupported/,
+  );
+});
+
+test("separate Host owners serialize refresh and cannot restore a disconnected login", async () => {
+  const a = fixture();
+  const b = fixture(a);
+  a.credentials.set(
+    "model-subscription:one",
+    JSON.stringify({ kind: "openai-codex", credential: token("old", 0) }),
+  );
+  const [first, second] = await Promise.all([a.owner.resolve("one"), b.owner.resolve("one")]);
+  assert.equal(a.refreshCount + b.refreshCount, 1);
+  assert.equal(first.apiKey, second.apiKey);
+  const flow = await a.owner.begin("one");
+  const finish = a.owner.finish("one", flow.flowId);
+  await b.owner.disconnect("one");
+  a.pending[0]!.resolve(token("late"));
+  await assert.rejects(finish, /cancelled/);
+  assert.equal(a.credentials.size, 0);
+});
+test("runtime auth rejects a provider-kind mismatch", async () => {
+  const f = fixture();
+  await assert.rejects(f.owner.resolve("one", "github-copilot"), /changed/);
+});
+test("DeepSeek Anthropic discovery uses the documented shared bearer catalog", async () => {
+  const provider = {
+    effectiveConfig: {
+      api: { type: "anthropic-messages", baseUrl: "https://api.deepseek.com/anthropic" },
+      access: { type: "api-key", apiKey: "synthetic" },
+    },
+  } as any;
+  await discoverConnectionModels(provider, async (input, init) => {
+    const r = new Request(input, init);
+    assert.equal(r.url, "https://api.deepseek.com/models");
+    assert.equal(r.headers.get("Authorization"), "Bearer synthetic");
+    assert.equal(r.headers.has("x-api-key"), false);
+    return Response.json({ data: [{ id: "exact-provider-id" }] });
+  });
+});
