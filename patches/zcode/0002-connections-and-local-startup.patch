diff --git a/packages/ui/src/settings/model-provider-section/SubscriptionConnectionSection.tsx b/packages/ui/src/settings/model-provider-section/SubscriptionConnectionSection.tsx
new file mode 100644
index 0000000..17f10b2
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/SubscriptionConnectionSection.tsx
@@ -0,0 +1,129 @@
+import { useEffect, useRef, useState } from "react";
+import { ExternalLinkIcon, LoaderCircleIcon, LogOutIcon } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { useServices } from "@/hooks/useServices.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { reloadProviderSettingsSnapshot } from "@/lib/providerSettingsSnapshot.js";
+import { useProviderDetailFeedback } from "./ProviderDetailFeedback.js";
+
+// Cindy's provider-scoped device flow: leaving this connection cancels only its own attempt.
+export function SubscriptionConnectionSection({
+  providerId,
+  connected,
+}: {
+  providerId: string;
+  connected: boolean;
+}) {
+  const { providerSettingsService } = useServices();
+  const platform = usePlatform();
+  const { intl } = useZCodeIntl();
+  const { showFeedback } = useProviderDetailFeedback();
+  const [busy, setBusy] = useState(false);
+  const [flow, setFlow] = useState<{ flowId: string; verificationUrl: string; userCode: string }>();
+  const attempt = useRef(0);
+  const activeFlow = useRef<string | undefined>(undefined);
+  useEffect(
+    () => () => {
+      attempt.current += 1;
+      if (activeFlow.current)
+        void providerSettingsService
+          .cancelSubscriptionLogin(providerId, activeFlow.current)
+          .catch(() => {});
+    },
+    [providerId, providerSettingsService],
+  );
+  const cancel = async () => {
+    attempt.current += 1;
+    const flowId = activeFlow.current;
+    activeFlow.current = undefined;
+    setFlow(undefined);
+    setBusy(false);
+    if (flowId) await providerSettingsService.cancelSubscriptionLogin(providerId, flowId);
+  };
+  const run = async (disconnect: boolean) => {
+    const version = ++attempt.current;
+    setBusy(true);
+    try {
+      if (disconnect) await providerSettingsService.disconnectSubscription(providerId);
+      else {
+        const next = await providerSettingsService.beginSubscriptionLogin(providerId);
+        if (attempt.current !== version) {
+          await providerSettingsService.cancelSubscriptionLogin(providerId, next.flowId);
+          return;
+        }
+        activeFlow.current = next.flowId;
+        setFlow(next);
+        await providerSettingsService.finishSubscriptionLogin(providerId, next.flowId);
+      }
+      if (attempt.current !== version) return;
+      await reloadProviderSettingsSnapshot();
+    } catch (error) {
+      if (attempt.current === version)
+        showFeedback({
+          key: `subscription:${providerId}`,
+          state: "failure",
+          message:
+            error instanceof Error
+              ? error.message
+              : intl.formatMessage({ id: "settings.modelProvider.subscription.failed" }),
+          dismissible: true,
+        });
+    } finally {
+      if (attempt.current === version) {
+        activeFlow.current = undefined;
+        setFlow(undefined);
+        setBusy(false);
+      }
+    }
+  };
+  return (
+    <section className="space-y-3" data-testid="subscription-connection">
+      <div className="text-ui-base text-foreground-subtle">
+        {intl.formatMessage({
+          id: connected
+            ? "settings.modelProvider.subscription.connected"
+            : "settings.modelProvider.subscription.description",
+        })}
+      </div>
+      {flow ? (
+        <div className="space-y-3 rounded-lg border border-border bg-surface p-4" role="status">
+          <p className="text-ui-base">
+            {intl.formatMessage({ id: "settings.modelProvider.subscription.enterCode" })}
+          </p>
+          <code className="block select-all text-ui-lg font-semibold tracking-widest">
+            {flow.userCode}
+          </code>
+          <Button
+            variant="outline"
+            onClick={() => void platform.openExternal(flow.verificationUrl)}
+          >
+            <ExternalLinkIcon className="size-4" />
+            {intl.formatMessage({ id: "settings.modelProvider.subscription.open" })}
+          </Button>
+        </div>
+      ) : null}
+      <div className="flex items-center gap-2">
+        <Button variant="outline" disabled={busy} onClick={() => void run(connected)}>
+          {busy ? (
+            <LoaderCircleIcon className="size-4 animate-spin" />
+          ) : connected ? (
+            <LogOutIcon className="size-4" />
+          ) : (
+            <ExternalLinkIcon className="size-4" />
+          )}
+          {intl.formatMessage({
+            id: connected
+              ? "settings.modelProvider.subscription.disconnect"
+              : "settings.modelProvider.subscription.login",
+          })}
+        </Button>
+        {busy ? (
+          <Button variant="ghost" onClick={() => void cancel()}>
+            {intl.formatMessage({ id: "common.cancel" })}
+          </Button>
+        ) : null}
+      </div>
+    </section>
+  );
+}
