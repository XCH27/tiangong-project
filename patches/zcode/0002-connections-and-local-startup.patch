diff --git a/packages/services/src/git/githubAccount.ts b/packages/services/src/git/githubAccount.ts
new file mode 100644
index 0000000..d4993fc
--- /dev/null
+++ b/packages/services/src/git/githubAccount.ts
@@ -0,0 +1,148 @@
+import { execFile, spawn, type ChildProcess } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { promisify } from "node:util";
+
+export interface GitHubAccountStatus {
+  installed: boolean;
+  accounts: Array<{ login: string; active: boolean }>;
+}
+export interface GitHubLoginState {
+  id: string;
+  state: "pending" | "complete" | "failed" | "cancelled";
+  code?: string;
+  verificationUrl: string;
+}
+export interface GitHubAccountOperations {
+  githubAccountStatus(): Promise<GitHubAccountStatus>;
+  githubBeginLogin(): Promise<GitHubLoginState>;
+  githubLoginState(id: string): Promise<GitHubLoginState>;
+  githubCancelLogin(id: string): Promise<void>;
+  githubSwitchAccount(login: string): Promise<GitHubAccountStatus>;
+  githubLogout(login: string): Promise<GitHubAccountStatus>;
+}
+
+const exec = promisify(execFile);
+// 凭据留在 gh/系统钥匙串；Host 只向界面返回账号名、验证码和流程状态。
+export function createGitHubAccountOperations(
+  deps: {
+    run?: (args: string[]) => Promise<string>;
+    start?: () => ChildProcess;
+  } = {},
+): GitHubAccountOperations {
+  const run =
+    deps.run ??
+    (async (args) => {
+      try {
+        return (
+          await exec("gh", args, {
+            encoding: "utf8",
+            timeout: 20_000,
+            windowsHide: true,
+            maxBuffer: 256_000,
+          })
+        ).stdout;
+      } catch (error) {
+        const failure = error as NodeJS.ErrnoException & { stdout?: string };
+        if (args[1] === "status" && failure.stdout?.trim().startsWith("{")) return failure.stdout;
+        if (failure.code === "ENOENT") throw new Error("GITHUB_CLI_MISSING");
+        throw new Error("GITHUB_CLI_AUTH_FAILED");
+      }
+    });
+  let flow:
+    | { public: GitHubLoginState; child: ChildProcess; timeout: ReturnType<typeof setTimeout> }
+    | undefined;
+  async function status(): Promise<GitHubAccountStatus> {
+    try {
+      const raw = JSON.parse(
+        await run(["auth", "status", "--hostname", "github.com", "--json", "hosts"]),
+      ) as { hosts?: Record<string, Array<{ login?: unknown; active?: unknown }>> };
+      return {
+        installed: true,
+        accounts: (raw.hosts?.["github.com"] ?? []).flatMap((account) =>
+          typeof account.login === "string"
+            ? [{ login: account.login, active: account.active === true }]
+            : [],
+        ),
+      };
+    } catch (error) {
+      if (error instanceof Error && error.message === "GITHUB_CLI_MISSING")
+        return { installed: false, accounts: [] };
+      throw error;
+    }
+  }
+  function cancel(id: string) {
+    if (flow?.public.id !== id || flow.public.state !== "pending") return;
+    flow.public.state = "cancelled";
+    clearTimeout(flow.timeout);
+    flow.child.kill();
+  }
+  function loginArgument(login: string) {
+    if (!/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/.test(login)) throw new Error("Invalid GitHub login");
+    return login;
+  }
+  return {
+    githubAccountStatus: status,
+    async githubBeginLogin() {
+      if (flow?.public.state === "pending") return { ...flow.public };
+      const child =
+        deps.start?.() ??
+        spawn(
+          "gh",
+          ["auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"],
+          { stdio: ["pipe", "pipe", "pipe"], windowsHide: true },
+        );
+      const state: GitHubLoginState = {
+        id: randomUUID(),
+        state: "pending",
+        verificationUrl: "https://github.com/login/device",
+      };
+      const timeout = setTimeout(() => cancel(state.id), 15 * 60_000);
+      timeout.unref();
+      flow = { public: state, child, timeout };
+      let output = "";
+      const onHostExit = () => cancel(state.id);
+      process.once("exit", onHostExit);
+      const finish = () => {
+        clearTimeout(timeout);
+        process.removeListener("exit", onHostExit);
+        output = "";
+      };
+      const receive = (chunk: Buffer) => {
+        if (state.state !== "pending") return;
+        output = (output + chunk.toString("utf8")).slice(-8192);
+        const match = output.match(/\b[A-Z0-9]{4}-[A-Z0-9]{4}\b/);
+        if (match) state.code = match[0];
+      };
+      child.stdout?.on("data", receive);
+      child.stderr?.on("data", receive);
+      child.on("error", () => {
+        // 取消后的迟到事件不能把已取消的流程重新改为失败。
+        if (state.state === "pending") state.state = "failed";
+        finish();
+      });
+      child.on("close", (code) => {
+        if (state.state === "pending") state.state = code === 0 ? "complete" : "failed";
+        finish();
+      });
+      // gh 的 web flow 会等一次回车后打开系统浏览器；只在用户点击登录后启动。
+      child.stdin?.on("error", () => {});
+      child.stdin?.end("\n");
+      return { ...state };
+    },
+    async githubLoginState(id) {
+      if (flow?.public.id !== id) throw new Error("GitHub login expired");
+      return { ...flow.public };
+    },
+    async githubCancelLogin(id) {
+      cancel(id);
+    },
+    async githubSwitchAccount(login) {
+      await run(["auth", "switch", "--hostname", "github.com", "--user", loginArgument(login)]);
+      return status();
+    },
+    async githubLogout(login) {
+      await run(["auth", "logout", "--hostname", "github.com", "--user", loginArgument(login)]);
+      return status();
+    },
+  };
+}
