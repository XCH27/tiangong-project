diff --git a/scripts/sync-fleet-provider-catalog.mjs b/scripts/sync-fleet-provider-catalog.mjs
new file mode 100644
index 0000000..db45c87
--- /dev/null
+++ b/scripts/sync-fleet-provider-catalog.mjs
@@ -0,0 +1,102 @@
+// Endpoints come from the pinned Pi catalog; this updates ZCode's existing template owner.
+import { readFile, writeFile } from "node:fs/promises";
+import { builtinProviders } from "@earendil-works/pi-ai/providers/all";
+const file = new URL("../config/provider/zcode-builtin.json", import.meta.url);
+const data = JSON.parse(await readFile(file, "utf8"));
+data.config.providerConfigRules.templateRules =
+  data.config.providerConfigRules.templateRules.filter((t) => t.templateId !== "fleet-minimax-cn");
+const providers = new Map(builtinProviders().map((p) => [p.id, p]));
+const entries = [
+  ["openai-codex", "ChatGPT / Codex", "https://chatgpt.com", "openai"],
+  ["github-copilot", "GitHub Copilot", "https://github.com/settings/copilot", "github"],
+  ["groq", "Groq", "https://console.groq.com/keys", "groq"],
+  ["cerebras", "Cerebras", "https://cloud.cerebras.ai", "cerebras"],
+  ["mistral", "Mistral", "https://console.mistral.ai", "mistral"],
+  ["nvidia", "NVIDIA", "https://build.nvidia.com", "nvidia"],
+  ["together", "Together AI", "https://api.together.ai/settings/api-keys", "together"],
+  ["kimi-coding", "Kimi Code", "https://www.kimi.com/code/console", "moonshot-kimi"],
+  ["minimax", "MiniMax 国际", "https://platform.minimax.io", "minimax"],
+  [
+    "qwen-token-plan-cn",
+    "Qwen Token Plan 中国",
+    "https://bailian.console.aliyun.com",
+    "alibaba-model-studio",
+  ],
+  [
+    "qwen-token-plan",
+    "Qwen Token Plan 国际",
+    "https://bailian.console.alibabacloud.com",
+    "alibaba-model-studio",
+  ],
+  [
+    "xiaomi-token-plan-cn",
+    "MiMo Token Plan 中国",
+    "https://platform.xiaomimimo.com",
+    "xiaomi-mimo",
+  ],
+];
+for (const [id, name, keyUrl, logo] of entries) {
+  const provider = providers.get(id);
+  if (!provider?.baseUrl) throw new Error(`Missing Pi provider ${id}`);
+  const subscription = id === "openai-codex" || id === "github-copilot";
+  const api = provider.getModels()[0]?.api;
+  const apiType =
+    api === "anthropic-messages"
+      ? "anthropic-messages"
+      : api === "openai-codex-responses"
+        ? "openai-responses"
+        : "openai-chat-completions";
+  const template = {
+    templateId: `fleet-${id}`,
+    templateNameMap: { "zh-CN": name, "en-US": name },
+    config: {
+      access: subscription
+        ? { type: "subscription", provider: id, connected: false }
+        : { type: "api-key", apiKeyManagementUrl: keyUrl },
+      api: {
+        type: apiType,
+        baseUrl: id === "mistral" ? "https://api.mistral.ai/v1" : provider.baseUrl,
+      },
+      builtinModelIds: [],
+      logo: { type: "builtin", key: logo },
+    },
+  };
+  const rules = data.config.providerConfigRules.templateRules;
+  const index = rules.findIndex((t) => t.templateId === template.templateId);
+  if (index < 0) rules.push(template);
+  else rules[index] = template;
+}
+// Google exposes an officially documented OpenAI-compatible endpoint as well as its native API.
+const google = {
+  templateId: "fleet-google",
+  templateNameMap: { "zh-CN": "Google Gemini", "en-US": "Google Gemini" },
+  config: {
+    access: { type: "api-key", apiKeyManagementUrl: "https://aistudio.google.com/apikey" },
+    api: {
+      type: "openai-chat-completions",
+      baseUrl: "https://generativelanguage.googleapis.com/v1beta/openai",
+    },
+    builtinModelIds: [],
+    logo: { type: "builtin", key: "google" },
+  },
+};
+const silicon = {
+  templateId: "fleet-siliconflow",
+  templateNameMap: { "zh-CN": "硅基流动", "en-US": "SiliconFlow" },
+  config: {
+    access: { type: "api-key", apiKeyManagementUrl: "https://cloud.siliconflow.cn/account/ak" },
+    api: { type: "openai-chat-completions", baseUrl: "https://api.siliconflow.cn/v1" },
+    builtinModelIds: [],
+    logo: { type: "builtin", key: "siliconflow" },
+  },
+};
+for (const t of [google, silicon]) {
+  const r = data.config.providerConfigRules.templateRules;
+  const i = r.findIndex((p) => p.templateId === t.templateId);
+  if (i < 0) r.push(t);
+  else r[i] = t;
+}
+await writeFile(file, JSON.stringify(data, null, 2) + "\n");
+console.log(
+  `Updated ${entries.length + 2} Fleet templates; ${data.config.providerConfigRules.templateRules.length} total.`,
+);
