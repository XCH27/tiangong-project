new file mode 100644
index 0000000..d445d6e
--- /dev/null
+++ b/packages/services/src/model-provider/modelDiscovery.ts
@@ -0,0 +1,85 @@
+import type { ProviderSettingsProviderView, ModelConfigObject } from "@zcode/provider";
+import type { SubscriptionConnectionOwner } from "./subscriptionConnections.js";
+
+export interface DiscoveredModel {
+  id: string;
+  name: string;
+  config: ModelConfigObject;
+}
+export interface ModelDiscoveryResult {
+  source: "provider" | "catalog";
+  models: DiscoveredModel[];
+}
+
+export async function discoverConnectionModels(
+  provider: ProviderSettingsProviderView,
+  fetch: typeof globalThis.fetch,
+  subscriptions?: SubscriptionConnectionOwner,
+): Promise<ModelDiscoveryResult> {
+  const config = provider.effectiveConfig;
+  if (config.access?.type === "subscription") {
+    if (!subscriptions) throw new Error("Subscription catalog is unavailable on this host");
+    return subscriptions.models(provider.providerId);
+  }
+  if (config.access?.type !== "api-key" && config.access?.type !== "zhipu-coding-plan-api-key")
+    throw new Error("This connection does not expose an API model list");
+  if (!config.api?.baseUrl || !config.access.apiKey)
+    throw new Error("Enter an API address and API key first");
+  const base = new URL(config.api.baseUrl);
+  if (base.protocol !== "https:" && base.protocol !== "http:")
+    throw new Error("Invalid API address");
+  const headers = new Headers(config.api.headers ?? {});
+  headers.set("Accept", "application/json");
+  if (config.api.type === "anthropic-messages") {
+    headers.set("x-api-key", config.access.apiKey);
+    headers.set("anthropic-version", "2023-06-01");
+  } else headers.set("Authorization", `Bearer ${config.access.apiKey}`);
+  let path = base.pathname.replace(/\/+$/, "");
+  if (config.api.type === "anthropic-messages" && !path.endsWith("/v1")) path += "/v1";
+  // DeepSeek's Anthropic-compatible inference uses its normal OpenAI catalog and bearer key.
+  if (base.hostname === "api.deepseek.com" && base.pathname.replace(/\/+$/, "") === "/anthropic") {
+    path = "";
+    headers.delete("x-api-key");
+    headers.delete("anthropic-version");
+    headers.set("Authorization", `Bearer ${config.access.apiKey}`);
+  }
+  const url = new URL(`${base.origin}${path}/models`);
+  const models = new Map<string, DiscoveredModel>();
+  for (let page = 0; page < 20; page++) {
+    const response = await fetch(url, {
+      headers,
+      signal: AbortSignal.timeout(20_000),
+      redirect: "error",
+    });
+    if (!response.ok)
+      throw new Error(
+        `Model list request failed (${response.status}); you can still add a model manually`,
+      );
+    const body = (await response.json()) as {
+      data?: unknown;
+      has_more?: boolean;
+      last_id?: string;
+    };
+    if (!Array.isArray(body.data))
+      throw new Error("The provider returned an unsupported model list; add models manually");
+    for (const item of body.data) {
+      if (!item || typeof item !== "object" || typeof item.id !== "string" || !item.id.trim())
+        continue;
+      const name =
+        typeof item.name === "string"
+          ? item.name
+          : typeof item.display_name === "string"
+            ? item.display_name
+            : item.id;
+      // /models IDs prove availability only; they do not prove image, PDF or reasoning support.
+      models.set(item.id, { id: item.id, name, config: {} });
+    }
+    if (!body.has_more) return { source: "provider", models: [...models.values()] };
+    if (!body.last_id || url.searchParams.get("after_id") === body.last_id)
+      throw new Error("The provider returned an invalid pagination cursor");
+    url.searchParams.set("after_id", body.last_id);
+  }
+  throw new Error(
+    "The model list exceeds the supported page limit; add the required models manually",
+  );
+}
