new file mode 100644
index 0000000..d719373
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ModelDiscoverySection.tsx
@@ -0,0 +1,158 @@
+import { useRef, useEffect, useState } from "react";
+import { DownloadIcon, LoaderCircleIcon } from "lucide-react";
+import type { IProviderSettingsService } from "@zcode/services";
+import { Button } from "@/components/ui/button.js";
+import { Checkbox } from "@/components/ui/checkbox.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { reloadProviderSettingsSnapshot } from "@/lib/providerSettingsSnapshot.js";
+import { useProviderDetailFeedback } from "./ProviderDetailFeedback.js";
+
+type Catalog = Awaited<ReturnType<IProviderSettingsService["discoverModels"]>>;
+export function ModelDiscoverySection({
+  providerId,
+  existingIds,
+}: {
+  providerId: string;
+  existingIds: string[];
+}) {
+  const { providerSettingsService } = useServices();
+  const { intl } = useZCodeIntl();
+  const { showFeedback } = useProviderDetailFeedback();
+  const [catalog, setCatalog] = useState<Catalog>();
+  const [selected, setSelected] = useState<Set<string>>(new Set());
+  const [busy, setBusy] = useState(false);
+  const generation = useRef(0);
+  useEffect(
+    () => () => {
+      generation.current++;
+    },
+    [providerId],
+  );
+  const run = async (importing: boolean) => {
+    const version = ++generation.current;
+    setBusy(true);
+    try {
+      if (importing && catalog) {
+        for (const model of catalog.models) {
+          if (version !== generation.current) break;
+          if (selected.has(model.id) && !existingIds.includes(model.id))
+            await providerSettingsService.addPersonalModel(providerId, model.id, {
+              ...model.config,
+              enabled: true,
+            });
+        }
+        if (version === generation.current) {
+          setCatalog(undefined);
+          setSelected(new Set());
+        }
+      } else {
+        const result = await providerSettingsService.discoverModels(providerId);
+        if (version === generation.current) {
+          setCatalog(result);
+          setSelected(new Set());
+        }
+      }
+    } catch (error) {
+      if (version === generation.current)
+        showFeedback({
+          key: `models:${providerId}`,
+          state: "failure",
+          message: error instanceof Error ? error.message : String(error),
+          dismissible: true,
+        });
+    } finally {
+      if (importing) {
+        try {
+          await reloadProviderSettingsSnapshot();
+        } catch (error) {
+          if (version === generation.current)
+            showFeedback({
+              key: `models:${providerId}`,
+              state: "failure",
+              message: error instanceof Error ? error.message : String(error),
+              dismissible: true,
+            });
+        }
+      }
+      if (version === generation.current) setBusy(false);
+    }
+  };
+  return (
+    <section className="space-y-3" data-testid="model-discovery">
+      <Button variant="outline" disabled={busy} onClick={() => void run(false)}>
+        {busy ? (
+          <LoaderCircleIcon className="size-4 animate-spin" />
+        ) : (
+          <DownloadIcon className="size-4" />
+        )}
+        {intl.formatMessage({ id: "settings.modelProvider.discovery.fetch" })}
+      </Button>
+      {catalog ? (
+        <div className="space-y-3 rounded-lg border border-border p-3">
+          <p className="text-ui-caption text-foreground-subtle">
+            {intl.formatMessage({
+              id:
+                catalog.source === "catalog"
+                  ? "settings.modelProvider.discovery.catalog"
+                  : "settings.modelProvider.discovery.provider",
+            })}
+          </p>
+          <div className="max-h-72 overflow-y-auto">
+            {catalog.models.map((model) => {
+              const exists = existingIds.includes(model.id);
+              return (
+                <label
+                  key={model.id}
+                  className="flex cursor-pointer items-center gap-3 rounded-lg px-2 py-2 hover:bg-hover"
+                >
+                  <Checkbox
+                    checked={exists || selected.has(model.id)}
+                    disabled={exists || busy}
+                    onCheckedChange={(checked) =>
+                      setSelected((previous) => {
+                        const next = new Set(previous);
+                        if (checked === true) next.add(model.id);
+                        else next.delete(model.id);
+                        return next;
+                      })
+                    }
+                  />
+                  <span className="min-w-0 flex-1 break-all text-ui-base">
+                    {model.name}
+                    {model.name !== model.id ? (
+                      <span className="ml-2 text-ui-caption text-foreground-subtle">
+                        {model.id}
+                      </span>
+                    ) : null}
+                  </span>
+                  {exists ? (
+                    <span className="text-ui-caption text-foreground-subtle">
+                      {intl.formatMessage({ id: "settings.modelProvider.discovery.added" })}
+                    </span>
+                  ) : null}
+                </label>
+              );
+            })}
+            {!catalog.models.length ? (
+              <p className="text-ui-base text-foreground-subtle">
+                {intl.formatMessage({ id: "settings.modelProvider.discovery.empty" })}
+              </p>
+            ) : null}
+          </div>
+          <div className="flex justify-end gap-2">
+            <Button variant="ghost" disabled={busy} onClick={() => setCatalog(undefined)}>
+              {intl.formatMessage({ id: "common.cancel" })}
+            </Button>
+            <Button disabled={busy || selected.size === 0} onClick={() => void run(true)}>
+              {intl.formatMessage(
+                { id: "settings.modelProvider.discovery.import" },
+                { count: selected.size },
+              )}
+            </Button>
+          </div>
+        </div>
+      ) : null}
+    </section>
+  );
+}
