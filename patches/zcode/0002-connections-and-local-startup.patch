diff --git a/packages/services/src/model-provider/subscriptionConnections.ts b/packages/services/src/model-provider/subscriptionConnections.ts
new file mode 100644
index 0000000..ee6d2c5
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionConnections.ts
@@ -0,0 +1,268 @@
+import { randomUUID } from "node:crypto";
+import {
+  getSupportedThinkingLevels,
+  type OAuthCredential,
+  type Provider,
+  type ModelAuth,
+} from "@earendil-works/pi-ai";
+import { openaiCodexProvider } from "@earendil-works/pi-ai/providers/openai-codex";
+import { githubCopilotProvider } from "@earendil-works/pi-ai/providers/github-copilot";
+import type { ICredentialService } from "../credential/credential.js";
+import type { ProviderSettingsView } from "@zcode/provider";
+import type { ModelDiscoveryResult } from "./modelDiscovery.js";
+
+export interface SubscriptionLogin {
+  flowId: string;
+  verificationUrl: string;
+  userCode: string;
+}
+export interface SubscriptionRequestAuth {
+  apiKey: string;
+  headers: Record<string, string>;
+  baseUrl?: string;
+}
+export type SubscriptionKind = "openai-codex" | "github-copilot";
+export interface SubscriptionConnectionOwner {
+  models(providerId: string): Promise<ModelDiscoveryResult>;
+  begin(providerId: string): Promise<SubscriptionLogin>;
+  finish(providerId: string, flowId: string): Promise<void>;
+  disconnect(providerId: string): Promise<void>;
+  cancel(providerId: string, flowId: string): Promise<void>;
+  resolve(providerId: string, expectedKind?: SubscriptionKind): Promise<SubscriptionRequestAuth>;
+}
+interface Flow {
+  id: string;
+  controller: AbortController;
+  done: Promise<void>;
+}
+interface SavedConnection {
+  kind: SubscriptionKind;
+  credential?: OAuthCredential;
+  pendingFlowId?: string;
+}
+
+// Pi owns vendor protocols. The host binds credentials and authorization to a personal connection.
+export function createSubscriptionConnections(options: {
+  credentials: Pick<ICredentialService, "load" | "save" | "delete">;
+  getView(): Promise<ProviderSettingsView>;
+  setConnected(providerId: string, connected: boolean): Promise<void>;
+  withConnectionLock<T>(providerId: string, operation: () => Promise<T>): Promise<T>;
+  providers?: Record<SubscriptionKind, Provider>;
+  now?: () => number;
+}): SubscriptionConnectionOwner {
+  const now = options.now ?? Date.now;
+  const providers = options.providers ?? {
+    "openai-codex": openaiCodexProvider(),
+    "github-copilot": githubCopilotProvider(),
+  };
+  const flows = new Map<string, Flow>();
+  const generations = new Map<string, number>();
+  const refreshing = new Map<string, Promise<SubscriptionRequestAuth>>();
+  const key = (id: string) => `model-subscription:${id}`;
+  const generation = (id: string) => generations.get(id) ?? 0;
+  async function driver(id: string, expectedKind?: SubscriptionKind) {
+    const provider = (await options.getView()).providers.find((entry) => entry.providerId === id);
+    const access = provider?.effectiveConfig.access;
+    if (access?.type !== "subscription")
+      throw new Error("Subscription connection no longer exists");
+    if (expectedKind && access.provider !== expectedKind)
+      throw new Error("Subscription connection changed; select the model again");
+    const oauth = providers[access.provider].auth.oauth;
+    if (!oauth) throw new Error("Subscription authorization is unavailable");
+    return { oauth, kind: access.provider };
+  }
+  async function load(id: string, kind: SubscriptionKind): Promise<SavedConnection | undefined> {
+    const raw = await options.credentials.load(key(id));
+    if (!raw) return undefined;
+    const saved = JSON.parse(raw) as SavedConnection;
+    if (saved.kind !== kind) throw new Error("Subscription connection changed; sign in again");
+    if (
+      saved.credential &&
+      (saved.credential.type !== "oauth" ||
+        !saved.credential.access ||
+        !saved.credential.refresh ||
+        !Number.isFinite(saved.credential.expires))
+    )
+      throw new Error("Subscription credentials are invalid; sign in again");
+    return saved;
+  }
+  function invalidate(id: string) {
+    generations.set(id, generation(id) + 1);
+    flows.get(id)?.controller.abort();
+    flows.delete(id);
+    refreshing.delete(id);
+  }
+  return {
+    async models(id) {
+      const { kind } = await driver(id);
+      const provider = providers[kind];
+      const saved = await load(id, kind);
+      if (!saved?.credential) throw new Error("Connect this subscription first");
+      const models = provider.filterModels
+        ? provider.filterModels(provider.getModels(), saved.credential)
+        : provider.getModels();
+      return {
+        source: "catalog",
+        models: models.map((model) => ({
+          id: model.id,
+          name: model.name,
+          config: {
+            properties: {
+              contextWindow: model.contextWindow,
+              requiresMfjsToolSchema: false,
+              inputFormat: {
+                supportsText: true,
+                supportsImage: model.input.includes("image"),
+                supportsPdf: false,
+                supportsAudio: false,
+                supportsVideo: false,
+              },
+              outputFormat: { supportsText: true },
+              supportsToolCall: true,
+              supportsJsonSchemaOutput: false,
+              supportsNativeWebSearch: false,
+              supportsMidConversationSystem:
+                (model.compat && "supportsMidConvoSystemMessages" in model.compat
+                  ? model.compat.supportsMidConvoSystemMessages
+                  : false) ?? false,
+            },
+            optionSpecs: {
+              maxOutputTokens: { max: model.maxTokens, map: "{}" },
+              reasoningLevel: { values: getSupportedThinkingLevels(model), map: "{}" },
+            },
+          },
+        })),
+      };
+    },
+    async begin(id) {
+      const { oauth, kind } = await driver(id);
+      invalidate(id);
+      const version = generation(id);
+      const controller = new AbortController();
+      const flowId = randomUUID();
+      // 保存 flow identity；另一个窗口取消/删除/重新登录后，迟到的 OAuth 结果不能恢复账号。
+      await options.withConnectionLock(id, async () => {
+        const previous = await load(id, kind);
+        await options.credentials.save(
+          key(id),
+          JSON.stringify({ ...previous, kind, pendingFlowId: flowId }),
+        );
+      });
+      const ready = Promise.withResolvers<SubscriptionLogin>();
+      const done = Promise.resolve().then(async () => {
+        const credential = await oauth.login({
+          signal: controller.signal,
+          async prompt(prompt) {
+            if (kind === "openai-codex" && prompt.type === "select") return "device_code";
+            if (kind === "github-copilot" && prompt.type === "text") return "";
+            throw new Error("This authorization method requires a supported device flow");
+          },
+          notify(event) {
+            if (event.type === "device_code")
+              ready.resolve({
+                flowId,
+                verificationUrl: event.verificationUri,
+                userCode: event.userCode,
+              });
+          },
+        });
+        await options.withConnectionLock(id, async () => {
+          const current = await load(id, kind);
+          if (
+            generation(id) !== version ||
+            current?.pendingFlowId !== flowId ||
+            (await driver(id)).kind !== kind
+          )
+            throw new Error("Subscription operation cancelled");
+          await options.credentials.save(key(id), JSON.stringify({ kind, credential }));
+          await options.setConnected(id, true);
+        });
+      });
+      const flow = { id: flowId, controller, done };
+      flows.set(id, flow);
+      // Attach immediately: login may fail before the renderer receives a flow ID.
+      void done.catch((error: unknown) => ready.reject(error));
+      controller.signal.addEventListener(
+        "abort",
+        () => ready.reject(new Error("Subscription login cancelled")),
+        { once: true },
+      );
+      try {
+        return await ready.promise;
+      } catch (error) {
+        if (flows.get(id) === flow) flows.delete(id);
+        throw error;
+      }
+    },
+    async finish(id, flowId) {
+      const flow = flows.get(id);
+      if (!flow || flow.id !== flowId) throw new Error("Subscription login expired or cancelled");
+      try {
+        await flow.done;
+      } finally {
+        if (flows.get(id) === flow) flows.delete(id);
+      }
+    },
+    async cancel(id, flowId) {
+      if (flows.get(id)?.id === flowId) invalidate(id);
+      await options.withConnectionLock(id, async () => {
+        const raw = await options.credentials.load(key(id));
+        if (!raw) return;
+        const current = JSON.parse(raw) as SavedConnection;
+        if (current.pendingFlowId !== flowId) return;
+        delete current.pendingFlowId;
+        await options.credentials.save(key(id), JSON.stringify(current));
+      });
+    },
+    async disconnect(id) {
+      invalidate(id);
+      await options.withConnectionLock(id, async () => {
+        await options.credentials.delete(key(id));
+        if ((await options.getView()).providers.some((p) => p.providerId === id))
+          await options.setConnected(id, false);
+      });
+    },
+    async resolve(id, expectedKind) {
+      const { kind } = await driver(id, expectedKind);
+      const pending = refreshing.get(id);
+      if (pending) return pending;
+      const version = generation(id);
+      // 现有文件锁跨 Host 串行 refresh，网络调用也在锁内，避免旋转 refresh token 被并发消费。
+      const request = options.withConnectionLock(id, async () => {
+        const { oauth } = await driver(id, kind);
+        const saved = await load(id, kind);
+        if (!saved?.credential) throw new Error("Sign in to this subscription connection first");
+        let credential = saved.credential;
+        if (credential.expires <= now() + 60_000) {
+          credential = {
+            ...credential,
+            ...(await oauth.refresh(credential, AbortSignal.timeout(30_000))),
+          };
+          if (generation(id) !== version) throw new Error("Subscription operation cancelled");
+          await options.credentials.save(key(id), JSON.stringify({ ...saved, credential }));
+        }
+        const auth = await oauth.toAuth(credential);
+        if (generation(id) !== version) throw new Error("Subscription operation cancelled");
+        return requestAuth(auth);
+      });
+      refreshing.set(id, request);
+      try {
+        return await request;
+      } finally {
+        if (refreshing.get(id) === request) refreshing.delete(id);
+      }
+    },
+  };
+}
+function requestAuth(auth: ModelAuth): SubscriptionRequestAuth {
+  if (!auth.apiKey) throw new Error("Subscription token is unavailable; sign in again");
+  return {
+    apiKey: auth.apiKey,
+    headers: Object.fromEntries(
+      Object.entries(auth.headers ?? {}).filter(
+        (pair): pair is [string, string] => typeof pair[1] === "string",
+      ),
+    ),
+    ...(auth.baseUrl ? { baseUrl: auth.baseUrl } : {}),
+  };
+}
