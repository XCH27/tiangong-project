@@ -561,3 +561,48 @@ test("new conversation policies persist in Personal while preserving fixed and a
     await f.close();
   }
 });
+
+test("new TypeSafe source has the published pin and existing alias bindings survive cold reopen", async () => {
+  const f = await fixture();
+  try {
+    const before = (await f.service.getView()).preferencesRevision;
+    const { providerId } = await f.runtime.configService.createPersonalProvider({
+      templateId: "fleet-typesafe-system-one",
+      initialConfig: parseProviderConfig({
+        access: { type: "api-key", apiKey: "synthetic-typesafe-fixture" },
+      }),
+    });
+    await f.runtime.registryService.refresh("dedicated-source-created");
+    let view = await f.service.getView();
+    assert.notEqual(view.preferencesRevision, before);
+    for (const modelId of ["jev-1.13.0", "jev-latest"])
+      assert.ok(
+        view.classifierModels?.some(
+          (entry) => entry.providerId === providerId && entry.modelId === modelId,
+        ),
+      );
+    const alias = { providerId, modelId: "jev-latest" };
+    await f.service.savePreferences({
+      expectedRevision: view.preferencesRevision,
+      decisionModelSettings: { enabled: false, selection: alias },
+    });
+    await f.reopen();
+    view = await f.service.getView();
+    assert.deepEqual(view.decisionModelSettings?.selection, alias);
+    assert.equal(view.decisionModelSettings?.enabled, false);
+    const pin = { providerId, modelId: "jev-1.13.0" };
+    await f.service.savePreferences({
+      expectedRevision: view.preferencesRevision,
+      decisionModelSettings: { enabled: false, selection: pin },
+    });
+    await f.reopen();
+    assert.deepEqual((await f.service.getView()).decisionModelSettings?.selection, pin);
+    assert.ok(
+      (await f.service.getView()).classifierModels?.some(
+        (entry) => entry.providerId === providerId && entry.modelId === "jev-latest",
+      ),
+    );
+  } finally {
+    await f.close();
+  }
+});
