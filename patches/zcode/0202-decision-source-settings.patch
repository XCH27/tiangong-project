diff --git a/packages/ui/src/settings/DecisionSourceEditor.tsx b/packages/ui/src/settings/DecisionSourceEditor.tsx
new file mode 100644
index 0000000..c987261
--- /dev/null
+++ b/packages/ui/src/settings/DecisionSourceEditor.tsx
@@ -0,0 +1,237 @@
+import { useEffect, useRef, useState } from "react";
+import {
+  isLocalClassifierEndpoint,
+  type ProviderConfigObject,
+  type ProviderSettingsTemplateView,
+} from "@zcode/provider";
+import type { DecisionModelRef } from "@zcode/shared";
+import type {
+  ProviderSettingsFormProvider,
+  ProviderSettingsSaveHandler,
+  ProviderSettingsSaveReceipt,
+} from "@/lib/providerSettingsFormTypes.js";
+import { pageAssistantScope } from "@/page-assistant/PageAssistantContext.js";
+import { Input } from "@/components/ui/input.js";
+import { Button } from "@/components/ui/button.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { SettingsRow } from "./SettingsPageParts.js";
+import { ModelConfigHelp } from "./model-provider-section/ModelConfigHelp.js";
+import { PresetProviderApiKeyBanner } from "./model-provider-section/PresetProviderApiKeyBanner.js";
+import { ApiKeyInput } from "./model-provider-section/ApiKeyInput.js";
+import {
+  newProviderSetupDraft,
+  providerSetupConfig,
+} from "./model-provider-section/providerSetupDraft.js";
+import {
+  readProviderDraftValues,
+  resolvePendingProviderDraftSave,
+} from "./model-provider-section/ProviderDraftSave.js";
+
+/** All accepted state remains in the existing Provider facade; this interface carries commands. */
+export interface DecisionSourceControls {
+  templates: readonly ProviderSettingsTemplateView[];
+  providers: readonly ProviderSettingsFormProvider[];
+  revision?: number;
+  reload(): void | Promise<unknown>;
+  openExternal?(url: string): void | Promise<unknown>;
+  create(templateId: string, config: ProviderConfigObject): Promise<ProviderSettingsSaveReceipt>;
+  save: ProviderSettingsSaveHandler;
+  addModel(providerId: string, modelId: string): Promise<ProviderSettingsSaveReceipt>;
+}
+
+export function DecisionSourceEditor({
+  source,
+  provider,
+  template,
+  controls,
+  selectedModelId,
+  onSaved,
+  onBusy,
+}: {
+  source: string;
+  provider?: ProviderSettingsFormProvider;
+  template: ProviderSettingsTemplateView;
+  controls: DecisionSourceControls;
+  selectedModelId?: string;
+  onSaved(selection: DecisionModelRef, current: () => boolean): Promise<boolean>;
+  onBusy(busy: boolean): void;
+}) {
+  const { intl } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelDefaults.decision.${key}` });
+  const seed = provider ? readProviderDraftValues(provider) : undefined;
+  const [url, setUrl] = useState(seed?.baseUrlValue ?? template.config.api?.baseUrl ?? "");
+  const [key, setKey] = useState(seed?.apiKeyValue ?? "");
+  const [model, setModel] = useState(
+    selectedModelId ?? template.config.builtinModelIds?.[0] ?? "auto",
+  );
+  const [visible, setVisible] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState(false);
+  const [uncertainCreation, setUncertainCreation] = useState(false);
+  const saveLock = useRef(false);
+  const receipt = useRef<ProviderSettingsSaveReceipt | undefined>(
+    provider && controls.revision !== undefined
+      ? { provider, revision: controls.revision }
+      : undefined,
+  );
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  const optional = isLocalClassifierEndpoint(url);
+  const keyAccess = provider?.config.access ?? template.config.access;
+  const keyUrl =
+    keyAccess && "apiKeyManagementUrl" in keyAccess ? keyAccess.apiKeyManagementUrl : undefined;
+  const newConfig = providerSetupConfig(
+    template,
+    { ...newProviderSetupDraft(template), baseUrl: url, primary: key },
+    ["typesafe-system-one"],
+  );
+  const valid = Boolean(newConfig && model.trim());
+  const save = async () => {
+    if (saveLock.current || uncertainCreation || !valid || !newConfig) return;
+    saveLock.current = true;
+    let creating = false;
+    setBusy(true);
+    onBusy(true);
+    setError(false);
+    try {
+      let saved = receipt.current;
+      if (!saved) {
+        creating = true;
+        saved = await controls.create(template.templateId, newConfig);
+        creating = false;
+        receipt.current = saved; // A failed later preference write must not create a duplicate.
+      } else {
+        const draft = readProviderDraftValues(saved.provider);
+        const pending = resolvePendingProviderDraftSave({
+          provider: saved.provider,
+          draft: { ...draft, baseUrlValue: url, apiKeyValue: key },
+          now: Date.now,
+        });
+        if (pending) {
+          saved = await controls.save(pending, saved.revision);
+          receipt.current = saved;
+        }
+      }
+      const modelId = model.trim();
+      if (!saved.provider.models.some((entry) => entry.modelId === modelId)) {
+        saved = await controls.addModel(saved.provider.providerId, modelId);
+        receipt.current = saved;
+      }
+      if (!mounted.current) return;
+      if (
+        !(await onSaved({ providerId: saved.provider.providerId, modelId }, () => mounted.current))
+      )
+        setError(true);
+    } catch {
+      if (mounted.current) {
+        setError(true);
+        if (creating) setUncertainCreation(true);
+      }
+    } finally {
+      saveLock.current = false;
+      if (mounted.current) {
+        setBusy(false);
+        onBusy(false);
+      }
+    }
+  };
+  return (
+    <div
+      data-decision-source-editor={source}
+      {...(receipt.current
+        ? pageAssistantScope(
+            { feature: "model-settings", providerId: receipt.current.provider.providerId },
+            receipt.current.provider.providerName ?? receipt.current.provider.providerId,
+          )
+        : {})}
+    >
+      <SettingsRow
+        breakpoint="md"
+        label={
+          <span className="inline-flex items-center">
+            {t("address")}
+            <ModelConfigHelp field="advanced" label={t("address")} copy={t("addressHelp")} />
+          </span>
+        }
+        control={
+          <Input
+            aria-label={t("address")}
+            value={url}
+            disabled={busy}
+            onChange={(event) => {
+              setUrl(event.target.value);
+              setError(false);
+            }}
+          />
+        }
+      />
+      <SettingsRow
+        breakpoint="md"
+        label={intl.formatMessage({
+          id: optional ? "settings.modelProvider.apiKeyOptional" : "settings.modelProvider.apiKey",
+        })}
+        control={
+          <ApiKeyInput
+            value={key}
+            visible={visible}
+            readOnly={busy}
+            onChange={(value) => {
+              setKey(value);
+              setError(false);
+            }}
+            onBlur={() => {}}
+            onToggleVisibility={() => setVisible(!visible)}
+          />
+        }
+      />
+      {keyUrl && controls.openExternal ? (
+        <div className="px-4 pb-3">
+          <PresetProviderApiKeyBanner onOpenApiKey={() => void controls.openExternal?.(keyUrl)} />
+        </div>
+      ) : null}
+      <SettingsRow
+        breakpoint="md"
+        label={t("model")}
+        control={
+          <Input
+            aria-label={t("model")}
+            value={model}
+            disabled={busy}
+            onChange={(event) => {
+              setModel(event.target.value);
+              setError(false);
+            }}
+          />
+        }
+      />
+      <SettingsRow
+        breakpoint="md"
+        label={t("configureSource")}
+        control={
+          <Button
+            type="button"
+            disabled={busy || uncertainCreation || !valid}
+            onClick={() => void save()}
+          >
+            {intl.formatMessage({ id: busy ? "common.saving" : "settings.modelProvider.save" })}
+          </Button>
+        }
+      />
+      {error ? (
+        <div className="px-4 pb-3">
+          <p role="alert" className="text-ui-base text-destructive">
+            {t(uncertainCreation ? "sourceSaveUncertain" : "sourceSaveFailed")}
+          </p>
+          <Button type="button" variant="outline" onClick={() => void controls.reload()}>
+            {t("reloadSources")}
+          </Button>
+        </div>
+      ) : null}
+    </div>
+  );
+}
