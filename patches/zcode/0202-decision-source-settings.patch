diff --git a/packages/ui/test/decisionSourceSettings.browser.test.tsx b/packages/ui/test/decisionSourceSettings.browser.test.tsx
new file mode 100644
index 0000000..5e6db6e
--- /dev/null
+++ b/packages/ui/test/decisionSourceSettings.browser.test.tsx
@@ -0,0 +1,430 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ProviderSettingsFacade, parseProviderTemplateMap } from "@zcode/provider";
+import builtin from "../../../config/provider/zcode-builtin.json";
+import {
+  customDecisionSourceTemplate,
+  DECISION_CUSTOM_TEMPLATE_ID,
+} from "../src/settings/model-provider-section/providerTemplateCatalog.js";
+import { ModelPurposeDefaults } from "../src/settings/ModelPurposeDefaults.js";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { useRemoteWorkspaceSessionStore } from "../src/store/remoteWorkspaceSessionStore.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: { name: string; error?: string }[] = [];
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const frame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+const templates = new ProviderSettingsFacade({
+  getSnapshot: () => ({
+    registry: { revision: 1 },
+    config: {
+      zcodeBuiltinProviderTemplates: parseProviderTemplateMap(
+        builtin.config.providerConfigRules.templateRules,
+      ),
+    },
+    resolution: { registryProviders: [], resolvedProviders: [] },
+    account: { states: {} },
+  }),
+} as never).getView().providerTemplates;
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
+async function fixture(locale = "en-US") {
+  const node = document.createElement("div");
+  node.style.width = "320px";
+  document.body.append(node);
+  const root = createRoot(node);
+  const previous = useRemoteWorkspaceSessionStore.getState().baseServices;
+  useRemoteWorkspaceSessionStore.setState({ baseServices: null });
+  const listeners = new Set<(view: any) => void>();
+  const providers: any[] = [];
+  let revision = 1;
+  let settings: any = {
+    enabled: false,
+    automaticTiers: { standard: { providerId: "chat", modelId: "main" } },
+  };
+  const events: any[] = [];
+  let failBinding = false;
+  let loseCreationAck = false;
+  let delayCreation: Promise<unknown> | undefined;
+  let closed = false;
+  const view = () => ({
+    revision,
+    preferencesRevision: `personal-${revision}`,
+    decisionModelSettings: settings,
+    providers: providers.map((provider) => ({
+      providerId: provider.providerId,
+      providerName: provider.providerName,
+      config: provider.config,
+      models: provider.models,
+    })),
+    classifierModels: providers.flatMap((provider) =>
+      provider.models.map((model: any) => ({
+        providerId: provider.providerId,
+        providerName: provider.providerName,
+        modelId: model.modelId,
+        lane: "classifier",
+      })),
+    ),
+  });
+  const publish = () => {
+    for (const listener of listeners) listener(view());
+  };
+  const service = {
+    onDidChange: (listener: (view: any) => void) => {
+      listeners.add(listener);
+      return { dispose: () => listeners.delete(listener) };
+    },
+    getView: async () => view(),
+    savePreferences: async (patch: any) => {
+      events.push({ kind: "preference", patch });
+      check(
+        patch.expectedRevision === `personal-${revision}`,
+        "Binding used a pre-creation revision",
+      );
+      if (failBinding && patch.decisionModelSettings?.selection) {
+        failBinding = false;
+        throw new Error("preference commit failed");
+      }
+      settings = patch.decisionModelSettings ?? settings;
+      revision++;
+      publish();
+      return settings;
+    },
+  };
+  const controls = {
+    templates,
+    providers,
+    get revision() {
+      return revision;
+    },
+    reload: async () => publish(),
+    create: async (templateId: string, config: any) => {
+      events.push({ kind: "create", templateId, config });
+      await delayCreation;
+      const template =
+        templates.find((entry) => entry.templateId === templateId) ?? customDecisionSourceTemplate;
+      const provider = {
+        providerId: "local-source",
+        providerName: "Saved local source",
+        templateId: templateId === DECISION_CUSTOM_TEMPLATE_ID ? undefined : templateId,
+        config: {
+          ...template.config,
+          ...config,
+          api: { ...template.config.api, ...config.api },
+          access: { ...template.config.access, ...config.access },
+        },
+        personalConfig: config,
+        enabled: true,
+        hasPersonalConfig: true,
+        models: (templateId === DECISION_CUSTOM_TEMPLATE_ID
+          ? []
+          : (template.config.builtinModelIds ?? [])
+        ).map((modelId) => ({
+          modelId,
+          config: { enabled: true },
+          personalConfig: {},
+          executable: false,
+        })),
+      };
+      providers.push(provider);
+      revision++;
+      publish();
+      if (loseCreationAck) {
+        loseCreationAck = false;
+        throw new Error("creation acknowledgement lost");
+      }
+      return { provider, revision };
+    },
+    save: async (provider: any, basedOnRevision: number) => {
+      events.push({ kind: "save", provider, basedOnRevision });
+      check(basedOnRevision === revision, "Provider draft lost its write revision");
+      providers.splice(0, providers.length, provider);
+      revision++;
+      publish();
+      return { provider, revision };
+    },
+    addModel: async (providerId: string, modelId: string) => {
+      events.push({ kind: "add-model", providerId, modelId });
+      const provider = providers.find((entry) => entry.providerId === providerId)!;
+      provider.models.push({
+        modelId,
+        config: { enabled: true },
+        personalConfig: {},
+        executable: false,
+      });
+      revision++;
+      publish();
+      return { provider, revision };
+    },
+  };
+  await act(async () =>
+    root.render(
+      <ServiceProvider services={{ modelSelectionService: service } as never}>
+        <ZCodeIntlProvider initialLocale={locale as never}>
+          <TooltipProvider>
+            <ModelPurposeDefaults sourceControls={controls as never} />
+          </TooltipProvider>
+        </ZCodeIntlProvider>
+      </ServiceProvider>,
+    ),
+  );
+  const zh = locale === "zh-CN";
+  const choose = async (name: string) => {
+    const trigger = node.querySelector<HTMLButtonElement>(
+      `[aria-label="${zh ? "决策来源" : "Decision source"}"]`,
+    )!;
+    await act(async () =>
+      trigger.dispatchEvent(
+        new PointerEvent("pointerdown", { bubbles: true, pointerType: "mouse", button: 0 }),
+      ),
+    );
+    await frame();
+    const item = [...document.querySelectorAll<HTMLElement>('[role="option"]')].find(
+      (entry) => entry.textContent?.trim() === name,
+    );
+    check(item, "Missing source: " + name);
+    await act(async () => item!.click());
+  };
+  const saveButton = () =>
+    [...node.querySelectorAll<HTMLButtonElement>("button")].find(
+      (entry) => entry.textContent?.trim() === (zh ? "保存" : "Save"),
+    )!;
+  const enter = async (label: string, value: string) => {
+    const input = node.querySelector<HTMLInputElement>(`input[aria-label="${label}"]`)!;
+    check(input, "Missing input " + label);
+    await act(async () => {
+      Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, value);
+      input.dispatchEvent(new Event("input", { bubbles: true }));
+    });
+  };
+  return {
+    node,
+    controls,
+    providers,
+    events,
+    view,
+    choose,
+    enter,
+    saveButton,
+    async laya() {
+      await choose(zh ? "配置 Laya（本地服务）" : "Set up Laya (local service)");
+    },
+    failBinding() {
+      failBinding = true;
+    },
+    loseAck() {
+      loseCreationAck = true;
+    },
+    delay(value: Promise<unknown>) {
+      delayCreation = value;
+    },
+    async save() {
+      await act(async () => saveButton().click());
+    },
+    async close() {
+      if (!closed) {
+        closed = true;
+        await act(async () => root.unmount());
+        node.remove();
+        useRemoteWorkspaceSessionStore.setState({ baseServices: previous });
+      }
+    },
+  };
+}
+(window as any).__decisionSourceSettingsTests = (async () => {
+  for (const locale of ["zh-CN", "en-US"])
+    for (const theme of ["theme-zai-light", "theme-zai-dark"]) {
+      await test(`${locale}/${theme}: dedicated fields stay inside auxiliary settings and bind after the existing source writer`, async () => {
+        document.documentElement.className = theme;
+        const f = await fixture(locale);
+        const zh = locale === "zh-CN";
+        try {
+          await f.laya();
+          check(
+            !f.node.querySelector('[role="tablist"]'),
+            "An unrelated chat wire format appeared in a System One form",
+          );
+          check(
+            f.node.textContent?.includes(zh ? "API Key（可选）" : "API Key (optional)"),
+            "Local key became mandatory",
+          );
+          check(!f.saveButton().disabled, "Keyless local source cannot be saved");
+          await f.enter(zh ? "服务地址" : "Service address", "https://classifier.example/v1");
+          check(f.saveButton().disabled, "Remote keyless source was admitted");
+          await f.enter(zh ? "服务地址" : "Service address", "http://127.0.0.1:8000/v1");
+          await f.save();
+          check(
+            f.events.filter((entry) => entry.kind === "create").length === 1,
+            "Creation duplicated",
+          );
+          check(
+            f.view().decisionModelSettings.selection?.providerId === "local-source" &&
+              f.view().decisionModelSettings.selection.modelId === "auto",
+            "Saved source was not bound: " + JSON.stringify(f.view().decisionModelSettings),
+          );
+          check(!f.view().decisionModelSettings.enabled, "Saving configuration enabled inference");
+          check(
+            !f.node.querySelector<HTMLButtonElement>(
+              `[aria-label="${zh ? "决策来源" : "Decision source"}"]`,
+            )?.disabled,
+            "Source controls stayed locked after binding/remount",
+          );
+          check(
+            f.view().decisionModelSettings.automaticTiers.standard.modelId === "main",
+            "Source setup replaced automatic tiers",
+          );
+          check(
+            document.documentElement.scrollWidth <= innerWidth,
+            "Narrow source configuration escaped the window",
+          );
+        } finally {
+          await f.close();
+        }
+      });
+    }
+  await test("source form retains two columns beside a scrollbar at 500px and stacks at 320px", async () => {
+    const f = await fixture();
+    try {
+      await f.laya();
+      const source = f.node.querySelector("[data-decision-source-editor]")!;
+      const grid = source.querySelector<HTMLElement>(".grid")!;
+      check(
+        getComputedStyle(grid).gridTemplateColumns.trim().split(" ").length === 1,
+        "Narrow controls do not stack",
+      );
+      f.node.style.width = "500px";
+      await frame();
+      check(
+        getComputedStyle(grid).gridTemplateColumns.trim().split(" ").length === 2,
+        "Scrollbar-width form unnecessarily doubled its rows",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("TypeSafe setup begins with the published pin and retains its historical alias", async () => {
+    const f = await fixture();
+    try {
+      await f.choose("Set up TypeSafe Jev");
+      check(
+        f.node.querySelector<HTMLInputElement>('input[aria-label="Decision model"]')?.value ===
+          "jev-1.13.0",
+        "New source followed a moving alias",
+      );
+      const template = templates.find((entry) => entry.templateId === "fleet-typesafe-system-one")!;
+      check(
+        template.config.builtinModelIds?.includes("jev-latest"),
+        "Historical alias membership was removed",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("custom source stays editable in auxiliary settings after binding without a template identity", async () => {
+    const f = await fixture();
+    try {
+      await f.choose("Set up Custom decision service");
+      await f.enter("Service address", "http://127.0.0.1:8000/v1");
+      await f.enter("Decision model", "my-classifier");
+      await f.save();
+      check(
+        f.providers[0]?.templateId === undefined,
+        "Custom source invented a persisted template",
+      );
+      check(
+        f.view().decisionModelSettings.selection?.modelId === "my-classifier",
+        "Custom model was not bound after membership save",
+      );
+      check(
+        f.node.querySelector<HTMLInputElement>('input[aria-label="Service address"]')?.value ===
+          "http://127.0.0.1:8000/v1",
+        "Saved custom source lost its inline configuration",
+      );
+      check(
+        f.events.filter((entry) => entry.kind === "create").length === 1 &&
+          f.events.filter((entry) => entry.kind === "add-model").length === 1,
+        "Custom source duplicated creation or model registration",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("failed preference binding retries the committed source without another creation", async () => {
+    const f = await fixture();
+    try {
+      await f.laya();
+      f.failBinding();
+      await f.save();
+      check(
+        f.providers.length === 1 && f.node.querySelector('[role="alert"]'),
+        "Committed source or failure diagnosis was lost",
+      );
+      await f.save();
+      check(
+        f.events.filter((entry) => entry.kind === "create").length === 1,
+        "Retry created a replacement",
+      );
+      check(
+        f.view().decisionModelSettings.selection?.providerId === "local-source",
+        "Retry did not bind retained source",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("unknown creation acknowledgement fences replay and the saved source can be selected explicitly", async () => {
+    const f = await fixture();
+    try {
+      await f.laya();
+      f.loseAck();
+      await f.save();
+      check(
+        f.saveButton().disabled && f.providers.length === 1,
+        "Unknown creation was left replayable",
+      );
+      await f.choose("Saved local source");
+      check(
+        f.events.filter((entry) => entry.kind === "create").length === 1,
+        "Selecting the saved source created another",
+      );
+      check(
+        f.view().decisionModelSettings.selection?.providerId === "local-source",
+        "Saved source is unreachable after acknowledgement failure",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  await test("leaving the page during creation cannot bind a delayed source into a newer settings view", async () => {
+    const f = await fixture();
+    let complete!: () => void;
+    const delay = new Promise<void>((resolve) => {
+      complete = resolve;
+    });
+    try {
+      await f.laya();
+      f.delay(delay);
+      const before = f.events.filter((entry) => entry.kind === "preference").length;
+      await f.save();
+      await f.close();
+      await act(async () => complete());
+      check(
+        f.events.filter((entry) => entry.kind === "preference").length === before,
+        "Delayed source changed preferences after unmount",
+      );
+    } finally {
+      await f.close();
+    }
+  });
+  return results;
+})();
