diff --git a/packages/ui/test/helpers/providerDraftFixture.tsx b/packages/ui/test/helpers/providerDraftFixture.tsx
new file mode 100644
index 0000000..99d2244
--- /dev/null
+++ b/packages/ui/test/helpers/providerDraftFixture.tsx
@@ -0,0 +1,208 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../../src/components/ui/tooltip.js";
+import { InlineEditableProviderCard } from "../../src/settings/model-provider-section/InlineEditableProviderCard.js";
+import { ProviderDetailFeedbackBoundary } from "../../src/settings/model-provider-section/ProviderDetailFeedback.js";
+import type { SavePersonalModelDraftInput } from "@zcode/provider";
+import type {
+  ProviderSettingsFormProvider,
+  ProviderSettingsSaveReceipt,
+} from "../../src/lib/providerSettingsFormTypes.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+
+export function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+export function provider(
+  id = "A",
+  url = "https://fixture.invalid/v1",
+  key = "synthetic-original",
+): ProviderSettingsFormProvider {
+  const config = {
+    group: "standard-personal" as const,
+    api: { type: "openai-chat-completions" as const, baseUrl: url },
+    access: { type: "api-key" as const, apiKey: key },
+  };
+  return {
+    providerId: id,
+    providerName: id,
+    enabled: true,
+    executable: true,
+    hasPersonalConfig: true,
+    personalConfig: config,
+    config,
+    models: [],
+  };
+}
+
+export async function fixture(locale: "zh-CN" | "en-US" = "en-US") {
+  const container = document.createElement("div");
+  document.body.append(container);
+  const root = createRoot(container);
+  const writes: Array<{
+    provider: ProviderSettingsFormProvider;
+    revision?: number;
+    result: ReturnType<typeof Promise.withResolvers<ProviderSettingsSaveReceipt>>;
+  }> = [];
+  const modelWrites: Array<{
+    input: SavePersonalModelDraftInput;
+    result: ReturnType<typeof Promise.withResolvers<ProviderSettingsSaveReceipt>>;
+  }> = [];
+  const modelActions: Array<{
+    kind: "enabled" | "add" | "order";
+    result: ReturnType<typeof Promise.withResolvers<ProviderSettingsSaveReceipt>>;
+  }> = [];
+  let currentModel: ProviderSettingsFormProvider["models"][number] | undefined;
+  const services = {
+    providerSettingsService: {
+      async discoverModels() {
+        return { models: [], warnings: [] };
+      },
+      async resolveModelConfig() {
+        return {
+          inheritedConfig: currentModel?.config ?? {},
+          effectiveConfig: currentModel?.config ?? {},
+          evidenceConfig: currentModel?.config ?? {},
+          issues: [],
+        };
+      },
+    },
+  };
+  return {
+    container,
+    writes,
+    modelWrites,
+    modelActions,
+    conflictText: locale === "zh-CN" ? "设置已变更" : "Settings changed",
+    async render(value: ProviderSettingsFormProvider, revision: number) {
+      currentModel = value.models[0];
+      await act(async () => {
+        root.render(
+          <ServiceProvider services={services as never}>
+            <ZCodeIntlProvider initialLocale={locale}>
+              <TooltipProvider>
+                <ProviderDetailFeedbackBoundary>
+                  <InlineEditableProviderCard
+                    provider={value}
+                    settingsRevision={revision}
+                    nameEditable
+                    onSavePersonalModelDraft={(input) => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      modelWrites.push({ input, result });
+                      return result.promise;
+                    }}
+                    onSetPersonalModelEnabled={() => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      modelActions.push({ kind: "enabled", result });
+                      return result.promise;
+                    }}
+                    onAddPersonalModel={() => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      modelActions.push({ kind: "add", result });
+                      return result.promise;
+                    }}
+                    onReorderModelIds={() => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      modelActions.push({ kind: "order", result });
+                      return result.promise;
+                    }}
+                    onSave={(next, basedOnRevision) => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      writes.push({ provider: next, revision: basedOnRevision, result });
+                      return result.promise;
+                    }}
+                  />
+                </ProviderDetailFeedbackBoundary>
+              </TooltipProvider>
+            </ZCodeIntlProvider>
+          </ServiceProvider>,
+        );
+      });
+    },
+    input(selector: string) {
+      const input = container.querySelector<HTMLInputElement>(selector);
+      check(input, `Missing input: ${selector}`);
+      return input;
+    },
+    async type(input: HTMLInputElement, value: string) {
+      await act(async () => {
+        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(
+          input,
+          value,
+        );
+        input.dispatchEvent(new Event("input", { bubbles: true }));
+      });
+    },
+    async key(input: HTMLInputElement, key: string) {
+      await act(async () => {
+        input.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true }));
+      });
+    },
+    async settle(index: number, value: ProviderSettingsSaveReceipt | Error) {
+      await act(async () => {
+        if (value instanceof Error) writes[index]!.result.reject(value);
+        else writes[index]!.result.resolve(value);
+      });
+    },
+    async close() {
+      await act(async () => {
+        root.unmount();
+      });
+      container.remove();
+    },
+    async failModel(index: number) {
+      await act(async () => {
+        modelWrites[index]!.result.reject(
+          new Error("Provider Settings revision conflict: expected 40, current 41"),
+        );
+      });
+    },
+    async settleModelAction(index: number, value: ProviderSettingsSaveReceipt) {
+      await act(async () => {
+        modelActions[index]!.result.resolve(value);
+      });
+    },
+  };
+}
+
+export function providerWithModel(): ProviderSettingsFormProvider {
+  const value = provider();
+  const config = {
+    enabled: true,
+    properties: {
+      contextWindow: 128_000,
+      supportsToolCall: true,
+      inputFormat: {
+        supportsText: true,
+        supportsImage: false,
+        supportsVideo: false,
+        supportsAudio: false,
+        supportsPdf: false,
+      },
+      outputFormat: { supportsText: true },
+    },
+    optionSpecs: {
+      maxOutputTokens: { max: 8192, map: "{}" },
+      reasoningLevel: { values: ["off"], map: "{}" },
+    },
+  };
+  value.models = [
+    {
+      kind: "candidate",
+      modelId: "fixture-model",
+      builtin: false,
+      config,
+      inheritedConfig: config,
+      evidenceConfig: config,
+      personalConfig: {},
+      hasPersonalConfig: false,
+      executable: true,
+      selectable: true,
+    },
+  ];
+  return value;
+}
