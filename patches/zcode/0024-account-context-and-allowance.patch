diff --git a/packages/ui/test/contextTokenDetails.test.tsx b/packages/ui/test/contextTokenDetails.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..83ea773c909c483e55ada134f01a5da90cdcac52
--- /dev/null
+++ b/packages/ui/test/contextTokenDetails.test.tsx
@@ -0,0 +1,80 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import type { SessionUsageState } from "@zcode/shared/zcode-protocol-v4";
+import { ContextTokenDetails } from "../src/chat-input-toolbar/ContextTokenDetails.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+
+const emptyUsage: SessionUsageState = {
+  contextWindow: null,
+  cumulative: { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 },
+};
+
+function render(usage?: SessionUsageState): string {
+  // Standalone tsx uses classic JSX outside the UI build; provide its runtime only during SSR.
+  const previous = Object.getOwnPropertyDescriptor(globalThis, "React");
+  Object.defineProperty(globalThis, "React", { configurable: true, value: React });
+  try {
+    return renderToStaticMarkup(
+      <ZCodeIntlProvider initialLocale="en-US">
+        <ContextTokenDetails usage={usage} />
+      </ZCodeIntlProvider>,
+    );
+  } finally {
+    if (previous) Object.defineProperty(globalThis, "React", previous);
+    else Reflect.deleteProperty(globalThis, "React");
+  }
+}
+
+function detail(html: string, label: string): string | undefined {
+  return [...html.matchAll(/<dt[^>]*>(.*?)<\/dt><dd[^>]*>(.*?)<\/dd>/g)].find(
+    ([, actualLabel]) => actualLabel === label,
+  )?.[2];
+}
+
+test("token details retain reported zeros and unknowns without adding cache or reasoning subsets to consumption", () => {
+  assert.equal(render(), "");
+  assert.equal(render(emptyUsage), "", "no report must not fabricate a zero-usage table");
+
+  const zero = render({
+    ...emptyUsage,
+    lastRequest: { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0 },
+  });
+  assert.match(zero, /Last request/);
+  assert.equal(detail(zero, "Input"), "0");
+  assert.equal(detail(zero, "Output"), "0");
+  assert.equal(detail(zero, "Cache read (part of input)"), "0");
+  assert.equal(detail(zero, "Cache write (part of input)"), "—");
+  assert.equal(detail(zero, "Reasoning (part of output)"), "—");
+
+  const measured = render({
+    contextWindow: null,
+    lastRequest: {
+      modelId: "synthetic-model",
+      inputTokens: 100,
+      outputTokens: 20,
+      cacheReadTokens: 70,
+      cacheWriteTokens: 10,
+      reasoningTokens: 5,
+    },
+    cumulative: {
+      inputTokens: 1_000,
+      outputTokens: 200,
+      cacheReadTokens: 700,
+      cacheWriteTokens: 100,
+    },
+  });
+  assert.match(
+    measured,
+    /synthetic-model/,
+    "last-request data remains visible without known context capacity",
+  );
+  assert.equal(detail(measured, "Input"), "100");
+  assert.equal(detail(measured, "Cache read (part of input)"), "70");
+  assert.equal(detail(measured, "Cache write (part of input)"), "10");
+  assert.equal(detail(measured, "Output"), "20");
+  assert.equal(detail(measured, "Reasoning (part of output)"), "5");
+  assert.match(measured, /Recorded requests total<\/span><span[^>]*>1,200<\/span>/);
+  assert.doesNotMatch(measured, />2,000<|>1,205</);
+});
diff --git a/packages/ui/test/subscriptionAccountLifecycle.test.ts b/packages/ui/test/subscriptionAccountLifecycle.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..81ea85a2bbd9b69976a6e41bb579b0b3a6293de8
--- /dev/null
+++ b/packages/ui/test/subscriptionAccountLifecycle.test.ts
@@ -0,0 +1,121 @@
+import { subscriptionAccountDisplayLabel } from "../src/settings/model-provider-section/subscriptionAccountLifecycle.js";
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createSubscriptionAccountRequestGate,
+  expandedSubscriptionAccount,
+  finishSubscriptionAccountLogin,
+} from "../src/settings/model-provider-section/subscriptionAccountLifecycle.js";
+
+const first = { id: "a", label: "same@example.test", active: true };
+const second = { id: "b", label: "same@example.test", active: false };
+
+test("adding a second account always reloads the owner without a Registry event and keeps the default", async () => {
+  const order: string[] = [];
+  const value = { accounts: [first, second], revision: "r2", autoSwitch: false };
+  const completed = await finishSubscriptionAccountLogin({
+    before: [first],
+    finish: async () => {
+      order.push("finish");
+      return { authorizedAccountId: "b", accountAdded: true };
+    },
+    read: async () => {
+      order.push("read");
+      return value;
+    },
+    isCurrent: () => true,
+  });
+  assert.deepEqual(order, ["finish", "read"]);
+  assert.equal(completed.value, value);
+  assert.equal(completed.expand, "b");
+  assert.equal(completed.accountAdded, true);
+  assert.equal(completed.value.accounts.find((account) => account.active)?.id, "a");
+});
+
+test("reauthorization expands the receipt identity without adding or selecting an account", async () => {
+  const result = await finishSubscriptionAccountLogin({
+    before: [first, second],
+    finish: async () => ({ authorizedAccountId: "b", accountAdded: false }),
+    read: async () => ({ accounts: [first, second] }),
+    isCurrent: () => true,
+  });
+  assert.equal(result.expand, "b");
+  assert.equal(result.accountAdded, false);
+  assert.equal(result.value.accounts.length, 2);
+  assert.equal(result.value.accounts[0]?.active, true);
+});
+
+test("legacy completion discovers only a genuinely new ID; same labels do not merge or infer identity", async () => {
+  const result = await finishSubscriptionAccountLogin({
+    before: [first],
+    finish: async () => ({}),
+    read: async () => ({ accounts: [first, second] }),
+    isCurrent: () => true,
+  });
+  assert.equal(result.expand, "b");
+  assert.equal(result.accountAdded, undefined);
+  assert.equal(expandedSubscriptionAccount([first, second], undefined), "a");
+  assert.equal(expandedSubscriptionAccount([first, second], "b"), "b");
+  assert.equal(expandedSubscriptionAccount([first], "b"), "a");
+  assert.equal(expandedSubscriptionAccount([first, second], null), null);
+});
+
+test("mutation invalidates earlier reads and queues change events until authoritative write completion", () => {
+  const gate = createSubscriptionAccountRequestGate();
+  const delayedRead = gate.beginRead()!;
+  const write = gate.beginWrite()!;
+  assert.equal(gate.current(delayedRead), false);
+  assert.equal(gate.beginWrite(), undefined, "duplicate mutations cannot enter");
+  assert.equal(gate.beginRead(), undefined, "onDidChange cannot supersede an active mutation");
+  assert.equal(gate.current(write), true);
+  assert.equal(gate.finishWrite(write), true, "one fresh read follows queued changes");
+  const latestRead = gate.beginRead()!;
+  assert.equal(gate.current(latestRead), true);
+  assert.equal(gate.current(delayedRead), false);
+  gate.deactivate();
+  assert.equal(gate.current(latestRead), false);
+  assert.equal(gate.beginRead(), undefined, "unmounted callbacks cannot start another read");
+  gate.activate();
+  assert.notEqual(gate.beginRead(), undefined, "StrictMode effect replay can resubscribe");
+});
+
+test("cancel or navigation during login cannot publish a late completed account list", async () => {
+  let finish!: (value: { authorizedAccountId: string }) => void;
+  let active = true;
+  let reads = 0;
+  const result = finishSubscriptionAccountLogin({
+    before: [first],
+    finish: () =>
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+    read: async () => {
+      reads++;
+      return { accounts: [first, second] };
+    },
+    isCurrent: () => active,
+  });
+  active = false;
+  finish({ authorizedAccountId: "b" });
+  await assert.rejects(result, /cancelled/);
+  assert.equal(reads, 0);
+});
+
+test("same-email workspace accounts retain distinct display labels without changing their identity", () => {
+  const accounts = [
+    { id: "workspace-a", label: "same@example.test" },
+    { id: "workspace-b", label: "same@example.test" },
+  ];
+  assert.equal(
+    subscriptionAccountDisplayLabel(accounts, accounts[0]!, "Account 1"),
+    "same@example.test · Account 1",
+  );
+  assert.equal(
+    subscriptionAccountDisplayLabel(accounts, accounts[1]!, "Account 2"),
+    "same@example.test · Account 2",
+  );
+  assert.equal(
+    subscriptionAccountDisplayLabel([accounts[0]!], accounts[0]!, "Account 1"),
+    "same@example.test",
+  );
+});
diff --git a/packages/ui/test/subscriptionAllowanceDetails.test.tsx b/packages/ui/test/subscriptionAllowanceDetails.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2ac9fae47035b5631aec1f2fadcaf85d07984ba4
--- /dev/null
+++ b/packages/ui/test/subscriptionAllowanceDetails.test.tsx
@@ -0,0 +1,66 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { SubscriptionAllowanceDetails } from "../src/settings/model-provider-section/SubscriptionAllowanceDetails.js";
+import type { SubscriptionUsageReading } from "../src/settings/model-provider-section/subscriptionUsageLifecycle.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+
+const now = Date.parse("2026-09-27T10:00:00Z");
+const base: Extract<SubscriptionUsageReading, { status: "available" }> = {
+  status: "available",
+  source: "fixture",
+  observedAt: now,
+  windows: [
+    { id: "default:primary_window", usedPercent: 0, windowMinutes: 300 },
+    { id: "default:secondary_window", usedPercent: 15, windowMinutes: 10080 },
+  ],
+};
+function render(result = base, condensed = false) {
+  const previous = Object.getOwnPropertyDescriptor(globalThis, "React");
+  Object.defineProperty(globalThis, "React", { configurable: true, value: React });
+  try {
+    return renderToStaticMarkup(
+      <ZCodeIntlProvider initialLocale="en-US">
+        <SubscriptionAllowanceDetails result={result} now={now} condensed={condensed} />
+      </ZCodeIntlProvider>,
+    );
+  } finally {
+    if (previous) Object.defineProperty(globalThis, "React", previous);
+    else Reflect.deleteProperty(globalThis, "React");
+  }
+}
+test("account quota displays remaining consistently in labels and bars, preserving unknown and unlimited", () => {
+  const html = render();
+  assert.match(html, />100% remaining</);
+  assert.match(html, />85% remaining</);
+  assert.match(html, /aria-valuenow="85"/);
+  assert.match(html, /title="15% used"/);
+  assert.match(render(base, true), />85% remaining</);
+  assert.match(render(base, true), /bg-success/);
+  const sparse = render({
+    ...base,
+    windows: [{ id: "unknown" }, { id: "unlimited", unlimited: true }],
+  });
+  assert.match(sparse, />—</);
+  assert.match(sparse, />Unlimited</);
+  assert.doesNotMatch(sparse, /remaining<|aria-valuenow/);
+});
+test("remaining membership days require a reported term, and quota reset is never an expiry", () => {
+  assert.match(
+    render({
+      ...base,
+      windows: [{ id: "default:primary_window", usedPercent: 20, resetAt: now + 86400000 }],
+    }),
+    /Expiry unavailable/,
+  );
+  assert.match(
+    render({ ...base, membership: { source: "authorization", activeUntil: now + 86400000 * 2 } }),
+    /2d left in this term/,
+  );
+  assert.match(
+    render({ ...base, membership: { source: "authorization", activeUntil: now - 1000 } }),
+    /Term ended; renewal unconfirmed/,
+  );
+  assert.doesNotMatch(render(), /0 days|Term ended/);
+});
diff --git a/packages/ui/test/subscriptionUsageLifecycle.test.ts b/packages/ui/test/subscriptionUsageLifecycle.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..900d2e99aea3811a77acc42a733953e8907f1114
--- /dev/null
+++ b/packages/ui/test/subscriptionUsageLifecycle.test.ts
@@ -0,0 +1,126 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IProviderSettingsService } from "@zcode/services";
+import {
+  readScopedSubscriptionUsage,
+  subscriptionUsageMatchesScope,
+  subscriptionUsageScopeChanged,
+  subscriptionUsageRefreshDelay,
+  type SubscriptionUsageReading,
+} from "../src/settings/model-provider-section/subscriptionUsageLifecycle.js";
+
+const scope = { providerId: "fixture", revision: "r1", accountId: "account-a" };
+const reading: SubscriptionUsageReading = {
+  status: "available",
+  accountId: "account-a",
+  connectionRevision: "r1",
+  source: "fixture",
+  observedAt: 1_000,
+  refreshAfter: 61_000,
+  windows: [{ id: "primary", usedPercent: 0, resetAt: 30_000 }],
+};
+
+test("explicit account reads require both identity fields while legacy default reads remain compatible", () => {
+  assert.equal(subscriptionUsageMatchesScope(reading, scope), true);
+  assert.equal(subscriptionUsageMatchesScope({ status: "unavailable" }, scope), false);
+  assert.equal(subscriptionUsageMatchesScope({ ...reading, accountId: "account-b" }, scope), false);
+  assert.equal(
+    subscriptionUsageMatchesScope({ ...reading, connectionRevision: "r2" }, scope),
+    false,
+  );
+  assert.equal(
+    subscriptionUsageMatchesScope({ status: "unavailable" }, { ...scope, accountId: undefined }),
+    true,
+  );
+  assert.equal(
+    subscriptionUsageMatchesScope(
+      { ...reading, connectionRevision: "r2" },
+      { ...scope, accountId: undefined },
+    ),
+    false,
+  );
+});
+
+test("concurrent settings and popup reads coalesce without caching settled allowance", async () => {
+  let calls = 0;
+  let finish!: (value: SubscriptionUsageReading) => void;
+  const service = {
+    getSubscriptionUsage: (providerId: string, force: boolean, accountId: string) => {
+      calls++;
+      assert.equal(providerId, scope.providerId);
+      assert.equal(force, false);
+      assert.equal(accountId, scope.accountId);
+      return new Promise<SubscriptionUsageReading>((resolve) => {
+        finish = resolve;
+      });
+    },
+  } as unknown as IProviderSettingsService;
+  const first = readScopedSubscriptionUsage(service, scope, false);
+  const second = readScopedSubscriptionUsage(service, scope, true);
+  assert.equal(first, second);
+  await Promise.resolve();
+  assert.equal(calls, 1);
+  finish(reading);
+  assert.equal(await first, reading);
+  assert.equal((await second).status, "available");
+  const next = readScopedSubscriptionUsage(service, scope, false);
+  await Promise.resolve();
+  assert.equal(calls, 2, "the Host owner, not this helper, owns cached readings");
+  finish(reading);
+  await next;
+});
+
+test("provider, account, revision and Host service each isolate pending requests", async () => {
+  const calls: string[] = [];
+  const makeService = (host: string) =>
+    ({
+      getSubscriptionUsage: async (providerId: string, _force: boolean, accountId?: string) => {
+        calls.push(`${host}:${providerId}:${accountId}`);
+        return reading;
+      },
+    }) as unknown as IProviderSettingsService;
+  const hostA = makeService("a");
+  const hostB = makeService("b");
+  await Promise.all([
+    readScopedSubscriptionUsage(hostA, scope, false),
+    readScopedSubscriptionUsage(hostA, { ...scope, providerId: "other" }, false),
+    readScopedSubscriptionUsage(hostA, { ...scope, accountId: "account-b" }, false),
+    readScopedSubscriptionUsage(hostA, { ...scope, revision: "r2" }, false),
+    readScopedSubscriptionUsage(hostB, scope, false),
+  ]);
+  assert.equal(calls.length, 5);
+});
+
+test("failed requests release coalescing and known zero usage survives refresh scheduling", async () => {
+  let calls = 0;
+  const service = {
+    getSubscriptionUsage: async () => {
+      if (++calls === 1) throw new Error("offline fixture");
+      return reading;
+    },
+  } as unknown as IProviderSettingsService;
+  await assert.rejects(readScopedSubscriptionUsage(service, scope, false), /offline fixture/);
+  const value = await readScopedSubscriptionUsage(service, scope, false);
+  assert.equal(value.status === "available" && value.windows[0]?.usedPercent, 0);
+  assert.equal(subscriptionUsageRefreshDelay(value, 2_000), 59_000);
+  assert.equal(
+    subscriptionUsageRefreshDelay(value, 100_000),
+    60_000,
+    "expired deadlines cannot create a refresh loop",
+  );
+  assert.equal(subscriptionUsageRefreshDelay({ status: "unavailable" }, 0), 60_000);
+});
+
+test("a changed account revision repairs the account view instead of treating valid allowance as unavailable", () => {
+  const updated = { ...reading, connectionRevision: "r2" };
+  assert.equal(subscriptionUsageMatchesScope(updated, scope), false);
+  assert.equal(subscriptionUsageScopeChanged(updated, scope), true);
+  const reloaded = { ...scope, revision: "r2" };
+  assert.equal(subscriptionUsageMatchesScope(updated, reloaded), true);
+  assert.equal(subscriptionUsageScopeChanged(updated, reloaded), false);
+  assert.equal(
+    subscriptionUsageScopeChanged({ status: "unavailable" }, scope),
+    false,
+    "a missing legacy capability must not cause a reload loop",
+  );
+});
