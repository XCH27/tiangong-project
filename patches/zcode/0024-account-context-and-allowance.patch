diff --git a/packages/ui/src/settings/model-provider-section/subscriptionAccountLifecycle.ts b/packages/ui/src/settings/model-provider-section/subscriptionAccountLifecycle.ts
new file mode 100644
index 0000000000000000000000000000000000000000..52f749dd9edf1084b01a941010186d20aac354b4
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/subscriptionAccountLifecycle.ts
@@ -0,0 +1,103 @@
+export function createSubscriptionAccountRequestGate() {
+  let generation = 0;
+  let writing = false;
+  let queuedRead = false;
+  let active = true;
+  return {
+    beginRead() {
+      if (!active) return undefined;
+      if (writing) {
+        queuedRead = true;
+        return undefined;
+      }
+      return ++generation;
+    },
+    beginWrite() {
+      if (!active || writing) return undefined;
+      writing = true;
+      return ++generation;
+    },
+    current(ticket: number) {
+      return active && ticket === generation;
+    },
+    finishWrite(ticket: number) {
+      if (ticket !== generation) return false;
+      writing = false;
+      const reload = queuedRead;
+      queuedRead = false;
+      return reload;
+    },
+    invalidate() {
+      generation++;
+      writing = false;
+      queuedRead = false;
+    },
+    activate() {
+      active = true;
+    },
+    deactivate() {
+      active = false;
+      generation++;
+      writing = false;
+      queuedRead = false;
+    },
+  };
+}
+
+export function authorizedSubscriptionAccount(
+  before: readonly { id: string }[],
+  after: readonly { id: string }[],
+  receiptAccountId?: string,
+): string | undefined {
+  if (receiptAccountId && after.some((account) => account.id === receiptAccountId))
+    return receiptAccountId;
+  return after.find((account) => !before.some((prior) => prior.id === account.id))?.id;
+}
+
+export function expandedSubscriptionAccount(
+  accounts: readonly { id: string; active: boolean }[],
+  previous: string | null | undefined,
+  preferred?: string,
+): string | null {
+  if (preferred && accounts.some((account) => account.id === preferred)) return preferred;
+  if (previous === null || accounts.some((account) => account.id === previous))
+    return previous ?? null;
+  return accounts.find((account) => account.active)?.id ?? accounts[0]?.id ?? null;
+}
+
+export async function finishSubscriptionAccountLogin<
+  T extends { accounts: readonly { id: string }[] },
+>({
+  before,
+  finish,
+  read,
+  isCurrent,
+}: {
+  before: readonly { id: string }[];
+  finish(): Promise<{ authorizedAccountId?: string; accountAdded?: boolean }>;
+  read(): Promise<T>;
+  isCurrent(): boolean;
+}): Promise<{ value: T; expand?: string; accountAdded?: boolean }> {
+  const receipt = await finish();
+  if (!isCurrent()) throw new Error("Subscription login cancelled");
+  // 同一组模型的第二账号可能没有 Registry 变化事件；每次完成授权都重读账号 owner。
+  const value = await read();
+  if (!isCurrent()) throw new Error("Subscription login cancelled");
+  return {
+    value,
+    expand: authorizedSubscriptionAccount(before, value.accounts, receipt.authorizedAccountId),
+    accountAdded: receipt.accountAdded,
+  };
+}
+
+// 同邮箱可以属于不同工作区；保留两行，并用稳定列表序号区分显示，绝不据邮箱合并。
+export function subscriptionAccountDisplayLabel(
+  accounts: readonly { id: string; label?: string }[],
+  account: { id: string; label?: string },
+  fallback: string,
+): string {
+  if (!account.label) return fallback;
+  return accounts.some((other) => other.id !== account.id && other.label === account.label)
+    ? `${account.label} · ${fallback}`
+    : account.label;
+}
diff --git a/packages/ui/src/settings/model-provider-section/subscriptionUsageLifecycle.ts b/packages/ui/src/settings/model-provider-section/subscriptionUsageLifecycle.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59f31288767a0a5dae63a1377486623517f3ad2a
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/subscriptionUsageLifecycle.ts
@@ -0,0 +1,75 @@
+import type { IProviderSettingsService } from "@zcode/services";
+import { readProviderSettings } from "../../lib/providerSettingsRead.js";
+
+export type SubscriptionUsageReading = Awaited<
+  ReturnType<IProviderSettingsService["getSubscriptionUsage"]>
+>;
+
+export interface SubscriptionUsageScope {
+  providerId: string;
+  revision: string;
+  accountId?: string;
+}
+
+// 只合并在途 RPC，不缓存额度；快照和 60 秒缓存仍由 Host 的订阅 owner 管理。
+const inFlight = new WeakMap<
+  IProviderSettingsService,
+  Map<string, Promise<SubscriptionUsageReading>>
+>();
+
+export function readScopedSubscriptionUsage(
+  service: IProviderSettingsService,
+  scope: SubscriptionUsageScope,
+  force: boolean,
+): Promise<SubscriptionUsageReading> {
+  let requests = inFlight.get(service);
+  if (!requests) inFlight.set(service, (requests = new Map()));
+  const key = JSON.stringify([scope.providerId, scope.revision, scope.accountId ?? null]);
+  const pending = requests.get(key);
+  if (pending) return pending;
+  const request = Promise.resolve().then(() =>
+    readProviderSettings(() =>
+      service.getSubscriptionUsage(scope.providerId, force, scope.accountId),
+    ),
+  );
+  requests.set(key, request);
+  void request
+    .finally(() => {
+      if (requests.get(key) === request) requests.delete(key);
+    })
+    .catch(() => {});
+  return request;
+}
+
+export function subscriptionUsageMatchesScope(
+  result: SubscriptionUsageReading,
+  scope: SubscriptionUsageScope,
+): boolean {
+  // 指定账号时旧 Host 的无身份结果不能用于展示；默认账号保留旧 Host 的读取兼容。
+  if (scope.accountId !== undefined)
+    return result.accountId === scope.accountId && result.connectionRevision === scope.revision;
+  return result.connectionRevision === undefined || result.connectionRevision === scope.revision;
+}
+
+export function subscriptionUsageRefreshDelay(
+  result: SubscriptionUsageReading | undefined,
+  now: number,
+): number {
+  const deadline = result?.refreshAfter;
+  return typeof deadline === "number" && Number.isFinite(deadline) && deadline > now
+    ? Math.max(1_000, deadline - now)
+    : 60_000;
+}
+
+/** A changed owner revision means refresh the account list, not retry the same stale UI scope. */
+export function subscriptionUsageScopeChanged(
+  result: SubscriptionUsageReading,
+  scope: SubscriptionUsageScope,
+): boolean {
+  return (
+    (result.connectionRevision !== undefined && result.connectionRevision !== scope.revision) ||
+    (scope.accountId !== undefined &&
+      result.accountId !== undefined &&
+      result.accountId !== scope.accountId)
+  );
+}
diff --git a/packages/ui/src/settings/model-provider-section/useSubscriptionAccountList.ts b/packages/ui/src/settings/model-provider-section/useSubscriptionAccountList.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b134654a8656f6e70167dc5fb616b7dc8f297c2e
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/useSubscriptionAccountList.ts
@@ -0,0 +1,105 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { IProviderSettingsService } from "@zcode/services";
+import { readProviderSettings } from "@/lib/providerSettingsRead.js";
+import {
+  createSubscriptionAccountRequestGate,
+  expandedSubscriptionAccount,
+} from "./subscriptionAccountLifecycle.js";
+
+type Accounts = Awaited<ReturnType<IProviderSettingsService["getSubscriptionAccounts"]>>;
+interface SubscriptionAccountList {
+  accounts?: Accounts;
+  expandedId?: string | null;
+  expand(id: string | null): void;
+  invalidate(): void;
+  reload(): Promise<void>;
+  mutate(
+    operation: (read: () => Promise<Accounts>) => Promise<{ value: Accounts; expand?: string }>,
+  ): Promise<boolean>;
+}
+
+export function useSubscriptionAccountList(
+  service: IProviderSettingsService,
+  providerId: string,
+  onRevision: (revision: string) => void,
+  onError: (error: unknown) => void,
+): SubscriptionAccountList {
+  const scope = useMemo(
+    () => ({ service, providerId, gate: createSubscriptionAccountRequestGate() }),
+    [service, providerId],
+  );
+  const [state, setState] = useState<{ scope: typeof scope; value: Accounts }>();
+  const currentScope = useRef(scope);
+  currentScope.current = scope;
+  const [expansion, setExpansion] = useState<{ scope: typeof scope; id: string | null }>();
+  const callbacks = useRef({ onRevision, onError });
+  callbacks.current = { onRevision, onError };
+  const publish = useCallback(
+    (value: Accounts, preferred?: string) => {
+      if (currentScope.current !== scope) return;
+      setState({ scope, value });
+      setExpansion((previous) => ({
+        scope,
+        id: expandedSubscriptionAccount(
+          value.accounts,
+          previous?.scope === scope ? previous.id : undefined,
+          preferred,
+        ),
+      }));
+      callbacks.current.onRevision(value.revision);
+    },
+    [scope],
+  );
+  const read = useCallback(
+    () => readProviderSettings(() => service.getSubscriptionAccounts(providerId)),
+    [service, providerId],
+  );
+  const reload = useCallback(async () => {
+    const ticket = scope.gate.beginRead();
+    if (ticket === undefined) return;
+    try {
+      const value = await read();
+      if (scope.gate.current(ticket)) publish(value);
+    } catch (error) {
+      if (currentScope.current === scope && scope.gate.current(ticket))
+        callbacks.current.onError(error);
+    }
+  }, [scope, read, publish]);
+  const mutate = useCallback(
+    async (
+      operation: (read: () => Promise<Accounts>) => Promise<{ value: Accounts; expand?: string }>,
+    ) => {
+      const ticket = scope.gate.beginWrite();
+      if (ticket === undefined) return false;
+      try {
+        const { value, expand } = await operation(read);
+        if (currentScope.current !== scope || !scope.gate.current(ticket)) return false;
+        publish(value, expand);
+        return true;
+      } catch (error) {
+        if (currentScope.current === scope && scope.gate.current(ticket)) throw error;
+        return false;
+      } finally {
+        if (scope.gate.finishWrite(ticket)) void reload();
+      }
+    },
+    [scope, read, publish, reload],
+  );
+  useEffect(() => {
+    scope.gate.activate();
+    void reload();
+    const subscription = service.onDidChange(() => void reload());
+    return () => {
+      scope.gate.deactivate();
+      subscription.dispose();
+    };
+  }, [scope, reload, service]);
+  return {
+    accounts: state?.scope === scope ? state.value : undefined,
+    expandedId: expansion?.scope === scope ? expansion.id : undefined,
+    expand: (id: string | null) => setExpansion({ scope, id }),
+    invalidate: () => scope.gate.invalidate(),
+    reload,
+    mutate,
+  };
+}
