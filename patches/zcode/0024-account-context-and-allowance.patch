diff --git a/packages/ui/src/chat-input-toolbar/ContextTokenDetails.tsx b/packages/ui/src/chat-input-toolbar/ContextTokenDetails.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f20c6407fd27153446c8ac622865ec74734c8b7c
--- /dev/null
+++ b/packages/ui/src/chat-input-toolbar/ContextTokenDetails.tsx
@@ -0,0 +1,57 @@
+import type { SessionUsageState } from "@zcode/shared/zcode-protocol-v4";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+/** Provider counters describe consumption; cache and reasoning are subsets, not extra totals. */
+export function ContextTokenDetails({ usage }: { usage?: SessionUsageState }) {
+  const { intl, locale } = useZCodeIntl();
+  if (!usage) return null;
+  const last = usage.lastRequest;
+  const total = usage.cumulative.inputTokens + usage.cumulative.outputTokens;
+  if (!last && total <= 0) return null;
+  const count = (value?: number) =>
+    typeof value === "number" && Number.isFinite(value) && value >= 0
+      ? new Intl.NumberFormat(locale).format(value)
+      : "—";
+  const rows = last
+    ? ([
+        ["input", last.inputTokens],
+        ["cacheRead", last.cacheReadTokens],
+        ["cacheWrite", last.cacheWriteTokens],
+        ["output", last.outputTokens],
+        ["reasoning", last.reasoningTokens],
+      ] as const)
+    : [];
+  return (
+    <section className="space-y-2 border-t border-border pt-3">
+      {last ? (
+        <>
+          <div className="flex items-center justify-between gap-3 text-ui-base font-medium">
+            <span>{intl.formatMessage({ id: "chat.tokens.lastRequest" })}</span>
+            <span className="text-ui-sm font-normal text-foreground-subtle">Tokens</span>
+          </div>
+          {last.modelId ? (
+            <div className="truncate text-ui-sm text-foreground-subtle" title={last.modelId}>
+              {last.modelId}
+            </div>
+          ) : null}
+          <dl className="space-y-1.5">
+            {rows.map(([key, value]) => (
+              <div key={key} className="flex items-center justify-between gap-3 text-ui-sm">
+                <dt className="text-foreground-subtle">
+                  {intl.formatMessage({ id: `chat.tokens.${key}` })}
+                </dt>
+                <dd className="font-mono tabular-nums">{count(value)}</dd>
+              </div>
+            ))}
+          </dl>
+        </>
+      ) : null}
+      <div className="flex items-center justify-between gap-3 border-t border-border pt-2 text-ui-sm">
+        <span className="text-foreground-subtle">
+          {intl.formatMessage({ id: "chat.tokens.cumulative" })}
+        </span>
+        <span className="font-mono tabular-nums">{count(total)}</span>
+      </div>
+    </section>
+  );
+}
diff --git a/packages/ui/src/chat-input-toolbar/ConversationSubscriptionUsage.tsx b/packages/ui/src/chat-input-toolbar/ConversationSubscriptionUsage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a53402bb860256754d56c08c4eb96688814cb407
--- /dev/null
+++ b/packages/ui/src/chat-input-toolbar/ConversationSubscriptionUsage.tsx
@@ -0,0 +1,210 @@
+import { useEffect, useState, type ComponentProps } from "react";
+import type { IProviderSettingsService } from "@zcode/services";
+import { Button } from "@/components/ui/button.js";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select.js";
+import { useServices } from "@/hooks/useServices.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { readProviderSettings } from "@/lib/providerSettingsRead.js";
+import {
+  setPendingSettingsSectionIntent,
+  setPendingSettingsUsageIntent,
+} from "@/lib/settingsNavigation.js";
+import { subscriptionAccountDisplayLabel } from "@/settings/model-provider-section/subscriptionAccountLifecycle.js";
+import { SubscriptionUsageSection } from "@/settings/model-provider-section/SubscriptionUsageSection.js";
+import { useTabStore } from "@/store/TabStoreProvider.js";
+
+export interface ConversationSubscriptionConnection {
+  providerId: string;
+  name: string;
+  kind: ComponentProps<typeof SubscriptionUsageSection>["kind"];
+  revision: number;
+}
+type Accounts = Awaited<ReturnType<IProviderSettingsService["getSubscriptionAccounts"]>>;
+
+/** Read-only account inspection: selecting this filter never changes the inference account. */
+export function ConversationSubscriptionUsage({
+  connection,
+  open,
+  onPickerOpenChange,
+  onNavigate,
+}: {
+  connection: ConversationSubscriptionConnection;
+  open: boolean;
+  onPickerOpenChange(open: boolean): void;
+  onNavigate(): void;
+}) {
+  const { providerSettingsService } = useServices();
+  const { intl } = useZCodeIntl();
+  const openSettings = useTabStore((state) => state.openSettingsTab);
+  const scope = `${connection.providerId}:${connection.revision}`;
+  const [state, setState] = useState<{
+    service: IProviderSettingsService;
+    scope: string;
+    accounts?: Accounts;
+    failed?: boolean;
+  }>();
+  const [choice, setChoice] = useState<{
+    scope: string;
+    accountId: string;
+    service: IProviderSettingsService;
+  }>();
+  const [retry, setRetry] = useState(0);
+  const scoped =
+    state?.service === providerSettingsService && state.scope === scope ? state : undefined;
+  const accounts = scoped?.accounts;
+  const selected =
+    accounts?.accounts.find(
+      (account) =>
+        choice?.service === providerSettingsService &&
+        choice.scope === scope &&
+        choice.accountId === account.id,
+    ) ??
+    accounts?.accounts.find((account) => account.active) ??
+    accounts?.accounts[0];
+
+  useEffect(() => {
+    if (!open) return;
+    let active = true;
+    let pending = false;
+    const read = async () => {
+      if (pending || document.hidden) return;
+      pending = true;
+      try {
+        const view = await readProviderSettings(() =>
+          providerSettingsService.getSubscriptionAccounts(connection.providerId),
+        );
+        if (active) setState({ service: providerSettingsService, scope, accounts: view });
+      } catch {
+        if (active) setState({ service: providerSettingsService, scope, failed: true });
+      } finally {
+        pending = false;
+      }
+    };
+    void read();
+    // 只在当前弹层打开时重读本地账号目录，切页或换 Host 的旧结果不能进入此处。
+    const timer = setInterval(() => void read(), 60_000);
+    const onVisible = () => {
+      if (!document.hidden) void read();
+    };
+    document.addEventListener("visibilitychange", onVisible);
+    window.addEventListener("online", onVisible);
+    return () => {
+      active = false;
+      clearInterval(timer);
+      document.removeEventListener("visibilitychange", onVisible);
+      window.removeEventListener("online", onVisible);
+    };
+  }, [open, connection.providerId, providerSettingsService, scope, retry]);
+  const accountLabel = (account: Accounts["accounts"][number], index: number) => {
+    const label = subscriptionAccountDisplayLabel(
+      accounts?.accounts ?? [],
+      account,
+      intl.formatMessage(
+        { id: "settings.modelProvider.credentials.accountNumber" },
+        { number: index + 1 },
+      ),
+    );
+    return account.active
+      ? `${label} · ${intl.formatMessage({ id: "settings.modelProvider.credentials.default" })}`
+      : label;
+  };
+
+  return (
+    <section
+      className="space-y-2"
+      aria-label={intl.formatMessage({ id: "settings.modelProvider.allowance.title" })}
+    >
+      {selected && accounts ? (
+        <>
+          <SubscriptionUsageSection
+            providerId={connection.providerId}
+            revision={accounts.revision}
+            kind={connection.kind}
+            accountId={selected.id}
+            enabled={open}
+            compact
+            condensed
+            accountControl={
+              accounts.accounts.length > 1 ? (
+                <Select
+                  value={selected.id}
+                  onValueChange={(accountId) =>
+                    setChoice({ scope, accountId, service: providerSettingsService })
+                  }
+                  onOpenChange={onPickerOpenChange}
+                >
+                  <SelectTrigger
+                    className="h-7 w-full border-0 bg-transparent px-0 text-ui-sm text-foreground-subtle shadow-none"
+                    aria-label={intl.formatMessage({ id: "chat.allowance.viewAccount" })}
+                  >
+                    <SelectValue />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {accounts.accounts.map((account, index) => (
+                      <SelectItem key={account.id} value={account.id}>
+                        {accountLabel(account, index)}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              ) : (
+                <div className="text-ui-sm text-foreground-subtle">{accountLabel(selected, 0)}</div>
+              )
+            }
+            showReset={false}
+            onScopeChanged={() => setRetry((value) => value + 1)}
+          />
+        </>
+      ) : (
+        <div className="text-ui-sm text-foreground-subtle" role="status">
+          {intl.formatMessage({
+            id: scoped?.failed
+              ? "settings.modelProvider.allowance.unavailable"
+              : accounts
+                ? "chat.allowance.noAccount"
+                : "settings.modelProvider.allowance.loading",
+          })}
+          {scoped?.failed ? (
+            <Button variant="ghost" size="sm" onClick={() => setRetry((value) => value + 1)}>
+              {intl.formatMessage({ id: "common.retry" })}
+            </Button>
+          ) : null}
+        </div>
+      )}
+      <div className="flex items-center justify-between gap-2">
+        <Button
+          variant="link"
+          size="sm"
+          className="h-auto p-0"
+          onClick={() => {
+            onNavigate();
+            setPendingSettingsSectionIntent("modelProvider", {
+              modelProviderId: connection.providerId,
+            });
+            openSettings();
+          }}
+        >
+          {intl.formatMessage({ id: "chat.allowance.manage" })}
+        </Button>
+        <Button
+          variant="link"
+          size="sm"
+          className="h-auto p-0"
+          onClick={() => {
+            onNavigate();
+            setPendingSettingsUsageIntent();
+            openSettings();
+          }}
+        >
+          {intl.formatMessage({ id: "sidebar.usage.plan.openStats" })}
+        </Button>
+      </div>
+    </section>
+  );
+}
