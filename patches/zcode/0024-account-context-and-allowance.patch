+/** Compare only credentials owned by the existing OAuth connection, without IO or migration. */
+export function isSameSubscriptionAccount(
+  kind: SubscriptionKind,
+  saved: OAuthCredential,
+  incoming: OAuthCredential,
+): boolean {
+  const sameRefresh = Boolean(identifier(saved.refresh) && saved.refresh === incoming.refresh);
+  if (kind === "github-copilot") return sameRefresh;
+  if (kind === "xai") {
+    const oldId = identifier(saved.accountId);
+    const newId = identifier(incoming.accountId);
+    return !conflicts(oldId, newId) && (Boolean(oldId && oldId === newId) || sameRefresh);
+  }
+  const a = codexIdentity(saved);
+  const b = codexIdentity(incoming);
+  // Codex account_id 是团队/工作区，不是成员 ID；仅按它去重会覆盖第二个团队成员。
+  if (
+    a.conflicting ||
+    b.conflicting ||
+    conflicts(a.workspace, b.workspace) ||
+    conflicts(a.member, b.member) ||
+    conflicts(a.user, b.user)
+  )
+    return false;
+  const sameMember =
+    Boolean(a.member && a.member === b.member) || Boolean(a.user && a.user === b.user);
+  return Boolean(a.workspace && a.workspace === b.workspace && sameMember) || sameRefresh;
+}
