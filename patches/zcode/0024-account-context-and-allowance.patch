@@ -0,0 +1,96 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ModelUsageRecord, ProjectId, SessionId } from "@zcode/contracts";
+import { SqliteSessionStore } from "../src/storage/session-store/sqlite-session-store.js";
+
+const FIXTURE_EPOCH = Date.now();
+
+async function fixture() {
+  const directory = await mkdtemp(join(tmpdir(), "fleet-usage-last-request-"));
+  const dbPath = join(directory, "session.sqlite");
+  let store = new SqliteSessionStore({ dbPath });
+  const sessionID = "session-fixture" as SessionId;
+  for (const id of [sessionID, "another-session" as SessionId]) {
+    await store.createSession({
+      id, projectID: "project-fixture" as ProjectId, slug: id,
+      directory, title: "Synthetic fixture", version: "fixture",
+    });
+  }
+  return {
+    async record(id: string, patch: Partial<ModelUsageRecord>) {
+      const input: ModelUsageRecord = {
+        id, logicalRequestId: id, sessionID, querySource: "main_turn",
+        providerId: "provider-fixture", modelId: "model-fixture", status: "completed",
+        startedAt: 100, completedAt: 200, ...patch,
+      };
+      // 通过真实写入 owner 保留既有 prune 行为，fixture 必须位于正常保留窗口内。
+      input.startedAt += FIXTURE_EPOCH;
+      if (input.completedAt !== undefined) input.completedAt += FIXTURE_EPOCH;
+      await store.recordModelUsage(input);
+    },
+    query: () => store.queryTaskUsage({ sessionID }),
+    reopen() { store.close(); store = new SqliteSessionStore({ dbPath }); },
+    async dispose() { store.close(); await rm(directory, { recursive: true, force: true }); },
+  };
+}
+
+test("SQLite reopen restores the last main request's raw counters, not aggregate columns or sidecars", async () => {
+  const f = await fixture();
+  try {
+    await f.record("main-completed-last", {
+      startedAt: 100, completedAt: 900, inputTokens: 777, outputTokens: 888,
+      rawUsage: { inputTokens: 0, outputTokens: 5, cacheReadTokens: 0, reasoningTokens: 3 },
+    });
+    await f.record("main-started-later", {
+      startedAt: 800, completedAt: 850, rawUsage: { inputTokens: 999 },
+    });
+    await f.record("sidecar-later", {
+      querySource: "session_title", startedAt: 1000, completedAt: 1100,
+      rawUsage: { inputTokens: 444 },
+    });
+    await f.record("other-session", {
+      sessionID: "another-session" as SessionId, startedAt: 2000, completedAt: 2100,
+      rawUsage: { inputTokens: 333 },
+    });
+    const before = await f.query();
+    f.reopen();
+    const after = await f.query();
+    assert.deepEqual(after, before, "reopen must retain existing aggregate results too");
+    assert.deepEqual(after.lastRequest, {
+      providerId: "provider-fixture", modelId: "model-fixture", observedAt: FIXTURE_EPOCH + 900,
+      inputTokens: 0, outputTokens: 5, cacheReadTokens: 0, reasoningTokens: 3,
+    });
+    assert.deepEqual(after.cumulativeMainUsage, { inputTokens: 999, outputTokens: 5, cacheReadTokens: 0, cacheWriteTokens: 0 }, "only raw main-turn counters, never sidecars or zero-coerced columns");
+  } finally { await f.dispose(); }
+});
+
+test("new errors and missing/invalid raw usage supersede older known counters after reopen", async () => {
+  const f = await fixture();
+  try {
+    await f.record("known", { rawUsage: { inputTokens: 50, outputTokens: 20 } });
+    await f.record("error", {
+      status: "error", startedAt: 300, completedAt: 400,
+      inputTokens: 123, outputTokens: 456,
+    });
+    f.reopen();
+    assert.deepEqual((await f.query()).lastRequest, {
+      providerId: "provider-fixture", modelId: "model-fixture", observedAt: FIXTURE_EPOCH + 400,
+    });
+    await f.record("partial", {
+      startedAt: 500, completedAt: 600,
+      rawUsage: { inputTokens: -1, outputTokens: "20", cacheReadTokens: null, cacheWriteTokens: 0, reasoningTokens: Infinity },
+    });
+    f.reopen();
+    assert.deepEqual((await f.query()).lastRequest, {
+      providerId: "provider-fixture", modelId: "model-fixture", observedAt: FIXTURE_EPOCH + 600, cacheWriteTokens: 0,
+    });
+    await f.record("missing", { startedAt: 700, completedAt: undefined, rawUsage: "not a usage object" });
+    f.reopen();
+    assert.deepEqual((await f.query()).lastRequest, {
+      providerId: "provider-fixture", modelId: "model-fixture", observedAt: FIXTURE_EPOCH + 700,
+    });
+  } finally { await f.dispose(); }
+});
