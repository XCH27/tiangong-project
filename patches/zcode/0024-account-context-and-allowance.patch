@@ -0,0 +1,103 @@
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+import type { SubscriptionKind } from "./subscriptionConnectionTypes.js";
+
+const AUTH_CLAIM = "https://api.openai.com/auth";
+function identifier(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 && value.trim() === value
+    ? value
+    : undefined;
+}
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+function authClaims(token: unknown): Record<string, unknown> | undefined {
+  if (typeof token !== "string" || token.length > 65_536) return undefined;
+  const parts = token.split(".");
+  if (parts.length !== 3 || parts.some((part) => !part)) return undefined;
+  try {
+    const payload = record(JSON.parse(Buffer.from(parts[1]!, "base64url").toString("utf8")));
+    return record(payload?.[AUTH_CLAIM]);
+  } catch {
+    return undefined;
+  }
+}
+/** Existing OAuth exchange metadata only; decoding does not authenticate a new credential. */
+export function subscriptionActiveUntil(credential: OAuthCredential): number | undefined {
+  const dates = [credential.access, credential.idToken, credential.id_token]
+    .map(authClaims)
+    .filter((claim) => claim?.chatgpt_account_id === credential.accountId)
+    .map((claim) => claim?.chatgpt_subscription_active_until)
+    .filter(
+      (value): value is string =>
+        typeof value === "string" && /^\d{4}-\d{2}-\d{2}T.+(?:Z|[+-]\d{2}:\d{2})$/.test(value),
+    )
+    .map(Date.parse)
+    .filter((value) => Number.isFinite(value) && value > 0);
