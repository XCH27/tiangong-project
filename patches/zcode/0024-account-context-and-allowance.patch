new file mode 100644
index 0000000000000000000000000000000000000000..47130f2a49a72c291d7cf3bbfb7b09bd8a5a2fde
--- /dev/null
+++ b/packages/services/src/model-provider/subscriptionCatalogCache.ts
@@ -0,0 +1,89 @@
+import { createHash } from "node:crypto";
+import type { ModelDiscoveryResult } from "./modelDiscovery.js";
+import type { SavedConnection, SubscriptionKind } from "./subscriptionConnectionTypes.js";
+import { readNativeSubscriptionCatalog } from "./subscriptionCatalog.js";
+
+type Account = NonNullable<SavedConnection["accounts"]>[number];
+type NativeKind = "openai-codex" | "xai";
+const CATALOG_TTL_MS = 60_000;
+function identity(kind: NativeKind, saved: SavedConnection, account: Account): string {
+  return JSON.stringify([
+    kind,
+    saved.revision,
+    account.id,
+    createHash("sha256").update(JSON.stringify(account.credential)).digest("hex"),
+  ]);
+}
+
+// 仅缓存当前凭据取得的目录；配置行或另一个账号的缓存不能证明模型可用。
+export function createSubscriptionCatalogReader(options: {
+  now(): number;
+  fetch: typeof fetch;
+  load(id: string, kind: SubscriptionKind): Promise<SavedConnection | undefined>;
+  getKind(id: string): Promise<SubscriptionKind>;
+}) {
+  const entries = new Map<
+    string,
+    {
+      providerId: string;
+      identity: string;
+      expiresAt: number;
+      value?: ModelDiscoveryResult;
+      pending?: Promise<ModelDiscoveryResult>;
+    }
+  >();
+  return {
+    invalidate(id: string) {
+      for (const [key, entry] of entries) if (entry.providerId === id) entries.delete(key);
+    },
+    async read(
+      id: string,
+      kind: NativeKind,
+      saved: SavedConnection,
+      account: Account,
+      refresh = false,
+    ): Promise<ModelDiscoveryResult> {
+      const key = JSON.stringify([id, account.id]);
+      const captured = identity(kind, saved, account);
+      let entry = entries.get(key);
+      if (entry?.identity !== captured) {
+        entry = { providerId: id, identity: captured, expiresAt: 0 };
+        entries.set(key, entry);
+      }
+      const assertCurrent = async () => {
+        const current = await options.load(id, kind);
+        const selected = current?.accounts?.find((a) => a.id === account.id);
+        if (
+          !current ||
+          !selected ||
+          entries.get(key) !== entry ||
+          (await options.getKind(id)) !== kind ||
+          identity(kind, current, selected) !== captured
+        )
+          throw new Error("Subscription account changed; reload its model list");
+      };
+      if (entry.pending) return entry.pending;
+      if (!refresh && entry.value && entry.expiresAt > options.now()) {
+        await assertCurrent();
+        return entry.value;
+      }
+      const request = (async () => {
+        const catalog = await readNativeSubscriptionCatalog(
+          kind,
+          account.credential,
+          options.fetch,
+        );
+        await assertCurrent();
+        entry.value = catalog;
+        entry.expiresAt = options.now() + CATALOG_TTL_MS;
+        return catalog;
+      })();
+      entry.pending = request;
+      try {
+        return await request;
+      } finally {
+        if (entry.pending === request) entry.pending = undefined;
+      }
+    },
+  };
+}
