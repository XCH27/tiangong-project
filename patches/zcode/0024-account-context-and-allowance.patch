+  const result: NonNullable<TaskUsageQueryResult["lastRequest"]> = {
+    ...(row.provider_id?.trim() ? { providerId: row.provider_id } : {}),
+    ...(row.model_id?.trim() ? { modelId: row.model_id } : {}),
   };
+  const observedAt = row.completed_at ?? row.started_at;
+  if (typeof observedAt === "number" && Number.isFinite(observedAt) && observedAt >= 0)
+    result.observedAt = observedAt;
+  const raw = parseReportedUsage(row.raw_usage_json);
+  // 整数列把 missing 归零，不能证明实报。最新失败/空报告也不能回退到更早成功请求。
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return result;
+  for (const key of ["inputTokens", "outputTokens", "cacheReadTokens", "cacheWriteTokens", "reasoningTokens"] as const) {
+    const value = (raw as Record<string, unknown>)[key];
+    if (typeof value === "number" && Number.isFinite(value) && value >= 0) result[key] = value;
+  }
+  return result;
+}
+
+function parseReportedUsage(value: string | null): Record<string, unknown> | undefined {
+  try {
+    const raw: unknown = value ? JSON.parse(value) : undefined;
+    return raw && typeof raw === "object" && !Array.isArray(raw) ? raw as Record<string, unknown> : undefined;
+  } catch { return undefined; }
 }
 
