diff --git a/packages/ui/src/hooks/useSubscriptionUsage.ts b/packages/ui/src/hooks/useSubscriptionUsage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0b7f50a5136e99b9632d5e3d0d82d89efc2b1ce2
--- /dev/null
+++ b/packages/ui/src/hooks/useSubscriptionUsage.ts
@@ -0,0 +1,165 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { useServices } from "./useServices.js";
+import {
+  readScopedSubscriptionUsage,
+  subscriptionUsageMatchesScope,
+  subscriptionUsageScopeChanged,
+  subscriptionUsageRefreshDelay,
+  type SubscriptionUsageReading,
+  type SubscriptionUsageScope,
+} from "../settings/model-provider-section/subscriptionUsageLifecycle.js";
+
+function canReadSubscriptionUsage(): boolean {
+  return (
+    (typeof document === "undefined" || document.visibilityState !== "hidden") &&
+    (typeof navigator === "undefined" || navigator.onLine !== false)
+  );
+}
+
+interface SubscriptionUsageView {
+  result?: SubscriptionUsageReading;
+  busy: boolean;
+  paused: boolean;
+  refresh: (force?: boolean) => Promise<SubscriptionUsageReading | undefined>;
+  now: number;
+}
+
+export function useSubscriptionUsage({
+  providerId,
+  revision,
+  accountId,
+  enabled = true,
+  onScopeChanged,
+}: SubscriptionUsageScope & {
+  enabled?: boolean;
+  onScopeChanged?: () => void;
+}): SubscriptionUsageView {
+  const { providerSettingsService } = useServices();
+  const scope = useMemo(
+    () => ({ service: providerSettingsService, providerId, revision, accountId }),
+    [providerSettingsService, providerId, revision, accountId],
+  );
+  const [active, setActive] = useState(canReadSubscriptionUsage);
+  const [now, setNow] = useState(Date.now);
+  const [state, setState] = useState<{
+    scope: typeof scope;
+    result?: SubscriptionUsageReading;
+    busy: boolean;
+  }>();
+  const generation = useRef(0);
+  const scopeChangeCallback = useRef(onScopeChanged);
+  scopeChangeCallback.current = onScopeChanged;
+  const synchronizedScope = useRef<typeof scope | undefined>(undefined);
+  const pending = useRef<Promise<SubscriptionUsageReading | undefined> | undefined>(undefined);
+  // 在 effect 清理之前也按完整身份筛选，切账号/Host 的首帧不闪现上一账号额度。
+  const result = state?.scope === scope ? state.result : undefined;
+  const readable = enabled && active;
+
+  const refresh = useCallback(
+    (force = false): Promise<SubscriptionUsageReading | undefined> => {
+      if (!readable || !canReadSubscriptionUsage()) return Promise.resolve(undefined);
+      if (pending.current) return pending.current;
+      const version = generation.current;
+      setState((previous) => ({
+        scope,
+        result: previous?.scope === scope ? previous.result : undefined,
+        busy: true,
+      }));
+      const request = readScopedSubscriptionUsage(scope.service, scope, force)
+        .then((value) => {
+          if (version !== generation.current) return undefined;
+          const accepted = subscriptionUsageMatchesScope(value, scope)
+            ? value
+            : { status: "unavailable" as const, refreshAfter: Date.now() + 60_000 };
+          setState({ scope, result: accepted, busy: false });
+          // 授权可只改变账号 revision 而不产生 Registry 事件。只重读一次账号目录，
+          // 不能反复拿旧 revision 查询并把有效账号误显示为“额度不可用”。
+          if (subscriptionUsageScopeChanged(value, scope) && synchronizedScope.current !== scope) {
+            synchronizedScope.current = scope;
+            scopeChangeCallback.current?.();
+          }
+          return accepted;
+        })
+        .catch(() => {
+          if (version !== generation.current) return undefined;
+          setState((previous) => ({
+            scope,
+            busy: false,
+            result:
+              previous?.scope === scope && previous.result?.status === "available"
+                ? {
+                    ...previous.result,
+                    refreshError: "unavailable",
+                    refreshAfter: Date.now() + 60_000,
+                  }
+                : { status: "unavailable", refreshAfter: Date.now() + 60_000 },
+          }));
+          return undefined;
+        })
+        .finally(() => {
+          if (version === generation.current) {
+            pending.current = undefined;
+            setNow(Date.now());
+          }
+        });
+      pending.current = request;
+      return request;
+    },
+    [readable, scope],
+  );
+
+  useEffect(() => {
+    const update = () => {
+      setActive(canReadSubscriptionUsage());
+      setNow(Date.now());
+    };
+    document.addEventListener("visibilitychange", update);
+    window.addEventListener("online", update);
+    window.addEventListener("offline", update);
+    return () => {
+      document.removeEventListener("visibilitychange", update);
+      window.removeEventListener("online", update);
+      window.removeEventListener("offline", update);
+    };
+  }, []);
+
+  useEffect(() => {
+    generation.current++;
+    pending.current = undefined;
+    if (readable) void refresh();
+    return () => {
+      generation.current++;
+      pending.current = undefined;
+    };
+  }, [readable, refresh]);
+
+  useEffect(() => {
+    if (!readable || state?.scope !== scope || state.busy) return;
+    const timer = setTimeout(
+      () => void refresh(),
+      subscriptionUsageRefreshDelay(result, Date.now()),
+    );
+    return () => clearTimeout(timer);
+  }, [readable, refresh, result, scope, state]);
+
+  useEffect(() => {
+    if (!readable || result?.status !== "available") return;
+    const resetAt = Math.min(
+      ...result.windows
+        .map((window) => window.resetAt ?? Infinity)
+        .filter((value) => Number.isFinite(value) && value > now),
+    );
+    if (!Number.isFinite(resetAt)) return;
+    // 到期只更新陈旧标记，不把旧百分比改成零，也不额外发起模型或额度请求。
+    const timer = setTimeout(() => setNow(Date.now()), Math.min(resetAt - now, 2_147_483_647));
+    return () => clearTimeout(timer);
+  }, [readable, result, now]);
+
+  return {
+    result,
+    paused: !active,
+    busy: readable && state?.scope === scope && state.busy,
+    refresh,
+    now,
+  };
+}
