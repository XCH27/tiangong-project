+function codexIdentity(credential: OAuthCredential) {
+  // 只解析已有 OAuth 交换返回的凭据，不把 JWT 解码当作认证，也不从显示邮箱推断身份。
+  const claims = [credential.access, credential.idToken, credential.id_token]
+    .map(authClaims)
+    .filter((value): value is Record<string, unknown> => value !== undefined);
+  const workspaces = new Set(
+    [
+      identifier(credential.accountId),
+      ...claims.map((claim) => identifier(claim.chatgpt_account_id)),
+    ].filter((value): value is string => value !== undefined),
+  );
+  const workspace = workspaces.values().next().value;
+  const scoped = claims.filter(
+    (claim) => workspace && identifier(claim.chatgpt_account_id) === workspace,
+  );
+  const members = new Set(
+    scoped
+      .map((claim) => identifier(claim.chatgpt_account_user_id))
+      .filter((value): value is string => value !== undefined),
+  );
+  const users = new Set(
+    scoped
+      .map((claim) => identifier(claim.chatgpt_user_id) ?? identifier(claim.user_id))
+      .filter((value): value is string => value !== undefined),
+  );
+  return {
+    workspace,
+    member: members.values().next().value,
+    user: users.values().next().value,
+    conflicting: workspaces.size > 1 || members.size > 1 || users.size > 1,
+  };
+}
+const conflicts = (a: string | undefined, b: string | undefined) =>
+  a !== undefined && b !== undefined && a !== b;
