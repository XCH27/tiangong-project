diff --git a/packages/services/test/subscription-login-interaction.test.ts b/packages/services/test/subscription-login-interaction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d31ed172aa1b4c8c6b21f8efe19dcc199c46b02b
--- /dev/null
+++ b/packages/services/test/subscription-login-interaction.test.ts
@@ -0,0 +1,82 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { subscriptionLoginInteraction } from "../src/model-provider/subscriptionLoginInteraction.js";
+import type { SubscriptionLogin } from "../src/model-provider/subscriptionConnectionTypes.js";
+
+const authorization = new URL("https://auth.openai.com/oauth/authorize");
+for (const [key, value] of Object.entries({
+  response_type: "code",
+  client_id: "synthetic-client",
+  redirect_uri: "http://localhost:1455/auth/callback",
+  scope: "openid profile email offline_access",
+  state: "synthetic+state/=",
+  code_challenge: "synthetic-pkce",
+  code_challenge_method: "S256",
+  id_token_add_organizations: "true",
+  codex_cli_simplified_flow: "true",
+}))
+  authorization.searchParams.set(key, value);
+
+function fixture(forceLogin?: boolean) {
+  const controller = new AbortController();
+  let login: SubscriptionLogin | undefined;
+  const bridge = subscriptionLoginInteraction({
+    kind: "openai-codex",
+    method: "browser",
+    flowId: "synthetic-flow",
+    signal: controller.signal,
+    forceLogin,
+    notify: (value) => {
+      login = value;
+    },
+  });
+  return { bridge, controller, login: () => login };
+}
+
+test("adding a Codex account requests fresh login while preserving the original OAuth binding", () => {
+  const f = fixture(true);
+  f.bridge.interaction.notify({ type: "auth_url", url: authorization.href });
+  const result = new URL(f.login()!.verificationUrl);
+  assert.equal(result.searchParams.get("prompt"), "login");
+  for (const [key, value] of authorization.searchParams)
+    assert.equal(result.searchParams.get(key), value);
+  assert.equal(result.origin, authorization.origin);
+  assert.equal(result.pathname, authorization.pathname);
+  assert.equal(f.login()?.flowId, "synthetic-flow");
+});
+
+test("first login preserves the driver URL and forced login still validates the original callback state", async () => {
+  const first = fixture();
+  first.bridge.interaction.notify({ type: "auth_url", url: authorization.href });
+  assert.equal(first.login()?.verificationUrl, authorization.href);
+  const f = fixture(true);
+  f.bridge.interaction.notify({ type: "auth_url", url: authorization.href });
+  const prompt = f.bridge.interaction.prompt({
+    type: "manual_code",
+    message: "Callback",
+    signal: f.controller.signal,
+  });
+  assert.throws(() =>
+    f.bridge.submit("http://localhost:1455/auth/callback?state=wrong&code=synthetic"),
+  );
+  const callback = new URL("http://localhost:1455/auth/callback");
+  callback.searchParams.set("state", authorization.searchParams.get("state")!);
+  callback.searchParams.set("code", "synthetic-code");
+  f.bridge.submit(callback.href);
+  assert.equal(await prompt, callback.href);
+});
+
+test("cancelling forced login retires the pending callback instead of accepting a late account", async () => {
+  const f = fixture(true);
+  f.bridge.interaction.notify({ type: "auth_url", url: authorization.href });
+  const prompt = f.bridge.interaction.prompt({
+    type: "manual_code",
+    message: "Callback",
+    signal: f.controller.signal,
+  });
+  f.controller.abort();
+  await assert.rejects(prompt);
+  assert.throws(() =>
+    f.bridge.submit("http://localhost:1455/auth/callback?state=synthetic&code=synthetic"),
+  );
+});
