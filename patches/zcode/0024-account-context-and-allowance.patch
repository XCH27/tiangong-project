new file mode 100644
index 0000000000000000000000000000000000000000..724c4c35805401ddb2b6fcc5fd2da6c112a681c2
--- /dev/null
+++ b/packages/services/src/model-provider/codexSubscriptionMetadata.ts
@@ -0,0 +1,158 @@
+import type { OAuthCredential } from "@earendil-works/pi-ai";
+
+export interface SubscriptionMembership {
+  activeUntil: number;
+  renews?: boolean;
+  source: "authorization" | "subscription" | "account-entitlement";
+  observedAt?: number;
+  stale?: boolean;
+}
+export type CodexMembershipResult =
+  | { status: "available"; membership?: SubscriptionMembership; plan?: string }
+  | { status: "unavailable" };
+
+export function parseCodexMembership(
+  payload: unknown,
+  accountId: string,
+  now: number,
+): CodexMembershipResult {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload))
+    return { status: "unavailable" };
+  const body = payload as Record<string, unknown>;
+  const responseAccount = body.account_id ?? body.accountId;
+  if (responseAccount !== undefined && responseAccount !== accountId)
+    return { status: "unavailable" };
+  const raw = body.active_until ?? body.activeUntil;
+  const plan =
+    typeof body.subscription_plan === "string" && body.subscription_plan.length <= 128
+      ? body.subscription_plan
+      : undefined;
+  const renewal = body.will_renew ?? body.willRenew;
+  // null 是供应商明确未给有效期；缺字段/坏日期属于失败，不能覆盖先前有效读数。
+  if (body.active_until === null || body.activeUntil === null) return { status: "available", plan };
+  if (typeof raw !== "string" || !/^\d{4}-\d{2}-\d{2}T.+(?:Z|[+-]\d{2}:\d{2})$/.test(raw))
+    return { status: "unavailable" };
+  const activeUntil = Date.parse(raw);
+  if (!Number.isFinite(activeUntil) || activeUntil <= 0) return { status: "unavailable" };
+  return {
+    status: "available",
+    plan,
+    membership: {
+      activeUntil,
+      source: "subscription",
+      observedAt: now,
+      ...(typeof renewal === "boolean" ? { renews: renewal } : {}),
+    },
+  };
+}
+
+function object(value: unknown): Record<string, unknown> | undefined {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+export function parseCodexAccountMembership(
+  payload: unknown,
+  accountId: string,
+  now: number,
+): CodexMembershipResult {
+  const accounts = object(payload)?.accounts;
+  const records: [string | undefined, unknown][] = Array.isArray(accounts)
+    ? accounts.map((value) => [undefined, value])
+    : Object.entries(object(accounts) ?? {});
+  for (const [key, value] of records) {
+    const record = object(value);
+    const account = object(record?.account) ?? record;
+    if (!account) continue;
+    const id =
+      account.account_id ?? account.id ?? account.chatgpt_account_id ?? account.workspace_id ?? key;
+    if (id !== accountId) continue;
+    const entitlement = object(record?.entitlement);
+    const result = parseCodexMembership(
+      {
+        account_id: accountId,
+        subscription_plan: entitlement?.subscription_plan ?? account.plan_type,
+        active_until: entitlement?.expires_at ?? account.expires_at,
+      },
+      accountId,
+      now,
+    );
+    return result.status === "available" && result.membership
+      ? { ...result, membership: { ...result.membership, source: "account-entitlement" } }
+      : result;
+  }
+  // 不选“第一个付费账号”或默认组织，避免把其他团队的期限贴到当前账号。
+  return { status: "unavailable" };
+}
+
+/** Same authenticated account, bounded metadata reads; no cookie import or default-account fallback. */
+export async function readCodexMembership(
+  credential: OAuthCredential,
+  fetcher: typeof fetch,
+  now: () => number,
+): Promise<CodexMembershipResult> {
+  if (typeof credential.accountId !== "string" || !credential.accountId)
+    return { status: "unavailable" };
+  const accountId = credential.accountId;
+  const signal = AbortSignal.timeout(8_000);
+  const read = async (path: string): Promise<unknown> => {
+    const url = new URL(path, "https://chatgpt.com");
+    if (path.includes("/accounts/check/"))
+      url.searchParams.set("timezone_offset_min", String(new Date().getTimezoneOffset()));
+    else url.searchParams.set("account_id", accountId);
+    const response = await fetcher(url, {
+      method: "GET",
+      redirect: "error",
+      signal,
+      headers: {
+        Authorization: `Bearer ${credential.access}`,
+        Accept: "application/json",
+        "ChatGPT-Account-Id": accountId,
+        Referer: "https://chatgpt.com/",
+        "x-openai-target-path": path,
+        "x-openai-target-route": path,
+      },
+    });
+    if (!response.ok) {
+      await response.body?.cancel();
+      return undefined;
+    }
+    const reader = response.body?.getReader();
+    if (!reader) return undefined;
+    const chunks: Uint8Array[] = [];
+    let bytes = 0;
+    try {
+      for (;;) {
+        const part = await reader.read();
+        if (part.done) break;
+        bytes += part.value.byteLength;
+        if (bytes > 256 * 1024) {
+          await reader.cancel();
+          return undefined;
+        }
+        chunks.push(part.value);
+      }
+    } finally {
+      reader.releaseLock();
+    }
+    return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+  };
+  // 两个接口不互相依赖；共享总截止时间但独立收集结果，账号目录超时不能吞掉已成功的账单信息。
+  const [account, subscription] = await Promise.all([
+    read("/backend-api/accounts/check/v4-2023-04-27")
+      .then((value) => parseCodexAccountMembership(value, accountId, now()))
+      .catch(() => ({ status: "unavailable" as const })),
+    read("/backend-api/subscriptions")
+      .then((value) => parseCodexMembership(value, accountId, now()))
+      .catch(() => ({ status: "unavailable" as const })),
+  ]);
+  if (
+    account.status === "available" &&
+    account.membership &&
+    account.membership.activeUntil > now()
+  )
+    return account;
+  if (subscription.status === "available") return subscription;
+  return account;
+}
