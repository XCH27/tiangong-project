diff --git a/apps/zcode-cli/packages/core/test/subscription-turn-binding.test.ts b/apps/zcode-cli/packages/core/test/subscription-turn-binding.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..17753d05abdcfb0700e1feb339f93e62e1d8656a
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/subscription-turn-binding.test.ts
@@ -0,0 +1,50 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createRefreshRuntimeHeadersBeforeModelAttempt } from "../src/runtime/methods/model-runtime-headers.js";
+
+const request = { subscriptionAccess:{provider:"openai-codex" as const},attempt:0 };
+function fixture() {
+  let selected = "account-a";
+  const calls:string[]=[];
+  const runtime:any={sessionId:"session",activeTurn:{turnId:"turn-a"},providerRuntimeHeadersPort:{
+    async refreshBeforeModelRequest(input:any) {
+      const accountId=input.subscriptionAccess.accountId ?? selected;
+      calls.push(accountId);
+      return {headersApplied:true,requestAuth:{apiKey:"synthetic",credentialSelection:{accountId,revision:"revision"}}};
+    },
+  }};
+  const callback=(turnId="turn-a")=>createRefreshRuntimeHeadersBeforeModelAttempt(runtime,{model:{providerId:"provider",modelId:"model"} as any,traceContext:{turnId} as any})!;
+  return {runtime,calls,callback,select:(id:string)=>selected=id};
+}
+test("changing the default account affects the next turn, not later model calls of the active turn",async()=>{
+  const f=fixture();
+  await f.callback()(request);
+  f.select("account-b");
+  await f.callback()(request);
+  assert.deepEqual(f.calls,["account-a","account-a"]);
+  f.runtime.activeTurn={turnId:"turn-b"};
+  await f.callback("turn-b")(request);
+  assert.deepEqual(f.calls,["account-a","account-a","account-b"]);
+});
+test("a late credential reply cannot enter a replacement turn",async()=>{
+  const f=fixture();
+  const pending=Promise.withResolvers<any>();
+  f.runtime.providerRuntimeHeadersPort.refreshBeforeModelRequest=()=>pending.promise;
+  const result=f.callback()(request);
+  f.runtime.activeTurn={turnId:"turn-b"};
+  pending.resolve({headersApplied:true,requestAuth:{apiKey:"synthetic",credentialSelection:{accountId:"old-account",revision:"r"}}});
+  await assert.rejects(result,/turn changed/i);
+  assert.equal(f.runtime.activeTurn.subscriptionAccounts,undefined);
+});
+
+test("an admitted Guide renews affinity and rejects prior-submission credential replies", async () => {
+  const f = fixture();
+  await f.callback()(request);
+  const pending = Promise.withResolvers<any>();
+  f.runtime.providerRuntimeHeadersPort.refreshBeforeModelRequest = () => pending.promise;
+  const result = f.callback()(request);
+  f.runtime.activeTurn.subscriptionAccounts = new Map();
+  pending.resolve({headersApplied:true, requestAuth:{apiKey:"synthetic",credentialSelection:{accountId:"old-account",revision:"r"}}});
+  await assert.rejects(result, /turn changed/i);
+  assert.equal(f.runtime.activeTurn.subscriptionAccounts.size, 0);
+});
