diff --git a/apps/zcode-cli/packages/adapters/src/model/pi-transcript.ts b/apps/zcode-cli/packages/adapters/src/model/pi-transcript.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d9a1d776647c8a98d764fb7fef96b02edeff6a5f
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/pi-transcript.ts
@@ -0,0 +1,133 @@
+import type { AssistantMessage, Message, Model as PiModel, Usage } from "@earendil-works/pi-ai";
+import type { ModelInputMessage } from "@zcode/contracts";
+
+export interface SubscriptionReplayScope {
+  connectionId: string;
+  modelId: string;
+  accountId?: string;
+}
+
+const emptyUsage: Usage = {
+  input: 0,
+  output: 0,
+  cacheRead: 0,
+  cacheWrite: 0,
+  totalTokens: 0,
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+export function toPiMessage(
+  message: ModelInputMessage,
+  model: PiModel<string>,
+  connectionId: string,
+  scope: SubscriptionReplayScope,
+): Message {
+  const blocks =
+    typeof message.content === "string"
+      ? [{ type: "text" as const, text: message.content }]
+      : message.content;
+  const timestamp = 0; // Stable replay: history conversion must not change the cached prefix.
+  if (message.role === "assistant") {
+    const content: AssistantMessage["content"] = blocks.flatMap(
+      (block): AssistantMessage["content"] => {
+        if (block.type === "text") return [{ type: "text", text: block.text }];
+        if (block.type === "reasoning") {
+          const metadata = block.providerOptions?.pi as
+            | { signature?: string; redacted?: boolean; scope?: SubscriptionReplayScope }
+            | undefined;
+          // 签名和加密推理只属于生成它的账号/模型；跨边界保留可读文字，不重放不透明状态。
+          if (metadata?.scope?.connectionId !== scope.connectionId ||
+              metadata.scope.modelId !== scope.modelId || metadata.scope.accountId !== scope.accountId) {
+            return block.text && !metadata?.redacted ? [{ type: "text", text: block.text }] : [];
+          }
+          return [
+            {
+              type: "thinking",
+              thinking: block.text,
+              thinkingSignature: metadata?.signature,
+              redacted: metadata?.redacted,
+            },
+          ];
+        }
+        throw new Error(`Unsupported assistant history block: ${block.type}`);
+      },
+    );
+    for (const tool of message.toolCalls ?? [])
+      content.push({
+        type: "toolCall",
+        id: tool.id,
+        name: tool.name,
+        arguments: tool.input as Extract<
+          AssistantMessage["content"][number],
+          { type: "toolCall" }
+        >["arguments"],
+      });
+    return {
+      role: "assistant",
+      content,
+      api: model.api,
+      provider:
+        message.providerId === undefined || message.providerId === connectionId
+          ? model.provider
+          : message.providerId,
+      model: message.modelId ?? model.id,
+      usage: emptyUsage,
+      stopReason: message.toolCalls?.length ? "toolUse" : "stop",
+      timestamp,
+    };
+  }
+  const content = blocks.map((block) => {
+    if (block.type === "text") return { type: "text" as const, text: block.text };
+    if (block.type === "file" && block.text !== undefined)
+      return { type: "text" as const, text: block.text };
+    if (block.type === "image") {
+      const match = /^data:([^;,]+);base64,([\s\S]+)$/.exec(block.dataUrl);
+      if (!match) throw new Error("Subscription image input requires a base64 data URL");
+      return { type: "image" as const, data: match[2]!, mimeType: match[1]! };
+    }
+    throw new Error(
+      `Unsupported subscription input: ${block.type}; use extracted text or a compatible API connection`,
+    );
+  });
+  if (message.role === "system") {
+    if (content.some((block) => block.type !== "text"))
+      throw new Error("System instructions must be text");
+    return { role: "system", content: content.filter((block) => block.type === "text"), timestamp };
+  }
+  if (message.role === "tool")
+    return {
+      role: "toolResult",
+      toolCallId: message.toolCallId ?? "",
+      toolName: message.toolName ?? "",
+      content,
+      isError: message.isError ?? false,
+      timestamp,
+    };
+  return { role: "user", content, timestamp };
+}
+
+/** Rejected requests may replay portable history, never another account's opaque continuation. */
+export function portableSubscriptionPayload(value: Record<string, unknown>): Record<string, unknown> {
+  if (value.previous_response_id) throw new Error("Cannot move a server continuation between accounts");
+  const payload = structuredClone(value);
+  if (Array.isArray(payload.input)) {
+    payload.input = payload.input.flatMap((item) => {
+      if (item.type === "item_reference") throw new Error("Cannot move an opaque item reference between accounts");
+      if (item.type === "reasoning") {
+        const text = (item.summary ?? []).map((part: {text?:string}) => part.text ?? "").join("\n");
+        return text ? [{type:"message",role:"assistant",content:[{type:"output_text",text}]}] : [];
+      }
+      const { id: _id, ...portable } = item;
+      return [portable];
+    });
+  }
+  if (Array.isArray(payload.messages)) {
+    payload.messages = payload.messages.map((message) => ({...message,
+      ...(Array.isArray(message.content) ? {content:message.content.flatMap((block: Record<string,unknown>) => {
+        if (block.type === "redacted_thinking") return [];
+        if (block.type === "thinking") return block.thinking ? [{type:"text",text:block.thinking}] : [];
+        return [block];
+      })} : {}),
+    }));
+  }
+  return payload;
+}
