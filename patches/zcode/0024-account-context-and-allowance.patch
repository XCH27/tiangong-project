@@ -0,0 +1,98 @@
+import { ChevronDown, ChevronRight, Trash2 } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "@/components/ui/collapsible.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { CredentialDefaultControl } from "./ProviderDraftControls.js";
+import { SubscriptionUsageSection } from "./SubscriptionUsageSection.js";
+
+export function SubscriptionAccountRow({
+  account,
+  displayLabel,
+  index,
+  providerId,
+  revision,
+  kind,
+  open,
+  busy,
+  onOpenChange,
+  onDefault,
+  onRemove,
+  onScopeChanged,
+}: {
+  account: { id: string; label?: string; active: boolean };
+  displayLabel?: string;
+  index: number;
+  providerId: string;
+  revision: string;
+  kind: "openai-codex" | "github-copilot" | "xai";
+  open: boolean;
+  busy: boolean;
+  onOpenChange(open: boolean): void;
+  onDefault(): void;
+  onRemove(): void;
+  onScopeChanged(): void;
+}) {
+  const { intl } = useZCodeIntl();
+  const label =
+    displayLabel ||
+    account.label ||
+    intl.formatMessage(
+      { id: "settings.modelProvider.credentials.accountNumber" },
+      { number: index + 1 },
+    );
+  return (
+    <Collapsible open={open} onOpenChange={onOpenChange} role="group" aria-label={label}>
+      <div className="flex items-center gap-2 px-3 py-2">
+        <CollapsibleTrigger asChild>
+          <Button
+            type="button"
+            variant="ghost"
+            className="min-w-0 flex-1 justify-start px-0"
+            aria-label={intl.formatMessage(
+              { id: "settings.modelProvider.credentials.viewAccountAllowance" },
+              { account: label },
+            )}
+          >
+            {open ? (
+              <ChevronDown className="size-4 shrink-0" />
+            ) : (
+              <ChevronRight className="size-4 shrink-0" />
+            )}
+            <span className="min-w-0 truncate text-ui-base">{label}</span>
+          </Button>
+        </CollapsibleTrigger>
+        <CredentialDefaultControl selected={account.active} disabled={busy} onSelect={onDefault} />
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon-sm"
+          disabled={busy}
+          aria-label={intl.formatMessage({
+            id: "settings.modelProvider.credentials.removeAccount",
+          })}
+          onClick={onRemove}
+        >
+          <Trash2 className="size-4" />
+        </Button>
+      </div>
+      <CollapsibleContent>
+        <div className="px-3 pb-3">
+          <SubscriptionUsageSection
+            providerId={providerId}
+            revision={revision}
+            kind={kind}
+            accountId={account.id}
+            enabled={open}
+            compact
+            onScopeChanged={onScopeChanged}
+            showReset={account.active}
+          />
+        </div>
+      </CollapsibleContent>
+    </Collapsible>
+  );
+}
diff --git a/packages/ui/src/settings/model-provider-section/SubscriptionAllowanceDetails.tsx b/packages/ui/src/settings/model-provider-section/SubscriptionAllowanceDetails.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..47037cc0891da83476ce27e06cc0c57630a779b6
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/SubscriptionAllowanceDetails.tsx
@@ -0,0 +1,165 @@
+import type { ReactNode } from "react";
+import { cn } from "@/components/lib/utils.js";
+import { Progress } from "@/components/ui/progress.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import type { SubscriptionUsageReading } from "./subscriptionUsageLifecycle.js";
+
+/** ZCode's compact quota meters, with the provider's used value converted once to remaining. */
+export function SubscriptionAllowanceDetails({
+  result,
+  now,
+  resetControl,
+  showResetCount = false,
+  condensed = false,
+}: {
+  result: Extract<SubscriptionUsageReading, { status: "available" }>;
+  now: number;
+  resetControl?: ReactNode;
+  showResetCount?: boolean;
+  condensed?: boolean;
+}) {
+  const { intl, locale } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.allowance.${key}` });
+  const numberFormat = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
+  const dateFormat = new Intl.DateTimeFormat(locale, {
+    month: "short",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+  });
+  const activeUntil = result.membership?.activeUntil;
+  const days = activeUntil === undefined ? undefined : Math.ceil((activeUntil - now) / 86_400_000);
+  return (
+    <div className="@container space-y-2">
+      <div
+        className={cn(
+          "grid grid-cols-1 gap-x-4",
+          condensed ? "gap-y-2" : "gap-y-3 @sm:grid-cols-2",
+        )}
+      >
+        {result.windows.map((window) => {
+          const duration = window.windowMinutes
+            ? new Intl.NumberFormat(locale, {
+                style: "unit",
+                unit:
+                  window.windowMinutes >= 1440 && window.windowMinutes % 1440 === 0
+                    ? "day"
+                    : "hour",
+                unitDisplay: "short",
+                maximumFractionDigits: 1,
+              }).format(
+                window.windowMinutes /
+                  (window.windowMinutes >= 1440 && window.windowMinutes % 1440 === 0 ? 1440 : 60),
+              )
+            : undefined;
+          const label = window.id.startsWith("default:")
+            ? (duration ?? t("window"))
+            : `${window.id.split(":")[0]}${duration ? ` · ${duration}` : ""}`;
+          const remaining = window.usedPercent === undefined ? undefined : 100 - window.usedPercent;
+          const value = window.unlimited
+            ? t("unlimited")
+            : remaining === undefined
+              ? "—"
+              : intl.formatMessage(
+                  { id: "settings.modelProvider.allowance.remaining" },
+                  { percent: numberFormat.format(remaining) },
+                );
+          return (
+            <div key={window.id} className="min-w-0 space-y-1.5 text-ui-sm">
+              <div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
+                <span className="text-foreground-subtle">{label}</span>
+                <span
+                  className="tabular-nums"
+                  title={
+                    window.usedPercent === undefined
+                      ? undefined
+                      : intl.formatMessage(
+                          { id: "settings.modelProvider.allowance.used" },
+                          { percent: numberFormat.format(window.usedPercent) },
+                        )
+                  }
+                >
+                  {value}
+                  {condensed && window.resetAt ? (
+                    <span
+                      className="text-foreground-subtle"
+                      title={`${t("resets")} ${dateFormat.format(window.resetAt)}`}
+                    >
+                      {` · ${new Intl.DateTimeFormat(locale, (window.windowMinutes ?? Infinity) <= 1440 ? { hour: "numeric", minute: "2-digit" } : { month: "short", day: "numeric" }).format(window.resetAt)}`}
+                      {window.resetAt <= now ? ` · ${t("expired")}` : ""}
+                    </span>
+                  ) : null}
+                </span>
+              </div>
+              {remaining !== undefined && !window.unlimited ? (
+                <Progress
+                  value={remaining}
+                  indicatorClassName={condensed ? "bg-success" : undefined}
+                  aria-valuenow={remaining}
+                  aria-label={`${label} · ${value}`}
+                />
+              ) : null}
+              {window.resetAt && !condensed ? (
+                <p className="text-foreground-subtle">
+                  {t("resets")} {dateFormat.format(window.resetAt)}
+                  {window.resetAt <= now ? ` · ${t("expired")}` : ""}
+                </p>
+              ) : null}
+            </div>
+          );
+        })}
+      </div>
+      <div
+        className={cn(
+          "flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-ui-sm text-foreground-subtle",
+          !condensed && "border-t border-border pt-2",
+        )}
+      >
+        <span
+          title={
+            condensed && activeUntil !== undefined
+              ? dateFormat.format(activeUntil)
+              : activeUntil === undefined
+                ? t("membershipUnavailable")
+                : t(
+                    result.membership?.source !== "authorization"
+                      ? "membershipLiveSource"
+                      : "membershipSource",
+                  )
+          }
+        >
+          {days === undefined
+            ? t(result.membershipReadFailed ? "membershipReadFailed" : "membershipUnknown")
+            : days <= 0
+              ? t("membershipElapsed")
+              : intl.formatMessage(
+                  {
+                    id: result.membership?.renews
+                      ? "settings.modelProvider.allowance.membershipRenews"
+                      : "settings.modelProvider.allowance.membershipDays",
+                  },
+                  { days },
+                )}
+          {activeUntil !== undefined && !condensed ? ` · ${dateFormat.format(activeUntil)}` : ""}
+        </span>
+        {result.membership?.stale ? <span>{t("membershipStale")}</span> : null}
+        {!condensed ? (
+          <span title={result.source}>
+            {t("observed")} {dateFormat.format(result.observedAt)}
+          </span>
+        ) : null}
+        {showResetCount && result.resetsAvailable === 0 ? (
+          <span>
+            {intl.formatMessage({ id: "settings.modelProvider.reset.count" }, { count: 0 })}
+          </span>
+        ) : null}
+      </div>
+      {resetControl}
+      {result.refreshError ? (
+        <p role="status" className="text-ui-sm text-foreground-subtle">
+          {t("stale")}
+        </p>
+      ) : null}
+    </div>
+  );
+}
