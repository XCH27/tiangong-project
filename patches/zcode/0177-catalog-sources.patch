+import { readdirSync } from "node:fs";
+import { basename, join, relative, sep } from "node:path";
+import { readMarkdownFrontmatter } from "./markdown-frontmatter.js";
+
+/**
+ * Agent Skills repositories as a catalog (OV-100 phase 2).
+ *
+ * The Agent Skills specification defines what a skill folder contains, not a remote index
+ * (`agentskills/docs/client-implementation/adding-skills-support.mdx`); public skill collections
+ * are plain repositories of `SKILL.md` folders. When an added repository or folder has no
+ * marketplace manifest, each skill folder becomes a one-skill plugin entry (`strict: false`,
+ * `skills: ["./"]`) so it installs, updates and uninstalls through the plugin lifecycle.
+ */
+
+const SKILL_FILE = "SKILL.md";
+const MAX_DEPTH = 4;
+const SKIPPED_DIRECTORIES = new Set(["node_modules", "dist", "build", "__pycache__"]);
+// Skills are commonly kept under these hidden client folders; other dot folders are skipped.
+const SKILL_DOT_DIRECTORIES = new Set([".agents", ".claude", ".codex", ".zcode"]);
+
+export function synthesizeSkillsMarketplace(
+  root: string,
+  marketplaceName: string,
+  scanRoot: string = root,
+): { name: string; description: string; plugins: Record<string, unknown>[] } | null {
+  const folders: string[] = [];
+  collectSkillFolders(scanRoot, 0, folders);
+  if (folders.length === 0) return null;
+  const used = new Set<string>();
+  const plugins = folders.map((folder) => {
+    const frontmatter = readMarkdownFrontmatter(join(folder, SKILL_FILE));
+    const skillName = frontmatter.name ?? basename(folder);
+    let name = slug(skillName) || slug(basename(folder)) || "skill";
+    for (let suffix = 2; used.has(name); suffix += 1) name = `${slug(skillName)}-${suffix}`;
+    used.add(name);
+    const path = relative(root, folder).split(sep).join("/");
+    return {
+      name,
+      ...(frontmatter.description ? { description: frontmatter.description } : {}),
+      displayName: skillName,
+      source: path ? `./${path}` : "./",
+      strict: false,
+      skills: ["./"],
+    };
+  });
+  return { name: marketplaceName, description: `Skills from ${marketplaceName}`, plugins };
+}
+
+function collectSkillFolders(directory: string, depth: number, found: string[]): void {
+  let entries;
+  try {
+    entries = readdirSync(directory, { withFileTypes: true });
+  } catch {
+    return;
+  }
+  if (entries.some((entry) => entry.isFile() && entry.name === SKILL_FILE)) {
+    // A skill folder is one unit; its subfolders are its references and scripts.
+    found.push(directory);
+    return;
+  }
+  if (depth >= MAX_DEPTH) return;
+  for (const entry of entries) {
+    if (!entry.isDirectory() || SKIPPED_DIRECTORIES.has(entry.name)) continue;
+    if (entry.name.startsWith(".") && !SKILL_DOT_DIRECTORIES.has(entry.name)) continue;
+    collectSkillFolders(join(directory, entry.name), depth + 1, found);
+  }
+}
+
+/** Marketplace id from a repository or folder name. */
+export function skillsMarketplaceName(label: string): string {
+  return slug(label.replace(/\.git$/, "").replace(/[/:]+/g, "-")) || "skills";
+}
+
+function slug(value: string): string {
+  return value
+    .toLowerCase()
+    .replace(/[^a-z0-9._-]+/g, "-")
+    .replace(/-+/g, "-")
+    .replace(/^[^a-z0-9]+|[^a-z0-9]+$/g, "")
+    .slice(0, 128);
+}
