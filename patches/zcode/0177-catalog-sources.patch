@@ -0,0 +1,348 @@
+import { isRecord } from "./helpers.js";
+
+/**
+ * MCP Registry catalog adapter (OV-100 phase 2).
+ *
+ * Contract: modelcontextprotocol/registry `docs/reference/api/generic-registry-api.md` (`GET
+ * /v0.1/servers`, opaque `metadata.nextCursor`), `official-registry-api.md` (`version=latest`) and
+ * `server-json/generic-server-json.md` (packages with npm/pypi/oci/nuget/mcpb, `remotes`,
+ * environment variables, positional/named arguments). Each active server becomes a one-primitive
+ * Claude-format marketplace entry (`strict: false`) so install, update, enablement and removal stay
+ * on the existing plugin lifecycle. Required secrets become sensitive plugin `userConfig`, which the
+ * MCP resolver substitutes only into env and header fields.
+ */
+
+export const OFFICIAL_MCP_REGISTRY_URL = "https://registry.modelcontextprotocol.io";
+export const MCP_REGISTRY_ENTRY_SOURCE = "mcp-registry";
+
+const SERVERS_PATH = "/v0.1/servers";
+const PAGE_LIMIT = 100;
+const DEFAULT_MAX_PAGES = 100;
+const OFFICIAL_META_KEY = "io.modelcontextprotocol.registry/official";
+
+type JsonRecord = Record<string, unknown>;
+
+interface UserConfigOption {
+  description?: string;
+  required: boolean;
+  sensitive: boolean;
+  title: string;
+  type: "string";
+  default?: string;
+}
+
+export interface McpRegistryCatalog {
+  name: string;
+  description: string;
+  plugins: JsonRecord[];
+}
+
+/** Marketplace id for a registry: the official one is `mcp-registry`, others carry their host. */
+export function mcpRegistryMarketplaceId(registryUrl: string): string {
+  const base = normalizeRegistryBaseUrl(registryUrl);
+  if (base === OFFICIAL_MCP_REGISTRY_URL) return "mcp-registry";
+  const host = new URL(base).hostname.toLowerCase().replace(/[^a-z0-9.-]/g, "-");
+  return `mcp-registry-${host}`;
+}
+
+export function normalizeRegistryBaseUrl(registryUrl: string): string {
+  const url = new URL(registryUrl.trim());
+  if (url.protocol !== "https:" && url.protocol !== "http:") {
+    throw new Error(`MCP registry URL must be http(s): ${registryUrl}`);
+  }
+  const path = url.pathname.replace(/\/+$/, "").replace(/\/v0(?:\.1)?\/servers$/, "");
+  return `${url.origin}${path}`;
+}
+
+/** Whether a pasted URL names an MCP registry rather than a marketplace JSON file. */
+export function isMcpRegistryUrl(value: string): boolean {
+  try {
+    const url = new URL(value.trim());
+    return (
+      url.hostname === new URL(OFFICIAL_MCP_REGISTRY_URL).hostname ||
+      /\/v0(?:\.1)?\/servers\/?$/.test(url.pathname)
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Reads every latest active server page by page. `request` performs one GET and returns parsed
+ * JSON, so the caller keeps its own network policy (proxy env, size limit, redirects, abort).
+ */
+export async function fetchMcpRegistryCatalog(input: {
+  maxPages?: number;
+  registryUrl: string;
+  request: (url: string) => Promise<unknown>;
+  signal?: AbortSignal;
+}): Promise<McpRegistryCatalog> {
+  const base = normalizeRegistryBaseUrl(input.registryUrl);
+  const maxPages = input.maxPages ?? DEFAULT_MAX_PAGES;
+  const servers: unknown[] = [];
+  let cursor: string | undefined;
+  for (let page = 0; page < maxPages; page += 1) {
+    if (input.signal?.aborted) throw input.signal.reason ?? new Error("Aborted");
+    const url = new URL(`${base}${SERVERS_PATH}`);
+    url.searchParams.set("version", "latest");
+    url.searchParams.set("limit", String(PAGE_LIMIT));
+    if (cursor) url.searchParams.set("cursor", cursor);
+    const body = await input.request(url.toString());
+    if (!isRecord(body) || !Array.isArray(body.servers)) {
+      throw new Error(`MCP registry returned an unexpected server list: ${url.toString()}`);
+    }
+    servers.push(...body.servers);
+    const next = isRecord(body.metadata) ? body.metadata.nextCursor : undefined;
+    if (typeof next !== "string" || next.length === 0 || next === cursor) break;
+    cursor = next;
+  }
+  return {
+    name: mcpRegistryMarketplaceId(base),
+    description: `MCP servers from ${new URL(base).host}`,
+    plugins: mcpRegistryServersToEntries(servers),
+  };
+}
+
+export function mcpRegistryServersToEntries(items: readonly unknown[]): JsonRecord[] {
+  const entries: JsonRecord[] = [];
+  const usedNames = new Set<string>();
+  for (const item of items) {
+    const entry = mcpRegistryServerToEntry(item);
+    if (!entry) continue;
+    let name = entry.name as string;
+    for (let suffix = 2; usedNames.has(name); suffix += 1) name = `${entry.name}-${suffix}`;
+    usedNames.add(name);
+    entries.push({ ...entry, name });
+  }
+  return entries;
+}
+
+/** One registry list item (`{ server, _meta }`) → marketplace entry, or null when not installable. */
+export function mcpRegistryServerToEntry(item: unknown): JsonRecord | null {
+  const server = isRecord(item) && isRecord(item.server) ? item.server : item;
+  if (!isRecord(server) || typeof server.name !== "string") return null;
+  const official = isRecord(item) && isRecord(item._meta) ? item._meta[OFFICIAL_META_KEY] : undefined;
+  if (isRecord(official) && typeof official.status === "string" && official.status !== "active") {
+    return null;
+  }
+  const userConfig: Record<string, UserConfigOption> = {};
+  const config = selectServerConfig(server, userConfig);
+  if (!config) return null;
+
+  const registryName = server.name;
+  const shortName = registryName.split("/").pop() || registryName;
+  const mcpKey = slug(shortName) || "server";
+  const version = typeof server.version === "string" ? server.version : undefined;
+  const repositoryUrl =
+    isRecord(server.repository) && typeof server.repository.url === "string"
+      ? server.repository.url
+      : undefined;
+  const homepage = typeof server.websiteUrl === "string" ? server.websiteUrl : repositoryUrl;
+  const title = typeof server.title === "string" && server.title.trim() ? server.title.trim() : shortName;
+  const icon = Array.isArray(server.icons)
+    ? server.icons.find((candidate) => isRecord(candidate) && typeof candidate.src === "string" && /^https:\/\//.test(candidate.src))
+    : undefined;
+  return {
+    name: slug(registryName),
+    ...(typeof server.description === "string" ? { description: server.description } : {}),
+    ...(version ? { version } : {}),
+    source: { source: MCP_REGISTRY_ENTRY_SOURCE, server: registryName, ...(version ? { version } : {}) },
+    strict: false,
+    displayName: title,
+    ...(isRecord(icon) ? { icon: icon.src } : {}),
+    ...(homepage ? { homepage } : {}),
+    ...(repositoryUrl ? { repository: repositoryUrl } : {}),
+    mcpServers: { [mcpKey]: config },
+    ...(Object.keys(userConfig).length > 0 ? { userConfig } : {}),
+  };
+}
+
+/**
+ * Prefers a local stdio package a person can run without an account (npm, then PyPI), then a
+ * hosted endpoint, then a container. NuGet and MCPB bundles are not runnable by this host.
+ */
+function selectServerConfig(server: JsonRecord, userConfig: Record<string, UserConfigOption>): JsonRecord | null {
+  for (const candidate of serverConfigCandidates(server)) {
+    const own: Record<string, UserConfigOption> = {};
+    try {
+      const config = candidate(own);
+      if (!config) continue;
+      Object.assign(userConfig, own);
+      return config;
+    } catch (error) {
+      if (error instanceof SecretArgumentError) continue;
+      throw error;
+    }
+  }
+  return null;
+}
+
+/** The host substitutes secrets only into env and headers, never into command arguments. */
+class SecretArgumentError extends Error {}
+
+type CandidateBuilder = (userConfig: Record<string, UserConfigOption>) => JsonRecord | null;
+
+function serverConfigCandidates(server: JsonRecord): CandidateBuilder[] {
+  const packages = Array.isArray(server.packages) ? server.packages.filter(isRecord) : [];
+  const remotes = Array.isArray(server.remotes) ? server.remotes.filter(isRecord) : [];
+  const byType = (type: string) =>
+    packages.find(
+      (pkg) =>
+        pkg.registryType === type &&
+        typeof pkg.identifier === "string" &&
+        (!isRecord(pkg.transport) || pkg.transport.type === undefined || pkg.transport.type === "stdio"),
+    );
+  const candidates: CandidateBuilder[] = [];
+  const npm = byType("npm");
+  if (npm) candidates.push((config) => stdioPackageConfig(npm, "npx", ["-y", pinned(npm, "@")], config));
+  const pypi = byType("pypi");
+  if (pypi) candidates.push((config) => stdioPackageConfig(pypi, "uvx", [pinned(pypi, "==")], config));
+  for (const remoteType of ["streamable-http", "sse"] as const) {
+    for (const remote of remotes.filter((candidate) => candidate.type === remoteType)) {
+      candidates.push((config) => {
+        const url = templatedUrl(remote, config);
+        if (!url) return null;
+        const headers = headerConfig(remote.headers, config);
+        return { type: remoteType === "sse" ? "sse" : "http", url, ...(headers ? { headers } : {}) };
+      });
+    }
+  }
+  const oci = byType("oci");
+  if (oci) {
+    candidates.push((config) => {
+      const runtime = argumentList(oci.runtimeArguments, config);
+      const env = envConfig(oci.environmentVariables, config);
+      const envArgs = Object.keys(env ?? {}).flatMap((name) => ["-e", name]);
+      return {
+        type: "stdio",
+        command: "docker",
+        args: ["run", "-i", "--rm", ...runtime, ...envArgs, oci.identifier as string, ...argumentList(oci.packageArguments, config)],
+        ...(env ? { env } : {}),
+      };
+    });
+  }
+  return candidates;
+}
+
+/**
+ * `{variable}` placeholders in a remote URL become non-sensitive user config. A secret placeholder
+ * would put a credential into a URL, so such a remote is skipped.
+ */
+function templatedUrl(remote: JsonRecord, userConfig: Record<string, UserConfigOption>): string | null {
+  if (typeof remote.url !== "string" || !remote.url) return null;
+  const variables = isRecord(remote.variables) ? remote.variables : {};
+  let failed = false;
+  const url = remote.url.replace(/\{([^}]+)\}/g, (_match, name: string) => {
+    const variable = variables[name];
+    if (!isRecord(variable) || variable.isSecret === true) {
+      failed = true;
+      return "";
+    }
+    const value = inputValue({ ...variable, isRequired: true }, name, userConfig);
+    if (value === undefined) failed = true;
+    return value ?? "";
+  });
+  return failed ? null : url;
+}
+
+function stdioPackageConfig(
+  pkg: JsonRecord,
+  command: string,
+  leading: string[],
+  userConfig: Record<string, UserConfigOption>,
+): JsonRecord {
+  const env = envConfig(pkg.environmentVariables, userConfig);
+  return {
+    type: "stdio",
+    command,
+    args: [...argumentList(pkg.runtimeArguments, userConfig), ...leading, ...argumentList(pkg.packageArguments, userConfig)],
+    ...(env ? { env } : {}),
+  };
+}
+
+function pinned(pkg: JsonRecord, separator: string): string {
+  const identifier = pkg.identifier as string;
+  return typeof pkg.version === "string" && pkg.version ? `${identifier}${separator}${pkg.version}` : identifier;
+}
+
+function envConfig(value: unknown, userConfig: Record<string, UserConfigOption>): Record<string, string> | undefined {
+  const env: Record<string, string> = {};
+  for (const variable of Array.isArray(value) ? value.filter(isRecord) : []) {
+    if (typeof variable.name !== "string") continue;
+    const resolved = inputValue(variable, variable.name, userConfig);
+    if (resolved !== undefined) env[variable.name] = resolved;
+  }
+  return Object.keys(env).length > 0 ? env : undefined;
+}
+
+function headerConfig(value: unknown, userConfig: Record<string, UserConfigOption>): Record<string, string> | undefined {
+  const headers: Record<string, string> = {};
+  for (const header of Array.isArray(value) ? value.filter(isRecord) : []) {
+    if (typeof header.name !== "string") continue;
+    const resolved = inputValue(header, header.name, userConfig);
+    if (resolved !== undefined) headers[header.name] = resolved;
+  }
+  return Object.keys(headers).length > 0 ? headers : undefined;
+}
+
+function argumentList(value: unknown, userConfig: Record<string, UserConfigOption>): string[] {
+  const args: string[] = [];
+  for (const argument of Array.isArray(value) ? value.filter(isRecord) : []) {
+    const label =
+      (typeof argument.name === "string" && argument.name.replace(/^-+/, "")) ||
+      (typeof argument.valueHint === "string" && argument.valueHint) ||
+      `arg${args.length + 1}`;
+    if (argument.isSecret === true) throw new SecretArgumentError(label);
+    const resolved = inputValue(argument, label, userConfig);
+    if (argument.type === "named" && typeof argument.name === "string") {
+      if (resolved === undefined) continue;
+      args.push(argument.name, resolved);
+    } else if (resolved !== undefined) {
+      args.push(resolved);
+    }
+  }
+  return args;
+}
+
+/**
+ * A fixed value or default is written as is. A value the person must supply becomes plugin
+ * userConfig; optional inputs without a default are left out rather than invented.
+ */
+function inputValue(
+  input: JsonRecord,
+  label: string,
+  userConfig: Record<string, UserConfigOption>,
+): string | undefined {
+  // Templated values reference {variables} this adapter does not prompt for.
+  if (typeof input.value === "string" && !/\{[^}]+\}/.test(input.value)) return input.value;
+  const secret = input.isSecret === true;
+  const fallback = typeof input.default === "string" ? input.default : undefined;
+  if (input.isRequired !== true && !secret) return fallback;
+  if (!secret && fallback !== undefined) return fallback;
+  const key = configKey(label, userConfig);
+  userConfig[key] = {
+    title: label,
+    ...(typeof input.description === "string" ? { description: input.description } : {}),
+    required: input.isRequired === true,
+    sensitive: secret,
+    type: "string",
+    ...(!secret && fallback !== undefined ? { default: fallback } : {}),
+  };
+  return `\${user_config.${key}}`;
+}
+
+function configKey(label: string, userConfig: Record<string, UserConfigOption>): string {
+  const base = label.replace(/[^A-Za-z0-9_]/g, "_") || "value";
+  let key = base;
+  for (let suffix = 2; key in userConfig; suffix += 1) key = `${base}_${suffix}`;
+  return key;
+}
+
+function slug(value: string): string {
+  return value
+    .toLowerCase()
+    .replace(/[^a-z0-9._-]+/g, "-")
+    .replace(/-+/g, "-")
+    .replace(/^[^a-z0-9]+|[^a-z0-9]+$/g, "")
+    .slice(0, 128);
+}
