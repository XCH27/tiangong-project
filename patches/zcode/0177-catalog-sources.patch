+import assert from "node:assert/strict";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { createServer } from "node:http";
+import os from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import {
+  addMarketplace,
+  installMarketplacePlugin,
+  loadMarketplaceManifestSync,
+  mcpRegistryServerToEntry,
+} from "@zcode/adapters/plugins";
+
+// OV-100 phase 2: catalog sources become ordinary marketplaces, so their items install, update and
+// uninstall through the one plugin lifecycle.
+
+test("a folder of Agent Skills becomes a marketplace of one-skill plugins", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-skills-repo-"));
+  try {
+    const repo = join(root, "team-skills");
+    const storageRoot = join(root, "storage");
+    await mkdir(join(repo, "skills", "release-notes", "references"), { recursive: true });
+    await mkdir(join(repo, ".claude", "skills", "triage"), { recursive: true });
+    await mkdir(join(repo, ".git", "skills", "ignored"), { recursive: true });
+    await writeFile(
+      join(repo, "skills", "release-notes", "SKILL.md"),
+      "---\nname: release-notes\ndescription: Draft release notes\n---\nBody\n",
+    );
+    await writeFile(join(repo, "skills", "release-notes", "references", "SKILL.md"), "nested is part of its parent\n");
+    await writeFile(join(repo, ".claude", "skills", "triage", "SKILL.md"), "---\nname: Triage Bugs\n---\nBody\n");
+    await writeFile(join(repo, ".git", "skills", "ignored", "SKILL.md"), "---\nname: ignored\n---\n");
+
+    const record = await addMarketplace({ source: { source: "directory", path: repo }, storageRoot });
+    assert.equal(record.id, "team-skills");
+    const manifest = loadMarketplaceManifestSync(storageRoot, record.id);
+    assert.deepEqual(manifest?.plugins.map((entry) => entry.name).sort(), ["release-notes", "triage-bugs"]);
+
+    const result = await installMarketplacePlugin({ marketplace: record.id, name: "release-notes", storageRoot });
+    const installPath = result.installed.find((plugin) => plugin.name === "release-notes")?.installPath;
+    assert.ok(installPath, JSON.stringify(result));
+    const pluginJson = JSON.parse(await readFile(join(installPath, ".claude-plugin", "plugin.json"), "utf8"));
+    assert.deepEqual(pluginJson.skills, ["./"]);
+    assert.match(await readFile(join(installPath, "SKILL.md"), "utf8"), /Draft release notes/);
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("the MCP Registry becomes a marketplace of one-server plugins with secrets as user config", async () => {
+  const root = await mkdtemp(join(os.tmpdir(), "fleet-mcp-registry-"));
+  const pages: Record<string, unknown> = {
+    "": {
+      servers: [
+        {
+          server: {
+            name: "io.github.example/weather",
+            title: "Weather",
+            description: "Forecasts",
+            version: "1.2.0",
+            packages: [
+              {
+                registryType: "npm",
+                identifier: "@example/weather-mcp",
+                version: "1.2.0",
+                transport: { type: "stdio" },
+                environmentVariables: [
+                  { name: "WEATHER_KEY", isRequired: true, isSecret: true, description: "API key" },
+                  { name: "UNITS", default: "metric" },
+                ],
+              },
+            ],
+          },
+          _meta: { "io.modelcontextprotocol.registry/official": { status: "active", isLatest: true } },
+        },
+        {
+          server: { name: "io.github.example/retired", version: "0.1.0", packages: [{ registryType: "npm", identifier: "x" }] },
+          _meta: { "io.modelcontextprotocol.registry/official": { status: "deleted" } },
+        },
+      ],
+      metadata: { nextCursor: "page-2" },
+    },
+    "page-2": {
+      servers: [
+        {
+          server: {
+            name: "com.example/hosted",
+            version: "2.0.0",
+            remotes: [
+              {
+                type: "streamable-http",
+                url: "https://mcp.example.com/mcp",
+                headers: [{ name: "Authorization", isRequired: true, isSecret: true }],
+              },
+            ],
+          },
+        },
+        { server: { name: "com.example/dotnet-only", version: "1.0.0", packages: [{ registryType: "nuget", identifier: "X" }] } },
+      ],
+      metadata: { nextCursor: null },
+    },
+  };
+  const requests: string[] = [];
+  const server = createServer((req, res) => {
+    const url = new URL(req.url ?? "/", "http://localhost");
+    requests.push(url.pathname + url.search);
+    const body = pages[url.searchParams.get("cursor") ?? ""];
+    res.writeHead(body ? 200 : 404, { "content-type": "application/json" });
+    res.end(JSON.stringify(body ?? {}));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  try {
+    const address = server.address();
+    assert.ok(address && typeof address === "object");
+    const storageRoot = join(root, "storage");
+    const record = await addMarketplace({
+      source: { source: "mcp-registry", url: `http://127.0.0.1:${address.port}` },
+      storageRoot,
+    });
+    assert.equal(record.id, "mcp-registry-127.0.0.1");
+    assert.ok(requests.every((request) => request.includes("version=latest")), requests.join("\n"));
+    const manifest = loadMarketplaceManifestSync(storageRoot, record.id);
+    assert.deepEqual(
+      manifest?.plugins.map((entry) => entry.name).sort(),
+      ["com.example-hosted", "io.github.example-weather"],
+      "deleted and unrunnable servers are left out",
+    );
+
+    const result = await installMarketplacePlugin({ marketplace: record.id, name: "io.github.example-weather", storageRoot });
+    const installPath = result.installed[0]?.installPath;
+    assert.ok(installPath, JSON.stringify(result));
+    const pluginJson = JSON.parse(await readFile(join(installPath, ".claude-plugin", "plugin.json"), "utf8"));
+    assert.deepEqual(pluginJson.mcpServers.weather, {
+      type: "stdio",
+      command: "npx",
+      args: ["-y", "@example/weather-mcp@1.2.0"],
+      env: { WEATHER_KEY: "${user_config.WEATHER_KEY}", UNITS: "metric" },
+    });
+    assert.equal(pluginJson.userConfig.WEATHER_KEY.sensitive, true);
+    assert.equal(pluginJson.userConfig.WEATHER_KEY.required, true);
+  } finally {
+    server.close();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("a secret passed as a command argument skips that package for one that keeps it out of argv", () => {
+  const entry = mcpRegistryServerToEntry({
+    server: {
+      name: "io.github.example/both",
+      packages: [
+        {
+          registryType: "npm",
+          identifier: "both",
+          packageArguments: [{ type: "named", name: "--token", isRequired: true, isSecret: true }],
+        },
+      ],
+      remotes: [{ type: "sse", url: "https://example.com/sse", headers: [{ name: "X-Key", isSecret: true, isRequired: true }] }],
+    },
+  });
+  assert.deepEqual((entry?.mcpServers as Record<string, unknown>).both, {
+    type: "sse",
+    url: "https://example.com/sse",
+    headers: { "X-Key": "${user_config.X-Key}".replace("X-Key}", "X_Key}") },
+  });
+  assert.deepEqual(Object.keys(entry?.userConfig as object), ["X_Key"], "the npm candidate's config is discarded");
+});
+
+test("URL placeholders become user config, but a secret placeholder never goes into a URL", () => {
+  const entry = mcpRegistryServerToEntry({
+    server: {
+      name: "ai.example/docs",
+      icons: [{ src: "https://example.com/icon.svg" }],
+      remotes: [
+        { type: "streamable-http", url: "https://x.example/{token}/mcp", variables: { token: { isSecret: true, isRequired: true } } },
+        { type: "streamable-http", url: "https://x.example/v2/{project_slug}/mcp", variables: { project_slug: { isRequired: true } } },
+      ],
+    },
+  });
+  assert.equal(entry?.icon, "https://example.com/icon.svg");
+  assert.deepEqual((entry?.mcpServers as Record<string, unknown>).docs, {
+    type: "http",
+    url: "https://x.example/v2/${user_config.project_slug}/mcp",
+  });
+  assert.equal((entry?.userConfig as Record<string, { sensitive: boolean }>).project_slug.sensitive, false);
+});
