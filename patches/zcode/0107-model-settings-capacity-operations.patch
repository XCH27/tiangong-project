+async function capacityOwner() {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-page-capacity-"));
+  const path = join(dir, "providers.json");
+  const runtime = new NodeProviderRegistryRuntime({ personalFilePath: path,
+    zcodeBuiltinFilePath: fileURLToPath(new URL("../../../../../config/provider/zcode-builtin.json", import.meta.url)),
+    personalPollingIntervalMs: false, watch: false });
+  await runtime.start();
