+test("real Pi and SQLite retain a capacity correction's permission, owner state and cold tool receipt without replay", async () => {
+  const owner = await capacityOwner();
+  const calls: string[] = [];
+  const f = await fixture("pi", true, { config: { ...config, modelSettingsAssistant: owner.target,
+    systemPrompt: modelSettingsAssistantInstructions(owner.target) }, deps: { modelSettingsPort: { async perform(command) {
+      calls.push(command.operation);
+      return owner.perform(owner.target, command);
+    } } } });
+  try {
+    const revision = owner.facade.getView().revision;
+    f.steps.push(() => reply("", [tool("ReadModelSettings", {})]),
+      () => reply("", [tool("SetModelLimits", { modelId: "model-b", basedOnRevision: revision, contextWindow: 65_536 })]),
+      () => reply("The context correction was saved; output capacity remains unknown."));
+    await f.runtime.executeTurn("Correct this model's context to 65536");
+    const saved = await owner.perform(owner.target, { operation: "read" });
+    assert.equal(saved.models[0]!.contextWindow, 65_536);
+    assert.equal(saved.models[0]!.maxOutputTokens, null);
+    assert.equal(f.permissionCalls, 1);
+    assert.deepEqual(calls, ["read", "set-limits"]);
+    const before = f.toolFacts();
+    assert.equal(before.length, 2);
+    const journal = await f.store.messages({ sessionID: "session" as never });
+    const serialized = JSON.stringify(journal);
+    assert.equal(serialized.includes("fixture-private-key"), false);
+    assert.ok(serialized.includes("SetModelLimits"));
+    assert.ok(serialized.includes("65536"));
+    await f.reopen();
+    assert.deepEqual(f.toolFacts(), before);
+    f.steps.push(() => reply("The saved correction is retained."));
+    await f.runtime.executeTurn("Explain the earlier result without another change");
+    assert.deepEqual(calls, ["read", "set-limits"]);
+    assert.equal((await owner.perform(owner.target, { operation: "read" })).models[0]!.contextWindow, 65_536);
+  } finally { await f.close(); await owner.close(); }
