+    api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+    access: { type: "api-key", apiKey: "fixture-private-key" },
+  }) });
+  await runtime.configService.addPersonalModel(providerId, "model-b", parseModelConfig({ properties: { contextWindow: 131_072 } }), undefined, true);
+  await runtime.registryService.refresh("capacity owner");
+  const facade = new ProviderSettingsFacade(runtime.registryService, {
+    savePersonalModelDraft: (...args: Parameters<typeof runtime.configService.savePersonalModelDraft>) => runtime.configService.savePersonalModelDraft(...args),
+    setPersonalModelEnabled: (...args: Parameters<typeof runtime.configService.setPersonalModelEnabled>) => runtime.configService.setPersonalModelEnabled(...args),
+    refresh: (reason: string) => runtime.registryService.refresh(reason),
+  } as never);
