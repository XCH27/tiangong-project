diff --git a/packages/ui/test/providerProbeScope.browser.tsx b/packages/ui/test/providerProbeScope.browser.tsx
new file mode 100644
index 0000000..2681d03
--- /dev/null
+++ b/packages/ui/test/providerProbeScope.browser.tsx
@@ -0,0 +1,136 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { useModelProviders } from "../src/hooks/useModelProviders.js";
+import type { ProviderSettingsView } from "@zcode/services";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+
+async function run() {
+  const container = document.createElement("div");
+  document.body.append(container);
+  const root = createRoot(container);
+  let current!: ReturnType<typeof useModelProviders>;
+  let publish!: (view: ProviderSettingsView) => void;
+  const config = {
+    group: "standard-personal",
+    api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+    access: { type: "api-key", apiKey: "synthetic-original" },
+  };
+  const model = (id: string) => ({ modelId: id, effectiveConfig: {}, executable: true });
+  let view = {
+    revision: 1,
+    providers: [
+      {
+        providerId: "fixture",
+        enabled: true,
+        executable: true,
+        effectiveConfig: config,
+        models: [model("tested")],
+      },
+    ],
+    providerTemplates: [],
+  } as unknown as ProviderSettingsView;
+  let response = Promise.resolve({ success: true as const });
+  const service = {
+    async getView() {
+      return view;
+    },
+    onDidChange(callback: typeof publish) {
+      publish = callback;
+      return { dispose() {} };
+    },
+    async testModelConnectivity() {
+      return response;
+    },
+  };
+  function Reader() {
+    current = useModelProviders({ workspacePath: "/fixture" });
+    return <div>{String(current.modelProviders[0]?.connectionTest?.result.success ?? false)}</div>;
+  }
+  const results: Array<{ name: string; error?: string }> = [];
+  try {
+    await act(async () => {
+      root.render(
+        <ServiceProvider services={{ providerSettingsService: service } as never}>
+          <Reader />
+        </ServiceProvider>,
+      );
+    });
+    await act(async () => {
+      current.invalidateConnectionTest("fixture", "account-revision-1");
+      await current.testModelConnectivity("fixture", "tested");
+    });
+    check(container.textContent === "true", "initial test did not publish");
+    await act(async () => {
+      view = {
+        ...view,
+        revision: 2,
+        providers: [
+          {
+            ...view.providers[0]!,
+            models: [...view.providers[0]!.models, model("unrelated") as never],
+          },
+        ],
+      };
+      publish(view);
+    });
+    check(container.textContent === "true", "an unrelated model erased the completed probe");
+    await act(async () => {
+      current.invalidateConnectionTest("fixture", "account-revision-1");
+    });
+    check(
+      container.textContent === "true",
+      "reopening unchanged subscription details erased the probe",
+    );
+    await act(async () => {
+      current.invalidateConnectionTest("fixture", "account-revision-2");
+    });
+    check(
+      container.textContent === "false",
+      "a changed subscription revision retained the old probe",
+    );
+    const pending = Promise.withResolvers<{ success: true }>();
+    response = pending.promise;
+    let probe!: Promise<unknown>;
+    await act(async () => {
+      probe = current.testModelConnectivity("fixture", "tested");
+    });
+    await act(async () => {
+      view = {
+        ...view,
+        revision: 3,
+        providers: [
+          {
+            ...view.providers[0]!,
+            effectiveConfig: {
+              ...config,
+              access: { type: "api-key", apiKey: "synthetic-new" },
+            } as never,
+          },
+        ],
+      };
+      publish(view);
+      pending.resolve({ success: true });
+      await probe;
+    });
+    check(container.textContent === "false", "a late test marked the new credential ready");
+    results.push({
+      name: "actual provider hook retains exact-model health through unrelated refresh/reopen and rejects changed account or credential evidence",
+    });
+  } catch (error) {
+    results.push({
+      name: "provider probe scope",
+      error: error instanceof Error ? error.stack : String(error),
+    });
+  } finally {
+    await act(async () => root.unmount());
+    container.remove();
+  }
+  return results;
+}
+(window as unknown as { __providerProbeTests: ReturnType<typeof run> }).__providerProbeTests =
+  run();
