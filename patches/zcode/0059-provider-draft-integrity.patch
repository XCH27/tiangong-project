diff --git a/packages/services/test/provider-overlay-revision.test.ts b/packages/services/test/provider-overlay-revision.test.ts
new file mode 100644
index 0000000..0d7cc8c
--- /dev/null
+++ b/packages/services/test/provider-overlay-revision.test.ts
@@ -0,0 +1,371 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { NodeProviderRegistryRuntime } from "@zcode/provider-node";
+import { ProviderSettingsFacade, parseProviderConfig, parseModelConfig } from "@zcode/provider";
+import { createProviderSettingsService } from "../src/model-provider/providerFacadeServices.js";
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "fleet-provider-overlay-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  let runtime = new NodeProviderRegistryRuntime(options);
+  await runtime.start();
+  const { providerId } = await runtime.configService.createPersonalProvider({
+    providerName: "Fixture",
+    initialConfig: parseProviderConfig({
+      api: { type: "openai-chat-completions", baseUrl: "https://fixture.invalid/v1" },
+      access: { type: "api-key", apiKey: "synthetic-original" },
+    }),
+  });
+  await runtime.registryService.refresh("fixture");
+  const facade = new ProviderSettingsFacade(runtime.registryService, {
+    savePersonalProviderOverlay: (
+      ...args: Parameters<typeof runtime.configService.savePersonalProviderOverlay>
+    ) => runtime.configService.savePersonalProviderOverlay(...args),
+    savePersonalModelDraft: (
+      ...args: Parameters<typeof runtime.configService.savePersonalModelDraft>
+    ) => runtime.configService.savePersonalModelDraft(...args),
+    refresh: (reason: string) => runtime.registryService.refresh(reason),
+  } as never);
+  return {
+    facade,
+    providerId,
+    get runtime() {
+      return runtime;
+    },
+    read: () => readFile(options.personalFilePath, "utf8"),
+    async independentWriter() {
+      const writer = new NodeProviderRegistryRuntime(options);
+      await writer.start();
+      return writer;
+    },
+    async reopen() {
+      runtime.dispose();
+      runtime = new NodeProviderRegistryRuntime(options);
+      await runtime.start();
+      return (await runtime.configService.read()).personalProviders.get(providerId)!.toJSON();
+    },
+    async close() {
+      runtime.dispose();
+      await rm(root, { recursive: true, force: true });
+    },
+  };
+}
+
+test("service readiness cannot change the submitted address, nested credentials or name", async () => {
+  const f = await fixture();
+  try {
+    const ready = Promise.withResolvers<void>();
+    const service = createProviderSettingsService(f.facade, () => ready.promise);
+    const config = {
+      api: { type: "openai-chat-completions" as const, baseUrl: "https://admitted.invalid/v1" },
+      access: {
+        type: "api-key" as const,
+        apiKey: "synthetic-admitted",
+        additionalApiKeys: ["synthetic-backup"],
+      },
+    };
+    const metadata = { providerName: "Admitted name", enabled: false };
+    const pending = service.savePersonalProviderOverlay(
+      f.providerId,
+      config,
+      metadata,
+      f.facade.getView().revision,
+    );
+    config.api.baseUrl = "https://mutated.invalid/v1";
+    config.access.apiKey = "synthetic-mutated";
+    config.access.additionalApiKeys[0] = "synthetic-mutated-backup";
+    metadata.providerName = "Mutated name";
+    metadata.enabled = true;
+    ready.resolve();
+    await pending;
+    const reopened = await f.reopen();
+    assert.equal(reopened.api?.baseUrl, "https://admitted.invalid/v1");
+    assert.equal(
+      reopened.access?.type === "api-key" && reopened.access.apiKey,
+      "synthetic-admitted",
+    );
+    assert.deepEqual(reopened.access?.type === "api-key" && reopened.access.additionalApiKeys, [
+      "synthetic-backup",
+    ]);
+    const rule = (await f.runtime.configService.read()).personalProviders.getRule(f.providerId)!;
+    assert.equal(rule.providerName, "Admitted name");
+    assert.equal(rule.enabled, false);
+  } finally {
+    await f.close();
+  }
+});
+
+test("the facade snapshots an overlay before its serialized queue starts", async () => {
+  const f = await fixture();
+  try {
+    const config = {
+      api: { type: "openai-chat-completions" as const, baseUrl: "https://queued.invalid/v1" },
+      access: {
+        type: "api-key" as const,
+        apiKey: "synthetic-queued",
+        additionalApiKeys: ["queued-backup"],
+      },
+    };
+    const metadata = { providerName: "Queued name" };
+    const pending = f.facade.savePersonalProviderOverlay(
+      f.providerId,
+      config,
+      metadata,
+      f.facade.getView().revision,
+    );
+    config.api.baseUrl = "https://mutated.invalid/v1";
+    config.access.additionalApiKeys[0] = "mutated-backup";
+    metadata.providerName = "Mutated name";
+    await pending;
+    const reopened = await f.reopen();
+    assert.equal(reopened.api?.baseUrl, "https://queued.invalid/v1");
+    assert.deepEqual(reopened.access?.type === "api-key" && reopened.access.additionalApiKeys, [
+      "queued-backup",
+    ]);
+    assert.equal(
+      (await f.runtime.configService.read()).personalProviders.getRule(f.providerId)?.providerName,
+      "Queued name",
+    );
+  } finally {
+    await f.close();
+  }
+});
+
+test("a submitted model draft retains its target, revision and configuration through service readiness", async () => {
+  const f = await fixture();
+  try {
+    await f.runtime.configService.addPersonalModel(
+      f.providerId,
+      "original-model",
+      parseModelConfig({ enabled: true }),
+    );
+    await f.runtime.registryService.refresh("model fixture");
+    const ready = Promise.withResolvers<void>();
+    const service = createProviderSettingsService(f.facade, () => ready.promise);
+    const draft = {
+      providerId: f.providerId,
+      originalModelId: "original-model",
+      nextModelId: "admitted-model",
+      basedOnRevision: f.facade.getView().revision,
+      personalConfig: { enabled: false },
+    };
+    const pending = service.savePersonalModelDraft(draft);
+    draft.providerId = "different-target";
+    draft.nextModelId = "mutated-model";
+    draft.basedOnRevision = -1;
+    draft.personalConfig.enabled = true;
+    ready.resolve();
+    await pending;
+    await f.reopen();
+    const stored = await f.runtime.configService.read();
+    assert.equal(
+      stored.personalModels.getExact(f.providerId, "admitted-model")?.toJSON().enabled,
+      false,
+    );
+    assert.equal(stored.personalModels.getExact(f.providerId, "mutated-model"), undefined);
+    assert.equal(stored.personalModels.getExact(f.providerId, "original-model"), undefined);
+  } finally {
+    await f.close();
+  }
+});
+
+test("the facade cannot redirect a queued model draft to a caller-mutated target", async () => {
+  const f = await fixture();
+  try {
+    await f.runtime.configService.addPersonalModel(
+      f.providerId,
+      "original-model",
+      parseModelConfig({ enabled: true }),
+    );
+    await f.runtime.registryService.refresh("model fixture");
+    const draft = {
+      providerId: f.providerId,
+      originalModelId: "original-model",
+      nextModelId: "queued-model",
+      basedOnRevision: f.facade.getView().revision,
+      personalConfig: { enabled: false },
+    };
+    const pending = f.facade.savePersonalModelDraft(draft);
+    draft.providerId = "different-target";
+    draft.originalModelId = "different-model";
+    draft.nextModelId = "mutated-model";
+    draft.personalConfig.enabled = true;
+    await pending;
+    await f.reopen();
+    const stored = await f.runtime.configService.read();
+    assert.equal(
+      stored.personalModels.getExact(f.providerId, "queued-model")?.toJSON().enabled,
+      false,
+    );
+    assert.equal(stored.personalModels.getExact(f.providerId, "mutated-model"), undefined);
+  } finally {
+    await f.close();
+  }
+});
+
+test("stale connection/name/key overlay cannot overwrite a newer commit, and fresh save survives reopen", async () => {
+  const f = await fixture();
+  try {
+    const initial = f.facade.getView();
+    const staleConfig = initial.providers.find(
+      (p) => p.providerId === f.providerId,
+    )!.personalConfig!;
+    const saved = await f.facade.savePersonalProviderOverlay(
+      f.providerId,
+      { ...staleConfig, access: { type: "api-key", apiKey: "synthetic-new" } },
+      { providerName: "New name", enabled: false },
+      initial.revision,
+    );
+    const before = await f.read();
+    await assert.rejects(
+      f.facade.savePersonalProviderOverlay(
+        f.providerId,
+        { ...staleConfig, api: { ...staleConfig.api, baseUrl: "https://stale.invalid/v1" } },
+        { providerName: "Old name", enabled: true },
+        initial.revision,
+      ),
+      /revision conflict/,
+    );
+    assert.equal(await f.read(), before);
+    const current = saved.providers.find((p) => p.providerId === f.providerId)!;
+    await f.facade.savePersonalProviderOverlay(
+      f.providerId,
+      {
+        ...current.personalConfig,
+        api: { ...current.personalConfig?.api, baseUrl: "https://new.invalid/v1" },
+      },
+      undefined,
+      saved.revision,
+    );
+    const reopened = await f.reopen();
+    assert.equal(reopened.api?.baseUrl, "https://new.invalid/v1");
+    assert.equal(reopened.access?.type === "api-key" && reopened.access.apiKey, "synthetic-new");
+    const rule = (await f.runtime.configService.read()).personalProviders.getRule(f.providerId)!;
+    assert.equal(rule.providerName, "New name");
+    assert.equal(rule.enabled, false);
+  } finally {
+    await f.close();
+  }
+});
+
+test("two queued writes from one rendered revision admit only the first", async () => {
+  const f = await fixture();
+  try {
+    const revision = f.facade.getView().revision;
+    const results = await Promise.allSettled([
+      f.facade.savePersonalProviderOverlay(
+        f.providerId,
+        { api: { baseUrl: "https://first.invalid/v1" } },
+        undefined,
+        revision,
+      ),
+      f.facade.savePersonalProviderOverlay(
+        f.providerId,
+        { api: { baseUrl: "https://second.invalid/v1" } },
+        undefined,
+        revision,
+      ),
+    ]);
+    assert.equal(results[0]!.status, "fulfilled");
+    assert.equal(results[1]!.status, "rejected");
+    assert.match((results[1] as PromiseRejectedResult).reason.message, /revision conflict/);
+    assert.equal((await f.reopen()).api?.baseUrl, "https://first.invalid/v1");
+  } finally {
+    await f.close();
+  }
+});
+
+test("a second runtime's disk commit rejects a stale writer before polling publishes its new view", async () => {
+  const f = await fixture();
+  const writer = await f.independentWriter();
+  try {
+    const revision = f.facade.getView().revision;
+    await writer.configService.savePersonalProviderOverlay(
+      f.providerId,
+      parseProviderConfig({ api: { baseUrl: "https://independent.invalid/v1" } }),
+    );
+    const before = await f.read();
+    assert.equal(
+      f.facade.getView().revision,
+      revision,
+      "the fixture must retain a stale registry view",
+    );
+    await assert.rejects(
+      f.facade.savePersonalProviderOverlay(
+        f.providerId,
+        { api: { baseUrl: "https://stale.invalid/v1" } },
+        undefined,
+        revision,
+      ),
+      /revision conflict/,
+    );
+    assert.equal(await f.read(), before);
+  } finally {
+    writer.dispose();
+    await f.close();
+  }
+});
+
+test("a registry change during the asynchronous writer fails inside the existing transaction", async () => {
+  const f = await fixture();
+  try {
+    let concurrentCommit = "";
+    const guarded = new ProviderSettingsFacade(f.runtime.registryService, {
+      savePersonalProviderOverlay: async (
+        ...args: Parameters<typeof f.runtime.configService.savePersonalProviderOverlay>
+      ) => {
+        await f.runtime.configService.savePersonalProviderOverlay(
+          f.providerId,
+          parseProviderConfig({ access: { type: "api-key", apiKey: "synthetic-concurrent" } }),
+        );
+        await f.runtime.registryService.refresh("changed after admission");
+        concurrentCommit = await f.read();
+        return f.runtime.configService.savePersonalProviderOverlay(...args);
+      },
+      refresh: (reason: string) => f.runtime.registryService.refresh(reason),
+    } as never);
+    await assert.rejects(
+      guarded.savePersonalProviderOverlay(
+        f.providerId,
+        { api: { baseUrl: "https://late.invalid/v1" } },
+        undefined,
+        guarded.getView().revision,
+      ),
+      /revision conflict/,
+    );
+    assert.ok(concurrentCommit);
+    assert.equal(await f.read(), concurrentCommit);
+  } finally {
+    await f.close();
+  }
+});
+
+test("a deleted target stays deleted; legacy three-argument callers retain their existing path", async () => {
+  const f = await fixture();
+  try {
+    await f.facade.savePersonalProviderOverlay(f.providerId, {}, { providerName: "Legacy import" });
+    const revision = f.facade.getView().revision;
+    await f.runtime.configService.deletePersonalProvider(f.providerId);
+    await f.runtime.registryService.refresh("deleted");
+    const before = await f.read();
+    await assert.rejects(
+      f.facade.savePersonalProviderOverlay(f.providerId, {}, undefined, revision),
+      /revision conflict/,
+    );
+    await assert.rejects(f.facade.savePersonalProviderOverlay(f.providerId, {}), /Provider 不存在/);
+    assert.equal(await f.read(), before);
+  } finally {
+    await f.close();
+  }
+});
