new file mode 100644
index 0000000..e675531
--- /dev/null
+++ b/packages/ui/test/providerDrafts.browser.tsx
@@ -0,0 +1,378 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { InlineEditableProviderCard } from "../src/settings/model-provider-section/InlineEditableProviderCard.js";
+import { ProviderDetailFeedbackBoundary } from "../src/settings/model-provider-section/ProviderDetailFeedback.js";
+import type { SavePersonalModelDraftInput } from "@zcode/provider";
+import type {
+  ProviderSettingsFormProvider,
+  ProviderSettingsSaveReceipt,
+} from "../src/lib/providerSettingsFormTypes.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+function provider(
+  id = "A",
+  url = "https://fixture.invalid/v1",
+  key = "synthetic-original",
+): ProviderSettingsFormProvider {
+  const config = {
+    group: "standard-personal" as const,
+    api: { type: "openai-chat-completions" as const, baseUrl: url },
+    access: { type: "api-key" as const, apiKey: key },
+  };
+  return {
+    providerId: id,
+    providerName: id,
+    enabled: true,
+    executable: true,
+    hasPersonalConfig: true,
+    personalConfig: config,
+    config,
+    models: [],
+  };
+}
+
+async function fixture(locale: "zh-CN" | "en-US" = "en-US") {
+  const container = document.createElement("div");
+  document.body.append(container);
+  const root = createRoot(container);
+  const writes: Array<{
+    provider: ProviderSettingsFormProvider;
+    revision?: number;
+    result: ReturnType<typeof Promise.withResolvers<ProviderSettingsSaveReceipt>>;
+  }> = [];
+  const modelWrites: Array<{
+    input: SavePersonalModelDraftInput;
+    result: ReturnType<typeof Promise.withResolvers<void>>;
+  }> = [];
+  let currentModel: ProviderSettingsFormProvider["models"][number] | undefined;
+  const services = {
+    providerSettingsService: {
+      async discoverModels() {
+        return { models: [], warnings: [] };
+      },
+      async resolveModelConfig() {
+        return {
+          inheritedConfig: currentModel?.config ?? {},
+          effectiveConfig: currentModel?.config ?? {},
+          evidenceConfig: currentModel?.config ?? {},
+          issues: [],
+        };
+      },
+    },
+  };
+  return {
+    container,
+    writes,
+    modelWrites,
+    conflictText: locale === "zh-CN" ? "设置已变更" : "Settings changed",
+    async render(value: ProviderSettingsFormProvider, revision: number) {
+      currentModel = value.models[0];
+      await act(async () => {
+        root.render(
+          <ServiceProvider services={services as never}>
+            <ZCodeIntlProvider initialLocale={locale}>
+              <TooltipProvider>
+                <ProviderDetailFeedbackBoundary>
+                  <InlineEditableProviderCard
+                    provider={value}
+                    settingsRevision={revision}
+                    nameEditable
+                    onSavePersonalModelDraft={(input) => {
+                      const result = Promise.withResolvers<void>();
+                      modelWrites.push({ input, result });
+                      return result.promise;
+                    }}
+                    onSave={(next, basedOnRevision) => {
+                      const result = Promise.withResolvers<ProviderSettingsSaveReceipt>();
+                      writes.push({ provider: next, revision: basedOnRevision, result });
