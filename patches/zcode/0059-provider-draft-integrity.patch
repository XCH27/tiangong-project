@@ -0,0 +1,16 @@
+import type { IntlInstance } from "../i18n/IntlProvider.js";
+
+export function isProviderSettingsWriteConflict(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error);
+  return /(?:Provider Settings(?: membership| snapshot)?|Personal Provider Config) revision conflict/.test(
+    message,
+  );
+}
+
+export function providerSettingsWriteError(error: unknown, intl: IntlInstance): string {
+  return isProviderSettingsWriteConflict(error)
+    ? intl.formatMessage({ id: "settings.modelProvider.settingsChanged" })
+    : error instanceof Error
+      ? error.message
+      : String(error);
+}
