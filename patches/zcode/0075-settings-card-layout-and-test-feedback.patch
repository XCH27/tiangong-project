+test("status and test feedback share classified copy without disclosing provider bodies", () => {
+  const intl = { formatMessage: ({ id }: { id: string }) => id };
+  for (const kind of ["authentication", "access-denied", "subscription-expired", "model", "network"] as const) {
+    assert.equal(modelConnectivityErrorMessage({ kind, message: "private body", statusCode: 403 }, intl),
+      `settings.modelProvider.testFailure.${kind} (HTTP 403)`);
+  }
+  assert.equal(modelConnectivityErrorMessage({ message: "Subscription expired in an unclassified body" }, intl),
+    "settings.modelProvider.testFailure.unknown");
+  assert.equal(modelConnectivityErrorMessage({ code: "model-unavailable", kind: "unknown", message: "private" }, intl),
+    "settings.modelProvider.testModel.modelUnavailable");
+});
