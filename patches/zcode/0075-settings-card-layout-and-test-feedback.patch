diff --git a/packages/ui/src/settings/model-provider-section/providerStatus.ts b/packages/ui/src/settings/model-provider-section/providerStatus.ts
index 0287474..8ab45da 100644
--- a/packages/ui/src/settings/model-provider-section/providerStatus.ts
+++ b/packages/ui/src/settings/model-provider-section/providerStatus.ts
@@ -1,4 +1,19 @@
 import type { ProviderSettingsFormProvider } from "@/lib/providerSettingsFormTypes.js";
+import type { ModelConnectivityResult } from "@zcode/shared";
+
+/** Shared by the original test feedback and navigation; provider response bodies stay private. */
+export function modelConnectivityErrorMessage(
+  error: Extract<ModelConnectivityResult, { success: false }>["error"],
+  intl: { formatMessage(descriptor: { id: string }): string },
+): string {
+  const id =
+    error.code === "provider-unavailable"
+      ? "settings.modelProvider.testModel.providerUnavailable"
+      : error.code === "model-unavailable"
+        ? "settings.modelProvider.testModel.modelUnavailable"
+        : `settings.modelProvider.testFailure.${error.kind ?? "unknown"}`;
+  return intl.formatMessage({ id }) + (error.statusCode ? ` (HTTP ${error.statusCode})` : "");
+}
 
 export type ProviderStatus = "disabled" | "unavailable" | "configured" | "failed" | "ready";
 type StatusFacts = Pick<ProviderSettingsFormProvider, "enabled" | "executable" | "connectionTest">;
