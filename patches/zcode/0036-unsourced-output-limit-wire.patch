+test("unknown output limits stay internal on optional API formats while required Messages still sends one", async () => {
+  for (const api of ["openai-chat-completions", "openai-responses", "anthropic-messages"] as const) {
+    const outputField = api === "openai-responses" ? "max_output_tokens" : "max_tokens";
+    const outputLimitMap = `{\"${outputField}\": maxOutputTokens}`;
+    const { execution, requests } = fixture();
+    await run(bind(execution, { api, outputLimitMap, omitUnsourcedOutputLimit: true }));
+    const body = requests[0]!.body;
+    if (api === "anthropic-messages") {
+      assert.equal(body.max_tokens, OPTIONS.maxOutputTokens);
+    } else {
+      assert.equal("max_output_tokens" in body, false);
+      assert.equal("max_tokens" in body, false);
+      assert.equal("max_completion_tokens" in body, false);
+    }
+    const known = fixture();
+    await run(bind(known.execution, { api, outputLimitMap }));
+    assert.equal(known.requests[0]!.body[outputField], OPTIONS.maxOutputTokens);
+  }
+});
