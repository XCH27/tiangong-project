diff --git a/packages/services/test/openrouter-catalog-metadata.test.ts b/packages/services/test/openrouter-catalog-metadata.test.ts
new file mode 100644
index 0000000..beba496
--- /dev/null
+++ b/packages/services/test/openrouter-catalog-metadata.test.ts
@@ -0,0 +1,33 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readDiscoveredModelMetadata } from "../src/model-provider/modelDiscoveryMetadata.js";
+
+// 形态取自 OpenRouter /api/v1/models 实际返回（2026-10-05，648 个模型）。
+const model = (id: string, outputs: string[], parameters: string[], inputs = ["text"]) => ({
+  id,
+  context_length: 128000,
+  architecture: { input_modalities: inputs, output_modalities: outputs },
+  supported_parameters: parameters,
+});
+
+test("OpenRouter reasoning level is offered only when the model declares reasoning", () => {
+  const reasons = readDiscoveredModelMetadata(model("a/r", ["text"], ["tools", "reasoning"]), "openai-chat-completions", undefined);
+  const plain = readDiscoveredModelMetadata(model("a/p", ["text"], ["tools"]), "openai-chat-completions", undefined);
+  const empty = readDiscoveredModelMetadata(model("a/i", ["image"], [], ["text", "image"]), "openai-chat-completions", undefined);
+  assert.ok(reasons.optionSpecs?.reasoningLevel);
+  assert.equal(plain.optionSpecs?.reasoningLevel, undefined);
+  assert.equal(empty.optionSpecs?.reasoningLevel, undefined);
+});
+
+test("OpenRouter transcription and speech outputs become explicit audio capabilities", () => {
+  const asr = readDiscoveredModelMetadata(model("g/transcribe", ["transcription"], [], ["audio"]), "openai-chat-completions", undefined);
+  const tts = readDiscoveredModelMetadata(model("o/tts", ["speech"], [], ["text"]), "openai-chat-completions", undefined);
+  assert.deepEqual(asr.properties?.outputFormat, {
+    supportsText: false,
+    supportsImage: false,
+    supportsVideo: false,
+    supportsTranscription: true,
+  });
+  assert.equal(tts.properties?.outputFormat?.supportsSpeech, true);
+  assert.equal(tts.properties?.outputFormat?.supportsText, false);
+});
