new file mode 100644
index 0000000..121cf43
--- /dev/null
+++ b/packages/ui/src/lib/providerSettingsRead.ts
@@ -0,0 +1,19 @@
+/** Reads have a deadline; a disconnected host must not leave settings in an endless spinner.
+ * This only bounds reads. Mutations must not time out and then be retried as duplicate writes.
+ */
+export function readProviderSettings<T>(read: () => Promise<T>, timeoutMs = 15_000): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(
+      () => reject(new Error("Provider settings service did not respond")),
+      timeoutMs,
+    );
+    try {
+      read()
+        .then(resolve, reject)
+        .finally(() => clearTimeout(timer));
+    } catch (error) {
+      clearTimeout(timer);
+      reject(error);
+    }
+  });
+}
