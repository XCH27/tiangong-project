+import type { ProviderSettingsFormProvider } from "../../ui/src/lib/providerSettingsFormTypes.js";
+import { guardHostConsole } from "../../desktop/src/host/hostConsoleSink.js";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+const view = (revision: number) => ({ revision }) as ProviderSettingsView;
+
+test("a stalled settings read expires, late results cannot win, and retry can recover", async () => {
+  const pending = deferred<ProviderSettingsView>();
+  const first = readProviderSettings(() => pending.promise, 10);
+  await assert.rejects(first, /did not respond/);
+  const next = await readProviderSettings(async () => view(2), 10);
+  pending.resolve(view(1));
+  assert.equal(next.revision, 2);
+  await assert.rejects(
+    readProviderSettings(() => {
+      throw new Error("disconnected");
+    }),
+    /disconnected/,
+  );
+});
+
+test("settings retains the last successful view on refresh failure and ignores disposed reads", async () => {
+  const pending = deferred<ProviderSettingsView>();
+  let read = async () => view(3);
+  let listener: (view: ProviderSettingsView) => void = () => {};
+  const service = {
+    getView: () => read(),
+    onDidChange: (callback: typeof listener) => {
+      listener = callback;
+      return { dispose() {} };
+    },
+  } as IProviderSettingsService;
+  const connection = connectProviderSettingsSnapshot(service);
+  await connection.ready;
+  read = async () => {
+    throw new Error("offline");
+  };
+  await assert.rejects(connection.reload(), /offline/);
+  assert.equal(getProviderSettingsSnapshot().status, "ready");
+  listener(view(2));
+  assert.equal((getProviderSettingsSnapshot() as { view: ProviderSettingsView }).view.revision, 3);
+  read = () => pending.promise;
+  const staleRead = connection.reload();
+  connection.dispose();
+  pending.resolve(view(9));
+  await staleRead;
+  assert.equal((getProviderSettingsSnapshot() as { view: ProviderSettingsView }).view.revision, 3);
+});
+
+test("a broken console pipe cannot kill the host, but unrelated failures still propagate", () => {
+  const stdout = new EventEmitter();
+  const stderr = new EventEmitter();
+  const writes: unknown[][] = [];
+  const write = (...args: unknown[]) => {
+    writes.push(args);
+  };
+  const output = guardHostConsole({ log: write, warn: write, error: write }, [stdout, stderr]);
+  output.log("before");
+  stdout.emit("error", Object.assign(new Error("closed"), { code: "EPIPE" }));
+  output.log("after");
+  output.error("still delivered separately by the parent-port relay");
+  assert.equal(writes.length, 1);
+  assert.throws(() => stderr.emit("error", new Error("unexpected I/O failure")), /unexpected/);
+  const sync = guardHostConsole(
+    {
+      log() {
+        throw Object.assign(new Error(), { code: "EPIPE" });
+      },
+      warn: write,
+      error: write,
+    },
+    [],
+  );
+  assert.doesNotThrow(() => sync.log("closed"));
+});
+
+test("editing saves endpoint and credentials together and preserves hidden settings after restart", async () => {
+  const root = await mkdtemp(join(tmpdir(), "fleet-model-edit-"));
+  const options = {
+    personalFilePath: join(root, "providers.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false as const,
+    watch: false,
+  };
+  const runtime = createProviderConfigRuntime(options);
+  let restarted: ReturnType<typeof createProviderConfigRuntime> | undefined;
+  try {
+    await runtime.start();
+    const config = {
+      api: {
+        type: "openai-chat-completions" as const,
+        baseUrl: "https://old.example/v1",
+        headers: { "X-Route": "preserve" },
+      },
+      access: {
+        type: "api-key" as const,
+        apiKey: "old-synthetic",
+        additionalApiKeys: ["backup-synthetic"],
+        autoSwitchCredentials: false,
+      },
+    };
+    const { providerId } = await runtime.configService.createPersonalProvider({
+      providerName: "Review connection",
+      initialConfig: parseProviderConfig(config),
+    });
+    const provider: ProviderSettingsFormProvider = {
+      providerId,
+      providerName: "Review connection",
+      templateId: null,
+      enabled: true,
+      executable: false,
+      hasPersonalConfig: true,
+      personalConfig: config,
+      config,
+      models: [],
+    };
+    const before = await readFile(options.personalFilePath, "utf8");
+    const draft = {
+      nameValue: "Unconfirmed rename",
+      apiFormat: "openai-responses" as const,
+      baseUrlValue: "https://new.example/v1",
+      apiKeyValue: "  new-synthetic  ",
+      additionalApiKeys: ["backup-synthetic", " backup-synthetic "],
+      autoSwitchCredentials: true,
+    };
+    const next = resolvePendingProviderDraftSave({ provider, draft, now: Date.now })!;
+    assert.equal(
+      await readFile(options.personalFilePath, "utf8"),
+      before,
+      "typing cannot write configuration",
+    );
+    assert.equal(
+      next.providerNameUpdate,
+      undefined,
+      "saving a connection cannot commit an unfinished rename",
+    );
+    await runtime.configService.savePersonalProviderOverlay(
+      providerId,
+      parseProviderConfig(next.personalConfig),
+    );
+    runtime.dispose();
+    restarted = createProviderConfigRuntime(options);
+    await restarted.start();
+    const saved = (await restarted.configService.read()).personalProviders
+      .get(providerId)!
+      .toJSON();
+    assert.equal(saved.api?.baseUrl, "https://new.example/v1");
+    assert.equal(saved.api?.type, "openai-responses");
+    assert.deepEqual(saved.api?.headers, { "X-Route": "preserve" });
+    assert.deepEqual(saved.access, {
+      type: "api-key",
+      apiKey: "new-synthetic",
+      additionalApiKeys: ["backup-synthetic"],
+      autoSwitchCredentials: true,
+    });
+  } finally {
+    runtime.dispose();
+    restarted?.dispose();
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("both new and edited connections reject incomplete addresses and unsafe embedded credentials", () => {
+  const config = {
+    api: { type: "openai-responses" as const, baseUrl: "https://api.openai.com/v1" },
+    access: { type: "api-key" as const },
+  };
+  for (const baseUrl of ["", "https://", "file:///tmp/model", "https://user:pass@example.com"]) {
+    assert.equal(
+      providerSetupConfig(
+        { config },
+        {
+          baseUrl,
+          api: "openai-responses",
+          primary: "synthetic",
+          additional: [],
+          automatic: false,
+        },
+      ),
+      undefined,
+    );
+  }
+  assert.equal(
+    providerSetupConfig(
+      { config },
+      {
+        baseUrl: config.api.baseUrl,
+        api: "anthropic-messages",
+        primary: "synthetic",
+        additional: [],
+        automatic: false,
+      },
+    ),
+    undefined,
+  );
+});
