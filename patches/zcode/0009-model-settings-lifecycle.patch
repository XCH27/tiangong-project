diff --git a/packages/desktop/src/host/hostConsoleSink.ts b/packages/desktop/src/host/hostConsoleSink.ts
new file mode 100644
index 0000000..b783b02
--- /dev/null
+++ b/packages/desktop/src/host/hostConsoleSink.ts
@@ -0,0 +1,37 @@
+interface ConsoleSink {
+  log(...args: unknown[]): void;
+  warn(...args: unknown[]): void;
+  error(...args: unknown[]): void;
+}
+interface ErrorStream {
+  on(event: "error", listener: (error: Error) => void): unknown;
+}
+
+/** Console is a secondary sink. Losing its pipe must not kill the RPC/settings host.
+ * The normal parent-port log relay remains active, including after EPIPE.
+ */
+export function guardHostConsole(
+  output: ConsoleSink,
+  streams: readonly (ErrorStream | undefined)[],
+): ConsoleSink {
+  let closed = false;
+  const handleError = (error: unknown) => {
+    if (error && typeof error === "object" && "code" in error && error.code === "EPIPE") {
+      closed = true;
+      return;
+    }
+    throw error;
+  };
+  for (const stream of streams) stream?.on("error", handleError);
+  const write =
+    (method: keyof ConsoleSink) =>
+    (...args: unknown[]) => {
+      if (closed) return;
+      try {
+        output[method](...args);
+      } catch (error) {
+        handleError(error);
+      }
+    };
+  return { log: write("log"), warn: write("warn"), error: write("error") };
+}
