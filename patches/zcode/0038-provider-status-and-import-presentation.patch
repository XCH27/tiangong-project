diff --git a/packages/ui/src/settings/model-provider-section/ccSwitchImportViewModel.ts b/packages/ui/src/settings/model-provider-section/ccSwitchImportViewModel.ts
new file mode 100644
index 0000000..ebe4f83
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/ccSwitchImportViewModel.ts
@@ -0,0 +1,39 @@
+interface ImportRow {
+  id: string;
+  appType: string;
+  modelIds: readonly string[];
+  eligible: boolean;
+  duplicateOf?: string;
+}
+
+export interface ImportRowGroup<T extends ImportRow> {
+  row: T;
+  ids: string[];
+  clients: string[];
+  modelIds: string[];
+}
+
+/** Collapse equivalent source-client entries without merging different saved keys. */
+export function groupCcSwitchImportRows<T extends ImportRow>(rows: readonly T[]): ImportRowGroup<T>[] {
+  const groups: ImportRowGroup<T>[] = [];
+  const byId = new Map<string, ImportRowGroup<T>>();
+  for (const row of rows) {
+    const group = row.duplicateOf ? byId.get(row.duplicateOf) : undefined;
+    if (group) {
+      group.ids.push(row.id);
+      if (!group.clients.includes(row.appType)) group.clients.push(row.appType);
+      for (const id of row.modelIds)
+        if (!group.modelIds.includes(id)) group.modelIds.push(id);
+      continue;
+    }
+    const created = {
+      row,
+      ids: [row.id],
+      clients: [row.appType],
+      modelIds: [...row.modelIds],
+    };
+    groups.push(created);
+    byId.set(row.id, created);
+  }
+  return groups.sort((a, b) => Number(b.row.eligible) - Number(a.row.eligible));
+}
diff --git a/packages/ui/src/settings/model-provider-section/providerStatus.ts b/packages/ui/src/settings/model-provider-section/providerStatus.ts
