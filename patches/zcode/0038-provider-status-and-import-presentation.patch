index 0000000..f318230
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/providerStatus.ts
@@ -0,0 +1,35 @@
+import type { ProviderSettingsFormProvider } from "@/lib/providerSettingsFormTypes.js";
+
+export type ProviderStatus = "disabled" | "unavailable" | "configured" | "failed" | "ready";
+type StatusFacts = Pick<ProviderSettingsFormProvider, "enabled" | "executable" | "connectionTest">;
+
+/** A non-secret comparison token; the serialized key material is discarded immediately. */
+export function providerProbeScope(
+  provider: Pick<ProviderSettingsFormProvider, "enabled" | "executable" | "config" | "models">,
+): string {
+  const value = JSON.stringify([
+    provider.enabled, provider.executable, provider.config.api, provider.config.access,
+    provider.models.map((model) => [model.modelId, model.config, model.executable]),
+  ]);
+  const hashes = [0x811c9dc5, 0x9e3779b1];
+  for (const char of value) {
+    const code = char.codePointAt(0) ?? 0;
+    hashes[0] = Math.imul((hashes[0]! ^ code) >>> 0, 0x01000193) >>> 0;
+    hashes[1] = Math.imul((hashes[1]! ^ code) >>> 0, 0x01000193) >>> 0;
+  }
+  return hashes.map((hash) => hash.toString(16).padStart(8, "0")).join("");
+}
+
+/** The original dot shows configuration readiness; only a scoped request proves inference. */
+export function resolveProviderStatus(provider?: StatusFacts | null): ProviderStatus {
+  if (provider?.enabled === false) return "disabled";
+  if (!provider?.executable) return "unavailable";
+  const result = provider.connectionTest?.result;
+  if (!result) return "configured";
+  if (result.success) return "ready";
+  // A model/parameter/network error is not evidence that the account itself is invalid.
+  return [
+    "authentication", "subscription-expired", "subscription-access",
+    "quota", "rate-limit", "endpoint", "client", "access-denied",
+  ].includes(result.error.kind ?? "") ? "failed" : "configured";
+}
