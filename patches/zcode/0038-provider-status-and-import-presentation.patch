index 0000000..e26e0ed
--- /dev/null
+++ b/packages/ui/test/ccSwitchImportViewModel.test.ts
@@ -0,0 +1,17 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { groupCcSwitchImportRows } from "../src/settings/model-provider-section/ccSwitchImportViewModel.js";
+
+test("preview groups only source-proven equivalent rows and keeps their model union", () => {
+  const rows = [
+    { id: "a", appType: "claude", modelIds: ["one"], eligible: true },
+    { id: "b", appType: "claude-desktop", modelIds: ["two"], eligible: true, duplicateOf: "a" },
+    { id: "c", appType: "codex", modelIds: ["one"], eligible: true },
+    { id: "d", appType: "gemini", modelIds: [], eligible: false },
+  ];
+  const groups = groupCcSwitchImportRows(rows);
+  assert.deepEqual(groups.map((group) => group.ids), [["a", "b"], ["c"], ["d"]]);
+  assert.deepEqual(groups[0]?.clients, ["claude", "claude-desktop"]);
+  assert.deepEqual(groups[0]?.modelIds, ["one", "two"]);
+  assert.equal(groups[2]?.row.eligible, false);
+});
diff --git a/packages/ui/test/providerStatus.test.ts b/packages/ui/test/providerStatus.test.ts
new file mode 100644
index 0000000..9e9458e
--- /dev/null
+++ b/packages/ui/test/providerStatus.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { providerProbeScope, resolveProviderStatus } from "../src/settings/model-provider-section/providerStatus.js";
+
+const configured = { enabled: true, executable: true };
+
+test("provider dot separates original configuration readiness from verified inference", () => {
+  assert.equal(resolveProviderStatus({ ...configured, enabled: false }), "disabled");
+  assert.equal(resolveProviderStatus({ ...configured, executable: false }), "unavailable");
+  assert.equal(resolveProviderStatus(configured), "configured");
+  assert.equal(resolveProviderStatus({ ...configured, connectionTest: {
+    modelId: "model-a", checkedAt: 1, result: { success: true },
+  } }), "ready");
+});
+
+test("account or endpoint rejection needs attention, while model and local test failures do not condemn an account", () => {
+  for (const kind of ["authentication", "access-denied", "subscription-expired", "subscription-access", "quota", "endpoint"] as const) {
+    assert.equal(resolveProviderStatus({ ...configured, connectionTest: {
+      modelId: "model-a", checkedAt: 1,
+      result: { success: false, error: { kind, message: "failed" } },
+    } }), "failed");
+  }
+  for (const kind of ["model", "request", "context", "network", "environment", "changed"] as const) {
+    assert.equal(resolveProviderStatus({ ...configured, connectionTest: {
+      modelId: "model-a", checkedAt: 1,
+      result: { success: false, error: { kind, message: "failed" } },
+    } }), "configured");
+  }
+});
+
+test("probe evidence survives unrelated refreshes but not credential or model changes", () => {
+  const provider = {
+    ...configured,
+    config: { api: { type: "anthropic-messages", baseUrl: "https://api.example.test" }, access: { type: "api-key", apiKey: "secret-a" } },
+    models: [{ modelId: "m", config: { contextWindow: 128000 }, executable: true }],
+  } as Parameters<typeof providerProbeScope>[0];
+  const first = providerProbeScope(provider);
+  assert.equal(providerProbeScope(structuredClone(provider)), first);
+  assert.notEqual(providerProbeScope({ ...provider, config: { ...provider.config, access: { type: "api-key", apiKey: "secret-b" } } } as typeof provider), first);
+  assert.notEqual(providerProbeScope({ ...provider, models: [{ ...provider.models[0]!, modelId: "different" }] }), first);
+});
