+++ b/apps/zcode-cli/packages/core/test/codex-native-errors.test.ts
@@ -0,0 +1,123 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { createCodexNativeAgentPort } from "../../adapters/src/native-agent/codex-turn.js";
+import { resolveCodexNativeExecutable } from "../../adapters/src/native-agent/codex-executable.js";
+import { classifyModelFailure } from "../../adapters/src/model/failure-classifier.js";
+
+const executable = resolveCodexNativeExecutable(process.env.FLEET_CODEX_TEST_CLI);
+
+// Codex reports a final failure as an `error` notification carrying TurnError {message,
+// codexErrorInfo}. The person must see Codex's message and the Host classifier a status it knows.
+async function failingTurn(status: number, body: unknown) {
+  assert.ok(executable, "Build and select the scoped Codex binary before this test");
+  const profile = await mkdtemp(join(tmpdir(), "fleet-codex-native-error-"));
+  const payload = Buffer.from(
+    JSON.stringify({
+      email: "fixture@example.invalid",
+      sub: "fixture-user",
+      "https://api.openai.com/auth": {
+        chatgpt_account_id: "fixture-workspace",
+        chatgpt_user_id: "fixture-user",
+        chatgpt_plan_type: "pro",
+      },
+      exp: Math.floor(Date.now() / 1000) + 3600,
+    }),
+  ).toString("base64url");
+  await writeFile(
+    join(profile, "auth.json"),
+    JSON.stringify({
+      auth_mode: "chatgpt",
+      OPENAI_API_KEY: null,
+      tokens: {
+        id_token: `e30.${payload}.fixture`,
+        access_token: "synthetic-native-token",
+        refresh_token: "synthetic-refresh",
+        account_id: "fixture-workspace",
+      },
+      last_refresh: new Date().toISOString(),
+    }),
+    { mode: 0o600 },
+  );
+  let inference = 0;
+  const server = createServer(async (req, res) => {
+    for await (const _chunk of req) {
+      // drain
+    }
+    if (req.url?.includes("accounts/check")) {
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(JSON.stringify({ accounts: [{ id: "fixture-workspace", plan_type: "pro", workspace_backend_origin: "https://chatgpt.com", account_routing_override: "NO_CONSTRAINT" }] }));
+      return;
+    }
+    if (req.method !== "POST" || !req.url?.includes("responses")) {
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(JSON.stringify({ models: [], data: [] }));
+      return;
+    }
+    inference++;
+    res.writeHead(status, { "content-type": "application/json" });
+    res.end(JSON.stringify(body));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address === "object");
+  const base = `http://127.0.0.1:${address.port}`;
+  let diagnostics = "";
+  const port = createCodexNativeAgentPort({
+    executable,
+    configDir: profile,
+    onDiagnostic: (chunk) => {
+      diagnostics = (diagnostics + chunk).slice(-16384);
+    },
+    args: [
+      "app-server", "--listen", "stdio://", "--host-tools-json", '["fleet.Probe"]',
+      "-c", `openai_base_url="${base}"`, "-c", `chatgpt_base_url="${base}"`,
+    ],
+  });
+  const f = await fixture(undefined, true, {
+    nativeExecutor: { kind: "codex", executable, configDir: profile },
+    config: {
+      toolAllowlist: ["Probe"],
+      modelSelection: { providerId: "fixture", modelId: "gpt-6-sol", options: { reasoningLevel: "high" } } as never,
+    },
+    deps: { nativeAgentPort: port },
+  });
+  try {
+    let caught: any;
+    await f.runtime.executeTurn("hello").catch((error) => {
+      caught = error;
+    });
+    assert.ok(caught, `the turn must fail\n${diagnostics}`);
+    const chain: any[] = [];
+    for (let cause = caught; cause && chain.length < 8; cause = cause.cause) chain.push(cause);
+    return { chain, text: chain.map((error) => error.message).join(" | "), inference, diagnostics };
+  } finally {
+    await f.close();
+    server.close();
+    await rm(profile, { recursive: true, force: true });
+  }
+}
+
+const native = (chain: any[]) => chain.find((error) => error.nativeError);
+
+test("an exhausted ChatGPT allowance reaches the person and the Host as a rate limit", { timeout: 120000 }, async () => {
+  const r = await failingTurn(429, {
+    error: { type: "usage_limit_reached", message: "The usage limit has been reached", plan_type: "pro", resets_in_seconds: 3600 },
+  });
+  assert.doesNotMatch(r.text, /^Turn execution failed \| Native Codex execution failed$/, r.diagnostics);
+  const error = native(r.chain);
+  assert.ok(error, `typed error missing: ${r.text}\nDIAG ${r.diagnostics.slice(-1500)}`);
+  assert.equal(classifyModelFailure(error).reason, "rate_limited");
+  assert.match(error.message, /limit/i);
+});
+
+test("a rejected ChatGPT login is an authentication failure", { timeout: 120000 }, async () => {
+  const r = await failingTurn(401, { error: { message: "Your authentication token has expired.", type: "invalid_request_error", code: "token_expired" } });
+  const error = native(r.chain);
+  assert.ok(error, `typed error missing: ${r.text}\nDIAG ${r.diagnostics.slice(-1500)}`);
+  assert.equal(classifyModelFailure(error).reason, "auth_failed");
+});
