@@ -0,0 +1,66 @@
+import type { SDKMessage } from "@anthropic-ai/claude-agent-sdk";
+
+type RateLimitInfo = Extract<SDKMessage, { type: "rate_limit_event" }>["rate_limit_info"];
+type AssistantFrame = Extract<SDKMessage, { type: "assistant" }>;
+
+/**
+ * Status the Host failure classifier understands for each SDK assistant error type. The CLI has
+ * already retried transient failures (`system/api_retry`); Fleet only classifies the final one.
+ */
+const STATUS: Readonly<Record<string, number>> = {
+  authentication_failed: 401,
+  oauth_org_not_allowed: 403,
+  account_on_hold: 403,
+  verification_required: 403,
+  billing_error: 402,
+  rate_limit: 429,
+  overloaded: 529,
+  server_error: 500,
+  invalid_request: 400,
+  model_not_found: 404,
+};
+
+export interface NativeClaudeError extends Error {
+  nativeError: string;
+  statusCode?: number;
+  responseHeaders?: Record<string, string>;
+}
+
+/** The CLI's own explanation, e.g. "Invalid API key · Fix external API key". */
+export function claudeAssistantErrorText(frame: AssistantFrame): string {
+  const content = frame.message?.content;
+  const text = Array.isArray(content)
+    ? content.map((block) => (block.type === "text" ? block.text : "")).join("").trim()
+    : "";
+  return text || `Native Claude request failed (${frame.error})`;
+}
+
+/**
+ * A typed failure: the reason text stays the CLI's, the status follows the SDK error type (the
+ * reported HTTP status wins where it is more specific, e.g. 403 or 529), and a rejected allowance
+ * window supplies the reset as `retry-after`.
+ */
+export function nativeClaudeError(
+  type: string,
+  message: string,
+  apiStatus: number | undefined,
+  rateLimit?: RateLimitInfo,
+): NativeClaudeError {
+  const mapped = STATUS[type];
+  const statusCode =
+    type === "billing_error"
+      ? 402
+      : apiStatus && (apiStatus >= 500 || apiStatus === 403 || mapped === undefined)
+        ? apiStatus
+        : (mapped ?? apiStatus);
+  const resetsAt = rateLimit?.status === "rejected" ? rateLimit.resetsAt : undefined;
+  const retryAfter =
+    type === "rate_limit" && typeof resetsAt === "number"
+      ? Math.max(0, Math.ceil(resetsAt - Date.now() / 1000))
+      : undefined;
+  return Object.assign(new Error(message), {
+    nativeError: type,
+    ...(statusCode !== undefined ? { statusCode } : {}),
+    ...(retryAfter !== undefined ? { responseHeaders: { "retry-after": String(retryAfter) } } : {}),
+  });
+}
