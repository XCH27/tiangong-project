diff --git a/apps/zcode-cli/packages/adapters/src/native-agent/codex-errors.ts b/apps/zcode-cli/packages/adapters/src/native-agent/codex-errors.ts
new file mode 100644
index 0000000..a8bb510
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/native-agent/codex-errors.ts
@@ -0,0 +1,44 @@
+/**
+ * Codex app-server `error` notification -> typed failure. The message stays Codex's own
+ * (TurnError.message plus additionalDetails); the status lets the Host classifier tell an
+ * exhausted allowance or expired login from a server fault. Variants follow
+ * codex-rs/app-server-protocol/schema/typescript/v2/CodexErrorInfo.ts.
+ */
+const STATUS: Readonly<Record<string, number>> = {
+  usageLimitExceeded: 429,
+  rateLimitExceeded: 429,
+  serverOverloaded: 529,
+  unauthorized: 401,
+  badRequest: 400,
+  contextWindowExceeded: 400,
+  internalServerError: 500,
+  cyberPolicy: 403,
+  misalignmentPolicyViolation: 403,
+};
+
+export interface NativeCodexError extends Error {
+  nativeError: string;
+  statusCode?: number;
+}
+
+export function nativeCodexError(params: unknown): NativeCodexError {
+  const error = (params as { error?: Record<string, unknown> } | undefined)?.error ?? {};
+  const info = error.codexErrorInfo;
+  const kind =
+    typeof info === "string"
+      ? info
+      : info && typeof info === "object"
+        ? (Object.keys(info)[0] ?? "other")
+        : "other";
+  const nested =
+    info && typeof info === "object" ? (Object.values(info)[0] as { httpStatusCode?: unknown } | undefined) : undefined;
+  const httpStatus = typeof nested?.httpStatusCode === "number" ? nested.httpStatusCode : undefined;
+  const statusCode = STATUS[kind] ?? httpStatus;
+  const message = [error.message, error.additionalDetails]
+    .filter((part): part is string => typeof part === "string" && part.trim().length > 0)
+    .join(" — ");
+  return Object.assign(new Error(message || "Native Codex execution failed"), {
+    nativeError: kind,
+    ...(statusCode !== undefined ? { statusCode } : {}),
+  });
+}
