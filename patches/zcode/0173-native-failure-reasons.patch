diff --git a/apps/zcode-cli/packages/core/test/claude-native-errors.test.ts b/apps/zcode-cli/packages/core/test/claude-native-errors.test.ts
new file mode 100644
index 0000000..ef17793
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/claude-native-errors.test.ts
@@ -0,0 +1,102 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createServer } from "node:http";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSync } from "node:child_process";
+import { fixture } from "./helpers/pi-runtime-fixture.js";
+import { createClaudeNativeAgentPort } from "../../adapters/src/native-agent/claude.js";
+import { resolveClaudeNativeExecutable } from "../../adapters/src/native-agent/claude-executable.js";
+import { classifyModelFailure } from "../../adapters/src/model/failure-classifier.js";
+
+const nativeExecutable = resolveClaudeNativeExecutable(process.env.FLEET_CLAUDE_TEST_CLI);
+execFileSync(nativeExecutable, ["--version"], { stdio: "ignore", timeout: 15000 });
+
+// A failed native request ends with an assistant frame carrying the SDK's typed `error` and a
+// result with `is_error` and `api_error_status`. The person must see the CLI's own reason, and the
+// Host classifier must receive a status it understands, instead of an internal stream error.
+async function failingTurn(status: number, body: unknown, headers: Record<string, string> = {}) {
+  const profile = await mkdtemp(join(tmpdir(), "fleet-claude-native-error-"));
+  let hits = 0;
+  const server = createServer(async (req, res) => {
+    for await (const _chunk of req) {
+      // drain
+    }
+    if (!req.url?.split("?")[0]?.endsWith("/messages")) {
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end("{}");
+      return;
+    }
+    hits++;
+    res.writeHead(status, { "content-type": "application/json", ...headers });
+    res.end(JSON.stringify(body));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.ok(address && typeof address === "object");
+  const port = createClaudeNativeAgentPort({
+    env: {
+      ANTHROPIC_API_KEY: "synthetic-native-test",
+      ANTHROPIC_BASE_URL: `http://127.0.0.1:${address.port}`,
+      CLAUDE_CONFIG_DIR: profile,
+      CLAUDE_CODE_MAX_RETRIES: "0",
+    },
+  });
+  const f = await fixture(undefined, true, {
+    nativeExecutor: { kind: "claude", executable: nativeExecutable },
+    deps: { nativeAgentPort: port },
+  });
+  try {
+    let caught: any;
+    await f.runtime.executeTurn("hello").catch((error) => {
+      caught = error;
+    });
+    assert.ok(caught, "the turn must fail");
+    let cause = caught;
+    const chain: any[] = [];
+    while (cause && chain.length < 8) {
+      chain.push(cause);
+      cause = cause.cause;
+    }
+    return { chain, text: chain.map((error) => error.message).join(" | "), hits };
+  } finally {
+    await f.close();
+    server.close();
+    await rm(profile, { recursive: true, force: true });
+  }
+}
+
+const native = (chain: any[]) => chain.find((error) => error.nativeError);
+
+test("an invalid key surfaces the CLI's reason as an authentication failure", { timeout: 60000 }, async () => {
+  const r = await failingTurn(401, { type: "error", error: { type: "authentication_error", message: "invalid x-api-key" } });
+  assert.match(r.text, /Invalid API key/);
+  assert.doesNotMatch(r.text, /no matching request stream|execution failed: success/);
+  const error = native(r.chain);
+  assert.equal(error?.nativeError, "authentication_failed");
+  assert.equal(classifyModelFailure(error).reason, "auth_failed");
+});
+
+test("low credit is a billing failure, not an unknown error", { timeout: 60000 }, async () => {
+  const r = await failingTurn(400, {
+    type: "error",
+    error: { type: "invalid_request_error", message: "Your credit balance is too low to access the Anthropic API." },
+  });
+  assert.match(r.text, /Credit balance is too low/);
+  assert.equal(native(r.chain)?.nativeError, "billing_error");
+  assert.equal(native(r.chain)?.statusCode, 402);
+});
+
+test("a rate limit keeps its status so the Host can wait instead of failing blindly", { timeout: 60000 }, async () => {
+  const r = await failingTurn(
+    429,
+    { type: "error", error: { type: "rate_limit_error", message: "Rate limited" } },
+    { "retry-after": "0" },
+  );
+  assert.match(r.text, /Rate limited/);
+  const error = native(r.chain);
+  assert.equal(error?.nativeError, "rate_limit");
+  assert.equal(classifyModelFailure(error).reason, "rate_limited");
+  assert.equal(r.hits, 1, "Fleet must not re-send a failed native request on its own");
+});
diff --git a/apps/zcode-cli/packages/core/test/codex-native-errors.test.ts b/apps/zcode-cli/packages/core/test/codex-native-errors.test.ts
