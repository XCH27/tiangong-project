+        await f.reopen();
+        const recovered = await resume.handler(
+          { receiptUri: accepted.uri, waitSeconds: 0 }, f.context(),
+        ) as any;
+        assert.equal(recovered.status, "completed");
+        assert.equal(recovered.artifactUri, saved.uri);
+        assert.equal(recovered.mimeType, "video/mp4");
+        assert.match(recovered.message, /already saved video.*completion details are unavailable/);
+        assert.equal(recovered.reportedCostUsd, undefined, "Bytes do not prove provider cost");
