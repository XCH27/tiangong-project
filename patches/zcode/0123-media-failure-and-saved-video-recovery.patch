+        const receipts = await artifacts.listMediaJobArtifacts({ sessionId: "session" as never });
+        const parsed = await Promise.all(receipts.map(async (file) => ({
+          uri: file.uri,
+          receipt: JSON.parse((await artifacts.readToolResultArtifact({ uri: file.uri })).content),
+        })));
