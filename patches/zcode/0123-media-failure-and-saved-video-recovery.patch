+    async () => {
+      const f = await setup();
+      const controller = new AbortController();
+      let submissions = 0;
+      let polls = 0;
+      let failCompletion = true;
+      const providerUsage = { outputSeconds: 6, billedUnits: 3 };
+      const port: MediaGenerationPort = {
+        listModels: () => [],
+        prepareImage: async () => "unused",
