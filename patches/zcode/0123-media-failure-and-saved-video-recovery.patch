+      const resume = tools.find((tool) => tool.metadata.name === "ResumeMediaJob")!;
+      const faultyArtifacts = new Proxy(artifacts, {
+        get(target, name) {
+          if (name === "writeToolResultArtifactOnce") return async (input: any) => {
+            if (fault !== "ledger" && !input.idempotencyKey.endsWith(":intent")) throw receiptFailure;
+            return target.writeToolResultArtifactOnce(input);
