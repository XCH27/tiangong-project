+        submitVideo: async () => {
+          submissions++;
+          return { requestId: "original-provider-request" };
+        },
+        readVideo: async (input) => {
+          polls++;
+          assert.equal(input.requestId, "original-provider-request");
+          assert.equal(input.credentialReference, "original-key");
+          if (polls > 1) return { status: "expired" };
+          controller.abort(); // Returned bytes must still finish local publication after Stop.
+          return {
+            status: "done", bytes: mp4, mimeType: "video/mp4",
+            reportedModelId: "reported-video", reportedCostUsd: 0.2, providerUsage,
+          };
+        },
+      };
+      const tools = createMediaGenerationToolEntries(port);
+      const generate = tools.find((tool) => tool.metadata.name === "GenerateVideo")!;
+      const resume = tools.find((tool) => tool.metadata.name === "ResumeMediaJob")!;
+      const originalRecord = f.store.recordModelUsage.bind(f.store);
+      f.store.recordModelUsage = async (record) => {
+        if (!retainUsage && record.rawUsage) throw new Error("completion ledger unavailable");
+        return originalRecord(record);
+      };
+      const readLedger = async () => {
+        const { DatabaseSync } = await import("node:sqlite");
+        const db = new DatabaseSync(join(f.root, "session.sqlite"), { readOnly: true });
+        try { return db.prepare("select * from model_usage").all(); }
+        finally { db.close(); }
+      };
+      try {
+        const context = f.context(controller.signal);
+        const artifacts = context.artifactStore as NodeToolArtifactStore;
+        context.artifactStore = new Proxy(artifacts, {
+          get(target, name) {
+            if (name === "writeToolResultArtifactOnce") return async (input: any) => {
+              if (input.idempotencyKey.endsWith(":completed") && failCompletion) {
+                failCompletion = false;
+                throw new Error("completion receipt unavailable");
+              }
+              return target.writeToolResultArtifactOnce(input);
+            };
+            const value = target[name as keyof NodeToolArtifactStore];
+            return typeof value === "function" ? value.bind(target) : value;
+          },
