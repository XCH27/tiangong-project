+} from "../src/v4/composer/composerDraftStore.js";
+import { resolveEffectiveModelSelection } from "@zcode/provider";
+import {
+  readComposerRecent,
+  captureComposerRecentSubmission,
+  rememberComposerModelChoice,
+} from "../src/lib/composerRecent.js";
+import { createComposerSubmissionConfig } from "../src/v4/composer/composerSubmissionConfig.js";
+import { useZCodeSessionStore } from "../src/store/zcodeSessionStore.js";
+import { resolveNewTaskModelChoice } from "../src/v4/composer/newTaskDraft.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const check = (value: unknown, message: string) => {
+  if (!value) throw new Error(message);
+};
+const results: Array<{ name: string; error?: string }> = [];
+const auto = (modelId: string) => ({
+  providerId: "connected",
+  modelId,
+  options: { reasoningLevel: "auto" },
+});
+const models = ["a", "b"].map((modelId) => ({
+  modelId,
+  config: {
+    properties: { contextWindow: 200000, contextWindows: [200000, 400000] },
+    optionSpecs: {
+      reasoningLevel: { values: ["auto", "low", "high"], defaultValue: "auto", map: "{}" },
+      speedMode: "openai-priority",
+    },
+  },
+  evidenceConfig: {
+    optionSpecs: {
+      reasoningLevel: { values: ["auto", "low", "high"], defaultValue: "auto", map: "{}" },
+    },
+  },
+}));
+
+async function fixture() {
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  let catalog = {
+    revision: 1,
+    providers: [
+      {
+        providerId: "connected",
+        providerName: "Connected",
+        config: { access: { type: "api-key" }, api: { type: "openai-responses" } },
+        models,
+      },
+    ],
+    preferredSelection: auto("a"),
+  };
+  const listeners = new Set<(view: any) => void>();
+  const service = {
+    onDidChange: (listener: (view: any) => void) => {
+      listeners.add(listener);
+      return {
+        dispose() {
+          listeners.delete(listener);
+        },
+      };
+    },
+    async getView(input?: any) {
+      return {
+        ...catalog,
+        ...(input
+          ? resolveEffectiveModelSelection({
+              selection: input.selection,
+              registry: catalog as never,
+              classifyProvider: () => "ordinary",
+            })
+          : {}),
+      };
+    },
+  };
+  const services = {
+    modelSelectionService: service,
+    settingService: { get: async () => ({}) },
+    broadcastService: {},
+    botsService: {},
+    zcodeAgentService: {},
+    zcodeSessionService: {},
+  };
+  let latest: ReturnType<typeof useDraftConfigControl>;
+  function Probe({
+    path,
+    session,
+    config,
+  }: {
+    path: string;
+    session: string | null;
+    config?: any;
+  }) {
+    latest = useDraftConfigControl({
+      workspacePath: path,
+      sessionId: session,
+      sessionConfig: config,
+      modelSelectionService: service as never,
+      agentStartupAllowed: false,
+    });
+    return <output>{latest.draftConfig.model ?? "none"}</output>;
+  }
+  return {
+    node,
+    get latest() {
+      return latest!;
+    },
+    get view() {
+      return catalog;
+    },
+    async render(path: string, session: string | null = null, config?: any) {
+      await act(async () =>
+        root.render(
+          <ServiceProvider services={services as never}>
+            <PlatformProvider platform={{} as never}>
+              <TabStoreProvider>
+                <Probe path={path} session={session} config={config} />
+              </TabStoreProvider>
+            </PlatformProvider>
+          </ServiceProvider>,
+        ),
+      );
+    },
+    async catalog(next: any) {
+      catalog = next;
+      await act(async () => {
+        for (const listener of listeners) listener(catalog);
+      });
+    },
+    async choose(model: string) {
+      await act(async () => latest.handleDraftSelectModel("connected", model));
+    },
+    async close() {
+      await act(async () => root.unmount());
+      node.remove();
+    },
+  };
+}
+async function test(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({ name, error: String(error) });
+  }
+}
