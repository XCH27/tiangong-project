+    for (const option of ["speedMode", "contextWindow"] as const) {
+      const checked = validateModelSelectionOptions(model, selection);
+      if (
+        !checked.ok &&
+        checked.code ===
+          (option === "speedMode" ? "speed-mode-not-supported" : "context-window-not-supported")
+      ) {
+        const options: NonNullable<ModelSelection["options"]> = { ...selection.options };
+        delete options[option];
+        selection = { ...selection, options };
+      }
+    }
+    if (validateModelSelectionOptions(model, selection).ok) return selection;
+  }
+  return undefined;
