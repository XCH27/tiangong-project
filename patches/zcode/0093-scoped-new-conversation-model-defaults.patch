+/** An empty reused composer is a new-chat preference, not unfinished user input. */
+export function resetEmptyV4DraftModel(workspacePath: string, workspaceIdentity?: string): void {
+  const draft = readV4ComposerDraft(workspacePath, workspaceIdentity, V4_DRAFT_SCOPE_ROOT);
+  if (!draft?.modelSelection || draft.text.trim() || draft.mention) return;
+  if (draft.editorStateJson) {
+    try {
+      const hasContent = (node: unknown): boolean => {
+        if (!isRecord(node)) return true;
+        if (typeof node.text === "string" && node.text.trim()) return true;
+        if (!["root", "paragraph", "text", "linebreak"].includes(String(node.type))) return true;
+        return Array.isArray(node.children) && node.children.some(hasContent);
+      };
+      if (hasContent(JSON.parse(draft.editorStateJson).root)) return;
+    } catch {
+      return;
+    } // Unknown editor data is retained, never discarded as an empty draft.
+  }
+  persistV4ComposerDraft(workspacePath, workspaceIdentity, V4_DRAFT_SCOPE_ROOT, {
+    ...draft,
+    modelSelection: undefined,
+  });
+}
