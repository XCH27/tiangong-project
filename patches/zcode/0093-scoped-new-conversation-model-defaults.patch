+/** A picker choice is a scoped preference, not an accepted execution or another Session writer. */
+export function rememberComposerModelChoice(
+  workspacePath: string,
+  selection: ModelSelection,
+  workspaceIdentity?: string,
+  storage: StorageLike | null = browserStorage(),
+): void {
+  if (!storage) return;
+  const modelSelection = normalizeSparseModelSelection(selection);
+  if (!modelSelection) return;
+  const key = resolveComposerRecentKey(workspacePath, workspaceIdentity);
+  let accepted = acceptedSequences.get(storage);
+  if (!accepted) {
+    accepted = new Map();
+    acceptedSequences.set(storage, accepted);
+  }
+  // A pending older send must not roll back a later human choice on its eventual ACK.
+  accepted.set(key, ++submissionSequence);
+  const previous = readComposerRecent(workspacePath, workspaceIdentity, storage);
+  try {
+    storage.setItem(key, JSON.stringify({ ...previous, modelSelection }));
+  } catch (error) {
+    logger.warn("[ComposerRecent] 保存模型偏好失败", { workspacePath, workspaceIdentity, error });
+  }
+}
