+      check(
+        f.latest.draftConfig.model === "a",
+        "The initialized empty draft remained permanently unselected",
+      );
+      check(
+        f.latest.composerDraft.text === "keep my input" &&
+          f.latest.composerDraft.mode === "yolo" &&
+          f.latest.composerDraft.planEnabled,
