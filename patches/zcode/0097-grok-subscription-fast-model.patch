diff --git a/packages/shared/src/grok-model-variants.ts b/packages/shared/src/grok-model-variants.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb0e99e4ba8de0936f932e8e4e4830da5856b04a
--- /dev/null
+++ b/packages/shared/src/grok-model-variants.ts
@@ -0,0 +1,27 @@
+// Verified native subscription pair. Never derive routes by appending a name suffix.
+const GROK_BUILD_SPEED_PAIRS = [{ standard: "grok-4.7", fast: "grok-4.7-build-fast" }] as const;
+
+export function isGrokBuildFastModel(modelId: string): boolean {
+  return GROK_BUILD_SPEED_PAIRS.some((pair) => pair.fast === modelId);
+}
+
+/** Availability belongs to this connected catalog, not another account or a public API name. */
+export function resolveGrokBuildSpeedPair(
+  access: { type?: string; provider?: string; connected?: boolean } | null | undefined,
+  models: readonly { modelId: string; enabled?: boolean }[],
+  modelId: string | undefined,
+): { standard: string; fast: string; mode: "standard" | "fast" } | undefined {
+  if (access?.type !== "subscription" || access.provider !== "xai" || access.connected !== true)
+    return;
+  const pair = GROK_BUILD_SPEED_PAIRS.find(
+    (item) => item.standard === modelId || item.fast === modelId,
+  );
+  if (
+    !pair ||
+    ![pair.standard, pair.fast].every((id) =>
+      models.some((model) => model.modelId === id && model.enabled !== false),
+    )
+  )
+    return;
+  return { ...pair, mode: modelId === pair.fast ? "fast" : "standard" };
+}
