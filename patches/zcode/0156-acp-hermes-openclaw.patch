+  await drain(turn);
+  await turn.close();
+  assert.ok(!agent.log().some((entry) => entry.method === "session/set_config_option" && entry.params.configId === "model"));
+});
+
+test("Hermes has no plan mode, so Fleet's plan refuses its change requests itself", async () => {
+  const agent = fakeAgent();
+  const turn = createAcpNativeAgentPort("hermes").createTurn({
+    ...request(agent.script, { collaborationMode: "plan" }),
+    model: { modelId: "k3", options: {}, nativeExecutor: { kind: "hermes", executable: agent.script } } as never,
+  });
+  await drain(turn);
+  await turn.close();
+  const log = agent.log();
+  assert.ok(!log.some((entry) => entry.method === "session/set_config_option" && entry.params.value === "plan"));
+  assert.deepEqual(log.find((entry) => entry.permissionOutcome)?.permissionOutcome, { outcome: "selected", optionId: "no" });
+});
