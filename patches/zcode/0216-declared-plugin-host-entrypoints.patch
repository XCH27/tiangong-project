@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import { chmod, mkdir, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import test from "node:test";
+import { ZCODE_PLUGIN_HOST_COMMAND } from "@zcode/contracts";
+import {
+  createBundledMcpRuntimeConfig,
+  officialPluginHostPrefixArgs,
+  writeOfficialPluginRuntimeManifest,
+} from "../src/app/official-plugin-runtime.js";
+
+const marker = `// zcode-cli-capability: ${ZCODE_PLUGIN_HOST_COMMAND}`;
+const sourceEntry = resolve(import.meta.dirname, "../../cli/src/main.ts");
+
+test("official launcher admits declared source/generated/symlink CLI entries and preserves args", async () => {
+  const root = await mkdtemp(join(tmpdir(), "launcher-admission-"));
+  const previous = process.argv;
+  try {
+    // Importing the build module does not invoke its guarded build entrypoint.
+    const buildModulePath = "../../cli/scripts/build.mjs";
+    const { createCliBundleBanner } = await import(buildModulePath);
+    const generated = join(root, "zcode.cjs");
+    const linked = join(root, "zcode-link.cjs");
+    const banner = createCliBundleBanner(Buffer.from("authored notices"));
+    assert.ok(banner.startsWith(`#!/usr/bin/env node\n${marker}\n`));
+    await writeFile(generated, `${banner}\n}\n`);
+    await symlink(generated, linked);
+    for (const entry of [sourceEntry, generated, linked]) {
+      process.argv = [process.execPath, entry, "ordinary-argument"];
+      const prefix = [...process.execArgv, resolve(entry), ZCODE_PLUGIN_HOST_COMMAND];
+      assert.deepEqual(officialPluginHostPrefixArgs(), prefix);
+      const runtime = createBundledMcpRuntimeConfig({
+        cwd: root, rootPath: root, env: { AUTHORED: "retained" }, timeoutMs: 123,
+      });
+      assert.deepEqual(runtime?.args, [...prefix, join(root, "dist", "mcp", "server.js")]);
+      assert.equal(runtime?.command, process.execPath);
+      assert.equal(runtime?.cwd, root);
+      assert.equal(runtime?.timeoutMs, 123);
+      assert.deepEqual(runtime?.env, { AUTHORED: "retained", ELECTRON_RUN_AS_NODE: "1" });
+    }
+    assert.ok((await readFile(sourceEntry, "utf8")).startsWith(`${marker}\n`));
+  } finally {
+    process.argv = previous;
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("arbitrary/test/missing/nonfile/late-declared entries refuse without rewriting manifests", async () => {
+  const root = await mkdtemp(join(tmpdir(), "launcher-refusal-"));
+  const previous = process.argv;
+  try {
+    const arbitrary = join(root, "embedded.js"), late = join(root, "late.cjs");
+    await writeFile(arbitrary, "throw new Error('must never execute');\n");
+    await writeFile(late, `${" ".repeat(4096)}\n${marker}\n`);
+    await mkdir(join(root, ".zcode-plugin"));
+    const manifestPath = join(root, ".zcode-plugin", "plugin.json");
+    const original = JSON.stringify({ mcpServers: { server: { command: "original-command", args: ["original-argument"] } } });
+    await writeFile(manifestPath, original);
+    for (const entry of [arbitrary, import.meta.filename, join(root, "missing"), root, late]) {
+      process.argv = [process.execPath, entry];
+      assert.equal(officialPluginHostPrefixArgs(), undefined);
+      assert.equal(createBundledMcpRuntimeConfig({ cwd: root, rootPath: root }), undefined);
+      writeOfficialPluginRuntimeManifest({ rootPath: root, pluginName: "authored" });
+      assert.equal(await readFile(manifestPath, "utf8"), original);
+    }
+    process.argv = [process.execPath];
+    assert.equal(officialPluginHostPrefixArgs(), undefined);
+    if (process.platform !== "win32" && process.getuid?.() !== 0) {
+      const unreadable = join(root, "unreadable.cjs");
+      await writeFile(unreadable, `${marker}\n`);
+      await chmod(unreadable, 0);
+      process.argv = [process.execPath, unreadable];
+      assert.equal(officialPluginHostPrefixArgs(), undefined);
+    }
+  } finally {
+    process.argv = previous;
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+test("SEA retains direct plugin-host command without inspecting the embedding entrypoint", () => {
+  const original = process.getBuiltinModule;
+  const replacement = ((id: string) => id === "node:sea" ? { isSea: () => true } : original(id)) as typeof original;
+  const previous = process.argv;
+  try {
+    process.getBuiltinModule = replacement;
+    process.argv = [process.execPath, "arbitrary-unreadable-entry"];
+    assert.deepEqual(officialPluginHostPrefixArgs(), [ZCODE_PLUGIN_HOST_COMMAND]);
+  } finally {
+    process.getBuiltinModule = original;
+    process.argv = previous;
+  }
+});
