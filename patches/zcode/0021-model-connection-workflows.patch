+} from "@zcode/contracts";
+import { createModel, type ModelExecutionRequest } from "../src/model/model.js";
+import { toAiSdkMessages } from "../src/model/transform.js";
+
+const TEXT_INPUT: ModelInputFormat = {
+  supportsText: true,
+  supportsImage: false,
+  supportsVideo: false,
