+import type { Event } from "@zcode/rpc";
+import { ServiceChannels, modelSelectionSchema } from "@zcode/shared";
+import { z } from "zod";
+import {
+  completeNewModelSelection,
+  normalizeModelSelection,
+  type ModelSelection,
+  type ModelSelectionFacade,
+  type ModelSelectionView,
+  type ModelSelectionViewInput,
+} from "@zcode/provider";
+import { createServiceDescriptor } from "../descriptors.js";
+import { createServiceLogger } from "../logger/serviceLogger.js";
+
+export interface ModelPreferences {
+  readonly defaultModelSelection?: ModelSelection;
+  readonly favoriteModelSelections: readonly ModelSelection[];
+}
+export interface ModelPreferencesPatch {
+  readonly defaultModelSelection?: ModelSelection | null;
+  readonly favoriteModelSelections?: readonly ModelSelection[];
+}
+export interface IModelSelectionService {
+  readonly onDidChange: Event<ModelSelectionView>;
+  getView(input?: ModelSelectionViewInput): Promise<ModelSelectionView>;
+  getPreferences(): Promise<ModelPreferences>;
+  savePreferences(patch: ModelPreferencesPatch): Promise<ModelPreferences>;
+}
+
+export interface ModelSelectionConfiguredDefaultSource {
+  read(): Promise<ModelSelection | undefined>;
+  readPreferences?(): Promise<ModelPreferences>;
+  savePreferences?(patch: ModelPreferencesPatch): Promise<void>;
+  onDidChange?(listener: () => void): () => void;
+}
+
+export const IModelSelectionService = createServiceDescriptor<IModelSelectionService>(
+  ServiceChannels.ModelSelection,
+);
+
+export function createModelSelectionService(
+  facade: ModelSelectionFacade,
+  ensureReady: () => Promise<void> = async () => {},
+  configuredDefaultSource?: ModelSelectionConfiguredDefaultSource,
+  applyChanges: () => Promise<void> = async () => {},
+): IModelSelectionService & { dispose(): void } {
+  const log = createServiceLogger("model-selection");
+  let revision = 0;
+  let disposed = false;
+  const listeners = new Set<(view: ModelSelectionView) => void>();
+  const readStablePreferences = async () => {
+    await ensureReady();
+    // 配置读取跨异步边界；读取期间发生更新时，旧结果不能标成新 revision 覆盖新设置。
+    for (let attempt = 0; attempt < 3; attempt += 1) {
+      if (disposed) throw new Error("ModelSelectionService 已 dispose");
+      revision = Math.max(revision, facade.getView().revision);
+      const startedRevision = revision;
+      const preferences = (await configuredDefaultSource?.readPreferences?.()) ?? {
+        defaultModelSelection: await configuredDefaultSource?.read(),
+        favoriteModelSelections: [],
+      };
+      if (disposed) throw new Error("ModelSelectionService 已 dispose");
+      if (revision === startedRevision && facade.getView().revision <= startedRevision)
+        return { preferences, revision: startedRevision };
+    }
+    throw new Error("Model preferences changed while loading; refresh to try again");
+  };
+  const getView = async (input?: ModelSelectionViewInput): Promise<ModelSelectionView> => {
+    const snapshot = await readStablePreferences();
+    return {
+      ...facade.getView(snapshot.preferences.defaultModelSelection, snapshot.revision, input),
+      favoriteModelSelections: snapshot.preferences.favoriteModelSelections,
+    };
+  };
+  const emit = (): void => {
+    if (disposed) return;
+    revision += 1;
+    void getView().then(
+      (view) => {
+        if (disposed) return;
+        for (const listener of listeners) listener(view);
+      },
+      (error: unknown) => {
+        // Registry 事件触发的异步 View 重建没有 owner；Host dispose 后它仍会继续
+        // 读取已释放的配置仓库，并形成未处理 rejection。dispose 是明确的取消边界；仅在服务
+        // 仍存活时记录真实读取失败。
+        if (disposed) return;
+        log.warn(undefined, `ModelSelection View 刷新失败: ${String(error)}`);
+      },
+    );
+  };
+  const disposeFacade = facade.onDidChange(emit);
+  const disposeConfiguredDefault = configuredDefaultSource?.onDidChange?.(emit);
+
+  return {
+    onDidChange: (listener) => {
+      listeners.add(listener);
+      return { dispose: () => listeners.delete(listener) };
+    },
+    getView,
+    async getPreferences() {
+      return (await readStablePreferences()).preferences;
+    },
+    async savePreferences(input) {
+      await ensureReady();
+      if (!configuredDefaultSource?.savePreferences)
+        throw new Error("Model preferences are unavailable on this host");
+      const patch = z
+        .object({
+          defaultModelSelection: modelSelectionSchema.nullable().optional(),
+          favoriteModelSelections: z.array(modelSelectionSchema).max(100).optional(),
+        })
+        .strict()
+        .parse(input);
+      const view = await getView();
+      const validate = (selection: ModelSelection): ModelSelection => {
+        const effective = selection.options?.reasoningLevel
+          ? normalizeModelSelection(view, selection)
+          : completeNewModelSelection(view, selection);
+        if (
+          !effective ||
+          (selection.options?.reasoningLevel &&
+            effective.options?.reasoningLevel !== selection.options.reasoningLevel)
+        )
+          throw new Error("This model or reasoning level is no longer available");
+        return effective;
+      };
+      if (patch.defaultModelSelection)
+        patch.defaultModelSelection = validate(patch.defaultModelSelection);
+      if (patch.favoriteModelSelections) {
+        const unique = new Map<string, ModelSelection>();
+        const existing = new Map(
+          (view.favoriteModelSelections ?? []).map((selection) => [
+            JSON.stringify([selection.providerId, selection.modelId]),
+            selection,
+          ]),
+        );
+        for (const selection of patch.favoriteModelSelections) {
+          const key = JSON.stringify([selection.providerId, selection.modelId]);
+          // 暂停/删除供应商不应阻塞其它收藏编辑；已保存的不可用收藏保留身份，新增仍需校验。
+          let effective: ModelSelection;
+          try {
+            effective = validate(selection);
+          } catch (error) {
+            const saved = existing.get(key);
+            if (!saved) throw error;
+            effective = saved;
+          }
+          unique.set(key, effective);
+        }
+        patch.favoriteModelSelections = [...unique.values()];
+      }
+      await configuredDefaultSource.savePreferences(patch);
+      await applyChanges();
+      return (
+        (await configuredDefaultSource.readPreferences?.()) ?? {
+          defaultModelSelection: await configuredDefaultSource.read(),
+          favoriteModelSelections: [],
+        }
+      );
+    },
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      disposeFacade();
+      disposeConfiguredDefault?.();
+      listeners.clear();
+    },
+  };
+}
