diff --git a/packages/ui/src/settings/model-provider-section/CcSwitchImportSection.tsx b/packages/ui/src/settings/model-provider-section/CcSwitchImportSection.tsx
new file mode 100644
index 0000000..97b83cb
--- /dev/null
+++ b/packages/ui/src/settings/model-provider-section/CcSwitchImportSection.tsx
@@ -0,0 +1,187 @@
+import { useEffect, useRef, useState } from "react";
+import { ArrowLeft, Download, FolderOpen, Loader2 } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { Checkbox } from "@/components/ui/checkbox.js";
+import { useServices } from "@/hooks/useServices.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+type Preview = Awaited<
+  ReturnType<ReturnType<typeof useServices>["providerSettingsService"]["previewCcSwitchImport"]>
+>;
+
+export function CcSwitchImportSection({
+  onBack,
+  onComplete,
+}: {
+  onBack: () => void;
+  onComplete: (providerId: string) => void;
+}) {
+  const { providerSettingsService } = useServices();
+  const platform = usePlatform();
+  const { intl } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.modelProvider.import.${key}` });
+  const [preview, setPreview] = useState<Preview>();
+  const [selected, setSelected] = useState<string[]>([]);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+  const [failedRows, setFailedRows] = useState<string[]>([]);
+  const mounted = useRef(true);
+  const lock = useRef(false);
+  const load = async (path?: string) => {
+    if (lock.current) return;
+    lock.current = true;
+    setBusy(true);
+    setError(undefined);
+    try {
+      const result = await providerSettingsService.previewCcSwitchImport(path);
+      if (!mounted.current) return;
+      setPreview(result);
+      setSelected(result.rows.filter((row) => row.eligible).map((row) => row.id));
+      setFailedRows([]);
+    } catch {
+      if (mounted.current) {
+        setPreview(undefined);
+        setError(t("readFailed"));
+      }
+    } finally {
+      lock.current = false;
+      if (mounted.current) setBusy(false);
+    }
+  };
+  useEffect(() => {
+    mounted.current = true;
+    void load();
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  const submit = async () => {
+    if (!preview || lock.current || !selected.length) return;
+    lock.current = true;
+    setBusy(true);
+    setError(undefined);
+    try {
+      const result = await providerSettingsService.importCcSwitchProviders({
+        path: preview.path,
+        revision: preview.revision,
+        ids: selected,
+      });
+      if (!mounted.current) return;
+      const failed = result.results.filter((row) => row.error).map((row) => row.id);
+      if (failed.length) {
+        setFailedRows(failed);
+        setSelected(failed);
+        setError(t("partialFailed"));
+      } else {
+        const first = result.results.find((row) => row.providerId)?.providerId;
+        if (first) onComplete(first);
+        else onBack();
+      }
+    } catch {
+      if (mounted.current) setError(t("sourceChanged"));
+    } finally {
+      lock.current = false;
+      if (mounted.current) setBusy(false);
+    }
+  };
+  const reason = (code?: string) =>
+    t(
+      code === "app-not-supported"
+        ? "unsupportedClient"
+        : code === "already-imported"
+          ? "alreadyImported"
+          : code === "gemini-native-protocol-not-supported" || code === "protocol-not-supported"
+            ? "unsupportedProtocol"
+            : code === "oauth-account-not-supported"
+              ? "subscriptionUnsupported"
+              : code === "custom-headers-not-supported"
+                ? "unsupportedHeaders"
+                : code === "full-endpoint-url-not-supported"
+                  ? "unsupportedEndpoint"
+                  : "incomplete",
+    );
+  return (
+    <section className="space-y-4">
+      <div className="flex items-center gap-3">
+        <Button
+          variant="ghost"
+          size="icon-sm"
+          disabled={busy}
+          onClick={onBack}
+          aria-label={t("back")}
+        >
+          <ArrowLeft className="size-4" />
+        </Button>
+        <h2 className="text-ui-lg font-semibold">{t("title")}</h2>
+      </div>
+      <p className="text-ui-base text-foreground-subtle">{t("description")}</p>
+      {preview ? (
+        <p className="break-all text-ui-sm text-foreground-subtle">{preview.path}</p>
+      ) : null}
+      <div className="space-y-2">
+        {preview?.rows.map((row) => (
+          <label
+            key={row.id}
+            className="flex items-start gap-3 rounded-lg border border-border bg-surface p-3"
+          >
+            <Checkbox
+              className="mt-0.5"
+              checked={selected.includes(row.id)}
+              disabled={busy || !row.eligible}
+              onCheckedChange={(checked) =>
+                setSelected((current) =>
+                  checked ? [...current, row.id] : current.filter((id) => id !== row.id),
+                )
+              }
+            />
+            <div className="min-w-0 space-y-1">
+              <div className="text-ui-base font-medium">
+                {row.name}{" "}
+                <span className="text-ui-sm font-normal text-foreground-subtle">{row.appType}</span>
+              </div>
+              <p className="break-all text-ui-sm text-foreground-subtle">{row.baseUrl}</p>
+              {row.modelIds.length ? (
+                <p className="break-words text-ui-sm text-foreground-subtle">
+                  {row.modelIds.join(" · ")}
+                </p>
+              ) : null}
+              {!row.eligible ? (
+                <p className="text-ui-sm text-foreground-subtle">{reason(row.reason)}</p>
+              ) : null}
+              {failedRows.includes(row.id) ? (
+                <p className="text-ui-sm text-destructive">{t("rowFailed")}</p>
+              ) : null}
+            </div>
+          </label>
+        ))}
+        {preview && !preview.rows.length ? (
+          <p className="text-ui-base text-foreground-subtle">{t("empty")}</p>
+        ) : null}
+      </div>
+      {error ? (
+        <p role="alert" className="text-ui-base text-destructive">
+          {error}
+        </p>
+      ) : null}
+      <div className="flex flex-wrap items-center justify-end gap-2">
+        <Button
+          variant="secondary"
+          disabled={busy || !platform.canSelectFilePath}
+          onClick={async () => {
+            const file = await platform.selectFile();
+            if (file) void load(file);
+          }}
+        >
+          <FolderOpen className="size-4" />
+          {t("chooseFile")}
+        </Button>
+        <Button disabled={busy || !selected.length || !preview} onClick={() => void submit()}>
+          {busy ? <Loader2 className="size-4 animate-spin" /> : <Download className="size-4" />}
+          {t("confirm")}
+          {selected.length ? ` (${selected.length})` : ""}
+        </Button>
+      </div>
+    </section>
+  );
+}
