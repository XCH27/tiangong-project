diff --git a/packages/services/src/model-provider/ccSwitchImport.ts b/packages/services/src/model-provider/ccSwitchImport.ts
new file mode 100644
index 0000000..e358285
--- /dev/null
+++ b/packages/services/src/model-provider/ccSwitchImport.ts
@@ -0,0 +1,338 @@
+import { createHash } from "node:crypto";
+import { realpath, stat } from "node:fs/promises";
+import { createRequire } from "node:module";
+import { homedir } from "node:os";
+import { extname, join, resolve } from "node:path";
+import { parse as parseToml } from "smol-toml";
+import type { ProviderConfigObject, ProviderSettingsFacade } from "@zcode/provider";
+
+// 与既有 Host Repo 一致，避免打包器把 node:sqlite 改写成 npm sqlite。
+const { DatabaseSync } = createRequire(import.meta.url)(
+  "node:sqlite",
+) as typeof import("node:sqlite");
+
+export interface CcSwitchImportRow {
+  readonly id: string;
+  readonly name: string;
+  readonly appType: string;
+  readonly baseUrl: string;
+  readonly modelIds: readonly string[];
+  readonly eligible: boolean;
+  readonly reason?: string;
+}
+
+export interface CcSwitchImportPreview {
+  readonly path: string;
+  readonly revision: string;
+  readonly rows: readonly CcSwitchImportRow[];
+}
+
+export interface CcSwitchImportInput {
+  readonly path: string;
+  readonly ids: readonly string[];
+  readonly revision: string;
+}
+
+export interface CcSwitchImportResult {
+  readonly results: readonly {
+    readonly id: string;
+    readonly providerId?: string;
+    readonly skipped?: boolean;
+    readonly error?: string;
+  }[];
+}
+
+export interface CcSwitchImportAdapter {
+  preview(path?: string): Promise<CcSwitchImportPreview>;
+  import(input: CcSwitchImportInput): Promise<CcSwitchImportResult>;
+}
+
+type ImportOwner = Pick<ProviderSettingsFacade, "createPersonalProvider" | "addPersonalModel">;
+type ApiType = NonNullable<ProviderConfigObject["api"]>["type"];
+type RecordValue = Record<string, unknown>;
+interface Candidate {
+  readonly row: CcSwitchImportRow;
+  readonly config?: ProviderConfigObject;
+}
+
+/** 外部文件只读；预览不保存密钥快照，确认时重新读取并校验版本后才调用现有写入 Owner。 */
+export function createCcSwitchImportAdapter(
+  owner: ImportOwner,
+  defaultPath = join(homedir(), ".cc-switch", "cc-switch.db"),
+): CcSwitchImportAdapter {
+  const imported = new Map<string, { providerId: string; error?: string }>();
+  let pending: Promise<unknown> = Promise.resolve();
+  const sourceKey = (path: string, id: string) => JSON.stringify([path, id]);
+  return {
+    async preview(path) {
+      const source = await readSource(path ?? defaultPath);
+      return {
+        path: source.path,
+        revision: source.revision,
+        rows: source.candidates.map(({ row }) =>
+          imported.has(sourceKey(source.path, row.id))
+            ? { ...row, eligible: false, reason: "already-imported" }
+            : row,
+        ),
+      };
+    },
+    import(input) {
+      // 同一 Host 的重复点击排队；创建成功即记录 ID，后续模型失败也不能重建第二个 Provider。
+      const operation = pending.then(async (): Promise<CcSwitchImportResult> => {
+        if (!Array.isArray(input.ids) || input.ids.some((id) => typeof id !== "string")) {
+          throw new Error("Invalid CC Switch selection");
+        }
+        const source = await readSource(input.path);
+        if (source.revision !== input.revision) {
+          throw new Error("CC Switch source changed; preview it again before importing");
+        }
+        const candidates = new Map(source.candidates.map((item) => [item.row.id, item]));
+        const results: CcSwitchImportResult["results"][number][] = [];
+        for (const id of new Set(input.ids)) {
+          const key = sourceKey(source.path, id);
+          const previous = imported.get(key);
+          if (previous) {
+            results.push({ id, ...previous, skipped: true });
+            continue;
+          }
+          const candidate = candidates.get(id);
+          if (!candidate?.row.eligible || !candidate.config) {
+            results.push({ id, error: candidate?.row.reason ?? "source-row-unavailable" });
+            continue;
+          }
+          let providerId: string | undefined;
+          try {
+            ({ providerId } = await owner.createPersonalProvider({
+              providerName: candidate.row.name,
+              initialConfig: candidate.config,
+            }));
+            imported.set(key, { providerId });
+            for (const modelId of candidate.row.modelIds) {
+              await owner.addPersonalModel(providerId, modelId, {}, true);
+            }
+            results.push({ id, providerId });
+          } catch {
+            // 底层解析/保存异常可能带配置片段；跨 RPC 只返回固定错误码，不回传原异常。
+            const error = providerId ? "model-import-failed" : "provider-import-failed";
+            if (providerId) imported.set(key, { providerId, error });
+            results.push({ id, ...(providerId ? { providerId } : {}), error });
+          }
+        }
+        return { results };
+      });
+      pending = operation.catch(() => {});
+      return operation;
+    },
+  };
+}
+
+async function readSource(input: string) {
+  if (typeof input !== "string" || extname(input).toLowerCase() !== ".db") {
+    throw new Error("Select a CC Switch .db file");
+  }
+  let db: InstanceType<typeof DatabaseSync> | undefined;
+  try {
+    const path = await realpath(resolve(input));
+    const info = await stat(path);
+    if (!info.isFile()) throw new Error("Invalid file");
+    db = new DatabaseSync(path, { readOnly: true });
+    // 同一个只读事务绑定 rows 与 revision，包含 WAL 中已提交的新数据。
+    db.exec("BEGIN");
+    const rows = db
+      .prepare(
+        "SELECT id, app_type, name, settings_config, meta, category FROM providers ORDER BY app_type, id",
+      )
+      .all();
+    const revision = createHash("sha256").update(JSON.stringify(rows)).digest("hex");
+    const candidates = rows.map((row) => parseCandidate(row));
+    return { path, revision, candidates };
+  } catch {
+    throw new Error("Unable to read CC Switch provider database");
+  } finally {
+    db?.close();
+  }
+}
+
+function record(value: unknown): RecordValue {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as RecordValue) : {};
+}
+
+function text(value: unknown): string {
+  return typeof value === "string" ? value.trim() : "";
+}
+
+function first(...values: unknown[]): string {
+  return values.map(text).find(Boolean) ?? "";
+}
+
+function parseObject(value: unknown): RecordValue {
+  if (typeof value !== "string") throw new Error("Invalid JSON");
+  const parsed: unknown = JSON.parse(value);
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
+    throw new Error("Invalid JSON");
+  return parsed as RecordValue;
+}
+
+function parseCandidate(raw: RecordValue): Candidate {
+  const appType = text(raw.app_type);
+  const id = JSON.stringify([appType, text(raw.id)]);
+  const row = { id, appType, name: text(raw.name), baseUrl: "", modelIds: [] as string[] };
+  try {
+    const settings = parseObject(raw.settings_config);
+    const meta = parseObject(raw.meta ?? "{}");
+    const env = record(settings.env);
+    const auth = record(settings.auth);
+    const toml =
+      appType === "codex" && typeof settings.config === "string" ? parseToml(settings.config) : {};
+    const active = record(record(toml.model_providers)[text(toml.model_provider)]);
+    let apiKey = "";
+    let apiType: ApiType;
+    if (appType === "claude") {
+      row.baseUrl = first(
+        env.ANTHROPIC_BASE_URL,
+        settings.base_url,
+        settings.baseURL,
+        settings.apiEndpoint,
+      );
+      apiKey = first(
+        env.ANTHROPIC_AUTH_TOKEN,
+        env.ANTHROPIC_API_KEY,
+        env.OPENROUTER_API_KEY,
+        env.GOOGLE_API_KEY,
+        env.OPENAI_API_KEY,
+        env.GEMINI_API_KEY,
+        settings.apiKey,
+        settings.api_key,
+      );
+      apiType = protocol(
+        first(meta.apiFormat, settings.api_format, settings.apiFormat) || "anthropic",
+      );
+      row.modelIds = [
+        env.ANTHROPIC_MODEL,
+        env.ANTHROPIC_DEFAULT_HAIKU_MODEL,
+        env.ANTHROPIC_DEFAULT_SONNET_MODEL,
+        env.ANTHROPIC_DEFAULT_OPUS_MODEL,
+      ]
+        .map(text)
+        .filter(Boolean);
+    } else if (appType === "codex") {
+      row.baseUrl = first(active.base_url, toml.base_url, settings.base_url, settings.baseURL);
+      apiKey = first(
+        auth.OPENAI_API_KEY,
+        // CC Switch 不从 Codex 保留 Provider 的 table 读取 bearer，只接受顶层兼容字段。
+        ["amazon-bedrock", "amazon-bedrock-runtime", "openai", "ollama", "lmstudio"].includes(
+          text(toml.model_provider),
+        )
+          ? undefined
+          : active.experimental_bearer_token,
+        toml.experimental_bearer_token,
+      );
+      apiType = protocol(
+        first(
+          meta.apiFormat,
+          settings.api_format,
+          settings.apiFormat,
+          active.wire_api,
+          toml.wire_api,
+        ) || "responses",
+      );
+      row.modelIds = [text(toml.model)].filter(Boolean);
+    } else if (appType === "gemini") {
+      row.baseUrl = first(env.GOOGLE_GEMINI_BASE_URL, settings.base_url, settings.baseURL);
+      apiKey = first(env.GEMINI_API_KEY, env.GOOGLE_API_KEY, settings.apiKey, settings.api_key);
+      row.modelIds = [text(env.GEMINI_MODEL)].filter(Boolean);
+    }
+    row.modelIds = [...new Set(row.modelIds)];
+    const oauth =
+      ["codex_oauth", "github_copilot", "xai_oauth"].includes(text(meta.providerType)) ||
+      (appType === "codex" && raw.id === "codex-official" && raw.category === "official") ||
+      record(meta.authBinding).source === "managed_account" ||
+      /chatgpt\.com\/backend-api|githubcopilot\.com/.test(row.baseUrl) ||
+      /^sk-ant-oat|^ya29\.|^eyJ[^.]*\.|^\s*\{/.test(apiKey) ||
+      (!apiKey && (auth.tokens !== undefined || auth.access_token !== undefined));
+    let reason = oauth
+      ? "oauth-account-not-supported"
+      : appType === "gemini"
+        ? "gemini-native-protocol-not-supported"
+        : !["claude", "codex"].includes(appType)
+          ? "app-not-supported"
+          : !apiType
+            ? "protocol-not-supported"
+            : !apiKey
+              ? "api-key-missing"
+              : !row.baseUrl
+                ? "base-url-missing"
+                : undefined;
+    // Full URL 与额外认证头依赖 CC Switch 代理的行为，当前 API Adapter 不能无损复现。
+    if (!reason && meta.isFullUrl === true) reason = "full-endpoint-url-not-supported";
+    if (
+      !reason &&
+      [settings.headers, active.http_headers, active.env_http_headers].some(
+        (headers) => Object.keys(record(headers)).length > 0,
+      )
+    )
+      reason = "custom-headers-not-supported";
+    if (row.baseUrl) {
+      try {
+        const url = new URL(row.baseUrl);
+        if (!["https:", "http:"].includes(url.protocol)) reason ??= "invalid-base-url";
+        if (
+          url.username ||
+          url.password ||
+          url.search ||
+          url.hash ||
+          (apiKey && row.baseUrl.includes(apiKey))
+        ) {
+          reason = "credential-bearing-url-not-supported";
+          row.baseUrl = `${url.protocol}//${url.host}`;
+        }
+      } catch {
+        row.baseUrl = "";
+        reason ??= "invalid-base-url";
+      }
+    }
+    // 即使来源把密钥误填进名称/模型，预览也不能把已识别密钥带到 Renderer。
+    if (apiKey) {
+      row.name = row.name.replaceAll(apiKey, "[redacted]");
+      row.modelIds = row.modelIds.map((model) => model.replaceAll(apiKey, "[redacted]"));
+    }
+    return {
+      row: { ...row, eligible: !reason, ...(reason ? { reason } : {}) },
+      ...(!reason && apiType
+        ? {
+            config: {
+              access: { type: "api-key", apiKey },
+              api: { type: apiType, baseUrl: row.baseUrl },
+            },
+          }
+        : {}),
+    };
+  } catch {
+    return { row: { ...row, eligible: false, reason: "invalid-provider-config" } };
+  }
+}
+
+function protocol(value: string): ApiType {
+  const normalized = value.toLowerCase();
+  if (
+    ["anthropic", "anthropic_messages", "anthropic-messages", "claude", "messages"].includes(
+      normalized,
+    )
+  )
+    return "anthropic-messages";
+  if (
+    [
+      "chat",
+      "chat_completions",
+      "chat-completions",
+      "openai_chat",
+      "openai-chat",
+      "openai_chat_completions",
+      "openai-chat-completions",
+    ].includes(normalized)
+  )
+    return "openai-chat-completions";
+  if (["responses", "openai_responses", "openai-responses"].includes(normalized))
+    return "openai-responses";
+  return undefined;
+}
