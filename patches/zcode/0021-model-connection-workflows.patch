+import type { ReactNode } from "react";
+import { ExternalLinkIcon } from "lucide-react";
+import { Button } from "@/components/ui/button.js";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { PlanStatusCardSurface } from "./PlanStatusCardSurface.js";
+import { ModelConfigHelp } from "./ModelConfigHelp.js";
+
+const SUBSCRIPTION_GUIDES = {
+  "openai-codex": "https://chatgpt.com/pricing/",
+  xai: "https://docs.x.ai/grok/faq",
+  "github-copilot": "https://github.com/features/copilot/plans",
+} as const;
+
+/** 复用原版状态卡；说明和公共指南不负责授权，实际登录仍由连接 owner 生成地址。 */
+export function SubscriptionConnectCard({
+  kind,
+  action,
+}: {
+  kind: keyof typeof SUBSCRIPTION_GUIDES;
+  action: ReactNode;
+}) {
+  const { intl } = useZCodeIntl();
+  const platform = usePlatform();
+  const t = (field: string) =>
+    intl.formatMessage({ id: `settings.modelProvider.subscription.info.${kind}.${field}` });
+  return (
+    <PlanStatusCardSurface
+      planTitle={t("title")}
+      titleAccessory={<ModelConfigHelp field="subscriptionAuthorization" />}
+      statusMeta={
+        <p className="text-ui-base leading-relaxed text-foreground-subtle">{t("description")}</p>
+      }
+      trailingAction={action}
+      usageContent={
+        <div className="space-y-2 text-ui-base leading-relaxed text-foreground-subtle">
+          <p>{t("flow")}</p>
+          <p>{t("scope")}</p>
+          <Button
+            type="button"
+            variant="link"
+            className="h-auto p-0"
+            onClick={() => void platform.openExternal(SUBSCRIPTION_GUIDES[kind])}
+          >
+            {intl.formatMessage({ id: "settings.modelProvider.subscription.info.guide" })}
+            <ExternalLinkIcon className="size-3.5" aria-hidden="true" />
+          </Button>
+        </div>
+      }
+    />
+  );
+}
