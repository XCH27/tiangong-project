diff --git a/packages/ui/src/settings/DefaultModelsSection.tsx b/packages/ui/src/settings/DefaultModelsSection.tsx
new file mode 100644
index 0000000..5bc85ac
--- /dev/null
+++ b/packages/ui/src/settings/DefaultModelsSection.tsx
@@ -0,0 +1,269 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { Star } from "lucide-react";
+import { completeNewModelSelection } from "@zcode/provider";
+import { type ModelSelection, ZCODE_AGENT_PROVIDER } from "@zcode/shared";
+import { useServices } from "@/hooks/useServices.js";
+import { useModelSelectionServiceView } from "@/hooks/useModelSelectionView.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { buildRegistryModelSelectGroups } from "@/lib/modelSelectionGroups.js";
+import { encodeCustomModelValue, decodeCustomModelValue } from "@/lib/zcodeCustomModelValue.js";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { SettingsGroupCard, SettingsRow } from "./SettingsPageParts.js";
+import { Button } from "@/components/ui/button.js";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select.js";
+
+type Preferences = {
+  defaultModelSelection?: ModelSelection;
+  favoriteModelSelections: readonly ModelSelection[];
+};
+
+export function DefaultModelsSection() {
+  const { modelSelectionService } = useServices();
+  const { intl } = useZCodeIntl();
+  const t = (key: string) => intl.formatMessage({ id: `settings.defaultModels.${key}` });
+  const read = useModelSelectionServiceView(modelSelectionService);
+  const view = read.state.status === "ready" ? read.state.view : null;
+  const [preferences, setPreferences] = useState<Preferences>();
+  const [busy, setBusy] = useState(false);
+  const [reloadToken, setReloadToken] = useState(0);
+  const [error, setError] = useState<string>();
+  const lock = useRef(false);
+  const generation = useRef(0);
+  useEffect(() => {
+    const current = ++generation.current;
+    let request = 0;
+    const load = () => {
+      const sequence = ++request;
+      void modelSelectionService.getPreferences().then(
+        (result) => {
+          if (generation.current === current && sequence === request) setPreferences(result);
+        },
+        () => {
+          if (generation.current === current) setError(t("readFailed"));
+        },
+      );
+    };
+    load();
+    const subscription = modelSelectionService.onDidChange(load);
+    return () => {
+      generation.current++;
+      subscription.dispose();
+    };
+  }, [modelSelectionService, reloadToken]);
+  const save = useCallback(
+    async (patch: {
+      defaultModelSelection?: ModelSelection | null;
+      favoriteModelSelections?: readonly ModelSelection[];
+    }) => {
+      if (lock.current) return;
+      lock.current = true;
+      const current = generation.current;
+      setBusy(true);
+      setError(undefined);
+      try {
+        const result = await modelSelectionService.savePreferences(patch);
+        if (generation.current === current) setPreferences(result);
+      } catch {
+        if (generation.current === current) setError(t("saveFailed"));
+      } finally {
+        lock.current = false;
+        if (generation.current === current) setBusy(false);
+      }
+    },
+    [modelSelectionService],
+  );
+  const configured = preferences?.defaultModelSelection;
+  const selected = view?.preferredSelection;
+  const unavailableDefault = Boolean(
+    configured &&
+    view &&
+    !view.providers.some(
+      (provider) =>
+        provider.providerId === configured.providerId &&
+        provider.models.some(
+          (model) =>
+            model.modelId === configured.modelId &&
+            (!configured.options?.reasoningLevel ||
+              model.config.optionSpecs.reasoningLevel.values.includes(
+                configured.options.reasoningLevel,
+              )),
+        ),
+    ),
+  );
+  const value = selected ? encodeCustomModelValue(selected.providerId, selected.modelId) : "";
+  const groups = view
+    ? buildRegistryModelSelectGroups(ZCODE_AGENT_PROVIDER, view, { favoritesLabel: t("favorites") })
+    : [];
+  const selectedModel = view?.providers
+    .find((provider) => provider.providerId === selected?.providerId)
+    ?.models.find((model) => model.modelId === selected?.modelId);
+  const levels = selectedModel?.config.optionSpecs.reasoningLevel.values ?? [];
+  const disabled = busy || !view || !preferences;
+  const choose = (next: string) => {
+    const decoded = decodeCustomModelValue(next);
+    if (!view || !decoded?.modelName) return;
+    const selection = completeNewModelSelection(view, {
+      providerId: decoded.providerId,
+      modelId: decoded.modelName,
+    });
+    if (selection) void save({ defaultModelSelection: selection });
+  };
+  return (
+    <div className="space-y-6">
+      <SettingsGroupCard>
+        <SettingsRow
+          label={t("chat")}
+          description={t("chatDescription")}
+          control={
+            <ModelConfigSelect
+              modelGroups={groups}
+              normalizedValue={value}
+              triggerLabel={selected?.modelId ?? t("select")}
+              disabled={disabled || !groups.length}
+              showManageModelsAction={false}
+              lockReasonMessage=""
+              isItemLocked={() => false}
+              onValueChange={choose}
+              triggerClassName="border border-input-border bg-input"
+              focusSelectorOnClose={null}
+            />
+          }
+        />
+        <SettingsRow
+          label={t("effort")}
+          description={t("effortDescription")}
+          control={
+            <Select
+              value={selected?.options?.reasoningLevel ?? ""}
+              disabled={disabled || !levels.length}
+              onValueChange={(reasoningLevel) => {
+                if (selected)
+                  void save({
+                    defaultModelSelection: { ...selected, options: { reasoningLevel } },
+                  });
+              }}
+            >
+              <SelectTrigger className="min-w-28">
+                <SelectValue placeholder={t("select")} />
+              </SelectTrigger>
+              <SelectContent>
+                {levels.map((level) => (
+                  <SelectItem key={level} value={level}>
+                    {[
+                      "default",
+                      "none",
+                      "off",
+                      "disabled",
+                      "auto",
+                      "minimal",
+                      "low",
+                      "medium",
+                      "high",
+                      "xhigh",
+                      "max",
+                    ].includes(level)
+                      ? t(`effort.${level}`)
+                      : level}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          }
+        />
+      </SettingsGroupCard>
+      {unavailableDefault ? (
+        <div className="flex items-center justify-between gap-3 text-ui-base text-foreground-subtle">
+          <span>{t("unavailableDefault")}</span>
+          <Button
+            variant="ghost"
+            disabled={busy}
+            onClick={() => void save({ defaultModelSelection: null })}
+          >
+            {t("clearDefault")}
+          </Button>
+        </div>
+      ) : null}
+      <section className="space-y-3">
+        <h2 className="text-ui-lg font-semibold">{t("favorites")}</h2>
+        <p className="text-ui-base text-foreground-subtle">{t("favoritesDescription")}</p>
+        {view?.providers.map((provider) => (
+          <div key={provider.providerId} className="space-y-2">
+            <h3 className="text-ui-sm text-foreground-subtle">
+              {provider.providerName ?? provider.providerId}
+            </h3>
+            <div className="divide-y divide-border rounded-lg border border-border">
+              {provider.models.map((model) => {
+                const active =
+                  preferences?.favoriteModelSelections.some(
+                    (item) =>
+                      item.providerId === provider.providerId && item.modelId === model.modelId,
+                  ) ?? false;
+                return (
+                  <div
+                    key={model.modelId}
+                    className="flex items-center justify-between gap-3 px-3 py-2"
+                  >
+                    <span className="truncate text-ui-base">{model.modelId}</span>
+                    <Button
+                      variant="ghost"
+                      size="icon-sm"
+                      disabled={disabled}
+                      aria-pressed={active}
+                      aria-label={`${t(active ? "unfavorite" : "favorite")} ${model.modelId}`}
+                      onClick={() => {
+                        if (!view || !preferences) return;
+                        const next = preferences.favoriteModelSelections.filter(
+                          (item) =>
+                            item.providerId !== provider.providerId ||
+                            item.modelId !== model.modelId,
+                        );
+                        if (!active) {
+                          const selection = completeNewModelSelection(view, {
+                            providerId: provider.providerId,
+                            modelId: model.modelId,
+                          });
+                          if (selection) next.push(selection);
+                        }
+                        void save({ favoriteModelSelections: next });
+                      }}
+                    >
+                      <Star className="size-4" fill={active ? "currentColor" : "none"} />
+                    </Button>
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        ))}
+        {view && !view.providers.length ? (
+          <p className="text-ui-base text-foreground-subtle">{t("empty")}</p>
+        ) : null}
+      </section>
+      {error || read.state.status === "error" ? (
+        <div
+          role="alert"
+          className="flex items-center justify-between gap-3 text-ui-base text-destructive"
+        >
+          <span>{error ?? t("readFailed")}</span>
+          <Button
+            variant="ghost"
+            disabled={busy}
+            onClick={() => {
+              setError(undefined);
+              read.reload();
+              setReloadToken((value) => value + 1);
+            }}
+          >
+            {intl.formatMessage({ id: "common.retry" })}
+          </Button>
+        </div>
+      ) : null}
+    </div>
+  );
+}
