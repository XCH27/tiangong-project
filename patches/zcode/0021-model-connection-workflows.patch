diff --git a/apps/zcode-cli/packages/adapters/src/model/subscription-thinking.ts b/apps/zcode-cli/packages/adapters/src/model/subscription-thinking.ts
new file mode 100644
index 0000000..1e11b7b
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/model/subscription-thinking.ts
@@ -0,0 +1,48 @@
+import {
+  clampThinkingLevel,
+  type Model,
+  type ModelThinkingLevel,
+  type ThinkingLevelMap,
+} from "@earendil-works/pi-ai";
+import { ModelErrorCode, ModelFailureReason, ModelProtocolError } from "@zcode/contracts";
+
+const levels: readonly ModelThinkingLevel[] = ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
+
+export function bindSubscriptionThinkingLevels(
+  model: Model<string>,
+  supported: readonly string[],
+  kind: "openai-codex" | "xai" | "github-copilot",
+): Model<string> {
+  // Codex/Grok 目录已给出原生档位；Pi 静态同名模型不能再缩减或改写它们。
+  // Copilot 有多种原生协议，保留该协议的映射，只在请求前禁止静默 clamp。
+  if (kind === "github-copilot") return model;
+  const thinkingLevelMap: ThinkingLevelMap = {};
+  for (const level of levels) {
+    thinkingLevelMap[level] = supported.includes(level) ? (level === "off" ? "none" : level) : null;
+  }
+  return {
+    ...model,
+    reasoning: supported.some((level) => level !== "off"),
+    thinkingLevelMap,
+  };
+}
+
+export function assertSubscriptionThinkingLevel(
+  model: Model<string>,
+  supported: readonly string[],
+  selected: string,
+): asserts selected is ModelThinkingLevel {
+  // 先于账号刷新和网络请求拒绝不支持的选值，避免把 UI 所选高档静默降成 low/high。
+  if (
+    !supported.includes(selected) ||
+    !levels.some((level) => level === selected) ||
+    clampThinkingLevel(model, selected as ModelThinkingLevel) !== selected
+  ) {
+    // 结构化请求错误必须保留不可重试原因；普通 Error 会落入 workflow 的默认重试分支。
+    throw new ModelProtocolError(
+      ModelErrorCode.InvalidModelRequest,
+      `Unsupported subscription reasoning level: ${selected}; no exact adapter mapping`,
+      { reason: ModelFailureReason.InvalidRequest, retryable: false, source: "runtime" },
+    );
+  }
+}
