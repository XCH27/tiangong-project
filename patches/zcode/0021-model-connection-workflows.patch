+  { type: "video", mediaType: "video/mp4", dataUrl: VIDEO_DATA },
+  { type: "file", mediaType: "video/mp4", dataUrl: VIDEO_DATA, name: "fixture.mp4" },
+];
+
+function fixture(
+  inputFormat = TEXT_INPUT,
+  execute?: (request: ModelExecutionRequest) => Promise<void>,
+) {
+  let executions = 0;
+  const model = createModel({
+    providerId: "fixture" as ModelProviderId,
+    modelId: "fixture-model" as ModelId,
+    properties: {
+      contextWindow: 4096,
+      requiresMfjsToolSchema: false,
+      inputFormat,
+      outputFormat: { supportsText: true },
+      supportsToolCall: true,
+      supportsJsonSchemaOutput: false,
+      supportsNativeWebSearch: false,
+      supportsMidConversationSystem: false,
+    },
+    optionSpecs: {
+      maxOutputTokens: { max: 512, map: "{}" },
+      reasoningLevel: { values: ["default"], map: "{}" },
+    },
+    options: { maxOutputTokens: 128, reasoningLevel: "default" },
+    executor: {
+      async generateText(request) {
+        executions++;
+        await execute?.(request);
+        return { text: "OK", finishReason: "stop", usage: {} };
+      },
+      async *streamText(request) {
+        executions++;
+        await execute?.(request);
+        yield { type: "start" };
+      },
+    },
+  });
+  return { model, count: () => executions };
+}
+
