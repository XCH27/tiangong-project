@@ -0,0 +1,66 @@
+import {
+  getUnsupportedModelInputMediaKind,
+  isProviderVisibleVideoModelInputBlock,
+  ModelErrorCode,
+  ModelFailureReason,
+  type ModelInputFormat,
+  type ModelInputMessage,
+  type ModelMessageContentBlock,
+} from "@zcode/contracts";
+import { AiSdkModelAdapterError } from "./errors.js";
+import { dataUrlToDataContent } from "./media-transform-policy.js";
+
+interface VideoProjectionOptions {
+  apiFormat?: string;
+  providerOptions?: Record<string, unknown>;
+  providerKind?: string;
+  stripMedia?: boolean;
+  inputFormat?: ModelInputFormat;
+}
+
+export function isNativeVideoInput(block: ModelMessageContentBlock): boolean {
+  // file 的提取正文在 transform 中优先作为文本发送，不是原生视频投递。
+  return (
+    isProviderVisibleVideoModelInputBlock(block) &&
+    !(block.type === "file" && block.text !== undefined && block.text.length > 0)
+  );
+}
+
+export function validateAiSdkVideoInputs(
+  messages: readonly ModelInputMessage[],
+  options: VideoProjectionOptions,
+): void {
+  if (options.stripMedia) return;
+  const apiFormat = options.apiFormat ?? options.providerOptions?.apiFormat;
+  // 当前只有这两个补丁能序列化 video；Responses 不可因目录声明而被当成可投递。
+  const routeSupportsVideo =
+    (options.providerKind === "anthropic" &&
+      (apiFormat === undefined || apiFormat === "anthropic-messages")) ||
+    (options.providerKind === "openai-compatible" &&
+      (apiFormat === undefined || apiFormat === "openai-chat-completions"));
+  for (const message of messages) {
+    if (message.role !== "user" && (message.role !== "tool" || message.isError)) continue;
+    if (!Array.isArray(message.content)) continue;
+    for (const block of message.content) {
+      if (!isNativeVideoInput(block)) continue;
+      const unsupported = options.inputFormat
+        ? getUnsupportedModelInputMediaKind(block, options.inputFormat)
+        : undefined;
+      if (unsupported) throw invalidVideo(`Model does not support ${unsupported}`);
+      if (!routeSupportsVideo)
+        throw invalidVideo("Selected API adapter does not support video input");
+      if (
+        (block.type === "video" || block.type === "file") &&
+        (!block.dataUrl || !dataUrlToDataContent(block.dataUrl))
+      ) {
+        throw invalidVideo("Video input data is empty or invalid");
+      }
+    }
+  }
+}
+
+function invalidVideo(message: string): AiSdkModelAdapterError {
+  return new AiSdkModelAdapterError(ModelErrorCode.InvalidModelRequest, message, {
+    context: { reason: ModelFailureReason.InvalidRequest, retryable: false, source: "runtime" },
+  });
+}
