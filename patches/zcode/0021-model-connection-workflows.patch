diff --git a/apps/zcode-cli/packages/core/test/compact-policy.test.ts b/apps/zcode-cli/packages/core/test/compact-policy.test.ts
new file mode 100644
index 0000000..dd260e0
--- /dev/null
+++ b/apps/zcode-cli/packages/core/test/compact-policy.test.ts
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { CompactModelMessage } from "../src/compact/manual.js";
+import {
+  getAutoCompactThreshold,
+  getEffectiveContextWindowSize,
+  shouldAutoCompact,
+} from "../src/compact/policy.js";
+
+const smallWindow = { contextWindow: 8_000, maxOutputTokens: 4_000 };
+const shortConversation: CompactModelMessage[] = [
+  { role: "user", content: "Hi" },
+  { role: "assistant", content: "Hello" },
+  { role: "user", content: "Next" },
+  { role: "assistant", content: "Okay" },
+];
+
+test("a short conversation in an 8K window does not compact after two rounds", () => {
+  const decision = shouldAutoCompact({
+    config: smallWindow,
+    messages: shortConversation,
+    tokenOverride: { source: "provider_usage", tokenCount: 6 },
+  });
+  assert.equal(decision.effectiveContextWindow, 4_000);
+  assert.equal(decision.outputReserveTokens, 4_000);
+  assert.equal(decision.threshold, 3_600);
+  assert.equal(decision.reason, "below_threshold");
+  assert.equal(decision.shouldCompact, false);
+});
+
+test("small-window compaction retains the exact inclusive threshold boundary", () => {
+  for (const [tokenCount, expected] of [
+    [3_599, false],
+    [3_600, true],
+  ] as const) {
+    const decision = shouldAutoCompact({
+      config: smallWindow,
+      messages: shortConversation,
+      tokenOverride: { source: "provider_usage", tokenCount },
+    });
+    assert.equal(decision.shouldCompact, expected);
+    assert.equal(decision.reason, expected ? "above_threshold" : "below_threshold");
+  }
+});
+
+test("200K and 1M windows preserve the existing 21K output reserve and 13K buffer", () => {
+  for (const [contextWindow, threshold] of [
+    [200_000, 166_000],
+    [1_000_000, 966_000],
+  ] as const) {
+    const config = { contextWindow, maxOutputTokens: 32_000 };
+    assert.equal(getEffectiveContextWindowSize(config), contextWindow - 21_000);
+    assert.equal(getAutoCompactThreshold(config), threshold);
+  }
+});
+
+test("explicit buffers, including zero and an oversized value, retain their semantics", () => {
+  assert.equal(getAutoCompactThreshold({ ...smallWindow, bufferTokens: 0 }), 4_000);
+  assert.equal(getAutoCompactThreshold({ ...smallWindow, bufferTokens: 1_000 }), 3_000);
+  assert.equal(getAutoCompactThreshold({ ...smallWindow, bufferTokens: 13_000 }), 0);
+});
+
+test("disabled compaction and its failure circuit breaker still suppress threshold triggers", () => {
+  const input = {
+    messages: shortConversation,
+    tokenOverride: { source: "provider_usage" as const, tokenCount: 4_000 },
+  };
+  const disabled = shouldAutoCompact({ ...input, config: { ...smallWindow, enabled: false } });
+  assert.equal(disabled.shouldCompact, false);
+  assert.equal(disabled.reason, "disabled");
+  const stopped = shouldAutoCompact({ ...input, config: smallWindow, consecutiveFailures: 3 });
+  assert.equal(stopped.shouldCompact, false);
+  assert.equal(stopped.reason, "circuit_breaker");
+});
+
+test("insufficient conversation history still suppresses compaction above the threshold", () => {
+  const decision = shouldAutoCompact({
+    config: smallWindow,
+    messages: shortConversation.slice(0, 1),
+    tokenOverride: { source: "provider_usage", tokenCount: 4_000 },
+  });
+  assert.equal(decision.shouldCompact, false);
+  assert.equal(decision.reason, "not_enough_messages");
+});
+
+test("default buffering never consumes a positive input window or invents an empty one", () => {
+  assert.equal(getAutoCompactThreshold({ contextWindow: 101, maxOutputTokens: 100 }), 1);
+  assert.equal(getEffectiveContextWindowSize({ contextWindow: 8_000, maxOutputTokens: 8_000 }), 0);
+  assert.equal(getAutoCompactThreshold({ contextWindow: 8_000, maxOutputTokens: 8_000 }), 0);
+});
