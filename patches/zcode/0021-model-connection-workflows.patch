+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ModelSelectionFacade, ModelSelectionView } from "@zcode/provider";
+import { providerProvisioningPersonalConfigSchema } from "@zcode/shared";
+import {
+  createModelSelectionService,
+  type ModelPreferences,
+} from "../src/model-provider/modelSelectionService.js";
+import {
+  completeNewModelSelection,
+  createRegistryModelConfig,
+  createRegistryProviderConfig,
+  normalizeModelSelection,
+  parseModelConfig,
+  parseProviderConfig,
+  ProviderRegistry,
+  resolveInitialModelSelection,
+} from "@zcode/provider";
+import { createModelCatalogPort } from "../../../apps/zcode-cli/packages/bootstrap/src/app/model-catalog-port.js";
+import {
+  listRegistryBackedModels,
+  resolveRegistryOwnedModelSelection,
+} from "../../../apps/zcode-cli/packages/bootstrap/src/app/provider-registry-selection.js";
+
+const selection = (modelId: string) => ({ providerId: "synthetic", modelId });
+
+test("a preference read started before a change cannot publish old data at the new revision", async () => {
+  let changed = () => {};
+  let release!: (value: ModelPreferences) => void;
+  let started!: () => void;
+  const reading = new Promise<void>((resolve) => {
+    started = resolve;
+  });
+  const oldRead = new Promise<ModelPreferences>((resolve) => {
+    release = resolve;
+  });
+  let count = 0;
+  const current = { favoriteModelSelections: [selection("new")] };
+  const facade = {
+    getView: (_default?: unknown, revision = 0) => ({ revision, providers: [] }),
+    onDidChange: () => () => {},
+  } as unknown as ModelSelectionFacade;
+  const service = createModelSelectionService(facade, async () => {}, {
+    read: async () => undefined,
+    readPreferences: async () => {
+      if (++count === 1) {
+        started();
+        return oldRead;
+      }
+      return current;
+    },
+    onDidChange: (listener) => {
+      changed = listener;
+      return () => {};
+    },
+  });
+  try {
+    const event = new Promise<ModelSelectionView>((resolve) => service.onDidChange(resolve));
+    const pending = service.getView();
+    await reading;
+    changed();
+    const latest = await event;
+    release({ favoriteModelSelections: [selection("old")] });
+    const late = await pending;
+    assert.deepEqual(latest.favoriteModelSelections, current.favoriteModelSelections);
+    assert.deepEqual(late.favoriteModelSelections, current.favoriteModelSelections);
+    assert.ok(late.revision >= latest.revision);
+  } finally {
+    service.dispose();
+  }
+});
+
+test("the provisioning envelope preserves favorite preferences, including an explicitly empty list", () => {
+  const base = {
+    providerConfigRules: { providerRules: [] },
+    modelConfigRules: { providerModelRules: [], manualProviderModelRules: [] },
+    defaultModelSelection: selection("default"),
+  };
+  for (const favoriteModelSelections of [[], [selection("favorite")]]) {
+    const input = { ...base, favoriteModelSelections };
+    assert.deepEqual(providerProvisioningPersonalConfigSchema.parse(input), input);
+  }
+});
+
+test("new selections use the declared default effort without rewriting an explicit saved selection", async () => {
+  const { completeNewModelSelection, normalizeModelSelection } = await import("@zcode/provider");
+  const view = {
+    providers: [
+      {
+        providerId: "synthetic",
+        models: [
+          {
+            modelId: "native",
+            config: {
+              optionSpecs: {
+                reasoningLevel: { values: ["low", "medium", "high"], defaultValue: "medium" },
+              },
+            },
+          },
+        ],
+      },
+    ],
+  };
+  const target = { providerId: "synthetic", modelId: "native" };
+  assert.equal(completeNewModelSelection(view, target)?.options?.reasoningLevel, "medium");
+  assert.equal(
+    normalizeModelSelection(view, { ...target, options: { reasoningLevel: "low" } })?.options
+      ?.reasoningLevel,
+    "low",
+  );
+});
+
+for (const [defaultValue, expected] of [
+  ["medium", "medium"],
+  ["unsupported", "high"],
+  [undefined, "high"],
+] as const) {
+  test(`Composer and Agent model projections share the declared default (${String(defaultValue)})`, () => {
+    const provider = createRegistryProviderConfig(
+      parseProviderConfig({
+        group: "standard-personal",
+        api: { type: "openai-chat-completions", baseUrl: "https://synthetic.example/v1" },
+        access: { type: "api-key", apiKey: "synthetic-key" },
+      }),
+    );
+    const model = createRegistryModelConfig(
+      parseModelConfig({
+        enabled: true,
+        properties: {
+          contextWindow: 4096,
+          requiresMfjsToolSchema: false,
+          inputFormat: {
+            supportsText: true,
+            supportsImage: false,
+            supportsVideo: false,
+            supportsAudio: false,
+            supportsPdf: false,
+          },
+          outputFormat: { supportsText: true },
+          supportsToolCall: true,
+          supportsJsonSchemaOutput: false,
+          supportsNativeWebSearch: false,
+          supportsMidConversationSystem: false,
+        },
+        optionSpecs: {
+          maxOutputTokens: { max: 512, map: "{}" },
+          reasoningLevel: { values: ["low", "medium", "high"], defaultValue, map: "{}" },
+        },
+      }),
+    );
+    assert.ok(provider.ok);
+    assert.ok(model.ok);
+    const registry = new ProviderRegistry([
+      {
+        providerId: "synthetic",
+        config: provider.config,
+        models: [{ modelId: "native", config: model.config }],
+      },
+    ]);
+    const target = { providerId: "synthetic", modelId: "native" };
+    const explicit = { ...target, options: { reasoningLevel: "high" } };
+    const original = structuredClone(explicit);
+    const view = registry.getView();
+    const composer = listRegistryBackedModels(registry)[0]!;
+    const agent = createModelCatalogPort({
+      registry,
+      currentSelection: () => explicit,
+    }).listModels()[0]!;
+    assert.equal(composer.reasoning?.defaultLevel, expected);
+    assert.equal(agent.defaultReasoningLevel, expected);
+    assert.equal(completeNewModelSelection(view, target)?.options?.reasoningLevel, expected);
+    assert.deepEqual(agent.reasoningLevels, ["low", "medium", "high"]);
+    assert.equal(agent.current, true);
+    assert.equal(normalizeModelSelection(view, explicit), explicit);
+    assert.deepEqual(resolveRegistryOwnedModelSelection(registry, explicit)?.selection, original);
+    assert.deepEqual(
+      resolveInitialModelSelection({ registry: view, configuredDefault: explicit }),
+      {
+        source: "configured-default",
+        selection: original,
+      },
+    );
+    assert.deepEqual(explicit, original);
+  });
