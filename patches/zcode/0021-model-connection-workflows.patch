diff --git a/apps/zcode-cli/packages/adapters/test/responses-contract.test.ts b/apps/zcode-cli/packages/adapters/test/responses-contract.test.ts
new file mode 100644
index 0000000..4c2b6d8
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/test/responses-contract.test.ts
@@ -0,0 +1,233 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { generateText, streamText } from "ai";
+import { createRegistryProviderConfig, parseProviderConfig } from "@zcode/provider";
+import { ModelErrorCode, type ModelInputFormat, type ModelInputMessage } from "@zcode/contracts";
+import { AiSdkModelExecution } from "../src/model/model-execution.js";
+import { toAiSdkMessages } from "../src/model/transform.js";
+import { toAiSdkTools } from "../src/model/tool-transform.js";
+
+const MODEL = "fixture-model";
+const KEY = "synthetic-responses-key";
+const URL = "https://synthetic.example/v1/responses";
+const IMAGE =
+  "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jO1cAAAAASUVORK5CYII=";
+const PDF = "data:application/pdf;base64,JVBERi1zeW50aGV0aWM=";
+const INPUT: ModelInputFormat = {
+  supportsText: true,
+  supportsImage: true,
+  supportsPdf: true,
+  supportsVideo: true,
+  supportsAudio: false,
+};
+
+interface RequestBody {
+  model: string;
+  stream?: boolean;
+  reasoning: { effort: string };
+  max_output_tokens: number;
+  input: Array<{
+    type?: string;
+    call_id?: string;
+    arguments?: string;
+    output?: string;
+    content?: Array<{ type: string; image_url?: string; filename?: string; file_data?: string }>;
+  }>;
+  tools: Array<{ type: string; name: string }>;
+}
+
+function fixture() {
+  const requests: Array<{ url: string; authorization: string | null; body: RequestBody }> = [];
+  const call = {
+    type: "function_call",
+    id: "fc_fixture",
+    call_id: "call_fixture",
+    name: "read_file",
+    arguments: '{"path":"fixture"}',
+    status: "completed",
+  };
+  const message = {
+    type: "message",
+    id: "msg_fixture",
+    role: "assistant",
+    status: "completed",
+    content: [{ type: "output_text", text: "OK", annotations: [] }],
+  };
+  const usage = { input_tokens: 7, output_tokens: 3, total_tokens: 10 };
+  const transport: typeof fetch = async (input, init) => {
+    const request = new Request(input, init);
+    const body = (await request.json()) as RequestBody;
+    requests.push({ url: request.url, authorization: request.headers.get("authorization"), body });
+    if (!body.stream) {
+      return Response.json({
+        id: "fixture",
+        object: "response",
+        created_at: 1,
+        model: MODEL,
+        status: "completed",
+        output: [message, call],
+        usage,
+      });
+    }
+    const events = [
+      { type: "response.created", response: { id: "fixture", created_at: 1, model: MODEL } },
+      {
+        type: "response.output_item.added",
+        output_index: 0,
+        item: { type: "message", id: "msg_fixture" },
+      },
+      { type: "response.output_text.delta", item_id: "msg_fixture", delta: "OK" },
+      { type: "response.output_item.done", output_index: 0, item: message },
+      { type: "response.output_item.added", output_index: 1, item: { ...call, arguments: "" } },
+      {
+        type: "response.function_call_arguments.delta",
+        output_index: 1,
+        item_id: "fc_fixture",
+        delta: call.arguments,
+      },
+      { type: "response.output_item.done", output_index: 1, item: call },
+      { type: "response.completed", response: { status: "completed", usage } },
+    ];
+    return new Response(events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""), {
+      headers: { "content-type": "text/event-stream" },
+    });
+  };
+  // 真实运行时负责 SDK、URL、鉴权与 Option Map；只替换底层 transport，禁止访问账户或网络。
+  return { requests, execution: new AiSdkModelExecution({ env: {} }, { transport }) };
+}
+
+test("Responses preserves native request/stream contracts and rejects unwired media/tools", async () => {
+  const { execution, requests } = fixture();
+  const provider = createRegistryProviderConfig(
+    parseProviderConfig({
+      group: "standard-personal",
+      access: { type: "api-key", apiKey: KEY },
+      api: { type: "openai-responses", baseUrl: "https://synthetic.example/v1" },
+    }),
+  );
+  assert.ok(provider.ok);
+  const binding = execution.bindModel({
+    providerId: "synthetic",
+    modelId: MODEL,
+    providerConfig: provider.config,
+    supportsJsonSchemaOutput: false,
+    optionSpecs: {
+      reasoningLevel: { map: "{'reasoning': {'effort': reasoningLevel}}" },
+      maxOutputTokens: { map: "{'max_output_tokens': maxOutputTokens}" },
+    },
+  });
+  const resolved = binding.resolveRequest({
+    options: { reasoningLevel: "high", maxOutputTokens: 128 },
+  });
+  const projection = {
+    apiFormat: "openai-responses",
+    providerKind: "openai" as const,
+    inputFormat: INPUT,
+  };
+  const history: ModelInputMessage[] = [
+    {
+      role: "user",
+      content: [
+        { type: "text", text: "Inspect input" },
+        { type: "image", mediaType: "image/png", dataUrl: IMAGE },
+        { type: "file", mediaType: "application/pdf", name: "fixture.pdf", dataUrl: PDF },
+      ],
+    },
+    {
+      role: "assistant",
+      content: "",
+      toolCalls: [{ id: "prior", name: "read_file", input: { path: "prior" } }],
+    },
+    { role: "tool", toolCallId: "prior", toolName: "read_file", content: "prior result" },
+  ];
+  const messages = toAiSdkMessages(history, projection);
+  const tools = toAiSdkTools(
+    [
+      {
+        name: "read_file",
+        inputSchema: {
+          type: "object",
+          properties: { path: { type: "string" } },
+          required: ["path"],
+        },
+      },
+    ],
+    { providerKind: "openai" },
+  );
+  const result = await generateText({ model: resolved.model, messages, tools, maxRetries: 0 });
+  const streamed = streamText({ model: resolved.model, messages, tools, maxRetries: 0 });
+  assert.equal(result.text, "OK");
+  assert.equal(await streamed.text, "OK");
+  for (const calls of [result.toolCalls, await streamed.toolCalls]) {
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0]!.toolCallId, "call_fixture");
+    assert.equal(calls[0]!.toolName, "read_file");
+    assert.deepEqual(calls[0]!.input, { path: "fixture" });
+  }
+  assert.equal(requests.length, 2);
+  assert.deepEqual(
+    requests.map(({ body }) => Boolean(body.stream)),
+    [false, true],
+  );
+  for (const request of requests) {
+    assert.equal(request.url, URL);
+    assert.equal(request.authorization, `Bearer ${KEY}`);
+    const body = request.body;
+    assert.equal(body.model, MODEL);
+    assert.equal(body.reasoning.effort, "high");
+    assert.equal(body.max_output_tokens, 128);
+    const content = body.input.flatMap((item) => item.content ?? []);
+    assert.equal(content.find((part) => part.type === "input_image")?.image_url, IMAGE);
+    const pdf = content.find((part) => part.type === "input_file");
+    assert.equal(pdf?.filename, "fixture.pdf");
+    assert.equal(pdf?.file_data, PDF);
+    const priorCall = body.input.find((item) => item.type === "function_call");
+    assert.equal(priorCall?.call_id, "prior");
+    assert.deepEqual(JSON.parse(priorCall!.arguments!), { path: "prior" });
+    const priorOutput = body.input.find((item) => item.type === "function_call_output");
+    assert.equal(priorOutput?.call_id, "prior");
+    assert.equal(priorOutput?.output, "prior result");
+    assert.equal(body.tools[0]?.type, "function");
+    assert.equal(body.tools[0]?.name, "read_file");
+  }
+
+  // 声明支持不能绕过 adapter 的投递限制，也不能把 native tool 当作普通函数工具。
+  assert.throws(
+    () =>
+      toAiSdkMessages(
+        [
+          {
+            role: "user",
+            content: [
+              { type: "video", mediaType: "video/mp4", dataUrl: "data:video/mp4;base64,AA==" },
+            ],
+          },
+        ],
+        projection,
+      ),
+    { code: ModelErrorCode.InvalidModelRequest, message: /video/i },
+  );
+  assert.throws(
+    () =>
+      toAiSdkTools(
+        [
+          {
+            name: "WebSearch",
+            inputSchema: { type: "object" },
+            providerNative: {
+              logicalName: "WebSearch",
+              providerToolName: "web_search",
+              kind: "provider_native",
+              fallback: "disabled",
+            },
+          },
+        ],
+        { providerKind: "openai", supportsNativeWebSearch: true },
+      ),
+    {
+      code: ModelErrorCode.InvalidModelRequest,
+      message: /does not encode/,
+    },
+  );
+  assert.equal(requests.length, 2, "rejected media and native tools must not send another request");
+});
