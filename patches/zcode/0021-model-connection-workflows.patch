--- /dev/null
+++ b/packages/services/src/model-provider/modelDiscoveryMetadata.ts
@@ -0,0 +1,55 @@
+import type { ModelConfigObject } from "@zcode/provider";
+
+const record = (value: unknown): Record<string, unknown> =>
+  value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+const positive = (value: unknown): number | undefined =>
+  typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : undefined;
+const strings = (value: unknown): string[] | undefined =>
+  Array.isArray(value) && value.every((item) => typeof item === "string" && item.trim())
+    ? [...new Set(value as string[])]
+    : undefined;
+
+/** 只接受目录明确返回的元数据；ID/名字不建立上下文、输入、工具或思考能力。 */
+export function readDiscoveredModelMetadata(value: unknown): ModelConfigObject {
+  const item = record(value);
+  const architecture = record(item.architecture);
+  const topProvider = record(item.top_provider);
+  const context = positive(item.context_window ?? item.contextWindow ?? item.context_length);
+  const output = positive(
+    item.max_output_tokens ?? item.maxOutputTokens ?? topProvider.max_completion_tokens,
+  );
+  const input = strings(item.input_modalities ?? architecture.input_modalities);
+  const outputs = strings(item.output_modalities ?? architecture.output_modalities);
+  const parameters = strings(item.supported_parameters);
+  const tools =
+    typeof item.supports_tool_calls === "boolean"
+      ? item.supports_tool_calls
+      : parameters
+        ? parameters.includes("tools")
+        : undefined;
+  return {
+    ...(context || input || outputs || tools !== undefined
+      ? {
+          properties: {
+            ...(context ? { contextWindow: context } : {}),
+            ...(input
+              ? {
+                  inputFormat: {
+                    supportsText: input.includes("text"),
+                    supportsImage: input.includes("image"),
+                    supportsVideo: input.includes("video"),
+                    supportsAudio: input.includes("audio"),
+                    supportsPdf: input.includes("pdf"),
+                  },
+                }
+              : {}),
+            ...(outputs ? { outputFormat: { supportsText: outputs.includes("text") } } : {}),
+            ...(tools !== undefined ? { supportsToolCall: tools } : {}),
+          },
+        }
+      : {}),
+    ...(output ? { optionSpecs: { maxOutputTokens: { max: output } } } : {}),
+  };
+}
