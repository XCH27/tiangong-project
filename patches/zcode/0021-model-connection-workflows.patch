+++ b/packages/services/test/cc-switch-import.test.ts
@@ -0,0 +1,344 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+import { createRegistryProviderConfig, parseProviderConfig } from "@zcode/provider";
+import { NodeModelSelectionConfigRepository } from "@zcode/provider-node";
+import { createCcSwitchImportAdapter } from "../src/model-provider/ccSwitchImport.js";
+import { createProviderConfigRuntime } from "../src/model-provider/providerConfigRuntime.js";
+import { ProviderRuntime } from "../src/model-provider/providerRuntime.js";
+import { AiSdkModelExecution } from "../../../apps/zcode-cli/packages/adapters/src/model/model-execution.js";
+
+type SourceRow = {
+  id: string;
+  app: string;
+  name?: string;
+  settings: unknown;
+  meta?: unknown;
+  category?: string;
+};
+const CLAUDE_KEY = "synthetic-claude-import-key";
+const CODEX_KEY = "synthetic-codex-import-key";
+
+async function fixture(rows: SourceRow[]) {
+  const dir = await mkdtemp(join(tmpdir(), "fleet-cc-switch-import-"));
+  const path = join(dir, "cc-switch.db");
+  const db = new DatabaseSync(path);
+  db.exec(
+    "CREATE TABLE providers (id TEXT, app_type TEXT, name TEXT, settings_config TEXT, meta TEXT, category TEXT, PRIMARY KEY(id, app_type))",
+  );
+  const insert = db.prepare("INSERT INTO providers VALUES (?, ?, ?, ?, ?, ?)");
+  for (const row of rows)
+    insert.run(
+      row.id,
+      row.app,
+      row.name ?? row.id,
+      JSON.stringify(row.settings),
+      JSON.stringify(row.meta ?? {}),
+      row.category ?? null,
+    );
+  db.close();
+  const configRuntime = createProviderConfigRuntime({
+    personalFilePath: join(dir, "personal.json"),
+    zcodeBuiltinFilePath: fileURLToPath(
+      new URL("../../../config/provider/zcode-builtin.json", import.meta.url),
+    ),
+    personalPollingIntervalMs: false,
+    watch: false,
+  });
+  const runtime = new ProviderRuntime({
+    configRuntime,
+    fetch: async () => {
+      throw new Error("Import must not use the network");
+    },
+  });
+  await runtime.start();
+  return {
+    path,
+    runtime,
+    configRuntime,
+    service: runtime.providerSettings,
+    async dispose() {
+      runtime.dispose();
+      await rm(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+const rows: SourceRow[] = [
+  {
+    id: "shared",
+    app: "claude",
+    name: "Claude gateway",
+    settings: {
+      env: {
+        ANTHROPIC_BASE_URL: "https://claude-gateway.example/custom-prefix",
+        ANTHROPIC_AUTH_TOKEN: CLAUDE_KEY,
+        ANTHROPIC_MODEL: "claude-synthetic",
+        ANTHROPIC_DEFAULT_SONNET_MODEL: "claude-synthetic",
+        ANTHROPIC_DEFAULT_HAIKU_MODEL: "claude-small-synthetic",
+      },
+    },
+  },
+  {
+    id: "shared",
+    app: "codex",
+    name: "Codex gateway",
+    settings: {
+      auth: { OPENAI_API_KEY: CODEX_KEY },
+      config:
+        'model_provider = "chosen"\nmodel = "codex-synthetic"\n[model_providers.unused]\nbase_url = "https://unused.example"\n[model_providers.chosen]\nbase_url = "https://codex-gateway.example/prefix/v1"\nwire_api = "responses"',
+    },
+  },
+  {
+    id: "gemini",
+    app: "gemini",
+    settings: {
+      env: {
+        GOOGLE_GEMINI_BASE_URL: "https://gemini-gateway.example/v1beta",
+        GEMINI_API_KEY: "synthetic-gemini-import-key",
+        GEMINI_MODEL: "gemini-synthetic",
+      },
+    },
+  },
+];
+
+test("preview is secret-free; selected import preserves source, URLs, models, default and Bearer auth", async () => {
+  const f = await fixture(rows);
+  try {
+    const defaults = new NodeModelSelectionConfigRepository({
+      personalRepository: f.configRuntime.personalRepository,
+    });
+    const selection = { providerId: "existing-provider", modelId: "existing-model" };
+    await defaults.saveConfiguredDefault(selection);
+    const before = await readFile(f.path);
+    const preview = await f.service.previewCcSwitchImport(f.path);
+    const serialized = JSON.stringify(preview);
+    for (const key of [
+      CLAUDE_KEY,
+      CODEX_KEY,
+      "synthetic-gemini-import-key",
+      "settings_config",
+      "OPENAI_API_KEY",
+    ]) {
+      assert.equal(serialized.includes(key), false, key);
+    }
+    assert.equal(new Set(preview.rows.map((row) => row.id)).size, 3);
+    const gemini = preview.rows.find((row) => row.appType === "gemini")!;
+    assert.equal(gemini.eligible, false);
+    assert.equal(gemini.reason, "gemini-native-protocol-not-supported");
+    const selected = preview.rows.filter((row) => row.eligible);
+    const result = await f.service.importCcSwitchProviders({
+      ...preview,
+      ids: selected.map((row) => row.id),
+    });
+    assert.equal(result.results.length, 2);
+    assert.ok(result.results.every((row) => row.providerId && !row.error));
+    const providers = (await f.service.getView()).providers;
+    const claude = providers.find(
+      (provider) => provider.providerId === result.results[0]!.providerId,
+    )!;
+    const codex = providers.find(
+      (provider) => provider.providerId === result.results[1]!.providerId,
+    )!;
+    assert.equal(
+      claude.effectiveConfig.api?.baseUrl,
+      "https://claude-gateway.example/custom-prefix",
+    );
+    assert.deepEqual(
+      claude.models.map((model) => model.modelId),
+      ["claude-synthetic", "claude-small-synthetic"],
+    );
+    assert.equal(claude.effectiveConfig.api?.headers, undefined);
+    assert.equal(codex.effectiveConfig.api?.baseUrl, "https://codex-gateway.example/prefix/v1");
+    assert.deepEqual(
+      codex.models.map((model) => model.modelId),
+      ["codex-synthetic"],
+    );
+    assert.deepEqual(await defaults.read(), selection);
+    assert.deepEqual(await readFile(f.path), before);
+
+    const requests: Request[] = [];
+    const execution = new AiSdkModelExecution(
+      { env: {} },
+      {
+        transport: async (input, init) => {
+          requests.push(new Request(input, init));
+          return Response.json({
+            id: "synthetic",
+            type: "message",
+            role: "assistant",
+            model: "claude-synthetic",
+            content: [{ type: "text", text: "OK" }],
+            stop_reason: "end_turn",
+            stop_sequence: null,
+            usage: { input_tokens: 1, output_tokens: 1 },
+          });
+        },
+      },
+    );
+    const config = createRegistryProviderConfig(parseProviderConfig(claude.effectiveConfig));
+    assert.ok(config.ok);
+    const binding = execution.bindModel({
+      providerId: claude.providerId,
+      modelId: "claude-synthetic",
+      providerConfig: config.config,
+      supportsJsonSchemaOutput: false,
+      optionSpecs: { reasoningLevel: { map: "{}" }, maxOutputTokens: { map: "{}" } },
+    });
+    const request = binding.resolveRequest({
+      options: { reasoningLevel: "default", maxOutputTokens: 8 },
+    });
+    await request.model.doGenerate({
+      prompt: [{ role: "user", content: [{ type: "text", text: "Synthetic fixture" }] }],
+      maxOutputTokens: 8,
+    });
+    assert.equal(requests.length, 1);
+    assert.equal(requests[0]!.headers.get("authorization"), `Bearer ${CLAUDE_KEY}`);
+    assert.equal(requests[0]!.headers.get("x-api-key"), CLAUDE_KEY);
+    defaults.dispose();
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("commit rereads the source and rejects stale content before creating any provider", async () => {
+  const f = await fixture([rows[0]!]);
+  try {
+    const preview = await f.service.previewCcSwitchImport(f.path);
+    const originalIds = (await f.service.getView()).providers.map(
+      (provider) => provider.providerId,
+    );
+    const writer = new DatabaseSync(f.path);
+    writer.prepare("UPDATE providers SET settings_config = ?").run(
+      JSON.stringify({
+        env: {
+          ANTHROPIC_API_KEY: "synthetic-replaced",
+          ANTHROPIC_BASE_URL: "https://changed.example",
+        },
+      }),
+    );
+    writer.close();
+    await assert.rejects(
+      f.service.importCcSwitchProviders({ ...preview, ids: preview.rows.map((row) => row.id) }),
+      /source changed/,
+    );
+    assert.deepEqual(
+      (await f.service.getView()).providers.map((provider) => provider.providerId),
+      originalIds,
+    );
+  } finally {
+    await f.dispose();
+  }
+});
+
+test("concurrent commits and repeated selections create each source row only once per host session", async () => {
+  const f = await fixture([rows[0]!]);
+  try {
+    const preview = await f.service.previewCcSwitchImport(f.path);
+    const input = { ...preview, ids: [preview.rows[0]!.id, preview.rows[0]!.id] };
+    const results = await Promise.all([
+      f.service.importCcSwitchProviders(input),
+      f.service.importCcSwitchProviders(input),
+    ]);
+    assert.equal(results[0]!.results.length, 1);
