+    assert.equal(
+      api === "anthropic-messages" ? part.source.data : part.image_url.url,
+      api === "anthropic-messages" ? IMAGE_DATA.split(",")[1] : IMAGE_DATA,
+    );
+  });
+
+  for (const video of VIDEOS) {
+    for (const role of ["user", "tool"] as const) {
+      test(`${api}: supported ${role} ${video.type} video reaches the native SDK wire`, async () => {
