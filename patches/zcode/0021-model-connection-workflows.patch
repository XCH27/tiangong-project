+  assert.equal(value.code, ModelErrorCode.InvalidModelRequest);
+  assert.equal(value.context?.reason, ModelFailureReason.InvalidRequest);
+  assert.equal(value.context?.retryable, false);
+  assert.equal(value.context?.source, "runtime");
+  return true;
+}
+
+for (const video of VIDEOS) {
+  test(`${video.type} video rejects before generate or stream executor when model lacks support`, async () => {
+    const { model, count } = fixture();
+    const request = { messages: [{ role: "user" as const, content: [video] }] };
+    await assert.rejects(model.generateText(request), invalidRequest);
+    await assert.rejects(async () => {
+      for await (const _ of model.streamText(request)) {
+      }
+    }, invalidRequest);
+    assert.equal(count(), 0);
+  });
+}
+
+for (const text of [undefined, ""]) {
+  test(`PDF without non-empty extracted text rejects before executor (${String(text)})`, async () => {
+    const { model, count } = fixture();
