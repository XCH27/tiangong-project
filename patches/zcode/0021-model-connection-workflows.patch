--- /dev/null
+++ b/packages/provider/src/api-key-credentials.ts
@@ -0,0 +1,13 @@
+interface ApiKeySlots {
+  readonly apiKey?: string | null;
+  readonly additionalApiKeys?: readonly string[] | null;
+  readonly apiKeyEnabledFlags?: readonly boolean[] | null;
+}
+
+/** Enabled credentials are derived from the existing access configuration, never persisted separately. */
+export function getEnabledApiKeys(access: ApiKeySlots): string[] {
+  const keys = [access.apiKey ?? "", ...(access.additionalApiKeys ?? [])].map((key) => key.trim());
+  // 旧配置可能重复同一密钥；任一对应槽位显式停用时，不能借另一重复槽位重新发送它。
+  const disabled = new Set(keys.filter((_, index) => access.apiKeyEnabledFlags?.[index] === false));
+  return [...new Set(keys.filter((key) => key && !disabled.has(key)))];
+}
