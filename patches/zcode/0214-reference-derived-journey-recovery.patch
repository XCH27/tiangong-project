+import { act, useEffect, useState } from "react";
+import { createRoot } from "react-dom/client";
+import type { IServiceAccessor } from "@zcode/services";
+import type { IPlatformService } from "@zcode/shared";
+import type { V4ConversationWorkflowRunArtifactDataResult } from "@zcode/shared/zcode-protocol-v4";
+import { ServiceProvider } from "../src/hooks/useServices.js";
+import { PlatformProvider } from "../src/hooks/usePlatform.js";
+import { TabStoreProvider } from "../src/store/TabStoreProvider.js";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { TooltipProvider } from "../src/components/ui/tooltip.js";
+import { V4PaneConversationProvider } from "../src/v4/V4ConversationContext.js";
+import { useWorkflowRunArtifactData } from "../src/hooks/useWorkflowRunArtifactData.js";
+import { WorkflowArtifactSidePane } from "../src/app-shell/WorkflowArtifactSidePane.js";
+import { WorkflowArtifactTilePreview } from "../src/app-shell/workflow-artifacts/WorkflowArtifactTilePreview.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 30; i++) await Promise.resolve();
+};
+const deferred = <T,>() => {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+};
+const empty: V4ConversationWorkflowRunArtifactDataResult = { items: [], hasMore: false };
+const item = (sequence: number, value: string) => ({
+  sequence,
+  siteId: "authored-site",
+  ordinal: sequence,
+  item: { value },
+});
+const artifact = {
+  id: "table",
+  kind: "table" as const,
+  version: 1,
+  versions: [],
+  itemCount: 1,
+  spec: { columns: [{ field: "value" }], title: "Authored table" },
+};
+const platform = {} as IPlatformService;
+const scope = {
+  workspacePath: `/authored/artifact-${crypto.randomUUID()}`,
+  workspaceKey: "authored",
+};
+function services(agent: ReturnType<typeof nativePresentationAgent>["agent"]): IServiceAccessor {
+  return { zcodeAgentService: agent } as IServiceAccessor;
+}
+function Providers({
+  agent,
+  children,
+}: {
+  agent: ReturnType<typeof nativePresentationAgent>["agent"];
+  children: React.ReactNode;
+}) {
+  return (
+    <PlatformProvider platform={platform}>
+      <ServiceProvider services={services(agent)}>
+        <TabStoreProvider>
+          <ZCodeIntlProvider locale="en-US">
+            <TooltipProvider>{children}</TooltipProvider>
+          </ZCodeIntlProvider>
+        </TabStoreProvider>
+      </ServiceProvider>
+    </PlatformProvider>
+  );
+}
+async function mount() {
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  return {
+    node,
+    root,
+    async close() {
+      await act(async () => root.unmount());
+      node.remove();
+    },
+  };
+}
+async function scenario(name: string, run: () => Promise<void>) {
+  try {
+    await run();
+    results.push({ name });
+  } catch (error) {
+    results.push({
+      name,
+      error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+    });
+  }
+}
+
+async function run() {
+  await scenario(
+    "same mounted original pane context A→B→A cannot lose replacement or final incremental drain",
+    async () => {
+      const view = await mount(),
+        a = nativePresentationAgent(),
+        b = nativePresentationAgent();
+      const readsA: Array<{
+        afterSequence?: number;
+        pending: ReturnType<typeof deferred<V4ConversationWorkflowRunArtifactDataResult>>;
+      }> = [];
+      const readsB: typeof readsA = [];
+      a.agent.conversationWorkflowRunArtifactDataV4 = async (params) => {
+        const pending = deferred<V4ConversationWorkflowRunArtifactDataResult>();
+        readsA.push({ afterSequence: params.afterSequence, pending });
+        return pending.promise;
+      };
+      b.agent.conversationWorkflowRunArtifactDataV4 = async (params) => {
+        const pending = deferred<V4ConversationWorkflowRunArtifactDataResult>();
+        readsB.push({ afterSequence: params.afterSequence, pending });
+        return pending.promise;
+      };
+      let mounts = 0;
+      function Probe({ count }: { count: number }) {
+        const state = useWorkflowRunArtifactData({
+          sessionId: "original-session",
+          runId: "original-run",
+          artifactId: "table",
+          itemCount: count,
+        });
+        useEffect(() => {
+          mounts++;
+        }, []);
+        return <pre data-testid="data-state">{JSON.stringify(state)}</pre>;
+      }
+      const render = async (agent: typeof a.agent, count = 1) => {
+        await act(async () => {
+          view.root.render(
+            <Providers agent={agent}>
+              <V4PaneConversationProvider scope={scope}>
+                <Probe count={count} />
+              </V4PaneConversationProvider>
+            </Providers>,
+          );
+          await tick();
+        });
+      };
+      try {
+        await render(a.agent);
+        check(readsA.length === 1, "initial original A read must start");
+        await render(b.agent);
+        check(readsB.length === 1, "replacement B must read while old A is pending");
+        await render(a.agent);
+        check(readsA.length === 2, "return A has its own current-generation read");
+        check(mounts === 1, "context service replacement retains the actual hook instance");
+        await act(async () => {
+          readsA[0]!.pending.resolve({ items: [item(1, "stale-A")], hasMore: false });
+          readsB[0]!.pending.resolve({ items: [item(1, "stale-B")], hasMore: false });
+          await tick();
+        });
+        check(
+          !view.node.textContent?.includes("stale-"),
+          "late foreign generations cannot publish",
+        );
+        await render(a.agent, 2);
+        check(readsA.length === 2, "same-generation signal coalesces behind its active read");
+        await act(async () => {
+          readsA[1]!.pending.resolve({ items: [item(1, "current")], hasMore: false });
+          await tick();
+        });
+        check(
+          readsA.length === 3 && readsA[2]!.afterSequence === 1,
+          "late prior finally cannot erase final incremental read",
+        );
+        await act(async () => {
+          readsA[2]!.pending.resolve({ items: [item(2, "final")], hasMore: false });
+          await tick();
+        });
+        check(
+          view.node.textContent?.includes("current") && view.node.textContent?.includes("final"),
+          "both current rows remain",
+        );
+      } finally {
+        for (const read of [...readsA, ...readsB]) read.pending.resolve(empty);
+        await view.close();
+      }
+    },
+  );
+
+  for (const outcome of ["loading", "failed", "unsupported", "empty", "metadata-failed"] as const) {
+    await scenario(
+      `actual artifact pane and tile distinguish ${outcome} from successful empty`,
+      async () => {
+        const view = await mount(),
+          owner = nativePresentationAgent(),
+          pending = deferred<V4ConversationWorkflowRunArtifactDataResult>();
+        owner.agent.conversationWorkflowRunArtifactsV4 = async () => {
+          if (outcome === "metadata-failed") throw new Error("Authored metadata journal failure");
+          return { artifacts: [artifact] };
+        };
+        owner.agent.conversationWorkflowRunArtifactDataV4 = async () => {
+          if (outcome === "loading") return pending.promise;
+          if (outcome === "failed") throw new Error("Authored item journal failure");
+          if (outcome === "unsupported")
+            throw new Error("fault.command.capabilityUnsupported: ArtifactItems");
+          return empty;
+        };
+        try {
+          await act(async () => {
+            view.root.render(
+              <Providers agent={owner.agent}>
+                <WorkflowArtifactSidePane
+                  tab={{
+                    ...scope,
+                    type: "workflow-artifact",
+                    id: "artifact-tab",
+                    parentSessionId: "original-session",
+                    runId: "original-run",
+                    artifactId: "table",
+                  }}
+                />
+                <V4PaneConversationProvider scope={scope}>
+                  <div data-testid="tile">
+                    <WorkflowArtifactTilePreview
+                      artifact={artifact}
+                      sessionId="original-session"
+                      runId="original-run"
+                      theme="light"
+                    />
+                  </div>
+                </V4PaneConversationProvider>
+              </Providers>,
+            );
+            await tick();
+          });
+          const expected =
+            outcome === "loading"
+              ? "workflow-artifact-loading"
+              : outcome === "failed"
+                ? "workflow-artifact-error"
+                : outcome === "unsupported"
+                  ? "workflow-artifact-unavailable"
+                  : outcome === "metadata-failed"
+                    ? "workflow-artifact-metadata-error"
+                    : undefined;
+          if (expected)
+            check(
+              view.node.querySelector(`[data-testid="${expected}"]`),
+              `full pane must show ${expected}`,
+            );
+          if (outcome === "empty") {
+            check(
+              view.node.querySelector('[data-artifact-body="preset"]'),
+              "successful empty is a valid preset",
+            );
+            check(
+              !view.node.querySelector('[data-testid="workflow-artifact-error"]'),
+              "successful empty is not error",
+            );
+          }
+          const tile = view.node.querySelector('[data-testid="tile"]');
+          if (outcome === "failed" || outcome === "unsupported")
+            check(
+              tile?.querySelector('[data-testid="workflow-artifact-preview-read-error"]'),
+              "tile reports read failure/unavailable",
+            );
+          if (outcome === "loading")
+            check(
+              tile?.querySelector('[data-testid="workflow-artifact-preview-pending"]'),
+              "tile remains pending while original read is in flight",
+            );
+        } finally {
+          pending.resolve(empty);
+          await view.close();
+        }
+      },
+    );
+  }
+
+  await scenario(
+    "incremental failure retains last original data and exposes error rather than zero rows",
+    async () => {
+      const view = await mount(),
+        owner = nativePresentationAgent();
+      let count = 1;
+      owner.agent.conversationWorkflowRunArtifactDataV4 = async (params) => {
+        if (params.afterSequence !== undefined) throw new Error("Authored incremental failure");
+        return { items: [item(1, "last-good")], hasMore: false };
+      };
+      function Probe() {
+        const [signal, setSignal] = useState(count);
+        const state = useWorkflowRunArtifactData({
+          sessionId: "original-session",
+          runId: "original-run",
+          artifactId: "table",
+          itemCount: signal,
+        });
+        return (
+          <>
+            <button onClick={() => setSignal(++count)}>Refresh</button>
+            <pre>{JSON.stringify(state)}</pre>
+          </>
+        );
+      }
+      try {
+        await act(async () => {
+          view.root.render(
+            <Providers agent={owner.agent}>
+              <V4PaneConversationProvider scope={scope}>
+                <Probe />
+              </V4PaneConversationProvider>
+            </Providers>,
+          );
+          await tick();
+        });
+        await act(async () => {
+          view.node.querySelector("button")?.click();
+          await tick();
+        });
+        check(
+          view.node.textContent?.includes("last-good") &&
+            view.node.textContent?.includes("Authored incremental failure"),
+          "old rows and explicit error remain together",
+        );
+      } finally {
+        await view.close();
+      }
+    },
+  );
+
+  return results;
+}
+(window as Window & { __workflowArtifactRecoveryTests?: unknown }).__workflowArtifactRecoveryTests =
+  run();
