+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { createRootTraceContext } from "@zcode/contracts";
+import { ProductProjection } from "../src/zcode-protocol-v4/product-projection.js";
+import { V4CommandExecutor } from "../src/zcode-protocol-v4/commands/executor.js";
+import type { V4SessionRecordView } from "../src/zcode-protocol-v4/commands/types.js";
+import { activeEditHostFixture, waitFor } from "./helpers/active-edit-host-fixture.js";
+
+for (const legacyBusy of [false, true]) {
+  test(`existing custom facade without optional activity getters supports ${legacyBusy ? "legacy controller join" : "idle Edit"}`, async () => {
+    const h = await activeEditHostFixture();
+    let off = () => {};
+    try {
+      const app = await h.createSession();
+      const projection = new ProductProjection(app.sessionId, "authored-facade");
+      off = app.runtime.subscribeEvents({
+        onSessionEvent(event) {
+          projection.applyEvent(event);
+        },
+      });
+      await h.command(app.sessionId, "sendText", { text: "old question" });
+      await h.entered;
+      h.release();
+      await waitFor(
+        () => h.firstFinished && !app.runtime.getActiveForegroundExecutionId(),
+        "real Core idle",
+      );
+      const original = app.runtime;
+      // Existing custom embedder's facade omits only optional lifecycle capabilities.
+      // Every surviving method remains bound to the SAME original Core/App/SQLite.
+      const facade = new Proxy(original, {
+        get(target, key) {
+          if (
+            [
+              "getActiveTurnInfo",
+              "getActiveForegroundExecutionId",
+              "stopActiveForegroundExecution",
+            ].includes(String(key))
+          )
+            return undefined;
+          const value = Reflect.get(target, key);
+          return typeof value === "function" ? value.bind(target) : value;
+        },
+      });
+      const customApp = new Proxy(app, {
+        get(target, key) {
+          if (key === "runtime") return facade;
+          const value = Reflect.get(target, key);
+          return typeof value === "function" ? value.bind(target) : value;
+        },
+      });
+      const controller = legacyBusy ? new AbortController() : undefined;
+      const joined = Promise.withResolvers<void>();
+      const record: V4SessionRecordView = {
+        app: customApp,
+        workspace: h.workspace,
+        persistence: "immediate",
+        traceContext: createRootTraceContext(),
+        ...(controller ? { activeAbortController: controller } : {}),
+      };
+      controller?.signal.addEventListener(
+        "abort",
+        () => {
+          assert.equal(
+            (
+              projection.getSnapshot().rows.window.find((row) => row.kind === "userInput") as {
+                text?: string;
+              }
+            )?.text,
+            "old question",
+          );
+          setTimeout(() => {
+            record.activeAbortController = undefined;
+            joined.resolve();
+          }, 10);
+        },
+        { once: true },
+      );
+      if (!controller) joined.resolve();
+      const row = projection
+        .getSnapshot()
+        .rows.window.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(row?.entityId);
+      const executor = new V4CommandExecutor({
+        getRecord: (sessionId) => (sessionId === app.sessionId ? record : undefined),
+        resolveRowActionTarget: (_sessionId, target, action) =>
+          projection.resolveRowActionTarget(target, action),
+      });
+      const editing = executor.execute({
+        commandId: randomUUID(),
+        clientId: "authored-facade",
+        sessionId: app.sessionId,
+        issuedAt: Date.now(),
+        type: "editUserQuery",
+        payload: {
+          target: { rowId: row.rowId, entityId: row.entityId },
+          newText: "edited question",
+        },
+      });
+      await joined.promise;
+      await editing;
+      if (controller) assert.equal(controller.signal.aborted, true);
+      await waitFor(
+        () => h.streams === 2 && !original.getActiveForegroundExecutionId(),
+        "same original Core replacement",
+      );
+      assert.ok((await h.store.getSession(app.sessionId))?.revert);
+      assert.ok(
+        projection
+          .getSnapshot()
+          .rows.window.some((row) => row.kind === "userInput" && row.text === "edited question"),
+      );
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      off();
+      await h.close();
+    }
+  });
+}
