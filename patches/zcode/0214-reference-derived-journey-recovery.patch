+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IPluginManagementService } from "@zcode/services";
+import { usePluginManagementStore as store } from "../src/store/pluginManagementStore.js";
+import { deferred } from "./pluginMarketFixture.js";
+
+function fixture() {
+  store.setState(
+    { ...store.getInitialState(), workspacePath: "/fixture", configScope: "user" },
+    true,
+  );
+  const plugin = { id: "writer@fixture", name: "writer", enabled: true };
+  store.setState({ plugins: [plugin] as never });
+  let present = true;
+  let reads = 0;
+  let writes = 0;
+  const service = {
+    async uninstallPlugin() {
+      writes++;
+      present = false;
+      throw new Error("cleanup failed after removal");
+    },
+    async listPlugins() {
+      reads++;
+      return { plugins: present ? [plugin] : [], diagnostics: [] };
+    },
+    async getPluginsOverview() {
+      reads++;
+      return {
+        marketplaces: [],
+        installedPlugins: [],
+        availablePlugins: [],
+        restorableBuiltins: [],
+        diagnostics: [],
+      };
+    },
+  } as unknown as IPluginManagementService;
+  return {
+    service,
+    plugin,
+    reads: () => reads,
+    writes: () => writes,
+    setPresent(value: boolean) {
+      present = value;
+    },
+  };
+}
+
+test("uninstall partial failure rereads canonical state, preserves failure and never retries mutation", async () => {
+  const f = fixture();
+  assert.equal(await store.getState().uninstallPlugin(f.plugin.id, f.service), false);
+  assert.equal(f.writes(), 1);
+  assert.equal(f.reads(), 2);
+  assert.deepEqual(store.getState().plugins, []);
+  assert.equal(store.getState().error, "cleanup failed after removal");
+  assert.equal(store.getState().operationId, null);
+});
+
+test("uninstall pre-effect rejection preserves the existing plugin and its original diagnostic", async () => {
+  const f = fixture();
+  f.service.uninstallPlugin = async () => {
+    throw new Error("before removal");
+  };
+  assert.equal(await store.getState().uninstallPlugin(f.plugin.id, f.service), false);
+  assert.equal(f.reads(), 2);
+  assert.equal(store.getState().plugins[0]?.id, f.plugin.id);
+  assert.equal(store.getState().error, "before removal");
+});
+
+test("failed reconciliation keeps the actual uninstall failure and marks catalog uncertainty", async () => {
+  const f = fixture();
+  f.service.listPlugins = async () => {
+    throw new Error("inspection unavailable");
+  };
+  f.service.getPluginsOverview = async () => {
+    throw new Error("overview unavailable");
+  };
+  assert.equal(await store.getState().uninstallPlugin(f.plugin.id, f.service), false);
+  assert.equal(store.getState().error, "cleanup failed after removal");
+  assert.equal(store.getState().marketplaceAvailabilityKnown, false);
+  assert.equal(f.writes(), 1);
+});
+
+test("uninstall success returns true with canonical removal", async () => {
+  const f = fixture();
+  f.service.uninstallPlugin = async () => {
+    f.setPresent(false);
+    return { diagnostics: [] };
+  };
+  assert.equal(await store.getState().uninstallPlugin(f.plugin.id, f.service), true);
+  assert.deepEqual(store.getState().plugins, []);
+  assert.equal(store.getState().error, null);
+});
+
+test("older uninstall failure cannot reread or override a newer mutation diagnostic", async () => {
+  const f = fixture();
+  const fail = deferred();
+  f.service.uninstallPlugin = async () => {
+    await fail.promise;
+    throw new Error("old uninstall failed");
+  };
+  const old = store.getState().uninstallPlugin(f.plugin.id, f.service);
+  f.service.configurePlugin = async () => {
+    throw new Error("new operation failed");
+  };
+  assert.equal(await store.getState().configurePlugin(f.plugin.id, {}, f.service), false);
+  fail.resolve();
+  assert.equal(await old, false);
+  assert.equal(f.reads(), 0);
+  assert.equal(store.getState().error, "new operation failed");
+});
+
+test("a newer mutation while failure reconciliation is waiting retains the newer diagnostic", async () => {
+  const f = fixture();
+  const ready = deferred();
+  const release = deferred();
+  const read = f.service.listPlugins;
+  f.service.listPlugins = async (input) => {
+    ready.resolve();
+    await release.promise;
+    return read(input);
+  };
+  const old = store.getState().uninstallPlugin(f.plugin.id, f.service);
+  await ready.promise;
+  f.service.configurePlugin = async () => {
+    throw new Error("new operation failed");
+  };
+  assert.equal(await store.getState().configurePlugin(f.plugin.id, {}, f.service), false);
+  release.resolve();
+  assert.equal(await old, false);
+  assert.equal(store.getState().error, "new operation failed");
+});
+
+test("original Bootstrap uninstall + real file cleanup failure reconciles removal without losing plugin user data", async (t) => {
+  const { pluginMarketFixture } = await import("./pluginMarketFixture.js");
+  const { default: fs } = await import("node:fs");
+  const { syncBuiltinESMExports } = await import("node:module");
+  const { join } = await import("node:path");
+  const { getPluginDataDir, listInstalledPluginRecords } =
+    await import("../../../apps/zcode-cli/packages/adapters/src/plugins/index.js");
+  const f = await pluginMarketFixture();
+  try {
+    await f.store.getState().installPlugin("writer", "audit-market", f.service);
+    const id = "writer@audit-market";
+    assert.equal(
+      await f.store.getState().configurePlugin(id, { retained: "original" }, f.service),
+      true,
+    );
+    const storage = join(f.root, "storage", "cli", "plugins");
+    const file = join(getPluginDataDir(storage, id), "authored-user-document.txt");
+    await fs.promises.mkdir(getPluginDataDir(storage, id), { recursive: true });
+    await fs.promises.writeFile(file, "Keep this original artifact");
+    const originalRename = fs.promises.rename;
+    let faultCount = 0;
+    const fault = t.mock.method(fs.promises, "rename", async (from, to) => {
+      if (String(to) === f.configPath) {
+        faultCount++;
+        throw Object.assign(new Error("authored publication fault"), { code: "EIO" });
+      }
+      return originalRename(from, to);
+    });
+    syncBuiltinESMExports();
+    try {
+      assert.equal(await f.store.getState().uninstallPlugin(id, f.service), false);
+      assert.equal(faultCount, 1);
+      assert.equal(
+        listInstalledPluginRecords(storage).some((item) => item.id === id),
+        false,
+      );
+      const missing = f.store.getState().plugins.find((item) => item.id === id);
+      assert.equal(missing?.source, "missing");
+      assert.equal(missing?.packageStatus, "missing");
+      // enabled describes the config footprint whose cleanup actually failed.
+      assert.equal(missing?.enabled, true);
+      assert.equal(
+        f.store.getState().installedPlugins.some((item) => item.id === id),
+        false,
+      );
+      assert.match(f.store.getState().error ?? "", /Unable to write config file/);
+      assert.equal(await fs.promises.readFile(file, "utf8"), "Keep this original artifact");
+      const config = JSON.parse(await fs.promises.readFile(f.configPath, "utf8"));
+      assert.deepEqual(config.plugins.options[id], { retained: "original" });
+    } finally {
+      fault.mock.restore();
+      syncBuiltinESMExports();
+    }
+  } finally {
+    await f.close();
+  }
+});
+
+for (const change of ["workspace", "scope", "service"] as const) {
+  test(`old uninstall failure cannot reread ${change} A→B→A owner`, async () => {
+    const f = fixture();
+    const fail = deferred();
+    f.service.uninstallPlugin = async () => {
+      await fail.promise;
+      throw new Error("old failure");
+    };
+    const old = store.getState().uninstallPlugin(f.plugin.id, f.service);
+    if (change === "service") {
+      await store.getState().refresh({ ...f.service });
+      await store.getState().refresh(f.service);
+    } else {
+      await store.getState().initialize({
+        workspacePath: change === "workspace" ? "/other" : "/fixture",
+        configScope: change === "scope" ? "workspace" : "user",
+        pluginService: f.service,
+      });
+      await store
+        .getState()
+        .initialize({ workspacePath: "/fixture", configScope: "user", pluginService: f.service });
+    }
+    const reads = f.reads();
+    fail.resolve();
+    assert.equal(await old, false);
+    assert.equal(f.reads(), reads);
+    assert.equal(store.getState().error, null);
+    assert.equal(store.getState().operationId, null);
+  });
+}
