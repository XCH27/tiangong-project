+import { act, useState } from "react";
+import { createRoot } from "react-dom/client";
+import type { CommandEnvelope } from "@zcode/shared/zcode-protocol-v4";
+import { acquireWorkspaceConnection } from "../src/v4/workspaceConnectionRegistry.js";
+import { useSavedWorkflowPromote } from "../src/settings/saved-workflows/useSavedWorkflowPromote.js";
+import { useSavedWorkflowLauncher } from "../src/settings/saved-workflows/useSavedWorkflowLauncher.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+const tick = async () => {
+  for (let i = 0; i < 40; i++) await Promise.resolve();
+};
+async function activationFailureRetry(kind: "launcher" | "promote") {
+  const old = nativePresentationAgent(),
+    failing = nativePresentationAgent(),
+    recovered = nativePresentationAgent();
+  const target = {
+    workspacePath: `/authored-activation-${crypto.randomUUID()}`,
+    workspaceIdentity: `remote-${crypto.randomUUID()}`,
+    remoteSessionId: `attachment-${crypto.randomUUID()}`,
+  };
+  const sent: CommandEnvelope[] = [];
+  const warm = acquireWorkspaceConnection(target, old.agent);
+  failing.agent.onDynamicConversationFrame = () => () => {
+    throw new Error("Authored activation failure");
+  };
+  recovered.agent.sendConversationCommandV4 = async ({ envelope }) => {
+    sent.push(envelope);
+    return {
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 0,
+      result:
+        envelope.type === "createSession"
+          ? { type: "createSession", sessionId: "recovered-parent" }
+          : { type: "startSavedWorkflow", runId: "recovered-run", toolCallId: "recovered-tool" },
+    };
+  };
+  const node = document.createElement("div");
+  document.body.append(node);
+  const root = createRoot(node);
+  function Probe({ agent }: { agent: typeof recovered.agent }) {
+    const launcher = useSavedWorkflowLauncher({ agentService: agent });
+    const promoter = useSavedWorkflowPromote({ agentService: agent });
+    const [last, setLast] = useState<unknown>();
+    const pending = kind === "launcher" ? launcher.pending : promoter.pending;
+    return (
+      <>
+        <button
+          disabled={pending}
+          onClick={() =>
+            void (
+              kind === "launcher"
+                ? launcher.launch(target, { name: "authored", scope: "project", args: {} })
+                : promoter.promote(target, {
+                    name: "authored",
+                    path: "authored.dwf.ts",
+                    locale: "en-US",
+                  })
+            ).then(setLast)
+          }
+        >
+          Run
+        </button>
+        <pre>{JSON.stringify({ last, pending })}</pre>
+      </>
+    );
+  }
+  try {
+    await act(async () => {
+      root.render(<Probe agent={failing.agent} />);
+      await tick();
+    });
+    await act(async () => {
+      node.querySelector("button")?.click();
+      await tick();
+    });
+    check(
+      !node.querySelector("button")?.disabled &&
+        node.textContent?.includes("Authored activation failure"),
+      `${kind} must expose activation failure and release pending`,
+    );
+    check(sent.length === 0, "failed activation has no command effect");
+    await act(async () => {
+      root.render(<Probe agent={recovered.agent} />);
+      await tick();
+    });
+    await act(async () => {
+      node.querySelector("button")?.click();
+      await tick();
+    });
+    check(
+      !node.querySelector("button")?.disabled && node.textContent?.includes('"ok":true'),
+      `${kind} next explicit action must succeed rather than remain locked`,
+    );
+    check(
+      sent.length === (kind === "launcher" ? 2 : 1),
+      "retry executes only the fresh admitted original action",
+    );
+  } finally {
+    await act(async () => root.unmount());
+    node.remove();
+    warm.release();
+  }
+}
+
+async function run() {
+  try {
+    const a = nativePresentationAgent(),
+      b = nativePresentationAgent();
+    const commands: CommandEnvelope[] = [];
+    const queries: Array<{
+      workspacePath: string;
+      commands: Array<{ sessionId: string | null; commandId: string }>;
+    }> = [];
+    let queryState: "unavailable" | "unknown" | "accepted" = "unavailable";
+    let wrongHost = 0;
+    a.agent.sendConversationCommandV4 = async (params) => {
+      check(params.workspacePath === "/authored-host-A", "only original workspace A can execute");
+      commands.push(params.envelope);
+      if (params.envelope.type === "createSession")
+        return {
+          commandId: params.envelope.commandId,
+          status: "accepted",
+          revisionAtDecision: 0,
+          result: { type: "createSession", sessionId: "original-parent" },
+        };
+      if (params.envelope.type === "startSavedWorkflow")
+        throw new Error("Authored accepted reply lost");
+      throw new Error("Uncertain launch must never close or replay");
+    };
+    a.agent.queryConversationCommandsV4 = async (params) => {
+      queries.push({ workspacePath: params.workspacePath, commands: params.commands });
+      check(params.workspacePath === "/authored-host-A", "query must retain original workspace");
+      if (queryState === "unavailable") throw new Error("Authored original receipt unavailable");
+      return {
+        results: params.commands.map((key) => ({
+          key,
+          result:
+            queryState === "unknown"
+              ? ("unknown" as const)
+              : {
+                  commandId: key.commandId,
+                  status: "duplicate" as const,
+                  revisionAtDecision: 0,
+                  result: {
+                    type: "startSavedWorkflow" as const,
+                    runId: "original-run",
+                    toolCallId: "original-tool",
+                  },
+                },
+        })),
+      };
+    };
+    b.agent.sendConversationCommandV4 = async () => {
+      wrongHost++;
+      throw new Error("Wrong Host B write");
+    };
+    b.agent.queryConversationCommandsV4 = async () => {
+      wrongHost++;
+      throw new Error("Wrong Host B query");
+    };
+    const node = document.createElement("div");
+    document.body.append(node);
+    const root = createRoot(node);
+    const navigated: Array<{ path: string; sessionId: string }> = [];
+    function Launcher({
+      agent,
+      path,
+      name,
+    }: {
+      agent: typeof a.agent;
+      path: string;
+      name: string;
+    }) {
+      const launcher = useSavedWorkflowLauncher({
+        agentService: agent,
+        onNavigate: (target, sessionId) =>
+          navigated.push({ path: target.workspacePath, sessionId }),
+      });
+      const [last, setLast] = useState<unknown>();
+      return (
+        <>
+          <button
+            disabled={launcher.pending}
+            onClick={() =>
+              void launcher
+                .launch({ workspacePath: path }, { name, scope: "project", args: {} })
+                .then(setLast)
+            }
+          >
+            Run
+          </button>
+          <pre>{JSON.stringify({ last, error: launcher.error })}</pre>
+        </>
+      );
+    }
+    const render = async (agent: typeof a.agent, path: string, name: string) => {
+      await act(async () => {
+        root.render(<Launcher agent={agent} path={path} name={name} />);
+        await tick();
+      });
+    };
+    const click = async () => {
+      await act(async () => {
+        node.querySelector("button")?.click();
+        await tick();
+      });
+    };
+    try {
+      await render(a.agent, "/authored-host-A", "first");
+      await click();
+      check(
+        node.textContent?.includes("uncertain") && node.textContent?.includes("original-parent"),
+        "unknown outcome keeps original Session discoverable",
+      );
+      queryState = "unknown";
+      await render(b.agent, "/authored-host-B", "changed");
+      await click();
+      check(
+        node.textContent?.includes("uncertain"),
+        "changed target cannot replace unresolved launch",
+      );
+      check(wrongHost === 0, "A→B cannot query/write through B carrier");
+      queryState = "accepted";
+      await render(a.agent, "/authored-host-A", "third");
+      await click();
+      check(
+        node.textContent?.includes("original-run") && node.textContent?.includes("original-tool"),
+        "exact accepted duplicate receipt returns real correlated identities",
+      );
+      check(
+        commands.length === 2 &&
+          commands[0]?.type === "createSession" &&
+          commands[1]?.type === "startSavedWorkflow",
+        "exactly one create and one start, no close/replay",
+      );
+      check(
+        queries.length === 3 &&
+          queries.every(
+            (q) =>
+              q.commands[0]?.commandId === commands[1]?.commandId &&
+              q.commands[0]?.sessionId === "original-parent",
+          ),
+        "all queries retain exact original command and Session",
+      );
+      check(
+        navigated.length === 1 &&
+          navigated[0]?.path === "/authored-host-A" &&
+          navigated[0]?.sessionId === "original-parent",
+        "navigation uses original target after recovery",
+      );
+      results.push({
+        name: "actual hook + original connection/transport retains A scope across A→B→A with zero new start/close",
+      });
+    } finally {
+      await act(async () => root.unmount());
+      node.remove();
+    }
+  } catch (error) {
+    results.push({
+      name: "actual hook launch scope recovery",
+      error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+    });
+  }
+  for (const kind of ["launcher", "promote"] as const) {
+    try {
+      await activationFailureRetry(kind);
+      results.push({
+        name: `${kind}: original activation failure releases pending and next explicit retry succeeds`,
+      });
+    } catch (error) {
+      results.push({
+        name: `${kind} activation failure/retry`,
+        error: error instanceof Error ? (error.stack ?? error.message) : String(error),
+      });
+    }
+  }
+  return results;
+}
+(window as Window & { __savedWorkflowLaunchScopeTests?: unknown }).__savedWorkflowLaunchScopeTests =
+  run();
