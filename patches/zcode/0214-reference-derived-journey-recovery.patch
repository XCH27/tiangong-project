+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { join } from "node:path";
+import { AiSdkModelAdapter } from "@zcode/adapters/model";
+import { SqliteSessionStore } from "@zcode/adapters/storage";
+import type { Model } from "@zcode/contracts";
+import { zcodeProtocolMethods as M, type ZCodeProtocolMessage } from "@zcode/shared";
+import {
+  V4_METHODS as V,
+  commandAckSchema,
+  v4ConversationRowsRangeResultSchema,
+  type CommandEnvelope,
+} from "@zcode/shared/zcode-protocol-v4";
+import { ZCodeProtocolAgentServer } from "../../src/zcode-protocol/server.js";
+import { appModelFixture } from "./app-model-completion-fixture.js";
+
+export async function waitFor(condition: () => boolean, label: string) {
+  for (let i = 0; i < 600; i++) {
+    if (condition()) return;
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+  throw new Error(`Timed out: ${label}`);
+}
+
+export async function activeEditHostFixture() {
+  const f = await appModelFixture();
+  const workspace = {
+    workspacePath: join(f.root, "workspace"),
+    workspaceKey: join(f.root, "workspace"),
+  };
+  const store = new SqliteSessionStore({ dbPath: join(f.root, "active-edit.sqlite") });
+  const adapter = new AiSdkModelAdapter({ env: {} });
+  const createModel = adapter.createModel.bind(adapter);
+  const entered = Promise.withResolvers<void>();
+  const released = Promise.withResolvers<void>();
+  const aborted = Promise.withResolvers<void>();
+  let firstSignal: AbortSignal | undefined;
+  let firstFinished = false;
+  let streams = 0;
+  const decorate = (model: Model): Model => ({
+    providerId: model.providerId,
+    modelId: model.modelId,
+    properties: model.properties,
+    optionSpecs: model.optionSpecs,
+    options: model.options,
+    bind: (options) => decorate(model.bind(options)),
+    async generateText() {
+      throw new Error("This fixture requires the real streaming turn");
+    },
+    async *streamText(input) {
+      streams++;
+      yield { type: "start" };
+      if (streams === 1) {
+        firstSignal = input.abortSignal;
+        firstSignal?.addEventListener("abort", () => aborted.resolve(), { once: true });
+        yield { type: "text_delta", text: "old partial" };
+        entered.resolve();
+        await released.promise;
+        try {
+          if (firstSignal?.aborted) throw firstSignal.reason;
+          yield { type: "text_delta", text: " old late result" };
+          yield {
+            type: "finish",
+            finishReason: "stop",
+            usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
+          };
+        } finally {
+          firstFinished = true;
+        }
+      } else {
+        yield { type: "text_delta", text: "edited answer" };
+        yield {
+          type: "finish",
+          finishReason: "stop",
+          usage: { inputTokens: 1, outputTokens: 1, totalTokens: 2 },
+        };
+      }
+    },
+  });
+  adapter.createModel = (input) => decorate(createModel(input));
+  const apps = new Map<string, Awaited<ReturnType<typeof f.create>>>();
+  const server = new ZCodeProtocolAgentServer({
+    cwd: workspace.workspacePath,
+    env: {},
+    sessionStore: store,
+    createZCodeApp: async (options) => {
+      const app = await f.create({
+        ...options,
+        sessionStore: store,
+        modelAdapter: adapter,
+        configuredDefaultModelSelection: {
+          providerId: f.providerId,
+          modelId: "standard",
+          options: { reasoningLevel: "high" },
+        },
+        runtimeConfig: {
+          ...options?.runtimeConfig,
+          workingDirectory: workspace.workspacePath,
+          memory: { enabled: false },
+          mcp: { enabled: false, servers: {} },
+          toolAllowlist: ["ReadWhiteboard", "WhiteboardUpdate"],
+          modelStreaming: "on",
+        },
+      });
+      apps.set(String(app.sessionId), app);
+      return app;
+    },
+  });
+  let id = 0;
+  let permission: ZCodeProtocolMessage | undefined;
+  const notifications: ZCodeProtocolMessage[] = [];
+  server.setNotificationSink((message) => {
+    notifications.push(message);
+    if ("method" in message && message.method === M.interactionRequestPermission)
+      permission = message;
+    if (
+      "method" in message &&
+      "id" in message &&
+      message.method === M.sessionRequestRuntimePreferences
+    )
+      void server.handleMessage({
+        id: message.id,
+        result: { nativeSearchEnhancementsEnabled: true, memoryEnabled: false },
+      });
+  });
+  async function request(method: string, params: unknown) {
+    const requestId = ++id;
+    const response = await server.handleMessage({
+      id: requestId,
+      method,
+      params,
+    } as ZCodeProtocolMessage);
+    assert.ok(response && "result" in response, JSON.stringify(response));
+    notifications.push(...server.takePostResponseMessages(requestId));
+    return response.result;
+  }
+  async function command(
+    sessionId: string,
+    type: CommandEnvelope["type"],
+    payload: unknown,
+    base?: { atRevision: number; atLogEpoch: string },
+  ) {
+    return commandAckSchema.parse(
+      await request(V.command, {
+        commandId: randomUUID(),
+        clientId: "authored-active-edit",
+        sessionId,
+        type,
+        payload,
+        issuedAt: Date.now(),
+        ...(base ? { baseRevision: base.atRevision, baseLogEpoch: base.atLogEpoch } : {}),
+      }),
+    );
+  }
+  return {
+    f,
+    store,
+    workspace,
+    apps,
+    server,
+    request,
+    command,
+    notifications,
+    entered: entered.promise,
+    aborted: aborted.promise,
+    release() {
+      released.resolve();
+    },
+    get permission() {
+      return permission;
+    },
+    async denyPermission() {
+      if (permission && "id" in permission) {
+        const held = permission;
+        permission = undefined;
+        await server.handleMessage({ id: held.id, result: { decision: "deny" } });
+      }
+    },
+    get firstSignal() {
+      return firstSignal;
+    },
+    get firstFinished() {
+      return firstFinished;
+    },
+    get streams() {
+      return streams;
+    },
+    async createSession() {
+      const result = await request(M.sessionCreate, { workspace, persistence: "deferred" });
+      assert.ok(result && typeof result === "object" && "session" in result);
+      const session = result.session as { sessionId: string };
+      const app = apps.get(session.sessionId);
+      assert.ok(app);
+      return app;
+    },
+    async rows(sessionId: string) {
+      return v4ConversationRowsRangeResultSchema.parse(
+        await request(V.conversationRowsRange, { sessionId, limit: 200 }),
+      );
+    },
+    async close() {
+      released.resolve();
+      if (permission && "id" in permission)
+        await server.handleMessage({ id: permission.id, result: { decision: "deny" } });
+      await server.shutdown();
+      server.disposeProjections();
+      store.close();
+      await f.close();
+    },
+  };
+}
