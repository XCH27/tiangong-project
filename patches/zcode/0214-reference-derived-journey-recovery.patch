+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { zcodeProtocolMethods as M, whiteboardRelativePath } from "@zcode/shared";
+import { SessionEventType, type SessionEvent } from "@zcode/contracts";
+import { activeEditHostFixture, waitFor } from "./helpers/active-edit-host-fixture.js";
+
+test(
+  "actual Host Edit waits for the Core-owned old stream to stop and join before rewinding",
+  { timeout: 15_000 },
+  async () => {
+    const h = await activeEditHostFixture();
+    try {
+      const app = await h.createSession();
+      const sent = await h.command(app.sessionId, "sendText", { text: "old question" });
+      assert.equal(sent.status, "accepted", JSON.stringify(sent));
+      await h.entered;
+      await waitFor(() => !!app.runtime.getActiveTurnInfo(), "real active streaming turn");
+      const view = await h.rows(app.sessionId);
+      const row = view.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(row?.entityId, "original UI projection exposes Edit for latest real user");
+      const editing = h.command(
+        app.sessionId,
+        "editUserQuery",
+        {
+          target: { rowId: row.rowId, entityId: row.entityId },
+          newText: "edited question",
+        },
+        view,
+      );
+      await waitFor(
+        () => !!h.firstSignal?.aborted,
+        "old stream receives Core Stop before mutation",
+      );
+      assert.equal(h.firstFinished, false, "abort delivery is not yet completion");
+      assert.equal((await h.store.getSession(app.sessionId))?.revert, undefined);
+      assert.equal(h.streams, 1);
+      h.release();
+      const edited = await editing;
+      assert.equal(edited.status, "accepted", JSON.stringify(edited));
+      await waitFor(
+        () => h.streams === 2 && !app.runtime.getActiveTurnInfo(),
+        "replacement turn finishes",
+      );
+      const restored = await h.rows(app.sessionId);
+      assert.ok(
+        restored.rows.some((row) => row.kind === "userInput" && row.text === "edited question"),
+      );
+      assert.ok(
+        restored.rows.some((row) => row.kind === "assistantText" && row.text === "edited answer"),
+      );
+      assert.equal(
+        restored.rows.some(
+          (row) => row.kind === "assistantText" && row.text.includes("old late result"),
+        ),
+        false,
+      );
+      assert.ok((await h.store.getSession(app.sessionId))?.revert);
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      await h.close();
+    }
+  },
+);
+
+test(
+  "stale Edit leaves a later native foreground alone; current Edit stops it before replacing history",
+  { timeout: 15_000 },
+  async () => {
+    const h = await activeEditHostFixture();
+    try {
+      const app = await h.createSession();
+      const sent = await h.command(app.sessionId, "sendText", { text: "old question" });
+      assert.equal(sent.status, "accepted");
+      await h.entered;
+      const stale = await h.rows(app.sessionId);
+      const old = stale.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(old?.entityId);
+      h.release();
+      await waitFor(
+        () => h.firstFinished && !app.runtime.getActiveForegroundExecutionId(),
+        "original turn settles",
+      );
+      const events: Array<{ event: SessionEvent; foreground: string | undefined }> = [];
+      const off = app.runtime.subscribeEvents({
+        onSessionEvent(event) {
+          events.push({ event, foreground: app.runtime.getActiveForegroundExecutionId() });
+        },
+      });
+      const document = {
+        id: `whiteboard:${randomUUID()}`,
+        name: "Held native Save",
+        width: 1280 as const,
+        height: 800 as const,
+        strokes: [],
+        undoneStrokes: [],
+        createdAt: 1,
+        updatedAt: 1,
+      };
+      const operationId = randomUUID();
+      const saving = h.request(M.sessionWhiteboardControl, {
+        workspace: h.workspace,
+        sessionId: app.sessionId,
+        operationId,
+        command: {
+          operation: "update",
+          input: { document, mutationId: randomUUID(), expectedAbsent: true },
+        },
+      });
+      await waitFor(() => !!h.permission, "real native permission wait");
+      const foreground = app.runtime.getActiveForegroundExecutionId();
+      assert.equal(foreground, `native-whiteboard:${operationId}`);
+      assert.equal(app.runtime.getActiveTurnInfo(), undefined);
+      const rejected = await h.command(
+        app.sessionId,
+        "editUserQuery",
+        {
+          target: { rowId: old.rowId, entityId: old.entityId },
+          newText: "stale edited question",
+        },
+        stale,
+      );
+      assert.equal(rejected.status, "stale", JSON.stringify(rejected));
+      assert.equal(app.runtime.getActiveForegroundExecutionId(), foreground);
+      assert.equal((await h.store.getSession(app.sessionId))?.revert, undefined);
+      const current = await h.rows(app.sessionId);
+      const row = current.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(row?.entityId);
+      const edited = await h.command(
+        app.sessionId,
+        "editUserQuery",
+        {
+          target: { rowId: row.rowId, entityId: row.entityId },
+          newText: "edited question",
+        },
+        current,
+      );
+      assert.equal(edited.status, "accepted", JSON.stringify(edited));
+      const native = await saving;
+      assert.ok(native && typeof native === "object" && "status" in native);
+      assert.equal(native.status, "failed", JSON.stringify(native));
+      const stoppedAt = events.findIndex(
+        ({ event }) =>
+          event.type === SessionEventType.TurnComplete &&
+          (event.payload as { resultType?: string }).resultType === "cancelled",
+      );
+      const rewoundAt = events.findIndex(
+        ({ event }) => event.type === SessionEventType.RewindTriggered,
+      );
+      assert.ok(stoppedAt >= 0, "original native TurnComplete observes its aborted signal");
+      assert.ok(rewoundAt > stoppedAt, "native cancelled settlement precedes durable rewind");
+      assert.equal(
+        events[rewoundAt]?.foreground,
+        undefined,
+        "old foreground finally joined before rewind",
+      );
+      assert.equal(app.runtime.getPendingPermissionRequests().length, 0);
+      off();
+      await assert.rejects(
+        readFile(join(h.workspace.workspacePath, whiteboardRelativePath(document.id))),
+        { code: "ENOENT" },
+      );
+      await waitFor(
+        () => h.streams === 2 && !app.runtime.getActiveForegroundExecutionId(),
+        "replacement stream completes",
+      );
+      assert.ok((await h.store.getSession(app.sessionId))?.revert);
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      await h.close();
+    }
+  },
+);
+
+test("idle Edit uses original history without issuing a Stop", { timeout: 15_000 }, async () => {
+  const h = await activeEditHostFixture();
+  try {
+    const app = await h.createSession();
+    await h.command(app.sessionId, "sendText", { text: "old question" });
+    await h.entered;
+    h.release();
+    await waitFor(
+      () => h.firstFinished && !app.runtime.getActiveForegroundExecutionId(),
+      "idle original Session",
+    );
+    const view = await h.rows(app.sessionId);
+    const row = view.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+    assert.ok(row?.entityId);
+    const stop = app.runtime.stopActiveForegroundExecution;
+    app.runtime.stopActiveForegroundExecution = () => {
+      throw new Error("Idle Edit must not Stop");
+    };
+    try {
+      const edited = await h.command(
+        app.sessionId,
+        "editUserQuery",
+        {
+          target: { rowId: row.rowId, entityId: row.entityId },
+          newText: "edited question",
+        },
+        view,
+      );
+      assert.equal(edited.status, "accepted", JSON.stringify(edited));
+      await waitFor(
+        () => h.streams === 2 && !app.runtime.getActiveForegroundExecutionId(),
+        "idle replacement finishes",
+      );
+      const rows = await h.rows(app.sessionId);
+      assert.ok(
+        rows.rows.some((row) => row.kind === "userInput" && row.text === "edited question"),
+      );
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      app.runtime.stopActiveForegroundExecution = stop;
+    }
+  } finally {
+    await h.close();
+  }
+});
+
+test(
+  "actual Host Stop failure refuses Edit before history or replacement input changes",
+  { timeout: 15_000 },
+  async () => {
+    const h = await activeEditHostFixture();
+    try {
+      const app = await h.createSession();
+      await h.command(app.sessionId, "sendText", { text: "old question" });
+      await h.entered;
+      const view = await h.rows(app.sessionId);
+      const row = view.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(row?.entityId);
+      const stop = app.runtime.stopActiveForegroundExecution;
+      // Fault only the public lifecycle boundary; actual Host admission/store remain production.
+      app.runtime.stopActiveForegroundExecution = () => {
+        throw new Error("Authored Stop delivery failure");
+      };
+      try {
+        const edited = await h.command(
+          app.sessionId,
+          "editUserQuery",
+          {
+            target: { rowId: row.rowId, entityId: row.entityId },
+            newText: "must not publish",
+          },
+          view,
+        );
+        assert.equal(edited.status, "failed", JSON.stringify(edited));
+        assert.match(edited.message ?? "", /Stop delivery failure/);
+        assert.equal(h.firstSignal?.aborted, false);
+        assert.equal((await h.store.getSession(app.sessionId))?.revert, undefined);
+        const rows = await h.rows(app.sessionId);
+        assert.ok(rows.rows.some((row) => row.kind === "userInput" && row.text === "old question"));
+        assert.equal(
+          rows.rows.some((row) => row.kind === "userInput" && row.text === "must not publish"),
+          false,
+        );
+        assert.equal(h.streams, 1);
+        assert.equal(h.f.httpCalls, 0);
+      } finally {
+        app.runtime.stopActiveForegroundExecution = stop;
+      }
+    } finally {
+      await h.close();
+    }
+  },
+);
+
+test(
+  "an aborted stream that fails to join by the original idle deadline cannot rewind",
+  { timeout: 15_000 },
+  async () => {
+    const h = await activeEditHostFixture();
+    try {
+      const app = await h.createSession();
+      await h.command(app.sessionId, "sendText", { text: "old question" });
+      await h.entered;
+      const view = await h.rows(app.sessionId);
+      const row = view.rows.find((row) => row.kind === "userInput" && row.actions?.canEdit);
+      assert.ok(row?.entityId);
+      const edited = await h.command(
+        app.sessionId,
+        "editUserQuery",
+        {
+          target: { rowId: row.rowId, entityId: row.entityId },
+          newText: "must not publish",
+        },
+        view,
+      );
+      assert.equal(edited.status, "failed", JSON.stringify(edited));
+      assert.match(edited.message ?? "", /idle/i);
+      assert.equal(h.firstSignal?.aborted, true);
+      assert.equal(h.firstFinished, false);
+      assert.ok(app.runtime.getActiveForegroundExecutionId());
+      assert.equal((await h.store.getSession(app.sessionId))?.revert, undefined);
+      assert.equal(h.streams, 1);
+      const rows = await h.rows(app.sessionId);
+      assert.ok(rows.rows.some((row) => row.kind === "userInput" && row.text === "old question"));
+      assert.equal(
+        rows.rows.some((row) => row.kind === "userInput" && row.text === "must not publish"),
+        false,
+      );
+      assert.equal(h.f.httpCalls, 0);
+    } finally {
+      await h.close();
+    }
+  },
+);
