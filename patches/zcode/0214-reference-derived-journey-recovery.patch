+    });
+    assert.equal(f.writes(), 1);
+    assert.equal(f.after(), 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("canonical absence at action time refuses even a previously enabled confirmation callback", async () => {
+  const f = await fixture();
+  try {
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
