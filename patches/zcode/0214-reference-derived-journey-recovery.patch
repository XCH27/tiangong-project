diff --git a/packages/ui/test/pluginUninstallDialog.browser.test.tsx b/packages/ui/test/pluginUninstallDialog.browser.test.tsx
new file mode 100644
index 00000000..c41c5e3b
--- /dev/null
+++ b/packages/ui/test/pluginUninstallDialog.browser.test.tsx
@@ -0,0 +1,165 @@
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import type { IPluginManagementService } from "@zcode/services";
+import { ZCodeIntlProvider } from "../src/i18n/IntlProvider.js";
+import { usePluginManagementStore as store } from "../src/store/pluginManagementStore.js";
+import { usePluginUninstall } from "../src/settings/usePluginUninstall.js";
+import { PluginUninstallConfirmDialog } from "../src/settings/PluginUninstallConfirmDialog.js";
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const results: Array<{ name: string; error?: string }> = [];
+function check(value: unknown, message: string): asserts value {
+  if (!value) throw new Error(message);
+}
+
+async function run() {
+  for (const locale of ["en-US", "zh-CN"] as const) {
+    for (const scenario of ["removed", "unknown", "before-effect"] as const) {
+      const node = document.createElement("div");
+      document.body.append(node);
+      const root = createRoot(node);
+      const id = `uninstall-probe-${locale}-${scenario}@authored`;
+      const plugin = { id, name: "Authored Uninstall", enabled: true };
+      let present = true;
+      let writes = 0;
+      let after = 0;
+      let control!: ReturnType<typeof usePluginUninstall>;
+      const service = {
+        async uninstallPlugin() {
+          writes++;
+          if (scenario !== "before-effect") present = false;
+          throw new Error("Authored uninstall cleanup failure");
+        },
+        async listPlugins() {
+          if (scenario === "unknown") throw new Error("Authored inspection unavailable");
+          return {
+            plugins: present
+              ? [plugin]
+              : [{ ...plugin, source: "missing", packageStatus: "missing" }],
+            diagnostics: [],
+          };
+        },
+        async getPluginsOverview() {
+          if (scenario === "unknown") throw new Error("Authored overview unavailable");
+          return {
+            marketplaces: [],
+            installedPlugins: [],
+            availablePlugins: [],
+            restorableBuiltins: [],
+            diagnostics: [],
+          };
+        },
+      } as unknown as IPluginManagementService;
+      store.setState(
+        {
+          ...store.getInitialState(),
+          workspacePath: `/fixture/${id}`,
+          configScope: "user",
+          marketplaceAvailabilityKnown: true,
+          plugins: [plugin] as never,
+        },
+        true,
+      );
+      function Probe() {
+        const plugins = store((state) => state.plugins);
+        const installedPlugins = store((state) => state.installedPlugins);
+        const operationId = store((state) => state.operationId);
+        control = usePluginUninstall({
+          pluginService: service,
+          plugins,
+          installedPlugins,
+          operationId,
+          onAfterUninstall: async () => {
+            after++;
+          },
+        });
+        return (
+          <PluginUninstallConfirmDialog
+            open={control.pendingPlugin !== null}
+            pluginName={control.pendingPlugin?.name ?? ""}
+            pending={control.uninstalling}
+            canConfirm={control.canConfirm}
+            error={control.error}
+            onCancel={control.cancelUninstall}
+            onConfirm={() => void control.confirmUninstall()}
+          />
+        );
+      }
+      const button = (kind: "confirm" | "cancel") => {
+        const value = document.querySelector<HTMLButtonElement>(
+          `[data-testid="plugin-store-uninstall-${kind}"]`,
+        );
+        check(value, `Missing ${kind} action`);
+        return value;
+      };
+      const name = `${locale}: original hook + uninstall dialog ${scenario}`;
+      try {
+        await act(async () => {
+          root.render(
+            <ZCodeIntlProvider initialLocale={locale}>
+              <Probe />
+            </ZCodeIntlProvider>,
+          );
+        });
+        await act(async () => {
+          control.requestUninstall(id);
+        });
+        await act(async () => {
+          button("confirm").click();
+        });
+        check(control.pendingPlugin?.id === id, "Failure target closed prematurely");
+        check(writes === 1 && after === 0, "Failure invoked another write or success finalization");
+        const dialog = document.querySelector<HTMLElement>(
+          '[data-testid="plugin-store-uninstall-dialog"]',
+        );
+        check(dialog && dialog.dataset.state === "open", "Failure dialog did not remain open");
+        check(
+          dialog
+            .querySelector('[role="alert"]')
+            ?.textContent?.includes("Authored uninstall cleanup failure"),
+          "Actual failure diagnostic missing",
+        );
+        check(!button("cancel").disabled, "Cancel remained locked after failure");
+        if (scenario === "before-effect") {
+          check(!button("confirm").disabled, "Confirmed present installation was not retryable");
+        } else {
+          check(button("confirm").disabled, "Unknown/removed installation allowed blind retry");
+          const expected =
+            locale === "en-US"
+              ? "The installation may already have changed."
+              : "安装状态可能已经改变。";
+          check(
+            dialog.textContent?.includes(expected),
+            "Localized current-state inspection notice missing",
+          );
+          await act(async () => {
+            button("confirm").click();
+          });
+          check(writes === 1, "Disabled confirmation replayed uninstall");
+        }
+        await act(async () => {
+          button("cancel").click();
+        });
+        check(control.pendingPlugin === null, "Cancel did not dismiss failure confirmation");
+        results.push({ name });
+      } catch (error) {
+        results.push({ name, error: error instanceof Error ? error.stack : String(error) });
+      } finally {
+        await act(async () => {
+          root.unmount();
+        });
+        node.remove();
+      }
+    }
+  }
+  return results;
+}
+(window as unknown as Record<string, unknown>).__pluginUninstallDialogTests = run().then(
+  (value) => value,
+  (error) => [
+    {
+      name: "plugin uninstall dialog fixture",
+      error: error instanceof Error ? error.stack : String(error),
+    },
+  ],
+);
diff --git a/packages/ui/test/pluginUninstallHook.test.ts b/packages/ui/test/pluginUninstallHook.test.ts
new file mode 100644
index 00000000..45da8824
--- /dev/null
+++ b/packages/ui/test/pluginUninstallHook.test.ts
@@ -0,0 +1,402 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createElement, act } from "react";
+import Reconciler from "react-reconciler";
+import type { IPluginManagementService } from "@zcode/services";
+import { usePluginManagementStore as store } from "../src/store/pluginManagementStore.js";
+import { usePluginUninstall } from "../src/settings/usePluginUninstall.js";
+
+// Node-only React lifecycle: the probe returns null, so no browser/renderer window,
+// DOM, authored style, or native UI is created. Exercise the original hook caller.
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+let priority = 0;
+const renderer = Reconciler({
+  rendererVersion: "test",
+  rendererPackageName: "node-plugin-uninstall-hook",
+  isPrimaryRenderer: true,
+  supportsMutation: true,
+  supportsPersistence: false,
+  supportsHydration: false,
+  getRootHostContext: () => ({}),
+  getChildHostContext: () => ({}),
+  prepareForCommit: () => null,
+  resetAfterCommit() {},
+  clearContainer() {},
+  scheduleTimeout: setTimeout,
+  cancelTimeout: clearTimeout,
+  noTimeout: -1,
+  supportsMicrotasks: true,
+  scheduleMicrotask: queueMicrotask,
+  getCurrentUpdatePriority: () => priority,
+  setCurrentUpdatePriority(value: number) {
+    priority = value;
+  },
+  resolveUpdatePriority: () => priority || 32,
+  resolveEventTimeStamp: () => -1,
+  resolveEventType: () => null,
+  trackSchedulerEvent() {},
+  shouldAttemptEagerTransition: () => false,
+  maySuspendCommit: () => false,
+  maySuspendCommitOnUpdate: () => false,
+  maySuspendCommitInSyncRender: () => false,
+  preloadInstance: () => true,
+});
+
+async function fixture() {
+  store.setState(
+    {
+      ...store.getInitialState(),
+      workspacePath: "/fixture",
+      configScope: "user",
+      marketplaceAvailabilityKnown: true,
+    },
+    true,
+  );
+  const plugin = { id: "writer@fixture", name: "writer", enabled: true };
+  store.setState({ plugins: [plugin] as never });
+  let present = true;
+  let writes = 0;
+  let after = 0;
+  const service = {
+    async uninstallPlugin() {
+      writes++;
+      present = false;
+      throw new Error("cleanup failed after removal");
+    },
+    async listPlugins() {
+      return { plugins: present ? [plugin] : [], diagnostics: [] };
+    },
+    async getPluginsOverview() {
+      return {
+        marketplaces: [],
+        installedPlugins: [],
+        availablePlugins: [],
+        restorableBuiltins: [],
+        diagnostics: [],
+      };
+    },
+  } as unknown as IPluginManagementService;
+  let target = service;
+  let controller!: ReturnType<typeof usePluginUninstall>;
+  function Probe() {
+    const plugins = store((state) => state.plugins);
+    const installedPlugins = store((state) => state.installedPlugins);
+    const operationId = store((state) => state.operationId);
+    controller = usePluginUninstall({
+      pluginService: target,
+      plugins,
+      installedPlugins,
+      operationId,
+      onAfterUninstall: async () => {
+        after++;
+      },
+    });
+    return null;
+  }
+  const fail = (error: Error) => {
+    throw error;
+  };
+  const root = renderer.createContainer({}, 1, null, false, null, "", fail, fail, fail, null);
+  const render = () =>
+    act(async () => {
+      renderer.updateContainer(createElement(Probe), root, null, null);
+    });
+  await render();
+  return {
+    service,
+    plugin,
+    controller: () => controller,
+    writes: () => writes,
+    after: () => after,
+    render,
+    setPresent(value: boolean) {
+      present = value;
+    },
+    replaceService(value: IPluginManagementService) {
+      target = value;
+    },
+    async close() {
+      await act(async () => {
+        renderer.updateContainer(null, root, null, null);
+      });
+    },
+  };
+}
+
+test("original uninstall hook keeps failure target visible, disallows removed-target retry and skips success finalization", async () => {
+  const f = await fixture();
+  try {
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.controller().pendingPlugin?.id, f.plugin.id);
+    assert.equal(f.controller().error, "cleanup failed after removal");
+    assert.equal(f.controller().canConfirm, false);
+    assert.equal(f.controller().uninstalling, false);
+    assert.equal(f.after(), 0);
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.writes(), 1);
+    await act(async () => {
+      f.controller().cancelUninstall();
+    });
+    assert.equal(f.controller().pendingPlugin, null);
+  } finally {
+    await f.close();
+  }
+});
+
+test("successful original hook finalizes once and releases its matching confirmation", async () => {
+  const f = await fixture();
+  try {
+    f.service.uninstallPlugin = async () => {
+      f.setPresent(false);
+      return { diagnostics: [] };
+    };
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.after(), 1);
+    assert.equal(f.controller().pendingPlugin, null);
+  } finally {
+    await f.close();
+  }
+});
+
+test("before-effect failure stays retryable only while canonical membership is confirmed", async () => {
+  const f = await fixture();
+  try {
+    f.service.uninstallPlugin = async () => {
+      throw new Error("before effect");
+    };
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.controller().canConfirm, true);
+    assert.equal(f.controller().error, "before effect");
+    assert.equal(f.after(), 0);
+  } finally {
+    await f.close();
+  }
+});
+
+test("unknown canonical inspection keeps Cancel available but does not authorize another uninstall", async () => {
+  const f = await fixture();
+  try {
+    f.service.listPlugins = async () => {
+      throw new Error("read unavailable");
+    };
+    f.service.getPluginsOverview = async () => {
+      throw new Error("overview unavailable");
+    };
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.controller().error, "cleanup failed after removal");
+    assert.equal(f.controller().canConfirm, false);
+    assert.equal(f.controller().uninstalling, false);
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.writes(), 1);
+    await act(async () => {
+      f.controller().cancelUninstall();
+    });
+    assert.equal(f.controller().pendingPlugin, null);
+  } finally {
+    await f.close();
+  }
+});
+
+for (const change of ["workspace", "scope", "service"] as const) {
+  test(`late successful uninstall cannot finalize after ${change} A→B→A ownership`, async () => {
+    const f = await fixture();
+    let resolve!: () => void;
+    f.service.uninstallPlugin = async () => {
+      await new Promise<void>((done) => {
+        resolve = done;
+      });
+      f.setPresent(false);
+      return { diagnostics: [] };
+    };
+    try {
+      await act(async () => {
+        f.controller().requestUninstall(f.plugin.id);
+      });
+      let pending!: Promise<void>;
+      await act(async () => {
+        pending = f.controller().confirmUninstall();
+      });
+      if (change === "service") {
+        f.replaceService({ ...f.service });
+        await f.render();
+        f.replaceService(f.service);
+        await f.render();
+      } else {
+        await act(async () => {
+          store.setState(
+            change === "workspace" ? { workspacePath: "/other" } : { configScope: "workspace" },
+          );
+          store.setState(
+            change === "workspace" ? { workspacePath: "/fixture" } : { configScope: "user" },
+          );
+        });
+      }
+      await act(async () => {
+        resolve();
+        await pending;
+      });
+      assert.equal(f.after(), 0);
+      assert.equal(f.controller().pendingPlugin, null);
+    } finally {
+      await f.close();
+    }
+  });
+}
+
+test("same-id new confirmation is not cleared by the older request settlement", async () => {
+  const f = await fixture();
+  let resolve!: () => void;
+  f.service.uninstallPlugin = async () => {
+    await new Promise<void>((done) => {
+      resolve = done;
+    });
+    return { diagnostics: [] };
+  };
+  try {
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    let pending!: Promise<void>;
+    await act(async () => {
+      pending = f.controller().confirmUninstall();
+    });
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      resolve();
+      await pending;
+    });
+    assert.equal(f.after(), 0);
+    assert.equal(f.controller().pendingPlugin?.id, f.plugin.id);
+    assert.equal(f.controller().uninstalling, false);
+  } finally {
+    await f.close();
+  }
+});
+
+test("newer unrelated failure is not attributed to the older uninstall confirmation", async () => {
+  const f = await fixture();
+  let resolve!: () => void;
+  f.service.uninstallPlugin = async () => {
+    await new Promise<void>((done) => {
+      resolve = done;
+    });
+    throw new Error("old failure");
+  };
+  f.service.configurePlugin = async () => {
+    throw new Error("new unrelated failure");
+  };
+  try {
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    let pending!: Promise<void>;
+    await act(async () => {
+      pending = f.controller().confirmUninstall();
+    });
+    await act(async () => {
+      await store.getState().configurePlugin(f.plugin.id, {}, f.service);
+    });
+    await act(async () => {
+      resolve();
+      await pending;
+    });
+    assert.equal(f.after(), 0);
+    assert.equal(f.controller().error, null);
+    assert.equal(f.controller().uninstalling, false);
+    assert.equal(store.getState().error, "new unrelated failure");
+  } finally {
+    await f.close();
+  }
+});
+
+test("missing-package config footprint is diagnostic membership and cannot authorize uninstall retry", async () => {
+  const f = await fixture();
+  try {
+    f.service.listPlugins = async () => ({
+      plugins: [{ ...f.plugin, source: "missing", packageStatus: "missing" }] as never,
+      diagnostics: [],
+    });
+    await act(async () => {
+      f.controller().requestUninstall(f.plugin.id);
+    });
+    await act(async () => {
+      await f.controller().confirmUninstall();
+    });
+    assert.equal(f.controller().pendingPlugin?.id, f.plugin.id);
+    assert.equal(f.controller().error, "cleanup failed after removal");
+    assert.equal(f.controller().canConfirm, false);
+    await act(async () => {
