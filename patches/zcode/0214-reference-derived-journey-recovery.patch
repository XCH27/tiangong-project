index 00000000..ff644771
--- /dev/null
+++ b/packages/ui/test/savedWorkflowLaunchActivation.test.ts
@@ -0,0 +1,226 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { IZCodeAgentService } from "@zcode/services";
+import type { CommandEnvelope, CommandKey } from "@zcode/shared/zcode-protocol-v4";
+import { acquireWorkspaceConnection } from "../src/v4/workspaceConnectionRegistry.js";
+import {
+  acquireLaunchLease,
+  runSavedWorkflowLaunch,
+} from "../src/settings/saved-workflows/useSavedWorkflowLauncher.js";
+import { nativePresentationAgent } from "./helpers/nativePresentationAgent.js";
+
+type Input = Parameters<typeof runSavedWorkflowLaunch>[0];
+const scope = () => ({
+  workspacePath: `/authored-remote-${crypto.randomUUID()}`,
+  workspaceIdentity: `remote-${crypto.randomUUID()}`,
+  remoteSessionId: `attachment-${crypto.randomUUID()}`,
+});
+function proxy(owner: string) {
+  const agent = nativePresentationAgent().agent;
+  const hello = agent.helloConversationV4.bind(agent);
+  const sent: CommandEnvelope[] = [],
+    queries: CommandKey[][] = [];
+  let outcome: "accepted" | "unknown" = "accepted",
+    loseReply = true;
+  agent.helloConversationV4 = async () => ({
+    ...(await hello()),
+    connectionId: owner,
+    clientMode: "web-remote-replayable",
+    deliveryProfile: "replayable",
+  });
+  agent.sendConversationCommandV4 = async ({ envelope }) => {
+    sent.push(envelope);
+    const ack = {
+      commandId: envelope.commandId,
+      status: "accepted" as const,
+      revisionAtDecision: 0,
+    };
+    if (envelope.type === "createSession")
+      return { ...ack, result: { type: "createSession", sessionId: "original-parent" } };
+    if (loseReply) {
+      loseReply = false;
+      throw new Error("Authored accepted start reply lost");
+    }
+    return {
+      ...ack,
+      result: { type: "startSavedWorkflow", runId: "original-run", toolCallId: "original-tool" },
+    };
+  };
+  agent.queryConversationCommandsV4 = async ({ commands }) => {
+    queries.push(commands);
+    return {
+      results: commands.map((key) => ({
+        key,
+        result:
+          outcome === "unknown"
+            ? ("unknown" as const)
+            : {
+                commandId: key.commandId,
+                status: "duplicate" as const,
+                revisionAtDecision: 0,
+                result: {
+                  type: "startSavedWorkflow" as const,
+                  runId: "original-run",
+                  toolCallId: "original-tool",
+                },
+              },
+      })),
+    };
+  };
+  return {
+    agent,
+    sent,
+    queries,
+    unknown() {
+      outcome = "unknown";
+    },
+  };
+}
+const request = { name: "authored", scope: "project" as const, args: {} };
+function inputFor(
+  lease: ReturnType<typeof acquireLaunchLease>,
+  target: ReturnType<typeof scope>,
+  agentService: IZCodeAgentService,
+  unsettled: Input["unsettled"] = { current: null },
+): Input {
+  return { target, request, agentService, transport: lease.transport, unsettled };
+}
+
+test("Hub action without mounted provider activates warm incoming proxy before original create/start/query", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const target = scope(),
+    old = proxy("old"),
+    incoming = proxy("incoming");
+  const warm = acquireWorkspaceConnection(target, old.agent);
+  warm.release();
+  const lease = acquireLaunchLease(target, incoming.agent);
+  try {
+    assert.equal(
+      lease.transport,
+      warm.transport,
+      "same original remote transport owner is retained",
+    );
+    const result = await runSavedWorkflowLaunch(inputFor(lease, target, incoming.agent));
+    assert.ok(result.ok);
+    assert.equal(old.sent.length + old.queries.length, 0, "old proxy performs no action/query");
+    assert.deepEqual(
+      incoming.sent.map((x) => x.type),
+      ["createSession", "startSavedWorkflow"],
+    );
+    assert.deepEqual(incoming.queries, [
+      [{ sessionId: "original-parent", commandId: incoming.sent[1]!.commandId }],
+    ]);
+  } finally {
+    lease.release();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("retained pending carrier cannot roll back newer original attachment or route to changed Host B", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const target = scope(),
+    initial = proxy("original-A"),
+    renewed = proxy("renewed-A"),
+    foreign = proxy("B");
+  initial.unknown();
+  const firstLease = acquireLaunchLease(target, initial.agent);
+  const input = inputFor(firstLease, target, initial.agent);
+  try {
+    assert.equal((await runSavedWorkflowLaunch(input)).ok, false);
+    const operation = input.unsettled.current;
+    assert.ok(operation);
+    firstLease.release();
+    const activated = acquireLaunchLease(target, renewed.agent);
+    activated.release();
+    const foreignLease = acquireLaunchLease(scope(), foreign.agent);
+    foreignLease.release();
+    // The actual hook's already-verified captured target/service selection uses this original helper.
+    const resumedLease = acquireLaunchLease(operation.target, operation.agentService);
+    try {
+      const result = await runSavedWorkflowLaunch({ ...input, transport: resumedLease.transport });
+      assert.ok(result.ok);
+      assert.equal(result.sessionId, operation.createdSessionId);
+      assert.equal(initial.sent.length, 2);
+      assert.equal(initial.queries.length, 1);
+      assert.equal(
+        renewed.sent.length,
+        0,
+        "new owner queries only, never repeats a writable start",
+      );
+      assert.deepEqual(renewed.queries, [
+        [{ sessionId: operation.createdSessionId, commandId: operation.startEnvelope.commandId }],
+      ]);
+      assert.equal(foreign.sent.length + foreign.queries.length, 0);
+    } finally {
+      resumedLease.release();
+    }
+  } finally {
+    firstLease.release();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("unknown receipt after action-time activation retains original operation and never closes/replays", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const target = scope(),
+    old = proxy("old"),
+    incoming = proxy("incoming");
+  incoming.unknown();
+  const warm = acquireWorkspaceConnection(target, old.agent);
+  warm.release();
+  const lease = acquireLaunchLease(target, incoming.agent),
+    input = inputFor(lease, target, incoming.agent);
+  try {
+    assert.equal((await runSavedWorkflowLaunch(input)).ok, false);
+    const operation = input.unsettled.current;
+    assert.ok(operation);
+    assert.equal((await runSavedWorkflowLaunch(input)).ok, false);
+    assert.equal(input.unsettled.current, operation);
+    assert.deepEqual(
+      incoming.sent.map((x) => x.type),
+      ["createSession", "startSavedWorkflow"],
+    );
+    assert.equal(incoming.queries.length, 2);
+    assert.equal(old.sent.length + old.queries.length, 0);
+  } finally {
+    lease.release();
+    t.mock.timers.tick(30_001);
+  }
+});
+
+test("activation failure releases exactly its acquired reference and makes no command/query", async (t) => {
+  t.mock.timers.enable({ apis: ["setTimeout"] });
+  const target = scope(),
+    old = proxy("old"),
+    failing = proxy("failing");
+  const warm = acquireWorkspaceConnection(target, old.agent);
+  const dispose = t.mock.method(warm.layer, "dispose");
+  failing.agent.onDynamicConversationFrame = () => () => {
+    throw new Error("Authored incoming frame attachment failure");
+  };
+  try {
+    assert.throws(
+      () => acquireLaunchLease(target, failing.agent),
+      /incoming frame attachment failure/,
+    );
+    assert.equal(
+      old.sent.length + old.queries.length + failing.sent.length + failing.queries.length,
+      0,
+    );
+    assert.equal(
+      dispose.mock.callCount(),
+      0,
+      "failed action cannot release the existing warm holder",
+    );
+    warm.release();
+    t.mock.timers.tick(30_001);
+    assert.equal(
+      dispose.mock.callCount(),
+      1,
+      "failed action's reference was released, not leaked or over-released",
+    );
+  } finally {
+    warm.release();
+    t.mock.timers.tick(30_001);
+  }
+});
diff --git a/packages/ui/test/savedWorkflowLaunchRecovery.test.ts b/packages/ui/test/savedWorkflowLaunchRecovery.test.ts
