index 00000000..fa515f1c
--- /dev/null
+++ b/packages/ui/test/savedWorkflowLaunchRecovery.test.ts
@@ -0,0 +1,288 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { randomUUID } from "node:crypto";
+import {
+  V4_METHODS,
+  V4_WIRE_PROTOCOL_VERSION,
+  commandAckSchema,
+  commandsQueryResultSchema,
+  type CommandEnvelope,
+  type CommandAck,
+} from "@zcode/shared/zcode-protocol-v4";
+import { zcodeProtocolMethods } from "@zcode/shared";
+import { createAgentConversationTransport } from "../src/v4/agentConversationTransport.js";
+import { runSavedWorkflowLaunch } from "../src/settings/saved-workflows/useSavedWorkflowLauncher.js";
+import {
+  productionHandoffFixture,
+  waitForRun,
+} from "../../../apps/zcode-cli/packages/bootstrap/test/helpers/production-handoff-fixture.js";
+
+type Input = Parameters<typeof runSavedWorkflowLaunch>[0];
+function operationInput(transport: Input["transport"], agentService: Input["agentService"]): Input {
+  return {
+    target: { workspacePath: "/authored-only" },
+    request: { name: "authored", scope: "project", args: {} },
+    transport,
+    agentService,
+    unsettled: { current: null },
+  };
+}
+
+async function actualTransport(h: Awaited<ReturnType<typeof productionHandoffFixture>>) {
+  const sent: CommandEnvelope[] = [];
+  const queries: Array<{ commands: Array<{ sessionId: string | null; commandId: string }> }> = [];
+  let loseStart = true;
+  let queryUnavailable = false;
+  const connectionId = randomUUID();
+  const service = {
+    async helloConversationV4() {
+      return {
+        kind: "hello",
+        protocolVersion: V4_WIRE_PROTOCOL_VERSION,
+        connectionId,
+        clientMode: "desktop-continuous",
+        deliveryProfile: "continuous",
+        serverTime: Date.now(),
+        capabilities: {
+          nativeDialogs: true,
+          localTerminal: true,
+          binaryFrames: false,
+          compression: "none",
+        },
+        auth: {},
+      };
+    },
+    async initializeConversationV4() {},
+    async sendConversationCommandV4(params: { envelope: CommandEnvelope; workspacePath: string }) {
+      assert.equal(params.workspacePath, h.workspace.workspacePath);
+      sent.push(params.envelope);
+      const ack = commandAckSchema.parse(await h.request(V4_METHODS.command, params.envelope));
+      if (params.envelope.type === "startSavedWorkflow" && loseStart) {
+        loseStart = false;
+        assert.equal(ack.status, "accepted", JSON.stringify(ack));
+        throw new Error("Authored loss of real Host accepted reply");
+      }
+      return ack;
+    },
+    async queryConversationCommandsV4(params: {
+      commands: Array<{ sessionId: string | null; commandId: string }>;
+      workspacePath: string;
+    }) {
+      assert.equal(params.workspacePath, h.workspace.workspacePath);
+      queries.push({ commands: params.commands });
+      if (queryUnavailable) throw new Error("Authored receipt read unavailable");
+      return commandsQueryResultSchema.parse(
+        await h.request(V4_METHODS.commandsQuery, { commands: params.commands }),
+      );
+    },
+  } as Parameters<typeof createAgentConversationTransport>[0];
+  return {
+    transport: createAgentConversationTransport(service, {
+      workspacePath: h.workspace.workspacePath,
+    }),
+    service,
+    sent,
+    queries,
+    unavailable(value: boolean) {
+      queryUnavailable = value;
+    },
+    keepReply() {
+      loseStart = false;
+    },
+  };
+}
+
+test("real registered saved workflow: lost accepted reply reconciles original command, keeps Session and cold one-run artifact", async () => {
+  const h = await productionHandoffFixture();
+  try {
+    const definitionOwner = await h.createSession();
+    await h.saveWorkflow(
+      definitionOwner,
+      "authored",
+      'await artifact.markdown("receipt", "one original run");',
+    );
+    const modelCallsBefore = h.f.calls.length;
+    const wire = await actualTransport(h);
+    const input = operationInput(wire.transport, wire.service as Input["agentService"]);
+    input.target.workspacePath = h.workspace.workspacePath;
+    let navigated = "";
+    input.onNavigate = (_target, sessionId) => {
+      navigated = sessionId;
+      throw new Error("Authored navigation failure after accepted start");
+    };
+    const result = await runSavedWorkflowLaunch(input);
+    assert.ok(result.ok, JSON.stringify(result));
+    assert.equal(navigated, result.sessionId);
+    assert.equal(input.unsettled.current, null);
+    assert.equal(wire.sent.filter((x) => x.type === "startSavedWorkflow").length, 1);
+    assert.equal(wire.sent.filter((x) => x.type === "deleteSession").length, 0);
+    const start = wire.sent.find((x) => x.type === "startSavedWorkflow");
+    assert.ok(start);
+    assert.deepEqual(wire.queries, [
+      { commands: [{ sessionId: result.sessionId, commandId: start.commandId }] },
+    ]);
+    const app = h.apps.get(result.sessionId);
+    assert.ok(app, "original accepted Session remains resident");
+    await h.request(zcodeProtocolMethods.sessionRead, { sessionId: result.sessionId });
+    const run = await waitForRun(app, result.runId);
+    assert.equal(run.status, "completed");
+    assert.equal((await app.listDynamicWorkflowRuns?.({ limit: 64 }))?.length, 1);
+    const bytes = await app.readDynamicWorkflowRunArtifact?.({
+      runId: result.runId,
+      artifactId: "receipt",
+      version: 1,
+    });
+    assert.equal(Buffer.from(bytes?.bytes ?? []).toString(), "one original run");
+    await h.restart();
+    await h.request(zcodeProtocolMethods.sessionResume, {
+      sessionId: result.sessionId,
+      workspace: h.workspace,
+      dynamicWorkflowEnabled: true,
+    });
+    const cold = h.apps.get(result.sessionId);
+    assert.ok(cold);
+    const runs = await cold.listDynamicWorkflowRuns?.({ limit: 64 });
+    assert.equal(runs?.length, 1);
+    assert.equal(runs?.[0]?.runId, result.runId);
+    const artifact = await cold.readDynamicWorkflowRunArtifact?.({
+      runId: result.runId,
+      artifactId: "receipt",
+      version: 1,
+    });
+    assert.deepEqual(artifact?.bytes, bytes?.bytes);
+    console.log(
+      JSON.stringify({
+        proof: "actual-saved-workflow-launch-recovery",
+        sessionId: result.sessionId,
+        runId: result.runId,
+        starts: 1,
+        closes: 0,
+        coldRuns: runs?.length,
+        authoredModelCalls: h.f.calls.length - modelCallsBefore,
+        httpCalls: h.f.httpCalls,
+      }),
+    );
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    await h.close();
+  }
+});
+
+test("unavailable original receipt retains accepted real run; changed request can only requery and never close/restart", async () => {
+  const h = await productionHandoffFixture();
+  try {
+    const app = await h.createSession();
+    await h.saveWorkflow(app, "authored", 'await artifact.markdown("receipt", "retained");');
+    const wire = await actualTransport(h);
+    wire.unavailable(true);
+    const input = operationInput(wire.transport, wire.service as Input["agentService"]);
+    input.target.workspacePath = h.workspace.workspacePath;
+    const first = await runSavedWorkflowLaunch(input);
+    assert.equal(first.ok, false);
+    if (!first.ok) assert.equal(first.error.reason, "uncertain");
+    const operation = input.unsettled.current;
+    assert.ok(operation);
+    assert.ok(h.apps.get(operation.createdSessionId));
+    input.request = {
+      name: "a different requested workflow",
+      scope: "global",
+      args: { changed: true },
+    };
+    wire.unavailable(false);
+    const recovered = await runSavedWorkflowLaunch(input);
+    assert.ok(recovered.ok);
+    assert.equal(recovered.sessionId, operation.createdSessionId);
+    assert.equal(wire.sent.filter((x) => x.type === "createSession").length, 1);
+    assert.equal(wire.sent.filter((x) => x.type === "startSavedWorkflow").length, 1);
+    assert.equal(wire.sent.filter((x) => x.type === "deleteSession").length, 0);
+    assert.ok(
+      wire.queries.every((q) => q.commands[0]?.commandId === operation.startEnvelope.commandId),
+    );
+    const original = h.apps.get(recovered.sessionId);
+    assert.ok(original);
+    await waitForRun(original, recovered.runId);
+    assert.equal((await original.listDynamicWorkflowRuns?.({ limit: 64 }))?.length, 1);
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    await h.close();
+  }
+});
+
+test("real preflight not_found receipt cleans only its fresh empty Session", async () => {
+  const h = await productionHandoffFixture();
+  try {
+    const wire = await actualTransport(h);
+    wire.keepReply();
+    const input = operationInput(wire.transport, wire.service as Input["agentService"]);
+    input.target.workspacePath = h.workspace.workspacePath;
+    const result = await runSavedWorkflowLaunch(input);
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.reason, "not_found");
+    assert.equal(input.unsettled.current, null);
+    assert.deepEqual(
+      wire.sent.map((x) => x.type),
+      ["createSession", "startSavedWorkflow", "deleteSession"],
+    );
+    const empty = wire.sent[1]?.sessionId;
+    const closed = await h.raw(zcodeProtocolMethods.sessionRead, { sessionId: empty });
+    assert.ok(
+      closed && "error" in closed,
+      "positively rejected empty Session is no longer resident",
+    );
+    assert.equal(h.f.httpCalls, 0);
+  } finally {
+    await h.close();
+  }
+});
+
+for (const reason of ["unknown", "generic", "start_failed", "wrong-key", "no-result"]) {
+  test(`uncertain ${reason} cannot clean up or replay writable launch`, async () => {
+    const sent: CommandEnvelope[] = [];
+    const ack = (envelope: CommandEnvelope, extra: Partial<CommandAck>): CommandAck => ({
+      commandId: envelope.commandId,
+      status: "accepted",
+      revisionAtDecision: 0,
+      ...extra,
+    });
+    const transport: Input["transport"] = {
+      async sendCommand(envelope) {
+        sent.push(envelope);
+        if (envelope.type === "createSession")
+          return ack(envelope, { result: { type: "createSession", sessionId: "owned" } });
+        throw new Error("Lost start receipt");
+      },
+      async queryCommands({ commands }) {
+        const key = commands[0]!;
+        if (reason === "unknown") return { results: [{ key, result: "unknown" }] };
+        return {
+          results: [
+            {
+              key: reason === "wrong-key" ? { ...key, sessionId: "foreign" } : key,
+              result: {
+                commandId: key.commandId,
+                status: reason === "no-result" ? "accepted" : "failed",
+                revisionAtDecision: 0,
+                reasonCode:
+                  reason === "start_failed"
+                    ? "fault.command.savedWorkflowStartRejected.start_failed"
+                    : "fault.generic",
+              },
+            },
+          ],
+        };
+      },
+    };
+    const input = operationInput(transport, {} as Input["agentService"]);
+    const first = await runSavedWorkflowLaunch(input);
+    assert.equal(first.ok, false);
+    const original = input.unsettled.current;
+    assert.ok(original);
+    input.target = { workspacePath: "/other-workspace" };
+    await runSavedWorkflowLaunch(input);
+    assert.equal(input.unsettled.current, original);
+    assert.deepEqual(
+      sent.map((x) => x.type),
+      ["createSession", "startSavedWorkflow"],
+    );
+  });
+}
