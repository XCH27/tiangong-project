@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import test from "node:test";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+
+for (const transition of ["reopen", "close"] as const) {
+  test(`Host fixture ${transition} retains storage until owned writes settle`, async () => {
+    const host = await fixture();
+    host.steps.push(() => reply("Persist the authored fixture session"));
+    await host.runtime.executeTurn("Initialize the authored session");
+    const requestsBeforeTeardown = host.requests.length;
+    const store = host.store;
+    const release = Promise.withResolvers<void>();
+    const target = join(host.dir, "artifacts", "session", "late-receipt.txt");
+    const write = host.runtime.trackResidencyBlockingWork(
+      (async () => {
+        await release.promise;
+        store.debugCounts();
+        await mkdir(join(host.dir, "artifacts", "session"), { recursive: true });
+        await writeFile(target, "settled", "utf8");
+      })(),
+    );
+    // Attach both rejection handlers before exercising the teardown boundary.
+    const writeResult = Promise.allSettled([write]);
+    const pending = host[transition]();
+    const transitionResult = Promise.allSettled([pending]);
+    try {
+      assert.doesNotThrow(
+        () => store.debugCounts(),
+        "the original SQLite owner must remain open while its writer is pending",
+      );
+      release.resolve();
+      const [writer] = await writeResult;
+      const [lifecycle] = await transitionResult;
+      if (writer.status === "rejected") throw writer.reason;
+      if (lifecycle.status === "rejected") throw lifecycle.reason;
+      if (transition === "reopen") {
+        assert.equal(await readFile(target, "utf8"), "settled");
+        assert.doesNotThrow(() => host.store.debugCounts());
+      } else {
+        await assert.rejects(readFile(target, "utf8"), { code: "ENOENT" });
+      }
+      assert.equal(
+        host.requests.length,
+        requestsBeforeTeardown,
+        "teardown never dispatches inference",
+      );
+    } finally {
+      release.resolve();
+      await writeResult;
+      await transitionResult;
+      if (transition === "reopen") await host.close();
+    }
+  });
+}
