@@ -0,0 +1,38 @@
+import type { ContextUsageBreakdownItem, ModelToolContract } from "@zcode/contracts";
+import { ESTIMATED_TOKEN_CHAR_DIVISOR } from "@zcode/shared";
+import { stringifyForEstimation } from "./tool-result.js";
+
+/** Host declaration observation, not provider tokenization or execution policy. */
+export function toolDeclarationText(tool: ModelToolContract): string {
+  return stringifyForEstimation({
+    name: tool.name,
+    description: tool.description,
+    inputSchema: tool.inputSchema,
+    strict: tool.strict,
+  });
+}
+
+export function estimateToolDeclarationTokens(tools: readonly ModelToolContract[]): number {
+  return Math.ceil(
+    tools.reduce((sum, tool) => sum + toolDeclarationText(tool).length, 0) /
+      ESTIMATED_TOKEN_CHAR_DIVISOR,
+  );
+}
+
+export function observedToolDeclarationTokens(
+  breakdown: readonly ContextUsageBreakdownItem[] | undefined,
+): number | undefined {
+  if (
+    !Array.isArray(breakdown) ||
+    breakdown.some((item) => !item || !Number.isFinite(item.chars) || item.chars < 0)
+  )
+    return undefined;
+  const chars = breakdown.reduce(
+    (sum, item) =>
+      item.source === "system_tool_schemas" || item.source === "mcp_tool_schemas"
+        ? sum + item.chars
+        : sum,
+    0,
+  );
+  return Math.ceil(chars / ESTIMATED_TOKEN_CHAR_DIVISOR);
+}
