+import assert from "node:assert/strict";
+import test from "node:test";
+import { getCurrentModelInvocationContext } from "@zcode/contracts";
+import { fixture, reply } from "./helpers/pi-runtime-fixture.js";
+import { estimateCurrentModelInputTokens } from "../src/runtime/methods/compact.js";
+import { resolveModelStepMaxOutputTokens } from "../src/runtime/methods/model-token-limits.js";
+
+const tool = { name: "Large", description: "x".repeat(32000), inputSchema: { type: "object" } };
+
+test("real Host/Pi request reserves output after final tool declarations", async () => {
+  const f = await fixture();
+  try {
+    const runtime = f.runtime as any;
+    const originalFactory = runtime.modelFactory;
+    const constrain = (model: any): any => ({
+      ...model,
+      properties: { ...model.properties, contextWindow: 16000 },
+      bind: (options: any) => constrain(model.bind(options)),
+    });
+    runtime.modelFactory = (input: any) => constrain(originalFactory(input));
+    const probe = runtime.getToolRegistry().get("Probe");
+    probe.metadata.description = tool.description;
+    runtime.invalidateToolCache();
+    f.steps.push((request: any) => {
+      const expectedInput =
+        estimateCurrentModelInputTokens(request.messages) +
+        request.tools.reduce(
+          (sum: number, declaration: any) =>
+            sum +
+            Math.ceil(
+              JSON.stringify({
+                name: declaration.name,
+                description: declaration.description,
+                inputSchema: declaration.inputSchema,
+                strict: declaration.strict,
+              }).length / 3,
+            ),
+          0,
+        );
+      const expectedOutput = resolveModelStepMaxOutputTokens({
+        baselineMaxOutputTokens: 4096,
+        contextWindow: 16000,
+        estimatedCurrentUsage: expectedInput,
+        modelContextBudgetStrategy: "preflight-v1",
+      });
+      assert.ok(expectedOutput < 4096, "fixture must reach the remaining-window boundary");
+      assert.equal(request.options.maxOutputTokens, expectedOutput);
+      return reply("complete");
+    });
+    await runtime.executeTurn("A bounded document request");
+    assert.equal(f.requests.length, 1);
+  } finally {
+    await f.close();
+  }
+});
+
+test("provider input includes old declarations once; growth and removal are estimated deltas", async () => {
+  const { createRuntimeAssistantEntry } = await import("../src/agent/message-history.js");
+  const { toolDeclarationText, estimateToolDeclarationTokens } =
+    await import("../src/runtime/helpers/request-tool-budget.js");
+  const oldTool = { ...tool, description: "old declaration" } as any;
+  const nextTool = tool as any;
+  const model = { providerId: "fixture", modelId: "model-a" } as any;
+  const anchor = createRuntimeAssistantEntry(
+    "ok",
+    [],
+    [],
+    model,
+    { input: 20000, output: 100, total: 20100, reasoning: 0, cache: { read: 1000, write: 0 } },
+    [{ source: "system_tool_schemas", chars: toolDeclarationText(oldTool).length }],
+  );
+  const tail = { message: { role: "user", content: "next" } } as any;
+  const entries = [anchor, tail];
+  const messages = entries.map((entry) => entry.message);
+  const oldTokens = estimateToolDeclarationTokens([oldTool]);
+  for (const currentTools of [[oldTool], [nextTool], []]) {
+    const expected = 20102 + estimateToolDeclarationTokens(currentTools) - oldTokens;
+    assert.equal(estimateCurrentModelInputTokens(messages, entries, currentTools, model), expected);
+  }
+  assert.equal(anchor.tokens?.input, 20000);
+  assert.equal(anchor.tokens?.cache.read, 1000, "cache subset is never counted again");
+  assert.equal(
+    estimateCurrentModelInputTokens(messages, entries, [nextTool], { ...model, modelId: "new" }),
+    estimateCurrentModelInputTokens(messages, [], [nextTool]),
+  );
+  const legacy = { ...anchor, contextUsageBreakdown: undefined };
+  assert.equal(
+    estimateCurrentModelInputTokens(messages, [legacy, tail], [oldTool], model),
+    20102,
+    "legacy input is a floor, not input plus the full declarations again",
+  );
+});
+
+test("cold Session hydration restores existing composition as Host-only budget provenance", async () => {
+  const f = await fixture();
+  try {
+    f.steps.push(() => ({
+      ...reply("retained"),
+      usage: { inputTokens: 20000, outputTokens: 100, totalTokens: 20100 },
+    }));
+    await f.runtime.executeTurn("Retain a document receipt");
+    const project = () => {
+      const entries = (f.runtime as any).messageHistory.toRuntimeEntries();
+      const assistant = entries.findLast((entry: any) => entry.message?.role === "assistant");
+      assert.ok(
+        assistant.contextUsageBreakdown?.some((item: any) => item.source === "system_tool_schemas"),
+      );
+      assert.ok(!JSON.stringify(assistant.message).includes("contextUsageBreakdown"));
+      return structuredClone(assistant.contextUsageBreakdown);
+    };
+    const before = project();
+    await f.reopen();
+    assert.deepEqual(project(), before);
+  } finally {
+    await f.close();
+  }
+});
+
+test("sparse and zero capacities retain the existing output fallback without invented evidence", () => {
+  for (const contextWindow of [undefined, 0, Number.NaN]) {
+    assert.equal(
+      resolveModelStepMaxOutputTokens({
+        baselineMaxOutputTokens: 4096,
+        contextWindow,
+        estimatedCurrentUsage: 999999,
+        modelContextBudgetStrategy: "preflight-v1",
+      }),
+      4096,
+    );
+  }
+});
+
+test("dynamic discovery reaches Host compaction before the next physical request", async () => {
+  const f = await fixture(undefined, false, {
+    config: { toolAllowlist: ["Probe", "SearchTools"] },
+  });
+  try {
+    const runtime = f.runtime as any;
+    const originalFactory = runtime.modelFactory;
+    const constrain = (model: any): any => ({
+      ...model,
+      properties: { ...model.properties, contextWindow: 24000 },
+      bind: (options: any) => constrain(model.bind(options)),
+      async *streamText(request: any) {
+        const result = await model.generateText(request);
+        yield { type: "start" };
+        if (result.text) {
+          yield { type: "text_start", id: "summary" };
+          yield { type: "text_delta", id: "summary", text: result.text };
+          yield { type: "text_end", id: "summary" };
+        }
+        for (const toolCall of result.toolCalls ?? []) yield { type: "tool_call", toolCall };
+        yield { type: "finish", finishReason: result.finishReason, usage: result.usage };
+      },
+    });
+    runtime.modelFactory = (input: any) => constrain(originalFactory(input));
+    const registry = runtime.getToolRegistry();
+    const probe = registry.get("Probe");
+    registry.register({
+      ...probe,
+      deferLoading: true,
+      metadata: { ...probe.metadata, name: "mcp__fixture__large", description: "x".repeat(48000) },
+    });
+    runtime.invalidateToolCache();
+    f.steps.push(() => reply("prior response"));
+    await runtime.executeTurn("An earlier document task");
+    let summaryCalls = 0;
+    let finalSeen = false;
+    f.steps.push(
+      (request: any) => {
+        assert.ok(!request.tools.some((tool: any) => tool.name === "mcp__fixture__large"));
+        return reply("discover", [
+          { id: "search", name: "SearchTools", input: { query: "mcp__fixture__large", limit: 1 } },
+        ]);
+      },
+      () => {
+        assert.equal(
+          getCurrentModelInvocationContext()?.modelCall?.operation,
+          "context_compaction",
+          "Host compacts before the next main model step",
+        );
+        summaryCalls++;
+        return reply("A short retained task summary");
+      },
+      (request: any) => {
+        assert.equal(summaryCalls, 1);
+        assert.ok(request.tools.some((tool: any) => tool.name === "mcp__fixture__large"));
+        finalSeen = true;
+        return reply("complete");
+      },
+    );
+    await runtime.executeTurn("Find the large document formatter");
+    assert.ok(finalSeen);
+  } finally {
+    await f.close();
+  }
+});
