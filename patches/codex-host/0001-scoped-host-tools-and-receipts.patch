diff --git a/codex-rs/app-server/src/host_tools.rs b/codex-rs/app-server/src/host_tools.rs
new file mode 100644
index 0000000..8711e49
--- /dev/null
+++ b/codex-rs/app-server/src/host_tools.rs
@@ -0,0 +1,114 @@
+// Modified by Fleet: immutable tool ceiling for an owned, scoped app-server process.
+use codex_extension_api::ExtensionDataInit;
+use codex_extension_api::ToolPolicy;
+use codex_protocol::ToolName;
+use std::io;
+use std::sync::OnceLock;
+
+// Each native executor process has one admitted Host loadout. This is a restriction,
+// not an approval grant, mutable Session store or replacement for native sandboxing.
+static HOST_TOOLS: OnceLock<Vec<ToolName>> = OnceLock::new();
+
+fn parse_tools(json: &str) -> io::Result<Vec<ToolName>> {
+    if json.len() > 131_072 {
+        return Err(io::Error::other("Host tool declaration exceeds its limit"));
+    }
+    let names: Vec<String> = serde_json::from_str(json)
+        .map_err(|_| io::Error::other("Host tools must be a JSON string array"))?;
+    if names.len() > 1024 {
+        return Err(io::Error::other("Too many Host tools"));
+    }
+    let mut tools = Vec::with_capacity(names.len());
+    for full_name in names {
+        let Some((namespace, name)) = full_name.split_once('.') else {
+            return Err(io::Error::other("Host tools need an explicit namespace"));
+        };
+        let valid = |part: &str| {
+            !part.is_empty()
+                && part.len() <= 64
+                && part
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+        };
+        if !valid(namespace) || !valid(name) {
+            return Err(io::Error::other("Invalid Host tool name"));
+        }
+        let tool = ToolName::namespaced(namespace, name);
+        if tools.contains(&tool) {
+            return Err(io::Error::other("Duplicate Host tool name"));
+        }
+        tools.push(tool);
+    }
+    Ok(tools)
+}
+
+/// Install once, before app-server startup; an empty list exposes no tools.
+pub fn install(json: &str) -> io::Result<()> {
+    HOST_TOOLS
+        .set(parse_tools(json)?)
+        .map_err(|_| io::Error::other("Host tool ceiling is already installed"))
+}
+
+pub(crate) fn enabled() -> bool {
+    HOST_TOOLS.get().is_some()
+}
+
+pub(crate) fn seed(data: &mut ExtensionDataInit) {
+    if let Some(tools) = HOST_TOOLS.get() {
+        data.insert(ToolPolicy {
+            allowed_tools: Some(tools.clone()),
+            ..Default::default()
+        });
+    }
+}
+
+pub(crate) fn extensions() -> ExtensionDataInit {
+    let mut data = ExtensionDataInit::new();
+    seed(&mut data);
+    data
+}
+
+pub(crate) fn handshake() -> Option<Vec<String>> {
+    HOST_TOOLS.get().map(|tools| {
+        tools
+            .iter()
+            .map(|tool| {
+                format!(
+                    "{}.{}",
+                    tool.namespace.as_deref().unwrap_or("functions"),
+                    tool.name
+                )
+            })
+            .collect()
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::parse_tools;
+    use codex_protocol::ToolName;
+
+    #[test]
+    fn exact_namespaces_and_empty_ceiling_are_preserved() {
+        assert_eq!(
+            parse_tools(r#"["fleet.Read","fleet.Write"]"#).unwrap(),
+            vec![
+                ToolName::namespaced("fleet", "Read"),
+                ToolName::namespaced("fleet", "Write")
+            ]
+        );
+        assert_eq!(parse_tools("[]").unwrap(), Vec::<ToolName>::new());
+    }
+
+    #[test]
+    fn ambiguous_or_duplicate_names_cannot_relax_the_ceiling() {
+        for value in [
+            r#"["Read"]"#,
+            r#"["fleet.*"]"#,
+            r#"["fleet.Read","fleet.Read"]"#,
+            r#"["fleet.Read.other"]"#,
+        ] {
+            assert!(parse_tools(value).is_err());
+        }
+    }
+}
