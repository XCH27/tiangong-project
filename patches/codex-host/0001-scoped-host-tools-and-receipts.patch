@@ -0,0 +1,152 @@
+//! Scoped Host discovery cannot present a warm or discarded catalog as an online refresh.
+use super::*;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicBool;
+
+#[derive(Debug, Default)]
+struct ChangedIdentityEndpoint {
+    changed: AtomicBool,
+    foreign_response: bool,
+    calls: AtomicUsize,
+}
+
+impl ModelsEndpointClient for ChangedIdentityEndpoint {
+    fn has_command_auth(&self) -> bool {
+        false
+    }
+
+    fn identity(&self) -> Option<String> {
+        Some(
+            if self.changed.load(Ordering::SeqCst) {
+                "after"
+            } else {
+                "before"
+            }
+            .into(),
+        )
+    }
+
+    fn uses_codex_backend(&self) -> ModelsEndpointFuture<'_, bool> {
+        Box::pin(async { true })
+    }
+
+    fn list_models<'a>(
+        &'a self,
+        _client_version: &'a str,
+        _http_client_factory: HttpClientFactory,
+    ) -> ModelsEndpointFuture<'a, CoreResult<ModelsEndpointResponse>> {
+        Box::pin(async {
+            let calls = self.calls.fetch_add(1, Ordering::SeqCst);
+            if !self.foreign_response {
+                self.changed.store(true, Ordering::SeqCst);
+            }
+            Ok(ModelsEndpointResponse {
+                models: vec![remote_model("original", "Original", /*priority*/ 0)],
+                etag: None,
+                identity: if self.foreign_response && calls > 0 {
+                    "foreign"
+                } else {
+                    "before"
+                }
+                .into(),
+            })
+        })
+    }
+}
+
+#[tokio::test]
+async fn fresh_discovery_rejects_a_discarded_identity_response() {
+    let manager = OpenAiModelsManager::new_without_cache(
+        Arc::new(ChangedIdentityEndpoint::default()),
+        /*auth_manager*/ None,
+    );
+    assert!(
+        manager
+            .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_err()
+    );
+    // Ordinary unscoped fallback policy remains the upstream behavior.
+    assert!(
+        !manager
+            .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn fresh_discovery_cannot_return_a_warm_catalog_after_a_foreign_response() {
+    let manager = OpenAiModelsManager::new_without_cache(
+        Arc::new(ChangedIdentityEndpoint {
+            foreign_response: true,
+            ..Default::default()
+        }),
+        /*auth_manager*/ None,
+    );
+    manager
+        .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("first fetch publishes");
+    assert!(
+        manager
+            .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_err()
+    );
+    assert!(
+        manager
+            .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .iter()
+            .any(|model| model.model == "original")
+    );
+}
+
+#[tokio::test]
+async fn fresh_discovery_reports_online_failure_even_with_a_warm_catalog() {
+    let known = remote_model("reported", "Reported", /*priority*/ 0);
+    let endpoint =
+        TestModelsEndpoint::with_command_auth(vec![Ok(vec![known]), Err(CodexErr::RequestTimeout)]);
+    let manager =
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), /*auth_manager*/ None);
+    manager
+        .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("first fetch succeeds");
+    assert!(
+        manager
+            .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_err()
+    );
+    assert_eq!(endpoint.fetch_count(), 2);
+    assert!(
+        manager
+            .list_models(RefreshStrategy::Offline, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .iter()
+            .any(|model| model.model == "reported")
+    );
+}
+
+#[tokio::test]
+async fn unavailable_fresh_discovery_does_not_report_static_fallback_success() {
+    let endpoint = TestModelsEndpoint::without_refresh(vec![]);
+    let manager =
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), /*auth_manager*/ None);
+    assert!(
+        manager
+            .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_err()
+    );
+    assert_eq!(endpoint.fetch_count(), 0);
+    let static_manager = static_manager_for_tests(ModelsResponse::default());
+    assert!(
+        static_manager
+            .list_models_fresh(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .is_err()
+    );
+}
